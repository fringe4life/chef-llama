    "var_1e7bf6f84996": {
      "type": "variant",
      "label": "Pantry 4 — narrow 390: empty pantry",
      "parentId": "var_64043b0f59ad",
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-8: calc(var(--spacing) * 8);\n    --space-20: calc(var(--spacing) * 20);\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body { block-size: 100%; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); line-height: var(--leading-body); }\n  h1, p, ul { margin: 0; }\n  ul { list-style: none; padding: 0; }\n  a { color: inherit; }\n  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }\n  svg { display: block; }\n  :focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  .screen { display: flex; flex-direction: column; min-block-size: 100vh; }\n\n  .app-head { border-block-end: var(--border-width-thin) solid var(--border); }\n  .deck { block-size: 56px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-inline: var(--space-4); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-2); text-decoration: none; }\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  .wordmark { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .account { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); text-decoration: none; }\n\n  .band { background: var(--primary); color: var(--primary-foreground); border-block-end: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 58%, var(--foreground)); }\n  .band__deck { min-block-size: 88px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-inline: var(--space-4); }\n  .title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .count { margin-block-start: var(--space-1); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: color-mix(in oklab, var(--primary-foreground) 88%, var(--primary)); }\n\n  main { display: flex; flex-direction: column; flex: 1 1 auto; gap: var(--space-4); padding: var(--space-5) var(--space-4) var(--space-4); }\n\n  .label { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .sub-label { font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  .entry__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .input { inline-size: 100%; min-block-size: 44px; padding-inline: var(--space-3); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-ui); }\n  .input::placeholder { color: var(--muted-foreground); }\n  .add { min-block-size: 44px; padding-inline: var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: var(--secondary); color: var(--secondary-foreground); font-size: var(--text-sm); font-weight: 700; }\n\n  .empty { display: grid; place-items: center; block-size: 220px; padding: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: color-mix(in oklab, var(--card) 52%, var(--background)); }\n  .empty p { font-size: var(--text-sm); color: var(--muted-foreground); }\n  .spacer { flex: 1 1 auto; }\n\n  .diet { padding-block: var(--space-4); border-block: var(--border-width-thin) solid var(--border); }\n  .diet__line { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }\n  .diet__name { font-family: var(--font-display); font-size: var(--text-lg); line-height: var(--leading-tight); }\n  .quiet { font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--muted-foreground) 45%, transparent); text-underline-offset: 3px; }\n  .tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-inline-start: var(--space-2); }\n  .tag { display: inline-flex; align-items: center; padding: 1px var(--space-1) 2px; border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 34%, var(--border)); border-radius: 3px; background: color-mix(in oklab, var(--accent) 12%, var(--card)); color: color-mix(in oklab, var(--accent) 62%, var(--foreground)); font-size: var(--text-2xs); }\n  .allergies { display: flex; align-items: baseline; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .allergies p { font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  .run { display: grid; gap: var(--space-2); margin-block-start: var(--space-3); padding-block-start: var(--space-3); border-block-start: var(--border-width-thin) solid var(--border); }\n  .run__row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .run .label { font-size: var(--text-xs); letter-spacing: 0.08em; }\n  .run__value { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--foreground); }\n\n  .generate { inline-size: 100%; min-block-size: 48px; border: var(--border-width-thin) solid var(--border); border-radius: var(--radius); background: color-mix(in oklab, var(--muted) 62%, var(--background)); color: var(--muted-foreground); font-size: var(--text-sm); font-weight: 700; }\n</style>\n<div class=\"screen\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"app-head\" data-kid=\"1-1\" data-name=\"application header bar\">\n<div class=\"deck\" data-kid=\"1-1-1\" data-name=\"header top bar with logo and account\">\n<a class=\"lockup\" data-kid=\"1-1-1-1\" data-name=\"brand logo and wordmark link\" href=\"/\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"llama mascot logo icon\" height=\"26\" viewbox=\"0 0 32 32\" width=\"26\">\n<g class=\"mk-hat\"><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<a class=\"account\" data-kid=\"1-1-1-2\" data-name=\"account navigation link\" href=\"/account\">Account</a>\n</div>\n</header>\n<section aria-labelledby=\"pantry-title\" class=\"band\" data-kid=\"1-2\" data-name=\"pantry section header band\">\n<div class=\"band__deck\" data-kid=\"1-2-1\" data-name=\"pantry header content container\">\n<h1 class=\"title\" data-kid=\"1-2-1-1\" data-name=\"section title heading\" id=\"pantry-title\">Pantry</h1>\n<p class=\"count\" data-kid=\"1-2-1-2\" data-name=\"item count indicator text\">0 / 16</p>\n</div>\n</section>\n<main data-kid=\"1-3\" data-name=\"main content area\">\n<div class=\"entry\" data-kid=\"1-3-1\" data-name=\"ingredient add form\">\n<label class=\"label\" data-kid=\"1-3-1-1\" data-name=\"ingredient input label\" for=\"ingredient\">Add ingredient</label>\n<div class=\"entry__row\" data-kid=\"1-3-1-2\" data-name=\"input and add button row\">\n<input autocomplete=\"off\" class=\"input\" data-kid=\"1-3-1-2-1\" data-name=\"ingredient text input field\" id=\"ingredient\" placeholder=\"e.g. leftover rice, firm tofu\" type=\"text\" value=\"\"/>\n<button class=\"add\" data-kid=\"1-3-1-2-2\" data-name=\"add ingredient button\" type=\"button\">Add</button>\n</div>\n</div>\n<div class=\"empty\" data-kid=\"1-3-2\" data-name=\"empty state placeholder container\" role=\"status\">\n<p data-kid=\"1-3-2-1\" data-name=\"empty state placeholder text\">No ingredients yet</p>\n</div>\n<section aria-label=\"Diet\" class=\"diet\" data-kid=\"1-3-3\" data-name=\"diet preferences section\">\n<div class=\"diet__line\" data-kid=\"1-3-3-1\" data-name=\"diet name and edit row\">\n<p class=\"diet__name\" data-kid=\"1-3-3-1-1\" data-name=\"diet name text\">Home</p>\n<span class=\"quiet\" data-kid=\"1-3-3-1-2\" data-name=\"edit diet link\">Edit Diet</span>\n</div>\n<div class=\"diet__line\" data-kid=\"1-3-3-2\" data-name=\"diet tags row container\" style=\"margin-block-start: var(--space-2)\">\n<ul class=\"tags\" data-kid=\"1-3-3-2-1\" data-name=\"food tag list\" style=\"margin-inline-start: 0\">\n<li class=\"tag\" data-kid=\"1-3-3-2-1-1\" data-name=\"vegan diet tag\">vegan</li>\n<li class=\"tag\" data-kid=\"1-3-3-2-1-2\" data-name=\"gluten free diet tag\">gluten free</li>\n</ul>\n</div>\n<div class=\"allergies\" data-kid=\"1-3-3-3\" data-name=\"allergies row container\">\n<span class=\"label\" data-kid=\"1-3-3-3-1\" data-name=\"allergies label\">Allergies</span>\n<p data-kid=\"1-3-3-3-2\" data-name=\"allergies value text\">sesame, peanut</p>\n</div>\n<div class=\"run\" data-kid=\"1-3-3-4\" data-name=\"this cook targets summary\">\n<p class=\"run__row\" data-kid=\"1-3-3-4-1\" data-name=\"servings summary row\"><span class=\"label\" data-kid=\"1-3-3-4-1-1\" data-name=\"servings summary label\">Servings</span><span class=\"run__value\" data-kid=\"1-3-3-4-1-2\" data-name=\"servings summary value\">2</span></p>\n<p class=\"run__row\" data-kid=\"1-3-3-4-2\" data-name=\"kcal target summary row\"><span class=\"label\" data-kid=\"1-3-3-4-2-1\" data-name=\"kcal target summary label\">kcal per serving</span><span class=\"run__value\" data-kid=\"1-3-3-4-2-2\" data-name=\"kcal target summary value\">600</span></p>\n<p class=\"run__row\" data-kid=\"1-3-3-4-3\" data-name=\"max minutes summary row\"><span class=\"label\" data-kid=\"1-3-3-4-3-1\" data-name=\"max minutes summary label\">Max minutes</span><span class=\"run__value\" data-kid=\"1-3-3-4-3-2\" data-name=\"max minutes summary value\">30</span></p>\n</div>\n</section>\n<div aria-hidden=\"true\" class=\"spacer\" data-kid=\"1-3-4\" data-name=\"flex spacer filler\"></div>\n<button class=\"generate\" data-kid=\"1-3-5\" data-name=\"generate recipe button\" disabled=\"\" type=\"button\">Generate recipe</button>\n</main>\n</div>",
      "comments": [],
      "created": "2026-11-19T05:37:23.441785+00:00",
