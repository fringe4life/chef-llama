      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n    --destructive-foreground: light-dark(oklch(0.985 0.014 95), oklch(0.190 0.045 20));\n    --chart-gift: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --chart-credit: light-dark(oklch(0.430 0.150 15), oklch(0.560 0.135 15));\n    --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n    --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n    --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n    --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n    --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n    --border-width-thick: 3px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n\n    --page-measure: 72rem;\n    --space-page: var(--space-5);\n  }\n  @media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); line-height: var(--leading-body); }\n  h1, h2, p, ul, ol { margin: 0; }\n  ul { list-style: none; padding: 0; }\n  a { color: inherit; }\n  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }\n  svg { display: block; }\n  :focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  .wrap { inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n  /* app chrome */\n  .app-head { border-block-end: var(--border-width-thin) solid var(--border); }\n  .deck { block-size: 72px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }\n  .mk { display: block; overflow: visible; }\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  .wordmark { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .nav { display: flex; align-items: center; gap: var(--space-7); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .nav a { text-decoration: none; }\n  .nav a[aria-current=\"page\"] { color: var(--foreground); font-weight: 700; }\n\n  /* saffron deck */\n  .band { background: var(--primary); color: var(--primary-foreground); border-block-end: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 58%, var(--foreground)); }\n  .band__deck { min-block-size: 112px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }\n  .title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .count { margin-block-start: var(--space-2); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: color-mix(in oklab, var(--primary-foreground) 88%, var(--primary)); }\n  .action { display: inline-flex; align-items: center; gap: var(--space-3); min-block-size: 48px; padding-inline: var(--space-6); border-radius: var(--radius); background: var(--primary-foreground); color: var(--primary); font-size: var(--text-sm); font-weight: 700; letter-spacing: 0.01em; white-space: nowrap; }\n  .action svg { color: var(--primary); }\n\n  /* work area */\n  .work { display: grid; grid-template-columns: minmax(0, 1fr) 400px; min-block-size: 764px; padding-block: var(--space-8); }\n  .editor { display: flex; flex-direction: column; min-block-size: 0; min-inline-size: 0; padding-inline-end: var(--space-8); }\n  .diet { border-inline-start: var(--border-width-thin) solid var(--border); padding-inline-start: var(--space-8); }\n\n  .label { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .sub-label { font-size: var(--text-xs); letter-spacing: 0.02em; color: var(--muted-foreground); }\n\n  .entry__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .input { inline-size: 100%; min-block-size: 44px; padding-inline: var(--space-3); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-ui); }\n  .input::placeholder { color: var(--muted-foreground); }\n  .add { min-block-size: 44px; padding-inline: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: var(--secondary); color: var(--secondary-foreground); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }\n  .hint { margin-block-start: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  /* chip collection */\n  .chips { display: flex; flex-wrap: wrap; align-content: flex-start; gap: var(--space-2); min-block-size: 300px; margin-block-start: var(--space-5); padding: var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: color-mix(in oklab, var(--card) 52%, var(--background)); }\n  .chip { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 36px; padding-inline: var(--space-3); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: var(--muted); color: var(--foreground); font-size: var(--text-sm); line-height: var(--leading-ui); }\n  .chip__cooked { padding: 2px var(--space-1); border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 40%, var(--border)); border-radius: 2px; background: color-mix(in oklab, var(--accent) 22%, var(--card)); color: color-mix(in oklab, var(--accent) 74%, var(--foreground)); font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }\n  .chip__x { display: grid; place-items: center; inline-size: 18px; block-size: 18px; margin-inline-end: -2px; border-radius: 50%; color: var(--muted-foreground); }\n  .chip__x:hover { color: var(--destructive); background: color-mix(in oklab, var(--destructive) 12%, transparent); }\n\n  .guide { margin-block-start: var(--space-6); border-block-start: var(--border-width-thin) solid var(--border); }\n  .editor .guide { margin-block-start: var(--space-6); }\n  .guide summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: 48px; list-style: none; cursor: pointer; font-size: var(--text-sm); }\n  .guide summary::-webkit-details-marker { display: none; }\n  .guide svg { color: var(--muted-foreground); }\n\n  /* Diet reference */\n  .diet__head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }\n  .diet__name { margin-block-start: var(--space-1); font-family: var(--font-display); font-size: var(--text-lg); line-height: var(--leading-tight); }\n  .quiet { font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--muted-foreground) 45%, transparent); text-underline-offset: 3px; }\n  .quiet:hover { color: var(--foreground); }\n  .group { margin-block-start: var(--space-5); }\n  .group + .group { padding-block-start: var(--space-5); border-block-start: var(--border-width-thin) solid var(--border); }\n  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .tag { min-block-size: 28px; display: inline-flex; align-items: center; padding-inline: var(--space-2); border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 34%, var(--border)); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--accent) 12%, var(--card)); color: color-mix(in oklab, var(--accent) 62%, var(--foreground)); font-size: var(--text-xs); }\n  .tag--plain { border-color: var(--border); background: var(--muted); color: var(--foreground); }\n  .warns { margin-block-start: var(--space-4); }\n  .field { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); margin-block-start: var(--space-3); }\n  .field--stack { grid-template-columns: minmax(0, 1fr); align-items: start; gap: var(--space-1); }\n  .optional { margin-inline-start: var(--space-1); color: color-mix(in oklab, var(--muted-foreground) 78%, transparent); font-style: normal; }\n  .stepper { display: inline-flex; align-items: center; border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm); background: var(--card); overflow: hidden; }\n  .stepper button { inline-size: 32px; block-size: 32px; display: grid; place-items: center; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--foreground); }\n  .stepper button:hover { background: var(--muted); }\n  .stepper__value { min-inline-size: 32px; text-align: center; font-family: var(--font-mono); font-size: var(--text-sm); }\n  .input--sm { min-block-size: 32px; inline-size: 96px; padding-inline: var(--space-2); font-family: var(--font-mono); font-size: var(--text-sm); text-align: end; }\n  .rule { margin-block-start: var(--space-6); padding-block-start: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); font-size: var(--text-xs); color: var(--muted-foreground); line-height: var(--leading-ui); }\n</style>\n<header class=\"app-head\" data-kid=\"1\" data-name=\"app header bar\">\n<div class=\"wrap deck\" data-kid=\"1-1\" data-name=\"header content row\">\n<a class=\"lockup\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1\" data-name=\"llama mascot logo icon\" height=\"32\" viewbox=\"0 0 32 32\" width=\"32\">\n<g class=\"mk-hat\"><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"App\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"app main navigation\">\n<a aria-current=\"page\" data-kid=\"1-1-2-1\" data-name=\"active navigation link Pantry\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" data-name=\"navigation link Saved\" href=\"/saved\">Saved</a>\n<a data-kid=\"1-1-2-3\" data-name=\"navigation link Account\" href=\"/account\">Account</a>\n</nav>\n</div>\n</header>\n<section aria-labelledby=\"pantry-title\" class=\"band\" data-kid=\"2\" data-name=\"page title banner section\">\n<div class=\"wrap band__deck\" data-kid=\"2-1\" data-name=\"banner content row\">\n<div data-kid=\"2-1-1\" data-name=\"page title group\">\n<h1 class=\"title\" data-kid=\"2-1-1-1\" data-name=\"page title heading\" id=\"pantry-title\">Pantry</h1>\n<p class=\"count\" data-kid=\"2-1-1-2\" data-name=\"ingredient count label\">9 / 16 ingredients</p>\n</div>\n<button class=\"action\" data-kid=\"2-1-2\" data-name=\"generate recipe call-to-action button\" type=\"button\">\n<span data-kid=\"2-1-2-1\" data-name=\"button action text\">Generate recipe</span>\n<svg aria-hidden=\"true\" data-kid=\"2-1-2-2\" data-name=\"right arrow icon\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\"></path></svg>\n</button>\n</div>\n</section>\n<main class=\"wrap work\" data-kid=\"3\" data-name=\"main work area grid\">\n<section aria-label=\"Pantry ingredients\" class=\"editor\" data-kid=\"3-1\" data-name=\"pantry ingredient editor section\">\n<div class=\"entry\" data-kid=\"3-1-1\" data-name=\"ingredient entry form\">\n<label class=\"label\" data-kid=\"3-1-1-1\" data-name=\"add ingredient input label\" for=\"ingredient\">Add ingredient</label>\n<div class=\"entry__row\" data-kid=\"3-1-1-2\" data-name=\"ingredient input row\">\n<input autocomplete=\"off\" class=\"input\" data-kid=\"3-1-1-2-1\" data-name=\"ingredient text input with example placeholder\" id=\"ingredient\" placeholder=\"e.g. leftover rice, firm tofu\" type=\"text\" value=\"\"/>\n<button class=\"add\" data-kid=\"3-1-1-2-2\" data-name=\"add ingredient button\" type=\"button\">Add</button>\n</div>\n<p class=\"hint\" data-kid=\"3-1-1-3\" data-name=\"entry helper hint text\">One per entry. Paste a list to add several.</p>\n</div>\n<ul aria-label=\"9 ingredients\" class=\"chips\" data-kid=\"3-1-2\" data-name=\"ingredient chip collection\">\n<li class=\"chip\" data-kid=\"3-1-2-1\" data-name=\"ingredient chip day-old rice\"><span data-kid=\"3-1-2-1-1\" data-name=\"chip ingredient name text\">day-old rice</span><span class=\"chip__cooked\" data-kid=\"3-1-2-1-2\" data-name=\"chip preparation state tag\">cooked</span><button aria-label=\"Remove day-old rice\" class=\"chip__x\" data-kid=\"3-1-2-1-3\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-1-3-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-2\" data-name=\"ingredient chip firm tofu\"><span data-kid=\"3-1-2-2-1\" data-name=\"chip ingredient name text\">firm tofu</span><button aria-label=\"Remove firm tofu\" class=\"chip__x\" data-kid=\"3-1-2-2-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-2-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-3\" data-name=\"ingredient chip soy sauce\"><span data-kid=\"3-1-2-3-1\" data-name=\"chip ingredient name text\">soy sauce</span><button aria-label=\"Remove soy sauce\" class=\"chip__x\" data-kid=\"3-1-2-3-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-3-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-4\" data-name=\"ingredient chip sesame oil\"><span data-kid=\"3-1-2-4-1\" data-name=\"chip ingredient name text\">sesame oil</span><button aria-label=\"Remove sesame oil\" class=\"chip__x\" data-kid=\"3-1-2-4-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-4-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-5\" data-name=\"ingredient chip spring onion\"><span data-kid=\"3-1-2-5-1\" data-name=\"chip ingredient name text\">spring onion</span><button aria-label=\"Remove spring onion\" class=\"chip__x\" data-kid=\"3-1-2-5-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-5-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-6\" data-name=\"ingredient chip garlic\"><span data-kid=\"3-1-2-6-1\" data-name=\"chip ingredient name text\">garlic</span><button aria-label=\"Remove garlic\" class=\"chip__x\" data-kid=\"3-1-2-6-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-6-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-7\" data-name=\"ingredient chip ginger\"><span data-kid=\"3-1-2-7-1\" data-name=\"chip ingredient name text\">ginger</span><button aria-label=\"Remove ginger\" class=\"chip__x\" data-kid=\"3-1-2-7-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-7-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-8\" data-name=\"ingredient chip carrot\"><span data-kid=\"3-1-2-8-1\" data-name=\"chip ingredient name text\">carrot</span><button aria-label=\"Remove carrot\" class=\"chip__x\" data-kid=\"3-1-2-8-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-8-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"chip\" data-kid=\"3-1-2-9\" data-name=\"ingredient chip cavolo nero\"><span data-kid=\"3-1-2-9-1\" data-name=\"chip ingredient name text\">cavolo nero</span><button aria-label=\"Remove cavolo nero\" class=\"chip__x\" data-kid=\"3-1-2-9-2\" data-name=\"chip remove button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"3-1-2-9-2-1\" data-name=\"clear x icon\" height=\"9\" viewbox=\"0 0 9 9\" width=\"9\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n</ul>\n<details class=\"guide\" data-kid=\"3-1-3\" data-name=\"expandable guide accordion\">\n<summary data-kid=\"3-1-3-1\" data-name=\"guide toggle summary control\">\n<span data-kid=\"3-1-3-1-1\" data-name=\"guide expansion title text\">How to get the most out of Chef Llama</span>\n<svg aria-hidden=\"true\" data-kid=\"3-1-3-1-2\" data-name=\"chevron down disclosure icon\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M2 4.5L6 8.5l4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</summary>\n</details>\n</section>\n<aside aria-labelledby=\"diet-label\" class=\"diet\" data-kid=\"3-2\" data-name=\"diet settings sidebar panel\">\n<div class=\"diet__head\" data-kid=\"3-2-1\" data-name=\"diet panel header\">\n<div data-kid=\"3-2-1-1\" data-name=\"diet name group\">\n<p class=\"label\" data-kid=\"3-2-1-1-1\" data-name=\"diet panel section label\" id=\"diet-label\">Diet</p>\n<p class=\"diet__name\" data-kid=\"3-2-1-1-2\" data-name=\"diet name display heading\">Home</p>\n</div>\n<a class=\"quiet\" data-kid=\"3-2-1-2\" data-name=\"edit diet link\" href=\"/account\">Edit Diet</a>\n</div>\n<div class=\"group\" data-kid=\"3-2-2\" data-name=\"hard limits group section\">\n<p class=\"label\" data-kid=\"3-2-2-1\" data-name=\"hard limits group label\">Hard limits</p>\n<p class=\"sub-label\" data-kid=\"3-2-2-2\" data-name=\"flags subheading label\" style=\"margin-block-start: var(--space-3)\">Flags</p>\n<ul class=\"tags\" data-kid=\"3-2-2-3\" data-name=\"diet restriction tag list\">\n<li class=\"tag\" data-kid=\"3-2-2-3-1\" data-name=\"diet restriction tag vegan\">vegan</li>\n<li class=\"tag\" data-kid=\"3-2-2-3-2\" data-name=\"diet restriction tag gluten free\">gluten free</li>\n</ul>\n<p class=\"sub-label\" data-kid=\"3-2-2-4\" data-name=\"allergies subheading label\" style=\"margin-block-start: var(--space-4)\">Allergies</p>\n<ul class=\"tags\" data-kid=\"3-2-2-5\" data-name=\"allergy tag list\">\n<li class=\"tag tag--plain\" data-kid=\"3-2-2-5-1\" data-name=\"allergy tag sesame\">sesame</li>\n<li class=\"tag tag--plain\" data-kid=\"3-2-2-5-2\" data-name=\"allergy tag peanut\">peanut</li>\n</ul>\n</div>\n<div class=\"group\" data-kid=\"3-2-3\" data-name=\"cook preferences group section\">\n<p class=\"label\" data-kid=\"3-2-3-1\" data-name=\"cook preferences group label\">This cook</p>\n<div class=\"field\" data-kid=\"3-2-3-2\" data-name=\"servings stepper field\" style=\"margin-block-start: var(--space-3)\">\n<span class=\"sub-label\" data-kid=\"3-2-3-2-1\" data-name=\"servings field label\" id=\"servings-label\">Servings</span>\n<div aria-labelledby=\"servings-label\" class=\"stepper\" data-kid=\"3-2-3-2-2\" data-name=\"servings number stepper widget\" role=\"group\">\n<button aria-label=\"One fewer serving\" data-kid=\"3-2-3-2-2-1\" data-name=\"decrement servings button\" type=\"button\">−</button>\n<span class=\"stepper__value\" data-dynamic=\"true\" data-kid=\"3-2-3-2-2-2\" data-name=\"servings value display\" data-reason=\"number rewritten by stepper button presses\">2</span>\n<button aria-label=\"One more serving\" data-kid=\"3-2-3-2-2-3\" data-name=\"increment servings button\" type=\"button\">+</button>\n</div>\n</div>\n<div class=\"field\" data-kid=\"3-2-3-3\" data-name=\"kcal per serving field\">\n<label class=\"sub-label\" data-kid=\"3-2-3-3-1\" data-name=\"kcal field label\" for=\"kcal\">kcal per serving <em class=\"optional\" data-kid=\"3-2-3-3-1-1\" data-name=\"optional field qualifier text\">optional</em></label>\n<input class=\"input input--sm\" data-kid=\"3-2-3-3-2\" data-name=\"kcal numeric input field\" id=\"kcal\" inputmode=\"numeric\" type=\"text\" value=\"600\"/>\n</div>\n<div class=\"field\" data-kid=\"3-2-3-4\" data-name=\"max minutes field\">\n<label class=\"sub-label\" data-kid=\"3-2-3-4-1\" data-name=\"max minutes field label\" for=\"minutes\">Max minutes <em class=\"optional\" data-kid=\"3-2-3-4-1-1\" data-name=\"optional field qualifier text\">optional</em></label>\n<input class=\"input input--sm\" data-kid=\"3-2-3-4-2\" data-name=\"max minutes numeric input field\" id=\"minutes\" inputmode=\"numeric\" type=\"text\" value=\"30\"/>\n</div>\n</div>\n<p class=\"rule\" data-kid=\"3-2-4\" data-name=\"precedence rule note text\">Pantry ingredients override the Diet for this cook.</p>\n</aside>\n</main>",
      "comments": [],
      "created": "2026-11-19T05:35:40.174207+00:00",
      "modified": "2026-11-19T05:41:59.978350+00:00",
      "id": "var_3dae9c660aaf"
    },
    "var_e698064075a5": {
      "type": "variant",
      "label": "Pantry 2 — first-run Diet dialog",
      "parentId": "var_3dae9c660aaf",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n    --destructive-foreground: light-dark(oklch(0.985 0.014 95), oklch(0.190 0.045 20));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-20: calc(var(--spacing) * 20);\n    --page-measure: 72rem;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); line-height: var(--leading-body); }\n  h1, h2, p, ul { margin: 0; }\n  ul { list-style: none; padding: 0; }\n  a { color: inherit; }\n  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }\n  svg { display: block; }\n  :focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  .scrim { min-block-size: 100vh; display: grid; place-items: center; padding: var(--space-6); background: color-mix(in oklab, var(--foreground) 34%, var(--background)); }\n\n  .sheet { inline-size: 640px; background: var(--card); color: var(--card-foreground); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-xl); box-shadow: 0 28px 64px -24px color-mix(in oklab, var(--foreground) 55%, transparent); overflow: hidden; }\n\n  .label { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .sub-label { font-size: var(--text-xs); letter-spacing: 0.02em; color: var(--muted-foreground); }\n\n  .sheet__head { padding: var(--space-6) var(--space-6) var(--space-5); border-block-end: var(--border-width-thin) solid var(--border); }\n  .sheet__title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .sheet__note { margin-block-start: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  .sheet__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }\n  .col { padding: var(--space-6); }\n  .col + .col { border-inline-start: var(--border-width-thin) solid var(--border); }\n\n  .field { margin-block-start: var(--space-2); }\n  .input { inline-size: 100%; min-block-size: 40px; padding-inline: var(--space-3); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-ui); }\n  .input--sm { inline-size: 96px; min-block-size: 34px; font-family: var(--font-mono); font-size: var(--text-sm); text-align: end; }\n\n  .block { margin-block-start: var(--space-5); }\n  .block:first-child { margin-block-start: 0; }\n\n  .checks { display: grid; gap: var(--space-1); margin-block-start: var(--space-3); }\n  .check { display: flex; align-items: center; gap: var(--space-3); min-block-size: 32px; font-size: var(--text-sm); cursor: pointer; }\n  .check input { appearance: none; flex: none; inline-size: 18px; block-size: 18px; margin: 0; border: var(--border-width-thin) solid var(--input); border-radius: 2px; background: var(--background); display: grid; place-items: center; }\n  .check input:checked { background: var(--primary); border-color: color-mix(in oklab, var(--primary) 70%, var(--foreground)); }\n  .check input:checked::after { content: \"\"; inline-size: 9px; block-size: 5px; border-inline-start: 2px solid var(--primary-foreground); border-block-end: 2px solid var(--primary-foreground); transform: translateY(-1px) rotate(-45deg); }\n\n  .achips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .achip { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 30px; padding-inline: var(--space-2) var(--space-2); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: var(--muted); font-size: var(--text-sm); }\n  .achip button { color: var(--muted-foreground); display: grid; place-items: center; inline-size: 16px; block-size: 16px; }\n  .achip button:hover { color: var(--destructive); }\n\n  .stepper { display: inline-flex; align-items: center; border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm); background: var(--background); overflow: hidden; }\n  .stepper button { inline-size: 34px; block-size: 34px; display: grid; place-items: center; font-family: var(--font-mono); font-size: var(--text-sm); }\n  .stepper button:hover { background: var(--muted); }\n  .stepper__value { min-inline-size: 34px; text-align: center; font-family: var(--font-mono); font-size: var(--text-sm); }\n  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); margin-block-start: var(--space-4); }\n  .row--stack { grid-template-columns: minmax(0, 1fr); align-items: start; gap: var(--space-1); }\n  .optional { margin-inline-start: var(--space-1); color: color-mix(in oklab, var(--muted-foreground) 78%, transparent); font-style: normal; }\n\n  .sheet__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-5) var(--space-6); border-block-start: var(--border-width-thin) solid var(--border); background: color-mix(in oklab, var(--muted) 55%, var(--card)); }\n  .quiet { font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--muted-foreground) 45%, transparent); text-underline-offset: 3px; }\n  .save { display: inline-flex; align-items: center; gap: var(--space-3); min-block-size: 44px; padding-inline: var(--space-6); border-radius: var(--radius); background: var(--primary); color: var(--primary-foreground); font-size: var(--text-sm); font-weight: 700; border: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 72%, var(--foreground)); }\n</style>\n<div class=\"scrim\" data-kid=\"1\" data-name=\"dialog backdrop scrim\">\n<div aria-labelledby=\"diet-dialog-title\" aria-modal=\"true\" class=\"sheet\" data-kid=\"1-1\" data-name=\"diet setup dialog sheet\" role=\"dialog\">\n<div class=\"sheet__head\" data-kid=\"1-1-1\" data-name=\"dialog header section\">\n<h1 class=\"sheet__title\" data-kid=\"1-1-1-1\" data-name=\"dialog title heading\" id=\"diet-dialog-title\">Set up your Diet</h1>\n<p class=\"sheet__note\" data-kid=\"1-1-1-2\" data-name=\"dialog helper note text\">Required before the first cook.</p>\n</div>\n<div class=\"sheet__body\" data-kid=\"1-1-2\" data-name=\"dialog body two-column grid\">\n<div class=\"col\" data-kid=\"1-1-2-1\" data-name=\"left form column\">\n<div class=\"block\" data-kid=\"1-1-2-1-1\" data-name=\"diet name field block\">\n<label class=\"label\" data-kid=\"1-1-2-1-1-1\" data-name=\"diet name field label\" for=\"diet-name\">Diet name</label>\n<div class=\"field\" data-kid=\"1-1-2-1-1-2\" data-name=\"diet name input container\">\n<input class=\"input\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"diet name text input field\" id=\"diet-name\" type=\"text\" value=\"Home\"/>\n</div>\n</div>\n<div class=\"block\" data-kid=\"1-1-2-1-2\" data-name=\"flags checkbox block\">\n<p class=\"label\" data-kid=\"1-1-2-1-2-1\" data-name=\"flags group label\">Flags</p>\n<div class=\"checks\" data-kid=\"1-1-2-1-2-2\" data-name=\"diet type checkbox grid\">\n<label class=\"check\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"vegan diet checkbox row\"><input checked=\"\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"vegan checkbox input\" type=\"checkbox\"/><span data-kid=\"1-1-2-1-2-2-1-2\" data-name=\"vegan checkbox label text\">vegan</span></label>\n<label class=\"check\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"vegetarian diet checkbox row\"><input data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"vegetarian checkbox input\" type=\"checkbox\"/><span data-kid=\"1-1-2-1-2-2-2-2\" data-name=\"vegetarian checkbox label text\">vegetarian</span></label>\n<label class=\"check\" data-kid=\"1-1-2-1-2-2-3\" data-name=\"gluten free diet checkbox row\"><input checked=\"\" data-kid=\"1-1-2-1-2-2-3-1\" data-name=\"gluten free checkbox input\" type=\"checkbox\"/><span data-kid=\"1-1-2-1-2-2-3-2\" data-name=\"gluten free checkbox label text\">gluten free</span></label>\n</div>\n</div>\n<div class=\"block\" data-kid=\"1-1-2-1-3\" data-name=\"allergies block\">\n<p class=\"label\" data-kid=\"1-1-2-1-3-1\" data-name=\"allergies label with count\">Allergies <span class=\"sub-label\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"allergies selected count indicator\" data-reason=\"count text is a derived display value re-computed as selections change\">2 / 16</span></p>\n<ul aria-label=\"Allergies\" class=\"achips\" data-kid=\"1-1-2-1-3-2\" data-name=\"selected allergy chips list\">\n<li class=\"achip\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"sesame allergy chip\"><span data-kid=\"1-1-2-1-3-2-1-1\" data-name=\"sesame allergy chip label\">sesame</span><button aria-label=\"Remove sesame\" data-kid=\"1-1-2-1-3-2-1-2\" data-name=\"remove sesame button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"1-1-2-1-3-2-1-2-1\" data-name=\"remove x icon\" height=\"8\" viewbox=\"0 0 9 9\" width=\"8\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n<li class=\"achip\" data-kid=\"1-1-2-1-3-2-2\" data-name=\"peanut allergy chip\"><span data-kid=\"1-1-2-1-3-2-2-1\" data-name=\"peanut allergy chip label\">peanut</span><button aria-label=\"Remove peanut\" data-kid=\"1-1-2-1-3-2-2-2\" data-name=\"remove peanut button\" type=\"button\"><svg aria-hidden=\"true\" data-kid=\"1-1-2-1-3-2-2-2-1\" data-name=\"remove x icon\" height=\"8\" viewbox=\"0 0 9 9\" width=\"8\"><path d=\"M1 1l7 7M8 1L1 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></svg></button></li>\n</ul>\n<div class=\"field\" data-kid=\"1-1-2-1-3-3\" data-name=\"add allergy field row\" style=\"display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2)\">\n<input aria-label=\"Add an allergy\" class=\"input\" data-kid=\"1-1-2-1-3-3-1\" data-name=\"add allergy text input field\" placeholder=\"Add an allergy\" type=\"text\"/>\n</div>\n</div>\n</div>\n<div class=\"col\" data-kid=\"1-1-2-2\" data-name=\"right form column\">\n<p class=\"label\" data-kid=\"1-1-2-2-1\" data-name=\"this cook section label\">This cook</p>\n<div class=\"row\" data-kid=\"1-1-2-2-2\" data-name=\"servings control row\" style=\"margin-block-start: var(--space-3)\">\n<span class=\"sub-label\" data-kid=\"1-1-2-2-2-1\" data-name=\"servings field label\" id=\"dlg-servings\">Servings</span>\n<div aria-labelledby=\"dlg-servings\" class=\"stepper\" data-kid=\"1-1-2-2-2-2\" data-name=\"servings stepper control\" role=\"group\">\n<button aria-label=\"One fewer serving\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"decrease servings button\" type=\"button\">−</button>\n<span class=\"stepper__value\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"servings value display\" data-reason=\"number is re-derived from user stepper actions rather than authored\">2</span>\n<button aria-label=\"One more serving\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"increase servings button\" type=\"button\">+</button>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-1-2-2-3\" data-name=\"kcal per serving row\">\n<label class=\"sub-label\" data-kid=\"1-1-2-2-3-1\" data-name=\"kcal per serving label\" for=\"dlg-kcal\">kcal per serving <em class=\"optional\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"optional field hint\">optional</em></label>\n<input class=\"input input--sm\" data-kid=\"1-1-2-2-3-2\" data-name=\"kcal per serving numeric input\" id=\"dlg-kcal\" inputmode=\"numeric\" type=\"text\" value=\"600\"/>\n</div>\n<div class=\"row\" data-kid=\"1-1-2-2-4\" data-name=\"max minutes row\">\n<label class=\"sub-label\" data-kid=\"1-1-2-2-4-1\" data-name=\"max minutes label\" for=\"dlg-minutes\">Max minutes <em class=\"optional\" data-kid=\"1-1-2-2-4-1-1\" data-name=\"optional field hint\">optional</em></label>\n<input class=\"input input--sm\" data-kid=\"1-1-2-2-4-2\" data-name=\"max minutes numeric input\" id=\"dlg-minutes\" inputmode=\"numeric\" type=\"text\" value=\"30\"/>\n</div>\n</div>\n</div>\n<div class=\"sheet__foot\" data-kid=\"1-1-3\" data-name=\"dialog footer bar\">\n<a class=\"quiet\" data-kid=\"1-1-3-1\" data-name=\"sign out link\" href=\"/sign-in\">Sign out</a>\n<button class=\"save\" data-kid=\"1-1-3-2\" data-name=\"save diet primary button\" type=\"button\">Save Diet</button>\n</div>\n</div>\n</div>",
      "comments": [],
      "created": "2026-11-19T05:36:23.427006+00:00",
      "modified": "2026-11-19T05:39:49.668912+00:00",
      "id": "var_e698064075a5"
    },
    "var_64043b0f59ad": {
      "type": "variant",
      "label": "Pantry 3 — generating: record locked, cupboard pending",
      "parentId": "var_e698064075a5",
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n    --destructive-foreground: light-dark(oklch(0.985 0.014 95), oklch(0.190 0.045 20));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-20: calc(var(--spacing) * 20);\n    --page-measure: 72rem;\n    --space-page: var(--space-5);\n  }\n  @media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); line-height: var(--leading-body); }\n  h1, p, ul { margin: 0; }\n  ul { list-style: none; padding: 0; }\n  a { color: inherit; }\n  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }\n  svg { display: block; }\n  :focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  .wrap { inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n  .app-head { border-block-end: var(--border-width-thin) solid var(--border); }\n  .deck { block-size: 72px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  .wordmark { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .nav { display: flex; align-items: center; gap: var(--space-7); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .nav a { text-decoration: none; }\n  .nav a[aria-current=\"page\"] { color: var(--foreground); font-weight: 700; }\n\n  .band { background: var(--primary); color: var(--primary-foreground); border-block-end: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 58%, var(--foreground)); }\n  .band__deck { min-block-size: 112px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }\n  .title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .count { margin-block-start: var(--space-2); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: color-mix(in oklab, var(--primary-foreground) 88%, var(--primary)); }\n  .action { display: inline-flex; align-items: center; gap: var(--space-3); min-block-size: 48px; padding-inline: var(--space-6); border-radius: var(--radius); background: var(--primary-foreground); color: var(--primary); font-size: var(--text-sm); font-weight: 700; letter-spacing: 0.01em; white-space: nowrap; }\n  .action--locked { background: color-mix(in oklab, var(--primary-foreground) 14%, var(--primary)); color: color-mix(in oklab, var(--primary-foreground) 78%, var(--primary)); border: var(--border-width-thin) solid color-mix(in oklab, var(--primary-foreground) 34%, var(--primary)); cursor: default; }\n\n  .work { display: grid; grid-template-columns: minmax(0, 1fr) 400px; min-block-size: 764px; padding-block: var(--space-8); }\n  .editor { display: flex; flex-direction: column; min-block-size: 0; min-inline-size: 0; padding-inline-end: var(--space-8); }\n  .diet { border-inline-start: var(--border-width-thin) solid var(--border); padding-inline-start: var(--space-8); }\n\n  .label { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .sub-label { font-size: var(--text-xs); letter-spacing: 0.02em; color: var(--muted-foreground); }\n\n  .entry__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .input { inline-size: 100%; min-block-size: 44px; padding-inline: var(--space-3); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-ui); }\n  .input::placeholder { color: var(--muted-foreground); }\n  .input:disabled { background: color-mix(in oklab, var(--muted) 62%, var(--background)); border-color: var(--border); color: var(--muted-foreground); }\n  .add { min-block-size: 44px; padding-inline: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: var(--secondary); color: var(--secondary-foreground); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }\n  .add:disabled { background: color-mix(in oklab, var(--muted) 62%, var(--background)); color: var(--muted-foreground); }\n  .hint { margin-block-start: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  .chips { display: flex; flex-wrap: wrap; align-content: flex-start; gap: var(--space-2); min-block-size: 128px; margin-block-start: var(--space-5); padding: var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: color-mix(in oklab, var(--card) 52%, var(--background)); }\n  .chip { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 36px; padding-inline: var(--space-3); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: var(--muted); color: var(--foreground); font-size: var(--text-sm); line-height: var(--leading-ui); }\n  .chips .chip { background: color-mix(in oklab, var(--muted) 54%, var(--background)); color: var(--muted-foreground); }\n  .chip__cooked { padding: 2px var(--space-1); border: var(--border-width-thin) solid var(--border); border-radius: 2px; background: color-mix(in oklab, var(--muted) 70%, var(--background)); color: var(--muted-foreground); font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }\n\n  .pending { display: grid; grid-template-columns: 260px minmax(0, 1fr); align-items: center; gap: var(--space-6); block-size: 260px; margin-block-start: var(--space-5); padding: var(--space-5); border: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 62%, var(--foreground)); border-radius: var(--radius-lg); background: color-mix(in oklab, var(--primary) 30%, var(--card)); }\n  .pending__art { inline-size: 260px; block-size: 150px; }\n  .pending__status { font-size: var(--text-base); font-weight: 700; line-height: var(--leading-ui); }\n  .pending__count { margin-block-start: var(--space-2); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: color-mix(in oklab, var(--foreground) 66%, var(--primary)); }\n\n  .guide { margin-block-start: var(--space-5); border-block-start: var(--border-width-thin) solid var(--border); }\n  .guide summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: 48px; list-style: none; font-size: var(--text-sm); color: var(--muted-foreground); }\n  .guide summary::-webkit-details-marker { display: none; }\n\n  .diet__head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }\n  .diet__name { margin-block-start: var(--space-1); font-family: var(--font-display); font-size: var(--text-lg); line-height: var(--leading-tight); }\n  .quiet { font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--muted-foreground) 45%, transparent); text-underline-offset: 3px; }\n  .group { margin-block-start: var(--space-5); }\n  .group + .group { padding-block-start: var(--space-5); border-block-start: var(--border-width-thin) solid var(--border); }\n  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block-start: var(--space-2); }\n  .tag { min-block-size: 28px; display: inline-flex; align-items: center; padding-inline: var(--space-2); border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 30%, var(--border)); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--accent) 9%, var(--card)); color: color-mix(in oklab, var(--accent) 58%, var(--foreground)); font-size: var(--text-xs); }\n  .tag--plain { border-color: var(--border); background: color-mix(in oklab, var(--muted) 62%, var(--background)); color: var(--muted-foreground); }\n  .field { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); margin-block-start: var(--space-3); }\n  .optional { margin-inline-start: var(--space-1); color: color-mix(in oklab, var(--muted-foreground) 78%, transparent); font-style: normal; }\n  .stepper { display: inline-flex; align-items: center; border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--muted) 62%, var(--background)); overflow: hidden; }\n  .stepper button { inline-size: 32px; block-size: 32px; display: grid; place-items: center; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted-foreground); }\n  .stepper__value { min-inline-size: 32px; text-align: center; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted-foreground); }\n  .input--sm { min-block-size: 32px; inline-size: 96px; padding-inline: var(--space-2); font-family: var(--font-mono); font-size: var(--text-sm); text-align: end; }\n  .rule { margin-block-start: var(--space-6); padding-block-start: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); font-size: var(--text-xs); color: var(--muted-foreground); line-height: var(--leading-ui); }\n</style>\n<header class=\"app-head\" data-kid=\"1\" data-name=\"app header\">\n<div class=\"wrap deck\" data-kid=\"1-1\" data-name=\"header bar with lockup and navigation\">\n<a class=\"lockup\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"/\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"llama head brand icon\" height=\"32\" viewbox=\"0 0 32 32\" width=\"32\">\n<g class=\"mk-hat\"><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"App\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"app navigation\">\n<a aria-current=\"page\" data-kid=\"1-1-2-1\" data-name=\"active pantry nav link\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" data-name=\"saved nav link\" href=\"/saved\">Saved</a>\n<a data-kid=\"1-1-2-3\" data-name=\"account nav link\" href=\"/account\">Account</a>\n</nav>\n</div>\n</header>\n<section aria-labelledby=\"pantry-title\" class=\"band\" data-kid=\"2\" data-name=\"page title band\">\n<div class=\"wrap band__deck\" data-kid=\"2-1\" data-name=\"page title band content\">\n<div data-kid=\"2-1-1\" data-name=\"title block\">\n<h1 class=\"title\" data-kid=\"2-1-1-1\" data-name=\"page headline\" id=\"pantry-title\">Pantry</h1>\n<p class=\"count\" data-kid=\"2-1-1-2\" data-name=\"ingredient count text\">9 / 16 ingredients</p>\n</div>\n<button aria-describedby=\"pending-status\" class=\"action action--locked\" data-kid=\"2-1-2\" data-name=\"locked generate recipe button\" disabled=\"\" type=\"button\">\n<span data-kid=\"2-1-2-1\" data-name=\"button status label\" id=\"pending-status\">Generating recipe</span>\n</button>\n</div>\n</section>\n<main class=\"wrap work\" data-kid=\"3\" data-name=\"main pantry layout grid\">\n<section aria-label=\"Pantry ingredients, locked while generating\" class=\"editor\" data-kid=\"3-1\" data-name=\"ingredients editor section\">\n<div class=\"entry\" data-kid=\"3-1-1\" data-name=\"ingredient add form\">\n<label class=\"label\" data-kid=\"3-1-1-1\" data-name=\"add ingredient field label\" for=\"ingredient\">Add ingredient</label>\n<div class=\"entry__row\" data-kid=\"3-1-1-2\" data-name=\"input row\">\n<input class=\"input\" data-kid=\"3-1-1-2-1\" data-name=\"disabled ingredient text input with example placeholder\" disabled=\"\" id=\"ingredient\" placeholder=\"e.g. leftover rice, firm tofu\" type=\"text\" value=\"\"/>\n<button class=\"add\" data-kid=\"3-1-1-2-2\" data-name=\"disabled add button\" disabled=\"\" type=\"button\">Add</button>\n</div>\n<p class=\"hint\" data-kid=\"3-1-1-3\" data-name=\"input hint text\">One per entry. Paste a list to add several.</p>\n</div>\n<ul aria-label=\"9 ingredients\" class=\"chips\" data-kid=\"3-1-2\" data-name=\"ingredient chip list\">\n<li class=\"chip\" data-kid=\"3-1-2-1\" data-name=\"day-old rice ingredient chip\"><span data-kid=\"3-1-2-1-1\" data-name=\"chip ingredient name text\">day-old rice</span><span class=\"chip__cooked\" data-kid=\"3-1-2-1-2\" data-name=\"chip cooked state badge\">cooked</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-2\" data-name=\"firm tofu ingredient chip\"><span data-kid=\"3-1-2-2-1\" data-name=\"chip ingredient name text\">firm tofu</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-3\" data-name=\"soy sauce ingredient chip\"><span data-kid=\"3-1-2-3-1\" data-name=\"chip ingredient name text\">soy sauce</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-4\" data-name=\"sesame oil ingredient chip\"><span data-kid=\"3-1-2-4-1\" data-name=\"chip ingredient name text\">sesame oil</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-5\" data-name=\"spring onion ingredient chip\"><span data-kid=\"3-1-2-5-1\" data-name=\"chip ingredient name text\">spring onion</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-6\" data-name=\"garlic ingredient chip\"><span data-kid=\"3-1-2-6-1\" data-name=\"chip ingredient name text\">garlic</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-7\" data-name=\"ginger ingredient chip\"><span data-kid=\"3-1-2-7-1\" data-name=\"chip ingredient name text\">ginger</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-8\" data-name=\"carrot ingredient chip\"><span data-kid=\"3-1-2-8-1\" data-name=\"chip ingredient name text\">carrot</span></li>\n<li class=\"chip\" data-kid=\"3-1-2-9\" data-name=\"cavolo nero ingredient chip\"><span data-kid=\"3-1-2-9-1\" data-name=\"chip ingredient name text\">cavolo nero</span></li>\n</ul>\n<div class=\"pending\" data-kid=\"3-1-3\" data-name=\"recipe generating status panel\" role=\"status\">\n<svg aria-hidden=\"true\" class=\"pending__art\" data-kid=\"3-1-3-1\" data-name=\"illustrative pantry scene icon\" viewbox=\"0 0 260 150\">\n<g fill=\"none\" stroke=\"var(--foreground)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n<rect fill=\"var(--card)\" height=\"134\" rx=\"4\" width=\"248\" x=\"6\" y=\"8\"></rect>\n<rect fill=\"var(--primary)\" height=\"118\" rx=\"2\" width=\"102\" x=\"14\" y=\"16\"></rect>\n<path d=\"M14 46h102M14 104h102\"></path>\n<rect fill=\"var(--foreground)\" height=\"20\" rx=\"1.5\" stroke=\"none\" width=\"5\" x=\"100\" y=\"64\"></rect>\n<path d=\"M126 16v118M126 56h118M126 100h118\"></path>\n<rect fill=\"var(--background)\" height=\"28\" rx=\"2\" width=\"26\" x=\"140\" y=\"28\"></rect>\n<path d=\"M140 34h26\"></path>\n<rect fill=\"color-mix(in oklab, var(--accent) 22%, var(--card))\" height=\"32\" rx=\"2\" width=\"30\" x=\"176\" y=\"24\"></rect>\n<path d=\"M176 31h30\"></path>\n<rect fill=\"var(--background)\" height=\"22\" rx=\"2\" width=\"22\" x=\"216\" y=\"34\"></rect>\n<path d=\"M216 39h22\"></path>\n<rect fill=\"var(--background)\" height=\"28\" rx=\"2\" width=\"18\" x=\"138\" y=\"72\"></rect>\n<rect fill=\"color-mix(in oklab, var(--primary) 42%, var(--card))\" height=\"32\" rx=\"2\" width=\"22\" x=\"164\" y=\"68\"></rect>\n<path d=\"M164 75h22\"></path>\n<path d=\"M198 84h44v10a14 14 0 0 1-14 14h-16a14 14 0 0 1-14-14z\" fill=\"var(--card)\"></path>\n<path d=\"M198 90h44\"></path>\n<rect fill=\"color-mix(in oklab, var(--accent) 14%, var(--card))\" height=\"22\" rx=\"3\" width=\"56\" x=\"138\" y=\"112\"></rect>\n<path d=\"M138 120h56M152 120v14M172 120v14\"></path>\n<rect fill=\"var(--background)\" height=\"26\" rx=\"3\" width=\"34\" x=\"206\" y=\"108\"></rect>\n<path d=\"M206 116h34\"></path>\n</g>\n</svg>\n<div data-kid=\"3-1-3-2\" data-name=\"status text block\">\n<p class=\"pending__status\" data-kid=\"3-1-3-2-1\" data-name=\"generating status text\">Generating recipe</p>\n<p class=\"pending__count\" data-kid=\"3-1-3-2-2\" data-name=\"generating ingredient count text\">9 ingredients</p>\n</div>\n</div>\n<details class=\"guide\" data-kid=\"3-1-4\" data-name=\"how-to guide details toggle\">\n<summary data-kid=\"3-1-4-1\" data-name=\"guide summary toggle\">\n<span data-kid=\"3-1-4-1-1\" data-name=\"guide summary title text\">How to get the most out of Chef Llama</span>\n<svg aria-hidden=\"true\" data-kid=\"3-1-4-1-2\" data-name=\"open/close chevron icon\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M2 4.5L6 8.5l4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg>\n</summary>\n</details>\n</section>\n<aside aria-labelledby=\"diet-label\" class=\"diet\" data-kid=\"3-2\" data-name=\"diet settings sidebar\">\n<div class=\"diet__head\" data-kid=\"3-2-1\" data-name=\"diet header\">\n<div data-kid=\"3-2-1-1\" data-name=\"diet name block\">\n<p class=\"label\" data-kid=\"3-2-1-1-1\" data-name=\"diet section label\" id=\"diet-label\">Diet</p>\n<p class=\"diet__name\" data-kid=\"3-2-1-1-2\" data-name=\"selected diet name\">Home</p>\n</div>\n<span class=\"quiet\" data-kid=\"3-2-1-2\" data-name=\"edit diet link\">Edit Diet</span>\n</div>\n<div class=\"group\" data-kid=\"3-2-2\" data-name=\"hard limits group\">\n<p class=\"label\" data-kid=\"3-2-2-1\" data-name=\"hard limits group label\">Hard limits</p>\n<p class=\"sub-label\" data-kid=\"3-2-2-2\" data-name=\"flags sublabel\" style=\"margin-block-start: var(--space-3)\">Flags</p>\n<ul class=\"tags\" data-kid=\"3-2-2-3\" data-name=\"diet flag tags\">\n<li class=\"tag\" data-kid=\"3-2-2-3-1\" data-name=\"vegan diet tag\">vegan</li>\n<li class=\"tag\" data-kid=\"3-2-2-3-2\" data-name=\"gluten free diet tag\">gluten free</li>\n</ul>\n<p class=\"sub-label\" data-kid=\"3-2-2-4\" data-name=\"allergies sublabel\" style=\"margin-block-start: var(--space-4)\">Allergies</p>\n<ul class=\"tags\" data-kid=\"3-2-2-5\" data-name=\"allergy tags list\">\n<li class=\"tag tag--plain\" data-kid=\"3-2-2-5-1\" data-name=\"sesame allergy tag\">sesame</li>\n<li class=\"tag tag--plain\" data-kid=\"3-2-2-5-2\" data-name=\"peanut allergy tag\">peanut</li>\n</ul>\n</div>\n<div class=\"group\" data-kid=\"3-2-3\" data-name=\"cook preferences group\">\n<p class=\"label\" data-kid=\"3-2-3-1\" data-name=\"this cook group label\">This cook</p>\n<div class=\"field\" data-kid=\"3-2-3-2\" data-name=\"servings field\" style=\"margin-block-start: var(--space-3)\">\n<span class=\"sub-label\" data-kid=\"3-2-3-2-1\" data-name=\"servings field label\">Servings</span>\n<div aria-hidden=\"true\" class=\"stepper\" data-kid=\"3-2-3-2-2\" data-name=\"servings stepper\">\n<span class=\"stepper__value\" data-kid=\"3-2-3-2-2-1\" data-name=\"decrement button\">−</span>\n<span class=\"stepper__value\" data-kid=\"3-2-3-2-2-2\" data-name=\"servings value display\">2</span>\n<span class=\"stepper__value\" data-kid=\"3-2-3-2-2-3\" data-name=\"increment button\">+</span>\n</div>\n</div>\n<div class=\"field\" data-kid=\"3-2-3-3\" data-name=\"kcal per serving field\">\n<span class=\"sub-label\" data-kid=\"3-2-3-3-1\" data-name=\"kcal per serving label\">kcal per serving <em class=\"optional\" data-kid=\"3-2-3-3-1-1\" data-name=\"optional qualifier text\">optional</em></span>\n<input aria-label=\"kcal per serving\" class=\"input input--sm\" data-kid=\"3-2-3-3-2\" data-name=\"disabled kcal input\" disabled=\"\" type=\"text\" value=\"600\"/>\n</div>\n<div class=\"field\" data-kid=\"3-2-3-4\" data-name=\"max minutes field\">\n<span class=\"sub-label\" data-kid=\"3-2-3-4-1\" data-name=\"max minutes label\">Max minutes <em class=\"optional\" data-kid=\"3-2-3-4-1-1\" data-name=\"optional qualifier text\">optional</em></span>\n<input aria-label=\"Max minutes\" class=\"input input--sm\" data-kid=\"3-2-3-4-2\" data-name=\"disabled max minutes input\" disabled=\"\" type=\"text\" value=\"30\"/>\n</div>\n</div>\n<p class=\"rule\" data-kid=\"3-2-4\" data-name=\"rule explanation text\">Pantry ingredients override the Diet for this cook.</p>\n</aside>\n</main>",
