      "html": "<style>\n:root {\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.968 0.026 88), oklch(0.185 0.020 40));\n  --foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --card: light-dark(oklch(0.994 0.008 88), oklch(0.235 0.022 40));\n  --card-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --popover: var(--card);\n  --popover-foreground: var(--card-foreground);\n  --secondary: light-dark(oklch(0.940 0.038 86), oklch(0.262 0.024 42));\n  --secondary-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --muted: light-dark(oklch(0.936 0.034 86), oklch(0.258 0.022 42));\n  --muted-foreground: light-dark(oklch(0.470 0.040 48), oklch(0.745 0.032 80));\n  --primary: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --primary-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 32));\n  --accent: light-dark(oklch(0.520 0.150 138), oklch(0.780 0.140 138));\n  --accent-foreground: light-dark(oklch(0.985 0.010 90), oklch(0.200 0.040 138));\n  --destructive: light-dark(oklch(0.480 0.185 22), oklch(0.660 0.170 22));\n  --destructive-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 22));\n  --border: light-dark(oklch(0.885 0.030 70), oklch(0.330 0.022 45));\n  --input: light-dark(oklch(0.865 0.032 68), oklch(0.350 0.024 45));\n  --ring: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --chart-gift: light-dark(oklch(0.600 0.155 138), oklch(0.800 0.130 138));\n  --chart-credit: light-dark(oklch(0.460 0.165 25), oklch(0.560 0.150 25));\n  --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n  --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n  --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n  --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n  --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-tight: 1.2;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --text-3xl: calc(var(--font-base) * 2.125);\n  --text-4xl: calc(var(--font-base) * 2.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-11: calc(var(--spacing) * 11);\n  --space-12: calc(var(--spacing) * 12);\n  --space-13: calc(var(--spacing) * 13);\n  --space-14: calc(var(--spacing) * 14);\n  --space-15: calc(var(--spacing) * 15);\n  --space-16: calc(var(--spacing) * 16);\n  --space-17: calc(var(--spacing) * 17);\n  --space-18: calc(var(--spacing) * 18);\n  --space-19: calc(var(--spacing) * 19);\n  --space-20: calc(var(--spacing) * 20);}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n</style><style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans);font-size: var(--text-sm);line-height:1.45}\n.sheet{\n  padding-block: var(--space-9) var(--space-14); box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n.plate{background:var(--card);border:var(--border-width-thin) solid var(--border);border-radius:12px;overflow:hidden}\n\n.bar{display:flex;align-items:center;gap: var(--space-7);block-size:60px;padding: 0 var(--space-11);border-block-end:var(--border-width-thin) solid var(--border)}\n.wordmark{font-family:var(--font-display);font-size: var(--text-lg);font-weight:700;letter-spacing: var(--tracking-display)}\n.nav{display:flex;gap: var(--space-5);margin-inline-start: var(--space-2)}\n.nav a{font-family:var(--font-sans);font-size: var(--text-xs);color:var(--muted-foreground);text-decoration:none;padding: var(--space-1) 0}\n.nav a[aria-current]{color:var(--foreground);box-shadow:inset 0 -2px 0 var(--primary)}\n.av{margin-inline-start:auto;display:grid;place-items:center;inline-size:28px;block-size:28px;border-radius:50%;border:var(--border-width-thin) solid var(--border);background:var(--secondary);font-family:var(--font-sans);font-size: var(--text-2xs);font-weight:600;color:var(--muted-foreground)}\n\n.doc{padding: var(--space-9) var(--space-11) var(--space-10)}\n.dish{font-family:var(--font-display);font-weight:400;font-size: var(--text-4xl);line-height:1.04;letter-spacing: -0.015em;margin:0;max-inline-size:19ch}\n.note{font-family:var(--font-sans);font-size: var(--text-base);line-height:1.6;color:var(--muted-foreground);margin: var(--space-4) 0 0;max-inline-size:58ch}\n\n.meta{display:grid;grid-template-columns:repeat(6,minmax(0,auto));justify-content:start;column-gap: var(--space-11);margin: var(--space-7) 0 0;padding: var(--space-4) 0 var(--space-4);border-block-start:var(--border-width-thin) solid var(--border);border-block-end:var(--border-width-thin) solid var(--border)}\n.meta dt{font-family:var(--font-sans);font-size: var(--text-2xs);font-weight:600;letter-spacing: 0.12em;text-transform:uppercase;color:var(--muted-foreground);margin:0}\n.meta dd{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-sm);margin: var(--space-1) 0 0}\n\n.body{display:grid;grid-template-columns:294px minmax(0,1fr);column-gap: var(--space-13);margin-top: var(--space-9)}\nh2{font-family:var(--font-sans);font-size: var(--text-sm);font-weight:600;letter-spacing: -0.005em;margin: 0 0 var(--space-1)}\n\n.ings{list-style:none;margin:0;padding:0}\n.ing{display:grid;grid-template-columns:62px minmax(0,1fr);column-gap: var(--space-4);padding: var(--space-2) 0 var(--space-3);border-block-end:var(--border-width-thin) solid var(--border)}\n.ing:first-child{border-block-start:var(--border-width-thin) solid var(--border)}\n.ing__q{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-sm);line-height:1.5}\n.ing__i{font-family:var(--font-sans);font-size: var(--text-base);line-height:1.5}\n\n.pantry{margin-top: var(--space-6);background:var(--secondary);border-radius:6px;padding: var(--space-3) var(--space-4) var(--space-4)}\n.pantry__l{font-family:var(--font-sans);font-size: var(--text-2xs);font-weight:600;letter-spacing: 0.12em;text-transform:uppercase;color:var(--muted-foreground);margin: 0 0 var(--space-3)}\n.chips{display:flex;flex-wrap:wrap;gap: var(--space-2);margin:0;padding:0;list-style:none}\n.chip{font-family:var(--font-sans);font-size: var(--text-xs);line-height:1;padding: var(--space-2) var(--space-2);border:var(--border-width-thin) dashed var(--border);border-radius:4px;background:var(--background)}\n\n.method{margin:0;padding:0;list-style:none}\n.step{display:grid;grid-template-columns:34px minmax(0,1fr);column-gap: var(--space-5);padding: var(--space-4) 0 var(--space-4);border-block-start:var(--border-width-thin) solid var(--border)}\n.step:last-child{border-block-end:var(--border-width-thin) solid var(--border)}\n.step__n{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-xs);line-height:1.9;color:var(--muted-foreground)}\n.step__t{font-family:var(--font-sans);font-size: var(--text-base);line-height:1.66;max-inline-size:38em}\n\n.docfoot{display:flex;align-items:center;justify-content:space-between;gap: var(--space-6);margin-top: var(--space-8);padding-top: var(--space-5);border-block-start:var(--border-width-thin) solid var(--border)}\n.gen{font-family:var(--font-sans);font-size: var(--text-xs);color:var(--muted-foreground);margin:0}\n.acts{display:flex;gap: var(--space-3)}\n.btn{display:inline-flex;align-items:center;block-size:38px;padding: 0 var(--space-5);border-radius:6px;border:var(--border-width-thin) solid transparent;font-family:var(--font-sans);font-size: var(--text-sm);font-weight:600;text-decoration:none;white-space:nowrap}\n.btn--fill{background:var(--primary);color:var(--primary-foreground)}\n.btn--ghost{border-color:var(--border);color:var(--foreground)}\n\n.key{display:flex;flex-wrap:wrap;gap: var(--space-1) var(--space-4);margin: var(--space-4) 2px 0;font-family:var(--font-mono);font-size: var(--text-2xs);line-height:1.6;color:var(--muted-foreground)}\n.key b{font-weight:400;color:var(--foreground)}\n.key em{font-style:normal;font-family:var(--font-sans);font-size: var(--text-xs);color:var(--foreground);margin-inline-end:2px}\n</style>\n<div class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"plate\" data-kid=\"1-1\" data-name=\"recipe document card panel\">\n<header class=\"bar\" data-kid=\"1-1-1\" data-name=\"top app bar\">\n<span class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"site wordmark logo\">Chef Llama</span>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to pantry page\" href=\"#\">Pantry</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to recipes page current\" href=\"#\">Recipes</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to saved items\" href=\"#\">Saved</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link to dashboard\" href=\"#\">Dashboard</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link to billing page\" href=\"#\">Billing</a>\n</nav>\n<span aria-hidden=\"true\" class=\"av\" data-kid=\"1-1-1-3\" data-name=\"user initials avatar\">AR</span>\n</header>\n<main class=\"doc\" data-kid=\"1-1-2\" data-name=\"recipe document main content\">\n<h1 class=\"dish\" data-kid=\"1-1-2-1\" data-name=\"recipe title headline\">Kūmara, chickpea and silverbeet traybake</h1>\n<p class=\"note\" data-kid=\"1-1-2-2\" data-name=\"recipe intro note text\">One tray and a 200 °C oven. The silverbeet goes in at the end, in two goes, so the stems cook through and the leaves only wilt.</p>\n<dl class=\"meta\" data-kid=\"1-1-2-3\" data-name=\"recipe metadata grid\">\n<div data-kid=\"1-1-2-3-1\" data-name=\"metadata cell for total time\"><dt data-kid=\"1-1-2-3-1-1\" data-name=\"metadata label total time\">Total</dt><dd data-kid=\"1-1-2-3-1-2\" data-name=\"metadata value total time\">40 min</dd></div>\n<div data-kid=\"1-1-2-3-2\" data-name=\"metadata cell for prep time\"><dt data-kid=\"1-1-2-3-2-1\" data-name=\"metadata label prep time\">Prep</dt><dd data-kid=\"1-1-2-3-2-2\" data-name=\"metadata value prep time\">15 min</dd></div>\n<div data-kid=\"1-1-2-3-3\" data-name=\"metadata cell for calories per serving\"><dt data-kid=\"1-1-2-3-3-1\" data-name=\"metadata label per serving calories\">Per serving</dt><dd data-kid=\"1-1-2-3-3-2\" data-name=\"metadata value calories per serving\">620 kcal</dd></div>\n<div data-kid=\"1-1-2-3-4\" data-name=\"metadata cell for serving count\"><dt data-kid=\"1-1-2-3-4-1\" data-name=\"metadata label serves\">Serves</dt><dd data-kid=\"1-1-2-3-4-2\" data-name=\"metadata value serves count\">4</dd></div>\n<div data-kid=\"1-1-2-3-5\" data-name=\"metadata cell for pantry items\"><dt data-kid=\"1-1-2-3-5-1\" data-name=\"metadata label from pantry\">From pantry</dt><dd data-kid=\"1-1-2-3-5-2\" data-name=\"metadata value pantry items count\">8 items</dd></div>\n<div data-kid=\"1-1-2-3-6\" data-name=\"metadata cell for cost\"><dt data-kid=\"1-1-2-3-6-1\" data-name=\"metadata label cost\">Cost</dt><dd data-kid=\"1-1-2-3-6-2\" data-name=\"metadata value cost\">1 Credit</dd></div>\n</dl>\n<div class=\"body\" data-kid=\"1-1-2-4\" data-name=\"recipe body two column container\">\n<section aria-labelledby=\"ings-h\" data-kid=\"1-1-2-4-1\" data-name=\"ingredients section\">\n<h2 data-kid=\"1-1-2-4-1-1\" data-name=\"ingredients section heading\" id=\"ings-h\">Ingredients</h2>\n<ul class=\"ings\" data-kid=\"1-1-2-4-1-2\" data-name=\"ingredients list\">\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"ingredient row for kūmara\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-1-1\" data-name=\"ingredient quantity\">800 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-1-2\" data-name=\"ingredient name kūmara chunks\">kūmara, cut into 3 cm chunks</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"ingredient row for chickpeas\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-2-1\" data-name=\"ingredient quantity chickpeas\">400 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-2-2\" data-name=\"ingredient name chickpeas\">chickpeas, drained</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-3\" data-name=\"ingredient row for olive oil\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-3-1\" data-name=\"ingredient quantity olive oil\">2 tbsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-3-2\" data-name=\"ingredient name olive oil\">olive oil</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-4\" data-name=\"ingredient row for smoked paprika\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-4-1\" data-name=\"ingredient quantity smoked paprika\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-4-2\" data-name=\"ingredient name smoked paprika\">smoked paprika</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-5\" data-name=\"ingredient row for garlic\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-5-1\" data-name=\"ingredient quantity garlic\">3</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-5-2\" data-name=\"ingredient name garlic\">cloves garlic, sliced</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-6\" data-name=\"ingredient row for silverbeet\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-6-1\" data-name=\"ingredient quantity silverbeet\">1 bunch</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-6-2\" data-name=\"ingredient name silverbeet\">silverbeet, stems sliced, leaves torn</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-7\" data-name=\"ingredient row for lemon\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-7-1\" data-name=\"ingredient quantity lemon\">1</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-7-2\" data-name=\"ingredient name lemon\">lemon, zest and juice</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-8\" data-name=\"ingredient row for feta\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-8-1\" data-name=\"ingredient quantity feta\">120 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-8-2\" data-name=\"ingredient name feta\">feta, crumbled</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-9\" data-name=\"ingredient row for flaky salt\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-9-1\" data-name=\"ingredient quantity flaky salt\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-9-2\" data-name=\"ingredient name flaky salt\">flaky salt</span></li>\n</ul>\n<div class=\"pantry\" data-kid=\"1-1-2-4-1-3\" data-name=\"pantry items callout box\">\n<p class=\"pantry__l\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"pantry callout heading\">From your pantry</p>\n<ul class=\"chips\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"pantry item chips list\">\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-1\" data-name=\"pantry item chip kūmara\">kūmara</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-2\" data-name=\"pantry item chip chickpeas\">chickpeas</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-3\" data-name=\"pantry item chip silverbeet\">silverbeet</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-4\" data-name=\"pantry item chip garlic\">garlic</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-5\" data-name=\"pantry item chip lemon\">lemon</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-6\" data-name=\"pantry item chip feta\">feta</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-7\" data-name=\"pantry item chip olive oil\">olive oil</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-8\" data-name=\"pantry item chip smoked paprika\">smoked paprika</li>\n</ul>\n</div>\n</section>\n<section aria-labelledby=\"method-h\" data-kid=\"1-1-2-4-2\" data-name=\"method section\">\n<h2 data-kid=\"1-1-2-4-2-1\" data-name=\"method section heading\" id=\"method-h\">Method</h2>\n<ol class=\"method\" data-kid=\"1-1-2-4-2-2\" data-name=\"method steps list\">\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"method step one row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"step number one\">01</span><span class=\"step__t\" data-dynamic=\"true\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"step instruction text one\" data-reason=\"text replaced by typewriter effect script\">Heat the oven to 200 °C fan and line a large tray.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"method step two row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"step number two\">02</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"step instruction text two\">Toss the kūmara with the olive oil, smoked paprika and salt, spread it in one layer, and roast for 20 minutes until the edges darken.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-3\" data-name=\"method step three row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-3-1\" data-name=\"step number three\">03</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-3-2\" data-name=\"step instruction text three\">Push the kūmara to one side of the tray, add the chickpeas and garlic to the bare side, and roast for 10 minutes more.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-4\" data-name=\"method step four row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-4-1\" data-name=\"step number four\">04</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-4-2\" data-name=\"step instruction text four\">Fold the sliced silverbeet stems through and return the tray for 4 minutes; they should give when pressed with the back of a spoon.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-5\" data-name=\"method step five row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-5-1\" data-name=\"step number five\">05</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-5-2\" data-name=\"step instruction text five\">Take the tray out and fold the torn leaves through in three handfuls. The residual heat wilts them without flattening them.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-6\" data-name=\"method step six row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-6-1\" data-name=\"step number six\">06</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-6-2\" data-name=\"step instruction text six\">Scatter over the feta, then the lemon zest and juice. Rest 5 minutes and serve from the tray.</span></li>\n</ol>\n</section>\n</div>\n<footer class=\"docfoot\" data-kid=\"1-1-2-5\" data-name=\"recipe document footer bar\">\n<p class=\"gen\" data-kid=\"1-1-2-5-1\" data-name=\"recipe generation timestamp text\">Generated 17 November 2026, 9:41 am</p>\n<div class=\"acts\" data-kid=\"1-1-2-5-2\" data-name=\"footer actions button group\">\n<a class=\"btn btn--ghost\" data-kid=\"1-1-2-5-2-1\" data-name=\"ghost button change ingredient\" href=\"#\">Change an ingredient</a>\n<a class=\"btn btn--fill\" data-kid=\"1-1-2-5-2-2\" data-name=\"primary save recipe button\" href=\"#\">Save recipe</a>\n</div>\n</footer>\n</main>\n</div>\n<p class=\"key\" data-kid=\"1-2\" data-name=\"typographic key caption\"><em data-kid=\"1-2-1\" data-name=\"key caption bold lead-in\">3 families.</em> name <b data-kid=\"1-2-2\" data-name=\"key geometric serif sample name\">Georgia</b> · headnote, method, nav, buttons, section headings, labels, chips, timestamp <b data-kid=\"1-2-3\" data-name=\"key humanist serif sample name\">Humanist</b> · quantities, step numbers, meta values <b data-kid=\"1-2-4\" data-name=\"key monospace sample name\">Mono</b></p>\n</div>\n",
