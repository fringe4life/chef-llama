    "var_d46090fb3409": {
      "type": "variant",
      "label": "T1 — Worktop pair, two rails on one band",
      "parentId": "var_a7850d5082d6",
      "themeId": null,
      "rect": {
        "x": 15999,
        "y": 0,
        "w": 1160,
        "h": 1067
      },
      "html": "<style>\n@property --p{ syntax: \"<percentage>\"; inherits: true; initial-value: 0%; }\n\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n\n  --ease-glide: linear(0, 0.002 3.125%, 0.01 6.25%, 0.022 9.375%, 0.039 12.5%, 0.085 18.75%, 0.148 25%, 0.211 30.273%, 0.282 35.547%, 0.368 41.479%, 0.643 59.277%, 0.756 67.188%, 0.843 74.219%, 0.881 77.734%, 0.915 81.25%, 0.951 85.938%, 0.978 90.625%, 0.994 95.313%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.092 41.3%, 1.117 46%, 1.13 51%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --duration-quick: 160ms;\n  --duration-base: 240ms;\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nbutton{ font: inherit; color: inherit; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n.sheet{ padding-block: var(--space-7) var(--space-10); }\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: 1px solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.block{ display: grid; gap: var(--space-4); margin-block-start: var(--space-8); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.screen{ display: grid; overflow: hidden; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-lg); }\n.bar{ border-block-end: 1px solid var(--border); }\n.bar__in{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 58px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); color: inherit; text-decoration: none; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: flex; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.steps{ border-block-end: 1px solid var(--border); }\n.steps__in{ display: flex; align-items: stretch; gap: var(--space-5); }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 42px; font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none; border-block-end: 2px solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-size: var(--text-2xs); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--primary-text); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n.page{ display: grid; gap: var(--space-5); padding-block: var(--space-5) var(--space-6); }\n.shelf{ display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); }\n.shelf__label{ display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.shelf__facts{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.field{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.lb{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.req{ display: inline-block; inline-size: 6px; block-size: 6px; background: var(--primary-text); border-radius: 1px; }\n.input{ inline-size: 100%; min-block-size: 38px; padding: 0 var(--space-3); border: 1px solid var(--input); border-radius: var(--radius-sm); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); }\n\n.worktop{ display: grid; gap: var(--space-6) var(--space-10); padding-block: var(--space-6); border-block: 1px solid var(--border); }\n@media (width >= 46rem){ .worktop{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }\n\n/* control: 68px track, 6px rule, 28 × 52 handle */\n.ctl{ --p: 0%; --trk-h: 68px; --rail-y: 34px; --pad: 14px;\n  display: grid; gap: var(--space-2); min-inline-size: 0;\n  transition: --p var(--duration-base) var(--ease-glide); }\n.ctl:has(.rng:active){ transition: --p 40ms linear; }\n@starting-style{ .ctl{ --p: 0%; } }\n.ctl__row{ display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }\n.fig{ font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); font-variant-numeric: tabular-nums; }\n\n.trk{ position: relative; block-size: var(--trk-h); }\n.trk__scale{ position: absolute; inset-inline: var(--pad); inset-block: 0; }\n.rail{ position: absolute; inset-inline: 0; inset-block-start: var(--rail-y); block-size: 6px; border: 1px solid color-mix(in oklab, var(--input) 62%, var(--foreground)); border-radius: 3px; background: color-mix(in oklab, var(--border) 55%, var(--card)); transition: box-shadow var(--duration-quick) var(--ease-squish); }\n.fill{ position: absolute; inset-inline-start: 0; inset-block-start: var(--rail-y); block-size: 6px; inline-size: 100%; border-radius: 3px; background: var(--primary);\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent calc(var(--p) + 8px));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent calc(var(--p) + 8px)); }\n.edge{ position: absolute; inset-inline-start: var(--p); inset-block-start: var(--rail-y); inline-size: 1px; block-size: 6px; background: color-mix(in oklab, var(--primary) 58%, var(--foreground)); }\n.pegs{ position: absolute; inset-inline: 0; inset-block-start: calc(var(--rail-y) - 13px); block-size: 10px; }\n.peg{ position: absolute; inset-block-start: 0; inset-inline-start: calc(var(--at) * 1%); inline-size: 1px; block-size: 100%; background: color-mix(in oklab, var(--muted-foreground) 52%, var(--card)); transform: translateX(-0.5px); }\n.grads{ position: absolute; inset-inline: 0; inset-block-start: calc(var(--rail-y) + 8px); block-size: 10px;\n  background-image: repeating-linear-gradient(to right, var(--tk-major) 0 1px, transparent 1px 10%), repeating-linear-gradient(to right, var(--tk-minor) 0 1px, transparent 1px 2.5%);\n  background-size: 100% 10px, 100% 5px; background-position: left bottom, left bottom; background-repeat: repeat-x;\n  --tk-major: color-mix(in oklab, var(--muted-foreground) 68%, var(--card));\n  --tk-minor: color-mix(in oklab, var(--muted-foreground) 32%, var(--card)); }\n.grads--in{ --tk-major: color-mix(in oklab, var(--background) 86%, var(--primary)); --tk-minor: color-mix(in oklab, var(--background) 70%, var(--primary));\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent var(--p));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent var(--p)); }\n.scale{ position: relative; block-size: 14px; margin-inline: var(--pad); }\n.mark{ position: absolute; inset-inline-start: calc(var(--at) * 1%); transform: translateX(-50%); font-family: var(--font-mono); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n.mark:first-child{ transform: none; }\n.mark:last-child{ transform: translateX(-100%); }\n\n/* brass plate, gradient only */\n.rng{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: grab; z-index: 3; }\n.rng:active{ cursor: grabbing; }\n.rng::-webkit-slider-runnable-track{ block-size: var(--trk-h); background: transparent; border: 0; }\n.rng::-webkit-slider-thumb{\n  -webkit-appearance: none;\n  inline-size: 22px; block-size: 56px;\n  margin-block-start: calc((var(--trk-h) - 56px) / 2);\n  border: 1px solid oklch(0.42 0.085 64 / 0.50);\n  border-radius: 3px;\n  background-color: transparent;\n  background-image: linear-gradient(90deg,\n    oklch(0.910 0.100 94) 0%,\n    oklch(0.855 0.145 88) 17%,\n    oklch(0.735 0.158 77) 50%,\n    oklch(0.855 0.145 88) 83%,\n    oklch(0.910 0.100 94) 100%);\n  background-repeat: no-repeat; background-size: 100% 100%;\n  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.55), inset 0 -1px 0 oklch(0.38 0.06 58 / 0.24), 0 2px 0 oklch(0.33 0.05 62 / 0.14), 0 0 0 1px oklch(0.42 0.085 64 / 0.08);\n  transition: transform var(--duration-quick) var(--ease-squish), box-shadow var(--duration-quick) var(--ease-squish);\n}\n.rng::-moz-range-track{ block-size: var(--trk-h); background: transparent; border: 0; }\n.rng::-moz-range-thumb{ inline-size: 22px; block-size: 56px; border: 1px solid oklch(0.42 0.085 64 / 0.50); border-radius: 3px;\n  background-image: linear-gradient(90deg, oklch(0.910 0.100 94) 0%, oklch(0.855 0.145 88) 17%, oklch(0.735 0.158 77) 50%, oklch(0.855 0.145 88) 83%, oklch(0.910 0.100 94) 100%);\n  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.55), inset 0 -1px 0 oklch(0.38 0.06 58 / 0.24), 0 2px 0 oklch(0.33 0.05 62 / 0.14); }\n\n.rng:hover::-webkit-slider-thumb{ transform: translateY(-1px); }\n.rng:active::-webkit-slider-thumb{ transform: translateY(1px) scaleY(1.05); }\n.rng:focus-visible::-webkit-slider-thumb{ box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.60), 0 0 0 2px var(--ring), 0 0 0 4px var(--background); }\n.trk:has(.rng:active) .rail{ box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent); }\n.trk:has(.rng:focus-visible) .rail{ box-shadow: 0 0 0 2px var(--ring), 0 0 0 4px var(--background); }\n\n.foot{ display: flex; align-items: center; justify-content: flex-end; gap: var(--space-3); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-5); border-radius: var(--radius); border: 1px solid var(--border); background: transparent; font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; }\n.btn--quiet{ border-color: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n\n@media (prefers-reduced-motion: reduce){\n  .ctl{ transition: none; }\n  .rng::-webkit-slider-thumb{ transition: none; }\n  .rail{ transition: none; }\n}\n</style>\n<div class=\"frame sheet\" data-kid=\"1\">\n<header class=\"head\" data-kid=\"1-1\">\n<h1 data-kid=\"1-1-1\">T1 — Worktop pair</h1>\n<p class=\"facts\" data-kid=\"1-1-2\"><span data-kid=\"1-1-2-1\">12 stops</span><span data-kid=\"1-1-2-2\">300–1200 kcal</span><span data-kid=\"1-1-2-3\">Step 50</span><span data-kid=\"1-1-2-4\" data-name=\"handle size spec fact\">Handle 22 × 56</span></p>\n</header>\n<section class=\"block\" data-kid=\"1-2\">\n<h2 data-kid=\"1-2-1\">In the Diet step</h2>\n<div class=\"screen\" data-kid=\"1-2-2\">\n<header class=\"bar\" data-kid=\"1-2-2-1\"><div class=\"frame bar__in\" data-kid=\"1-2-2-1-1\">\n<a class=\"lockup\" data-kid=\"1-2-2-1-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-2-2-1-1-1-1\" height=\"26\" viewbox=\"0 0 32 32\" width=\"26\"><g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g><circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle><g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g></svg>\n<span class=\"wordmark\" data-kid=\"1-2-2-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-2-2-1-1-2\"><span data-kid=\"1-2-2-1-1-2-1\">Pantry</span><span data-kid=\"1-2-2-1-1-2-2\">Saved</span><span data-kid=\"1-2-2-1-1-2-3\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"1-2-2-2\"><div class=\"frame steps__in\" data-kid=\"1-2-2-2-1\">\n<a class=\"step step--done\" data-kid=\"1-2-2-2-1-1\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-1-1\">1</span>Devices</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"1-2-2-2-1-2\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-2-1\">2</span>Diet</a>\n<a class=\"step\" data-kid=\"1-2-2-2-1-3\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-3-1\">3</span>Staples</a>\n<a class=\"step\" data-kid=\"1-2-2-2-1-4\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-4-1\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"1-2-2-3\">\n<header class=\"shelf\" data-kid=\"1-2-2-3-1\"><div class=\"shelf__label\" data-kid=\"1-2-2-3-1-1\">\n<h2 class=\"shelf__h\" data-kid=\"1-2-2-3-1-1-1\">Diet</h2>\n<p class=\"shelf__facts\" data-kid=\"1-2-2-3-1-1-2\">First cook</p>\n</div></header>\n<div class=\"field\" data-kid=\"1-2-2-3-2\">\n<label class=\"lb\" data-kid=\"1-2-2-3-2-1\" for=\"t1-name\">Diet name <span class=\"req\" data-kid=\"1-2-2-3-2-1-1\"></span></label>\n<input class=\"input\" data-kid=\"1-2-2-3-2-2\" id=\"t1-name\" type=\"text\" value=\"Home\"/>\n</div>\n<div class=\"worktop\" data-kid=\"1-2-2-3-3\">\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"1-2-2-3-3-1\" style=\"--p:27.2727%\">\n<div class=\"ctl__row\" data-kid=\"1-2-2-3-3-1-1\"><span class=\"caps\" data-kid=\"1-2-2-3-3-1-1-1\">Servings</span></div>\n<p class=\"fig\" data-kid=\"1-2-2-3-3-1-2\"><output data-kid=\"1-2-2-3-3-1-2-1\">4</output></p>\n<div class=\"trk\" data-kid=\"1-2-2-3-3-1-3\">\n<div class=\"trk__scale\" data-kid=\"1-2-2-3-3-1-3-1\">\n<span class=\"rail\" data-kid=\"1-2-2-3-3-1-3-1-1\"></span>\n<span class=\"pegs\" data-kid=\"1-2-2-3-3-1-3-1-2\"><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-1\" style=\"--at:0\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-2\" style=\"--at:9.0909\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-3\" style=\"--at:18.1818\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-4\" style=\"--at:27.2727\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-5\" style=\"--at:36.3636\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-6\" style=\"--at:45.4545\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-7\" style=\"--at:54.5455\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-8\" style=\"--at:63.6364\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-9\" style=\"--at:72.7273\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-10\" style=\"--at:81.8182\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-11\" style=\"--at:90.9091\"></span><span class=\"peg\" data-kid=\"1-2-2-3-3-1-3-1-2-12\" style=\"--at:100\"></span></span>\n<span class=\"fill\" data-kid=\"1-2-2-3-3-1-3-1-3\"></span>\n<span class=\"edge\" data-kid=\"1-2-2-3-3-1-3-1-4\"></span>\n</div>\n<input aria-label=\"Servings\" class=\"rng\" data-kid=\"1-2-2-3-3-1-3-2\" max=\"12\" min=\"1\" oninput=\"t1(this)\" step=\"1\" type=\"range\" value=\"4\"/>\n</div>\n<div class=\"scale\" data-kid=\"1-2-2-3-3-1-4\">\n<span class=\"mark\" data-kid=\"1-2-2-3-3-1-4-1\" style=\"--at:0\">1</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-1-4-2\" style=\"--at:27.2727\">4</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-1-4-3\" style=\"--at:54.5455\">7</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-1-4-4\" style=\"--at:81.8182\">10</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-1-4-5\" style=\"--at:100\">12</span>\n</div>\n</div>\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"1-2-2-3-3-2\" style=\"--p:44.4444%\">\n<div class=\"ctl__row\" data-kid=\"1-2-2-3-3-2-1\"><span class=\"caps\" data-kid=\"1-2-2-3-3-2-1-1\">kcal per serving</span></div>\n<p class=\"fig\" data-kid=\"1-2-2-3-3-2-2\"><output data-kid=\"1-2-2-3-3-2-2-1\">700</output></p>\n<div class=\"trk\" data-kid=\"1-2-2-3-3-2-3\">\n<div class=\"trk__scale\" data-kid=\"1-2-2-3-3-2-3-1\">\n<span class=\"rail\" data-kid=\"1-2-2-3-3-2-3-1-1\"></span>\n<span class=\"fill\" data-kid=\"1-2-2-3-3-2-3-1-2\"></span>\n<span class=\"edge\" data-kid=\"1-2-2-3-3-2-3-1-3\"></span>\n<span class=\"grads\" data-kid=\"1-2-2-3-3-2-3-1-4\"></span>\n<span class=\"grads grads--in\" data-kid=\"1-2-2-3-3-2-3-1-5\"></span>\n</div>\n<input aria-label=\"kcal per serving\" class=\"rng\" data-kid=\"1-2-2-3-3-2-3-2\" max=\"1200\" min=\"300\" oninput=\"t1(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div class=\"scale\" data-kid=\"1-2-2-3-3-2-4\">\n<span class=\"mark\" data-kid=\"1-2-2-3-3-2-4-1\" style=\"--at:0\">300</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-2-4-2\" style=\"--at:16.6667\">Light</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-2-4-3\" style=\"--at:44.4444\">Standard</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-2-4-4\" style=\"--at:77.7778\">Hearty</span>\n<span class=\"mark\" data-kid=\"1-2-2-3-3-2-4-5\" style=\"--at:100\">1200</span>\n</div>\n</div>\n</div>\n<div class=\"foot\" data-kid=\"1-2-2-3-4\">\n<button class=\"btn btn--quiet\" data-kid=\"1-2-2-3-4-1\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"1-2-2-3-4-2\" type=\"button\">Save Diet</button>\n</div>\n</main>\n</div>\n</section>\n</div>\n<script>\nfunction t1(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n}\n</script>",
