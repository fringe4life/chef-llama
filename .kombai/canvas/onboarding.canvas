 var(--primary-foreground); }\n.chip:hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.chip:active{ --surface: var(--muted); transform: translateY(1px); }\n.chip:has(input:checked){ border-color: var(--primary); }\n.chip:has(input:checked) .chip__wash{ clip-path: circle(150% at calc(var(--pad-x) + var(--slot) / 2) 50%); transition: clip-path var(--duration-base) var(--ease-arrive), background-color var(--duration-tick) var(--ease-linear); }\n.chip:has(input:checked) .chip__pocket{ background: transparent; animation: pocket-seal var(--duration-quick) var(--ease-squish) both; }\n.chip:has(input:checked) .chip__pocket::before{ background: transparent; }\n.chip:has(input:checked) .chip__tick{ animation: tick-draw var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n.chip:has(input:checked):hover .chip__wash{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n@keyframes pocket-seal{ from{ transform: scale(0.62); } to{ transform: scale(1); } }\n@keyframes tick-draw{ from{ stroke-dashoffset: 17; } to{ stroke-dashoffset: 0; } }\n\n/* the consequence, one line, under the decision */\n.consequence{ display: grid; gap: var(--space-2) var(--space-8); align-items: baseline; padding-block-end: var(--space-3); border-block-end: 1px solid var(--border); }\n@media (width >= 56rem){ .consequence{ grid-template-columns: 132px minmax(0,1fr) auto; } }\n.consequence__text{ font-size: var(--text-xs); line-height: var(--leading-ui); white-space: nowrap; }\n.swap{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--text-2xs); }\n.swap__arrow{ color: var(--muted-foreground); }\n.swap__why{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.rule{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.rule b{ font-weight: 700; color: var(--foreground); }\n\n.actions{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 44px; padding: 0 var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--border); background: transparent; font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; transition: background-color var(--duration-tick) var(--ease-linear), transform var(--duration-quick) var(--ease-squish); }\n.btn:active{ transform: translateY(1px); }\n.btn--quiet{ border-color: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--quiet:hover{ background: var(--muted); color: var(--foreground); }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n.btn--primary:hover{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n\n@media (prefers-reduced-motion: reduce){\n  .tile, .tile::before, .part, .tick, .chip, .ctl, .btn, .rng::-webkit-slider-thumb, .rail{ transition: none; }\n  .chip__pocket, .chip__tick{ animation: none; }\n  .chip:has(input:checked) .chip__tick{ stroke-dashoffset: 0; }\n  .in:checked + .tile .part{ animation: none; }\n}\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" data-name=\"hidden shared SVG symbol sprite\" focusable=\"false\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\"><path d=\"M2.4 6.6c1.2 1.2 2.4 2.4 3.5 3.6 2-3.1 4-6 5.5-7.7\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.1\"></path></symbol>\n<symbol id=\"b-vegan\" viewbox=\"0 0 24 24\">\n<path d=\"M12 21.2c0-4.8.6-8.6 1.8-11.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n</symbol>\n<symbol id=\"p-vegan\" viewbox=\"0 0 24 24\">\n<path d=\"M13.4