s=\"input input--add\" data-kid=\"4-4-5\" data-name=\"custom allergy text input\" placeholder=\"Another allergy\" type=\"text\"/>\n</div>\n<div class=\"pair\" data-kid=\"4-5\" data-name=\"servings field block\">\n<label class=\"field__label\" data-kid=\"4-5-1\" data-name=\"servings label\" for=\"d5-serv\">Servings</label>\n<span class=\"ob\" data-kid=\"4-5-2\" data-name=\"scale badge\">Scale</span>\n<div class=\"note\" data-kid=\"4-5-3\" data-name=\"servings note container\">\n<p class=\"note__p\" data-kid=\"4-5-3-1\" data-name=\"servings note text\"><b data-kid=\"4-5-3-1-1\" data-name=\"servings note emphasized text\">Every quantity in the Recipe follows it.</b> A dish for four uses twice the ingredients of the same dish for two.</p>\n</div>\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"4-5-4\" data-name=\"servings slider control\" style=\"--p:27.2727%\">\n<p class=\"fig\" data-kid=\"4-5-4-1\" data-name=\"servings value readout heading\"><output data-dynamic=\"true\" data-kid=\"4-5-4-1-1\" data-name=\"servings value number\" data-reason=\"output text replaced by rail() script from the range input value on input\">4</output></p>\n<div class=\"trk\" data-kid=\"4-5-4-2\" data-name=\"servings slider track\">\n<div class=\"trk__scale\" data-kid=\"4-5-4-2-1\" data-name=\"slider scale markup\">\n<span class=\"rail\" data-kid=\"4-5-4-2-1-1\" data-name=\"slider rail background\"></span>\n<span class=\"pegs\" data-kid=\"4-5-4-2-1-2\" data-name=\"slider tick pegs container\"><span class=\"peg\" data-kid=\"4-5-4-2-1-2-1\" data-name=\"servings tick peg\" style=\"--at:0\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-2\" data-name=\"servings tick peg\" style=\"--at:9.0909\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-3\" data-name=\"servings tick peg\" style=\"--at:18.1818\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-4\" data-name=\"servings tick peg\" style=\"--at:27.2727\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-5\" data-name=\"servings tick peg\" style=\"--at:36.3636\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-6\" data-name=\"servings tick peg\" style=\"--at:45.4545\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-7\" data-name=\"servings tick peg\" style=\"--at:54.5455\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-8\" data-name=\"servings tick peg\" style=\"--at:63.6364\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-9\" data-name=\"servings tick peg\" style=\"--at:72.7273\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-10\" data-name=\"servings tick peg\" style=\"--at:81.8182\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-11\" data-name=\"servings tick peg\" style=\"--at:90.9091\"></span><span class=\"peg\" data-kid=\"4-5-4-2-1-2-12\" data-name=\"servings tick peg\" style=\"--at:100\"></span></span>\n<span class=\"fill\" data-kid=\"4-5-4-2-1-3\" data-name=\"slider progress fill\"></span>\n<span class=\"edge\" data-kid=\"4-5-4-2-1-4\" data-name=\"slider position edge marker\"></span>\n</div>\n<input class=\"rng\" data-kid=\"4-5-4-2-2\" data-name=\"servings range input\" id=\"d5-serv\" max=\"12\" min=\"1\" oninput=\"rail(this)\" step=\"1\" type=\"range\" value=\"4\"/>\n</div>\n<div class=\"scale\" data-kid=\"4-5-4-3\" data-name=\"servings number scale\">\n<span class=\"mark\" data-kid=\"4-5-4-3-1\" data-name=\"servings scale mark\" style=\"--at:0\">1</span><span class=\"mark\" data-kid=\"4-5-4-3-2\" data-name=\"servings scale mark\" style=\"--at:27.2727\">4</span><span class=\"mark\" data-kid=\"4-5-4-3-3\" data-name=\"servings scale mark\" style=\"--at:54.5455\">7</span><span class=\"mark\" data-kid=\"4-5-4-3-4\" data-name=\"servings scale mark\" style=\"--at:81.8182\">10</span><span class=\"mark\" data-kid=\"4-5-4-3-5\" data-name=\"servings scale mark\" style=\"--at:100\">12</span>\n</div>\n</div>\n</div>\n<div class=\"pair\" data-kid=\"4-6\" data-name=\"kcal field block\">\n<label class=\"field__label\" data-kid=\"4-6-1\" data-name=\"kcal per serving label\" for=\"d5-kcal\">kcal per serving</label>\n<span class=\"ob\" data-kid=\"4-6-2\" data-name=\"optional target badge\">Optional target</span>\n<div class=\"note\" data-kid=\"4-6-3\" data-name=\"kcal note container\">\n<p class=\"note__p\" data-kid=\"4-6-3-1\" data-name=\"kcal note text\"><b data-kid=\"4-6-3-1-1\" data-name=\"kcal note emphasized text\">A target, not a limit.</b> A Recipe may come in over it. What a person needs moves with age, body size and how active they are; an adult's evening meal lands near 700.</p>\n</div>\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"4-6-4\" data-name=\"kcal slider control\" style=\"--p:44.4444%\">\n<p class=\"fig\" data-kid=\"4-6-4-1\" data-name=\"kcal value readout heading\"><output data-dynamic=\"true\" data-kid=\"4-6-4-1-1\" data-name=\"kcal value number\" data-reason=\"output text replaced by rail() script from the range input value on input\">700</output></p>\n<div class=\"trk\" data-kid=\"4-6-4-2\" data-name=\"kcal slider track\">\n<div class=\"trk__scale\" data-kid=\"4-6-4-2-1\" data-name=\"slider scale markup\">\n<span class=\"rail\" data-kid=\"4-6-4-2-1-1\" data-name=\"slider rail background\"></span>\n<span class=\"fill\" data-kid=\"4-6-4-2-1-2\" data-name=\"slider progress fill\"></span>\n<span class=\"edge\" data-kid=\"4-6-4-2-1-3\" data-name=\"slider position edge marker\"></span>\n<span class=\"grads\" data-kid=\"4-6-4-2-1-4\" data-name=\"slider tick marks\"></span>\n<span class=\"grads grads--in\" data-kid=\"4-6-4-2-1-5\" data-name=\"slider masked tick marks\"></span>\n</div>\n<input class=\"rng\" data-kid=\"4-6-4-2-2\" data-name=\"kcal range input\" id=\"d5-kcal\" max=\"1200\" min=\"300\" oninput=\"rail(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div class=\"scale\" data-kid=\"4-6-4-3\" data-name=\"kcal number scale\">\n<span class=\"mark\" data-kid=\"4-6-4-3-1\" data-name=\"kcal scale mark\" style=\"--at:0\">300</span><span class=\"mark\" data-kid=\"4-6-4-3-2\" data-name=\"kcal scale mark\" style=\"--at:16.6667\">Light</span><span class=\"mark\" data-kid=\"4-6-4-3-3\" data-name=\"kcal scale mark\" style=\"--at:44.4444\">Standard</span><span class=\"mark\" data-kid=\"4-6-4-3-4\" data-name=\"kcal scale mark\" style=\"--at:77.7778\">Hearty</span><span class=\"mark\" data-kid=\"4-6-4-3-5\" data-name=\"kcal scale mark\" style=\"--at:100\">1200</span>\n</div>\n</div>\n</div>\n<div class=\"actions\" data-kid=\"4-7\" data-name=\"action buttons row\">\n<button class=\"btn btn--quiet\" data-kid=\"4-7-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"4-7-2\" data-name=\"save diet primary button\" type=\"button\">Save Diet</button>\n</div>\n</main>\n<script>\nfunction rail(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n}\n</script>",
      "comments": [],
      "created": "2026-11-24T20:31:58.877971+00:00",
      "modified": "2026-11-26T01:45:24.707108+00:00",
      "id": "var_e2b526c93007"
    },
    "var_9eb82776e647": {
      "type": "variant",
      "label": "Tile — one shell, tick and rank",
      "parentId": "var_2bf18cda5e0c",
      "themeId": null,
      "rect": {
        "x": 32650,
        "y": 0,
        "w": 1215,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --accent-text: color-mix(in oklab, var(--accent) 60%, var(--foreground));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --box-line: color-mix(in oklab, var(--input) 74%, var(--foreground));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n\n  --ease-arrive: linear(0, 0.264 6.25%, 0.482 12.5%, 0.647 18.75%, 0.765 25%, 0.876 34.375%, 0.937 43.75%, 0.98 57.813%, 0.998 78.906%, 1);\n  --ease-depart: linear(0, 0.002 21.094%, 0.02 42.188%, 0.063 56.25%, 0.124 65.625%, 0.235 75%, 0.353 81.25%, 0.518 87.5%, 0.736 93.75%, 1);\n  --ease-glide: linear(0, 0.002 3.125%, 0.022 9.375%, 0.085 18.75%, 0.148 25%, 0.282 35.547%, 0.643 59.277%, 0.843 74.219%, 0.915 81.25%, 0.978 90.625%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.117 46%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --ease-linear: linear(0, 1);\n  --duration-tick: 100ms;\n  --duration-quick: 160ms;\n  --duration-base: 250ms;\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,h3,p,ol,ul,figure,figcaption,table{ margin: 0; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\ncode{ font-family: var(--font-mono); font-size: 0.94em; color: var(--primary-text); }\n\n.sheet{ padding-block: var(--space-6) var(--space-10); display: grid; gap: var(--space-10); }\n.bar{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); }\n.head{ display: grid; gap: var(--space-2); padding-block-start: var(--space-4); border-block-start: 1px solid var(--border); }\nh1{ font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.lede{ display: grid; gap: var(--space-1); max-inline-size: 78ch; font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.block{ display: grid; gap: var(--space-4); }\n.block__head{ display: grid; gap: var(--space-1); padding-block-end: var(--space-3); border-block-end: 1px solid var(--border); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.block__head p{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); max-inline-size: 92ch; }\n\n/* ── the shell ───────────────────────────────────────────────────────── */\n.tile{\n  --slot: 20px;\n  --slot-inset: var(--space-2);\n  --fill-x: calc(100% - var(--slot-inset) - var(--slot) / 2);\n  --fill-y: calc(var(--slot-inset) + var(--slot) / 2);\n  --mark-size: 40px; --sw: 1.5; --sw-s: 1.3;\n  --surface: var(--card);\n  --food: color-mix(in oklab, var(--primary) 66%, var(--foreground));\n  --leaf: var(--accent-text);\n  --steam: color-mix(in oklab, var(--foreground) 44%, var(--background));\n  position: relative; overflow: hidden;\n  display: grid; justify-items: center; align-content: center;\n  gap: var(--space-2); min-block-size: 92px; padding: var(--space-3) var(--space-2);\n  border: 1px solid var(--border); border-radius: var(--radius-sm);\n  background: var(--surface); color: var(--foreground);\n  cursor: pointer;\n  transition: background-color var(--duration-tick) var(--ease-linear),\n              border-color var(--duration-tick) var(--ease-linear),\n              transform var(--duration-quick) var(--ease-squish);\n}\n.tile::before{\n  content: \"\"; position: absolute; inset: 0; z-index: 0; background: var(--primary);\n  clip-path: circle(0% at var(--fill-x) var(--fill-y));\n  transition: clip-path var(--duration-quick) var(--ease-depart);\n}\n.tile:hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.tile:active{ --surface: var(--muted); transform: translateY(1px); }\n.tile input{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n.tile:has(input:focus-visible){ outline: 2px solid var(--ring); outline-offset: 2px; }\n\n.tile.is-on{\n  border-color: var(--primary); color: var(--primary-foreground);\n  --food: color-mix(in oklab, var(--background) 82%, var(--primary));\n  --leaf: color-mix(in oklab, var(--accent) 76%, var(--primary-foreground));\n  --steam: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n}\n.tile.is-on::before{\n  clip-path: circle(150% at var(--fill-x) var(--fill-y));\n  transition: clip-path var(--duration-base) var(--ease-arrive);\n}\n.tile.is-on:hover{ --surface: var(--card); border-color: color-mix(in oklab, var(--primary) 82%, var(--foreground)); }\n.tile.is-limit{ border-style: dashed; color: var(--muted-foreground); --surface: var(--card); }\n.tile.is-limit .ic{ opacity: 0.55; }\n.tile.is-limit:hover{ --surface: var(--card); border-color: var(--border); }\n.tile.is-limit .pocket{ background: color-mix(in oklab, var(--input) 55%, transparent); }\n\n/* static states, drawn for the register */\n.tile.is-hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.tile.is-press{ --surface: var(--muted); transform: translateY(1px); }\n.tile.is-focus{ outline: 2px solid var(--ring); outline-offset: 2px; }\n.tile.is-fill40::before{ clip-path: circle(40% at var(--fill-x) var(--fill-y)); transition: none; }\n.tile.is-static{ cursor: default; }\n\n/* the mark: two or three layers, paint published by the shell */\n.ic{ position: relative; z-index: 2; display: block; flex: none; inline-size: var(--mark-size); block-size: var(--mark-size); }\n.lay{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }\n.part{ transform-origin: var(--org, 50% 50%); transition: transform var(--duration-base) var(--ease-glide); }\n.tend{ opacity: 0; transition: opacity var(--duration-tick) var(--ease-linear); }\n.tile:hover .part, .tile:has(input:focus-visible) .part, .tile.is-hover .part, .tile.is-focus .part{ transform: var(--pose); }\n.tile.is-on .part{ transform: var(--hold); }\n.tile.is-on .tend{ opacity: 1; animation: rise 1500ms cubic-bezier(0.2,0.6,0.3,1) var(--sd, 0ms) infinite; }\n\n.tile__name{\n  position: relative; z-index: 2;\n  font-size: var(--text-2xs); line-height: var(--leading-tight);\n  text-align: center; text-wrap: balance;\n  transition: color var(--duration-tick) var(--ease-linear);\n}\n.tile.is-on .tile__name{ font-weight: 700; }\n\n/* the slot: the numeral's and the tick's one address */\n.tile__slot{\n  position: absolute; z-index: 3;\n  inset-block-start: var(--slot-inset); inset-inline-end: var(--slot-inset);\n  display: grid; place-items: center;\n  inline-size: var(--slot); block-size: var(--slot);\n  color: var(--primary-foreground);\n}\n.pocket{ position: absolute; inset: 0; background: var(--box-line);\n  clip-path: polygon(4% 2%, 98% 6%, 99% 94%, 2% 99%);\n  transition: background-color var(--duration-tick) var(--ease-linear); }\n.pocket::before{ content: \"\"; position: absolute; inset: 1px; background: var(--surface); clip-path: inherit;\n  transition: background-color var(--duration-tick) var(--ease-linear); }\n\n/* tick: the glyph draws over a pocket that clears */\n.ind-tick{ position: relative; z-index: 1; inline-size: 11px; block-size: 11px; overflow: visible;\n  stroke-dasharray: 17; stroke-dashoffset: 17; }\n.tile.is-on .ind--tick .pocket{ background: transparent; }\n.tile.is-on .ind--tick .pocket::before{ background: transparent; }\n.tile.is-on .ind--tick .ind-tick{ animation: tick-draw var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n@keyframes tick-draw{ from{ stroke-dashoffset: 17; } to{ stroke-dashoffset: 0; } }\n\n/* rank: the pocket inverts and the numeral seals in */\n.ind-num{ position: relative; z-index: 1; font-family: var(--font-mono); font-size: var(--text-2xs);\n  line-height: var(--leading-solid); font-variant-numeric: tabular-nums; color: var(--primary);\n  opacity: 0; transform: scale(0.4); }\n.tile.is-on .ind--rank .pocket{ background: var(--primary-foreground); animation: pocket-seal var(--duration-quick) var(--ease-squish) both; }\n.tile.is-on .ind--rank .pocket::before{ background: transparent; }\n.tile.is-on .ind--rank .ind-num{ animation: rank-in var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n@keyframes pocket-seal{ from{ transform: scale(0.62); } to{ transform: scale(1); } }\n@keyframes rank-in{ from{ opacity: 0; transform: scale(0.4); } to{ opacity: 1; transform: scale(1); } }\n@keyframes rise{\n  0%{ transform: translateY(8%) scaleY(0.86); opacity: 0; }\n  22%{ opacity: 0.62; }\n  100%{ transform: translateY(-22%) scaleY(1.12); opacity: 0; }\n}\n\n/* ── the bank: the count gives way, the tile does not ────────────────── */\n.bank-frame{ container: bank / inline-size; }\n.bank{ display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }\n@container bank (width >= 30rem){ .bank{ grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; } }\n@container bank (width >= 64rem){ .bank{ grid-template-columns: repeat(8, minmax(0, 1fr)); } }\n@container bank (width < 30rem){\n  .tile{ min-block-size: 96px; --mark-size: 48px; }\n  .tile__name{ font-size: var(--text-xs); }\n}\n.bank + .bank-caption{ margin-block-start: calc(var(--space-4) * -1 + var(--space-2)); }\n\n/* each mark's own travel */\n.m-vegan{ --org: 58% 46%; --pose: rotate(-7deg); --hold: rotate(-4deg); }\n.m-vegetarian{ --org: 54% 33%; --pose: rotate(-6deg); --hold: rotate(-2deg); }\n.m-pescatarian{ --org: 50% 50%; --pose: translateX(1.4px); --hold: translateX(0); }\n.m-halal{ --org: 84% 24%; --pose: scale(1.25); --hold: scale(1.12); }\n.m-gluten{ --org: 50% 50%; --pose: translate(0.6px,-0.6px); --hold: translate(-1px,-1.2px) rotate(-6deg); }\n.m-dairy{ --org: 26% 78%; --pose: rotate(-4deg); --hold: rotate(-7deg); }\n.m-keto{ --org: 50% 88%; --pose: rotate(5deg); --hold: rotate(-5deg); }\n.m-paleo{ --org: 60% 26%; --pose: rotate(-5deg); --hold: rotate(-8deg); }\n.tile.is-on .drift-sway{ animation: sway 5s ease-in-out infinite alternate; }\n.tile.is-on .drift-swim{ animation: swim 7s linear infinite; }\n.tile.is-on .drift-twinkle{ animation: twinkle 3.6s ease-in-out infinite; }\n@keyframes sway{ from{ transform: rotate(-2.5deg); } to{ transform: rotate(3.5deg); } }\n@keyframes swim{\n  0%{ transform: translate(-1.2px, 0) rotate(-3deg); }\n  25%{ transform: translate(0, -1.4px) rotate(0deg); }\n  50%{ transform: translate(1.2px, 0) rotate(3deg); }\n  75%{ transform: translate(0, 1.4px) rotate(0deg); }\n  100%{ transform: translate(-1.2px, 0) rotate(-3deg); }\n}\n@keyframes twinkle{ 0%, 100%{ transform: scale(1); opacity: 0.7; } 50%{ transform: scale(1.22); opacity: 1; } }\n.m-fry{ --mv: translateY(-9%); --sd: 0ms; }\n.m-sauce{ --mv: translateY(-13%); --sd: -240ms; }\n.m-oven{ --mv: scaleY(0.34); --org: 50% 100%; }\n.m-air{ --mv: translateY(7%); --sd: -120ms; }\n.m-slow{ --mv: translateY(-10%); --sd: -640ms; }\n.m-press{ --mv: translateY(-2.5%); --sd: -420ms; }\n.m-grill{ --mv: translateY(-8%); --sd: -880ms; }\n.m-nocook{ --mv: translateY(-6%) rotate(5deg); --org: 50% 90%; }\n.m-fry, .m-sauce, .m-oven, .m-air, .m-slow, .m-press, .m-grill, .m-nocook{ --pose: var(--mv); --hold: var(--mv); }\n\n/* ── states register ─────────────────────────────────────────────────── */\n.register{ display: grid; }\n.reg-row{ display: grid; grid-template-columns: 76px repeat(6, minmax(0, 1fr)); align-items: stretch; }\n.reg-row + .reg-row{ border-block-start: 1px solid var(--border); }\n.reg-row--head{ border-block-end: 1px solid var(--border); }\n.reg-key{ display: flex; align-items: center; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.reg-h{ padding: var(--space-2); text-align: center; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.reg-cell{ display: grid; place-items: center; padding: var(--space-3) var(--space-2); border-inline-start: 1px solid var(--border); }\n.reg-cell:first-of-type{ border-inline-start: 0; }\n.reg-cell .tile{ inline-size: 100%; min-block-size: 96px; }\n.reg-cell .tile .tile__name{ font-size: var(--text-2xs); }\n.reg-vacant{ font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--muted-foreground); }\n\n/* ── the pocket at 2.8x ──────────────────────────────────────────────── */\n.pockets{ display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--border); }\n.pocket-cell{ display: grid; justify-items: center; align-content: center; gap: var(--space-3); padding: var(--space-6) var(--space-2); border-inline-start: 1px solid var(--border); }\n.pocket-cell:first-child{ border-inline-start: 0; }\n.plate{ display: grid; place-items: center; inline-size: 112px; block-size: 84px; border-radius: var(--radius-sm); }\n.plate--off{ background: var(--card); border: 1px solid var(--border); }\n.plate--on{ background: var(--primary); }\n.zoom{ --slot: 56px; --surface: var(--card); position: relative; display: grid; place-items: center; inline-size: var(--slot); block-size: var(--slot); color: var(--primary-foreground); }\n.plate--on .zoom{ --surface: var(--primary); }\n.zoom .pocket{ position: absolute; inset: 0; }\n.zoom.is-on .pocket{ background: var(--primary-foreground); }\n.zoom.is-on .pocket::before{ background: transparent; }\n.zoom--tick.is-on .pocket{ background: transparent; }\n.zoom .ind-tick{ inline-size: 28px; block-size: 28px; }\n.zoom.is-on .ind-tick{ stroke-dashoffset: 0; }\n.zoom .ind-num{ font-size: var(--text-lg); opacity: 1; transform: none; }\n.caption{ display: flex; gap: var(--space-2); }\n.k{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n/* ── the fill ────────────────────────────────────────────────────────── */\n.fills{ display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block: 1px solid var(--border); }\n.fill-cell{ display: grid; justify-items: center; align-content: start; gap: var(--space-3); padding: var(--space-5) var(--space-3); border-inline-start: 1px solid var(--border); }\n.fill-cell:first-child{ border-inline-start: 0; }\n.fill-cell .tile{ inline-size: 100%; max-inline-size: 220px; min-block-size: 104px; }\n.fill-cell figcaption{ display: grid; gap: 2px; justify-items: center; text-align: center; }\n.fill-cell .k{ color: var(--foreground); font-weight: 700; letter-spacing: var(--tracking-tight); text-transform: none; font-size: var(--text-xs); }\n.fill-cell code{ font-size: var(--text-2xs); color: var(--muted-foreground); }\n.rule-row{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-6); font-size: var(--text-2xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.rule-row b{ color: var(--foreground); font-weight: 700; }\n\n/* ── the contract ────────────────────────────────────────────────────── */\n.contract{ display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block-start: 1px solid var(--border); }\n.contract section{ padding-block: var(--space-4) var(--space-5); border-inline-start: 1px solid var(--border); padding-inline-start: var(--space-4); }\n.contract section:first-child{ border-inline-start: 0; padding-inline-start: 0; }\n.contract h3{ margin-block-end: var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.contract ul{ padding: 0; list-style: none; display: grid; gap: var(--space-1); }\n.contract li{ font-size: var(--text-2xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.contract li b{ color: var(--foreground); font-weight: 700; }\n\n/* ── timing ──────────────────────────────────────────────────────────── */\n.timing{ display: grid; }\n.trow{ display: grid; grid-template-columns: minmax(0,1fr) 150px 170px minmax(0,1.5fr); gap: var(--space-3); align-items: center; min-block-size: 38px; }\n.trow + .trow{ border-block-start: 1px solid var(--border); }\n.trow--head{ min-block-size: 30px; border-block-end: 1px solid var(--border); }\n.th{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.tstep{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.ttok{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n.tval{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n.tnum{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); }\n\n/* a fill caught mid-travel: the pocket is still closed and the mark has not landed */\n.tile.is-filling .pocket{ background: var(--box-line); }\n.tile.is-filling .pocket::before{ background: var(--surface); }\n.tile.is-filling .ind--tick .ind-tick{ animation: none; stroke-dashoffset: 17; }\n.tile.is-filling .ind--rank .ind-num{ animation: none; opacity: 0; transform: scale(0.4); }\n\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n@media (prefers-reduced-motion: reduce){\n  .tile, .tile::before, .part, .tend, .pocket, .ind-tick{ transition: none; }\n  .pocket, .ind-num, .ind-tick{ animation: none; }\n  .tile.is-on .ind--tick .ind-tick{ stroke-dashoffset: 0; }\n  .tile.is-on .ind--rank .ind-num{ opacity: 1; transform: none; }\n  .tile.is-on .tend{ animation: none; opacity: 0; }\n  .tile.is-on .drift-sway, .tile.is-on .drift-swim, .tile.is-on .drift-twinkle{ animation: none; }\n}\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" data-name=\"hidden SVG symbol definitions library\" focusable=\"false\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\"><path d=\"M2.4 6.6c1.2 1.2 2.4 2.4 3.5 3.6 2-3.1 4-6 5.5-7.7\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.1\"></path></symbol>\n<symbol id=\"b-vegan\" viewbox=\"0 0 24 24\"><path d=\"M12 21.2c0-4.8.6-8.6 1.8-11.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path></symbol>\n<symbol id=\"p-vegan\" viewbox=\"0 0 24 24\">\n<path d=\"M13.4 12.2C7.9 13.1 4.9 10.5 5.1 5.8c5-.9 8.1 1.4 8.3 6.4z\" fill=\"var(--leaf)\"></path>\n<path d=\"M14.1 10.3c.6-4.1 3.3-6 8-5.5-.3 4.2-2.9 6.3-8 5.5z\" fill=\"var(--leaf)\"></path>\n</symbol>\n<symbol id=\"b-vegetarian\" viewbox=\"0 0 24 24\">\n<path d=\"M9.2 7.6 17.2 9.6 7.8 19.4z\" fill=\"var(--food)\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M10.4 14.1l1.7 1.2M8.9 16.9l1.7 1.2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.15\"></path>\n</symbol>\n<symbol id=\"p-vegetarian\" viewbox=\"0 0 24 24\"><g fill=\"none\" stroke=\"var(--leaf)\" stroke-linecap=\"round\" stroke-width=\"1.7\">\n<path d=\"M10.