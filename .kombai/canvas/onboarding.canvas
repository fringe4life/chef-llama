ock-start: var(--space-3)\">\n<label class=\"lb\" data-kid=\"2-1-2-3-2-1-3-3-1\" data-name=\"custom allergy field label\" for=\"b2-other\">Another allergy</label>\n<input class=\"input\" data-kid=\"2-1-2-3-2-1-3-3-2\" data-name=\"custom allergy text input\" id=\"b2-other\" placeholder=\"e.g. banana\" type=\"text\"/>\n</div>\n</fieldset>\n<p class=\"note\" data-kid=\"2-1-2-3-2-1-4\" data-name=\"form explanatory note\"><b data-kid=\"2-1-2-3-2-1-4-1\" data-name=\"note emphasis text\">Flags and allergies are hard limits.</b> kcal is a target.</p>\n</form>\n<aside class=\"frag\" data-kid=\"2-1-2-3-2-2\" data-name=\"example recipe fragment aside\">\n<div class=\"frag__head\" data-kid=\"2-1-2-3-2-2-1\" data-name=\"fragment header row\">\n<p class=\"frag__tag\" data-kid=\"2-1-2-3-2-2-1-1\" data-name=\"example tag label\">Example</p>\n<span class=\"cond\" data-kid=\"2-1-2-3-2-2-1-2\" data-name=\"example dietary condition badge\">vegetarian</span>\n</div>\n<div class=\"frag__list\" data-kid=\"2-1-2-3-2-2-2\" data-name=\"example ingredient list\">\n<p class=\"line\" data-kid=\"2-1-2-3-2-2-2-1\" data-name=\"excluded ingredient row: chicken\"><span class=\"line__n line__n--out\" data-kid=\"2-1-2-3-2-2-2-1-1\" data-name=\"excluded ingredient name (struck)\">chicken</span><span class=\"lead\" data-kid=\"2-1-2-3-2-2-2-1-2\" data-name=\"dotted leader connector\"></span><span class=\"line__s\" data-kid=\"2-1-2-3-2-2-2-1-3\" data-name=\"exclusion reason note\">breaks vegetarian</span></p>\n<p class=\"line\" data-kid=\"2-1-2-3-2-2-2-2\" data-name=\"included ingredient row: firm tofu\"><span class=\"line__n\" data-kid=\"2-1-2-3-2-2-2-2-1\" data-name=\"included ingredient name\">firm tofu</span><span class=\"lead\" data-kid=\"2-1-2-3-2-2-2-2-2\" data-name=\"dotted leader connector\"></span><span class=\"line__s line__s--in\" data-kid=\"2-1-2-3-2-2-2-2-3\" data-name=\"inclusion note: in the Recipe\">in the Recipe</span></p>\n</div>\n<p class=\"frag__note\" data-kid=\"2-1-2-3-2-2-3\" data-