bel class=\"flag\" data-kid=\"2-2-2-3-2-1-1-1-2-2\"><input data-kid=\"2-2-2-3-2-1-1-1-2-2-1\" type=\"checkbox\"/>vegan</label>\n<label class=\"flag\" data-kid=\"2-2-2-3-2-1-1-1-2-3\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-1-1-2-3-1\" type=\"checkbox\"/>vegetarian</label>\n<label class=\"flag\" data-kid=\"2-2-2-3-2-1-1-1-2-4\"><input data-kid=\"2-2-2-3-2-1-1-1-2-4-1\" type=\"checkbox\"/>gluten free</label>\n</fieldset>\n<div class=\"f\" data-kid=\"2-2-2-3-2-1-1-1-3\" data-name=\"allergy presets field\">\n<p class=\"f__label\" data-kid=\"2-2-2-3-2-1-1-1-3-1\" data-name=\"allergy field label\">Allergies <span class=\"count\" data-kid=\"2-2-2-3-2-1-1-1-3-1-1\" data-name=\"allergy count text\">2 / 15</span></p>\n<div class=\"presets\" data-kid=\"2-2-2-3-2-1-1-1-3-2\" data-name=\"allergy presets list\">\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-1\" data-name=\"allergy preset milk\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-1-1\" data-name=\"allergy preset milk checkbox\" type=\"checkbox\"/>milk</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-2\" data-name=\"allergy preset egg\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-2-1\" data-name=\"allergy preset egg checkbox\" type=\"checkbox\"/>egg</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-3\" data-name=\"allergy preset peanut\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-1-1-3-2-3-1\" data-name=\"allergy preset peanut checkbox\" type=\"checkbox\"/>peanut</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-4\" data-name=\"allergy preset tree nuts\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-4-1\" data-name=\"allergy preset tree nuts checkbox\" type=\"checkbox\"/>tree nuts</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-5\" data-name=\"allergy preset sesame\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-1-1-3-2-5-1\" data-name=\"allergy preset sesame checkbox\" type=\"checkbox\"/>sesame</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-6\" data-name=\"allergy preset soy\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-6-1\" data-name=\"allergy preset soy checkbox\" type=\"checkbox\"/>soy</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-7\" data-name=\"allergy preset wheat\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-7-1\" data-name=\"allergy preset wheat checkbox\" type=\"checkbox\"/>wheat</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-8\" data-name=\"allergy preset fish\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-8-1\" data-name=\"allergy preset fish checkbox\" type=\"checkbox\"/>fish</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-9\" data-name=\"allergy preset shellfish\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-9-1\" data-name=\"allergy preset shellfish checkbox\" type=\"checkbox\"/>shellfish</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-10\" data-name=\"allergy preset mollusc\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-10-1\" data-name=\"allergy preset mollusc checkbox\" type=\"checkbox\"/>mollusc</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-11\" data-name=\"allergy preset sulphites\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-11-1\" data-name=\"allergy preset sulphites checkbox\" type=\"checkbox\"/>sulphites</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-12\" data-name=\"allergy preset lupin\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-12-1\" data-name=\"allergy preset lupin checkbox\" type=\"checkbox\"/>lupin</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-13\" data-name=\"allergy preset celery\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-13-1\" data-name=\"allergy preset celery checkbox\" type=\"checkbox\"/>celery</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-14\" data-name=\"allergy preset mustard\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-14-1\" data-name=\"allergy preset mustard checkbox\" type=\"checkbox\"/>mustard</label>\n<label class=\"pre\" data-kid=\"2-2-2-3-2-1-1-1-3-2-15\" data-name=\"allergy preset kiwi fruit\"><input data-kid=\"2-2-2-3-2-1-1-1-3-2-15-1\" data-name=\"allergy preset kiwi fruit checkbox\" type=\"checkbox\"/>kiwi fruit</label>\n</div>\n<input aria-label=\"Another allergy\" class=\"input\" data-kid=\"2-2-2-3-2-1-1-1-3-3\" data-name=\"add custom allergy input field\" placeholder=\"Another allergy\" type=\"text\"/>\n</div>\n</div>\n<div class=\"diet__col diet__col--right\" data-kid=\"2-2-2-3-2-1-1-2\" data-name=\"step form right column\">\n<div class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-1\">\n<p class=\"row__k\" data-kid=\"2-2-2-3-2-1-1-2-1-1\">Servings</p>\n<div class=\"stepper\" data-kid=\"2-2-2-3-2-1-1-2-1-2\"><button aria-label=\"One fewer serving\" data-kid=\"2-2-2-3-2-1-1-2-1-2-1\" type=\"button\">−</button><output data-kid=\"2-2-2-3-2-1-1-2-1-2-2\">2</output><button aria-label=\"One more serving\" data-kid=\"2-2-2-3-2-1-1-2-1-2-3\" type=\"button\">+</button></div>\n</div>\n<div class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-2\">\n<p class=\"row__k\" data-kid=\"2-2-2-3-2-1-1-2-2-1\">kcal per serving <span data-kid=\"2-2-2-3-2-1-1-2-2-1-1\">optional</span></p>\n<input aria-label=\"kcal per serving\" class=\"input narrow\" data-kid=\"2-2-2-3-2-1-1-2-2-2\" type=\"text\" value=\"600\"/>\n</div>\n<p class=\"rule\" data-kid=\"2-2-2-3-2-1-1-2-3\" data-name=\"diet hard limits note\"><b data-kid=\"2-2-2-3-2-1-1-2-3-1\" data-name=\"hard limits note bold text\">Flags and allergies are hard limits.</b> kcal is a target.</p>\n</div>\n</div>\n</form>\n<aside class=\"why\" data-kid=\"2-2-2-3-2-2\">\n<p class=\"why__label\" data-kid=\"2-2-2-3-2-2-1\">What this changes</p>\n<p class=\"why__text\" data-kid=\"2-2-2-3-2-2-2\">A hard limit is never traded away. When one of your ingredients breaks it, the Recipe keeps the dish and swaps the ingredient.</p>\n<figure class=\"ex\" data-kid=\"2-2-2-3-2-2-3\">\n<div class=\"ex__row\" data-kid=\"2-2-2-3-2-2-3-1\">\n<span class=\"ex__k\" data-kid=\"2-2-2-3-2-2-3-1-1\">chicken</span>\n<span class=\"ex__v\" data-kid=\"2-2-2-3-2-2-3-1-2\">breaks vegetarian</span>\n</div>\n<div class=\"ex__row\" data-kid=\"2-2-2-3-2-2-3-2\">\n<span class=\"ex__k\" data-kid=\"2-2-2-3-2-2-3-2-1\">firm tofu</span>\n<span class=\"ex__v\" data-kid=\"2-2-2-3-2-2-3-2-2\">in the Recipe</span>\n</div>\n<figcaption class=\"ex__note\" data-kid=\"2-2-2-3-2-2-3-3\">Shown on the Recipe as a swap, so you can see what changed and why.</figcaption>\n</figure>\n</aside>\n</div>\n<div class=\"actions actions--split\" data-kid=\"2-2-2-3-3\">\n<button class=\"btn btn--quiet\" data-kid=\"2-2-2-3-3-1\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-2-2-3-3-2\" type=\"button\">Save Diet</button>\n</div>\n</main>\n</div>\n</section>\n<section class=\"flow\" data-kid=\"2-3\">\n<p class=\"label\" data-kid=\"2-3-1\">Step 3 — Staples</p>\n<div class=\"screen\" data-kid=\"2-3-2\">\n<header class=\"bar\" data-kid=\"2-3-2-1\"><div class=\"frame\" data-kid=\"2-3-2-1-1\">\n<a class=\"lockup\" data-kid=\"2-3-2-1-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"2-3-2-1-1-1-1\" height=\"28\" viewbox=\"0 0 32 32\" width=\"28\">\n<g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"2-3-2-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"2-3-2-1-1-2\"><span data-kid=\"2-3-2-1-1-2-1\">Pantry</span><span data-kid=\"2-3-2-1-1-2-2\">Saved</span><span data-kid=\"2-3-2-1-1-2-3\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"2-3-2-2\"><div class=\"frame\" data-kid=\"2-3-2-2-1\">\n<a class=\"step step--done\" data-kid=\"2-3-2-2-1-1\" href=\"#\"><span class=\"step__n\" data-kid=\"2-3-2-2-1-1-1\">1</span>Devices</a>\n<a class=\"step step--done\" data-kid=\"2-3-2-2-1-2\" href=\"#\"><span class=\"step__n\" data-kid=\"2-3-2-2-1-2-1\">2</span>Diet</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"2-3-2-2-1-3\" href=\"#\"><span class=\"step__n\" data-kid=\"2-3-2-2-1-3-1\">3</span>Staples</a>\n<a class=\"step\" data-kid=\"2-3-2-2-1-4\" href=\"#\"><span class=\"step__n\" data-kid=\"2-3-2-2-1-4-1\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"2-3-2-3\">\n<header class=\"shelf\" data-kid=\"2-3-2-3-1\" data-name=\"section header with title and count badge\">\n<div class=\"shelf__label\" data-kid=\"2-3-2-3-1-1\" data-name=\"section title card\">\n<h1 class=\"shelf__h\" data-kid=\"2-3-2-3-1-1-1\" data-name=\"section title heading\">Staples</h1>\n<p class=\"shelf__facts\" data-kid=\"2-3-2-3-1-1-2\" data-name=\"section title facts text\">5 ticked</p>\n</div>\n</header>\n<div class=\"split\" data-kid=\"2-3-2-3-2\" data-name=\"split two-column staple layout\">\n<div class=\"panel\" data-kid=\"2-3-2-3-2-1\" data-name=\"staples panel\">\n<div class=\"field__head\" data-kid=\"2-3-2-3-2-1-1\" data-name=\"staples field header\">\n<span class=\"field__label\" data-kid=\"2-3-2-3-2-1-1-1\" data-name=\"staples field label\">Things you always have</span>\n<span class=\"field__hint\" data-kid=\"2-3-2-3-2-1-1-2\" data-name=\"staples field hint text\">Ticked staples are left off the Recipe's ingredient list.</span>\n</div>\n<div class=\"staples\" data-kid=\"2-3-2-3-2-1-2\" data-name=\"staples grouped picker\">\n<div class=\"staples__col\" data-kid=\"2-3-2-3-2-1-2-1\" data-name=\"staples left column\">\n<div class=\"staples__group\" data-kid=\"2-3-2-3-2-1-2-1-1\" data-name=\"basic staples group\">\n<p class=\"f__label\" data-kid=\"2-3-2-3-2-1-2-1-1-1\" data-name=\"basic staples group label\">The basics</p>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-1-1-2\" data-name=\"salt staple option\"><input checked=\"\" data-kid=\"2-3-2-3-2-1-2-1-1-2-1\" data-name=\"salt staple selection checkbox\" type=\"checkbox\"/>salt</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-1-1-3\" data-name=\"oil staple option\"><input checked=\"\" data-kid=\"2-3-2-3-2-1-2-1-1-3-1\" data-name=\"oil staple selection checkbox\" type=\"checkbox\"/>oil</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-1-1-4\" data-name=\"water staple option\"><input data-kid=\"2-3-2-3-2-1-2-1-1-4-1\" data-name=\"water staple selection checkbox\" type=\"checkbox\"/>water</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-1-1-5\" data-name=\"pepper staple option\"><input checked=\"\" data-kid=\"2-3-2-3-2-1-2-1-1-5-1\" data-name=\"pepper staple selection checkbox\" type=\"checkbox\"/>pepper</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-1-1-6\" data-name=\"butter staple option\"><input data-kid=\"2-3-2-3-2-1-2-1-1-6-1\" data-name=\"butter staple selection checkbox\" type=\"checkbox\"/>butter</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-1-1-7\" data-name=\"sugar staple option\"><input data-kid=\"2-3-2-3-2-1-2-1-1-7-1\" data-name=\"sugar staple selection checkbox\" type=\"checkbox\"/>sugar</label>\n</div>\n<div class=\"staples__group\" data-kid=\"2-3-2-3-2-1-2-1-2\" data-name=\"custom staples group\">\n<p class=\"f__label\" data-kid=\"2-3-2-3-2-1-2-1-2-1\" data-name=\"custom staples group label\">Your own</p>\n<div class=\"mine__list\" data-kid=\"2-3-2-3-2-1-2-1-2-2\" data-name=\"custom staples list\">\n<span class=\"mine__chip\" data-kid=\"2-3-2-3-2-1-2-1-2-2-1\" data-name=\"soy sauce custom staple chip\">soy sauce<button aria-label=\"Remove soy sauce\" class=\"chip__x\" data-kid=\"2-3-2-3-2-1-2-1-2-2-1-1\" data-name=\"remove soy sauce button\" type=\"button\"><svg class=\"x\" data-kid=\"2-3-2-3-2-1-2-1-2-2-1-1-1\" data-name=\"remove soy sauce x icon\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n<span class=\"mine__chip\" data-kid=\"2-3-2-3-2-1-2-1-2-2-2\" data-name=\"stock custom staple chip\">stock<button aria-label=\"Remove stock\" class=\"chip__x\" data-kid=\"2-3-2-3-2-1-2-1-2-2-2-1\" data-name=\"remove stock button\" type=\"button\"><svg class=\"x\" data-kid=\"2-3-2-3-2-1-2-1-2-2-2-1-1\" data-name=\"remove stock x icon\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n</div>\n<input aria-label=\"Add a staple\" class=\"input\" data-kid=\"2-3-2-3-2-1-2-1-2-3\" data-name=\"add custom staple input field\" placeholder=\"Add a staple\" type=\"text\"/>\n</div>\n</div>\n<div class=\"staples__col\" data-kid=\"2-3-2-3-2-1-2-2\" data-name=\"staples right column\">\n<div class=\"staples__group\" data-kid=\"2-3-2-3-2-1-2-2-1\" data-name=\"spices group\">\n<p class=\"f__label\" data-kid=\"2-3-2-3-2-1-2-2-1-1\" data-name=\"spices group label\">Spices</p>\n<div class=\"spices\" data-kid=\"2-3-2-3-2-1-2-2-1-2\" data-name=\"spices grid\">\n<div data-kid=\"2-3-2-3-2-1-2-2-1-2-1\" data-name=\"spices grid first half\">\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-1\" data-name=\"chilli flakes spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-1-1-1\" data-name=\"chilli flakes spice selection checkbox\" type=\"checkbox\"/>chilli flakes</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-2\" data-name=\"cumin spice option\"><input checked=\"\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-2-1\" data-name=\"cumin spice selection checkbox\" type=\"checkbox\"/>cumin</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-3\" data-name=\"paprika spice option\"><input checked=\"\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-3-1\" data-name=\"paprika spice selection checkbox\" type=\"checkbox\"/>paprika</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-4\" data-name=\"oregano spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-1-4-1\" data-name=\"oregano spice selection checkbox\" type=\"checkbox\"/>oregano</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-1-5\" data-name=\"turmeric spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-1-5-1\" data-name=\"turmeric spice selection checkbox\" type=\"checkbox\"/>turmeric</label>\n</div>\n<div data-kid=\"2-3-2-3-2-1-2-2-1-2-2\" data-name=\"spices grid second half\">\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-2-1\" data-name=\"cinnamon spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-2-1-1\" data-name=\"cinnamon spice selection checkbox\" type=\"checkbox\"/>cinnamon</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-2-2\" data-name=\"curry powder spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-2-2-1\" data-name=\"curry powder spice selection checkbox\" type=\"checkbox\"/>curry powder</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-2-3\" data-name=\"garlic powder spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-2-3-1\" data-name=\"garlic powder spice selection checkbox\" type=\"checkbox\"/>garlic powder</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-2-4\" data-name=\"ginger spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-2-4-1\" data-name=\"ginger spice selection checkbox\" type=\"checkbox\"/>ginger</label>\n<label class=\"staple\" data-kid=\"2-3-2-3-2-1-2-2-1-2-2-5\" data-name=\"coriander spice option\"><input data-kid=\"2-3-2-3-2-1-2-2-1-2-2-5-1\" data-name=\"coriander spice selection checkbox\" type=\"checkbox\"/>coriander</label>\n</div>\n</div>\n</div>\n</div>\n</div>\n<p class=\"field__hint\" data-kid=\"2-3-2-3-2-1-3\" data-name=\"staples picker footer hint\">Tick what you always have, or add your own.</p>\n</div>\n<aside class=\"why\" data-kid=\"2-3-2-3-2-2\" data-name=\"step feature explanation aside\">\n<p class=\"why__label\" data-kid=\"2-3-2-3-2-2-1\" data-name=\"explanation label\">What this changes</p>\n<p class=\"why__text\" data-kid=\"2-3-2-3-2-2-2\" data-name=\"step feature explanation text\">Staples are left off the ingredient list, because you already have them. The Recipe can still call for one you forgot.</p>\n<figure class=\"ex\" data-kid=\"2-3-2-3-2-2-3\" data-name=\"step example figure\">\n<div class=\"ex__row\" data-kid=\"2-3-2-3-2-2-3-1\" data-name=\"example firm tofu row\">\n<span class=\"ex__k\" data-kid=\"2-3-2-3-2-2-3-1-1\" data-name=\"example firm tofu name\">firm tofu</span>\n<span class=\"ex__v\" data-kid=\"2-3-2-3-2-2-3-1-2\" data-name=\"example firm tofu state\">listed</span>\n</div>\n<div class=\"ex__row\" data-kid=\"2-3-2-3-2-2-3-2\" data-name=\"example rice row\">\n<span class=\"ex__k\" data-kid=\"2-3-2-3-2-2-3-2-1\" data-name=\"example rice name\">rice</span>\n<span class=\"ex__v\" data-kid=\"2-3-2-3-2-2-3-2-2\" data-name=\"example rice state\">listed</span>\n</div>\n<div class=\"ex__row\" data-kid=\"2-3-2-3-2-2-3-3\" data-name=\"example staple line\">\n<span class=\"ex__k\" data-kid=\"2-3-2-3-2-2-3-3-1\" data-name=\"example staple names text\">salt, oil, pepper</span>\n<span class=\"ex__v\" data-kid=\"2-3-2-3-2-2-3-3-2\" data-name=\"example staple state text\">not listed</span>\n</div>\n<figcaption class=\"ex__note\" data-kid=\"2-3-2-3-2-2-3-4\">Anything you did not name is listed under need.</figcaption>\n</figure>\n</aside>\n</div>\n<div class=\"actions actions--split\" data-kid=\"2-3-2-3-3\" data-name=\"actions bar\">\n<button class=\"btn btn--quiet\" data-kid=\"2-3-2-3-3-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-3-2-3-3-2\" data-name=\"continue to next step button\" type=\"button\">Continue</button>\n</div>\n</main>\n</div>\n</section>\n<section class=\"flow\" data-kid=\"2-4\">\n<p class=\"label\" data-kid=\"2-4-1\">Step 4 — Cooking state</p>\n<div class=\"screen\" data-kid=\"2-4-2\">\n<header class=\"bar\" data-kid=\"2-4-2-1\"><div class=\"frame\" data-kid=\"2-4-2-1-1\">\n<a class=\"lockup\" data-kid=\"2-4-2-1-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"2-4-2-1-1-1-1\" height=\"28\" viewbox=\"0 0 32 32\" width=\"28\">\n<g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"2-4-2-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"2-4-2-1-1-2\"><span data-kid=\"2-4-2-1-1-2-1\">Pantry</span><span data-kid=\"2-4-2-1-1-2-2\">Saved</span><span data-kid=\"2-4-2-1-1-2-3\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"2-4-2-2\"><div class=\"frame\" data-kid=\"2-4-2-2-1\">\n<a class=\"step step--done\" data-kid=\"2-4-2-2-1-1\" href=\"#\"><span class=\"step__n\" data-kid=\"2-4-2-2-1-1-1\">1</span>Devices</a>\n<a class=\"step step--done\" data-kid=\"2-4-2-2-1-2\" href=\"#\"><span class=\"step__n\" data-kid=\"2-4-2-2-1-2-1\">2</span>Diet</a>\n<a class=\"step step--done\" data-kid=\"2-4-2-2-1-3\" href=\"#\"><span class=\"step__n\" data-kid=\"2-4-2-2-1-3-1\">3</span>Staples</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"2-4-2-2-1-4\" href=\"#\"><span class=\"step__n\" data-kid=\"2-4-2-2-1-4-1\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"2-4-2-3\">\n<header class=\"shelf\" data-kid=\"2-4-2-3-1\" data-name=\"section header with title and count badge\">\n<div class=\"shelf__label\" data-kid=\"2-4-2-3-1-1\" data-name=\"section title card\">\n<h1 class=\"shelf__h\" data-kid=\"2-4-2-3-1-1-1\" data-name=\"section title heading\">Cooked or uncooked</h1>\n<p class=\"shelf__facts\" data-kid=\"2-4-2-3-1-1-2\" data-name=\"section title facts text\">Two examples</p>\n</div>\n</header>\n<div class=\"pairs\" data-kid=\"2-4-2-3-2\" data-name=\"step pairs layout\">\n<figure class=\"pair\" data-kid=\"2-4-2-3-2-1\" data-name=\"step pair figure\">\n<figcaption class=\"pair__name\" data-kid=\"2-4-2-3-2-1-1\" data-name=\"step pair name\">rice</figcaption>\n<div class=\"prow\" data-kid=\"2-4-2-3-2-1-2\">\n<span class=\"chip\" data-kid=\"2-4-2-3-2-1-2-1\"><span class=\"ic ic16\" data-kid=\"2-4-2-3-2-1-2-1-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-1-2-1-1-1\" viewbox=\"0 0 24 24\"><use href=\"#m-raw\"></use></svg></span>uncooked</span>\n<span class=\"prow__method\" data-kid=\"2-4-2-3-2-1-2-2\"><span class=\"ic ic20\" data-kid=\"2-4-2-3-2-1-2-2-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-1-2-2-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-sauce\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-2-1-2-2-1-2\" viewbox=\"0 0 24 24\"><use href=\"#p-sauce\"></use></svg></span>Saucepan</span>\n<span class=\"prow__min\" data-kid=\"2-4-2-3-2-1-2-3\">18 min</span>\n</div>\n<div class=\"prow\" data-kid=\"2-4-2-3-2-1-3\">\n<span class=\"chip chip--cooked\" data-kid=\"2-4-2-3-2-1-3-1\"><span class=\"ic ic16\" data-kid=\"2-4-2-3-2-1-3-1-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-1-3-1-1-1\" viewbox=\"0 0 24 24\"><use href=\"#m-cooked\"></use></svg></span>already cooked</span>\n<span class=\"prow__method\" data-kid=\"2-4-2-3-2-1-3-2\"><span class=\"ic ic20\" data-kid=\"2-4-2-3-2-1-3-2-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-1-3-2-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-2-1-3-2-1-2\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span>Fry pan</span>\n<span class=\"prow__min\" data-kid=\"2-4-2-3-2-1-3-3\">6 min</span>\n</div>\n</figure>\n<figure class=\"pair\" data-kid=\"2-4-2-3-2-2\">\n<figcaption class=\"pair__name\" data-kid=\"2-4-2-3-2-2-1\">chicken</figcaption>\n<div class=\"prow\" data-kid=\"2-4-2-3-2-2-2\">\n<span class=\"chip\" data-kid=\"2-4-2-3-2-2-2-1\"><span class=\"ic ic16\" data-kid=\"2-4-2-3-2-2-2-1-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-2-2-1-1-1\" viewbox=\"0 0 24 24\"><use href=\"#m-raw\"></use></svg></span>uncooked</span>\n<span class=\"prow__method\" data-kid=\"2-4-2-3-2-2-2-2\"><span class=\"ic ic20\" data-kid=\"2-4-2-3-2-2-2-2-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-2-2-2-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-oven\"></use></svg><svg class=\"lay part\" data-dynamic=\"true\" data-kid=\"2-4-2-3-2-2-2-2-1-2\" data-name=\"oven icon movable part layer\" data-reason=\"fill replaced by --surface custom property set from tile state (CSS-driven color, masks authored value)\" viewbox=\"0 0 24 24\"><use href=\"#p-oven\"></use></svg></span>Oven</span>\n<span class=\"prow__min\" data-kid=\"2-4-2-3-2-2-2-3\">35 min</span>\n</div>\n<div class=\"prow\" data-kid=\"2-4-2-3-2-2-3\">\n<span class=\"chip chip--cooked\" data-kid=\"2-4-2-3-2-2-3-1\"><span class=\"ic ic16\" data-kid=\"2-4-2-3-2-2-3-1-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-2-3-1-1-1\" viewbox=\"0 0 24 24\"><use href=\"#m-cooked\"></use></svg></span>already cooked</span>\n<span class=\"prow__method\" data-kid=\"2-4-2-3-2-2-3-2\"><span class=\"ic ic20\" data-kid=\"2-4-2-3-2-2-3-2-1\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-2-3-2-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-2-2-3-2-1-2\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span>Fry pan</span>\n<span class=\"prow__min\" data-kid=\"2-4-2-3-2-2-3-3\">8 min</span>\n</div>\n</figure>\n</div>\n<p class=\"rule\" data-kid=\"2-4-2-3-3\" data-name=\"step rule note\"><b data-kid=\"2-4-2-3-3-1\" data-name=\"step rule note bold text\">A cooked ingredient is reheated or folded in at the end.</b> An uncooked one is cooked through, which is why the time and the device change. Mark it in the Pantry when the food is already cooked.</p>\n<div class=\"actions actions--split\" data-kid=\"2-4-2-3-4\" data-name=\"actions bar\">\n<button class=\"btn btn--quiet\" data-kid=\"2-4-2-3-4-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-4-2-3-4-2\" data-name=\"continue to next step button\" type=\"button\">Open pantry</button>\n</div>\n</main>\n</div>\n</section>\n</div>",
      "comments": [],
      "created": "2026-11-22T03:10:41.868881+00:00",
      "modified": "2026-11-22T08:45:09.879655+00:00",
      "id": "var_9995c829f278",
      "contentHeight": 3255
    },
    "var_a5a39bbf4983": {
      "type": "variant",
      "label": "Selection control — custom toggles",
      "parentId": "var_9995c829f278",
      "themeId": null,
      "rect": {
        "x": 5720,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-12: calc(var(--spacing) * 12);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,fieldset,legend,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; }\nbutton{ font: inherit; color: inherit; }\n.sr-only{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.label{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.frame{ box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.sheet{ padding-block: var(--space-7) var(--space-12); container-type: inline-size; }\n\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: var(--border-width-thin) solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.stack{ display: grid; gap: var(--space-9); margin-block-start: var(--space-6); }\n.block{ display: grid; gap: var(--space-4); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.duo{ display: grid; gap: var(--space-5); }\n@container (inline-size >= 860px){ .duo{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: var(--space-7); } }\n.card{ display: grid; gap: var(--space-4); align-content: start; padding: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n.field__head{ display: grid; gap: 2px; }\n.field__label{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.field__hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n\n.tg{\n  position: relative;\n  display: inline-flex; align-items: center; gap: var(--space-2);\n  min-block-size: 32px; padding: 0 var(--space-3);\n  border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm);\n  background: var(--card); color: var(--foreground);\n  font-size: var(--text-sm); line-height: var(--leading-solid); white-space: nowrap;\n  cursor: pointer;\n  transition: background-color 120ms linear, border-color 120ms linear, color 120ms linear, transform 120ms cubic-bezier(0.23,1,0.32,1);\n}\n.tg input{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n.tg__tick{\n  display: block; flex: none; inline-size: 12px; block-size: 12px;\n  opacity: 0; transform: scale(0.55);\n  transition: transform 170ms cubic-bezier(0.23,1,0.32,1), opacity 110ms linear;\n}\n.tg:hover{ background: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.tg:active{ background: var(--muted); transform: translateY(1px); }\n.tg:has(input:focus-visible){ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.tg:has(input:checked){ background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }\n.tg:has(input:checked):hover{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n.tg:has(input:checked):active{ background: color-mix(in oklab, var(--primary) 88%, var(--foreground)); }\n.tg:has(input:checked) .tg__tick{ opacity: 1; transform: scale(1); }\n.tg:has(input:disabled){ border-style: dashed; background: transparent; color: var(--muted-foreground); cursor: not-allowed; transform: none; }\n.tg:has(input:disabled) .tg__tick{ opacity: 0; }\n\n/* the row: a neutral line, and the control is a 20px box at its start */\n.tg--row{\n  display: grid; grid-template-columns: 20px minmax(0,1fr) auto; gap: var(--space-3); align-items: center;\n  inline-size: 100%; min-block-size: 44px; padding: 0 var(--space-2);\n  background: transparent; color: var(--foreground);\n}\n/* the box holds its 20px slot in both states, so every name starts at the same x */\n.tg--row::before{\n  content: \"\"; grid-column: 1; grid-row: 1; justify-self: start; align-self: center;\n  inline-size: 20px; block-size: 20px;\n  border: var(--border-width-thin) solid color-mix(in oklab, var(--input) 72%, var(--foreground)); border-radius: 3px;\n  background: var(--background);\n  box-shadow: inset 0 1px 2px color-mix(in oklab, var(--foreground) 9%, transparent);\n  transition: background-color 120ms linear, border-color 120ms linear;\n}\n.tg--row > .tg__tick{ grid-column: 1; grid-row: 1; justify-self: center; align-self: center; color: var(--primary-foreground); }\n/* no row ever fills gold: the box carries the state */\n.tg.tg--row:has(input:checked){ background: transparent; border-color: var(--border); color: var(--foreground); }\n.tg.tg--row:has(input:checked):hover{ background: var(--secondary); }\n.tg.tg--row:has(input:checked):active{ background: var(--muted); }\n.tg.tg--row:has(input:checked)::before{ background: var(--primary); border-color: var(--primary); }\n.tg.tg--row:has(input:disabled){ border-color: var(--border); border-style: solid; background: transparent; color: var(--muted-foreground); }\n.tg.tg--row:has(input:disabled)::before{ border-style: dashed; background: transparent; }\n.tg--row:has(input:focus-visible){ outline: var(--border-width-medium) solid var(--ring); outline-offset: -2px; }\n/* the same two states drawn by hand, for the matrix and the size row */\n.tg--row.st-on{ background: transparent; border-color: var(--border); color: var(--foreground); }\n.tg--row.st-on::before{ background: var(--primary); border-color: var(--primary); }\n.tg--row.st-on .tg__meta{ color: var(--muted-foreground); }\n.tg--row.st-off{ background: transparent; border-color: var(--border); border-style: solid; color: var(--muted-foreground); }\n.tg--row.st-off::before{ border-style: dashed; background: transparent; }\n.tg--row.st-focus{ outline: var(--border-width-medium) solid var(--ring); outline-offset: -2px; }\n.tg__name{ overflow: hidden; text-overflow: ellipsis; }\n.tg__meta{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.tg:has(input:checked) .tg__meta{ color: color-mix(in oklab, var(--primary-foreground) 78%, var(--primary)); }\n.group{ display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.rows{ display: grid; gap: 0; border-block-start: var(--border-width-thin) solid var(--border); }\n.rows .tg{ border-radius: 0; border-width: 0 0 var(--border-width-thin) 0; }\n.rows .tg:hover{ border-color: var(--border); }\n.rows .tg:has(input:focus-visible){ outline-offset: -2px; }\n\n.matrix{ display: grid; gap: var(--space-3); }\n.mrow{ display: grid; grid-template-columns: 84px repeat(6, minmax(0,1fr)); align-items: center; gap: var(--space-3); }\n.mrow--head{ padding-block-end: var(--space-2); border-block-end: var(--border-width-thin) solid var(--border); }\n.mhead{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.cell{ display: grid; place-items: center; padding: var(--space-3) var(--space-2); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: var(--background); min-block-size: 56px; }\n.cell--row{ justify-items: stretch; }\n.cell--row .tg__meta{ display: none; }\n.st-hover{ background: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.st-focus{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.st-press{ background: var(--muted); transform: translateY(1px); }\n.st-on{ background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }\n.st-on .tg__tick{ opacity: 1; transform: scale(1); }\n.st-on .tg__meta{ color: color-mix(in oklab, var(--primary-foreground) 78%, var(--primary)); }\n.st-off{ border-style: dashed; background: transparent; color: var(--muted-foreground); }\n.st-off .tg__tick{ opacity: 0; }\n\n.sizes{ display: grid; gap: var(--space-3); }\n.sizerow{ display: flex; align-items: center; gap: var(--space-4); }\n.sizekey{ inline-size: 76px; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); color: var(--muted-foreground); }\n.tg--sm{ min-block-size: 26px; padding: 0 var(--space-2); font-size: var(--text-xs); }\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG symbol definitions sprite\" focusable=\"false\" style=\"position:absolute;inline-size:0;block-size:0\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\">\n<path d=\"M1.9 6.2l2.6 2.6L10.1 3.2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\"></path>\n</symbol>\n</defs></svg>\n