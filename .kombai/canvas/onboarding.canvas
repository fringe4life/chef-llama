-1-3-6-1-3\" data-name=\"oven steam tendril layer\" viewbox=\"0 0 24 24\"><use href=\"#s-oven\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"2-1-2-3-2-1-3-6-2\" data-name=\"oven device tile label\">Oven</span>\n</label>\n<input checked=\"\" class=\"in\" data-kid=\"2-1-2-3-2-1-3-7\" data-name=\"air fryer selection checkbox\" id=\"a2-air\" type=\"checkbox\"/>\n<label class=\"tile m-air\" data-kid=\"2-1-2-3-2-1-3-8\" data-name=\"air fryer device tile\" for=\"a2-air\">\n<span class=\"ic ic48\" data-kid=\"2-1-2-3-2-1-3-8-1\" data-name=\"air fryer icon container\"><svg class=\"lay body\" data-kid=\"2-1-2-3-2-1-3-8-1-1\" data-name=\"air fryer icon base layer\" viewbox=\"0 0 24 24\"><use href=\"#b-air\"></use></svg><svg class=\"lay part\" data-kid=\"2-1-2-3-2-1-3-8-1-2\" data-name=\"air fryer icon movable part layer\" viewbox=\"0 0 24 24\"><use href=\"#p-air\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"2-1-2-3-2-1-3-8-2\" data-name=\"air fryer device tile label\">Air fryer</span>\n</label>\n<input class=\"in\" data-kid=\"2-1-2-3-2-1-3-9\" data-name=\"slow cooker selection checkbox\" id=\"a2-slow\" type=\"checkbox\"/>\n<label class=\"tile m-slow\" data-kid=\"2-1-2-3-2-1-3-10\" data-name=\"slow cooker device tile\" for=\"a2-slow\">\n<span class=\"ic ic48\" data-kid=\"2-1-2-3-2-1-3-10-1\" data-name=\"slow cooker icon container\"><svg class=\"lay body\" data-kid=\"2-1-2-3-2-1-3-10-1-1\" data-name=\"slow cooker icon base layer\" viewbox=\"0 0 24 24\"><use href=\"#b-slow\"></use></svg><svg class=\"lay part\" data-kid=\"2-1-2-3-2-1-3-10-1-2\" data-name=\"slow cooker icon movable part layer\" viewbox=\"0 0 24 24\"><use href=\"#p-slow\"></use></svg><svg class=\"lay tend\" data-dynamic=\"true\" data-kid=\"2-1-2-3-2-1-3-10-1-3\" data-name=\"slow cooker steam tendril layer\" data-reason=\"opacity and transform replaced by 'rise' keyframe animation on selected state (held hidden by animation-fill-mode: both)\" viewbox=\"0 0 24 24\"><use href=\"#s-slow\"></u