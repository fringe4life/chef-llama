 per serving</label>\n<input class=\"ln ln--sm\" data-kid=\"2-1-2-2-2-3-2-2-2\" data-name=\"kcal per serving text input\" id=\"c1-kcal\" type=\"text\" value=\"600\"/>\n</div>\n</div>\n<fieldset class=\"field\" data-kid=\"2-1-2-2-2-3-3\" data-name=\"flags group\">\n<legend class=\"lb\" data-kid=\"2-1-2-2-2-3-3-1\" data-name=\"flags group legend\">Flags</legend>\n<div class=\"flags\" data-kid=\"2-1-2-2-2-3-3-2\" data-name=\"flags container\">\n<label class=\"flag\" data-kid=\"2-1-2-2-2-3-3-2-1\" data-name=\"vegan checkbox flag\"><input data-kid=\"2-1-2-2-2-3-3-2-1-1\" data-name=\"vegan checkbox\" type=\"checkbox\"/>vegan</label>\n<label class=\"flag\" data-kid=\"2-1-2-2-2-3-3-2-2\" data-name=\"vegetarian checkbox flag\"><input checked=\"\" data-kid=\"2-1-2-2-2-3-3-2-2-1\" data-name=\"vegetarian checkbox\" type=\"checkbox\"/>vegetarian</label>\n<label class=\"flag\" data-kid=\"2-1-2-2-2-3-3-2-3\" data-name=\"gluten free checkbox flag\"><input data-kid=\"2-1-2-2-2-3-3-2-3-1\" data-name=\"gluten free checkbox\" type=\"checkbox\"/>gluten free</label>\n</div>\n<p class=\"rule\" data-kid=\"2-1-2-2-2-3-3-3\" data-name=\"hard limit example rule note\">A hard limit is never traded, so a chicken Recipe is cooked with <i data-kid=\"2-1-2-2-2-3-3-3-1\" data-name=\"firm tofu example phrase\">firm tofu</i> instead.</p>\n</fieldset>\n<fieldset class=\"field\" data-kid=\"2-1-2-2-2-3-4\" data-name=\"allergies group\">\n<legend class=\"lb\" data-kid=\"2-1-2-2-2-3-4-1\" data-name=\"allergies legend with count\">Allergies <span class=\"count\" data-kid=\"2-1-2-2-2-3-4-1-1\" data-name=\"allergy counter text\">2 / 15</span></legend>\n<div class=\"rack\" data-kid=\"2-1-2-2-2-3-4-2\" data-name=\"allergy rack container\">\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-1\" data-name=\"milk allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-1-1\" data-name=\"milk allergy checkbox input\" type=\"checkbox\"/>milk</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-2\" data-name=\"egg allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-2-1\" data-name=\"egg checkbox input\" type=\"checkbox\"/>egg</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-3\" data-name=\"peanut allergy checkbox\"><input checked=\"\" data-kid=\"2-1-2-2-2-3-4-2-3-1\" data-name=\"peanut checkbox input\" type=\"checkbox\"/>peanut</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-4\" data-name=\"tree nuts allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-4-1\" data-name=\"tree nuts checkbox input\" type=\"checkbox\"/>tree nuts</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-5\" data-name=\"sesame allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-5-1\" data-name=\"sesame checkbox input\" type=\"checkbox\"/>sesame</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-6\" data-name=\"soy allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-6-1\" data-name=\"soy checkbox input\" type=\"checkbox\"/>soy</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-7\" data-name=\"wheat allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-7-1\" data-name=\"wheat checkbox input\" type=\"checkbox\"/>wheat</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-8\" data-name=\"fish allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-8-1\" data-name=\"fish checkbox input\" type=\"checkbox\"/>fish</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-9\" data-name=\"shellfish allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-9-1\" data-name=\"shellfish checkbox input\" type=\"checkbox\"/>shellfish</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-10\" data-name=\"mollusc allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-10-1\" data-name=\"mollusc checkbox input\" type=\"checkbox\"/>mollusc</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-11\" data-name=\"sulphites allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-11-1\" data-name=\"sulphites checkbox input\" type=\"checkbox\"/>sulphites</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-12\" data-name=\"lupin allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-12-1\" data-name=\"lupin checkbox input\" type=\"checkbox\"/>lupin</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-13\" data-name=\"celery allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-13-1\" data-name=\"celery checkbox input\" type=\"checkbox\"/>celery</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-14\" data-name=\"mustard allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-14-1\" data-name=\"mustard checkbox input\" type=\"checkbox\"/>mustard</label>\n<label class=\"all\" data-kid=\"2-1-2-2-2-3-4-2-15\" data-name=\"kiwi fruit allergy checkbox\"><input data-kid=\"2-1-2-2-2-3-4-2-15-1\" data-name=\"kiwi fruit checkbox input\" type=\"checkbox\"/>kiwi fruit</label>\n</div>\n<div class=\"field\" data-kid=\"2-1-2-2-2-3-4-3\" data-name=\"another allergy field\" style=\"margin-block-start: var(--space-3)\">\n<label class=\"lb\" data-kid=\"2-1-2-2-2-3-4-3-1\" data-name=\"another allergy label\" for=\"c1-other\">Another allergy</label>\n<input class=\"ln ln--sm\" data-kid=\"2-1-2-2-2-3-4-3-2\" data-name=\"another allergy text input\" id=\"c1-other\" placeholder=\"e.g. banana\" style=\"max-inline-size: 18rem\" type=\"text\"/>\n</div>\n</fieldset>\n</div>\n<div class=\"foot\" data-kid=\"2-1-2-2-2-4\" data-name=\"form footer bar\">\n<p class=\"commit\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"summary commit text\"><b data-kid=\"2-1-2-2-2-4-1-1\" data-name=\"diet name in summary\">Home</b>, vegetarian, 2 allergies, serves 2, 600 kcal</p>\n<div class=\"actions\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"action buttons container\">\n<button class=\"btn btn--quiet\" data-kid=\"2-1-2-2-2-4-2-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-1-2-2-2-4-2-2\" data-name=\"save diet primary button\" type=\"button\">Save Diet</button>\n</div>\n</div>\n</main>\n</div>\n</div>\n</section>\n<section class=\"flow\" data-kid=\"2-2\" data-name=\"step 3 staples section\">\n<p class=\"label\" data-kid=\"2-2-1\" data-name=\"step label heading\">Step 3 — Staples</p>\n<div class=\"screen\" data-kid=\"2-2-2\" data-name=\"screen frame mockup\">\n<header class=\"bar\" data-kid=\"2-2-2-1\" data-name=\"screen top toolbar\"><div class=\"frame\" data-kid=\"2-2-2-1-1\" data-name=\"toolbar row container\">\n<a class=\"lockup\" data-kid=\"2-2-2-1-1-1\" data-name=\"site brand link\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"llama mascot logo icon\" height=\"28\" viewbox=\"0 0 32 32\" width=\"28\"><g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g><circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle><g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g></svg>\n<span class=\"wordmark\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"site wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"2-2-2-1-1-2\" data-name=\"main site navigation\"><span data-kid=\"2-2-2-1-1-2-1\" data-name=\"nav link Pantry\">Pantry</span><span data-kid=\"2-2-2-1-1-2-2\" data-name=\"nav link Saved\">Saved</span><span data-kid=\"2-2-2-1-1-2-3\" data-name=\"nav link Account\">Account</span></nav>\n</div></header>\n<div class=\"body\" data-kid=\"2-2-2-2\" data-name=\"screen body layout\">\n<nav aria-label=\"Setup\" class=\"spine\" data-kid=\"2-2-2-2-1\" data-name=\"setup stepper sidebar nav\">\n<p class=\"spine__h\" data-kid=\"2-2-2-2-1-1\" data-name=\"sidebar nav heading\">Setup</p>\n<div class=\"ix\" data-kid=\"2-2-2-2-1-2\" data-name=\"setup step list container\">\n<a class=\"ix__row ix__row--done\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"step item Devices (completed)\" href=\"#\"><span class=\"ix__n\" data-kid=\"2-2-2-2-1-2-1-1\" data-name=\"step number badge 1\">1</span><span data-kid=\"2-2-2-2-1-2-1-2\" data-name=\"step label and status wrapper\"><span class=\"ix__t\" data-kid=\"2-2-2-2-1-2-1-2-1\" data-name=\"step title Devices\">Devices</span><span class=\"ix__f\" data-kid=\"2-2-2-2-1-2-1-2-2\" data-name=\"step status note 5 owned\">5 owned</span></span></a>\n<a class=\"ix__row ix__row--done\" data-kid=\"2-2-2-2-1-2-2\" data-name=\"step item Diet (completed)\" href=\"#\"><span class=\"ix__n\" data-kid=\"2-2-2-2-1-2-2-1\" data-name=\"step number badge 2\">2</span><span data-kid=\"2-2-2-2-1-2-2-2\" data-name=\"step label and status wrapper\"><span class=\"ix__t\" data-kid=\"2-2-2-2-1-2-2-2-1\" data-name=\"step title Diet\">Diet</span><span class=\"ix__f\" data-kid=\"2-2-2-2-1-2-2-2-2\" data-name=\"step status note 2 limits\">2 limits</span></span></a>\n<a aria-current=\"step\" class=\"ix__row ix__row--on\" data-kid=\"2-2-2-2-1-2-3\" data-name=\"step item Staples (current)\" href=\"#\"><span class=\"ix__n\" data-kid=\"2-2-2-2-1-2-3-1\" data-name=\"step number badge 3\">3</span><span data-kid=\"2-2-2-2-1-2-3-2\" data-name=\"step label and status wrapper\"><span class=\"ix__t\" data-kid=\"2-2-2-2-1-2-3-2-1\" data-name=\"step title Staples\">Staples</span><span class=\"ix__f\" data-kid=\"2-2-2-2-1-2-3-2-2\" data-name=\"step status note 5 ticked\">5 ticked</span></span></a>\n<a class=\"ix__row\" data-kid=\"2-2-2-2-1-2-4\" data-name=\"step item Cooking state (upcoming)\" href=\"#\"><span class=\"ix__n\" data-kid=\"2-2-2-2-1-2-4-1\" data-name=\"step number badge 4\">4</span><span data-kid=\"2-2-2-2-1-2-4-2\" data-name=\"step label and status wrapper\"><span class=\"ix__t\" data-kid=\"2-2-2-2-1-2-4-2-1\" data-name=\"step title Cooking state\">Cooking state</span><span class=\"ix__f\" data-kid=\"2-2-2-2-1-2-4-2-2\" data-name=\"step status note 2 marked\">2 marked</span></span></a>\n</div>\n</nav>\n<main class=\"content\" data-kid=\"2-2-2-2-2\" data-name=\"main content area\">\n<header class=\"shelf\" data-kid=\"2-2-2-2-2-1\" data-name=\"page header banner\">\n<div class=\"shelf__label\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"page heading label group\">\n<h1 class=\"shelf__h\" data-kid=\"2-2-2-2-2-1-1-1\" data-name=\"page title Staples\">Staples</h1>\n<p class=\"shelf__facts\" data-kid=\"2-2-2-2-2-1-1-2\" data-name=\"page subtitle tag\">5 ticked</p>\n</div>\n</header>\n<p class=\"rule\" data-kid=\"2-2-2-2-2-2\" data-name=\"staples rule note\"><b data-kid=\"2-2-2-2-2-2-1\" data-name=\"staples rule bold text\">Ticked staples stay off the ingredient list.</b> The Recipe can still bring one in when it suits the dish, so you never add them again.</p>\n<div class=\"grp\" data-kid=\"2-2-2-2-2-3\" data-name=\"the basics group\">\n<p class=\"lb\" data-kid=\"2-2-2-2-2-3-1\" data-name=\"group heading The basics\">The basics</p>\n<div class=\"rack2\" data-kid=\"2-2-2-2-2-3-2\" data-name=\"basics rack container\">\n<div data-kid=\"2-2-2-2-2-3-2-1\" data-name=\"basics rack left column\">\n<label class=\"list\" data-kid=\"2-2-2-2-2-3-2-1-1\" data-name=\"salt staple row\"><input checked=\"\" data-kid=\"2-2-2-2-2-3-2-1-1-1\" data-name=\"salt checkbox\" type=\"checkbox\"/>salt</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-3-2-1-2\" data-name=\"olive oil staple row\"><input checked=\"\" data-kid=\"2-2-2-2-2-3-2-1-2-1\" data-name=\"olive oil checkbox\" type=\"checkbox\"/>olive oil</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-3-2-1-3\" data-name=\"water staple row\"><input data-kid=\"2-2-2-2-2-3-2-1-3-1\" data-name=\"water checkbox\" type=\"checkbox\"/>water</label>\n</div>\n<div data-kid=\"2-2-2-2-2-3-2-2\" data-name=\"basics rack right column\">\n<label class=\"list\" data-kid=\"2-2-2-2-2-3-2-2-1\" data-name=\"black pepper staple row\"><input checked=\"\" data-kid=\"2-2-2-2-2-3-2-2-1-1\" data-name=\"black pepper checkbox\" type=\"checkbox\"/>black pepper</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-3-2-2-2\" data-name=\"butter staple row\"><input data-kid=\"2-2-2-2-2-3-2-2-2-1\" data-name=\"butter checkbox\" type=\"checkbox\"/>butter</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-3-2-2-3\" data-name=\"sugar staple row\"><input data-kid=\"2-2-2-2-2-3-2-2-3-1\" data-name=\"sugar checkbox\" type=\"checkbox\"/>sugar</label>\n</div>\n</div>\n</div>\n<div class=\"grp\" data-kid=\"2-2-2-2-2-4\" data-name=\"spices and herbs group\">\n<p class=\"lb\" data-kid=\"2-2-2-2-2-4-1\" data-name=\"group heading Spices and herbs\">Spices and herbs</p>\n<div class=\"rack2\" data-kid=\"2-2-2-2-2-4-2\" data-name=\"spices rack container\">\n<div data-kid=\"2-2-2-2-2-4-2-1\" data-name=\"spices rack left column\">\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-1-1\" data-name=\"chilli flakes staple row\"><input data-kid=\"2-2-2-2-2-4-2-1-1-1\" data-name=\"chilli flakes checkbox\" type=\"checkbox\"/>chilli flakes</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-1-2\" data-name=\"cumin staple row\"><input checked=\"\" data-kid=\"2-2-2-2-2-4-2-1-2-1\" data-name=\"cumin checkbox\" type=\"checkbox\"/>cumin</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-1-3\" data-name=\"paprika staple row\"><input checked=\"\" data-kid=\"2-2-2-2-2-4-2-1-3-1\" data-name=\"paprika checkbox\" type=\"checkbox\"/>paprika</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-1-4\" data-name=\"oregano staple row\"><input data-kid=\"2-2-2-2-2-4-2-1-4-1\" data-name=\"oregano checkbox\" type=\"checkbox\"/>oregano</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-1-5\" data-name=\"turmeric staple row\"><input data-kid=\"2-2-2-2-2-4-2-1-5-1\" data-name=\"turmeric checkbox\" type=\"checkbox\"/>turmeric</label>\n</div>\n<div data-kid=\"2-2-2-2-2-4-2-2\" data-name=\"spices rack right column\">\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-2-1\" data-name=\"cinnamon staple row\"><input data-kid=\"2-2-2-2-2-4-2-2-1-1\" data-name=\"cinnamon checkbox\" type=\"checkbox\"/>cinnamon</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-2-2\" data-name=\"curry powder staple row\"><input data-kid=\"2-2-2-2-2-4-2-2-2-1\" data-name=\"curry powder checkbox\" type=\"checkbox\"/>curry powder</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-2-3\" data-name=\"garlic powder staple row\"><input data-kid=\"2-2-2-2-2-4-2-2-3-1\" data-name=\"garlic powder checkbox\" type=\"checkbox\"/>garlic powder</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-2-4\" data-name=\"ginger staple row\"><input data-kid=\"2-2-2-2-2-4-2-2-4-1\" data-name=\"ginger checkbox\" type=\"checkbox\"/>ginger</label>\n<label class=\"list\" data-kid=\"2-2-2-2-2-4-2-2-5\" data-name=\"coriander staple row\"><input data-kid=\"2-2-2-2-2-4-2-2-5-1\" data-name=\"coriander checkbox\" type=\"checkbox\"/>coriander</label>\n</div>\n</div>\n</div>\n<div class=\"grp\" data-kid=\"2-2-2-2-2-5\" data-name=\"your own staples group\">\n<p class=\"lb\" data-kid=\"2-2-2-2-2-5-1\" data-name=\"group heading Your own\">Your own</p>\n<div class=\"mine\" data-kid=\"2-2-2-2-2-5-2\" data-name=\"custom staples chips container\">\n<span class=\"mine__chip\" data-kid=\"2-2-2-2-2-5-2-1\" data-name=\"soy sauce custom staple chip\">soy sauce<button aria-label=\"Remove soy sauce\" class=\"chip__x\" data-kid=\"2-2-2-2-2-5-2-1-1\" data-name=\"remove soy sauce button\" type=\"button\"><svg class=\"x\" data-kid=\"2-2-2-2-2-5-2-1-1-1\" data-name=\"x close icon\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n<span class=\"mine__chip\" data-kid=\"2-2-2-2-2-5-2-2\" data-name=\"chicken stock custom staple chip\">chicken stock<button aria-label=\"Remove chicken stock\" class=\"chip__x\" data-kid=\"2-2-2-2-2-5-2-2-1\" data-name=\"remove chicken stock button\" type=\"button\"><svg class=\"x\" data-kid=\"2-2-2-2-2-5-2-2-1-1\" data-name=\"x close icon\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n</div>\n<label class=\"lb\" data-kid=\"2-2-2-2-2-5-3\" data-name=\"add a staple label\" for=\"c1-add\">Add a staple</label>\n<input class=\"ln\" data-kid=\"2-2-2-2-2-5-4\" data-name=\"add a staple text input\" id=\"c1-add\" placeholder=\"e.g. fish sauce\" style=\"max-inline-size: 18rem\" type=\"text\"/>\n</div>\n<div class=\"foot\" data-kid=\"2-2-2-2-2-6\" data-name=\"form footer bar\">\n<p class=\"commit\" data-kid=\"2-2-2-2-2-6-1\" data-name=\"summary commit text\"><b data-kid=\"2-2-2-2-2-6-1-1\" data-name=\"staples count in summary\">5 staples</b>, 2 of your own</p>\n<div class=\"actions\" data-kid=\"2-2-2-2-2-6-2\" data-name=\"action buttons container\">\n<button class=\"btn btn--quiet\" data-kid=\"2-2-2-2-2-6-2-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-2-2-2-2-6-2-2\" data-name=\"continue primary button\" type=\"button\">Continue</button>\n</div>\n</div>\n</main>\n</div>\n</div>\n</section>\n</div>",
      "comments": [],
      "created": "2026-11-22T11:48:18.361898+00:00",
      "modified": "2026-11-22T11:51:50.386602+00:00",
      "id": "var_0550e71fa3b7",
