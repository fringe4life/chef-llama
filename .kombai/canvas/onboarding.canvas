      "html": "<style>\n@property --p{ syntax: \"<percentage>\"; inherits: true; initial-value: 0%; }\n\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n\n  --ease-glide: linear(0, 0.002 3.125%, 0.01 6.25%, 0.022 9.375%, 0.039 12.5%, 0.085 18.75%, 0.148 25%, 0.211 30.273%, 0.282 35.547%, 0.368 41.479%, 0.643 59.277%, 0.756 67.188%, 0.843 74.219%, 0.881 77.734%, 0.915 81.25%, 0.951 85.938%, 0.978 90.625%, 0.994 95.313%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.092 41.3%, 1.117 46%, 1.13 51%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --duration-quick: 160ms;\n  --duration-base: 240ms;\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nbutton{ font: inherit; color: inherit; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n.sheet{ padding-block: var(--space-7) var(--space-10); }\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: 1px solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.block{ display: grid; gap: var(--space-4); margin-block-start: var(--space-8); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.well{ padding: var(--space-6); background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-lg); }\n.ctl{ --p: 0%; display: grid; gap: var(--space-2); min-inline-size: 0; transition: --p var(--duration-base) var(--ease-glide); }\n.ctl:has(.rng:active){ transition: --p 40ms linear; }\n.ctl__row{ display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }\n.fig{ font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); font-variant-numeric: tabular-nums; }\n\n/* rail: 68px track, 6px rule */\n.trk{ --trk-h: 68px; --rail-y: 34px; --pad: 14px; position: relative; block-size: var(--trk-h); transition: --p var(--duration-base) var(--ease-glide); }\n.trk:has(.rng:active){ transition: --p 40ms linear; }\n@starting-style{ .ctl{ --p: 0%; } }\n.trk__scale{ position: absolute; inset-inline: var(--pad); inset-block: 0; }\n.rail{ position: absolute; inset-inline: 0; inset-block-start: var(--rail-y); block-size: 6px; border: 1px solid color-mix(in oklab, var(--input) 62%, var(--foreground)); border-radius: 3px; background: color-mix(in oklab, var(--border) 55%, var(--card)); transition: box-shadow var(--duration-quick) var(--ease-squish); }\n.fill{ position: absolute; inset-inline-start: 0; inset-block-start: var(--rail-y); block-size: 6px; inline-size: 100%; border-radius: 3px; background: var(--primary);\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent calc(var(--p) + 8px));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent calc(var(--p) + 8px)); }\n.edge{ position: absolute; inset-inline-start: var(--p); inset-block-start: var(--rail-y); inline-size: 1px; block-size: 6px; background: color-mix(in oklab, var(--primary) 58%, var(--foreground)); }\n.grads{ position: absolute; inset-inline: 0; inset-block-start: calc(var(--rail-y) + 8px); block-size: 10px;\n  background-image: repeating-linear-gradient(to right, var(--tk-major) 0 1px, transparent 1px 10%), repeating-linear-gradient(to right, var(--tk-minor) 0 1px, transparent 1px 2.5%);\n  background-size: 100% 10px, 100% 5px; background-position: left bottom, left bottom; background-repeat: repeat-x;\n  --tk-major: color-mix(in oklab, var(--muted-foreground) 68%, var(--card));\n  --tk-minor: color-mix(in oklab, var(--muted-foreground) 32%, var(--card)); }\n.grads--in{ --tk-major: color-mix(in oklab, var(--background) 86%, var(--primary)); --tk-minor: color-mix(in oklab, var(--background) 70%, var(--primary));\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent var(--p));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent var(--p)); }\n.scale{ position: relative; block-size: 14px; margin-inline: 14px; }\n.mark{ position: absolute; inset-inline-start: calc(var(--at) * 1%); transform: translateX(-50%); font-family: var(--font-mono); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n.mark:first-child{ transform: none; }\n.mark:last-child{ transform: translateX(-100%); }\n\n/* ── the handle: brass, 22 × 56, gradient only ───────────────────────── */\n.brass{\n  --tw: 22px; --th: 56px; --th-radius: 3px;\n  --th-grad: linear-gradient(90deg,\n    oklch(0.910 0.100 94) 0%,\n    oklch(0.855 0.145 88) 17%,\n    oklch(0.735 0.158 77) 50%,\n    oklch(0.855 0.145 88) 83%,\n    oklch(0.910 0.100 94) 100%);\n  --th-edge: 1px solid oklch(0.42 0.085 64 / 0.50);\n  --th-shadow: inset 0 1px 0 oklch(1 0 0 / 0.55), inset 0 -1px 0 oklch(0.38 0.06 58 / 0.24), 0 2px 0 oklch(0.33 0.05 62 / 0.14), 0 0 0 1px oklch(0.42 0.085 64 / 0.08);\n}\n\n.rng{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: grab; z-index: 3; }\n.rng:active{ cursor: grabbing; }\n.rng::-webkit-slider-runnable-track{ block-size: var(--trk-h); background: transparent; border: 0; }\n.rng::-webkit-slider-thumb{\n  -webkit-appearance: none;\n  inline-size: var(--tw); block-size: var(--th);\n  margin-block-start: calc((var(--trk-h) - var(--th)) / 2);\n  border: var(--th-edge); border-radius: var(--th-radius);\n  background-color: transparent;\n  background-image: var(--th-grad);\n  background-repeat: no-repeat; background-size: 100% 100%;\n  box-shadow: var(--th-shadow);\n  transition: transform var(--duration-quick) var(--ease-squish), box-shadow var(--duration-quick) var(--ease-squish);\n}\n.rng::-moz-range-track{ block-size: var(--trk-h); background: transparent; border: 0; }\n.rng::-moz-range-thumb{ inline-size: var(--tw); block-size: var(--th); border: var(--th-edge); border-radius: var(--th-radius); background-image: var(--th-grad); box-shadow: var(--th-shadow); }\n\n.rng:hover::-webkit-slider-thumb, .rng.is-hover::-webkit-slider-thumb{ transform: translateY(-1px); }\n.rng:active::-webkit-slider-thumb, .rng.is-drag::-webkit-slider-thumb{ transform: translateY(1px) scaleY(1.04); }\n\n.trk:has(.rng:active) .rail, .trk:has(.rng.is-drag) .rail{ box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent); }\n.trk:has(.rng:focus-visible) .rail, .trk:has(.rng.is-focus) .rail{ box-shadow: 0 0 0 2px var(--ring), 0 0 0 4px var(--background); transition: box-shadow 100ms linear; }\n.rng--frozen{ pointer-events: none; }\n\n.thumb{ display: block; inline-size: var(--tw); block-size: var(--th); border: var(--th-edge); border-radius: var(--th-radius); background-image: var(--th-grad); background-repeat: no-repeat; background-size: 100% 100%; box-shadow: var(--th-shadow); }\n.loupe{ display: flex; align-items: flex-end; gap: var(--space-8); }\n.loupe__cell{ display: grid; gap: var(--space-3); justify-items: center; min-inline-size: 96px; }\n\n/* grab band: the 68px the input accepts a finger on */\n.grab{ display: grid; gap: var(--space-3); }\n.grab__band{ position: relative; block-size: 68px; border-block: 1px dashed color-mix(in oklab, var(--muted-foreground) 42%, transparent); }\n.grab__rule{ position: absolute; inset-inline: 0; inset-block-start: 31px; block-size: 6px; border: 1px solid color-mix(in oklab, var(--input) 62%, var(--foreground)); border-radius: 3px; background: color-mix(in oklab, var(--border) 55%, var(--card)); }\n.grab__fill{ position: absolute; inset-inline-start: 0; inset-block-start: 31px; block-size: 6px; inline-size: calc(30% + 11px); border-radius: 3px; background: var(--primary); }\n.grab__thumb{ position: absolute; inset-block-start: 6px; inset-inline-start: 30%; }\n\n/* handle section: loupe beside the construction */\n.handle{ display: grid; grid-template-columns: auto minmax(0,1fr); gap: var(--space-6) var(--space-8); align-items: end; }\n@media (width <= 56rem){ .handle{ grid-template-columns: minmax(0,1fr); } }\n\n/* spec rows */\n.spec{ display: grid; }\n.spec__row{ display: grid; grid-template-columns: 84px 96px minmax(0,1fr); gap: var(--space-3); align-items: baseline; padding-block: var(--space-2); }\n.spec__row + .spec__row{ border-block-start: 1px solid var(--border); }\n.spec__k{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.spec__n{ font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }\n.spec__v{ font-size: var(--text-sm); color: var(--muted-foreground); }\n\n/* states */\n.states{ display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: var(--space-4) var(--space-5); }\n.st{ display: grid; gap: var(--space-2); align-content: start; }\n.trk--mini{ --trk-h: 46px; --rail-y: 23px; --pad: 10px; --tw: 17px; --th: 32px; }\n.st__sel{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n/* motion table */\n.motion{ display: grid; }\n.trow{ display: grid; grid-template-columns: minmax(0,1fr) 240px 100px minmax(0,1fr); gap: var(--space-3); align-items: center; min-block-size: 38px; }\n.trow + .trow{ border-block-start: 1px solid var(--border); }\n.trow--head{ min-block-size: 30px; border-block-end: 1px solid var(--border); }\n.th{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.tstep{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.tok{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n.tnum{ font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }\n\n@media (prefers-reduced-motion: reduce){\n  .ctl{ transition: none; }\n  .rng::-webkit-slider-thumb{ transition: none; }\n  .rail{ transition: none; }\n}\n</style>\n<div class=\"frame sheet\" data-kid=\"1\">\n<header class=\"head\" data-kid=\"1-1\">\n<h1 data-kid=\"1-1-1\" data-name=\"page title heading\">Handle and motion</h1>\n<p class=\"facts\" data-kid=\"1-1-2\" data-name=\"spec summary facts bar\"><span data-kid=\"1-1-2-1\" data-name=\"brass handle size fact\">Brass 22 × 56</span><span data-kid=\"1-1-2-2\" data-name=\"grab band size fact\">Grab band 68</span><span data-kid=\"1-1-2-3\" data-name=\"drag trail latency fact\">Trails 40 ms while dragging</span><span data-kid=\"1-1-2-4\" data-name=\"CSS states fact\">States in CSS</span><span data-kid=\"1-1-2-5\" data-name=\"first paint pour fact\">Pours on first paint</span></p>\n</header>\n<section class=\"block\" data-kid=\"1-2\">\n<h2 data-kid=\"1-2-1\" data-name=\"handle section heading\">Handle</h2>\n<div class=\"well\" data-kid=\"1-2-2\" data-name=\"handle demo well panel\">\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"1-2-2-1\" data-name=\"kcal slider control\" style=\"--p:44.4444%\">\n<div class=\"ctl__row\" data-kid=\"1-2-2-1-1\" data-name=\"kcal control header row\"><span class=\"caps\" data-kid=\"1-2-2-1-1-1\" data-name=\"kcal per serving label\">kcal per serving</span></div>\n<p class=\"fig\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"kcal readout value\" data-reason=\"output text and CSS var --p reset from slider value by mt() on input and @starting-style on load\"><output data-kid=\"1-2-2-1-2-1\">700</output></p>\n<div class=\"trk brass\" data-kid=\"1-2-2-1-3\" data-name=\"kcal slider track\">\n<div class=\"trk__scale\" data-kid=\"1-2-2-1-3-1\" data-name=\"slider track scale layer\">\n<span class=\"rail\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"slider rail bar\"></span>\n<span class=\"fill\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"slider fill bar\"></span><span class=\"edge\" data-kid=\"1-2-2-1-3-1-3\" data-name=\"slider fill edge marker\"></span>\n<span class=\"grads\" data-kid=\"1-2-2-1-3-1-4\" data-name=\"slider lower tick gradient\"></span><span class=\"grads grads--in\" data-kid=\"1-2-2-1-3-1-5\" data-name=\"slider inner tick gradient\"></span>\n</div>\n<input aria-label=\"kcal per serving\" class=\"rng\" data-kid=\"1-2-2-1-3-2\" data-name=\"kcal range input\" max=\"1200\" min=\"300\" oninput=\"mt(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div class=\"scale\" data-kid=\"1-2-2-1-4\" data-name=\"kcal slider numeric scale\">\n<span class=\"mark\" data-kid=\"1-2-2-1-4-1\" data-name=\"scale mark at 300\" style=\"--at:0\">300</span><span class=\"mark\" data-kid=\"1-2-2-1-4-2\" data-name=\"scale mark Light\" style=\"--at:16.6667\">Light</span><span class=\"mark\" data-kid=\"1-2-2-1-4-3\" data-name=\"scale mark Standard\" style=\"--at:44.4444\">Standard</span><span class=\"mark\" data-kid=\"1-2-2-1-4-4\" data-name=\"scale mark Hearty\" style=\"--at:77.7778\">Hearty</span><span class=\"mark\" data-kid=\"1-2-2-1-4-5\" data-name=\"scale mark at 1200\" style=\"--at:100\">1200</span>\n</div>\n</div>\n</div>\n<div class=\"handle\" data-kid=\"1-2-9\" data-name=\"handle layout container with loupe and spec\">\n<div class=\"loupe\" data-kid=\"1-2-3\" data-name=\"loupe magnification row\">\n<div class=\"loupe__cell\" data-kid=\"1-2-3-1\" data-name=\"loupe 1x cell\"><span class=\"thumb brass\" data-kid=\"1-2-3-1-1\" data-name=\"brass handle swatch 1x\"></span><span class=\"caps\" data-kid=\"1-2-3-1-2\" data-name=\"loupe 1x caption\">1× · 22 × 56</span></div>\n<div class=\"loupe__cell\" data-kid=\"1-2-3-2\" data-name=\"loupe 2x cell\"><span class=\"thumb brass\" data-kid=\"1-2-3-2-1\" data-name=\"brass handle swatch 2x\" style=\"--tw:44px;--th:112px\"></span><span class=\"caps\" data-kid=\"1-2-3-2-2\" data-name=\"loupe 2x caption\">2×</span></div>\n<div class=\"loupe__cell\" data-kid=\"1-2-3-3\" data-name=\"loupe 3x cell\"><span class=\"thumb brass\" data-kid=\"1-2-3-3-1\" data-name=\"brass handle swatch 3x\" style=\"--tw:66px;--th:168px\"></span><span class=\"caps\" data-kid=\"1-2-3-3-2\" data-name=\"loupe 3x caption\">3× · radius 3</span></div>\n</div>\n<div class=\"spec\" data-kid=\"1-2-10\" data-name=\"handle spec table\">\n<div class=\"spec__row\" data-kid=\"1-2-10-1\" data-name=\"handle spec silhouette row\"><span class=\"spec__k\" data-kid=\"1-2-10-1-1\" data-name=\"spec key silhouette\">Silhouette</span><span class=\"spec__n\" data-kid=\"1-2-10-1-2\" data-name=\"spec value 22x56\">22 × 56</span><span class=\"spec__v\" data-kid=\"1-2-10-1-3\" data-name=\"spec silhouette description\">One bar, radius 3, a 1 px arris down each side.</span></div>\n<div class=\"spec__row\" data-kid=\"1-2-10-2\" data-name=\"handle spec base row\"><span class=\"spec__k\" data-kid=\"1-2-10-2-1\" data-name=\"spec key base\">Base</span><span class=\"spec__n\" data-kid=\"1-2-10-2-2\" data-name=\"spec value 5 stops\">5 stops</span><span class=\"spec__v\" data-kid=\"1-2-10-2-3\" data-name=\"spec base gradient description\">Mirrored about the centre line: cream at both edges, deep brass at the waist.</span></div>\n<div class=\"spec__row\" data-kid=\"1-2-10-3\" data-name=\"handle spec cap row\"><span class=\"spec__k\" data-kid=\"1-2-10-3-1\" data-name=\"spec key cap\">Cap</span><span class=\"spec__n\" data-kid=\"1-2-10-3-2\" data-name=\"spec value 1px\">1 px</span><span class=\"spec__v\" data-kid=\"1-2-10-3-3\" data-name=\"spec cap highlight description\">A cream line on the top face, a shadow line on the bottom.</span></div>\n<div class=\"spec__row\" data-kid=\"1-2-10-4\" data-name=\"handle spec cast row\"><span class=\"spec__k\" data-kid=\"1-2-10-4-1\" data-name=\"spec key cast\">Cast</span><span class=\"spec__n\" data-kid=\"1-2-10-4-2\" data-name=\"spec value 2px\">2 px</span><span class=\"spec__v\" data-kid=\"1-2-10-4-3\" data-name=\"spec cast shadow description\">Lift at 14%, plus a 1 px ring at 8% so the edge holds against the fill.</span></div>\n</div>\n</div>\n</section>\n<section class=\"block\" data-kid=\"1-3\">\n<h2 data-kid=\"1-3-1\" data-name=\"touch target section heading\">Touch target</h2>\n<div class=\"grab\" data-kid=\"1-3-2\" data-name=\"grab band demo diagram\">\n<div class=\"grab__band\" data-kid=\"1-3-2-1\" data-name=\"grab band track diagram\">\n<span class=\"grab__rule\" data-kid=\"1-3-2-1-1\" data-name=\"grab band rail rule\"></span>\n<span class=\"grab__fill\" data-kid=\"1-3-2-1-3\" data-name=\"grab band fill bar\"></span>\n<span class=\"thumb brass grab__thumb\" data-kid=\"1-3-2-1-2\" data-name=\"grab band brass handle\"></span>\n</div>\n<p class=\"caps\" data-kid=\"1-3-2-2\" data-name=\"grab band caption text\">Handle 56 inside the 68 px band, 6 px of room above and below</p>\n</div>\n<div class=\"spec\" data-kid=\"1-3-3\" data-name=\"touch target spec table\">\n<div class=\"spec__row\" data-kid=\"1-3-3-1\" data-name=\"spec row band\"><span class=\"spec__k\" data-kid=\"1-3-3-1-1\" data-name=\"spec key band\">Band</span><span class=\"spec__n\" data-kid=\"1-3-3-1-2\" data-name=\"spec value 68 x full\">68 × full</span><span class=\"spec__v\" data-kid=\"1-3-3-1-3\" data-name=\"spec band interaction description\">Anywhere on it takes a tap, which moves the handle to that station before the drag starts.</span></div>\n<div class=\"spec__row\" data-kid=\"1-3-3-2\" data-name=\"spec row handle\"><span class=\"spec__k\" data-kid=\"1-3-3-2-1\" data-name=\"spec key handle\">Handle</span><span class=\"spec__n\" data-kid=\"1-3-3-2-2\" data-name=\"spec value 56 x 22\">56 × 22</span><span class=\"spec__v\" data-kid=\"1-3-3-2-3\" data-name=\"spec handle sizing description\">Tall enough for a thumb; the band carries the aiming, so the narrow width does not have to.</span></div>\n<div class=\"spec__row\" data-kid=\"1-3-3-3\" data-name=\"spec row rail\"><span class=\"spec__k\" data-kid=\"1-3-3-3-1\" data-name=\"spec key rail\">Rail</span><span class=\"spec__n\" data-kid=\"1-3-3-3-2\" data-name=\"spec value 6 tall\">6 tall</span><span class=\"spec__v\" data-kid=\"1-3-3-3-3\" data-name=\"spec rail description\">Shows the station the fill has reached; the handle hides 22 px of it.</span></div>\n</div>\n</section>\n<section class=\"block\" data-kid=\"1-4\">\n<h2 data-kid=\"1-4-1\" data-name=\"states section heading\">States</h2>\n<div class=\"states\" data-kid=\"1-4-2\" data-name=\"interaction states grid\">\n<div class=\"st\" data-kid=\"1-4-2-1\" data-name=\"rest state specimen\"><span class=\"caps\" data-kid=\"1-4-2-1-1\" data-name=\"rest state label\">Rest</span>\n<span class=\"trk trk--mini brass\" data-kid=\"1-4-2-1-2\" data-name=\"rest state slider track\" style=\"--p:45.4545%\"><span class=\"trk__scale\" data-kid=\"1-4-2-1-2-1\" data-name=\"rest slider track scale layer\"><span class=\"rail\" data-kid=\"1-4-2-1-2-1-1\" data-name=\"rest slider rail bar\"></span><span class=\"fill\" data-kid=\"1-4-2-1-2-1-2\" data-name=\"rest slider fill bar\"></span><span class=\"edge\" data-kid=\"1-4-2-1-2-1-3\" data-name=\"rest slider fill edge marker\"></span></span><input class=\"rng rng--frozen\" data-kid=\"1-4-2-1-2-2\" data-name=\"rest frozen range input\" max=\"12\" min=\"1\" step=\"1\" tabindex=\"-1\" type=\"range\" value=\"6\"/></span>\n<span class=\"st__sel\" data-kid=\"1-4-2-1-3\" data-name=\"rest state selector code\">—</span>\n</div>\n<div class=\"st\" data-kid=\"1-4-2-2\" data-name=\"hover state specimen\"><span class=\"caps\" data-kid=\"1-4-2-2-1\" data-name=\"hover state label\">Hover</span>\n<span class=\"trk trk--mini brass\" data-kid=\"1-4-2-2-2\" data-name=\"hover state slider track\" style=\"--p:45.4545%\"><span class=\"trk__scale\" data-kid=\"1-4-2-2-2-1\" data-name=\"hover slider track scale layer\"><span class=\"rail\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"hover slider rail bar\"></span><span class=\"fill\" data-kid=\"1-4-2-2-2-1-2\" data-name=\"hover slider fill bar\"></span><span class=\"edge\" data-kid=\"1-4-2-2-2-1-3\" data-name=\"hover slider fill edge marker\"></span></span><input class=\"rng rng--frozen is-hover\" data-kid=\"1-4-2-2-2-2\" data-name=\"hover frozen range input\" max=\"12\" min=\"1\" step=\"1\" tabindex=\"-1\" type=\"range\" value=\"6\"/></span>\n<span class=\"st__sel\" data-kid=\"1-4-2-2-3\" data-name=\"hover state selector code\">:hover</span>\n</div>\n<div class=\"st\" data-kid=\"1-4-2-3\" data-name=\"focus state specimen\"><span class=\"caps\" data-kid=\"1-4-2-3-1\" data-name=\"focus state label\">Focus</span>\n<span class=\"trk trk--mini brass\" data-kid=\"1-4-2-3-2\" data-name=\"focus state slider track\" style=\"--p:45.4545%\"><span class=\"trk__scale\" data-kid=\"1-4-2-3-2-1\" data-name=\"focus slider track scale layer\"><span class=\"rail\" data-kid=\"1-4-2-3-2-1-1\" data-name=\"focus slider rail bar\"></span><span class=\"fill\" data-kid=\"1-4-2-3-2-1-2\" data-name=\"focus slider fill bar\"></span><span class=\"edge\" data-kid=\"1-4-2-3-2-1-3\" data-name=\"focus slider fill edge marker\"></span></span><input class=\"rng rng--frozen is-focus\" data-kid=\"1-4-2-3-2-2\" data-name=\"focus frozen range input\" max=\"12\" min=\"1\" step=\"1\" tabindex=\"-1\" type=\"range\" value=\"6\"/></span>\n<span class=\"st__sel\" data-kid=\"1-4-2-3-3\" data-name=\"focus state selector code\">:focus-visible</span>\n</div>\n<div class=\"st\" data-kid=\"1-4-2-4\" data-name=\"dragging state specimen\"><span class=\"caps\" data-kid=\"1-4-2-4-1\" data-name=\"dragging state label\">Dragging</span>\n<span class=\"trk trk--mini brass\" data-kid=\"1-4-2-4-2\" data-name=\"dragging state slider track\" style=\"--p:45.4545%\"><span class=\"trk__scale\" data-kid=\"1-4-2-4-2-1\" data-name=\"dragging slider track scale layer\"><span class=\"rail\" data-kid=\"1-4-2-4-2-1-1\" data-name=\"dragging slider rail bar\"></span><span class=\"fill\" data-kid=\"1-4-2-4-2-1-2\" data-name=\"dragging slider fill bar\"></span><span class=\"edge\" data-kid=\"1-4-2-4-2-1-3\" data-name=\"dragging slider fill edge marker\"></span></span><input class=\"rng rng--frozen is-drag\" data-kid=\"1-4-2-4-2-2\" data-name=\"dragging frozen range input\" max=\"12\" min=\"1\" step=\"1\" tabindex=\"-1\" type=\"range\" value=\"6\"/></span>\n<span class=\"st__sel\" data-kid=\"1-4-2-4-3\" data-name=\"dragging state selector code\">:active</span>\n</div>\n</div>\n</section>\n<section class=\"block\" data-kid=\"1-5\">\n<h2 data-kid=\"1-5-1\">Motion</h2>\n<div class=\"motion\" data-kid=\"1-5-2\">\n<div class=\"trow trow--head\" data-kid=\"1-5-2-1\"><span class=\"th\" data-kid=\"1-5-2-1-1\">Interaction</span><span class=\"th\" data-kid=\"1-5-2-1-2\">What moves</span><span class=\"th\" data-kid=\"1-5-2-1-3\">Duration</span><span class=\"th\" data-kid=\"1-5-2-1-4\">Easing</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-2\"><span class=\"tstep\" data-kid=\"1-5-2-2-1\">First paint</span><span class=\"tok\" data-kid=\"1-5-2-2-2\">--p 0% → value, the fill pours in behind a still handle</span><span class=\"tnum\" data-kid=\"1-5-2-2-3\">240 ms</span><span class=\"tok\" data-kid=\"1-5-2-2-4\">--ease-glide · @starting-style</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-3\"><span class=\"tstep\" data-kid=\"1-5-2-3-1\">Dragging</span><span class=\"tok\" data-kid=\"1-5-2-3-2\">fill tip lags the handle by a few px</span><span class=\"tnum\" data-kid=\"1-5-2-3-3\">40 ms</span><span class=\"tok\" data-kid=\"1-5-2-3-4\">linear · :has(.rng:active)</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-4\"><span class=\"tstep\" data-kid=\"1-5-2-4-1\">Release</span><span class=\"tok\" data-kid=\"1-5-2-4-2\">fill tip catches the handle</span><span class=\"tnum\" data-kid=\"1-5-2-4-3\">240 ms</span><span class=\"tok\" data-kid=\"1-5-2-4-4\">--ease-glide</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-5\" data-name=\"tap on rail motion row\"><span class=\"tstep\" data-kid=\"1-5-2-5-1\" data-name=\"motion step tap on rail\">Tap on the rail</span><span class=\"tok\" data-kid=\"1-5-2-5-2\" data-name=\"motion what moves description\">fill jumps and pours to the new station</span><span class=\"tnum\" data-kid=\"1-5-2-5-3\" data-name=\"motion duration 240 ms\">240 ms</span><span class=\"tok\" data-kid=\"1-5-2-5-4\" data-name=\"motion easing ease-glide\">--ease-glide</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-6\"><span class=\"tstep\" data-kid=\"1-5-2-6-1\">Hover</span><span class=\"tok\" data-kid=\"1-5-2-6-2\" data-name=\"motion what moves hover description\">handle lifts 1 px</span><span class=\"tnum\" data-kid=\"1-5-2-6-3\">160 ms</span><span class=\"tok\" data-kid=\"1-5-2-6-4\">--ease-squish</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-7\"><span class=\"tstep\" data-kid=\"1-5-2-7-1\">Press</span><span class=\"tok\" data-kid=\"1-5-2-7-2\" data-name=\"motion what moves press description\">handle sinks 1 px, grows 4% taller</span><span class=\"tnum\" data-kid=\"1-5-2-7-3\">160 ms</span><span class=\"tok\" data-kid=\"1-5-2-7-4\">--ease-squish</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-8\"><span class=\"tstep\" data-kid=\"1-5-2-8-1\">Rail halo</span><span class=\"tok\" data-kid=\"1-5-2-8-2\">0 → 3 px, primary at 22%</span><span class=\"tnum\" data-kid=\"1-5-2-8-3\">160 ms</span><span class=\"tok\" data-kid=\"1-5-2-8-4\">--ease-squish</span></div>\n<div class=\"trow\" data-kid=\"1-5-2-9\"><span class=\"tstep\" data-kid=\"1-5-2-9-1\">Focus</span><span class=\"tok\" data-kid=\"1-5-2-9-2\">0 → 2 px ring, 2 px offset on rail and handle</span><span class=\"tnum\" data-kid=\"1-5-2-9-3\">100 ms</span><span class=\"tok\" data-kid=\"1-5-2-9-4\">linear</span></div>\n</div>\n</section>\n</div>\n<script>\nfunction mt(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  var o = c.querySelector('output');\n  if (o) o.textContent = v;\n}\n</script>",
      "comments": [],
      "created": "2026-11-23T11:29:20.041099+00:00",
      "modified": "2026-11-24T17:34:07.583113+00:00",
      "id": "var_fc34d7bbe987",
      "contentHeight": 1411
    },
    "var_6e48cfb95f08": {
      "type": "variant",
      "label": "Diet A — Requirements bank, the same tiles as devices",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 26659,
        "y": 0,
        "w": 1276,
        "h": 0
      },
      "html": "<style>\n@property --p{ syntax:\"<percentage>\"; inherits:true; initial-value:0%; }\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --accent-text: color-mix(in oklab, var(--accent) 60%, var(--foreground));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n\n  --food: color-mix(in oklab, var(--primary) 68%, var(--foreground));\n  --leaf: var(--accent-text);\n\n  --ease-arrive: linear(0, 0.264 6.25%, 0.482 12.5%, 0.647 18.75%, 0.765 25%, 0.876 34.375%, 0.937 43.75%, 0.98 57.813%, 0.998 78.906%, 1);\n  --ease-depart: linear(0, 0.002 21.094%, 0.02 42.188%, 0.063 56.25%, 0.124 65.625%, 0.235 75%, 0.353 81.25%, 0.518 87.5%, 0.736 93.75%, 1);\n  --ease-glide: linear(0, 0.002 3.125%, 0.022 9.375%, 0.085 18.75%, 0.148 25%, 0.282 35.547%, 0.643 59.277%, 0.843 74.219%, 0.915 81.25%, 0.978 90.625%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.117 46%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --ease-linear: linear(0, 1);\n  --duration-tick: 100ms;\n  --duration-quick: 160ms;\n  --duration-base: 240ms;\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,fieldset,legend,figure,figcaption{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; min-inline-size: 0; }\nlegend{ padding: 0; }\nbutton{ font: inherit; color: inherit; }\n:is(a,button,input,label):focus-visible{ outline: 2px solid var(--ring); outline-offset: 2px; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.bar{ border-block-end: 1px solid var(--border); }\n.bar__in{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 58px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); color: inherit; text-decoration: none; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: none; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n@media (width >= 48rem){ .nav{ display: flex; } }\n\n.steps{ border-block-end: 1px solid var(--border); }\n.steps__in{ display: flex; align-items: stretch; gap: var(--space-5); }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 42px; font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none; border-block-end: 2px solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-size: var(--text-2xs); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--primary-text); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n\n.page{ display: grid; gap: var(--space-6); padding-block: var(--space-5) var(--