4-2-4-4-11-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-2-4-4-11-2\"><span class=\"chip__pocket\" data-kid=\"4-2-4-4-11-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-2-4-4-11-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"4-2-4-4-11-3\">sulphites</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-2-4-4-11-4\"><span class=\"chip__wash-label\" data-kid=\"4-2-4-4-11-4-1\">sulphites</span></span></label>\n<label class=\"chip\" data-kid=\"4-2-4-4-12\"><input data-kid=\"4-2-4-4-12-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-2-4-4-12-2\"><span class=\"chip__pocket\" data-kid=\"4-2-4-4-12-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-2-4-4-12-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"4-2-4-4-12-3\">lupin</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-2-4-4-12-4\"><span class=\"chip__wash-label\" data-kid=\"4-2-4-4-12-4-1\">lupin</span></span></label>\n<label class=\"chip\" data-kid=\"4-2-4-4-13\"><input data-kid=\"4-2-4-4-13-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-2-4-4-13-2\"><span class=\"chip__pocket\" data-kid=\"4-2-4-4-13-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-2-4-4-13-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"4-2-4-4-13-3\">celery</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-2-4-4-13-4\"><span class=\"chip__wash-label\" data-kid=\"4-2-4-4-13-4-1\">celery</span></span></label>\n<label class=\"chip\" data-kid=\"4-2-4-4-14\"><input data-kid=\"4-2-4-4-14-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-2-4-4-14-2\"><span class=\"chip__pocket\" data-kid=\"4-2-4-4-14-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-2-4-4-14-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"4-2-4-4-14-3\">mustard</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-2-4-4-14-4\"><span class=\"chip__wash-label\" data-kid=\"4-2-4-4-14-4-1\">mustard</span></span></label>\n<label class=\"chip\" data-kid=\"4-2-4-4-15\"><input data-kid=\"4-2-4-4-15-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-2-4-4-15-2\"><span class=\"chip__pocket\" data-kid=\"4-2-4-4-15-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-2-4-4-15-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"4-2-4-4-15-3\">kiwi fruit</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-2-4-4-15-4\"><span class=\"chip__wash-label\" data-kid=\"4-2-4-4-15-4-1\">kiwi fruit</span></span></label>\n</div>\n<input aria-label=\"Another allergy\" class=\"input input--add\" data-kid=\"4-2-4-5\" placeholder=\"Another allergy\" type=\"text\"/>\n</div>\n<div class=\"pair\" data-kid=\"4-2-5\">\n<label class=\"field__label\" data-kid=\"4-2-5-1\" for=\"d4-serv\">Servings</label>\n<span class=\"ob\" data-kid=\"4-2-5-2\">Scale</span>\n<div class=\"note\" data-kid=\"4-2-5-3\">\n<p class=\"note__p\" data-kid=\"4-2-5-3-1\"><b data-kid=\"4-2-5-3-1-1\">Every quantity in the Recipe follows it.</b> A dish for four uses twice the ingredients of the same dish for two.</p>\n</div>\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"4-2-5-4\" style=\"--p:27.2727%\">\n<p class=\"fig\" data-kid=\"4-2-5-4-1\"><output data-dynamic=\"true\" data-kid=\"4-2-5-4-1-1\" data-name=\"servings value readout\" data-reason=\"text replaced by rail() script on input\">4</output></p>\n<div class=\"trk\" data-kid=\"4-2-5-4-2\">\n<div class=\"trk__scale\" data-kid=\"4-2-5-4-2-1\">\n<span class=\"rail\" data-kid=\"4-2-5-4-2-1-1\"></span>\n<span class=\"pegs\" data-kid=\"4-2-5-4-2-1-2\"><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-1\" style=\"--at:0\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-2\" style=\"--at:9.0909\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-3\" style=\"--at:18.1818\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-4\" style=\"--at:27.2727\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-5\" style=\"--at:36.3636\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-6\" style=\"--at:45.4545\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-7\" style=\"--at:54.5455\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-8\" style=\"--at:63.6364\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-9\" style=\"--at:72.7273\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-10\" style=\"--at:81.8182\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-11\" style=\"--at:90.9091\"></span><span class=\"peg\" data-kid=\"4-2-5-4-2-1-2-12\" style=\"--at:100\"></span></span>\n<span class=\"fill\" data-dynamic=\"true\" data-kid=\"4-2-5-4-2-1-3\" data-name=\"servings rail fill\" data-reason=\"mask position driven by --p set by rail() script\"></span>\n<span class=\"edge\" data-dynamic=\"true\" data-kid=\"4-2-5-4-2-1-4\" data-name=\"servings rail edge marker\" data-reason=\"inset-inline-start driven by --p set by rail() script\"></span>\n</div>\n<input class=\"rng\" data-kid=\"4-2-5-4-2-2\" id=\"d4-serv\" max=\"12\" min=\"1\" oninput=\"rail(this)\" step=\"1\" type=\"range\" value=\"4\"/>\n</div>\n<div class=\"scale\" data-kid=\"4-2-5-4-3\">\n<span class=\"mark\" data-kid=\"4-2-5-4-3-1\" style=\"--at:0\">1</span><span class=\"mark\" data-kid=\"4-2-5-4-3-2\" style=\"--at:27.2727\">4</span><span class=\"mark\" data-kid=\"4-2-5-4-3-3\" style=\"--at:54.5455\">7</span><span class=\"mark\" data-kid=\"4-2-5-4-3-4\" style=\"--at:81.8182\">10</span><span class=\"mark\" data-kid=\"4-2-5-4-3-5\" style=\"--at:100\">12</span>\n</div>\n</div>\n</div>\n<div class=\"pair\" data-kid=\"4-2-6\">\n<label class=\"field__label\" data-kid=\"4-2-6-1\" for=\"d4-kcal\">kcal per serving</label>\n<span class=\"ob\" data-kid=\"4-2-6-2\">Optional target</span>\n<div class=\"note\" data-kid=\"4-2-6-3\">\n<p class=\"note__p\" data-kid=\"4-2-6-3-1\"><b data-kid=\"4-2-6-3-1-1\">A target, not a limit.</b> A Recipe may come in over it. What a person needs moves with age, body size and how active they are; an adult's evening meal lands near 700.</p>\n</div>\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"4-2-6-4\" style=\"--p:44.4444%\">\n<p class=\"fig\" data-kid=\"4-2-6-4-1\"><output data-dynamic=\"true\" data-kid=\"4-2-6-4-1-1\" data-name=\"kcal value readout\" data-reason=\"text replaced by rail() script on input\">700</output></p>\n<div class=\"trk\" data-kid=\"4-2-6-4-2\">\n<div class=\"trk__scale\" data-kid=\"4-2-6-4-2-1\">\n<span class=\"rail\" data-kid=\"4-2-6-4-2-1-1\"></span>\n<span class=\"fill\" data-dynamic=\"true\" data-kid=\"4-2-6-4-2-1-2\" data-name=\"kcal rail fill\" data-reason=\"mask position driven by --p set by rail() script\"></span>\n<span class=\"edge\" data-dynamic=\"true\" data-kid=\"4-2-6-4-2-1-3\" data-name=\"kcal rail edge marker\" data-reason=\"inset-inline-start driven by --p set by rail() script\"></span>\n<span class=\"grads\" data-kid=\"4-2-6-4-2-1-4\"></span>\n<span class=\"grads grads--in\" data-dynamic=\"true\" data-kid=\"4-2-6-4-2-1-5\" data-name=\"kcal gradient ticks fill\" data-reason=\"mask position driven by --p set by rail() script\"></span>\n</div>\n<input class=\"rng\" data-kid=\"4-2-6-4-2-2\" id=\"d4-kcal\" max=\"1200\" min=\"300\" oninput=\"rail(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div class=\"scale\" data-kid=\"4-2-6-4-3\">\n<span class=\"mark\" data-kid=\"4-2-6-4-3-1\" style=\"--at:0\">300</span><span class=\"mark\" data-kid=\"4-2-6-4-3-2\" style=\"--at:16.6667\">Light</span><span class=\"mark\" data-kid=\"4-2-6-4-3-3\" style=\"--at:44.4444\">Standard</span><span class=\"mark\" data-kid=\"4-2-6-4-3-4\" style=\"--at:77.7778\">Hearty</span><span class=\"mark\" data-kid=\"4-2-6-4-3-5\" style=\"--at:100\">1200</span>\n</div>\n</div>\n</div>\n</div>\n<div class=\"actions\" data-kid=\"4-3\">\n<button class=\"btn btn--quiet\" data-kid=\"4-3-1\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"4-3-2\" type=\"button\">Save Diet</button>\n</div>\n</main>\n<script>\nfunction rail(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n}\n</script>",
