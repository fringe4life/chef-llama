b-gluten\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-2-4-1-1-2\" data-name=\"gluten-free wheat part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-gluten\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-2-4-1-2\" data-name=\"tick specimen name label\">Gluten free</span><span class=\"tile__slot ind--tick\" data-kid=\"2-4-2-2-4-1-3\" data-name=\"tick specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-2-4-1-3-1\" data-name=\"tick specimen pocket backing\"></span><svg class=\"ind-tick\" data-kid=\"2-4-2-2-4-1-3-2\" data-name=\"tick specimen checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-2-5\" data-name=\"tick filling state cell\"><span class=\"tile is-static is-on is-fill40 is-filling m-gluten\" data-kid=\"2-4-2-2-5-1\" data-name=\"tick filling state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-2-5-1-1\" data-name=\"tick specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-2-5-1-1-1\" data-name=\"gluten-free body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-gluten\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-2-5-1-1-2\" data-name=\"gluten-free wheat part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-gluten\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-2-5-1-2\" data-name=\"tick specimen name label\">Gluten free</span><span class=\"tile__slot ind--tick\" data-kid=\"2-4-2-2-5-1-3\" data-name=\"tick specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-2-5-1-3-1\" data-name=\"tick specimen pocket backing\"></span><svg class=\"ind-tick\" data-kid=\"2-4-2-2-5-1-3-2\" data-name=\"tick specimen checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-2-6\" data-name=\"tick checked state cell\"><span class=\"tile is-static is-on m-gluten\" data-kid=\"2-4-2-2-6-1\" data-name=\"tick checked state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-2-6-1-1\" data-name=\"tick specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-2-6-1-1-1\" data-name=\"gluten-free body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-gluten\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-2-6-1-1-2\" data-name=\"gluten-free wheat part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-gluten\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-2-6-1-2\" data-name=\"tick specimen name label\">Gluten free</span><span class=\"tile__slot ind--tick\" data-kid=\"2-4-2-2-6-1-3\" data-name=\"tick specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-2-6-1-3-1\" data-name=\"tick specimen pocket backing\"></span><svg class=\"ind-tick\" data-kid=\"2-4-2-2-6-1-3-2\" data-name=\"tick specimen checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-2-7\" data-name=\"tick at-limit cell\"><span class=\"reg-vacant\" data-kid=\"2-4-2-2-7-1\" data-name=\"at-limit note: no cap\">no cap</span></span>\n</div>\n<div class=\"reg-row\" data-kid=\"2-4-2-3\" data-name=\"register row for rank indication states\">\n<span class=\"reg-key\" data-kid=\"2-4-2-3-1\" data-name=\"rank row label key\">Rank</span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-3-2\" data-name=\"rank rest state cell\"><span class=\"tile is-static m-fry\" data-kid=\"2-4-2-3-2-1\" data-name=\"rank rest state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-3-2-1-1\" data-name=\"rank specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-3-2-1-1-1\" data-name=\"fry pan body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-2-1-1-2\" data-name=\"fry pan food part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-3-2-1-2\" data-name=\"rank specimen name label\">Fry pan</span><span class=\"tile__slot ind--rank\" data-kid=\"2-4-2-3-2-1-3\" data-name=\"rank specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-3-2-1-3-1\" data-name=\"rank specimen pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-4-2-3-2-1-3-2\" data-name=\"rank specimen numeral\"></span></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-3-3\" data-name=\"rank hover state cell\"><span class=\"tile is-static is-hover m-fry\" data-kid=\"2-4-2-3-3-1\" data-name=\"rank hover state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-3-3-1-1\" data-name=\"rank specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-3-3-1-1-1\" data-name=\"fry pan body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-3-1-1-2\" data-name=\"fry pan food part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-3-3-1-2\" data-name=\"rank specimen name label\">Fry pan</span><span class=\"tile__slot ind--rank\" data-kid=\"2-4-2-3-3-1-3\" data-name=\"rank specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-3-3-1-3-1\" data-name=\"rank specimen pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-4-2-3-3-1-3-2\" data-name=\"rank specimen numeral\"></span></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-3-4\" data-name=\"rank focus state cell\"><span class=\"tile is-static is-focus m-fry\" data-kid=\"2-4-2-3-4-1\" data-name=\"rank focus state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-3-4-1-1\" data-name=\"rank specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-3-4-1-1-1\" data-name=\"fry pan body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-4-1-1-2\" data-name=\"fry pan food part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-3-4-1-2\" data-name=\"rank specimen name label\">Fry pan</span><span class=\"tile__slot ind--rank\" data-kid=\"2-4-2-3-4-1-3\" data-name=\"rank specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-3-4-1-3-1\" data-name=\"rank specimen pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-4-2-3-4-1-3-2\" data-name=\"rank specimen numeral\"></span></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-3-5\" data-name=\"rank filling state cell\"><span class=\"tile is-static is-on is-fill40 is-filling m-fry\" data-kid=\"2-4-2-3-5-1\" data-name=\"rank filling state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-3-5-1-1\" data-name=\"rank specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-3-5-1-1-1\" data-name=\"fry pan body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-5-1-1-2\" data-name=\"fry pan food part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-3-5-1-2\" data-name=\"rank specimen name label\">Fry pan</span><span class=\"tile__slot ind--rank\" data-kid=\"2-4-2-3-5-1-3\" data-name=\"rank specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-3-5-1-3-1\" data-name=\"rank specimen pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-4-2-3-5-1-3-2\" data-name=\"rank specimen numeral 1\">1</span></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-3-6\" data-name=\"rank checked state cell\"><span class=\"tile is-static is-on m-fry\" data-kid=\"2-4-2-3-6-1\" data-name=\"rank checked state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-3-6-1-1\" data-name=\"rank specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-3-6-1-1-1\" data-name=\"fry pan body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-6-1-1-2\" data-name=\"fry pan food part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg><svg class=\"lay tend\" data-kid=\"2-4-2-3-6-1-1-3\" data-name=\"fry pan steam tendril\" viewbox=\"0 0 24 24\"><use href=\"#s-fry\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-3-6-1-2\" data-name=\"rank specimen name label\">Fry pan</span><span class=\"tile__slot ind--rank\" data-kid=\"2-4-2-3-6-1-3\" data-name=\"rank specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-3-6-1-3-1\" data-name=\"rank specimen pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-4-2-3-6-1-3-2\" data-name=\"rank specimen numeral 1\">1</span></span></span></span>\n<span class=\"reg-cell\" data-kid=\"2-4-2-3-7\" data-name=\"rank at-limit state cell\"><span class=\"tile is-static is-limit m-air\" data-kid=\"2-4-2-3-7-1\" data-name=\"rank at-limit state tile specimen\"><span class=\"ic\" data-kid=\"2-4-2-3-7-1-1\" data-name=\"rank specimen icon stack\"><svg class=\"lay body\" data-kid=\"2-4-2-3-7-1-1-1\" data-name=\"air fryer body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-air\"></use></svg><svg class=\"lay part\" data-kid=\"2-4-2-3-7-1-1-2\" data-name=\"air fryer basket part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-air\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-4-2-3-7-1-2\" data-name=\"rank specimen name label\">Air fryer</span><span class=\"tile__slot ind--rank\" data-kid=\"2-4-2-3-7-1-3\" data-name=\"rank specimen indicator slot\"><span class=\"pocket\" data-kid=\"2-4-2-3-7-1-3-1\" data-name=\"rank specimen pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-4-2-3-7-1-3-2\" data-name=\"rank specimen numeral\"></span></span></span></span>\n</div>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-5\" data-name=\"section introducing the pocket detail\">\n<div class=\"block__head\" data-kid=\"2-5-1\" data-name=\"pocket section heading block\">\n<h2 data-kid=\"2-5-1-1\" data-name=\"pocket section heading: The pocket\">The pocket</h2>\n<p data-kid=\"2-5-1-2\" data-name=\"pocket section description text\">The empty pocket is drawn in rest, so the tile says where the mark will land before it lands — the same promise the 32px allergy chip makes. Checked: the tick draws over a pocket that clears, the rank inverts it.</p>\n</div>\n<div class=\"pockets\" data-kid=\"2-5-2\" data-name=\"pocket detail state grid\">\n<div class=\"pocket-cell\" data-kid=\"2-5-2-1\" data-name=\"tick rest pocket detail cell\">\n<span class=\"plate plate--off\" data-kid=\"2-5-2-1-1\" data-name=\"tick rest plate\"><span class=\"zoom zoom--tick\" data-kid=\"2-5-2-1-1-1\" data-name=\"tick rest zoom container\"><span class=\"pocket\" data-kid=\"2-5-2-1-1-1-1\" data-name=\"tick rest pocket backing\"></span><svg class=\"ind-tick\" data-kid=\"2-5-2-1-1-1-2\" data-name=\"tick rest checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span>\n<span class=\"caption\" data-kid=\"2-5-2-1-2\" data-name=\"tick rest caption\"><span class=\"k\" data-kid=\"2-5-2-1-2-1\" data-name=\"caption label Tick\">Tick</span><span class=\"k\" data-kid=\"2-5-2-1-2-2\" data-name=\"caption label Rest\">Rest</span></span>\n</div>\n<div class=\"pocket-cell\" data-kid=\"2-5-2-2\" data-name=\"tick checked pocket detail cell\">\n<span class=\"plate plate--on\" data-kid=\"2-5-2-2-1\" data-name=\"tick checked plate\"><span class=\"zoom zoom--tick is-on\" data-kid=\"2-5-2-2-1-1\" data-name=\"tick checked zoom container\"><span class=\"pocket\" data-kid=\"2-5-2-2-1-1-1\" data-name=\"tick checked pocket backing\"></span><svg class=\"ind-tick\" data-kid=\"2-5-2-2-1-1-2\" data-name=\"tick checked checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span>\n<span class=\"caption\" data-kid=\"2-5-2-2-2\" data-name=\"tick checked caption\"><span class=\"k\" data-kid=\"2-5-2-2-2-1\" data-name=\"caption label Tick\">Tick</span><span class=\"k\" data-kid=\"2-5-2-2-2-2\" data-name=\"caption label Checked\">Checked</span></span>\n</div>\n<div class=\"pocket-cell\" data-kid=\"2-5-2-3\" data-name=\"rank rest pocket detail cell\">\n<span class=\"plate plate--off\" data-kid=\"2-5-2-3-1\" data-name=\"rank rest plate\"><span class=\"zoom\" data-kid=\"2-5-2-3-1-1\" data-name=\"rank rest zoom container\"><span class=\"pocket\" data-kid=\"2-5-2-3-1-1-1\" data-name=\"rank rest pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-5-2-3-1-1-2\" data-name=\"rank rest numeral\"></span></span></span>\n<span class=\"caption\" data-kid=\"2-5-2-3-2\" data-name=\"rank rest caption\"><span class=\"k\" data-kid=\"2-5-2-3-2-1\" data-name=\"caption label Rank\">Rank</span><span class=\"k\" data-kid=\"2-5-2-3-2-2\" data-name=\"caption label Rest\">Rest</span></span>\n</div>\n<div class=\"pocket-cell\" data-kid=\"2-5-2-4\" data-name=\"rank checked pocket detail cell\">\n<span class=\"plate plate--on\" data-kid=\"2-5-2-4-1\" data-name=\"rank checked plate\"><span class=\"zoom is-on\" data-kid=\"2-5-2-4-1-1\" data-name=\"rank checked zoom container\"><span class=\"pocket\" data-kid=\"2-5-2-4-1-1-1\" data-name=\"rank checked pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-5-2-4-1-1-2\" data-name=\"rank checked numeral 1\">1</span></span></span>\n<span class=\"caption\" data-kid=\"2-5-2-4-2\" data-name=\"rank checked caption\"><span class=\"k\" data-kid=\"2-5-2-4-2-1\" data-name=\"caption label Rank\">Rank</span><span class=\"k\" data-kid=\"2-5-2-4-2-2\" data-name=\"caption label Checked\">Checked</span></span>\n</div>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-6\" data-name=\"section introducing the fill wash animation\">\n<div class=\"block__head\" data-kid=\"2-6-1\" data-name=\"fill section heading block\">\n<h2 data-kid=\"2-6-1-1\" data-name=\"fill section heading: The fill\">The fill</h2>\n<p data-kid=\"2-6-1-2\" data-name=\"fill section description text\">The wash grows from the pocket's centre in both indications — the tile's one address. Caught at 40%.</p>\n</div>\n<div class=\"fills\" data-kid=\"2-6-2\" data-name=\"fill catch frame grid\">\n<figure class=\"fill-cell\" data-kid=\"2-6-2-1\" data-name=\"tick indication fill catch figure\">\n<span class=\"tile is-static is-on is-fill40 m-vegan\" data-kid=\"2-6-2-1-1\" data-name=\"vegan tile at 40 percent fill\"><span class=\"ic\" data-kid=\"2-6-2-1-1-1\" data-name=\"vegan icon stack\"><svg class=\"lay body\" data-kid=\"2-6-2-1-1-1-1\" data-name=\"vegan stem body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-vegan\"></use></svg><svg class=\"lay part\" data-kid=\"2-6-2-1-1-1-2\" data-name=\"vegan leaf part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-vegan\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-6-2-1-1-2\" data-name=\"vegan tile name label\">Vegan</span><span class=\"tile__slot ind--tick\" data-kid=\"2-6-2-1-1-3\" data-name=\"vegan tick indicator slot\"><span class=\"pocket\" data-kid=\"2-6-2-1-1-3-1\" data-name=\"vegan tick pocket backing\"></span><svg class=\"ind-tick\" data-kid=\"2-6-2-1-1-3-2\" data-name=\"vegan tick checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span>\n<figcaption data-kid=\"2-6-2-1-2\" data-name=\"tick fill caption\"><span class=\"k\" data-kid=\"2-6-2-1-2-1\" data-name=\"tick fill caption label\">Tick</span><code data-kid=\"2-6-2-1-2-2\" data-name=\"tick fill clip-path code\">circle(40% at var(--fill-x) var(--fill-y))</code></figcaption>\n</figure>\n<figure class=\"fill-cell\" data-kid=\"2-6-2-2\" data-name=\"rank indication fill catch figure\">\n<span class=\"tile is-static is-on is-fill40 m-fry\" data-kid=\"2-6-2-2-1\" data-name=\"fry pan tile at 40 percent fill\"><span class=\"ic\" data-kid=\"2-6-2-2-1-1\" data-name=\"fry pan icon stack\"><svg class=\"lay body\" data-kid=\"2-6-2-2-1-1-1\" data-name=\"fry pan body icon\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-6-2-2-1-1-2\" data-name=\"fry pan food part icon\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span><span class=\"tile__name\" data-kid=\"2-6-2-2-1-2\" data-name=\"fry pan tile name label\">Fry pan</span><span class=\"tile__slot ind--rank\" data-kid=\"2-6-2-2-1-3\" data-name=\"fry pan rank indicator slot\"><span class=\"pocket\" data-kid=\"2-6-2-2-1-3-1\" data-name=\"fry pan rank pocket backing\"></span><span class=\"ind-num\" data-kid=\"2-6-2-2-1-3-2\" data-name=\"fry pan rank numeral 1\">1</span></span></span>\n<figcaption data-kid=\"2-6-2-2-2\" data-name=\"rank fill caption\"><span class=\"k\" data-kid=\"2-6-2-2-2-1\" data-name=\"rank fill caption label\">Rank</span><code data-kid=\"2-6-2-2-2-2\" data-name=\"rank fill clip-path code\">circle(40% at var(--fill-x) var(--fill-y))</code></figcaption>\n</figure>\n</div>\n<p class=\"rule-row\" data-kid=\"2-6-3\" data-name=\"fill rule notes row\"><span data-kid=\"2-6-3-1\" data-name=\"fill on rule note\"><b data-kid=\"2-6-3-1-1\" data-name=\"rule value 150 percent\">150%</b> on, from a corner</span><span data-kid=\"2-6-3-2\" data-name=\"fill overshoot rule note\"><b data-kid=\"2-6-3-2-1\" data-name=\"rule value 110 percent\">110%</b> would fall 12px short of the far corner at eight across</span><span data-kid=\"2-6-3-3\" data-name=\"fill off rule note\"><b data-kid=\"2-6-3-3-1\" data-name=\"rule value 0 percent\">0%</b> off, leaving at 160</span></p>\n</section>\n<section class=\"block\" data-kid=\"2-7\" data-name=\"section describing layer ownership contract\">\n<div class=\"block__head\" data-kid=\"2-7-1\" data-name=\"contract section heading block\">\n<h2 data-kid=\"2-7-1-1\" data-name=\"contract section heading: What each layer owns\">What each layer owns</h2>\n<p data-kid=\"2-7-1-2\" data-name=\"contract section description text\">The shell carries every state; the mark carries its own travel and reads its paint from the shell; the indication carries only the pocket's contents.</p>\n</div>\n<div class=\"contract\" data-kid=\"2-7-2\" data-name=\"layer ownership contract grid\">\n<section data-kid=\"2-7-2-1\" data-name=\"shell ownership panel\">\n<h3 data-kid=\"2-7-2-1-1\" data-name=\"shell ownership heading\">The shell</h3>\n<ul data-kid=\"2-7-2-1-2\" data-name=\"shell ownership list\">\n<li data-kid=\"2-7-2-1-2-1\" data-name=\"shell responsibility: surface and borders\"><b data-kid=\"2-7-2-1-2-1-1\" data-name=\"bold term: surface border corner\">Surface, border, 4px corner</b>, hover, press, focus ring</li>\n<li data-kid=\"2-7-2-1-2-2\" data-name=\"shell responsibility: the wash\"><b data-kid=\"2-7-2-1-2-2-1\" data-name=\"bold term: the wash\">The wash</b> and its origin: 150% on, 0% off</li>\n<li data-kid=\"2-7-2-1-2-3\" data-name=\"shell responsibility: the slot\"><b data-kid=\"2-7-2-1-2-3-1\" data-name=\"bold term: the slot\">The slot</b>: 20px at <code data-kid=\"2-7-2-1-2-3-2\" data-name=\"slot inset code token\">--space-2</code>, pocket drawn in rest</li>\n<li data-kid=\"2-7-2-1-2-4\" data-name=\"shell responsibility: paint tokens\"><b data-kid=\"2-7-2-1-2-4-1\" data-name=\"bold term: paint\">Paint</b>: <code data-kid=\"2-7-2-1-2-4-2\" data-name=\"surface paint token\">--surface</code>, <code data-kid=\"2-7-2-1-2-4-3\" data-name=\"food paint token\">--food</code>, <code data-kid=\"2-7-2-1-2-4-4\" data-name=\"leaf paint token\">--leaf</code>, <code data-kid=\"2-7-2-1-2-4-5\" data-name=\"steam paint token\">--steam</code>, <code data-kid=\"2-7-2-1-2-4-6\" data-name=\"stroke-width token\">--sw</code></li>\n<li data-kid=\"2-7-2-1-2-5\" data-name=\"shell responsibility: the name\"><b data-kid=\"2-7-2-1-2-5-1\" data-name=\"bold term: the name\">The name</b>: colour, then 700 at checked</li>\n<li data-kid=\"2-7-2-1-2-6\" data-name=\"shell responsibility: mark size token\"><b data-kid=\"2-7-2-1-2-6-1\" data-name=\"mark size bold-term wrap\"><code data-kid=\"2-7-2-1-2-6-1-1\" data-name=\"mark size code token\">--mark-size</code></b>, set by the bank</li>\n</ul>\n</section>\n<section data-kid=\"2-7-2-2\" data-name=\"indication ownership panel\">\n<h3 data-kid=\"2-7-2-2-1\" data-name=\"indication ownership heading\">The indication</h3>\n<ul data-kid=\"2-7-2-2-2\" data-name=\"indication ownership list\">\n<li data-kid=\"2-7-2-2-2-1\" data-name=\"indication responsibility: tick\"><b data-kid=\"2-7-2-2-2-1-1\" data-name=\"bold term: tick\">Tick</b>: 11px, no frame of its own, drawn over the pocket</li>\n<li data-kid=\"2-7-2-2-2-2\" data-name=\"indication responsibility: rank\"><b data-kid=\"2-7-2-2-2-2-1\" data-name=\"bold term: rank\">Rank</b>: the same pocket, inverted, with the numeral sealed in</li>\n<li data-kid=\"2-7-2-2-2-3\" data-name=\"indication responsibility: extensibility\"><b data-kid=\"2-7-2-2-2-3-1\" data-name=\"bold term: the next one\">The next one</b>: a third contents rule, not a third tile</li>\n<li data-kid=\"2-7-2-2-2-4\" data-name=\"indication responsibility: no geometry\">Neither sets geometry: <b data-kid=\"2-7-2-2-2-4-1\" data-name=\"bold term: the slot does\">the slot does</b></li>\n<li data-kid=\"2-7-2-2-2-5\" data-name=\"indication responsibility: no cap logic\">Neither knows the cap or the order: <b data-kid=\"2-7-2-2-2-5-1\" data-name=\"bold term: the bank does\">the bank does</b></li>\n</ul>\n</section>\n<section data-kid=\"2-7-2-3\" data-name=\"mark ownership panel\">\n<h3 data-kid=\"2-7-2-3-1\" data-name=\"mark ownership heading\">The mark</h3>\n<ul data-kid=\"2-7-2-3-2\" data-name=\"mark ownership list\">\n<li data-kid=\"2-7-2-3-2-1\" data-name=\"mark responsibility: layer count\"><b data-kid=\"2-7-2-3-2-1-1\" data-name=\"bold term: two or three layers\">Two or three layers</b>: body, part, tendrils</li>\n<li data-kid=\"2-7-2-3-2-2\" data-name=\"mark responsibility: own travel tokens\"><b data-kid=\"2-7-2-3-2-2-1\" data-name=\"bold term: its own travel\">Its own travel</b>: <code data-kid=\"2-7-2-3-2-2-2\" data-name=\"origin token\">--org</code>, <code data-kid=\"2-7-2-3-2-2-3\" data-name=\"pose token\">--pose</code>, <code data-kid=\"2-7-2-3-2-2-4\" data-name=\"hold token\">--hold</code></li>\n<li data-kid=\"2-7-2-3-2-3\" data-name=\"mark responsibility: reads paint\"><b data-kid=\"2-7-2-3-2-3-1\" data-name=\"bold term: reads the paint\">Reads the paint</b>, never declares a colour</li>\n<li data-kid=\"2-7-2-3-2-4\" data-name=\"mark responsibility: steam as layer\">Steam is a layer, not a tile feature</li>\n<li data-kid=\"2-7-2-3-2-5\" data-name=\"mark responsibility: oven occluder\">The oven door is filled with <code data-kid=\"2-7-2-3-2-5-1\" data-name=\"surface token\">--surface</code> so it occludes its food</li>\n</ul>\n</section>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-8\" data-name=\"section describing motion timing token table\">\n<div class=\"block__head\" data-kid=\"2-8-1\" data-name=\"timing section heading block\">\n<h2 data-kid=\"2-8-1-1\" data-name=\"timing section heading: Timing\">Timing</h2>\n<p data-kid=\"2-8-1-2\" data-name=\"timing section description text\">One set of tokens for both fields. Arrive at <code data-kid=\"2-8-1-2-1\" data-name=\"base duration token reference\">--duration-base</code>, leave at the step below it.</p>\n</div>\n<div class=\"timing\" data-kid=\"2-8-2\" data-name=\"timing token table\">\n<div class=\"trow trow--head\" data-kid=\"2-8-2-1\" data-name=\"timing table header row\"><span class=\"th\" data-kid=\"2-8-2-1-1\" data-name=\"header: step\">Step</span><span class=\"th\" data-kid=\"2-8-2-1-2\" data-name=\"header: easing\">Easing</span><span class=\"th\" data-kid=\"2-8-2-1-3\" data-name=\"header: duration\">Duration</span><span class=\"th\" data-kid=\"2-8-2-1-4\" data-name=\"header: value\">Value</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-2\" data-name=\"timing row: fill\"><span class=\"tstep\" data-kid=\"2-8-2-2-1\" data-name=\"step name Fill\">Fill</span><span class=\"ttok\" data-kid=\"2-8-2-2-2\" data-name=\"easing token ease-arrive\">--ease-arrive</span><span class=\"tdur\" data-kid=\"2-8-2-2-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-2-3-1\" data-name=\"duration value 250 ms\">250 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-2-3-2\" data-name=\"duration token reference\">--duration-base</span></span><span class=\"tval\" data-kid=\"2-8-2-2-4\" data-name=\"value description: fill circle\">circle 0 → 150% at the pocket's centre</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-3\" data-name=\"timing row: release\"><span class=\"tstep\" data-kid=\"2-8-2-3-1\" data-name=\"step name Release\">Release</span><span class=\"ttok\" data-kid=\"2-8-2-3-2\" data-name=\"easing token ease-depart\">--ease-depart</span><span class=\"tdur\" data-kid=\"2-8-2-3-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-3-3-1\" data-name=\"duration value 160 ms\">160 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-3-3-2\" data-name=\"duration token reference\">--duration-quick</span></span><span class=\"tval\" data-kid=\"2-8-2-3-4\" data-name=\"value description: release circle\">circle back to 0, pocket restored</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-4\" data-name=\"timing row: tick draw\"><span class=\"tstep\" data-kid=\"2-8-2-4-1\" data-name=\"step name Tick draw\">Tick draw</span><span class=\"ttok\" data-kid=\"2-8-2-4-2\" data-name=\"easing token ease-arrive\">--ease-arrive</span><span class=\"tdur\" data-kid=\"2-8-2-4-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-4-3-1\" data-name=\"duration value 160 ms\">160 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-4-3-2\" data-name=\"duration token reference\">--duration-quick</span></span><span class=\"tval\" data-kid=\"2-8-2-4-4\" data-name=\"value description: dashoffset\">dashoffset 17 → 0, delayed 100 ms</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-5\" data-name=\"timing row: pocket seal\"><span class=\"tstep\" data-kid=\"2-8-2-5-1\" data-name=\"step name Pocket seal\">Pocket seal</span><span class=\"ttok\" data-kid=\"2-8-2-5-2\" data-name=\"easing token ease-squish\">--ease-squish</span><span class=\"tdur\" data-kid=\"2-8-2-5-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-5-3-1\" data-name=\"duration value 160 ms\">160 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-5-3-2\" data-name=\"duration token reference\">--duration-quick</span></span><span class=\"tval\" data-kid=\"2-8-2-5-4\" data-name=\"value description: pocket scale\">scale 0.62 → 1, rank only</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-6\" data-name=\"timing row: numeral\"><span class=\"tstep\" data-kid=\"2-8-2-6-1\" data-name=\"step name Numeral\">Numeral</span><span class=\"ttok\" data-kid=\"2-8-2-6-2\" data-name=\"easing token ease-arrive\">--ease-arrive</span><span class=\"tdur\" data-kid=\"2-8-2-6-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-6-3-1\" data-name=\"duration value 160 ms\">160 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-6-3-2\" data-name=\"duration token reference\">--duration-quick</span></span><span class=\"tval\" data-kid=\"2-8-2-6-4\" data-name=\"value description: numeral reveal\">opacity 0 → 1, scale 0.4 → 1, delayed 100 ms</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-7\" data-name=\"timing row: part pose\"><span class=\"tstep\" data-kid=\"2-8-2-7-1\" data-name=\"step name Part pose\">Part pose</span><span class=\"ttok\" data-kid=\"2-8-2-7-2\" data-name=\"easing token ease-glide\">--ease-glide</span><span class=\"tdur\" data-kid=\"2-8-2-7-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-7-3-1\" data-name=\"duration value 250 ms\">250 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-7-3-2\" data-name=\"duration token reference\">--duration-base</span></span><span class=\"tval\" data-kid=\"2-8-2-7-4\" data-name=\"value description: mark pose\">each mark's own pose, per method</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-8\" data-name=\"timing row: hover\"><span class=\"tstep\" data-kid=\"2-8-2-8-1\" data-name=\"step name Hover\">Hover</span><span class=\"ttok\" data-kid=\"2-8-2-8-2\" data-name=\"easing token ease-linear\">--ease-linear</span><span class=\"tdur\" data-kid=\"2-8-2-8-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-8-3-1\" data-name=\"duration value 100 ms\">100 ms</span> <span class=\"ttok\" data-kid=\"2-8-2-8-3-2\" data-name=\"duration token reference\">--duration-tick</span></span><span class=\"tval\" data-kid=\"2-8-2-8-4\" data-name=\"value description: hover surfaces\">surface, border and pocket fill</span></div>\n<div class=\"trow\" data-kid=\"2-8-2-9\" data-name=\"timing row: steam loop\"><span class=\"tstep\" data-kid=\"2-8-2-9-1\" data-name=\"step name Steam loop\">Steam loop</span><span class=\"ttok\" data-kid=\"2-8-2-9-2\" data-name=\"easing: keyframe sequence\">keyframe sequence</span><span class=\"tdur\" data-kid=\"2-8-2-9-3\" data-name=\"duration cell\"><span class=\"tnum\" data-kid=\"2-8-2-9-3-1\" data-name=\"duration value 1500 ms\">1500 ms</span></span><span class=\"tval\" data-kid=\"2-8-2-9-4\" data-name=\"value description: steam rise\">rise and fade, per-device offset</span></div>\n</div>\n</section>\n</div>\n<script>\nfunction bank(root, { max }){\n  const tiles = [...root.querySelectorAll('.tile')];\n  let selected = tiles.filter(t => t.classList.contains('is-on')).map(t => t.dataset.value);\n\n  function paint(){\n    for (const t of tiles){\n      const rank = selected.indexOf(t.dataset.value) + 1;\n      const on = rank > 0;\n      const limit = max !== null && !on && selected.length >= max;\n      t.classList.toggle('is-on', on);\n      t.classList.toggle('is-limit', limit);\n      const input = t.querySelector('input');\n      if (input) input.checked = on;\n      const num = t.querySelector('.ind-num');\n      if (num) num.textContent = on ? String(rank) : '';\n    }\n  }\n\n  root.addEventListener('change', (e) => {\n    const tile = e.target.closest('.tile');\n    if (!tile) return;\n    const value = tile.dataset.value;\n    const at = selected.indexOf(value);\n    if (at > -1) selected.splice(at, 1);\n    else if (max === null || selected.length < max) selected.push(value);\n    paint();\n  });\n\n  paint();\n}\n\nbank(document.querySelector('#diet'), { max: null });\nbank(document.querySelector('#devices'), { max: 3 });\n</script>",
      "comments": [],
      "created": "2026-11-26T01:41:32.281991+00:00",
      "modified": "2026-11-26T01:56:05.391723+00:00",
      "id": "var_9eb82776e647"
    }
  },
