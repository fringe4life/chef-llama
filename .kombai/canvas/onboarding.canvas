    "var_b4a7abaa4193": {
      "type": "variant",
      "label": "Selection A — ink drop (circle collapses into the square)",
      "parentId": "var_a5a39bbf4983",
      "themeId": null,
      "rect": {
        "x": 7100,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  --box-line: color-mix(in oklab, var(--input) 74%, var(--foreground));\n  --ghost: color-mix(in oklab, var(--foreground) 20%, transparent);\n  --pocket: color-mix(in oklab, var(--foreground) 7%, transparent);\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1, h2, p, dl, dd{ margin: 0; }\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.sheet{ padding-block: var(--space-7) var(--space-10); container-type: inline-size; }\n\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: var(--border-width-thin) solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.stack{ display: grid; gap: var(--space-8); margin-block-start: var(--space-6); }\n.block{ display: grid; gap: var(--space-4); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.card{ max-inline-size: 34rem; padding: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n.field__head{ display: grid; gap: 2px; margin-block-end: var(--space-3); }\n.field__label{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.field__hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n\n/* ── the control: a pocket that visibly holds its own tick ────────────── */\n.row{ position: relative; display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--space-3); align-items: center; inline-size: 100%; min-block-size: 44px; padding-inline: var(--space-2); border-block-end: var(--border-width-thin) solid var(--border); cursor: pointer; transition: background-color 120ms linear; }\n.card .row:last-of-type{ border-block-end: 0; }\n.row:hover{ background: var(--secondary); }\n.row:active{ background: var(--muted); }\n.row input{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n.row input:focus-visible + .box{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.row__name{ overflow: hidden; text-overflow: ellipsis; }\n\n.box{\n  position: relative; display: block; justify-self: start;\n  inline-size: 20px; block-size: 20px; border-radius: 3px;\n  background: var(--background);\n  box-shadow: inset 0 0 0 var(--border-width-thin) var(--box-line), inset 0 1px 2px var(--pocket);\n  transition: box-shadow 140ms linear;\n}\n.box__clip{ position: absolute; inset: 0; border-radius: 3px; overflow: hidden; }\n.box__ghost, .box__tick{ position: absolute; inset: 4px; inline-size: 12px; block-size: 12px; fill: none; }\n.box__ghost{ color: var(--ghost); transition: opacity 150ms linear; }\n.box__tick{ color: var(--primary-foreground); stroke-dasharray: 15; stroke-dashoffset: 15; }\n\n/* ── A: the fill arrives as an ink drop, then collapses into the square ── */\n.box__fill{\n  position: absolute; inset: 0; background: var(--primary);\n  border-radius: 50%; opacity: 0; transform: scale(0.24);\n  transition: transform 150ms linear, opacity 130ms linear, border-radius 150ms linear;\n}\n.row input:checked + .box .box__fill{ animation: drop 400ms cubic-bezier(0.2, 0.9, 0.25, 1) both; }\n.row input:checked + .box .box__ghost{ opacity: 0; }\n.row input:checked + .box .box__tick{ animation: draw 200ms cubic-bezier(0.55, 0.1, 0.5, 1) 260ms both; }\n\n@keyframes drop{\n  0%{ transform: scale(0.2); border-radius: 50%; opacity: 0; }\n  14%{ opacity: 1; }\n  64%{ transform: scale(1.06); border-radius: 50%; opacity: 1; }\n  86%{ transform: scale(0.97); border-radius: 14%; opacity: 1; }\n  100%{ transform: scale(1); border-radius: 15%; opacity: 1; }\n}\n@keyframes draw{ from{ stroke-dashoffset: 15; } to{ stroke-dashoffset: 0; } }\n\n/* the same three moments, frozen */\n.box.d-mid .box__fill{ animation: none; transform: scale(0.6); border-radius: 50%; opacity: 1; }\n.box.d-mid .box__ghost{ opacity: 0.32; }\n.box.d-mid .box__tick{ animation: none; stroke-dashoffset: 15; }\n.box.d-on .box__fill{ animation: none; transform: scale(1); border-radius: 15%; opacity: 1; }\n.box.d-on .box__ghost{ opacity: 0; }\n.box.d-on .box__tick{ animation: none; stroke-dashoffset: 0; }\n.box.d-limit{ background: transparent; box-shadow: none; outline: var(--border-width-thin) dashed var(--input); outline-offset: -1px; }\n.box.d-limit .box__fill{ display: none; }\n.box.d-limit .box__ghost{ opacity: 0.45; }\n.box.d-limit .box__tick{ color: var(--muted-foreground); stroke-dashoffset: 9; }\n\n/* the magnified cut */\n.box.lg{ inline-size: 80px; block-size: 80px; border-radius: 12px; box-shadow: inset 0 0 0 var(--border-width-thin) var(--box-line), inset 0 2px 6px var(--pocket); }\n.box.lg .box__clip{ border-radius: 12px; }\n.box.lg .box__ghost, .box.lg .box__tick{ inset: 16px; inline-size: 48px; block-size: 48px; }\n\n/* ── the register of frozen moments ───────────────────────────────────── */\n.strip{ display: grid; grid-template-columns: 104px repeat(5, minmax(0, 1fr)); align-items: stretch; border-block: var(--border-width-thin) solid var(--border); }\n.cell{ display: grid; place-items: center; align-content: center; gap: var(--space-2); min-block-size: 96px; padding: var(--space-3) var(--space-2); border-inline-start: var(--border-width-thin) solid var(--border); }\n.cell--key{ justify-items: start; border-inline-start: 0; }\n.cell--h{ min-block-size: 0; padding-block: var(--space-2); }\n.k{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n/* ── timing ───────────────────────────────────────────────────────────── */\n.spec{ display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: var(--space-2) var(--space-4); }\n.spec dt{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); padding-block-start: 3px; }\n.spec dd{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); }\n.spec-note{ grid-column: 2; font-family: var(--font-sans); font-size: var(--text-xs); color: var(--muted-foreground); }\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" focusable=\"false\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\">\n<path d=\"M2.4 6.6c1.2 1.2 2.4 2.4 3.5 3.6 2-3.1 4-6 5.5-7.7\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.1\"></path>\n</symbol>\n</defs></svg>\n<div class=\"frame sheet\" data-kid=\"2\">\n<header class=\"head\" data-kid=\"2-1\">\n<h1 data-kid=\"2-1-1\">Selection A</h1>\n<p class=\"facts\" data-kid=\"2-1-2\"><span data-kid=\"2-1-2-1\">Ink drop</span><span data-kid=\"2-1-2-2\">Circle to square</span><span data-kid=\"2-1-2-3\" data-name=\"drop duration fact tag\">400 ms</span><span data-kid=\"2-1-2-4\">Tick last</span></p>\n</header>\n<div class=\"stack\" data-kid=\"2-2\">\n<section class=\"block\" data-kid=\"2-2-1\">\n<h2 data-kid=\"2-2-1-1\">In the form</h2>\n<div class=\"card\" data-kid=\"2-2-1-2\">\n<div class=\"field__head\" data-kid=\"2-2-1-2-1\">\n<span class=\"field__label\" data-kid=\"2-2-1-2-1-1\">Staples</span>\n<span class=\"field__hint\" data-kid=\"2-2-1-2-1-2\">Ticked staples are left off the Recipe's ingredient list.</span>\n</div>\n<label class=\"row\" data-kid=\"2-2-1-2-2\"><input checked=\"\" data-kid=\"2-2-1-2-2-1\" type=\"checkbox\"/><span class=\"box\" data-kid=\"2-2-1-2-2-2\"><span class=\"box__clip\" data-kid=\"2-2-1-2-2-2-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-1-2-2-2-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-1-2-2-2-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-1-2-2-2-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"row__name\" data-kid=\"2-2-1-2-2-3\">salt</span></label>\n<label class=\"row\" data-kid=\"2-2-1-2-3\"><input checked=\"\" data-kid=\"2-2-1-2-3-1\" type=\"checkbox\"/><span class=\"box\" data-kid=\"2-2-1-2-3-2\"><span class=\"box__clip\" data-kid=\"2-2-1-2-3-2-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-1-2-3-2-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-1-2-3-2-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-1-2-3-2-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"row__name\" data-kid=\"2-2-1-2-3-3\">oil</span></label>\n<label class=\"row\" data-kid=\"2-2-1-2-4\"><input data-kid=\"2-2-1-2-4-1\" type=\"checkbox\"/><span class=\"box\" data-kid=\"2-2-1-2-4-2\"><span class=\"box__clip\" data-kid=\"2-2-1-2-4-2-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-1-2-4-2-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-1-2-4-2-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-1-2-4-2-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"row__name\" data-kid=\"2-2-1-2-4-3\">pepper</span></label>\n<label class=\"row\" data-kid=\"2-2-1-2-5\"><input data-kid=\"2-2-1-2-5-1\" type=\"checkbox\"/><span class=\"box\" data-kid=\"2-2-1-2-5-2\"><span class=\"box__clip\" data-kid=\"2-2-1-2-5-2-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-1-2-5-2-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-1-2-5-2-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-1-2-5-2-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"row__name\" data-kid=\"2-2-1-2-5-3\">cumin</span></label>\n<label class=\"row\" data-kid=\"2-2-1-2-6\"><input data-kid=\"2-2-1-2-6-1\" type=\"checkbox\"/><span class=\"box\" data-kid=\"2-2-1-2-6-2\"><span class=\"box__clip\" data-kid=\"2-2-1-2-6-2-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-1-2-6-2-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-1-2-6-2-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-1-2-6-2-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"row__name\" data-kid=\"2-2-1-2-6-3\">paprika</span></label>\n<label class=\"row\" data-kid=\"2-2-1-2-7\"><input data-kid=\"2-2-1-2-7-1\" type=\"checkbox\"/><span class=\"box\" data-kid=\"2-2-1-2-7-2\"><span class=\"box__clip\" data-kid=\"2-2-1-2-7-2-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-1-2-7-2-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-1-2-7-2-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-1-2-7-2-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"row__name\" data-kid=\"2-2-1-2-7-3\">turmeric</span></label>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-2-2\">\n<h2 data-kid=\"2-2-2-1\">The transition</h2>\n<div class=\"strip\" data-kid=\"2-2-2-2\">\n<span class=\"cell cell--key cell--h\" data-kid=\"2-2-2-2-1\"><span class=\"k\" data-kid=\"2-2-2-2-1-1\">20 px</span></span>\n<span class=\"cell cell--h\" data-kid=\"2-2-2-2-2\"><span class=\"k\" data-kid=\"2-2-2-2-2-1\">Off</span></span>\n<span class=\"cell cell--h\" data-kid=\"2-2-2-2-3\"><span class=\"k\" data-kid=\"2-2-2-2-3-1\">Mid</span></span>\n<span class=\"cell cell--h\" data-kid=\"2-2-2-2-4\"><span class=\"k\" data-kid=\"2-2-2-2-4-1\">On</span></span>\n<span class=\"cell cell--h\" data-kid=\"2-2-2-2-5\"><span class=\"k\" data-kid=\"2-2-2-2-5-1\">Mid, 4×</span></span>\n<span class=\"cell cell--h\" data-kid=\"2-2-2-2-6\"><span class=\"k\" data-kid=\"2-2-2-2-6-1\">At limit</span></span>\n<span class=\"cell cell--key\" data-kid=\"2-2-2-2-7\"><span class=\"box d-on\" data-kid=\"2-2-2-2-7-1\"><span class=\"box__clip\" data-kid=\"2-2-2-2-7-1-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-7-1-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-7-1-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-7-1-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-8\"><span class=\"box\" data-kid=\"2-2-2-2-8-1\"><span class=\"box__clip\" data-kid=\"2-2-2-2-8-1-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-8-1-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-8-1-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-8-1-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-9\"><span class=\"box d-mid\" data-kid=\"2-2-2-2-9-1\"><span class=\"box__clip\" data-kid=\"2-2-2-2-9-1-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-9-1-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-9-1-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-9-1-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-10\"><span class=\"box d-on\" data-kid=\"2-2-2-2-10-1\"><span class=\"box__clip\" data-kid=\"2-2-2-2-10-1-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-10-1-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-10-1-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-10-1-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-11\"><span class=\"box lg d-mid\" data-kid=\"2-2-2-2-11-1\"><span class=\"box__clip\" data-kid=\"2-2-2-2-11-1-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-11-1-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-11-1-1-2\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-11-1-1-3\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-12\"><span class=\"box d-limit\" data-kid=\"2-2-2-2-12-1\"><span class=\"box__clip\" data-kid=\"2-2-2-2-12-1-1\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-12-1-1-1\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-12-1-1-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-2-3\">\n<h2 data-kid=\"2-2-3-1\">Timing</h2>\n<dl class=\"spec\" data-kid=\"2-2-3-2\">\n<dt data-kid=\"2-2-3-2-1\">Drop</dt><dd data-kid=\"2-2-3-2-2\" data-name=\"drop timing value for Drop\">400 ms</dd>\n<dt data-kid=\"2-2-3-2-3\">Curve</dt><dd data-kid=\"2-2-3-2-4\">cubic-bezier(0.2, 0.9, 0.25, 1)</dd>\n<dt data-kid=\"2-2-3-2-5\">Circular</dt><dd data-kid=\"2-2-3-2-6\" data-name=\"circular phase timing value\">0 – 256 ms</dd>\n<dt data-kid=\"2-2-3-2-7\">Square</dt><dd data-kid=\"2-2-3-2-8\" data-name=\"square phase timing value\">256 – 400 ms</dd>\n<dt data-kid=\"2-2-3-2-9\">Tick</dt><dd data-dynamic=\"true\" data-kid=\"2-2-3-2-10\" data-name=\"tick timing value\" data-reason=\"delay value reinitialized from updated CSS animation timing (320/190 changed to 400/260 ms)\">200 ms, delay 260 ms</dd>\n<dt data-kid=\"2-2-3-2-11\">Reverse</dt><dd data-kid=\"2-2-3-2-12\">150 ms, no tick</dd>\n<dt data-kid=\"2-2-3-2-13\">Reduced motion</dt><dd data-kid=\"2-2-3-2-14\">Endpoint only, no travel</dd>\n</dl>\n</section>\n</div>\n</div>\n",
