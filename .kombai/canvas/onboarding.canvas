ic is-filled\" data-kid=\"2-2-3-2-4-1\" data-name=\"100% fill chip specimen\"><span class=\"chip__slot\" data-kid=\"2-2-3-2-4-1-1\" data-name=\"chip check pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-3-2-4-1-1-1\" data-name=\"chip check pocket outline\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-3-2-4-1-1-2\" data-name=\"chip checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-3-2-4-1-1-3\" data-name=\"chip focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"2-2-3-2-4-1-2\" data-name=\"chip label text\">sulphites</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-3-2-4-1-3\" data-name=\"chip checked wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-2-3-2-4-1-3-1\" data-name=\"checked wash label text\">sulphites</span></span></span><span class=\"k\" data-kid=\"2-2-3-2-4-2\" data-name=\"stage fill percentage label\">100%</span></div>\n<div class=\"stage\" data-kid=\"2-2-3-2-5\" data-name=\"off-state 4x pocket stage cell\"><span class=\"big-slot\" data-kid=\"2-2-3-2-5-1\" data-name=\"off-state 4x magnified pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-3-2-5-1-1\" data-name=\"off-state pocket outline\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-3-2-5-1-2\" data-name=\"off-state checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"detail__sizes\" data-kid=\"2-2-3-2-5-2\" data-name=\"4x stage size caption group\"><span class=\"k\" data-kid=\"2-2-3-2-5-2-1\" data-name=\"stage state caption\">Off</span><span class=\"k\" data-kid=\"2-2-3-2-5-2-2\" data-name=\"stage magnification caption\">4×</span></span></div>\n<div class=\"stage\" data-kid=\"2-2-3-2-6\" data-name=\"on-state 4x pocket stage cell\"><span class=\"big-slot is-on\" data-kid=\"2-2-3-2-6-1\" data-name=\"on-state 4x magnified pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-3-2-6-1-1\" data-name=\"on-state pocket fill\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-3-2-6-1-2\" data-name=\"on-state checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"detail__sizes\" data-kid=\"2-2-3-2-6-2\" data-name=\"4x stage size caption group\"><span class=\"k\" data-kid=\"2-2-3-2-6-2-1\" data-name=\"stage state caption\">On</span><span class=\"k\" data-kid=\"2-2-3-2-6-2-2\" data-name=\"stage magnification caption\">4×</span></span></div>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-2-4\">\n<h2 data-kid=\"2-2-4-1\">Timing</h2>\n<div class=\"timing\" data-kid=\"2-2-4-2\">\n<div class=\"trow trow--head\" data-kid=\"2-2-4-2-1\"><span class=\"th\" data-kid=\"2-2-4-2-1-1\">Step</span><span class=\"th\" data-kid=\"2-2-4-2-1-2\">Easing</span><span class=\"th\" data-kid=\"2-2-4-2-1-3\">Duration</span><span class=\"th\" data-kid=\"2-2-4-2-1-4\">Value</span></div>\n<div class=\"trow\" data-kid=\"2-2-4-2-2\"><span class=\"tstep\" data-kid=\"2-2-4-2-2-1\">Fill</span><span class=\"ttok\" data-kid=\"2-2-4-2-2-2\">--ease-arrive</span><span class=\"tdur\" data-kid=\"2-2-4-2-2-3\"><span class=\"ttok\" data-kid=\"2-2-4-2-2-3-1\">--duration-base</span><span class=\"tnum\" data-kid=\"2-2-4-2-2-3-2\">250 ms</span></span><span class=\"tval\" data-kid=\"2-2-4-2-2-4\">circle 0 → 150%, origin at the pocket</span></div>\n<div class=\"trow\" data-kid=\"2-2-4-2-3\"><span class=\"tstep\" data-kid=\"2-2-4-2-3-1\">Pocket seal</span><span class=\"ttok\" data-kid=\"2-2-4-2-3-2\">--ease-squish</span><span class=\"tdur\" data-kid=\"2-2-4-2-3-3\"><span class=\"ttok\" data-kid=\"2-2-4-2-3-3-1\">--duration-quick</span><span class=\"tnum\" data-kid=\"2-2-4-2-3-3-2\">160 ms</span></span><span class=\"tval\" data-kid=\"2-2-4-2-3-4\">scale 0.62 → 1, peak 1.131</span></div>\n<div class=\"trow\" data-kid=\"2-2-4-2-4\"><span class=\"tstep\" data-kid=\"2-2-4-2-4-1\">Ring</span><span class=\"ttok\" data-kid=\"2-2-4-2-4-2\">--ease-arrive</span><span class=\"tdur\" data-kid=\"2-2-4-2-4-3\"><span class=\"ttok\" data-kid=\"2-2-4-2-4-3-1\">--duration-base</span><span class=\"tnum\" data-kid=\"2-2-4-2-4-3-2\">250 ms</span></span><span class=\"tval\" data-kid=\"2-2-4-2-4-4\">scale 1 → 1.9, opacity 0.7 → 0</span></div>\n<div class=\"trow\" data-kid=\"2-2-4-2-5\"><span class=\"tstep\" data-kid=\"2-2-4-2-5-1\">Tick</span><span class=\"ttok\" data-kid=\"2-2-4-2-5-2\">--ease-arrive</span><span class=\"tdur\" data-kid=\"2-2-4-2-5-3\"><span class=\"ttok\" data-kid=\"2-2-4-2-5-3-1\">--duration-quick</span><span class=\"tnum\" data-kid=\"2-2-4-2-5-3-2\">160 ms</span></span><span class=\"tval\" data-kid=\"2-2-4-2-5-4\" data-name=\"timing tick delay and value description\">dashoffset 17 → 0, delay 100 ms</span></div>\n<div class=\"trow\" data-kid=\"2-2-4-2-6\"><span class=\"tstep\" data-kid=\"2-2-4-2-6-1\">Release</span><span class=\"ttok\" data-kid=\"2-2-4-2-6-2\">--ease-depart</span><span class=\"tdur\" data-kid=\"2-2-4-2-6-3\"><span class=\"ttok\" data-kid=\"2-2-4-2-6-3-1\">--duration-quick</span><span class=\"tnum\" data-kid=\"2-2-4-2-6-3-2\">160 ms</span></span><span class=\"tval\" data-kid=\"2-2-4-2-6-4\">circle back to 0, tick withdrawn</span></div>\n<div class=\"trow\" data-kid=\"2-2-4-2-7\"><span class=\"tstep\" data-kid=\"2-2-4-2-7-1\">Hover</span><span class=\"ttok\" data-kid=\"2-2-4-2-7-2\">--ease-linear</span><span class=\"tdur\" data-kid=\"2-2-4-2-7-3\"><span class=\"ttok\" data-kid=\"2-2-4-2-7-3-1\">--duration-tick</span><span class=\"tnum\" data-kid=\"2-2-4-2-7-3-2\">100 ms</span></span><span class=\"tval\" data-kid=\"2-2-4-2-7-4\">surface and line colour</span></div>\n</div>\n</section>\n</div>\n</div>",
      "comments": [],
      "created": "2026-11-23T02:47:55.379194+00:00",
      "modified": "2026-11-23T02:51:40.138802+00:00",
