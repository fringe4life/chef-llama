p\">\n<p class=\"lb\" data-kid=\"2-2-2-3-2-1-2-1\" data-name=\"group heading for spices and herbs\">Spices and herbs</p>\n<div class=\"rack2\" data-kid=\"2-2-2-3-2-1-2-2\" data-name=\"spices checkbox rack\">\n<div data-kid=\"2-2-2-3-2-1-2-2-1\" data-name=\"spices checkbox column 1\">\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-1-1\" data-name=\"staple checkbox: chilli flakes\"><input data-kid=\"2-2-2-3-2-1-2-2-1-1-1\" data-name=\"staple checkbox input: chilli flakes\" type=\"checkbox\"/>chilli flakes</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-1-2\" data-name=\"staple checkbox: cumin\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-2-2-1-2-1\" data-name=\"staple checkbox input: cumin\" type=\"checkbox\"/>cumin</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-1-3\" data-name=\"staple checkbox: paprika\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-2-2-1-3-1\" data-name=\"staple checkbox input: paprika\" type=\"checkbox\"/>paprika</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-1-4\" data-name=\"staple checkbox: oregano\"><input data-kid=\"2-2-2-3-2-1-2-2-1-4-1\" data-name=\"staple checkbox input: oregano\" type=\"checkbox\"/>oregano</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-1-5\" data-name=\"staple checkbox: turmeric\"><input data-kid=\"2-2-2-3-2-1-2-2-1-5-1\" data-name=\"staple checkbox input: turmeric\" type=\"checkbox\"/>turmeric</label>\n</div>\n<div data-kid=\"2-2-2-3-2-1-2-2-2\" data-name=\"spices checkbox column 2\">\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-2-1\" data-name=\"staple checkbox: cinnamon\"><input data-kid=\"2-2-2-3-2-1-2-2-2-1-1\" data-name=\"staple checkbox input: cinnamon\" type=\"checkbox\"/>cinnamon</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-2-2\" data-name=\"staple checkbox: curry powder\"><input data-kid=\"2-2-2-3-2-1-2-2-2-2-1\" data-name=\"staple checkbox input: curry powder\" type=\"checkbox\"/>curry powder</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-2-3\" data-name=\"staple checkbox: garlic powder\"><input data-kid=\"2-2-2-3-2-1-2-2-2-3-1\" data-name=\"staple checkbox input: garlic powder\" type=\"checkbox\"/>garlic powder</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-2-4\" data-name=\"staple checkbox: ginger\"><input data-kid=\"2-2-2-3-2-1-2-2-2-4-1\" data-name=\"staple checkbox input: ginger\" type=\"checkbox\"/>ginger</label>\n<label class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-2-5\" data-name=\"staple checkbox: coriander\"><input data-kid=\"2-2-2-3-2-1-2-2-2-5-1\" data-name=\"staple checkbox input: coriander\" type=\"checkbox\"/>coriander</label>\n</div>\n</div>\n</div>\n</div>\n<div class=\"grp\" data-kid=\"2-2-2-3-2-2\" data-name=\"custom staples group\">\n<p class=\"lb\" data-kid=\"2-2-2-3-2-2-1\" data-name=\"group heading for custom staples\">Your own</p>\n<div class=\"mine\" data-kid=\"2-2-2-3-2-2-2\" data-name=\"custom staple chips container\">\n<span class=\"mine__chip\" data-kid=\"2-2-2-3-2-2-2-1\" data-name=\"custom staple chip: soy sauce\">soy sauce<button aria-label=\"Remove soy sauce\" class=\"chip__x\" data-kid=\"2-2-2-3-2-2-2-1-1\" data-name=\"remove chip button: soy sauce\" type=\"button\"><svg class=\"x\" data-kid=\"2-2-2-3-2-2-2-1-1-1\" data-name=\"x close icon\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n<span class=\"mine__chip\" data-kid=\"2-2-2-3-2-2-2-2\" data-name=\"custom staple chip: chicken stock\">chicken stock<button aria-label=\"Remove chicken stock\" class=\"chip__x\" data-kid=\"2-2-2-3-2-2-2-2-1\" data-name=\"remove chip button: chicken stock\" type=\"button\"><svg class=\"x\" data-kid=\"2-2-2-3-2-2-2-2-1-1\" data-name=\"x close icon\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n</div>\n<div class=\"addrow\" data-kid=\"2-2-2-3-2-2-3\" data-name=\"add staple row\">\n<label class=\"lb--sub\" data-kid=\"2-2-2-3-2-2-3-1\" data-name=\"add staple field label\" for=\"c3-add\">Add a staple</label>\n<input class=\"input\" data-kid=\"2-2-2-3-2-2-3-2\" data-name=\"add staple text input\" id=\"c3-add\" placeholder=\"e.g. fish sauce\" type=\"text\"/>\n</div>\n</div>\n</div>\n<figure class=\"band\" data-kid=\"2-2-2-3-3\" data-name=\"example ingredient band\">\n<div class=\"band__in\" data-kid=\"2-2-2-3-3-1\" data-name=\"band inner layout\">\n<p class=\"tag\" data-kid=\"2-2-2-3-3-1-1\" data-name=\"band example tag\">Example</p>\n<div class=\"cols3\" data-kid=\"2-2-2-3-3-1-2\" data-name=\"example columns row\">\n<div class=\"grp\" data-kid=\"2-2-2-3-3-1-2-1\" data-name=\"listed staples column\">\n<p class=\"tag\" data-kid=\"2-2-2-3-3-1-2-1-1\" data-name=\"column heading: Listed\">Listed</p>\n<p class=\"bn\" data-kid=\"2-2-2-3-3-1-2-1-2\" data-name=\"listed staple item: firm tofu\">firm tofu</p>\n<p class=\"bn\" data-kid=\"2-2-2-3-3-1-2-1-3\" data-name=\"listed staple item: jasmine rice\">jasmine rice</p>\n<p class=\"bn\" data-kid=\"2-2-2-3-3-1-2-1-4\" data-name=\"listed staple item: soy sauce\">soy sauce</p>\n</div>\n<div class=\"grp\" data-kid=\"2-2-2-3-3-1-2-2\" data-name=\"not listed column\">\n<p class=\"tag\" data-kid=\"2-2-2-3-3-1-2-2-1\" data-name=\"column heading: Not listed\">Not listed</p>\n<p class=\"bn bn--out\" data-kid=\"2-2-2-3-3-1-2-2-2\" data-name=\"non-listed staple: salt\">salt</p>\n<p class=\"bn bn--out\" data-kid=\"2-2-2-3-3-1-2-2-3\" data-name=\"non-listed staple: olive oil\">olive oil</p>\n<p class=\"bn bn--out\" data-kid=\"2-2-2-3-3-1-2-2-4\" data-name=\"non-listed staple: black pepper\">black pepper</p>\n</div>\n<p class=\"band__note\" data-kid=\"2-2-2-3-3-1-2-3\" data-name=\"band explanatory note with bold lead\"><b data-kid=\"2-2-2-3-3-1-2-3-1\" data-name=\"note bold emphasis\">Ticked staples stay off the ingredient list.</b> The Recipe can still bring one in when it suits the dish, so you never add them again.</p>\n</div>\n</div>\n</figure>\n<div class=\"foot\" data-kid=\"2-2-2-3-4\" data-name=\"page action button bar\">\n<button class=\"btn btn--quiet\" data-kid=\"2-2-2-3-4-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-2-2-3-4-2\" data-name=\"continue primary button\" type=\"button\">Continue</button>\n</div>\n</main>\n</div>\n</section>\n</div>",
      "comments": [],
      "created": "2026-11-22T11:50:34.655921+00:00",
      "modified": "2026-11-22T11:51:53.671046+00:00",
      "id": "var_a7850d5082d6",
      "contentHeight": 1859
    },
    "var_7df99a16189d": {
      "type": "variant",
      "label": "Selection D — outline chips, the fill spreads from the pocket",
      "parentId": "var_229ec6197e9b",
      "themeId": null,
      "rect": {
        "x": 23799,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  --box-line: color-mix(in oklab, var(--input) 74%, var(--foreground));\n\n  --ease-arrive: linear(0, 0.264 6.25%, 0.38 9.375%, 0.482 12.5%, 0.571 15.625%, 0.647 18.75%, 0.765 25%, 0.829 29.688%, 0.876 34.375%, 0.937 43.75%, 0.98 57.813%, 0.998 78.906%, 1);\n  --ease-depart: linear(0, 0.002 21.094%, 0.02 42.188%, 0.063 56.25%, 0.124 65.625%, 0.171 70.313%, 0.235 75%, 0.353 81.25%, 0.429 84.375%, 0.518 87.5%, 0.62 90.625%, 0.736 93.75%, 1);\n  --ease-glide: linear(0, 0.002 3.125%, 0.01 6.25%, 0.022 9.375%, 0.039 12.5%, 0.085 18.75%, 0.148 25%, 0.211 30.273%, 0.282 35.547%, 0.368 41.479%, 0.643 59.277%, 0.756 67.188%, 0.843 74.219%, 0.881 77.734%, 0.915 81.25%, 0.951 85.938%, 0.978 90.625%, 0.994 95.313%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.092 41.3%, 1.117 46%, 1.13 51%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --ease-anticipate: linear(0, -0.006 5.6%, -0.038 17.6%, -0.04 22.9%, -0.016 29%, 0.042 34.5%, 0.131 39.3%, 0.254 43.8%, 0.654 53.6%, 0.803 58.1%, 0.92 63.2%, 0.996 68.6%, 1.03 73.4%, 1.041 78.7%, 1);\n  --ease-linear: linear(0, 1);\n  --duration-tick: 100ms;\n  --duration-quick: 160ms;\n  --duration-base: 250ms;\n  --duration-slow: 400ms;\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,fieldset,legend,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; }\nbutton{ font: inherit; color: inherit; }\n.sr-only{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.sheet{ padding-block: var(--space-7) var(--space-10); container-type: inline-size; }\n\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: var(--border-width-thin) solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.stack{ display: grid; gap: var(--space-10); margin-block-start: var(--space-6); }\n.block{ display: grid; gap: var(--space-4); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.duo{ display: grid; align-items: start; gap: var(--space-5); }\n@container (inline-size >= 860px){ .duo{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: var(--space-7); } }\n.card{ display: grid; gap: var(--space-4); align-content: start; padding: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n.field__head{ display: grid; gap: 2px; }\n.field__label{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.field__hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.group{ display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.k{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n/* ── the chip: an outline button with an empty pocket at its start ─────── */\n.chip{\n  --pad-x: var(--space-3);\n  --slot: 14px;\n  --gap: var(--space-2);\n  --label-x: calc(var(--pad-x) + var(--slot) + var(--gap));\n  --surface: var(--card);\n  --well: var(--card);\n  position: relative;\n  display: inline-flex; align-items: center; gap: var(--gap);\n  min-block-size: 32px; padding-inline: var(--pad-x);\n  border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm);\n  background: var(--surface); color: var(--foreground);\n  font-size: var(--text-sm); line-height: var(--leading-solid); white-space: nowrap;\n  cursor: pointer; overflow: hidden;\n  transition: background-color var(--duration-tick) var(--ease-linear),\n              border-color var(--duration-tick) var(--ease-linear),\n              transform var(--duration-quick) var(--ease-squish);\n}\n.chip input{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n.chip__name{ position: relative; z-index: 0; overflow: hidden; text-overflow: ellipsis; }\n.chip__slot{ position: relative; z-index: 2; flex: none; display: grid; place-items: center; inline-size: var(--slot); block-size: var(--slot); }\n/* the pocket: a box pulled a hair off true, empty in the off state */\n.chip__pocket{\n  position: absolute; inset: 0;\n  background: var(--box-line);\n  clip-path: polygon(4% 2%, 98% 6%, 99% 94%, 2% 99%);\n  transition: background-color var(--duration-tick) var(--ease-linear);\n}\n.chip__pocket::before{\n  content: \"\"; position: absolute; inset: 1px;\n  background: var(--surface);\n  clip-path: inherit;\n  transition: background-color var(--duration-tick) var(--ease-linear);\n}\n.chip__tick{\n  position: absolute; z-index: 1;\n  inline-size: calc(var(--slot) - 3px); block-size: calc(var(--slot) - 3px);\n  color: var(--primary-foreground);\n  stroke-dasharray: 17; stroke-dashoffset: 17;\n  overflow: visible;\n}\n.chip__ring{\n  position: absolute; inset: -1px; border-radius: 4px;\n  border: var(--border-width-thin) solid var(--ring);\n  opacity: 0; pointer-events: none;\n}\n/* the gold plate under the type, clipped to the circle that grows from the pocket */\n.chip__wash{\n  position: absolute; inset: 0; z-index: 1;\n  background: var(--primary);\n  clip-path: circle(0% at calc(var(--pad-x) + var(--slot) / 2) 50%);\n  transition: clip-path var(--duration-quick) var(--ease-depart),\n              background-color var(--duration-tick) var(--ease-linear);\n}\n.chip__wash-label{\n  position: absolute; inset-block: 0; inset-inline-start: var(--label-x);\n  display: flex; align-items: center;\n  color: var(--primary-foreground);\n}\n\n.chip:not(.is-static):hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.chip:not(.is-static):active{ --surface: var(--muted); transform: translateY(1px); }\n.chip:has(input:focus-visible){ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n.chip:has(input:checked){ border-color: var(--primary); }\n.chip:has(input:checked) .chip__wash{\n  clip-path: circle(150% at calc(var(--pad-x) + var(--slot) / 2) 50%);\n  transition: clip-path var(--duration-base) var(--ease-arrive),\n              background-color var(--duration-tick) var(--ease-linear);\n}\n.chip:has(input:checked) .chip__pocket{ background: transparent; animation: pocket-seal var(--duration-quick) var(--ease-squish) both; }\n.chip:has(input:checked) .chip__pocket::before{ background: transparent; }\n.chip:has(input:checked) .chip__tick{ animation: tick-draw var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n.chip:has(input:checked) .chip__ring{ animation: ring-out var(--duration-base) var(--ease-arrive) both; }\n.chip:has(input:checked):hover .chip__wash{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n.chip:has(input:checked):active .chip__wash{ background: color-mix(in oklab, var(--primary) 86%, var(--foreground)); }\n.chip:has(input:disabled){ border-style: dashed; border-color: var(--input); background: transparent; color: var(--muted-foreground); cursor: not-allowed; transform: none; }\n.chip:has(input:disabled) .chip__pocket{ background: color-mix(in oklab, var(--input) 55%, transparent); }\n.chip:has(input:disabled) .chip__pocket::before{ background: var(--well); }\n.chip:has(input:disabled) .chip__tick{ animation: none; stroke-dashoffset: 17; }\n\n/* the same states drawn by hand, for the register and the fill stages */\n.chip.is-hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.chip.is-hover .chip__pocket::before{ background: var(--secondary); }\n.chip.is-press{ --surface: var(--muted); transform: translateY(1px); }\n.chip.is-press .chip__pocket::before{ background: var(--muted); }\n.chip.is-focus{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.chip.is-off{ border-style: dashed; border-color: var(--input); background: transparent; color: var(--muted-foreground); --well: var(--background); }\n.chip.is-off .chip__pocket{ background: color-mix(in oklab, var(--input) 55%, transparent); }\n.chip.is-off .chip__pocket::before{ background: var(--well); }\n.chip.is-fill40 .chip__wash{ clip-path: circle(40% at calc(var(--pad-x) + var(--slot) / 2) 50%); }\n.chip.is-fill80 .chip__wash{ clip-path: circle(80% at calc(var(--pad-x) + var(--slot) / 2) 50%); }\n.chip.is-fill40 .chip__pocket,\n.chip.is-fill80 .chip__pocket{ background: transparent; }\n.chip.is-fill40 .chip__pocket::before,\n.chip.is-fill80 .chip__pocket::before{ background: transparent; }\n.chip.is-fill40, .chip.is-fill80, .chip.is-filled{ border-color: var(--primary); }\n.chip.is-filled .chip__wash{ clip-path: circle(150% at calc(var(--pad-x) + var(--slot) / 2) 50%); }\n.chip.is-filled .chip__pocket{ background: transparent; }\n.chip.is-filled .chip__pocket::before{ background: transparent; }\n.chip.is-filled .chip__tick{ stroke-dashoffset: 0; }\n.chip.is-static{ cursor: default; }\n\n@keyframes pocket-seal{ from{ transform: scale(0.62); } to{ transform: scale(1); } }\n@keyframes ring-out{ from{ transform: scale(1); opacity: 0.7; } to{ transform: scale(1.9); opacity: 0; } }\n@keyframes tick-draw{ from{ stroke-dashoffset: 17; } to{ stroke-dashoffset: 0; } }\n\n/* ── the register of states, hairlines only ────────────────────────────── */\n.register{ display: grid; }\n.reg-row{ display: grid; grid-template-columns: 84px repeat(7, minmax(0, 1fr)); align-items: stretch; }\n.reg-row + .reg-row{ border-block-start: var(--border-width-thin) solid var(--border); }\n.reg-row--head{ align-items: end; border-block-end: var(--border-width-thin) solid var(--border); }\n.reg-key{ display: flex; align-items: center; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.reg-h{ padding: var(--space-2); text-align: center; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.reg-cell{ display: grid; place-items: center; padding: var(--space-4) var(--space-2); min-block-size: 64px; border-inline-start: var(--border-width-thin) solid var(--border); }\n.reg-cell:first-of-type{ border-inline-start: 0; }\n\n/* ── fill stages and the pocket at 4x ──────────────────────────────────── */\n.stages{ display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-block: var(--border-width-thin) solid var(--border); }\n.stage{ display: grid; grid-template-rows: 56px auto; align-items: center; justify-items: center; gap: var(--space-3); padding: var(--space-5) var(--space-2); border-inline-start: var(--border-width-thin) solid var(--border); }\n.stage:first-child{ border-inline-start: 0; }\n.detail__sizes{ display: flex; gap: var(--space-2); }\n.big-slot{\n  --slot: 56px;\n  --surface: var(--background);\n  position: relative; display: grid; place-items: center;\n  inline-size: var(--slot); block-size: var(--slot);\n}\n.big-slot .chip__tick{ inline-size: calc(var(--slot) - 16px); block-size: calc(var(--slot) - 16px); }\n.big-slot.is-on .chip__pocket{ background: var(--primary); }\n.big-slot.is-on .chip__pocket::before{ background: transparent; }\n.big-slot.is-on .chip__tick{ stroke-dashoffset: 0; }\n\n/* ── timing, token by token ────────────────────────────────────────────── */\n.timing{ display: grid; }\n.trow{ display: grid; grid-template-columns: minmax(0,1fr) 170px 200px minmax(0,1.45fr); gap: var(--space-3); align-items: center; min-block-size: 40px; }\n.trow + .trow{ border-block-start: var(--border-width-thin) solid var(--border); }\n.trow--head{ min-block-size: 30px; border-block-end: var(--border-width-thin) solid var(--border); }\n.th{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.tstep{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.ttok{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n.tdur{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); }\n.tnum{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); }\n.tval{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n@media (prefers-reduced-motion: reduce){\n  .chip__wash{ transition: none; }\n  .chip__pocket, .chip__tick, .chip__ring{ animation: none; }\n  .chip:has(input:checked) .chip__tick{ stroke-dashoffset: 0; }\n}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" focusable=\"false\" style=\"position:absolute;inline-size:0;block-size:0\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\">\n<path d=\"M2.4 6.6c1.2 1.2 2.4 2.4 3.5 3.6 2-3.1 4-6 5.5-7.7\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.1\"></path>\n</symbol>\n</defs></svg>\n<div class=\"frame sheet\" data-kid=\"2\">\n<header class=\"head\" data-kid=\"2-1\">\n<h1 data-kid=\"2-1-1\">Selection D</h1>\n<p class=\"facts\" data-kid=\"2-1-2\"><span data-kid=\"2-1-2-1\">Outline → primary</span><span data-kid=\"2-1-2-2\" data-name=\"header fact about fill spreading from pocket\">Circle fill from the pocket</span><span data-kid=\"2-1-2-3\" data-name=\"header fact noting no off-state tick\">No tick when off</span><span data-kid=\"2-1-2-4\" data-name=\"header fact noting chip reuse across lists\">Same chip, both lists</span></p>\n</header>\n<div class=\"stack\" data-kid=\"2-2\">\n<section class=\"block\" data-kid=\"2-2-1\">\n<h2 data-kid=\"2-2-1-1\">In the form</h2>\n<div class=\"duo\" data-kid=\"2-2-1-2\">\n<fieldset class=\"card\" data-kid=\"2-2-1-2-1\">\n<legend class=\"sr-only\" data-kid=\"2-2-1-2-1-1\">Allergies</legend>\n<div class=\"field__head\" data-kid=\"2-2-1-2-1-2\">\n<span class=\"field__label\" data-kid=\"2-2-1-2-1-2-1\">Allergies</span>\n<span class=\"field__hint\" data-kid=\"2-2-1-2-1-2-2\">Tap to select. These are hard limits.</span>\n</div>\n<div class=\"group\" data-kid=\"2-2-1-2-1-3\">\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-1\"><input checked=\"\" data-kid=\"2-2-1-2-1-3-1-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-1-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-1-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-1-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-1-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-1-3\">sesame</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-1-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-1-4-1\">sesame</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-2\"><input checked=\"\" data-kid=\"2-2-1-2-1-3-2-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-2-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-2-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-2-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-2-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-2-3\">peanut</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-2-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-2-4-1\">peanut</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-3\"><input data-kid=\"2-2-1-2-1-3-3-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-3-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-3-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-3-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-3-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-3-3\">milk</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-3-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-3-4-1\">milk</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-4\"><input data-kid=\"2-2-1-2-1-3-4-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-4-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-4-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-4-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-4-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-4-3\">egg</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-4-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-4-4-1\">egg</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-5\"><input data-kid=\"2-2-1-2-1-3-5-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-5-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-5-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-5-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-5-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-5-3\">tree nuts</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-5-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-5-4-1\">tree nuts</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-6\"><input data-kid=\"2-2-1-2-1-3-6-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-6-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-6-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-6-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-6-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-6-3\">soy</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-6-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-6-4-1\">soy</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-7\"><input data-kid=\"2-2-1-2-1-3-7-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-7-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-7-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-7-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-7-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-7-3\">wheat</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-7-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-7-4-1\">wheat</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-8\"><input data-kid=\"2-2-1-2-1-3-8-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-8-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-8-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-8-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-8-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-8-3\">shellfish</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-8-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-8-4-1\">shellfish</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-9\"><input data-kid=\"2-2-1-2-1-3-9-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-9-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-9-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-9-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-9-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-9-3\">fish</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-1-3-9-4\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-1-3-9-4-1\">fish</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-1-3-10\"><input data-kid=\"2-2-1-2-1-3-10-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-1-3-10-2\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-1-3-10-2-1\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-1-3-10-2-2\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-1-3-10-2-3\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-1-3-10-3\">sulphites</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-