>\n<symbol id=\"b-paleo\" viewbox=\"0 0 24 24\">\n<path d=\"M11.2 12.6 6.4 17.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<circle cx=\"5.4\" cy=\"18.4\" fill=\"currentColor\" r=\"1.7\"></circle>\n<circle cx=\"7.9\" cy=\"20.9\" fill=\"currentColor\" r=\"1.3\"></circle></symbol>\n<symbol id=\"p-paleo\" viewbox=\"0 0 24 24\"><path d=\"M15 3.8a5.4 5.4 0 1 1 0 10.8 5.4 5.4 0 0 1 0-10.8z\" fill=\"var(--food)\" stroke=\"currentColor\" stroke-width=\"var(--sw)\"></path></symbol>\n</defs></svg>\n<header class=\"bar\" data-kid=\"2\"><div class=\"frame bar__in\" data-kid=\"2-1\">\n<a class=\"lockup\" data-kid=\"2-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"2-1-1-1\" height=\"26\" viewbox=\"0 0 32 32\" width=\"26\"><g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g><circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle><g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g></svg>\n<span class=\"wordmark\" data-kid=\"2-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"2-1-2\"><span data-kid=\"2-1-2-1\">Pantry</span><span data-kid=\"2-1-2-2\">Saved</span><span data-kid=\"2-1-2-3\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"3\"><div class=\"frame steps__in\" data-kid=\"3-1\">\n<a class=\"step step--done\" data-kid=\"3-1-1\" href=\"#\"><span class=\"step__n\" data-kid=\"3-1-1-1\">1</span>Devices</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"3-1-2\" href=\"#\"><span class=\"step__n\" data-kid=\"3-1-2-1\">2</span>Diet</a>\n<a class=\"step\" data-kid=\"3-1-3\" href=\"#\"><span class=\"step__n\" data-kid=\"3-1-3-1\">3</span>Staples</a>\n<a class=\"step\" data-kid=\"3-1-4\" href=\"#\"><span class=\"step__n\" data-kid=\"3-1-4-1\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"4\">\n<header data-kid=\"4-1\"><div class=\"shelf__label\" data-kid=\"4-1-1\">\n<h1 class=\"shelf__h\" data-kid=\"4-1-1-1\">Diet</h1>\n<p class=\"caps\" data-kid=\"4-1-1-2\">Required before the first cook</p>\n</div></header>\n<div class=\"sheet\" data-kid=\"4-2\">\n<div class=\"sheet__head\" data-kid=\"4-2-1\">\n<p class=\"caps\" data-kid=\"4-2-1-1\">Setting</p>\n<p class=\"caps\" data-kid=\"4-2-1-2\">What it does</p>\n</div>\n<div class=\"pair\" data-kid=\"4-2-2\">\n<label class=\"field__label\" data-kid=\"4-2-2-1\" for=\"d4-name\">Diet name</label>\n<span class=\"ob ob--req\" data-kid=\"4-2-2-2\">Required</span>\n<div class=\"note\" data-kid=\"4-2-2-3\">\n<p class=\"note__p\" data-kid=\"4-2-2-3-1\">Saved as the name of this Diet. <b data-kid=\"4-2-2-3-1-1\">The Pantry shows which one is in use.</b></p>\n</div>\n<input class=\"input input--short\" data-kid=\"4-2-2-4\" id=\"d4-name\" type=\"text\" value=\"Home\"/>\n</div>\n<div aria-labelledby=\"d4-req\" class=\"pair\" data-kid=\"4-2-3\" role=\"group\">\n<p class=\"field__label\" data-kid=\"4-2-3-1\" id=\"d4-req\">Dietary requirements</p>\n<span class=\"ob\" data-kid=\"4-2-3-2\">Hard limit</span>\n<div class=\"note\" data-kid=\"4-2-3-3\">\n<p class=\"note__p\" data-kid=\"4-2-3-3-1\"><b data-kid=\"4-2-3-3-1-1\">A Recipe that breaks one is not offered.</b> The dish stays as it is; the conflicting ingredient is swapped.</p>\n<figure class=\"swap\" data-kid=\"4-2-3-3-2\">\n<span data-kid=\"4-2-3-3-2-1\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"4-2-3-3-2-2\">→</span><span data-kid=\"4-2-3-3-2-3\">firm tofu</span>\n<figcaption class=\"swap__why\" data-kid=\"4-2-3-3-2-4\">breaks vegan</figcaption>\n</figure>\n</div>\n<div class=\"bank\" data-kid=\"4-2-3-4\" data-name=\"dietary requirements tile bank (responsive grid)\">\n<input checked=\"\" class=\"in\" data-kid=\"4-2-3-4-1\" id=\"d4-vegan\" type=\"checkbox\"/>\n<label class=\"tile m-vegan\" data-kid=\"4-2-3-4-2\" for=\"d4-vegan\">\n<span class=\"ic\" data-kid=\"4-2-3-4-2-1\"><svg aria-hidden=\"true\" class=\"lay body\" data-kid=\"4-2-3-4-2-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-vegan\"></use></svg><svg aria-hidden=\"true\" class=\"lay part drift-sway\" data-kid=\"4-2-3-4-2-1-2\" viewbox=\"0 0 24 24\"><use href=\"#p-vegan\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"4-2-3-4-2-2\">Vegan</span>\n<svg aria-hidden=\"true\" class=\"tick\" data-kid=\"4-2-3-4-2-3\" data-name=\"vegan tile checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg>\n</label>\n<input checked=\"\" class=\"in\" data-kid=\"4-2-3-4-3\" id=\"d4-vegetarian\" type=\"checkbox\"/>\n<label class=\"tile m-vegetarian\" data-kid=\"4-2-3-4-4\" for=\"d4-vegetarian\">\n<span class=\"ic\" data-kid=\"4-2-3-4-4-1\"><svg aria-hidden=\"true\" class=\"lay body\" data-kid=\"4-2-3-4-4-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-vegetarian\"></use></svg><svg aria-hidden=\"true\" class=\"lay part\" data-kid=\"4-2-3-4-4-1-2\" viewbox=\"0 0 24 24\"><use href=\"#p-vegetarian\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"4-2-3-4-4-2\">Vegetarian</span>\n<svg aria-hidden=\"true\" class=\"tick\" data-kid=\"4-2-3-4-4-3\" data-name=\"vegetarian tile checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg>\n</label>\n<input class=\"in\" data-kid=\"4-2-3-4-5\" id=\"d4-pescatarian\" type=\"checkbox\"/>\n<label class=\"tile m-pescatarian\" data-kid=\"4-2-3-4-6\" for=\"d4-pescatarian\">\n<span class=\"ic\" data-kid=\"4-2-3-4-6-1\"><svg aria-hidden=\"true\" class=\"lay part drift-swim\" data-kid=\"4-2-3-4-6-1-1\" viewbox=\"0 0 24 24\"><use href=\"#p-pescatarian\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"4-2-3-4-6-2\">Pescatarian</span>\n<svg aria-hidden=\"true\" class=\"tick\" data-ki