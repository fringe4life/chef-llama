      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ margin: 0; padding: 0; border: 0; min-inline-size: 0; }\nbutton{ font: inherit; color: inherit; }\n.sr-only{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n.sheet{ padding-block: var(--space-7) var(--space-10); }\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: 1px solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.block{ display: grid; gap: var(--space-4); margin-block-start: var(--space-8); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.screen{ display: grid; overflow: hidden; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-lg); }\n.bar{ border-block-end: 1px solid var(--border); }\n.bar__in{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 58px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); color: inherit; text-decoration: none; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: flex; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.steps{ border-block-end: 1px solid var(--border); }\n.steps__in{ display: flex; align-items: stretch; gap: var(--space-5); }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 42px; font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none; border-block-end: 2px solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-size: var(--text-2xs); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--primary-text); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n.page{ display: grid; gap: var(--space-6); padding-block: var(--space-5) var(--space-6); }\n.shelf{ display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); }\n.shelf__label{ display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.shelf__facts{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.field{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.lb{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.req{ display: inline-block; inline-size: 6px; block-size: 6px; background: var(--primary-text); border-radius: 1px; }\n.input{ inline-size: 100%; min-block-size: 38px; padding: 0 var(--space-3); border: 1px solid var(--input); border-radius: var(--radius-sm); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); }\n.flags{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }\n.flag{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; font-size: var(--text-sm); }\n.flag input{ inline-size: 16px; block-size: 16px; margin: 0; accent-color: var(--primary-text); }\n\n.head2{ display: grid; gap: var(--space-6); align-items: start; }\n@media (width >= 56rem){ .head2{ grid-template-columns: minmax(0,1fr) 380px; column-gap: var(--space-8); } }\n.colL{ display: grid; gap: var(--space-6); align-content: start; }\n\n/* amounts ledger */\n.led{ display: grid; gap: var(--space-5); padding: var(--space-4) var(--space-5) var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); }\n.led__h{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.row{ --p: 0%; display: grid; gap: var(--space-2); }\n.row__top{ display: flex; align-items: center; gap: var(--space-3); }\n.row__top .caps{ margin-inline-end: auto; }\n.winnum{ display: inline-flex; align-items: center; min-block-size: 22px; padding-inline: var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); font-family: var(--font-mono); font-size: var(--text-base); font-weight: 700; font-variant-numeric: tabular-nums; line-height: var(--leading-solid); }\n.row .fig--off{ display: none; }\n\n/* any toggle */\n.any{ display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); cursor: pointer; }\n.any input{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n.any__box{ position: relative; display: grid; place-items: center; inline-size: 13px; block-size: 13px; border: 1px solid color-mix(in oklab, var(--input) 66%, var(--foreground)); border-radius: 2px; background: var(--background); box-shadow: inset 0 1px 2px color-mix(in oklab, var(--foreground) 9%, transparent); }\n.any input:checked + .any__box{ background: var(--primary); border-color: var(--primary); }\n.any input:checked + .any__box::after{ content: \"\"; inline-size: 6px; block-size: 3px; border-inline-start: 2px solid var(--primary-foreground); border-block-end: 2px solid var(--primary-foreground); transform: translateY(-1px) rotate(-45deg); }\n.any:has(input:checked){ color: var(--foreground); }\n.any input:focus-visible + .any__box{ outline: 2px solid var(--ring); outline-offset: 2px; }\n\n/* the printed strip */\n.strip{ position: relative; block-size: 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); }\n.zone{ position: absolute; inset-block: 0; pointer-events: none; }\n.zone--l{ inset-inline: 0 66.6667%; border-start-start-radius: var(--radius-sm); border-end-start-radius: var(--radius-sm); background: color-mix(in oklab, var(--primary) 9%, var(--card)); }\n.zone--s{ inset-inline: 33.3333% 38.8889%; background: color-mix(in oklab, var(--primary) 21%, var(--card)); }\n.zone--h{ inset-inline: 61.1111% 0; border-start-end-radius: var(--radius-sm); border-end-end-radius: var(--radius-sm); background: color-mix(in oklab, var(--accent) 16%, var(--card)); }\n.fill{ position: absolute; inset-block: 0; inset-inline-start: 0; inline-size: 100%; border-start-start-radius: var(--radius-sm); border-end-start-radius: var(--radius-sm); background: color-mix(in oklab, var(--primary) 52%, var(--card));\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 5px), transparent calc(var(--p) + 5px));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 5px), transparent calc(var(--p) + 5px)); }\n.b{ position: absolute; inset-block: 0; inline-size: 0; border-inline-start: 1px dashed color-mix(in oklab, var(--border) 40%, var(--foreground)); pointer-events: none; }\n.b1{ inset-inline-start: 33.3333%; }\n.b2{ inset-inline-start: 61.1111%; }\n.notes{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.notes [data-band]{ padding-inline: 2px; }\n.notes [data-band].is-on{ color: var(--primary-text); font-weight: 700; }\n.notes--ends{ justify-content: space-between; }\n\n/* needle on the native range */\n.rng{ position: absolute; inset-block: -10px; inset-inline: -1px; inline-size: calc(100% + 2px); block-size: 34px; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: grab; z-index: 4; }\n.rng:active{ cursor: grabbing; }\n.rng::-webkit-slider-runnable-track{ block-size: 34px; background: transparent; border: 0; }\n.rng::-webkit-slider-thumb{ -webkit-appearance: none; inline-size: 2px; block-size: 30px; margin-block-start: 2px; border: 0; border-radius: 0; background: var(--foreground); box-shadow: 2px 0 0 color-mix(in oklab, var(--foreground) 20%, transparent); }\n.rng::-moz-range-track{ block-size: 34px; background: transparent; border: 0; }\n.rng::-moz-range-thumb{ inline-size: 2px; block-size: 30px; border: 0; border-radius: 0; background: var(--foreground); box-shadow: 2px 0 0 color-mix(in oklab, var(--foreground) 20%, transparent); }\n.strip:has(.rng:focus-visible){ outline: 2px solid var(--ring); outline-offset: 3px; }\n\n.led__total{ display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); padding-block-start: var(--space-4); border-block-start: 1px solid var(--border); }\n.led__total .num{ font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; font-variant-numeric: tabular-nums; line-height: var(--leading-solid); }\n\n.row.is-off .fill,\n.row.is-off .zone,\n.row.is-off .b,\n.row.is-off .rng{ opacity: 0; }\n.row.is-off .rng{ pointer-events: none; }\n.row.is-off .strip{ border-style: dashed; background: transparent; }\n.row.is-off .fig--on{ display: none; }\n.row.is-off .fig--off{ display: inline; }\n.row.is-off .notes [data-band].is-on{ color: var(--muted-foreground); font-weight: 400; }\n.row.is-off .notes{ opacity: 0.7; }\n\n.foot{ display: flex; align-items: center; justify-content: flex-end; gap: var(--space-3); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-5); border-radius: var(--radius); border: 1px solid var(--border); background: transparent; font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; }\n.btn--quiet{ border-color: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n\n.spec{ padding-block: var(--space-5); border-block: 1px solid var(--border); max-inline-size: 420px; }\n</style>\n<div class=\"frame sheet\" data-kid=\"1\">\n<header class=\"head\" data-kid=\"1-1\">\n<h1 data-kid=\"1-1-1\">T2 — Amounts ledger</h1>\n<p class=\"facts\" data-kid=\"1-1-2\"><span data-kid=\"1-1-2-1\">Equal-length rails</span><span data-kid=\"1-1-2-2\">Zones printed on the strip</span><span data-kid=\"1-1-2-3\" data-name=\"header fact: One block two rails\">One block, two rails</span><span data-kid=\"1-1-2-4\">Total is derived</span></p>\n</header>\n<section class=\"block\" data-kid=\"1-2\">\n<h2 data-kid=\"1-2-1\">In the Diet step</h2>\n<div class=\"screen\" data-kid=\"1-2-2\">\n<header class=\"bar\" data-kid=\"1-2-2-1\"><div class=\"frame bar__in\" data-kid=\"1-2-2-1-1\">\n<a class=\"lockup\" data-kid=\"1-2-2-1-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-2-2-1-1-1-1\" height=\"26\" viewbox=\"0 0 32 32\" width=\"26\"><g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g><circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle><g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g></svg>\n<span class=\"wordmark\" data-kid=\"1-2-2-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-2-2-1-1-2\"><span data-kid=\"1-2-2-1-1-2-1\">Pantry</span><span data-kid=\"1-2-2-1-1-2-2\">Saved</span><span data-kid=\"1-2-2-1-1-2-3\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"1-2-2-2\"><div class=\"frame steps__in\" data-kid=\"1-2-2-2-1\">\n<a class=\"step step--done\" data-kid=\"1-2-2-2-1-1\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-1-1\">1</span>Devices</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"1-2-2-2-1-2\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-2-1\">2</span>Diet</a>\n<a class=\"step\" data-kid=\"1-2-2-2-1-3\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-3-1\">3</span>Staples</a>\n<a class=\"step\" data-kid=\"1-2-2-2-1-4\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-4-1\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"1-2-2-3\">\n<header class=\"shelf\" data-kid=\"1-2-2-3-1\"><div class=\"shelf__label\" data-kid=\"1-2-2-3-1-1\">\n<h2 class=\"shelf__h\" data-kid=\"1-2-2-3-1-1-1\">Diet</h2>\n<p class=\"shelf__facts\" data-kid=\"1-2-2-3-1-1-2\">First cook</p>\n</div></header>\n<div class=\"head2\" data-kid=\"1-2-2-3-2\">\n<div class=\"colL\" data-kid=\"1-2-2-3-2-1\">\n<div class=\"field\" data-kid=\"1-2-2-3-2-1-1\">\n<label class=\"lb\" data-kid=\"1-2-2-3-2-1-1-1\" for=\"t2-name\">Diet name <span class=\"req\" data-kid=\"1-2-2-3-2-1-1-1-1\"></span></label>\n<input class=\"input\" data-kid=\"1-2-2-3-2-1-1-2\" id=\"t2-name\" type=\"text\" value=\"Home\"/>\n</div>\n<fieldset class=\"field\" data-kid=\"1-2-2-3-2-1-2\">\n<legend class=\"lb\" data-kid=\"1-2-2-3-2-1-2-1\">Flags</legend>\n<div class=\"flags\" data-kid=\"1-2-2-3-2-1-2-2\">\n<label class=\"flag\" data-kid=\"1-2-2-3-2-1-2-2-1\"><input data-kid=\"1-2-2-3-2-1-2-2-1-1\" type=\"checkbox\"/>vegan</label>\n<label class=\"flag\" data-kid=\"1-2-2-3-2-1-2-2-2\"><input checked=\"\" data-kid=\"1-2-2-3-2-1-2-2-2-1\" type=\"checkbox\"/>vegetarian</label>\n<label class=\"flag\" data-kid=\"1-2-2-3-2-1-2-2-3\"><input data-kid=\"1-2-2-3-2-1-2-2-3-1\" type=\"checkbox\"/>gluten free</label>\n</div>\n</fieldset>\n</div>\n<section aria-label=\"Amounts\" class=\"led\" data-kid=\"1-2-2-3-2-2\">\n<p class=\"led__h\" data-kid=\"1-2-2-3-2-2-1\">Amounts</p>\n<div class=\"row row--kcal\" data-ctl=\"\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"kcal per serving row\" style=\"--p:44.4444%\">\n<div class=\"row__top\" data-kid=\"1-2-2-3-2-2-2-1\">\n<span class=\"caps\" data-kid=\"1-2-2-3-2-2-2-1-1\">kcal per serving</span>\n<span class=\"winnum\" data-kid=\"1-2-2-3-2-2-2-1-2\" data-name=\"kcal numeric value window\"><output data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2-1-2-1\" data-name=\"kcal active value output\" data-reason=\"textContent replaced by t2 script on slider input\">700</output></span>\n</div>\n<div class=\"strip\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"kcal strip container\" data-reason=\"--p CSS custom property rewritten by t2 from slider value\">\n<span class=\"fill\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2-2-1\" data-name=\"kcal strip fill overlay\" data-reason=\"mask driven by --p that t2 rewrites from slider\"></span>\n<span class=\"zone zone--l\" data-kid=\"1-2-2-3-2-2-2-2-2\"></span>\n<span class=\"zone zone--s\" data-kid=\"1-2-2-3-2-2-2-2-3\"></span>\n<span class=\"zone zone--h\" data-kid=\"1-2-2-3-2-2-2-2-4\"></span>\n<span class=\"b b1\" data-kid=\"1-2-2-3-2-2-2-2-5\"></span>\n<span class=\"b b2\" data-kid=\"1-2-2-3-2-2-2-2-6\"></span>\n<input aria-label=\"kcal per serving\" class=\"rng\" data-kid=\"1-2-2-3-2-2-2-2-7\" id=\"t2-kcal\" max=\"1200\" min=\"300\" oninput=\"t2(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div class=\"notes\" data-kid=\"1-2-2-3-2-2-2-3\">\n<span data-band=\"light\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2-3-1\" data-name=\"kcal band note: Light\" data-reason=\"is-on class toggled by t2 based on slider value\">Light</span>\n<span class=\"is-on\" data-band=\"standard\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2-3-2\" data-name=\"kcal band note: Standard\" data-reason=\"is-on class toggled by t2 based on slider value\">Standard</span>\n<span data-band=\"hearty\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2-3-3\" data-name=\"kcal band note: Hearty\" data-reason=\"is-on class toggled by t2 based on slider value\">Hearty</span>\n</div>\n</div>\n<div class=\"row row--serv\" data-ctl=\"\" data-kid=\"1-2-2-3-2-2-3\" style=\"--p:45.4545%\">\n<div class=\"row__top\" data-kid=\"1-2-2-3-2-2-3-1\">\n<span class=\"caps\" data-kid=\"1-2-2-3-2-2-3-1-1\">Servings</span>\n<span class=\"winnum\" data-kid=\"1-2-2-3-2-2-3-1-2\"><output data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-3-1-2-1\" data-name=\"servings value output\" data-reason=\"textContent replaced by t2 script on slider input\">6</output></span>\n</div>\n<div class=\"strip\" data-kid=\"1-2-2-3-2-2-3-2\">\n<span class=\"fill\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-3-2-1\" data-name=\"servings strip fill overlay\" data-reason=\"mask driven by --p recomputed by t2 from slider\"></span>\n<input aria-label=\"Servings\" class=\"rng\" data-kid=\"1-2-2-3-2-2-3-2-2\" id=\"t2-srv\" max=\"12\" min=\"1\" oninput=\"t2(this)\" step=\"1\" type=\"range\" value=\"6\"/>\n</div>\n<div class=\"notes notes--ends\" data-kid=\"1-2-2-3-2-2-3-3\">\n<span data-kid=\"1-2-2-3-2-2-3-3-1\">1</span>\n<span data-kid=\"1-2-2-3-2-2-3-3-2\">12</span>\n</div>\n</div>\n<p class=\"led__total\" data-kid=\"1-2-2-3-2-2-4\" data-name=\"amounts total row\"><span class=\"caps\" data-kid=\"1-2-2-3-2-2-4-1\">Total</span><span class=\"num\" data-kid=\"1-2-2-3-2-2-4-2\"><output data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-4-2-1\" data-name=\"amounts total numeric output\" data-reason=\"textContent computed from kcal times servings by t2\" id=\"t2-total\">4,200</output> <span class=\"caps\" data-kid=\"1-2-2-3-2-2-4-2-2\">kcal</span></span></p>\n</section>\n</div>\n<div class=\"foot\" data-kid=\"1-2-2-3-3\">\n<button class=\"btn btn--quiet\" data-kid=\"1-2-2-3-3-1\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"1-2-2-3-3-2\" type=\"button\">Continue</button>\n</div>\n</main>\n</div>\n</section>\n<section class=\"block\" data-kid=\"1-3\">\n<h2 data-kid=\"1-3-1\" data-name=\"amounts at a glance heading\">Amounts at a glance</h2>\n<div class=\"spec\" data-kid=\"1-3-2\">\n<section aria-label=\"Amounts\" class=\"led\" data-kid=\"1-3-2-1\">\n<p class=\"led__h\" data-kid=\"1-3-2-1-1\">Amounts</p>\n<div class=\"row row--kcal\" data-ctl=\"\" data-kid=\"1-3-2-1-2\" data-name=\"kcal per serving row\" style=\"--p:44.4444%\">\n<div class=\"row__top\" data-kid=\"1-3-2-1-2-1\">\n<span class=\"caps\" data-kid=\"1-3-2-1-2-1-1\">kcal per serving</span>\n<span class=\"winnum\" data-kid=\"1-3-2-1-2-1-2\"><output data-kid=\"1-3-2-1-2-1-2-1\">700</output></span>\n</div>\n<div class=\"strip\" data-kid=\"1-3-2-1-2-2\">\n<span class=\"fill\" data-kid=\"1-3-2-1-2-2-1\"></span>\n<span class=\"zone zone--l\" data-kid=\"1-3-2-1-2-2-2\"></span>\n<span class=\"zone zone--s\" data-kid=\"1-3-2-1-2-2-3\"></span>\n<span class=\"zone zone--h\" data-kid=\"1-3-2-1-2-2-4\"></span>\n<span class=\"b b1\" data-kid=\"1-3-2-1-2-2-5\"></span>\n<span class=\"b b2\" data-kid=\"1-3-2-1-2-2-6\"></span>\n</div>\n<div class=\"notes\" data-kid=\"1-3-2-1-2-3\">\n<span data-band=\"light\" data-kid=\"1-3-2-1-2-3-1\">Light</span>\n<span class=\"is-on\" data-band=\"standard\" data-kid=\"1-3-2-1-2-3-2\">Standard</span>\n<span data-band=\"hearty\" data-kid=\"1-3-2-1-2-3-3\">Hearty</span>\n</div>\n</div>\n<div class=\"row row--serv\" data-ctl=\"\" data-kid=\"1-3-2-1-3\" style=\"--p:27.2727%\">\n<div class=\"row__top\" data-kid=\"1-3-2-1-3-1\">\n<span class=\"caps\" data-kid=\"1-3-2-1-3-1-1\">Servings</span>\n<span class=\"winnum\" data-kid=\"1-3-2-1-3-1-2\"><output data-kid=\"1-3-2-1-3-1-2-1\">4</output></span>\n</div>\n<div class=\"strip\" data-kid=\"1-3-2-1-3-2\">\n<span class=\"fill\" data-kid=\"1-3-2-1-3-2-1\"></span>\n</div>\n<div class=\"notes notes--ends\" data-kid=\"1-3-2-1-3-3\"><span data-kid=\"1-3-2-1-3-3-1\">1</span><span data-kid=\"1-3-2-1-3-3-2\">12</span></div>\n</div>\n<p class=\"led__total\" data-kid=\"1-3-2-1-4\" data-name=\"amounts total row\"><span class=\"caps\" data-kid=\"1-3-2-1-4-1\">Total</span><span class=\"num\" data-kid=\"1-3-2-1-4-2\"><output data-kid=\"1-3-2-1-4-2-1\" data-name=\"amounts total value output\">2,800</output> <span class=\"caps\" data-kid=\"1-3-2-1-4-2-2\">kcal</span></span></p>\n</section>\n</div>\n</section>\n</div>\n<script>\nfunction t2(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n  if (c.dataset.band !== undefined || c.classList.contains('row--kcal')){\n    var b = v < 500 ? 'light' : (v <= 700 ? 'standard' : 'hearty');\n    c.querySelectorAll('[data-band]').forEach(function(s){ s.classList.toggle('is-on', s.dataset.band === b); });\n  }\n  var srv = document.querySelector('#t2-srv'), kcal = document.querySelector('#t2-kcal'), tot = document.querySelector('#t2-total');\n  if (srv && kcal && tot) tot.textContent = (+srv.value * +kcal.value).toLocaleString('en-NZ');\n}\nfunction t2any(el){\n  el.closest('.row').classList.toggle('is-off', el.checked);\n  var tot = document.querySelector('#t2-total');\n  if (tot) tot.closest('.led__total').style.display = el.checked ? 'none' : 'flex';\n}\n</script>",
      "comments": [],
      "created": "2026-11-23T05:19:26.282922+00:00",
      "modified": "2026-11-23T11:31:28.947658+00:00",
      "id": "var_b52bca51a9b7",
      "contentHeight": 1185
    },
    "var_2fb190a7eaaf": {
      "type": "variant",
      "label": "T3 — Instrument row, keyline troughs with a lifted ladder",
      "parentId": "var_d46090fb3409",
      "themeId": null,
      "rect": {
        "x": 18519,
        "y": 0,
        "w": 1160,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nbutton{ font: inherit; color: inherit; }\n.sr-only{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n.sheet{ padding-block: var(--space-7) var(--space-10); }\n.head{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); border-block-end: 1px solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.block{ display: grid; gap: var(--space-4); margin-block-start: var(--space-8); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.screen{ display: grid; overflow: hidden; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-lg); }\n.bar{ border-block-end: 1px solid var(--border); }\n.bar__in{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 58px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); color: inherit; text-decoration: none; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: flex; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.steps{ border-block-end: 1px solid var(--border); }\n.steps__in{ display: flex; align-items: stretch; gap: var(--space-5); }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 42px; font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none; border-block-end: 2px solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-size: var(--text-2xs); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--primary-text); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n.page{ display: grid; gap: var(--space-5); padding-block: var(--space-5) var(--space-6); }\n.shelf{ display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); }\n.shelf__label{ display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.shelf__facts{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.field{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.lb{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.req{ display: inline-block; inline-size: 6px; block-size: 6px; background: var(--primary-text); border-radius: 1px; }\n.input{ inline-size: 100%; min-block-size: 38px; padding: 0 var(--space-3); border: 1px solid var(--input); border-radius: var(--radius-sm); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); }\n\n/* instrument row */\n.head3{ display: grid; gap: var(--space-5); align-items: end; margin-block-start: var(--space-1); padding-block: var(--space-5); border-block: 1px solid var(--border); }\n@media (width >= 44rem){ .head3{ grid-template-columns: minmax(0,1fr) 132px 168px; column-gap: var(--space-6); } }\n.head3--pair{ grid-template-columns: 132px 168px; justify-content: start; column-gap: var(--space-6); border-block: 0; padding-block: 0; }\n\n.cell{ --p: 0%; position: relative; display: grid; gap: var(--space-2); min-inline-size: 0; }\n.cell__top{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-block-size: 20px; }\n.plate{ display: inline-flex; align-items: center; min-block-size: 20px; padding-inline: var(--space-2); border: 1px solid var(--border); border-radius: 999px; background: var(--card); box-shadow: inset 0 2px 3px color-mix(in oklab, var(--foreground) 13%, transparent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; font-variant-numeric: tabular-nums; line-height: var(--leading-solid); }\n\n.trough{ position: relative; block-size: 24px; border-radius: 999px; background: color-mix(in oklab, var(--foreground) 86%, var(--background)); box-shadow: inset 0 1px 0 color-mix(in oklab, var(--background) 26%, transparent); }\n.trough__scale{ position: absolute; inset-inline: 9px; inset-block: 0; }\n.notch{ position: absolute; inset-inline-start: calc(var(--at) * 1%); inset-block-end: 4px; inline-size: 1px; block-size: 4px; background: color-mix(in oklab, var(--background) 78%, var(--foreground)); transform: translateX(-0.5px); }\n\n.rng{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: grab; z-index: 3; }\n.rng:active{ cursor: grabbing; }\n.rng::-webkit-slider-runnable-track{ block-size: 24px; background: transparent; border: 0; }\n.rng::-webkit-slider-thumb{ -webkit-appearance: none; inline-size: 18px; block-size: 22px; margin-block-start: 1px; border: 0; border-radius: 999px; background: var(--primary); box-shadow: inset 0 1px 0 color-mix(in oklab, var(--background) 62%, transparent), 0 1px 2px color-mix(in oklab, var(--foreground) 32%, transparent); }\n.rng::-moz-range-track{ block-size: 24px; background: transparent; border: 0; }\n.rng::-moz-range-thumb{ inline-size: 18px; block-size: 22px; border: 0; border-radius: 999px; background: var(--primary); box-shadow: inset 0 1px 0 color-mix(in oklab, var(--background) 62%, transparent), 0 1px 2px color-mix(in oklab, var(--foreground) 32%, transparent); }\n.trough:has(.rng:focus-visible){ outline: 2px solid var(--ring); outline-offset: 3px; }\n\n/* lifted ladder */\n.ladder{ position: absolute; inset-block-end: calc(100% + var(--space-3)); inset-inline-end: calc(var(--space-3) * -1); inline-size: 300px; display: none; padding: var(--space-4) var(--space-5) var(--space-5); background: var(--card); border: 1px solid var(--border); border-radius: 2px; box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); z-index: 6; }\n.cell--open .ladder, .cell:focus-within .ladder{ display: block; }\n.ladder__nums{ position: relative; block-size: 14px; margin-block-end: var(--space-2); }\n.ladder__nums span{ position: absolute; inset-inline-start: calc(var(--at) * 1%); transform: translateX(-50%); font-family: var(--font-mono); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n.ladder__rail{ position: relative; block-size: 6px; border: 1px solid var(--border); border-radius: 2px; background: color-mix(in oklab, var(--border) 55%, var(--card)); }\n.lg-grads{ position: absolute; inset: 0;\n  background-image: repeating-linear-gradient(to right, var(--tk-major) 0 1px, transparent 1px 10%), repeating-linear-gradient(to right, var(--tk-minor) 0 1px, transparent 1px 2.5%);\n  background-size: 100% 6px, 100% 3px; background-position: left bottom, left bottom; background-repeat: repeat-x;\n  --tk-major: color-mix(in oklab, var(--muted-foreground) 64%, var(--card));\n  --tk-minor: color-mix(in oklab, var(--muted-foreground) 30%, var(--card)); }\n.lg-fill{ position: absolute; inset-block: 0; inset-inline-start: 0; inline-size: 100%; border-radius: 2px; background: var(--primary);\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 6px), transparent calc(var(--p) + 6px));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 6px), transparent calc(var(--p) + 6px)); }\n.ladder__bands{ position: relative; block-size: 22px; margin-block-start: var(--space-3); }\n.bp{ position: absolute; inset-inline-start: calc(var(--at) * 1%); transform: translateX(-50%); display: inline-flex; align-items: center; min-block-size: 20px; padding-inline: var(--space-2); border: 1px solid var(--border); border-radius: 999px; background: var(--card); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); white-space: nowrap; }\n.bp.is-on{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); font-weight: 700; }\n\n.foot{ display: flex; align-items: center; justify-content: flex-end; gap: var(--space-3); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-5); border-radius: var(--radius); border: 1px solid var(--border); background: transparent; font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; }\n.btn--quiet{ border-color: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n\n.specimen{ position: relative; display: grid; padding-block: 150px var(--space-6); padding-inline: var(--space-6); border-block: 1px solid var(--border); }\n</style>\n<div class=\"frame sheet\" data-kid=\"1\">\n<header class=\"head\" data-kid=\"1-1\">\n<h1 data-kid=\"1-1-1\">T3 — Instrument row</h1>\n<p class=\"facts\" data-kid=\"1-1-2\"><span data-kid=\"1-1-2-1\">132 / 168 px</span><span data-kid=\"1-1-2-2\">Three notches at rest</span><span data-kid=\"1-1-2-3\">Ladder on focus</span><span data-kid=\"1-1-2-4\">Saffron plug</span></p>\n</header>\n<section class=\"block\" data-kid=\"1-2\">\n<h2 data-kid=\"1-2-1\">At rest</h2>\n<div class=\"screen\" data-kid=\"1-2-2\">\n<header class=\"bar\" data-kid=\"1-2-2-1\"><div class=\"frame bar__in\" data-kid=\"1-2-2-1-1\">\n<a class=\"lockup\" data-kid=\"1-2-2-1-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-2-2-1-1-1-1\" height=\"26\" viewbox=\"0 0 32 32\" width=\"26\"><g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g><circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle><g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g></svg>\n<span class=\"wordmark\" data-kid=\"1-2-2-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-2-2-1-1-2\"><span data-kid=\"1-2-2-1-1-2-1\">Pantry</span><span data-kid=\"1-2-2-1-1-2-2\">Saved</span><span data-kid=\"1-2-2-1-1-2-3\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"1-2-2-2\"><div class=\"frame steps__in\" data-kid=\"1-2-2-2-1\">\n<a class=\"step step--done\" data-kid=\"1-2-2-2-1-1\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-1-1\">1</span>Devices</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"1-2-2-2-1-2\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-2-1\">2</span>Diet</a>\n<a class=\"step\" data-kid=\"1-2-2-2-1-3\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-3-1\">3</span>Staples</a>\n<a class=\"step\" data-kid=\"1-2-2-2-1-4\" href=\"#\"><span class=\"step__n\" data-kid=\"1-2-2-2-1-4-1\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"1-2-2-3\">\n<header class=\"shelf\" data-kid=\"1-2-2-3-1\"><div class=\"shelf__label\" data-kid=\"1-2-2-3-1-1\">\n<h2 class=\"shelf__h\" data-kid=\"1-2-2-3-1-1-1\">Diet</h2>\n<p class=\"shelf__facts\" data-kid=\"1-2-2-3-1-1-2\">First cook</p>\n</div></header>\n<div class=\"head3\" data-kid=\"1-2-2-3-2\">\n<div class=\"field\" data-kid=\"1-2-2-3-2-1\">\n<label class=\"lb\" data-kid=\"1-2-2-3-2-1-1\" for=\"t3-name\">Diet name <span class=\"req\" data-kid=\"1-2-2-3-2-1-1-1\"></span></label>\n<input class=\"input\" data-kid=\"1-2-2-3-2-1-2\" id=\"t3-name\" type=\"text\" value=\"Home\"/>\n</div>\n<div class=\"cell\" data-ctl=\"\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2\" data-name=\"servings slider cell\" data-reason=\"--p custom property set by t3() script on input\" style=\"--p:36.3636%\">\n<div class=\"cell__top\" data-kid=\"1-2-2-3-2-2-1\"><span class=\"caps\" data-kid=\"1-2-2-3-2-2-1-1\">Servings</span><span class=\"plate\" data-kid=\"1-2-2-3-2-2-1-2\"><output data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-1-2-1\" data-name=\"servings value readout\" data-reason=\"text replaced by t3() on slider input\">5</output></span></div>\n<div class=\"trough\" data-kid=\"1-2-2-3-2-2-2\">\n<div class=\"trough__scale\" data-kid=\"1-2-2-3-2-2-2-1\"><span class=\"notch\" data-kid=\"1-2-2-3-2-2-2-1-1\" style=\"--at:0\"></span><span class=\"notch\" data-kid=\"1-2-2-3-2-2-2-1-2\" style=\"--at:50\"></span><span class=\"notch\" data-kid=\"1-2-2-3-2-2-2-1-3\" style=\"--at:100\"></span></div>\n<input aria-label=\"Servings\" class=\"rng\" data-kid=\"1-2-2-3-2-2-2-2\" max=\"12\" min=\"1\" oninput=\"t3(this)\" step=\"1\" type=\"range\" value=\"5\"/>\n</div>\n</div>\n<div class=\"cell cell--kcal\" data-ctl=\"\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3\" data-name=\"kcal slider cell\" data-reason=\"--p custom property set by t3() script on input\" style=\"--p:44.4444%\">\n<div class=\"cell__top\" data-kid=\"1-2-2-3-2-3-1\"><span class=\"caps\" data-kid=\"1-2-2-3-2-3-1-1\">kcal</span><span class=\"plate\" data-kid=\"1-2-2-3-2-3-1-2\"><output data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-1-2-1\" data-name=\"kcal value readout\" data-reason=\"text replaced by t3() on slider input\">700</output></span></div>\n<div class=\"trough\" data-kid=\"1-2-2-3-2-3-2\">\n<div class=\"trough__scale\" data-kid=\"1-2-2-3-2-3-2-1\"><span class=\"notch\" data-kid=\"1-2-2-3-2-3-2-1-1\" style=\"--at:0\"></span><span class=\"notch\" data-kid=\"1-2-2-3-2-3-2-1-2\" style=\"--at:50\"></span><span class=\"notch\" data-kid=\"1-2-2-3-2-3-2-1-3\" style=\"--at:100\"></span></div>\n<input aria-label=\"kcal per serving\" class=\"rng\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-2-2\" data-name=\"kcal range input\" data-reason=\"input value reinitialized on page load by script\" max=\"1200\" min=\"300\" oninput=\"t3(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div aria-hidden=\"true\" class=\"ladder\" data-kid=\"1-2-2-3-2-3-3\">\n<div class=\"ladder__nums\" data-kid=\"1-2-2-3-2-3-3-1\">\n<span data-kid=\"1-2-2-3-2-3-3-1-1\" data-name=\"ladder label 300\" style=\"--at:0\">300</span><span data-kid=\"1-2-2-3-2-3-3-1-2\" data-name=\"ladder label 500\" style=\"--at:22.2222\">500</span><span data-kid=\"1-2-2-3-2-3-3-1-3\" data-name=\"ladder label 700\" style=\"--at:44.4444\">700</span><span data-kid=\"1-2-2-3-2-3-3-1-4\" data-name=\"ladder label 900\" style=\"--at:66.6667\">900</span><span data-kid=\"1-2-2-3-2-3-3-1-5\" data-name=\"ladder label 1200\" style=\"--at:100\">1200</span>\n</div>\n<div class=\"ladder__rail\" data-kid=\"1-2-2-3-2-3-3-2\"><span class=\"lg-grads\" data-kid=\"1-2-2-3-2-3-3-2-1\"></span><span class=\"lg-fill\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-3-2-2\" data-name=\"ladder fill bar\" data-reason=\"mask width driven by --p set by t3() script\"></span></div>\n<div class=\"ladder__bands\" data-kid=\"1-2-2-3-2-3-3-3\">\n<span class=\"bp\" data-kid=\"1-2-2-3-2-3-3-3-1\" style=\"--at:16.6667\">Light</span>\n<span class=\"bp is-on\" data-kid=\"1-2-2-3-2-3-3-3-2\" data-name='active band label \"Standard\"' style=\"--at:44.4444\">Standard</span>\n<span class=\"bp\" data-kid=\"1-2-2-3-2-3-3-3-3\" style=\"--at:77.7778\">Hearty</span>\n</div>\n</div>\n</div>\n</div>\n<div class=\"foot\" data-kid=\"1-2-2-3-3\">\n<button class=\"btn btn--quiet\" data-kid=\"1-2-2-3-3-1\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"1-2-2-3-3-2\" type=\"button\">Save Diet</button>\n</div>\n</main>\n</div>\n</section>\n<section class=\"block\" data-kid=\"1-3\">\n<h2 data-kid=\"1-3-1\">Ladder open</h2>\n<div class=\"specimen\" data-kid=\"1-3-2\">\n<div class=\"head3 head3--pair\" data-kid=\"1-3-2-1\">\n<div class=\"cell\" data-ctl=\"\" data-kid=\"1-3-2-1-1\" style=\"--p:36.3636%\">\n<div class=\"cell__top\" data-kid=\"1-3-2-1-1-1\"><span class=\"caps\" data-kid=\"1-3-2-1-1-1-1\">Servings</span><span class=\"plate\" data-kid=\"1-3-2-1-1-1-2\"><output data-kid=\"1-3-2-1-1-1-2-1\">5</output></span></div>\n<div class=\"trough\" data-kid=\"1-3-2-1-1-2\">\n<div class=\"trough__scale\" data-kid=\"1-3-2-1-1-2-1\"><span class=\"notch\" data-kid=\"1-3-2-1-1-2-1-1\" style=\"--at:0\"></span><span class=\"notch\" data-kid=\"1-3-2-1-1-2-1-2\" style=\"--at:50\"></span><span class=\"notch\" data-kid=\"1-3-2-1-1-2-1-3\" style=\"--at:100\"></span></div>\n<input aria-label=\"Servings\" class=\"rng\" data-kid=\"1-3-2-1-1-2-2\" max=\"12\" min=\"1\" oninput=\"t3(this)\" step=\"1\" type=\"range\" value=\"5\"/>\n</div>\n</div>\n<div class=\"cell cell--kcal cell--open\" data-ctl=\"\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2\" data-name=\"kcal slider cell (ladder open)\" data-reason=\"--p custom property set by t3() script on input\" style=\"--p:50%\">\n<div class=\"cell__top\" data-kid=\"1-3-2-1-2-1\"><span class=\"caps\" data-kid=\"1-3-2-1-2-1-1\">kcal</span><span class=\"plate\" data-kid=\"1-3-2-1-2-1-2\"><output data-dynamic=\"true\" data-kid=\"1-3-2-1-2-1-2-1\" data-name=\"kcal value readout\" data-reason=\"text replaced by t3() on slider input\">750</output></span></div>\n<div class=\"trough\" data-kid=\"1-3-2-1-2-2\">\n<div class=\"trough__scale\" data-kid=\"1-3-2-1-2-2-1\"><span class=\"notch\" data-kid=\"1-3-2-1-2-2-1-1\" style=\"--at:0\"></span><span class=\"notch\" data-kid=\"1-3-2-1-2-2-1-2\" style=\"--at:50\"></span><span class=\"notch\" data-kid=\"1-3-2-1-2-2-1-3\" style=\"--at:100\"></span></div>\n<input aria-label=\"kcal per serving\" class=\"rng\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"kcal range input\" data-reason=\"input value reinitialized on page load by script\" max=\"1200\" min=\"300\" oninput=\"t3(this)\" step=\"50\" type=\"range\" value=\"750\"/>\n</div>\n<div class=\"ladder\" data-kid=\"1-3-2-1-2-3\">\n<div class=\"ladder__nums\" data-kid=\"1-3-2-1-2-3-1\">\n<span data-kid=\"1-3-2-1-2-3-1-1\" data-name=\"ladder label 300\" style=\"--at:0\">300</span><span data-kid=\"1-3-2-1-2-3-1-2\" data-name=\"ladder label 500\" style=\"--at:22.2222\">500</span><span data-kid=\"1-3-2-1-2-3-1-3\" data-name=\"ladder label 700\" style=\"--at:44.4444\">700</span><span data-kid=\"1-3-2-1-2-3-1-4\" data-name=\"ladder label 900\" style=\"--at:66.6667\">900</span><span data-kid=\"1-3-2-1-2-3-1-5\" data-name=\"ladder label 1200\" style=\"--at:100\">1200</span>\n</div>\n<div class=\"ladder__rail\" data-kid=\"1-3-2-1-2-3-2\"><span class=\"lg-grads\" data-kid=\"1-3-2-1-2-3-2-1\"></span><span class=\"lg-fill\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3-2-2\" data-name=\"ladder fill bar\" data-reason=\"mask width driven by --p set by t3() script\"></span></div>\n<div class=\"ladder__bands\" data-kid=\"1-3-2-1-2-3-3\">\n<span class=\"bp\" data-kid=\"1-3-2-1-2-3-3-1\" style=\"--at:16.6667\">Light</span>\n<span class=\"bp is-on\" data-kid=\"1-3-2-1-2-3-3-2\" data-name='active band label \"Standard\"' style=\"--at:44.4444\">Standard</span>\n<span class=\"bp\" data-kid=\"1-3-2-1-2-3-3-3\" style=\"--at:77.7778\">Hearty</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>\n<script>\nfunction t3(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n}\n</script>",
