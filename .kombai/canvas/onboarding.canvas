-3-2-2-3-1-1-1\" data-name=\"example row fry pan icon base layer\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-1-2-3-2-2-3-1-1-2\" data-name=\"example row fry pan icon movable part layer\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span>\n<span class=\"ex__k\" data-kid=\"2-1-2-3-2-2-3-1-2\" data-name=\"example method name\">Fry pan</span>\n<span class=\"ex__v\" data-kid=\"2-1-2-3-2-2-3-1-3\" data-name=\"example method time\">12 min</span>\n</div>\n<div class=\"ex__row\" data-kid=\"2-1-2-3-2-2-3-2\" data-name=\"example method row\">\n<span class=\"ic ic20\" data-kid=\"2-1-2-3-2-2-3-2-1\" data-name=\"example row slow cooker icon container\"><svg class=\"lay body\" data-kid=\"2-1-2-3-2-2-3-2-1-1\" data-name=\"example row slow cooker icon base layer\" viewbox=\"0 0 24 24\"><use href=\"#b-slow\"></use></svg><svg class=\"lay part\" data-kid=\"2-1-2-3-2-2-3-2-1-2\" data-name=\"example row slow cooker icon movable part layer\" viewbox=\"0 0 24 24\"><use href=\"#p-slow\"></use></svg></span>\n<span class=\"ex__k\" data-kid=\"2-1-2-3-2-2-3-2-2\" data-name=\"example method name\">Slow cooker</span>\n<span class=\"ex__v\" data-kid=\"2-1-2-3-2-2-3-2-3\" data-name=\"example method time\">7 h</span>\n</div>\n<figcaption class=\"ex__note\" data-kid=\"2-1-2-3-2-2-3-3\" data-name=\"example row note\">The same dish, two methods.</figcaption>\n</figure>\n</aside>\n</div>\n<div class=\"actions\" data-kid=\"2-1-2-3-3\" data-name=\"primary action button bar\"><button class=\"btn btn--primary\" data-kid=\"2-1-2-3-3-1\" data-name=\"continue to next step button\" type=\"button\">Continue</button></div>\n</main>\n</div>\n</section>\n<section class=\"flow\" data-kid=\"2-2\" data-name=\"diet step screen\">\n<p class=\"label\" data-dynamic=\"true\" data-kid=\"2-2-1\" data-name=\"step label\" data-reason=\"false\">Step 2 — Diet</p>\n<div class=\"screen\" data-kid=\"2-2-2\" data-name=\"diet screen mock frame\">\n<header class=\"bar\" dat