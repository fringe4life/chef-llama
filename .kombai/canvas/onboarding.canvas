 24\"><use href=\"#p-dairy\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"4-2-3-4-12-2\">Dairy free</span>\n<svg aria-hidden=\"true\" class=\"tick\" data-kid=\"4-2-3-4-12-3\" data-name=\"dairy-free tile checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg>\n</label>\n<input class=\"in\" data-kid=\"4-2-3-4-13\" id=\"d4-keto\" type=\"checkbox\"/>\n<label class=\"tile m-keto\" data-kid=\"4-2-3-4-14\" for=\"d4-keto\">\n<span class=\"ic\" data-kid=\"4-2-3-4-14-1\"><svg aria-hidden=\"true\" class=\"lay part\" data-kid=\"4-2-3-4-14-1-1\" viewbox=\"0 0 24 24\"><use href=\"#p-keto\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"4-2-3-4-14-2\">Keto</span>\n<svg aria-hidden=\"true\" class=\"tick\" data-kid=\"4-2-3-4-14-3\" data-name=\"keto tile checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg>\n</label>\n<input class=\"in\" data-kid=\"4-2-3-4-15\" id=\"d4-paleo\" type=\"checkbox\"/>\n<label class=\"tile m-paleo\" data-kid=\"4-2-3-4-16\" for=\"d4-paleo\">\n<span class=\"ic\" data-kid=\"4-2-3-4-16-1\"><svg aria-hidden=\"true\" class=\"lay body\" data-kid=\"4-2-3-4-16-1-1\" viewbox=\"0 0 24 24\"><use href=\"#b-paleo\"></use></svg><svg aria-hidden=\"true\" class=\"lay part\" data-kid=\"4-2-3-4-16-1-2\" viewbox=\"0 0 24 24\"><use href=\"#p-paleo\"></use></svg></span>\n<span class=\"tile__name\" data-kid=\"4-2-3-4-16-2\">Paleo</span>\n<svg aria-hidden=\"true\" class=\"tick\" data-kid=\"4-2-3-4-16-3\" data-name=\"paleo tile checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg>\n</label>\n</div>\n</div>\n<div aria-labelledby=\"d4-alg\" class=\"pair\" data-kid=\"4-2-4\" role=\"group\">\n<p class=\"field__label\" data-kid=\"4-2-4-1\" id=\"d4-alg\">Allergies <span class=\"caps\" data-kid=\"4-2-4-1-1\">2 / 15</span></p>\n<span class=\"ob\" data-kid=\"4-2-4-2\">Hard limit</span>\n<div class=\"note\" data-kid=\"4-2-4-3\">\n<p class=\"note__p\" data-kid=\"4-2-4-3-1\"><b data-kid=\"4-2-4-3-1-1\">Every ingredi