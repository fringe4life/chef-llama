ata-name=\"basics staples list\">\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-1\" data-name=\"salt staple row (checked)\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-1-2-1-1\" data-name=\"salt checkbox input (checked)\" type=\"checkbox\"/>salt</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-2\" data-name=\"olive oil staple row (checked)\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-1-2-2-1\" data-name=\"olive oil checkbox input (checked)\" type=\"checkbox\"/>olive oil</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-3\" data-name=\"water staple row\"><input data-kid=\"2-2-2-3-2-1-1-2-3-1\" data-name=\"water checkbox input\" type=\"checkbox\"/>water</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-4\" data-name=\"black pepper staple row (checked)\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-1-2-4-1\" data-name=\"black pepper checkbox input (checked)\" type=\"checkbox\"/>black pepper</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-5\" data-name=\"butter staple row\"><input data-kid=\"2-2-2-3-2-1-1-2-5-1\" data-name=\"butter checkbox input\" type=\"checkbox\"/>butter</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-1-2-6\" data-name=\"sugar staple row\"><input data-kid=\"2-2-2-3-2-1-1-2-6-1\" data-name=\"sugar checkbox input\" type=\"checkbox\"/>sugar</label>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-3-2-1-1-3\" data-name=\"your own staples field group\" style=\"margin-block-start: var(--space-3)\">\n<p class=\"lb\" data-kid=\"2-2-2-3-2-1-1-3-1\" data-name=\"Your own group label\">Your own</p>\n<div class=\"mine\" data-kid=\"2-2-2-3-2-1-1-3-2\" data-name=\"custom staples chip list\">\n<span class=\"mine__chip\" data-kid=\"2-2-2-3-2-1-1-3-2-1\" data-name=\"soy sauce custom staple chip\">soy sauce<button aria-label=\"Remove soy sauce\" class=\"chip__x\" data-kid=\"2-2-2-3-2-1-1-3-2-1-1\" data-name=\"remove soy sauce button\" type=\"button\"><svg class=\"x\" data-kid=\"2-2-2-3-2-1-1-3-2-1-1-1\" data-name=\"small X close icon (soy sauce)\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n<span class=\"mine__chip\" data-kid=\"2-2-2-3-2-1-1-3-2-2\" data-name=\"chicken stock custom staple chip\">chicken stock<button aria-label=\"Remove chicken stock\" class=\"chip__x\" data-kid=\"2-2-2-3-2-1-1-3-2-2-1\" data-name=\"remove chicken stock button\" type=\"button\"><svg class=\"x\" data-kid=\"2-2-2-3-2-1-1-3-2-2-1-1\" data-name=\"small X close icon (chicken stock)\" height=\"10\" width=\"10\"><use href=\"#x\"></use></svg></button></span>\n</div>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-3-2-1-1-4\" data-name=\"add staple input field\">\n<label class=\"lb\" data-kid=\"2-2-2-3-2-1-1-4-1\" data-name=\"Add a staple field label\" for=\"b3-add\">Add a staple</label>\n<input class=\"input\" data-kid=\"2-2-2-3-2-1-1-4-2\" data-name=\"add new staple text input\" id=\"b3-add\" placeholder=\"e.g. fish sauce\" type=\"text\"/>\n</div>\n</div>\n<div class=\"grp\" data-kid=\"2-2-2-3-2-1-2\" data-name=\"right spices group\">\n<p class=\"lb\" data-kid=\"2-2-2-3-2-1-2-1\" data-name=\"Spices group label\">Spices</p>\n<div class=\"rack2\" data-kid=\"2-2-2-3-2-1-2-2\" data-name=\"spices two-column rack layout\">\n<div class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-1\" data-name=\"left spices list column\">\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-1-1\" data-name=\"chilli flakes spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-1-1-1\" data-name=\"chilli flakes checkbox input\" type=\"checkbox\"/>chilli flakes</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-1-2\" data-name=\"cumin spice row (checked)\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-2-2-1-2-1\" data-name=\"cumin checkbox input (checked)\" type=\"checkbox\"/>cumin</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-1-3\" data-name=\"paprika spice row (checked)\"><input checked=\"\" data-kid=\"2-2-2-3-2-1-2-2-1-3-1\" data-name=\"paprika checkbox input (checked)\" type=\"checkbox\"/>paprika</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-1-4\" data-name=\"oregano spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-1-4-1\" data-name=\"oregano checkbox input\" type=\"checkbox\"/>oregano</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-1-5\" data-name=\"turmeric spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-1-5-1\" data-name=\"turmeric checkbox input\" type=\"checkbox\"/>turmeric</label>\n</div>\n<div class=\"list\" data-kid=\"2-2-2-3-2-1-2-2-2\" data-name=\"right spices list column\">\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-2-1\" data-name=\"cinnamon spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-2-1-1\" data-name=\"cinnamon checkbox input\" type=\"checkbox\"/>cinnamon</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-2-2\" data-name=\"curry powder spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-2-2-1\" data-name=\"curry powder checkbox input\" type=\"checkbox\"/>curry powder</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-2-3\" data-name=\"garlic powder spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-2-3-1\" data-name=\"garlic powder checkbox input\" type=\"checkbox\"/>garlic powder</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-2-4\" data-name=\"ginger spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-2-4-1\" data-name=\"ginger checkbox input\" type=\"checkbox\"/>ginger</label>\n<label class=\"row\" data-kid=\"2-2-2-3-2-1-2-2-2-5\" data-name=\"coriander spice row\"><input data-kid=\"2-2-2-3-2-1-2-2-2-5-1\" data-name=\"coriander checkbox input\" type=\"checkbox\"/>coriander</label>\n</div>\n</div>\n</div>\n</div>\n<figure class=\"rec\" data-kid=\"2-2-2-3-2-2\" data-name=\"staples consequence example figure\">\n<p class=\"rec__h\" data-kid=\"2-2-2-3-2-2-1\" data-name=\"example caption heading\">Example</p>\n<div class=\"rec--table\" data-kid=\"2-2-2-3-2-2-2\" data-name=\"three-column example layout\">\n<div class=\"grp\" data-kid=\"2-2-2-3-2-2-2-1\" data-name=\"listed staples example column\">\n<p class=\"rec__h\" data-kid=\"2-2-2-3-2-2-2-1-1\" data-name=\"listed column subheading\">Listed</p>\n<p class=\"rec__n\" data-kid=\"2-2-2-3-2-2-2-1-2\" data-name=\"listed item: firm tofu\">firm tofu</p>\n<p class=\"rec__n\" data-kid=\"2-2-2-3-2-2-2-1-3\" data-name=\"listed item: jasmine rice\">jasmine rice</p>\n<p class=\"rec__n\" data-kid=\"2-2-2-3-2-2-2-1-4\" data-name=\"listed item: soy sauce\">soy sauce</p>\n</div>\n<div class=\"grp\" data-kid=\"2-2-2-3-2-2-2-2\" data-name=\"not listed column group\">\n<p class=\"rec__h\" data-kid=\"2-2-2-3-2-2-2-2-1\" data-name=\"not listed column subheading\">Not listed</p>\n<p class=\"rec__n rec__n--out\" data-kid=\"2-2-2-3-2-2-2-2-2\" data-name=\"not listed item: salt (muted)\">salt</p>\n<p class=\"rec__n rec__n--out\" data-kid=\"2-2-2-3-2-2-2-2-3\" data-name=\"not listed item: olive oil (muted)\">olive oil</p>\n<p class=\"rec__n rec__n--out\" data-kid=\"2-2-2-3-2-2-2-2-4\" data-name=\"not listed item: black pepper (muted)\">black pepper</p>\n</div>\n<figcaption class=\"rec__note\" data-kid=\"2-2-2-3-2-2-2-3\" data-name=\"example explanation note\"><b data-kid=\"2-2-2-3-2-2-2-3-1\" data-name=\"emphasized rule statement text\">Ticked staples stay off the ingredient list.</b> The Recipe can still call for one you forgot.</figcaption>\n</div>\n</figure>\n<div class=\"actions\" data-kid=\"2-2-2-3-2-3\" data-name=\"form actions footer bar\">\n<button class=\"btn btn--quiet\" data-kid=\"2-2-2-3-2-3-1\" data-name=\"Back secondary button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"2-2-2-3-2-3-2\" data-name=\"Continue primary button\" type=\"button\">Continue</button>\n</div>\n</div>\n</main>\n</div>\n</section>\n</div>",
      "comments": [],
      "created": "2026-11-22T10:39:55.465542+00:00",
      "modified": "2026-11-22T10:41:38.321953+00:00",
      "id": "var_a93287b7c3cf",
      "contentHeight": 2090
    },
    "var_0550e71fa3b7": {
      "type": "variant",
      "label": "C1 — Step spine, page as one column",
      "parentId": "var_a93287b7c3cf",
      "themeId": null,
      "rect": {
        "x": 12219,
        "y": 0,
        "w": 1160,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --accent-text: color-mix(in oklab, var(--accent) 60%, var(--foreground));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --space-12: calc(var(--spacing) * 12);\n  --space-16: calc(var(--spacing) * 16);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,p,ol,ul,dl,dd,fieldset,legend,figure,figcaption{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; min-inline-size: 0; }\nbutton{ font: inherit; color: inherit; }\n:is(a,button,input,label):focus-visible{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.board{ display: grid; gap: var(--space-10); padding: var(--space-8) var(--space-8) var(--space-12); }\n.flow{ display: grid; gap: var(--space-2); }\n.label{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.screen{ display: grid; overflow: hidden; background: var(--background); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); container-type: inline-size; }\n\n.bar{ border-block-end: var(--border-width-thin) solid var(--border); }\n.bar .frame{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 60px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); text-decoration: none; color: inherit; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: none; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n@media (width >= 48rem){ .nav{ display: flex; } }\n\n/* the setup index, standing in for the strip */\n.body{ display: grid; }\n@container (inline-size >= 840px){ .body{ grid-template-columns: 236px minmax(0,1fr); } }\n.spine{ padding: var(--space-6) var(--space-4); background: color-mix(in oklab, var(--primary) 7%, var(--background)); }\n.spine__h{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); padding-inline: var(--space-2); padding-block-end: var(--space-3); }\n.ix{ display: grid; gap: 2px; }\n.ix__row{ display: grid; grid-template-columns: 22px minmax(0,1fr); align-items: start; gap: var(--space-3); padding: var(--space-2); border-radius: var(--radius-sm); text-decoration: none; color: var(--muted-foreground); }\n.ix__row:hover{ background: color-mix(in oklab, var(--primary) 8%, transparent); }\n.ix__n{ display: grid; place-items: center; inline-size: 22px; block-size: 22px; border: var(--border-width-thin) solid var(--border); border-radius: 3px; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-solid); }\n.ix__t{ display: block; font-size: var(--text-sm); line-height: var(--leading-tight); padding-block-start: 3px; }\n.ix__f{ display: block; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.ix__row--done{ color: var(--foreground); }\n.ix__row--done .ix__n{ background: var(--muted); border-color: transparent; color: var(--muted-foreground); }\n.ix__row--on{ color: var(--foreground); font-weight: 700; }\n.ix__row--on .ix__n{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n\n.content{ padding: var(--space-6) var(--space-6) var(--space-7); min-inline-size: 0; display: grid; gap: var(--space-5); align-content: start; }\n.shelf{ position: relative; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-block-start: calc(var(--space-2) * -1); }\n.shelf__label{ position: relative; z-index: 4; display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.shelf__facts{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n/* one key, no per-field \"optional\" */\n.key{ display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.req{ display: inline-block; inline-size: 6px; block-size: 6px; background: var(--primary-text); border-radius: 1px; vertical-align: middle; }\n\n.form{ display: grid; gap: var(--space-5); }\n.field{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.lb{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.ln{ inline-size: 100%; block-size: 38px; padding: 0 0 0 1px; border: 0; border-block-end: var(--border-width-thin) solid var(--input); background: transparent; color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); }\n.ln:focus-visible{ outline: none; border-block-end-width: var(--border-width-medium); border-block-end-color: var(--ring); }\n.ln--sm{ max-inline-size: 9rem; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }\n.duo{ display: grid; gap: var(--space-5); }\n@container (inline-size >= 640px){ .duo{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); column-gap: var(--space-8); align-items: start; } }\n.inline{ display: flex; align-items: center; gap: var(--space-3); }\n.stepper{ display: inline-flex; align-items: center; inline-size: fit-content; border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm); background: transparent; overflow: hidden; }\n.stepper button{ inline-size: 30px; block-size: 34px; padding: 0; border: 0; background: transparent; color: var(--foreground); cursor: pointer; }\n.stepper button:hover{ background: var(--muted); }\n.stepper output{ min-inline-size: 32px; text-align: center; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-sm); }\n.flags{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); }\n.flag{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 34px; font-size: var(--text-sm); cursor: pointer; }\n.flag input{ inline-size: 16px; block-size: 16px; margin: 0; accent-color: var(--primary-text); }\n.rule{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); max-inline-size: 58ch; }\n.rule b{ color: var(--foreground); font-weight: 700; }\n.rule em{ font-style: normal; text-decoration: line-through; text-decoration-thickness: var(--border-width-thin); }\n.rule i{ font-style: normal; color: var(--accent-text); font-weight: 700; }\n\n.rack{ display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: var(--space-1) var(--space-4); }\n@container (inline-size >= 700px){ .rack{ grid-template-columns: repeat(5, minmax(0,1fr)); } }\n.all{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; font-size: var(--text-sm); cursor: pointer; }\n.all input{ inline-size: 14px; block-size: 14px; margin: 0; accent-color: var(--primary-text); }\n.all:has(input:checked){ font-weight: 700; }\n.count{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); font-weight: 400; }\n\n/* staples: every group is a two-column rack */\n.grp{ display: grid; gap: var(--space-2); }\n.list{ display: grid; grid-template-columns: 16px minmax(0,1fr); align-items: center; column-gap: var(--space-3); min-block-size: 34px; border-block-end: var(--border-width-thin) solid var(--border); font-size: var(--text-sm); cursor: pointer; }\n.rack2{ display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); column-gap: var(--space-8); }\n.rack2 .list{ display: grid; }\n.mine{ display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.mine__chip{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; padding-inline: var(--space-3) var(--space-1); border: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 46%, var(--border)); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--primary) 14%, var(--background)); font-size: var(--text-sm); }\n.chip__x{ display: grid; place-items: center; inline-size: 20px; block-size: 20px; padding: 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--muted-foreground); cursor: pointer; }\n.chip__x:hover{ color: var(--foreground); background: var(--muted); }\n\n.foot{ display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block-start: var(--space-5); border-block-start: var(--border-width-thin) solid var(--border); }\n.commit{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: 0.02em; color: var(--muted-foreground); }\n.commit b{ color: var(--foreground); font-weight: 700; }\n.actions{ display: flex; align-items: center; gap: var(--space-3); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-5); border-radius: var(--radius-md); border: var(--border-width-thin) solid var(--border); background: transparent; font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; }\n.btn:hover{ background: var(--muted); }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n.btn--primary:hover{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n.btn--quiet{ border-color: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--quiet:hover{ background: var(--muted); color: var(--foreground); }\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n.x{ display: block; flex: none; }\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" data-name=\"hidden SVG symbol definitions (X icon)\" focusable=\"false\"><defs>\n<symbol id=\"x\" viewbox=\"0 0 10 10\"><path d=\"M1 1l8 8M9 1l-8 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></symbol>\n</defs></svg>\n<div class=\"board\" data-kid=\"2\" data-name=\"page layout container\">\n<section class=\"flow\" data-kid=\"2-1\" data-name=\"step 2 diet section\">\n<p class=\"label\" data-kid=\"2-1-1\" data