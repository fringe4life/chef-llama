use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-8-1-1-2\" data-name=\"checkbox seal fill layer\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-8-1-1-3\" data-name=\"checkbox animated tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"box__ring\" data-kid=\"2-2-2-2-8-1-2\" data-name=\"checkbox pulse ring\"></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-9\" data-name=\"mid state example cell\"><span class=\"box d-mid\" data-kid=\"2-2-2-2-9-1\" data-name=\"mid state checkbox box\"><span class=\"box__clip\" data-kid=\"2-2-2-2-9-1-1\" data-name=\"checkbox clip wrapper\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-9-1-1-1\" data-name=\"checkbox ghost checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-9-1-1-2\" data-name=\"checkbox seal fill layer\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-9-1-1-3\" data-name=\"checkbox animated tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"box__ring\" data-kid=\"2-2-2-2-9-1-2\" data-name=\"checkbox pulse ring\"></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-10\" data-name=\"on state example cell\"><span class=\"box d-on\" data-kid=\"2-2-2-2-10-1\" data-name=\"on state checkbox box\"><span class=\"box__clip\" data-kid=\"2-2-2-2-10-1-1\" data-name=\"checkbox clip wrapper\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-10-1-1-1\" data-name=\"checkbox ghost checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-10-1-1-2\" data-name=\"checkbox seal fill layer\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-10-1-1-3\" data-name=\"checkbox animated tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"box__ring\" data-kid=\"2-2-2-2-10-1-2\" data-name=\"checkbox pulse ring\"></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-11\" data-name=\"large mid state example cell\"><span class=\"box lg d-mid\" data-kid=\"2-2-2-2-11-1\" data-name=\"large mid state checkbox box\"><span class=\"box__clip\" data-kid=\"2-2-2-2-11-1-1\" data-name=\"checkbox clip wrapper\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-11-1-1-1\" data-name=\"checkbox ghost checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"box__fill\" data-kid=\"2-2-2-2-11-1-1-2\" data-name=\"checkbox seal fill layer\"></span><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-11-1-1-3\" data-name=\"checkbox animated tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"box__ring\" data-kid=\"2-2-2-2-11-1-2\" data-name=\"checkbox pulse ring\"></span></span></span>\n<span class=\"cell\" data-kid=\"2-2-2-2-12\" data-name=\"at limit state example cell\"><span class=\"box d-limit\" data-kid=\"2-2-2-2-12-1\" data-name=\"at limit state checkbox box\"><span class=\"box__clip\" data-kid=\"2-2-2-2-12-1-1\" data-name=\"checkbox clip wrapper\"><svg aria-hidden=\"true\" class=\"box__ghost\" data-kid=\"2-2-2-2-12-1-1-1\" data-name=\"checkbox ghost checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><svg aria-hidden=\"true\" class=\"box__tick\" data-kid=\"2-2-2-2-12-1-1-2\" data-name=\"checkbox tick outline icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span></span>\n</div>\n</section>\n<section class=\"block\" data-kid=\"2-2-3\" data-name=\"timing specifications section\">\n<h2 data-kid=\"2-2-3-1\" data-name=\"section heading timing\">Timing</h2>\n<dl class=\"spec\" data-kid=\"2-2-3-2\" data-name=\"timing specifications list\">\n<dt data-kid=\"2-2-3-2-1\" data-name=\"seal animation label\">Seal</dt><dd data-kid=\"2-2-3-2-2\" data-name=\"seal duration value\">340 ms</dd>\n<dt data-kid=\"2-2-3-2-3\" data-name=\"curve label\">Curve</dt><dd data-kid=\"2-2-3-2-4\" data-name=\"easing curve value\">cubic-bezier(0.3, 1.1, 0.3, 1)</dd>\n<dt data-kid=\"2-2-3-2-5\" data-name=\"settle label\">Settle</dt><dd data-kid=\"2-2-3-2-6\" data-name=\"settle timing value\">107 % at 210 ms, 100 % at 340 ms</dd>\n<dt data-kid=\"2-2-3-2-7\" data-name=\"ring label\">Ring</dt><dd data-kid=\"2-2-3-2-8\" data-name=\"ring timing value\">460 ms, 1 → 2.4×, fades to 0.18 at 330 ms</dd>\n<dt data-kid=\"2-2-3-2-9\" data-name=\"fill label\">Fill</dt><dd data-kid=\"2-2-3-2-10\" data-name=\"fill timing value\">30 – 340 ms</dd>\n<dt data-kid=\"2-2-3-2-11\" data-name=\"tick label\">Tick</dt><dd data-kid=\"2-2-3-2-12\" data-name=\"tick timing value\">190 ms, delay 120 ms</dd>\n<dt data-kid=\"2-2-3-2-13\" data-name=\"reduced motion label\">Reduced motion</dt><dd data-kid=\"2-2-3-2-14\" data-name=\"reduced motion behavior value\">Endpoint only, no ring</dd>\n</dl>\n</section>\n</div>\n</div>\n",
