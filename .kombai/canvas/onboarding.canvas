=\"4-4-1-2-7-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-7-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-7-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-7-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-7-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-7-3\" data-name=\"allergy chip name label: wheat\">wheat</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-7-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-7-4-1\" data-name=\"chip wash name label: wheat\">wheat</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-8\" data-name=\"allergy chip: fish\"><input data-kid=\"4-4-1-2-8-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-8-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-8-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-8-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-8-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-8-3\" data-name=\"allergy chip name label: fish\">fish</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-8-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-8-4-1\" data-name=\"chip wash name label: fish\">fish</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-9\" data-name=\"allergy chip: shellfish\"><input data-kid=\"4-4-1-2-9-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-9-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-9-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-9-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-9-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-9-3\" data-name=\"allergy chip name label: shellfish\">shellfish</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-9-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-9-4-1\" data-name=\"chip wash name label: shellfish\">shellfish</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-10\" data-name=\"allergy chip: mollusc\"><input data-kid=\"4-4-1-2-10-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-10-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-10-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-10-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-10-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-10-3\" data-name=\"allergy chip name label: mollusc\">mollusc</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-10-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-10-4-1\" data-name=\"chip wash name label: mollusc\">mollusc</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-11\" data-name=\"allergy chip: sulphites\"><input data-kid=\"4-4-1-2-11-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-11-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-11-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-11-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-11-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-11-3\" data-name=\"allergy chip name label: sulphites\">sulphites</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-11-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-11-4-1\" data-name=\"chip wash name label: sulphites\">sulphites</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-12\" data-name=\"allergy chip: lupin\"><input data-kid=\"4-4-1-2-12-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-12-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-12-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-12-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-12-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-12-3\" data-name=\"allergy chip name label: lupin\">lupin</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-12-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-12-4-1\" data-name=\"chip wash name label: lupin\">lupin</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-13\" data-name=\"allergy chip: celery\"><input data-kid=\"4-4-1-2-13-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-13-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-13-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-13-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-13-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-13-3\" data-name=\"allergy chip name label: celery\">celery</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-13-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-13-4-1\" data-name=\"chip wash name label: celery\">celery</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-14\" data-name=\"allergy chip: mustard\"><input data-kid=\"4-4-1-2-14-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-14-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-14-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-14-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-14-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-14-3\" data-name=\"allergy chip name label: mustard\">mustard</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-14-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-14-4-1\" data-name=\"chip wash name label: mustard\">mustard</span></span></label>\n<label class=\"chip\" data-kid=\"4-4-1-2-15\" data-name=\"allergy chip: kiwi fruit\"><input data-kid=\"4-4-1-2-15-1\" data-name=\"allergy chip checkbox input\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"4-4-1-2-15-2\" data-name=\"checkbox slot group\"><span class=\"chip__pocket\" data-kid=\"4-4-1-2-15-2-1\" data-name=\"checkbox pocket surface\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"4-4-1-2-15-2-2\" data-name=\"checkbox checkmark icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"4-4-1-2-15-2-3\" data-name=\"focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"4-4-1-2-15-3\" data-name=\"allergy chip name label: kiwi fruit\">kiwi fruit</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"4-4-1-2-15-4\" data-name=\"chip filled wash layer\"><span class=\"chip__wash-label\" data-kid=\"4-4-1-2-15-4-1\" data-name=\"chip wash name label: kiwi fruit\">kiwi fruit</span></span></label>\n</div>\n<input aria-label=\"Another allergy\" class=\"input\" data-kid=\"4-4-1-3\" data-name=\"custom allergy text input\" placeholder=\"Another allergy\" type=\"text\"/>\n</fieldset>\n<aside class=\"consequence\" data-kid=\"4-4-2\" data-name=\"consequence explanation panel\">\n<p class=\"caps\" data-kid=\"4-4-2-1\" data-name=\"consequence panel caption\">What this changes</p>\n<p class=\"consequence__text\" data-kid=\"4-4-2-2\" data-name=\"consequence explanation text\">The Recipe keeps the dish and swaps the ingredient.</p>\n<figure class=\"swap\" data-kid=\"4-4-2-3\" data-name=\"ingredient swap example figure\">\n<span data-kid=\"4-4-2-3-1\" data-name=\"swap-from ingredient: chicken\">chicken</span>\n<span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"4-4-2-3-2\" data-name=\"swap arrow icon\">→</span>\n<span data-kid=\"4-4-2-3-3\" data-name=\"swap-to ingredient: firm tofu\">firm tofu</span>\n<figcaption class=\"swap__why\" data-kid=\"4-4-2-3-4\" data-name=\"swap reason caption: breaks vegan\">breaks vegan</figcaption>\n</figure>\n</aside>\n</div>\n<p class=\"rule\" data-kid=\"4-5\" data-name=\"hard limits rule text\"><b data-kid=\"4-5-1\" data-name=\"bold emphasis on hard limits phrase\">Requirements and allergies are hard limits.</b> kcal is a target.</p>\n<div class=\"actions\" data-kid=\"4-6\" data-name=\"page action buttons bar\">\n<button class=\"btn btn--quiet\" data-kid=\"4-6-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"4-6-2\" data-name=\"save diet primary button\" type=\"button\">Save Diet</button>\n</div>\n</main>\n<script>\nfunction rail(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n}\n</script>",
      "comments": [],
      "created": "2026-11-24T17:59:55.026257+00:00",
      "modified": "2026-11-24T18:39:31.202523+00:00",
      "id": "var_2bf18cda5e0c",
      "contentHeight": 1131
    },
    "var_b166bece1d6d": {
      "type": "variant",
      "label": "Diet D — Field sheet, every setting beside what it does",
      "parentId": "var_6e48cfb95f08",
      "themeId": null,
      "rect": {
        "x": 28035,
        "y": 0,
        "w": 1215,
        "h": 0
      },
      "html": "<style>\n@property --p{ syntax:\"<percentage>\"; inherits:true; initial-value:0%; }\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --accent-text: color-mix(in oklab, var(--accent) 60%, var(--foreground));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-8: calc(var(--spacing) * 8);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n\n  --food: color-mix(in oklab, var(--primary) 68%, var(--foreground));\n  --leaf: var(--accent-text);\n\n  --ease-arrive: linear(0, 0.264 6.25%, 0.482 12.5%, 0.647 18.75%, 0.765 25%, 0.876 34.375%, 0.937 43.75%, 0.98 57.813%, 0.998 78.906%, 1);\n  --ease-depart: linear(0, 0.002 21.094%, 0.02 42.188%, 0.063 56.25%, 0.124 65.625%, 0.235 75%, 0.353 81.25%, 0.518 87.5%, 0.736 93.75%, 1);\n  --ease-glide: linear(0, 0.002 3.125%, 0.022 9.375%, 0.085 18.75%, 0.148 25%, 0.282 35.547%, 0.643 59.277%, 0.843 74.219%, 0.915 81.25%, 0.978 90.625%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.117 46%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --ease-linear: linear(0, 1);\n  --duration-tick: 100ms;\n  --duration-quick: 160ms;\n  --duration-base: 250ms;\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,figure,figcaption{ margin: 0; }\nbutton{ font: inherit; color: inherit; }\n:is(a,button,input,label):focus-visible{ outline: 2px solid var(--ring); outline-offset: 2px; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.caps{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.bar{ border-block-end: 1px solid var(--border); }\n.bar__in{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 58px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); color: inherit; text-decoration: none; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: none; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n@media (width >= 48rem){ .nav{ display: flex; } }\n\n.steps{ border-block-end: 1px solid var(--border); }\n.steps__in{ display: flex; align-items: stretch; gap: var(--space-5); }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 42px; font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none; border-block-end: 2px solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-size: var(--text-2xs); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--primary-text); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n\n.page{ display: grid; gap: var(--space-5); padding-block: var(--space-5) var(--space-8); }\n.shelf__label{ display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n\n/* One row per setting. Every row is the same five children in the same order —\n   label, obligation, statement, control, specimen — and only the areas change. */\n.sheet{ display: grid; grid-template-columns: minmax(0,1fr) 312px; column-gap: var(--space-8); container: sheet / inline-size; }\n.sheet__head{ grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; column-gap: var(--space-8); }\n\n.pair{ grid-column: 1 / -1; display: grid; align-items: start;\n  grid-template-columns: minmax(0,1fr) 312px;\n  grid-template-areas:\n    \"label  tag\"\n    \"ctrl   note\"\n    \"extra  note\";\n  column-gap: var(--space-8); row-gap: 0;\n  padding-block: var(--space-4);\n  border-block-start: 1px solid var(--border); }\n.note{ grid-area: note; margin-block-start: var(--space-2); display: grid; gap: var(--space-2); align-content: start; min-inline-size: 0; }\n\n.field__label{ grid-area: label; font-size: var(--text-sm); font-weight: 700; line-height: 20px; letter-spacing: var(--tracking-tight); }\n.field__label .caps{ margin-inline-start: var(--space-1); font-weight: 400; }\n.ob{ grid-area: tag; justify-self: start; display: inline-flex; align-items: center; gap: var(--space-2); block-size: 20px;\n  font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-solid); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--primary-text); }\n.ob--req::before{ content: \"\"; flex: none; inline-size: 5px; block-size: 5px; background: var(--primary-text); }\n.note__p{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.note__p b{ color: var(--foreground); font-weight: 700; }\n.input{ grid-area: ctrl; margin-block-start: var(--space-2); inline-size: 100%; min-block-size: 40px; padding: 0 var(--space-3); border: 1px solid var(--input); border-radius: var(--radius-sm); background: var(--card); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); }\n.input--short{ max-inline-size: 420px; }\n.input--add{ grid-area: extra; }\n\n/* the requirements bank: eight across a wide sheet, four mid, two on a phone.\n   The tile keeps its width; the count is what gives way. */\n.bank{ grid-area: ctrl; margin-block-start: var(--space-2); display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: var(--space-2); }\n@container sheet (width >= 30rem){ .bank{ grid-template-columns: repeat(4, minmax(0,1fr)); gap: 6px; } }\n@container sheet (width >= 64rem){ .bank{ grid-template-columns: repeat(8, minmax(0,1fr)); } }\n.in{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.tile{ --slot: 20px; --slot-inset: var(--space-2);\n  --fill-x: calc(100% - var(--slot-inset) - var(--slot) / 2);\n  --fill-y: calc(var(--slot-inset) + var(--slot) / 2);\n  --mark-size: 44px;\n  --surface: var(--card);\n  --box-line: color-mix(in oklab, var(--input) 74%, var(--foreground));\n  position: relative; overflow: hidden; display: grid; justify-items: center; align-content: center; gap: var(--space-2); min-block-size: 92px; padding: var(--space-3) var(--space-1);\n  border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--foreground); cursor: pointer;\n  transition: border-color var(--duration-tick) var(--ease-linear), background-color var(--duration-tick) var(--ease-linear), transform var(--duration-quick) var(--ease-squish); }\n.tile::before{ content: \"\"; position: absolute; inset: 0; z-index: 0; background: var(--primary);\n  clip-path: circle(0% at var(--fill-x) var(--fill-y));\n  transition: clip-path var(--duration-quick) var(--ease-depart); }\n.tile::after{ content: \"\"; position: absolute; z-index: 2; inset-block-start: var(--slot-inset); inset-inline-end: var(--slot-inset);\n  inline-size: var(--slot); block-size: var(--slot);\n  background: var(--surface); box-shadow: inset 0 0 0 1px var(--box-line);\n  clip-path: polygon(4% 2%, 98% 6%, 99% 94%, 2% 99%);\n  transition: background-color var(--duration-tick) var(--ease-linear), box-shadow var(--duration-tick) var(--ease-linear); }\n.tile:hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--border) 46%, var(--foreground)); }\n.tile:active{ --surface: var(--muted); transform: translateY(1px); }\n.in:focus-visible + .tile{ outline: 2px solid var(--ring); outline-offset: 2px; }\n.in:checked + .tile{ border-color: var(--primary); color: var(--primary-foreground);\n  --food: color-mix(in oklab, var(--background) 82%, var(--primary));\n  --leaf: color-mix(in oklab, var(--accent) 76%, var(--primary-foreground)); }\n.in:checked + .tile::before{ clip-path: circle(150% at var(--fill-x) var(--fill-y)); transition: clip-path var(--duration-base) var(--ease-arrive); }\n.in:checked + .tile::after{ background: transparent; box-shadow: none; }\n.in:checked + .tile .tile__name{ font-weight: 700; }\n.in:checked + .tile:hover{ --surface: var(--card); border-color: color-mix(in oklab, var(--primary) 82%, var(--foreground)); }\n\n.ic{ position: relative; z-index: 1; display: block; inline-size: var(--mark-size); block-size: var(--mark-size); --sw: 1.5; color: currentColor; }\n.lay{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }\n.tile__name{ position: relative; z-index: 1; font-size: var(--text-2xs); line-height: var(--leading-tight); text-align: center; text-wrap: balance; }\n.tick{ position: absolute; z-index: 3; inset-block-start: calc(var(--slot-inset) + (var(--slot) - 11px) / 2); inset-inline-end: calc(var(--slot-inset) + (var(--slot) - 11px) / 2);\n  inline-size: 11px; block-size: 11px; color: var(--primary-foreground); overflow: visible;\n  stroke-dasharray: 17; stroke-dashoffset: 17; }\n.in:checked + .tile .tick{ animation: tick-draw var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n@keyframes tick-draw{ from{ stroke-dashoffset: 17; } to{ stroke-dashoffset: 0; } }\n\n.part{ transform-origin: var(--org, 50% 50%); transition: transform 320ms cubic-bezier(0.23,1,0.32,1); }\n.m-vegan{ --org: 58% 46%; --pose: rotate(-7deg); --hold: rotate(-4deg); }\n.m-vegetarian{ --org: 54% 33%; --pose: rotate(-6deg); --hold: rotate(-2deg); }\n.m-pescatarian{ --org: 50% 50%; --pose: translateX(1.4px); --hold: translateX(0); }\n.m-halal{ --org: 84% 24%; --pose: scale(1.25); --hold: scale(1.12); }\n.m-gluten{ --org: 50% 50%; --pose: translate(0.6px,-0.6px); --hold: translate(-1px,-1.2px) rotate(-6deg); }\n.m-dairy{ --org: 26% 78%; --pose: rotate(-4deg); --hold: rotate(-7deg); }\n.m-keto{ --org: 50% 88%; --pose: rotate(5deg); --hold: rotate(-5deg); }\n.m-paleo{ --org: 60% 26%; --pose: rotate(-5deg); --hold: rotate(-8deg); }\n.tile:hover .part{ transform: var(--pose); }\n.in:focus-visible + .tile .part{ transform: var(--pose); }\n.in:checked + .tile .part{ transform: var(--hold); }\n.in:checked + .tile .drift-sway{ animation: sway 5s ease-in-out infinite alternate; }\n.in:checked + .tile .drift-swim{ animation: swim 7s linear infinite; }\n.in:checked + .tile .drift-twinkle{ animation: twinkle 3.6s ease-in-out infinite; }\n@keyframes sway{ from{ transform: rotate(-2.5deg); } to{ transform: rotate(3.5deg); } }\n@keyframes swim{\n  0%{ transform: translate(-1.2px, 0) rotate(-3deg); }\n  25%{ transform: translate(0, -1.4px) rotate(0deg); }\n  50%{ transform: translate(1.2px, 0) rotate(3deg); }\n  75%{ transform: translate(0, 1.4px) rotate(0deg); }\n  100%{ transform: translate(-1.2px, 0) rotate(-3deg); }\n}\n@keyframes twinkle{ 0%, 100%{ transform: scale(1); opacity: 0.7; } 50%{ transform: scale(1.22); opacity: 1; } }\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n\n/* the rails, one per row, each with its own account of itself */\n.ctl{ grid-area: ctrl; margin-block-start: var(--space-2); --p: 0%; --trk-h: 58px; --rail-y: 29px; --pad: 14px; display: grid; gap: var(--space-1); min-inline-size: 0; transition: --p var(--duration-base) var(--ease-glide); }\n.ctl:has(.rng:active){ transition: --p 40ms linear; }\n@starting-style{ .ctl{ --p: 0%; } }\n.fig{ font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); font-variant-numeric: tabular-nums; }\n.trk{ position: relative; block-size: var(--trk-h); }\n.trk__scale{ position: absolute; inset-inline: var(--pad); inset-block: 0; }\n.rail{ position: absolute; inset-inline: 0; inset-block-start: var(--rail-y); block-size: 6px; border: 1px solid color-mix(in oklab, var(--input) 62%, var(--foreground)); border-radius: 3px; background: color-mix(in oklab, var(--border) 55%, var(--card)); transition: box-shadow var(--duration-quick) var(--ease-squish); }\n.fill{ position: absolute; inset-inline-start: 0; inset-block-start: var(--rail-y); block-size: 6px; inline-size: 100%; border-radius: 3px; background: var(--primary);\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent calc(var(--p) + 8px));\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent calc(var(--p) + 8px)); }\n.edge{ position: absolute; inset-inline-start: var(--p); inset-block-start: var(--rail-y); inline-size: 1px; block-size: 6px; background: color-mix(in oklab, var(--primary) 58%, var(--foreground)); }\n.pegs{ position: absolute; inset-inline: 0; inset-block-start: calc(var(--rail-y) - 13px); block-size: 10px; }\n.peg{ position: absolute; inset-block-start: 0; inset-inline-start: calc(var(--at) * 1%); inline-size: 1px; block-size: 100%; background: color-mix(in oklab, var(--muted-foreground) 52%, var(--card)); transform: translateX(-0.5px); }\n.grads{ position: absolute; inset-inline: 0; inset-block-start: calc(var(--rail-y) + 8px); block-size: 10px;\n  background-image: repeating-linear-gradient(to right, var(--tk-major) 0 1px, transparent 1px 10%), repeating-linear-gradient(to right, var(--tk-minor) 0 1px, transparent 1px 2.5%);\n  background-size: 100% 10px, 100% 5px; background-position: left bottom, left bottom; background-repeat: repeat-x;\n  --tk-major: color-mix(in oklab, var(--muted-foreground) 68%, var(--card));\n  --tk-minor: color-mix(in oklab, var(--muted-foreground) 32%, var(--card)); }\n.grads--in{ --tk-major: color-mix(in oklab, var(--background) 86%, var(--primary)); --tk-minor: color-mix(in oklab, var(--background) 70%, var(--primary));\n  -webkit-mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent var(--p));\n  mask-image: linear-gradient(to right, #000 calc(var(--p) - 8px), transparent var(--p)); }\n.scale{ position: relative; block-size: 14px; margin-inline: var(--pad); }\n.mark{ position: absolute; inset-inline-start: calc(var(--at) * 1%); transform: translateX(-50%); font-family: var(--font-mono); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n.mark:first-child{ transform: none; }\n.mark:last-child{ transform: translateX(-100%); }\n.rng{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: grab; z-index: 3; }\n.rng:active{ cursor: grabbing; }\n.rng::-webkit-slider-runnable-track{ block-size: var(--trk-h); background: transparent; border: 0; }\n.rng::-webkit-slider-thumb{ -webkit-appearance: none; inline-size: 22px; block-size: 56px; margin-block-start: calc((var(--trk-h) - 56px) / 2);\n  border: 1px solid oklch(0.42 0.085 64 / 0.50); border-radius: 3px; background-color: transparent;\n  background-image: linear-gradient(90deg, oklch(0.910 0.100 94) 0%, oklch(0.855 0.145 88) 17%, oklch(0.735 0.158 77) 50%, oklch(0.855 0.145 88) 83%, oklch(0.910 0.100 94) 100%);\n  background-repeat: no-repeat; background-size: 100% 100%;\n  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.55), inset 0 -1px 0 oklch(0.38 0.06 58 / 0.24), 0 2px 0 oklch(0.33 0.05 62 / 0.14), 0 0 0 1px oklch(0.42 0.085 64 / 0.08);\n  transition: transform var(--duration-quick) var(--ease-squish), box-shadow var(--duration-quick) var(--ease-squish); }\n.rng::-moz-range-track{ block-size: var(--trk-h); background: transparent; border: 0; }\n.rng::-moz-range-thumb{ inline-size: 22px; block-size: 56px; border: 1px solid oklch(0.42 0.085 64 / 0.50); border-radius: 3px;\n  background-image: linear-gradient(90deg, oklch(0.910 0.100 94) 0%, oklch(0.855 0.145 88) 17%, oklch(0.735 0.158 77) 50%, oklch(0.855 0.145 88) 83%, oklch(0.910 0.100 94) 100%);\n  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.55), inset 0 -1px 0 oklch(0.38 0.06 58 / 0.24), 0 2px 0 oklch(0.33 0.05 62 / 0.14); }\n.rng:hover::-webkit-slider-thumb{ transform: translateY(-1px); }\n.rng:active::-webkit-slider-thumb{ transform: translateY(1px) scaleY(1.05); }\n.rng:focus-visible::-webkit-slider-thumb{ box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.60), 0 0 0 2px var(--ring), 0 0 0 4px var(--background); }\n.trk:has(.rng:active) .rail{ box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent); }\n.trk:has(.rng:focus-visible) .rail{ box-shadow: 0 0 0 2px var(--ring), 0 0 0 4px var(--background); }\n\n/* allergies: the Selection D chip */\n.chips{ grid-area: ctrl; margin-block-start: var(--space-2); display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.chip{ --pad-x: var(--space-3); --slot: 14px; --gap: var(--space-2); --label-x: calc(var(--pad-x) + var(--slot) + var(--gap)); --surface: var(--card);\n  position: relative; display: inline-flex; align-items: center; gap: var(--gap); min-block-size: 32px; padding-inline: var(--pad-x);\n  border: 1px solid var(--input); border-radius: var(--radius-sm); background: var(--surface); color: var(--foreground);\n  font-size: var(--text-sm); line-height: var(--leading-solid); white-space: nowrap; cursor: pointer; overflow: hidden;\n  transition: background-color var(--duration-tick) var(--ease-linear), border-color var(--duration-tick) var(--ease-linear), transform var(--duration-quick) var(--ease-squish); }\n.chip input{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n.chip__name{ position: relative; z-index: 0; }\n.chip__slot{ position: relative; z-index: 2; flex: none; display: grid; place-items: center; inline-size: var(--slot); block-size: var(--slot); }\n.chip__pocket{ position: absolute; inset: 0; background: color-mix(in oklab, var(--input) 74%, var(--foreground)); clip-path: polygon(4% 2%, 98% 6%, 99% 94%, 2% 99%); transition: background-color var(--duration-tick) var(--ease-linear); }\n.chip__pocket::before{ content: \"\"; position: absolute; inset: 1px; background: var(--surface); clip-path: inherit; transition: background-color var(--duration-tick) var(--ease-linear); }\n.chip__tick{ position: absolute; z-index: 1; inline-size: calc(var(--slot) - 3px); block-size: calc(var(--slot) - 3px); color: var(--primary-foreground); stroke-dasharray: 17; stroke-dashoffset: 17; overflow: visible; }\n.chip__ring{ position: absolute; inset: -1px; border-radius: 4px; border: 1px solid var(--ring); opacity: 0; pointer-events: none; }\n.chip__wash{ position: absolute; inset: 0; z-index: 1; background: var(--primary); clip-path: circle(0% at calc(var(--pad-x) + var(--slot) / 2) 50%); transition: clip-path var(--duration-quick) var(--ease-depart), background-color var(--duration-tick) var(--ease-linear); }\n.chip__wash-label{ position: absolute; inset-block: 0; inset-inline-start: var(--label-x); display: flex; align-items: center; color: var(--primary-foreground); }\n.chip:hover{ --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.chip:active{ --surface: var(--muted); transform: translateY(1px); }\n.chip:has(input:checked){ border-color: var(--primary); }\n.chip:has(input:checked) .chip__wash{ clip-path: circle(150% at calc(var(--pad-x) + var(--slot) / 2) 50%); transition: clip-path var(--duration-base) var(--ease-arrive), background-color var(--duration-tick) var(--ease-linear); }\n.chip:has(input:checked) .chip__pocket{ background: transparent; animation: pocket-seal var(--duration-quick) var(--ease-squish) both; }\n.chip:has(input:checked) .chip__pocket::before{ background: transparent; }\n.chip:has(input:checked) .chip__tick{ animation: tick-draw var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n.chip:has(input:checked):hover .chip__wash{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n@keyframes pocket-seal{ from{ transform: scale(0.62); } to{ transform: scale(1); } }\n@keyframes tick-draw{ from{ stroke-dashoffset: 17; } to{ stroke-dashoffset: 0; } }\n\n/* the specimen: what the limit does to one ingredient */\n.swap{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-2); font-family: var(--font-mono); font-size: var(--text-2xs); }\n.swap__arrow{ color: var(--muted-foreground); }\n.swap__why{ flex-basis: 100%; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.actions{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block-start: var(--space-3); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 44px; padding: 0 var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--border); background: transparent; font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; transition: background-color var(--duration-tick) var(--ease-linear), transform var(--duration-quick) var(--ease-squish); }\n.btn:active{ transform: translateY(1px); }\n.btn--quiet{ border-color: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--quiet:hover{ background: var(--muted); color: var(--foreground); }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n.btn--primary:hover{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n\n/* the whole responsive difference: the same markup, two area maps */\n@container sheet (width < 56rem){\n  .sheet{ grid-template-columns: minmax(0,1fr); }\n  .sheet__head{ display: none; }\n  .pair{ grid-template-columns: minmax(0,1fr) auto; row-gap: var(--space-2);\n    grid-template-areas:\n      \"label  tag\"\n      \"note   note\"\n      \"ctrl   ctrl\"\n      \"extra  extra\"; }\n  .ob{ justify-self: end; }\n  .note, .bank, .chips, .ctl, .input{ margin-block-start: 0; }\n}\n/* at two across the tile is a large one: 48 mark and a 12 label, per the size ladder */\n@container sheet (width < 30rem){\n  .tile{ min-block-size: 96px; padding: var(--space-3) var(--space-2); --mark-size: 48px; }\n  .tile__name{ font-size: var(--text-xs); }\n}\n\n@media (prefers-reduced-motion: reduce){\n  .tile, .tile::before, .tile::after, .part, .tick, .chip, .ctl, .btn, .rng::-webkit-slider-thumb, .rail{ transition: none; }\n  .chip__pocket, .chip__tick{ animation: none; }\n  .chip:has(input:checked) .chip__tick{ stroke-dashoffset: 0; }\n  .in:checked + .tile .tick{ animation: none; stroke-dashoffset: 0; }\n  .in:checked + .tile .part{ animation: none; }\n}\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" focusable=\"false\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\"><path d=\"M2.4 6.6c1.2 1.2 2.4 2.4 3.5 3.6 2-3.1 4-6 5.5-7.7\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.1\"></path></symbol>\n<symbol id=\"b-vegan\" viewbox=\"0 0 24 24\"><path d=\"M12 21.2c0-4.8.6-8.6 1.8-11.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path></symbol>\n<symbol id=\"p-vegan\" viewbox=\"0 0 24 24\">\n<