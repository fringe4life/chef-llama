      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --accent-text: color-mix(in oklab, var(--accent) 60%, var(--foreground));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --space-12: calc(var(--spacing) * 12);\n  --space-16: calc(var(--spacing) * 16);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,p,ol,ul,dl,dd,fieldset,legend,figure,figcaption{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; min-inline-size: 0; }\nbutton{ font: inherit; color: inherit; }\n:is(a,button,input,label):focus-visible{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.board{ display: grid; gap: var(--space-10); padding: var(--space-8) var(--space-8) var(--space-12); }\n.flow{ display: grid; gap: var(--space-2); }\n.label{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.screen{ display: grid; overflow: hidden; background: var(--background); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); container-type: inline-size; }\n\n.bar{ border-block-end: var(--border-width-thin) solid var(--border); }\n.bar .frame{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 60px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); text-decoration: none; color: inherit; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: none; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n@media (width >= 48rem){ .nav{ display: flex; } }\n\n.steps{ border-block-end: var(--border-width-thin) solid var(--border); }\n.steps .frame{ display: flex; align-items: stretch; gap: var(--space-5); overflow-x: auto; }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 44px; padding-block-start: 2px; font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none; border-block-end: var(--border-width-medium) solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-2xs); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--accent-text); }\n\n.page{ display: grid; gap: var(--space-6); padding-block: var(--space-3) var(--space-8); }\n.shelf{ position: relative; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-block-start: calc(var(--space-2) * -1); }\n.shelf__label{ position: relative; z-index: 4; display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.shelf__facts{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n/* one surface: the editable unit and its one action */\n.surface{ display: grid; gap: var(--space-6); padding: var(--space-6); background: var(--card); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); }\n.split{ display: grid; gap: var(--space-6); }\n@container (inline-size >= 860px){ .split{ grid-template-columns: minmax(0,1fr) 288px; column-gap: var(--space-10); align-items: start; } }\n.stack{ display: grid; gap: var(--space-6); align-content: start; min-inline-size: 0; }\n.field{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.lb{ display: block; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.input{ inline-size: 100%; min-block-size: 38px; padding: 0 var(--space-3); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-base); }\n.input--num{ inline-size: 96px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }\n.flags{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); }\n.flag{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; font-size: var(--text-sm); cursor: pointer; }\n.flag input{ inline-size: 16px; block-size: 16px; margin: 0; accent-color: var(--primary-text); }\n.rack{ display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: var(--space-1) var(--space-4); }\n.all{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; font-size: var(--text-sm); cursor: pointer; }\n.all input{ inline-size: 14px; block-size: 14px; margin: 0; accent-color: var(--primary-text); }\n.all:has(input:checked){ font-weight: 700; }\n.count{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n.stepper{ display: inline-flex; align-items: center; inline-size: fit-content; border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--background); overflow: hidden; }\n.stepper button{ inline-size: 32px; block-size: 36px; padding: 0; border: 0; background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-base); }\n.stepper button:hover{ background: var(--muted); }\n.stepper output{ min-inline-size: 34px; text-align: center; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-sm); }\n.note{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.note b{ color: var(--foreground); font-weight: 700; }\n\n/* the consequence, sitting where the decision is made */\n.rec{ display: grid; gap: var(--space-3); padding-block-start: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); }\n.rec__h{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.rec__lines{ display: grid; gap: var(--space-1); max-inline-size: 27rem; }\n.line{ display: flex; align-items: baseline; gap: var(--space-2); min-block-size: 26px; font-size: var(--text-base); }\n.line__n{ white-space: nowrap; }\n.line__n--out{ color: var(--muted-foreground); text-decoration: line-through; text-decoration-thickness: var(--border-width-thin); }\n.lead{ flex: 1 1 var(--space-4); min-inline-size: var(--space-4); border-block-end: var(--border-width-thin) dotted color-mix(in oklab, var(--foreground) 26%, var(--card)); transform: translateY(-4px); }\n.line__s{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.02em; color: var(--muted-foreground); white-space: nowrap; }\n.line__s--in{ color: var(--accent-text); }\n.rec__note{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.rec__note b{ color: var(--foreground); font-weight: 700; }\n\n/* staples */\n.groups{ display: grid; gap: var(--space-6); }\n@container (inline-size >= 780px){ .groups{ grid-template-columns: minmax(0,1fr) minmax(0,1.1fr); column-gap: var(--space-8); align-items: start; } }\n.grp{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.list{ display: grid; }\n.row{ display: grid; grid-template-columns: 16px minmax(0,1fr); align-items: center; gap: var(--space-3); min-block-size: 36px; border-block-end: var(--border-width-thin) solid var(--border); font-size: var(--text-sm); cursor: pointer; }\n.list .row:first-of-type{ border-block-start: var(--border-width-thin) solid var(--border); }\n.row input{ inline-size: 16px; block-size: 16px; margin: 0; accent-color: var(--primary-text); }\n.rack2{ display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); column-gap: var(--space-6); }\n.mine{ display: grid; gap: var(--space-2); }\n.mine__chip{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-block-size: 34px; padding-inline: var(--space-2) var(--space-1); border: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 46%, var(--border)); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--primary) 14%, var(--card)); font-size: var(--text-sm); }\n.chip__x{ display: grid; place-items: center; inline-size: 20px; block-size: 20px; padding: 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--muted-foreground); cursor: pointer; }\n.chip__x:hover{ color: var(--foreground); background: var(--muted); }\n.rec--table{ display: grid; gap: var(--space-5); }\n@container (inline-size >= 720px){ .rec--table{ grid-template-columns: minmax(0,1fr) minmax(0,1fr) minmax(0,1.35fr); column-gap: var(--space-8); align-items: start; } }\n.rec__n{ font-size: var(--text-base); line-height: var(--leading-tight); }\n.rec__n--out{ color: var(--muted-foreground); }\n\n.actions{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block-start: var(--space-5); border-block-start: var(--border-width-thin) solid var(--border); }\n.btn{ display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-5); border-radius: var(--radius-md); border: var(--border-width-thin) solid var(--border); background: var(--card); font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; }\n.btn:hover{ background: var(--muted); }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n.btn--primary:hover{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n.btn--quiet{ border-color: transparent; background: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--quiet:hover{ background: var(--muted); color: var(--foreground); }\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n.x{ display: block; flex: none; }\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" data-name=\"hidden SVG sprite definitions\" focusable=\"false\"><defs>\n<symbol id=\"x\" viewbox=\"0 0 10 10\"><path d=\"M1 1l8 8M9 1l-8 8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path></symbol>\n</defs></svg>\n<div class=\"board\" data-kid=\"2\" data-name=\"page board with stacked screen mockups\">\n<section class=\"flow\" data-kid=\"2-1\" data-name=\"Step 2 diet screen demo section\">\n<p class=\"label\" data-kid=\"2-1-1\" data-name=\"section label for Step 2 Diet\">Step 2 — Diet</p>\n<div class=\"screen\" data-kid=\"2-1-2\" data-name=\"browser-like screen frame for diet step\">\n<header class=\"bar\" data-kid=\"2-1-2-1\" data-name=\"top toolbar bar\"><div class=\"frame\" data-kid=\"2-1-2-1-1\" data-name=\"toolbar content row\">\n<a class=\"lockup\" data-kid=\"2-1-2-1-1-1\" data-name=\"brand logo lockup link\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"llama head brand icon\" height=\"28\" viewbox=\"0 0 32 32\" width=\"28\"><g><rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect><ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse></g><circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle><g><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect><rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect></g></svg>\n<span class=\"wordmark\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"2-1-2-1-1-2\" data-name=\"top site navigation\"><span data-kid=\"2-1-2-1-1-2-1\" data-name=\"Pantry nav link\">Pantry</span><span data-kid=\"2-1-2-1-1-2-2\" data-name=\"Saved nav link\">Saved</span><span data-kid=\"2-1-2-1-1-2-3\" data-name=\"Account nav link\">Account</span></nav>\n</div></header>\n<nav aria-label=\"Setup\" class=\"steps\" data-kid=\"2-1-2-2\" data-name=\"setup step progress bar\"><div class=\"frame\" data-kid=\"2-1-2-2-1\" data-name=\"step list row\">\n<a class=\"step step--done\" data-kid=\"2-1-2-2-1-1\" data-name=\"done step link: Devices\" href=\"#\"><span class=\"step__n\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"step number badge: 1\">1</span>Devices</a>\n<a aria-current=\"step\" class=\"step\" data-kid=\"2-1-2-2-1-2\" data-name=\"current active step link: Diet\" href=\"#\"><span class=\"step__n\" data-kid=\"2-1-2-2-1-2-1\" data-name=\"step number badge: 2\">2</span>Diet</a>\n<a class=\"step\" data-kid=\"2-1-2-2-1-3\" data-name=\"upcoming step link: Staples\" href=\"#\"><span class=\"step__n\" data-kid=\"2-1-2-2-1-3-1\" data-name=\"step number badge: 3\">3</span>Staples</a>\n<a class=\"step\" data-kid=\"2-1-2-2-1-4\" data-name=\"upcoming step link: Cooking state\" href=\"#\"><span class=\"step__n\" data-kid=\"2-1-2-2-1-4-1\" data-name=\"step number badge: 4\">4</span>Cooking state</a>\n</div></nav>\n<main class=\"frame page\" data-kid=\"2-1-2-3\">\n<header class=\"shelf\" data-kid=\"2-1-2-3-1\" data-name=\"page heading shelf\">\n<div class=\"shelf__label\" data-kid=\"2-1-2-3-1-1\" data-name=\"tilted shelf label card\">\n<h1 class=\"shelf__h\" data-kid=\"2-1-2-3-1-1-1\" data-name=\"page heading: Diet\">Diet</h1>\n<p class=\"shelf__facts\" data-kid=\"2-1-2-3-1-1-2\" data-name=\"shelf supporting fact text\">Required before the first cook</p>\n</div>\n</header>\n<form class=\"surface\" data-kid=\"2-1-2-3-2\" data-name=\"diet edit form surface card\">\n<div class=\"split\" data-kid=\"2-1-2-3-2-1\" data-name=\"two-column edit split container\">\n<div class=\"stack\" data-kid=\"2-1-2-3-2-1-1\" data-name=\"left column edit stack\">\n<div class=\"field\" data-kid=\"2-1-2-3-2-1-1-1\" data-name=\"diet name text field\">\n<label class=\"lb\" data-kid=\"2-1-2-3-2-1-1-1-1\" data-name=\"Diet name field label\" for=\"b3-name\">Diet name</label>\n<input class=\"input\" data-kid=\"2-1-2-3-2-1-1-1-2\" data-name=\"Diet name input value field\" id=\"b3-name\" type=\"text\" value=\"Home\"/>\n</div>\n<fieldset class=\"field\" data-kid=\"2-1-2-3-2-1-1-2\" data-name=\"diet flags fieldset\">\n<legend class=\"lb\" data-kid=\"2-1-2-3-2-1-1-2-1\" data-name=\"Flags fieldset legend\">Flags</legend>\n<div class=\"flags\" data-kid=\"2-1-2-3-2-1-1-2-2\" data-name=\"flags checkbox group container\">\n<label class=\"flag\" data-kid=\"2-1-2-3-2-1-1-2-2-1\" data-name=\"vegan diet flag checkbox\"><input data-kid=\"2-1-2-3-2-1-1-2-2-1-1\" data-name=\"vegan checkbox input\" type=\"checkbox\"/>vegan</label>\n<label class=\"flag\" data-kid=\"2-1-2-3-2-1-1-2-2-2\" data-name=\"vegetarian diet flag checkbox\"><input checked=\"\" data-kid=\"2-1-2-3-2-1-1-2-2-2-1\" data-name=\"vegetarian checkbox input (checked)\" type=\"checkbox\"/>vegetarian</label>\n<label class=\"flag\" data-kid=\"2-1-2-3-2-1-1-2-2-3\" data-name=\"gluten free diet flag checkbox\"><input data-kid=\"2-1-2-3-2-1-1-2-2-3-1\" data-name=\"gluten free checkbox input\" type=\"checkbox\"/>gluten free</label>\n</div>\n</fieldset>\n<figure class=\"rec\" data-kid=\"2-1-2-3-2-1-1-3\" data-name=\"flag consequence example figure\">\n<p class=\"rec__h\" data-kid=\"2-1-2-3-2-1-1-3-1\" data-name=\"example caption heading\">Example</p>\n<div class=\"rec__lines\" data-kid=\"2-1-2-3-2-1-1-3-2\" data-name=\"example consequence lines\">\n<p class=\"line\" data-kid=\"2-1-2-3-2-1-1-3-2-1\" data-name=\"excluded ingredient line example\"><span class=\"line__n line__n--out\" data-kid=\"2-1-2-3-2-1-1-3-2-1-1\" data-name=\"excluded ingredient name (crossed)\">chicken</span><span class=\"lead\" data-kid=\"2-1-2-3-2-1-1-3-2-1-2\" data-name=\"dotted leader connector\"></span><span class=\"line__s\" data-kid=\"2-1-2-3-2-1-1-3-2-1-3\" data-name=\"consequence reason: breaks vegetarian\">breaks vegetarian</span></p>\n<p class=\"line\" data-kid=\"2-1-2-3-2-1-1-3-2-2\" data-name=\"kept ingredient line example\"><span class=\"line__n\" data-kid=\"2-1-2-3-2-1-1-3-2-2-1\" data-name=\"kept ingredient name: firm tof