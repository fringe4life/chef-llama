:0\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-2\" data-name=\"servings peg at 2\" style=\"--at:9.0909\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-3\" data-name=\"servings peg at 3\" style=\"--at:18.1818\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-4\" data-name=\"servings peg at 4\" style=\"--at:27.2727\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-5\" data-name=\"servings peg at 5\" style=\"--at:36.3636\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-6\" data-name=\"servings peg at 6\" style=\"--at:45.4545\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-7\" data-name=\"servings peg at 7\" style=\"--at:54.5455\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-8\" data-name=\"servings peg at 8\" style=\"--at:63.6364\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-9\" data-name=\"servings peg at 9\" style=\"--at:72.7273\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-10\" data-name=\"servings peg at 10\" style=\"--at:81.8182\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-11\" data-name=\"servings peg at 11\" style=\"--at:90.9091\"></span><span class=\"peg\" data-kid=\"4-3-2-1-1-3-1-2-12\" data-name=\"servings peg at 12\" style=\"--at:100\"></span></span>\n<span class=\"fill\" data-kid=\"4-3-2-1-1-3-1-3\" data-name=\"servings progress fill bar\"></span>\n<span class=\"edge\" data-kid=\"4-3-2-1-1-3-1-4\" data-name=\"servings slider edge indicator\"></span>\n</div>\n<input aria-label=\"Servings\" class=\"rng\" data-kid=\"4-3-2-1-1-3-2\" data-name=\"servings range input\" max=\"12\" min=\"1\" oninput=\"rail(this)\" step=\"1\" type=\"range\" value=\"4\"/>\n</div>\n<div class=\"scale\" data-kid=\"4-3-2-1-1-4\" data-name=\"servings numeric scale row\">\n<span class=\"mark\" data-kid=\"4-3-2-1-1-4-1\" data-name=\"servings scale mark: 1\" style=\"--at:0\">1</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-1-4-2\" data-name=\"servings scale mark: 4\" style=\"--at:27.2727\">4</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-1-4-3\" data-name=\"servings scale mark: 7\" style=\"--at:54.5455\">7</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-1-4-4\" data-name=\"servings scale mark: 10\" style=\"--at:81.8182\">10</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-1-4-5\" data-name=\"servings scale mark: 12\" style=\"--at:100\">12</span>\n</div>\n</div>\n<div class=\"ctl\" data-ctl=\"\" data-kid=\"4-3-2-1-2\" data-name=\"kcal per serving slider control\" style=\"--p:44.4444%\">\n<div class=\"caps\" data-kid=\"4-3-2-1-2-1\" data-name=\"kcal per serving caption label\">kcal per serving</div>\n<p class=\"fig\" data-kid=\"4-3-2-1-2-2\" data-name=\"kcal figure digit box\"><output data-dynamic=\"true\" data-kid=\"4-3-2-1-2-2-1\" data-name=\"kcal numeric readout\" data-reason=\"textContent replaced by rail() on every input\">700</output></p>\n<div class=\"trk\" data-kid=\"4-3-2-1-2-3\" data-name=\"kcal slider track frame\">\n<div class=\"trk__scale\" data-kid=\"4-3-2-1-2-3-1\" data-name=\"kcal track scale container\">\n<span class=\"rail\" data-kid=\"4-3-2-1-2-3-1-1\" data-name=\"kcal rail bar\"></span>\n<span class=\"fill\" data-kid=\"4-3-2-1-2-3-1-2\" data-name=\"kcal progress fill bar\"></span>\n<span class=\"edge\" data-kid=\"4-3-2-1-2-3-1-3\" data-name=\"kcal slider edge indicator\"></span>\n<span class=\"grads\" data-kid=\"4-3-2-1-2-3-1-4\" data-name=\"kcal graduated tick row\"></span>\n<span class=\"grads grads--in\" data-kid=\"4-3-2-1-2-3-1-5\" data-name=\"kcal filled graduated tick row\"></span>\n</div>\n<input aria-label=\"kcal per serving\" class=\"rng\" data-kid=\"4-3-2-1-2-3-2\" data-name=\"kcal range input\" max=\"1200\" min=\"300\" oninput=\"rail(this)\" step=\"50\" type=\"range\" value=\"700\"/>\n</div>\n<div class=\"scale\" data-kid=\"4-3-2-1-2-4\" data-name=\"kcal scale row\">\n<span class=\"mark\" data-kid=\"4-3-2-1-2-4-1\" data-name=\"kcal scale mark: 300\" style=\"--at:0\">300</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-2-4-2\" data-name=\"kcal scale mark: light\" style=\"--at:16.6667\">Light</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-2-4-3\" data-name=\"kcal scale mark: standard\" style=\"--at:44.4444\">Standard</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-2-4-4\" data-name=\"kcal scale mark: hearty\" style=\"--at:77.7778\">Hearty</span>\n<span class=\"mark\" data-kid=\"4-3-2-1-2-4-5\" data-name=\"kcal scale mark: 1200\" style=\"--at:100\">1200</span>\n</div>\n</div>\n</div>\n<p class=\"rule\" data-kid=\"4-3-2-2\" data-name=\"rule note about hard limits vs kcal target\"><b data-kid=\"4-3-2-2-1\" data-name=\"rule emphasized clause\">Requirements and allergies are hard limits.</b> kcal is a target.</p>\n<aside class=\"consequence\" data-kid=\"4-3-2-3\" data-name=\"consequence explainer aside\">\n<p class=\"caps\" data-kid=\"4-3-2-3-1\" data-name=\"consequence caption: what this changes\">What this changes</p>\n<p class=\"consequence__text\" data-kid=\"4-3-2-3-2\" data-name=\"consequence explanation text\">The Recipe keeps the dish and swaps the ingredient.</p>\n<figure class=\"swap\" data-kid=\"4-3-2-3-3\" data-name=\"ingredient swap figure\">\n<span data-kid=\"4-3-2-3-3-1\" data-name=\"swap source ingredient (chicken)\">chicken</span>\n<span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"4-3-2-3-3-2\" data-name=\"swap arrow\">→</span>\n<span data-kid=\"4-3-2-3-3-3\" data-name=\"swap target ingredient (firm tofu)\">firm tofu</span>\n<figcaption class=\"swap__why\" data-kid=\"4-3-2-3-3-4\" data-name=\"swap reason caption: breaks vegan\">breaks vegan</figcaption>\n</figure>\n</aside>\n</div>\n</div>\n<div class=\"actions\" data-kid=\"4-4\" data-name=\"page action buttons row\">\n<button class=\"btn btn--quiet\" data-kid=\"4-4-1\" data-name=\"back button\" type=\"button\">Back</button>\n<button class=\"btn btn--primary\" data-kid=\"4-4-2\" data-name=\"save diet primary button\" type=\"button\">Save Diet</button>\n</div>\n</main>\n<script>\nfunction rail(el){\n  var c = el.closest('[data-ctl]');\n  var v = +el.value, lo = +el.min, hi = +el.max;\n  c.style.setProperty('--p', ((v - lo) / (hi - lo) * 100) + '%');\n  c.querySelector('output').textContent = v;\n}\n</script>",
