    "var_9995c829f278": {
      "type": "variant",
      "label": "A2 — Four steps, explanation in the margin",
      "parentId": "var_4f55a0ab37af",
      "themeId": null,
      "rect": {
        "x": 4460,
        "y": 0,
        "w": 1160,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --accent-text: color-mix(in oklab, var(--accent) 60%, var(--foreground));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-10: calc(var(--spacing) * 10);\n  --space-12: calc(var(--spacing) * 12);\n  --space-16: calc(var(--spacing) * 16);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n\n  --food: color-mix(in oklab, var(--primary) 68%, var(--foreground));\n  --leaf: var(--accent-text);\n  --steam: color-mix(in oklab, var(--foreground) 52%, var(--background));\n  /* the oven door paints this over its food, so it must track the surface under it */\n  --surface: var(--card);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--secondary); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,dl,dd,fieldset,legend,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; }\nbutton{ font: inherit; color: inherit; }\n:is(a,button,input,label):focus-visible{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.sr-only{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.label{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.frame{ box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n\n.board{ display: grid; gap: var(--space-10); padding: var(--space-10) var(--space-8) var(--space-16); }\n@media (width >= 64rem){ .board{ padding: var(--space-12) var(--space-10) var(--space-16); } }\n.flow{ display: grid; gap: var(--space-2); }\n.screen{ display: grid; overflow: hidden; background: var(--background); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); container-type: inline-size; }\n\n.bar{ border-block-end: var(--border-width-thin) solid var(--border); }\n.bar .frame{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); block-size: 60px; }\n.lockup{ display: flex; align-items: center; gap: var(--space-2); text-decoration: none; color: inherit; }\n.mk{ display: block; flex: none; }\n.mk-crown{ fill: var(--accent); }\n.mk-band{ fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n.mk-head{ fill: var(--primary); }\n.mk-eye{ fill: var(--primary-foreground); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-tight); }\n.nav{ display: none; align-items: center; gap: var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n@media (width >= 48rem){ .nav{ display: flex; } }\n\n.steps{ border-block-end: var(--border-width-thin) solid var(--border); background: color-mix(in oklab, var(--primary) 9%, var(--background)); }\n.steps .frame{ display: flex; align-items: stretch; gap: var(--space-5); overflow-x: auto; }\n.step{ display: flex; align-items: center; gap: var(--space-2); block-size: 48px; padding-block-start: 2px; font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none; border-block-end: var(--border-width-medium) solid transparent; white-space: nowrap; }\n.step__n{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-2xs); }\n.step[aria-current=\"step\"]{ color: var(--foreground); font-weight: 700; border-block-end-color: var(--primary); }\n.step--done{ color: var(--foreground); }\n.step--done .step__n{ color: var(--accent-text); }\n\n.page{ display: grid; gap: var(--space-6); padding-block: var(--space-3) var(--space-8); }\n/* the section header: paper laid on the boundary, barely off level */\n.shelf{ position: relative; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-block-start: calc(var(--space-2) * -1); }\n.shelf__label{ position: relative; z-index: 4; display: inline-grid; gap: 2px; padding: var(--space-3) var(--space-5); background: var(--card); border-radius: 2px; transform: rotate(-1deg); box-shadow: 3px 4px 0 color-mix(in oklab, var(--foreground) 13%, transparent); }\n.shelf__h{ font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.shelf__facts{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.count{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n\n/* control + the column that says what it changes */\n.split{ display: grid; gap: var(--space-5); align-items: start; }\n@container (inline-size >= 880px){ .split{ grid-template-columns: minmax(0,1fr) 296px; column-gap: var(--space-8); } }\n.panel{ display: grid; gap: var(--space-5); padding: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n.field__head{ display: grid; gap: 2px; }\n.field__label{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.field__hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n\n.why{ display: grid; gap: var(--space-4); padding-inline-start: var(--space-5); border-inline-start: var(--border-width-thin) solid var(--border); }\n.why__label{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.why__text{ font-size: var(--text-sm); line-height: var(--leading-body); }\n.why__text b{ font-weight: 700; }\n.ex{ display: grid; gap: var(--space-2); padding: var(--space-3); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: var(--card); }\n.ex__row{ display: flex; align-items: center; gap: var(--space-2); }\n.ex__k{ font-size: var(--text-xs); font-weight: 700; }\n.ex__v{ margin-inline-start: auto; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-2xs); color: var(--muted-foreground); white-space: nowrap; }\n.ex__note{ font-size: var(--text-2xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n\n/* devices: an inventory, not an order */\n.rail{ display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: var(--space-2); }\n.in{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.tile{\n  position: relative; display: grid; justify-items: center; align-content: start; gap: var(--space-1);\n  min-block-size: 100px; padding: var(--space-3) var(--space-2);\n  border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm);\n  background: var(--card); color: var(--foreground); cursor: pointer;\n  transition: background-color 140ms linear, border-color 140ms linear, transform 110ms cubic-bezier(0.23,1,0.32,1);\n  --surface: var(--card);\n}\n.tile__name{ font-size: var(--text-2xs); line-height: var(--leading-tight); text-align: center; }\n.tile:hover{ background: var(--secondary); border-color: color-mix(in oklab, var(--border) 48%, var(--foreground)); --surface: var(--secondary); }\n.in:focus-visible + .tile{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.tile:active{ transform: translateY(1px); background: var(--muted); --surface: var(--muted); }\n.in:checked + .tile{ background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); --surface: var(--primary); --food: color-mix(in oklab, var(--background) 84%, var(--primary)); --leaf: var(--accent); --steam: color-mix(in oklab, var(--primary-foreground) 76%, var(--primary)); }\n\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n.ic{ position: relative; display: block; --sw: 1.4; --sw-s: 1.15; }\n.lay{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }\n.ic48{ inline-size: 48px; block-size: 48px; }\n.ic20{ inline-size: 20px; block-size: 20px; --sw: 2.1; --sw-s: 1.8; }\n.ic16{ inline-size: 16px; block-size: 16px; --sw: 2.55; --sw-s: 2.2; }\n.ic16 .d{ display: none; }\n.ic16 .tend{ display: none; }\n.part{ transform-origin: var(--org, 50% 50%); transition: transform 320ms cubic-bezier(0.23,1,0.32,1); }\n.tend{ opacity: 0; transition: opacity 140ms linear; }\n\n/* one pose per device, reached only when the device is chosen */\n.m-fry{ --mv: translateY(-9%); }\n.m-sauce{ --mv: translateY(-13%); }\n.m-oven{ --mv: scaleY(0.34); --org: 50% 100%; }\n.m-air{ --mv: translateY(7%); }\n.m-slow{ --mv: translateY(-10%); }\n.m-press{ --mv: translateY(-2.5%); }\n.m-grill{ --mv: translateY(-8%); }\n.m-nocook{ --mv: translateY(-6%) rotate(5deg); --org: 50% 90%; }\n\n.in:checked + .tile .part{ transform: var(--mv); }\n.in:checked + .tile .tend{ animation: rise 1500ms cubic-bezier(0.2, 0.6, 0.3, 1) 1 both; }\n.tile:active .part{ transform: none; }\n\n/* steam rises and fades. It never comes back down. */\n@keyframes rise{\n  0%{ transform: translateY(8%) scaleY(0.86); opacity: 0; }\n  22%{ opacity: 0.62; }\n  100%{ transform: translateY(-22%) scaleY(1.12); opacity: 0; }\n}\n\n.actions{ display: flex; align-items: center; justify-content: flex-end; gap: var(--space-3); }\n.actions--split{ justify-content: space-between; }\n.btn{ display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-block-size: 44px; padding: 0 var(--space-5); border-radius: var(--radius-md); border: var(--border-width-thin) solid var(--border); background: var(--card); font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); cursor: pointer; transition: background-color 120ms linear, transform 120ms cubic-bezier(0.23,1,0.32,1); }\n.btn:hover{ background: var(--muted); }\n.btn:active{ transform: translateY(1px); }\n.btn--primary{ border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n.btn--primary:hover{ background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n.btn--quiet{ border-color: transparent; background: transparent; color: var(--muted-foreground); font-weight: 400; }\n.btn--quiet:hover{ background: var(--muted); color: var(--foreground); }\n.x{ display: block; flex: none; }\n\n/* diet */\n.diet{ display: grid; gap: var(--space-6); }\n@container (inline-size >= 640px){ .diet{ grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); column-gap: var(--space-6); } }\n.diet__col{ display: grid; gap: var(--space-4); align-content: start; }\n@container (inline-size >= 640px){ .diet__col--right{ padding-inline-start: var(--space-5); border-inline-start: var(--border-width-thin) solid var(--border); } }\n.f{ display: grid; gap: var(--space-2); }\n.f__label{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.input{ inline-size: 100%; min-block-size: 44px; padding: 0 var(--space-3); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); }\n.flag{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); }\n.flag input{ inline-size: 16px; block-size: 16px; margin: 0; accent-color: var(--primary-text); }\n.row{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }\n.row__k{ font-size: var(--text-sm); white-space: nowrap; }\n.row__k span{ margin-inline-start: var(--space-1); color: var(--muted-foreground); }\n.stepper{ display: flex; align-items: center; border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-md); background: var(--background); overflow: hidden; }\n.stepper button{ inline-size: 34px; block-size: 40px; border: 0; background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-base); }\n.stepper button:hover{ background: var(--muted); }\n.stepper output{ min-inline-size: 38px; text-align: center; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-sm); }\n.narrow{ inline-size: 104px; }\n.chipset{ display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.chip{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; padding: 0 var(--space-1) 0 var(--space-2); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: var(--background); font-size: var(--text-xs); line-height: var(--leading-solid); white-space: nowrap; }\n.chip__x{ display: grid; place-items: center; inline-size: 20px; block-size: 20px; padding: 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--muted-foreground); cursor: pointer; }\n.chip__x:hover{ color: var(--foreground); background: var(--muted); }\n.presets{ display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.pre{ display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 32px; padding: 0 var(--space-2); border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm); background: var(--background); font-size: var(--text-xs); cursor: pointer; }\n.pre input{ inline-size: 12px; block-size: 12px; margin: 0; accent-color: var(--primary-text); }\n.pre:has(input:checked){ background: var(--secondary); border-color: color-mix(in oklab, var(--border) 40%, var(--foreground)); font-weight: 700; }\n.rule{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }\n.rule b{ font-weight: 700; color: var(--foreground); }\n\n/* staples: the basics and your own on the left, the spice rack on the right */\n.staples{ display: grid; gap: var(--space-6); }\n@container (inline-size >= 720px){ .staples{ grid-template-columns: minmax(0,1fr) minmax(0,1.15fr); column-gap: var(--space-7); } }\n.staples__col{ display: grid; gap: var(--space-4); align-content: start; min-inline-size: 0; }\n.staples__group{ display: grid; gap: var(--space-2); min-inline-size: 0; }\n.spices{ display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); column-gap: var(--space-5); }\n.staple{ display: grid; grid-template-columns: 16px minmax(0,1fr); align-items: center; gap: var(--space-3); min-block-size: 44px; padding: 0 var(--space-2); border-block-end: var(--border-width-thin) solid var(--border); font-size: var(--text-sm); cursor: pointer; }\n.staple:first-of-type{ border-block-start: var(--border-width-thin) solid var(--border); }\n.staple input{ inline-size: 16px; block-size: 16px; margin: 0; accent-color: var(--primary-text); }\n.mine{ display: grid; gap: var(--space-2); }\n.mine__list{ display: grid; gap: var(--space-2); }\n.mine__chip{ display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-block-size: 36px; padding: 0 var(--space-1) 0 var(--space-3); border: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 46%, var(--border)); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--primary) 14%, var(--card)); font-size: var(--text-sm); }\n\n/* cooked / uncooked */\n.pairs{ display: grid; gap: var(--space-4); }\n@container (inline-size >= 720px){ .pairs{ grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: var(--space-6); } }\n.pair{ display: grid; gap: var(--space-2); padding: var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n.pair__name{ font-family: var(--font-display); font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.prow{ display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: var(--space-3); min-block-size: 44px; border-block-end: var(--border-width-thin) solid var(--border); }\n.prow:last-child{ border-block-end: 0; }\n.prow__method{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--foreground); }\n.prow__min{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n.chip--cooked{ background: color-mix(in oklab, var(--primary) 17%, var(--card)); border-color: color-mix(in oklab, var(--primary) 46%, var(--border)); --surface: color-mix(in oklab, var(--primary) 17%, var(--card)); --food: var(--primary-text); --leaf: var(--accent-text); --steam: color-mix(in oklab, var(--foreground) 40%, var(--background)); }\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" data-name=\"hidden SVG sprite of reusable icon symbols\" focusable=\"false\"><defs>\n<symbol id=\"b-fry\" viewbox=\"0 0 24 24\">\n<path d=\"M3.5 10.2a6.6 6.6 0 0 0 13.2 0\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"