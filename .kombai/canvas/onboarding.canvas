ame=\"chip label text for salt\">salt</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-2-3-1-4\" data-name=\"chip checked wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-2-3-1-4-1\" data-name=\"checked wash label text for salt\">salt</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-2-3-2\" data-name=\"chip allergen label for oil\"><input checked=\"\" data-kid=\"2-2-1-2-2-3-2-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-2-3-2-2\" data-name=\"chip check pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-2-3-2-2-1\" data-name=\"chip check pocket outline\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-2-3-2-2-2\" data-name=\"chip checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-2-3-2-2-3\" data-name=\"chip focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-2-3-2-3\" data-name=\"chip label text for oil\">oil</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-2-3-2-4\" data-name=\"chip checked wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-2-3-2-4-1\" data-name=\"checked wash label text for oil\">oil</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-2-3-3\" data-name=\"chip allergen label for pepper\"><input data-kid=\"2-2-1-2-2-3-3-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-2-3-3-2\" data-name=\"chip check pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-2-3-3-2-1\" data-name=\"chip check pocket outline\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-2-3-3-2-2\" data-name=\"chip checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-2-3-3-2-3\" data-name=\"chip focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-2-3-3-3\" data-name=\"chip label text for pepper\">pepper</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-2-3-3-4\" data-name=\"chip checked wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-2-3-3-4-1\" data-name=\"checked wash label text for pepper\">pepper</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-2-3-4\" data-name=\"chip allergen label for cumin\"><input data-kid=\"2-2-1-2-2-3-4-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-2-3-4-2\" data-name=\"chip check pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-2-3-4-2-1\" data-name=\"chip check pocket outline\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-2-3-4-2-2\" data-name=\"chip checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-2-3-4-2-3\" data-name=\"chip focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-2-3-4-3\" data-name=\"chip label text for cumin\">cumin</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-2-1-2-2-3-4-4\" data-name=\"chip checked wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-2-1-2-2-3-4-4-1\" data-name=\"checked wash label text for cumin\">cumin</span></span></label>\n<label class=\"chip\" data-kid=\"2-2-1-2-2-3-5\" data-name=\"chip allergen label for paprika\"><input data-kid=\"2-2-1-2-2-3-5-1\" type=\"checkbox\"/><span class=\"chip__slot\" data-kid=\"2-2-1-2-2-3-5-2\" data-name=\"chip check pocket slot\"><span class=\"chip__pocket\" data-kid=\"2-2-1-2-2-3-5-2-1\" data-name=\"chip check pocket outline\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-1-2-2-3-5-2-2\" data-name=\"chip checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg><span class=\"chip__ring\" data-kid=\"2-2-1-2-2-3-5-2-3\" data-name=\"chip focus ring overlay\"></span></span><span class=\"chip__name\" data-kid=\"2-2-1-2-2-3-5-3\" data-name=\"chip lab