    },
    "var_f6733f754ee0": {
      "type": "variant",
      "label": "Selection D1 — pocket line kept on the fill",
      "parentId": "var_7df99a16189d",
      "themeId": null,
      "rect": {
        "x": 25179,
        "y": 0,
        "w": 640,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --box-line: color-mix(in oklab, var(--input) 74%, var(--foreground));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --border-width-thin: 1px;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-caps: 0.14em;\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n}\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\n.wrap{ display: grid; justify-items: start; gap: var(--space-6); padding: var(--space-6) var(--space-5); }\n.chips{ display: flex; flex-wrap: wrap; gap: var(--space-2); }\n\n.chip{\n  --pad-x: var(--space-3);\n  --slot: 14px;\n  --gap: var(--space-2);\n  --surface: var(--card);\n  position: relative;\n  display: inline-flex; align-items: center; gap: var(--gap);\n  min-block-size: 32px; padding-inline: var(--pad-x);\n  border: var(--border-width-thin) solid var(--input); border-radius: var(--radius-sm);\n  background: var(--surface); color: var(--foreground);\n  font-size: var(--text-sm); line-height: var(--leading-solid); white-space: nowrap;\n  overflow: hidden;\n}\n.chip__name{ position: relative; z-index: 0; }\n.chip__slot{ position: relative; z-index: 2; flex: none; display: grid; place-items: center; inline-size: var(--slot); block-size: var(--slot); }\n.chip__pocket{\n  position: absolute; inset: 0;\n  background: var(--box-line);\n  clip-path: polygon(4% 2%, 98% 6%, 99% 94%, 2% 99%);\n}\n.chip__pocket::before{\n  content: \"\"; position: absolute; inset: 1px;\n  background: var(--surface);\n  clip-path: inherit;\n}\n.chip__tick{\n  position: absolute; z-index: 1;\n  inline-size: calc(var(--slot) - 3px); block-size: calc(var(--slot) - 3px);\n  color: var(--primary-foreground);\n  stroke-dasharray: 17; stroke-dashoffset: 17;\n  overflow: visible;\n}\n.chip__wash{\n  position: absolute; inset: 0; z-index: 1;\n  background: var(--primary);\n  clip-path: circle(0% at calc(var(--pad-x) + var(--slot) / 2) 50%);\n}\n.chip__wash-label{\n  position: absolute; inset-block: 0; inset-inline-start: calc(var(--pad-x) + var(--slot) + var(--gap));\n  display: flex; align-items: center;\n  color: var(--primary-foreground);\n}\n\n/* filled: the gold lands, the pocket line stays as an impression */\n.chip.is-filled{ border-color: var(--primary); }\n.chip.is-filled .chip__wash{ clip-path: circle(150% at calc(var(--pad-x) + var(--slot) / 2) 50%); }\n.chip.is-filled .chip__pocket{ background: color-mix(in oklab, var(--primary-foreground) 42%, var(--primary)); }\n.chip.is-filled .chip__pocket::before{ background: transparent; }\n.chip.is-filled .chip__tick{ stroke-dashoffset: 0; }\n.chip.is-off{ border-style: dashed; border-color: var(--input); background: transparent; color: var(--muted-foreground); }\n.chip.is-off .chip__pocket{ background: color-mix(in oklab, var(--input) 55%, transparent); }\n.chip.is-off .chip__pocket::before{ background: var(--background); }\n\n.pairs{ display: flex; align-items: flex-start; gap: var(--space-6); }\n.pair{ display: grid; justify-items: center; gap: var(--space-2); }\n.plate{ display: grid; place-items: center; inline-size: 112px; block-size: 80px; border-radius: var(--radius-sm); background: var(--primary); }\n.plate--off{ background: var(--card); border: var(--border-width-thin) solid var(--border); }\n.big-slot{ --surface: var(--background); position: relative; display: grid; place-items: center; inline-size: 56px; block-size: 56px; }\n.big-slot .chip__pocket{ background: var(--box-line); }\n.big-slot .chip__pocket::before{ background: var(--surface); }\n.big-slot .chip__tick{ inline-size: 40px; block-size: 40px; }\n.big-slot.is-on .chip__pocket{ background: color-mix(in oklab, var(--primary-foreground) 42%, var(--primary)); }\n.big-slot.is-on .chip__pocket::before{ background: transparent; }\n.big-slot.is-on .chip__tick{ stroke-dashoffset: 0; }\n.caption{ display: flex; gap: var(--space-2); }\n.k{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG symbol definitions\" focusable=\"false\" style=\"position:absolute;inline-size:0;block-size:0\"><defs>\n<symbol id=\"tick\" viewbox=\"0 0 12 12\">\n<path d=\"M2.4 6.6c1.2 1.2 2.4 2.4 3.5 3.6 2-3.1 4-6 5.5-7.7\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.1\"></path>\n</symbol>\n</defs></svg>\n<div class=\"wrap\" data-kid=\"2\" data-name=\"page layout container\">\n<div class=\"chips\" data-kid=\"2-1\" data-name=\"allergen chip list\">\n<span class=\"chip is-filled\" data-kid=\"2-1-1\" data-name=\"selected allergen chip (sesame)\"><span class=\"chip__slot\" data-kid=\"2-1-1-1\" data-name=\"chip check-slot container\"><span class=\"chip__pocket\" data-kid=\"2-1-1-1-1\" data-name=\"check-slot pocket background\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-1-1-1-2\" data-name=\"checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"2-1-1-2\" data-name=\"chip label text (sesame)\">sesame</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-1-1-3\" data-name=\"chip gold wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-1-1-3-1\" data-name=\"wash label text (sesame)\">sesame</span></span></span>\n<span class=\"chip is-filled\" data-kid=\"2-1-2\" data-name=\"selected allergen chip (peanut)\"><span class=\"chip__slot\" data-kid=\"2-1-2-1\" data-name=\"chip check-slot container\"><span class=\"chip__pocket\" data-kid=\"2-1-2-1-1\" data-name=\"check-slot pocket background\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-1-2-1-2\" data-name=\"checkmark tick icon\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"2-1-2-2\" data-name=\"chip label text (peanut)\">peanut</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-1-2-3\" data-name=\"chip gold wash overlay\"><span class=\"chip__wash-label\" data-kid=\"2-1-2-3-1\" data-name=\"wash label text (peanut)\">peanut</span></span></span>\n<span class=\"chip\" data-kid=\"2-1-3\" data-name=\"unselected allergen chip (milk)\"><span class=\"chip__slot\" data-kid=\"2-1-3-1\" data-name=\"chip check-slot container\"><span class=\"chip__pocket\" data-kid=\"2-1-3-1-1\" data-name=\"check-slot pocket background\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-1-3-1-2\" data-name=\"checkmark tick icon (hidden)\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"2-1-3-2\" data-name=\"chip label text (milk)\">milk</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-1-3-3\" data-name=\"chip gold wash overlay (collapsed)\"><span class=\"chip__wash-label\" data-kid=\"2-1-3-3-1\" data-name=\"wash label text (milk)\">milk</span></span></span>\n<span class=\"chip is-off\" data-kid=\"2-1-4\" data-name=\"disabled/off allergen chip (mollusc)\"><span class=\"chip__slot\" data-kid=\"2-1-4-1\" data-name=\"chip check-slot container\"><span class=\"chip__pocket\" data-kid=\"2-1-4-1-1\" data-name=\"check-slot pocket background\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-1-4-1-2\" data-name=\"checkmark tick icon (hidden)\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span><span class=\"chip__name\" data-kid=\"2-1-4-2\" data-name=\"chip label text (mollusc)\">mollusc</span><span aria-hidden=\"true\" class=\"chip__wash\" data-kid=\"2-1-4-3\" data-name=\"chip wash overlay (collapsed)\"><span class=\"chip__wash-label\" data-kid=\"2-1-4-3-1\" data-name=\"wash label text (mollusc)\">mollusc</span></span></span>\n</div>\n<div class=\"pairs\" data-kid=\"2-2\" data-name=\"state plate comparison row\">\n<span class=\"pair\" data-kid=\"2-2-1\" data-name=\"off-state plate pair\"><span class=\"plate plate--off\" data-kid=\"2-2-1-1\" data-name=\"off-state plate background\"><span class=\"big-slot\" data-kid=\"2-2-1-1-1\" data-name=\"off-state check slot (inactive)\"><span class=\"chip__pocket\" data-kid=\"2-2-1-1-1-1\" data-name=\"slot pocket background\"></span></span></span><span class=\"caption\" data-kid=\"2-2-1-2\" data-name=\"off-state caption labels\"><span class=\"k\" data-kid=\"2-2-1-2-1\" data-name=\"state label (Off)\">Off</span><span class=\"k\" data-kid=\"2-2-1-2-2\" data-name=\"percentage label (4×)\">4×</span></span></span>\n<span class=\"pair\" data-kid=\"2-2-2\" data-name=\"on-state plate pair\"><span class=\"plate\" data-kid=\"2-2-2-1\" data-name=\"active on-state plate background\"><span class=\"big-slot is-on\" data-kid=\"2-2-2-1-1\" data-name=\"on-state check slot (active)\"><span class=\"chip__pocket\" data-kid=\"2-2-2-1-1-1\" data-name=\"slot pocket background\"></span><svg aria-hidden=\"true\" class=\"chip__tick\" data-kid=\"2-2-2-1-1-2\" data-name=\"checkmark tick icon (revealed)\" viewbox=\"0 0 12 12\"><use href=\"#tick\"></use></svg></span></span><span class=\"caption\" data-kid=\"2-2-2-2\" data-name=\"on-state caption labels\"><span class=\"k\" data-kid=\"2-2-2-2-1\" data-name=\"state label (On)\">On</span><span class=\"k\" data-kid=\"2-2-2-2-2\" data-name=\"percentage label (4×)\">4×</span></span></span>\n</div>\n</div>",
      "comments": [],
