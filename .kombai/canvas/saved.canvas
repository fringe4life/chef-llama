      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n    --destructive-foreground: light-dark(oklch(0.985 0.014 95), oklch(0.190 0.045 20));\n    --chart-gift: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --chart-credit: light-dark(oklch(0.430 0.150 15), oklch(0.560 0.135 15));\n    --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n    --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n    --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n    --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n    --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n    --border-width-thick: 3px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n  }\n\n  /* page frame — docs/theme.md#page-frame */\n  :root { --page-measure: 72rem; --space-page: var(--space-5); }\n  @media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n  * { box-sizing: border-box; }\n\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-sm);\n    line-height: var(--leading-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, p, ol, ul, dl, dd, dt { margin: 0; }\n  ul, ol { padding: 0; list-style: none; }\n  a { color: inherit; }\n  button { font: inherit; }\n  a:focus-visible, button:focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; border-radius: 2px; }\n\n  .wrap {\n    box-sizing: border-box;\n    inline-size: 100%;\n    max-inline-size: calc(var(--page-measure) + var(--space-page) * 2);\n    margin-inline: auto;\n    padding-inline: var(--space-page);\n  }\n\n  .label {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    line-height: var(--leading-ui);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n\n  /* app chrome */\n  .app-header { border-block-end: var(--border-width-thin) solid var(--border); }\n  .app-header .deck {\n    display: flex;\n    align-items: center;\n    gap: var(--space-6);\n    block-size: 72px;\n  }\n  .lockup {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--space-3);\n    text-decoration: none;\n  }\n  .mk { display: block; flex: none; overflow: visible; }\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  .wordmark {\n    font-family: var(--font-display);\n    font-size: var(--text-xl);\n    font-weight: 400;\n    line-height: var(--leading-solid);\n    letter-spacing: var(--tracking-display);\n  }\n  .app-nav {\n    margin-inline-start: auto;\n    display: flex;\n    align-items: center;\n    gap: var(--space-7);\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n  }\n  .app-nav a {\n    padding-block: var(--space-2);\n    color: var(--muted-foreground);\n    text-decoration: none;\n    border-block-end: var(--border-width-medium) solid transparent;\n    transition: color 130ms linear, border-color 130ms linear;\n  }\n  .app-nav a:hover { color: var(--foreground); }\n  .app-nav a[aria-current=\"page\"] {\n    color: var(--foreground);\n    font-weight: 700;\n    border-block-end-color: var(--primary);\n  }\n\n  /* page head */\n  .page-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: var(--space-2) var(--space-6);\n    padding-block: var(--space-9) var(--space-6);\n  }\n  .page-head h1 {\n    font-family: var(--font-display);\n    font-size: var(--text-2xl);\n    font-weight: 400;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-display);\n  }\n  .page-head .count { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  /* the returned recipe */\n  .added {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: start;\n    gap: var(--space-2) var(--space-6);\n    min-block-size: 112px;\n    padding: var(--space-5) var(--space-6);\n    border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 38%, var(--border));\n    border-radius: var(--radius-lg);\n    background: color-mix(in oklab, var(--accent) 13%, var(--card));\n  }\n  .added__label {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--space-2);\n    color: color-mix(in oklab, var(--accent) 62%, var(--foreground));\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n  }\n  .added__check { display: block; color: color-mix(in oklab, var(--accent) 70%, var(--foreground)); }\n  .added__back {\n    font-size: var(--text-xs);\n    color: color-mix(in oklab, var(--foreground) 82%, var(--background));\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 3px;\n  }\n  .added__back:hover { color: var(--foreground); text-decoration-thickness: 2px; }\n  .added__main {\n    grid-column: 1 / -1;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: var(--space-2) var(--space-6);\n    margin-block-start: var(--space-1);\n  }\n  .added__title {\n    font-family: var(--font-display);\n    font-size: var(--text-xl);\n    font-weight: 400;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-display);\n  }\n  .added__title a { text-decoration: none; }\n  .added__title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }\n  .added__facts {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: var(--space-2) var(--space-5);\n  }\n  .added__facts .fact { display: flex; align-items: baseline; gap: var(--space-2); }\n  .added__facts dt {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: color-mix(in oklab, var(--foreground) 68%, var(--background));\n  }\n  .added__facts dd { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-sm); line-height: var(--leading-solid); }\n  .added__flags { display: flex; flex-wrap: wrap; gap: var(--space-2); }\n\n  .flag {\n    display: inline-flex;\n    align-items: center;\n    min-block-size: 22px;\n    padding-inline: var(--space-2);\n    border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 30%, var(--border));\n    border-radius: var(--radius-sm);\n    background: color-mix(in oklab, var(--accent) 9%, var(--card));\n    color: color-mix(in oklab, var(--accent) 58%, var(--foreground));\n    font-size: var(--text-xs);\n    line-height: var(--leading-solid);\n    white-space: nowrap;\n  }\n\n  /* the index */\n  .list {\n    inline-size: 100%;\n    margin-block-start: var(--space-8);\n    border-collapse: separate;\n    border-spacing: 0;\n    table-layout: fixed;\n    font-size: var(--text-sm);\n  }\n  .list caption { text-align: start; }\n  .list col.c-title { inline-size: auto; }\n  .list col.c-min { inline-size: 96px; }\n  .list col.c-serv { inline-size: 96px; }\n  .list col.c-kcal { inline-size: 150px; }\n  .list col.c-flags { inline-size: 208px; }\n  .list thead th {\n    padding: 0 var(--space-3) var(--space-3);\n    border-block-end: var(--border-width-thin) solid var(--border);\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    font-weight: 400;\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n    text-align: start;\n    white-space: nowrap;\n  }\n  .list thead th:first-child { padding-inline-start: 0; }\n  .list thead th.num { text-align: end; }\n  .list tbody th { font-weight: 400; text-align: start; padding-inline-start: 0; }\n  .list tbody td, .list tbody th { padding: var(--space-5) var(--space-3); vertical-align: baseline; }\n  .list tbody tr > :first-child { padding-inline-start: 0; }\n  .list tbody tr { border: 0; }\n  .list tbody tr:hover td, .list tbody tr:hover th { background: color-mix(in oklab, var(--primary) 7%, var(--background)); }\n  .list tbody tr:hover td:first-child, .list tbody tr:hover th:first-child { border-start-start-radius: var(--radius-md); border-end-start-radius: var(--radius-md); }\n  .list tbody tr:hover td:last-child { border-start-end-radius: var(--radius-md); border-end-end-radius: var(--radius-md); }\n  .list tbody tr:first-child td, .list tbody tr:first-child th { padding-block-start: var(--space-6); }\n  .list .title {\n    font-family: var(--font-display);\n    font-size: var(--text-lg);\n    font-weight: 400;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-display);\n  }\n  .list .title a { text-decoration: none; }\n  .list .title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }\n  .list .num {\n    font-family: var(--font-mono);\n    font-variant-numeric: tabular-nums;\n    font-size: var(--text-sm);\n    letter-spacing: var(--tracking-display);\n    text-align: end;\n    white-space: nowrap;\n  }\n  .list .flags { display: flex; flex-wrap: wrap; gap: var(--space-2); }\n  .page-foot { padding-block: var(--space-12) var(--space-16); }\n\n  .sr-only {\n    position: absolute;\n    inline-size: 1px;\n    block-size: 1px;\n    overflow: hidden;\n    clip-path: inset(50%);\n    white-space: nowrap;\n  }\n</style>\n<div data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"app-header\" data-kid=\"1-1\" data-name=\"app header bar with bottom border\">\n<div class=\"wrap deck\" data-kid=\"1-1-1\" data-name=\"header content row with logo and nav\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1\" data-name=\"brand logo lockup link to home\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1\" data-name=\"llama mascot logo illustration\" height=\"32\" viewbox=\"0 0 32 32\" width=\"32\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"App\" class=\"app-nav\" data-kid=\"1-1-1-2\" data-name=\"main app navigation\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to pantry\" href=\"/pantry\">Pantry</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to saved (current page)\" href=\"/saved\">Saved</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to account\" href=\"/account\">Account</a>\n</nav>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"page-head\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page title\">Saved</h1>\n<p class=\"count\" data-kid=\"1-2-1-2\" data-name=\"recipe count label\">7 recipes</p>\n</div>\n<section aria-labelledby=\"added-title\" class=\"added\" data-kid=\"1-2-2\" data-name=\"added recipe confirmation card\">\n<p class=\"added__label\" data-kid=\"1-2-2-1\" data-name=\"added status label\">\n<svg aria-hidden=\"true\" class=\"added__check\" data-kid=\"1-2-2-1-1\" data-name=\"checkmark confirmation icon\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\">\n<path d=\"M1.6 6.2 4.4 9 10.4 3\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\"></path>\n</svg>\n        Added to Saved\n      </p>\n<a class=\"added__back\" data-kid=\"1-2-2-2\" data-name=\"back-to-recipe link\" href=\"/recipes/miso-noodles-bok-choy\">Back to the recipe</a>\n<div class=\"added__main\" data-kid=\"1-2-2-3\" data-name=\"recipe summary row\">\n<h2 class=\"added__title\" data-kid=\"1-2-2-3-1\" data-name=\"recipe title heading\" id=\"added-title\"><a data-kid=\"1-2-2-3-1-1\" data-name=\"recipe title link to detail\" href=\"/recipes/miso-noodles-bok-choy\">Miso noodles with bok choy</a></h2>\n<dl class=\"added__facts\" data-kid=\"1-2-2-3-2\" data-name=\"recipe facts definition list\">\n<div class=\"fact\" data-kid=\"1-2-2-3-2-1\" data-name=\"recipe minutes fact\"><dt data-kid=\"1-2-2-3-2-1-1\" data-name=\"minutes term label\">Minutes</dt><dd data-kid=\"1-2-2-3-2-1-2\" data-name=\"minutes value\">18</dd></div>\n<div class=\"fact\" data-kid=\"1-2-2-3-2-2\" data-name=\"servings fact\"><dt data-kid=\"1-2-2-3-2-2-1\" data-name=\"servings term label\">Servings</dt><dd data-kid=\"1-2-2-3-2-2-2\" data-name=\"servings value\">2</dd></div>\n<div class=\"fact\" data-kid=\"1-2-2-3-2-3\" data-name=\"calories per serving fact\"><dt data-kid=\"1-2-2-3-2-3-1\" data-name=\"calories term label\">Kcal per serving</dt><dd data-kid=\"1-2-2-3-2-3-2\" data-name=\"calories value\">460</dd></div>\n</dl>\n<p class=\"added__flags\" data-kid=\"1-2-2-3-3\" data-name=\"recipe dietary flags container\"><span class=\"flag\" data-kid=\"1-2-2-3-3-1\" data-name=\"dietary flag chip (vegan)\">vegan</span></p>\n</div>\n</section>\n<table class=\"list\" data-kid=\"1-2-3\" data-name=\"saved recipes index table\">\n<caption class=\"sr-only\" data-kid=\"1-2-3-1\" data-name=\"screen-reader-only table caption\">Saved recipes</caption>\n<colgroup data-kid=\"1-2-3-2\" data-name=\"table column definitions\">\n<col class=\"c-title\" data-kid=\"1-2-3-2-1\" data-name=\"recipe title column definition\"/>\n<col class=\"c-min\" data-kid=\"1-2-3-2-2\" data-name=\"minutes column definition\"/>\n<col class=\"c-serv\" data-kid=\"1-2-3-2-3\" data-name=\"servings column definition\"/>\n<col class=\"c-kcal\" data-kid=\"1-2-3-2-4\" data-name=\"calories column definition\"/>\n<col class=\"c-flags\" data-kid=\"1-2-3-2-5\" data-name=\"flags column definition\"/>\n</colgroup>\n<thead data-kid=\"1-2-3-3\" data-name=\"table header row\">\n<tr data-kid=\"1-2-3-3-1\" data-name=\"table header cells row\">\n<th data-kid=\"1-2-3-3-1-1\" data-name=\"recipe column header\" scope=\"col\">Recipe</th>\n<th class=\"num\" data-kid=\"1-2-3-3-1-2\" data-name=\"minutes column header\" scope=\"col\">Minutes</th>\n<th class=\"num\" data-kid=\"1-2-3-3-1-3\" data-name=\"servings column header\" scope=\"col\">Servings</th>\n<th class=\"num\" data-kid=\"1-2-3-3-1-4\" data-name=\"calories column header\" scope=\"col\">Kcal per serving</th>\n<th data-kid=\"1-2-3-3-1-5\" data-name=\"flags column header\" scope=\"col\">Flags</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-3-4\" data-name=\"table body with recipe rows\">\n<tr data-kid=\"1-2-3-4-1\" data-name=\"tofu fried rice recipe row\">\n<th class=\"title\" data-kid=\"1-2-3-4-1-1\" data-name=\"tofu fried rice title cell\" scope=\"row\"><a data-kid=\"1-2-3-4-1-1-1\" data-name=\"tofu fried rice link\" href=\"/recipes/tofu-fried-rice\">Tofu fried rice</a></th>\n<td class=\"num\" data-kid=\"1-2-3-4-1-2\" data-name=\"tofu fried rice minutes cell\">25</td>\n<td class=\"num\" data-kid=\"1-2-3-4-1-3\" data-name=\"tofu fried rice servings cell\">2</td>\n<td class=\"num\" data-kid=\"1-2-3-4-1-4\" data-name=\"tofu fried rice calories cell\">480</td>\n<td data-kid=\"1-2-3-4-1-5\" data-name=\"tofu fried rice flags cell\"><span class=\"flags\" data-kid=\"1-2-3-4-1-5-1\" data-name=\"tofu fried rice flag chips\"><span class=\"flag\" data-kid=\"1-2-3-4-1-5-1-1\" data-name=\"dietary flag chip (vegan)\">vegan</span><span class=\"flag\" data-kid=\"1-2-3-4-1-5-1-2\" data-name=\"dietary flag chip (gluten free)\">gluten free</span></span></td>\n</tr>\n<tr data-kid=\"1-2-3-4-2\" data-name=\"lemon lentils with herbs recipe row\">\n<th class=\"title\" data-kid=\"1-2-3-4-2-1\" data-name=\"lemon lentils title cell\" scope=\"row\"><a data-kid=\"1-2-3-4-2-1-1\" data-name=\"lemon lentils link\" href=\"/recipes/lemon-lentils-with-herbs\">Lemon lentils with herbs</a></th>\n<td class=\"num\" data-kid=\"1-2-3-4-2-2\" data-name=\"lemon lentils minutes cell\">35</td>\n<td class=\"num\" data-kid=\"1-2-3-4-2-3\" data-name=\"lemon lentils servings cell\">2</td>\n<td class=\"num\" data-kid=\"1-2-3-4-2-4\" data-name=\"lemon lentils calories cell\">380</td>\n<td data-kid=\"1-2-3-4-2-5\" data-name=\"lemon lentils flags cell\"><span class=\"flags\" data-kid=\"1-2-3-4-2-5-1\" data-name=\"lemon lentils flag chips\"><span class=\"flag\" data-kid=\"1-2-3-4-2-5-1-1\" data-name=\"dietary flag chip (vegan)\">vegan</span><span class=\"flag\" data-kid=\"1-2-3-4-2-5-1-2\" data-name=\"dietary flag chip (gluten free)\">gluten free</span></span></td>\n</tr>\n<tr data-kid=\"1-2-3-4-3\" data-name=\"garlic oil pasta with kale recipe row\">\n<th class=\"title\" data-kid=\"1-2-3-4-3-1\" data-name=\"garlic oil pasta title cell\" scope=\"row\"><a data-kid=\"1-2-3-4-3-1-1\" data-name=\"garlic oil pasta link\" href=\"/recipes/garlic-oil-pasta-with-kale\">Garlic oil pasta with kale</a></th>\n<td class=\"num\" data-kid=\"1-2-3-4-3-2\" data-name=\"garlic oil pasta minutes cell\">20</td>\n<td class=\"num\" data-kid=\"1-2-3-4-3-3\" data-name=\"garlic oil pasta servings cell\">2</td>\n<td class=\"num\" data-kid=\"1-2-3-4-3-4\" data-name=\"garlic oil pasta calories cell\">520</td>\n<td data-kid=\"1-2-3-4-3-5\" data-name=\"garlic oil pasta flags cell\"><span class=\"flags\" data-kid=\"1-2-3-4-3-5-1\" data-name=\"garlic oil pasta flag chips\"><span class=\"flag\" data-kid=\"1-2-3-4-3-5-1-1\" data-name=\"dietary flag chip (vegan)\">vegan</span></span></td>\n</tr>\n<tr data-kid=\"1-2-3-4-4\" data-name=\"roast squash and chickpeas recipe row\">\n<th class=\"title\" data-kid=\"1-2-3-4-4-1\" data-name=\"roast squash title cell\" scope=\"row\"><a data-kid=\"1-2-3-4-4-1-1\" data-name=\"roast squash link\" href=\"/recipes/roast-squash-and-chickpeas\">Roast squash and chickpeas</a></th>\n<td class=\"num\" data-kid=\"1-2-3-4-4-2\" data-name=\"roast squash minutes cell\">40</td>\n<td class=\"nu