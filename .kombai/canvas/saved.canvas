      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n    --destructive-foreground: light-dark(oklch(0.985 0.014 95), oklch(0.190 0.045 20));\n    --chart-gift: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --chart-credit: light-dark(oklch(0.430 0.150 15), oklch(0.560 0.135 15));\n    --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n    --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n    --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n    --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n    --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n    --border-width-thick: 3px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n  }\n\n  :root { --page-measure: 72rem; --space-page: var(--space-5); }\n  @media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n  * { box-sizing: border-box; }\n\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-sm);\n    line-height: var(--leading-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, p { margin: 0; }\n  a { color: inherit; }\n  button { font: inherit; }\n  a:focus-visible, button:focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; border-radius: 2px; }\n\n  .wrap {\n    box-sizing: border-box;\n    inline-size: 100%;\n    max-inline-size: calc(var(--page-measure) + var(--space-page) * 2);\n    margin-inline: auto;\n    padding-inline: var(--space-page);\n  }\n\n  /* chrome — mark, wordmark, three mono links; nothing else fits at 390 */\n  .app-header { border-block-end: var(--border-width-thin) solid var(--border); }\n  .app-header .deck {\n    display: flex;\n    align-items: center;\n    gap: var(--space-3);\n    block-size: 64px;\n  }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-2); text-decoration: none; }\n  .mk { display: block; flex: none; overflow: visible; }\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  .wordmark {\n    font-family: var(--font-display);\n    font-size: var(--text-lg);\n    font-weight: 400;\n    line-height: var(--leading-solid);\n    letter-spacing: var(--tracking-display);\n    white-space: nowrap;\n  }\n  .app-nav {\n    margin-inline-start: auto;\n    display: flex;\n    align-items: center;\n    gap: var(--space-3);\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n  }\n  .app-nav a { color: var(--muted-foreground); text-decoration: none; }\n  .app-nav a[aria-current=\"page\"] { color: var(--foreground); font-weight: 700; }\n\n  .page-head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: var(--space-3);\n    padding-block: var(--space-6) var(--space-4);\n  }\n  .page-head h1 {\n    font-family: var(--font-display);\n    font-size: var(--text-xl);\n    font-weight: 400;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-display);\n  }\n  .page-head .count { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-2xs); color: var(--muted-foreground); }\n\n  .empty {\n    padding: var(--space-5);\n    border: var(--border-width-thin) solid var(--border);\n    border-radius: var(--radius-lg);\n  }\n  .empty__title {\n    font-family: var(--font-display);\n    font-size: var(--text-lg);\n    font-weight: 400;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-display);\n  }\n  .empty__action {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    inline-size: 100%;\n    min-block-size: 44px;\n    margin-block-start: var(--space-5);\n    padding-inline: var(--space-4);\n    border: var(--border-width-thin) solid var(--border);\n    border-radius: var(--radius-md);\n    background: var(--secondary);\n    color: var(--secondary-foreground);\n    font-size: var(--text-sm);\n    font-weight: 700;\n    line-height: var(--leading-tight);\n    text-decoration: none;\n    transition: background-color 140ms cubic-bezier(0.23, 1, 0.32, 1), border-color 140ms linear;\n  }\n  .empty__action:hover {\n    background: color-mix(in oklab, var(--secondary) 82%, var(--foreground));\n    border-color: color-mix(in oklab, var(--border) 70%, var(--foreground));\n  }\n  .empty__action:active { transform: scale(0.99); }\n  .page-foot { padding-block: var(--space-8) var(--space-10); }\n</style>\n<div data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"app-header\" data-kid=\"1-1\" data-name=\"app header bar\">\n<div class=\"wrap deck\" data-kid=\"1-1-1\" data-name=\"header inner flex container\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1\" data-name=\"brand link with logo and wordmark\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1\" data-name=\"decorative chef llama logo icon\" height=\"26\" viewbox=\"0 0 32 32\" width=\"26\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"App\" class=\"app-nav\" data-kid=\"1-1-1-2\" data-name=\"app navigation\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to pantry\" href=\"/pantry\">Pantry</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to saved (current page)\" href=\"/saved\">Saved</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to account\" href=\"/account\">Account</a>\n</nav>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"1-2\" data-name=\"main content container\">\n<div class=\"page-head\" data-kid=\"1-2-1\" data-name=\"page header row with title and count\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page title heading\">Saved</h1>\n<p class=\"count\" data-kid=\"1-2-1-2\" data-name=\"saved recipes count text\">0 recipes</p>\n</div>\n<section aria-labelledby=\"empty-title\" class=\"empty\" data-kid=\"1-2-2\" data-name=\"empty state section\">\n<h2 class=\"empty__title\" data-kid=\"1-2-2-1\" data-name=\"empty state headline\" id=\"empty-title\">No saved recipes</h2>\n<a class=\"empty__action\" data-kid=\"1-2-2-2\" data-name=\"call-to-action link to open pantry\" href=\"/pantry\">Open Pantry</a>\n</section>\n<div class=\"page-foot\" data-kid=\"1-2-3\" data-name=\"page footer spacer\"></div>\n</main>\n</div>",
