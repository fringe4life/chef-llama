      "html": "<style>\n  :root{\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.968 0.026 88), oklch(0.185 0.020 40));\n    --foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n    --card: light-dark(oklch(0.994 0.008 88), oklch(0.235 0.022 40));\n    --secondary: light-dark(oklch(0.940 0.038 86), oklch(0.262 0.024 42));\n    --muted-foreground: light-dark(oklch(0.470 0.040 48), oklch(0.745 0.032 80));\n    --border: light-dark(oklch(0.885 0.030 70), oklch(0.330 0.022 45));\n    --radius: 0.5rem;\n    --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  \n    --spacing: 0.25rem;\n    --font-base: 1rem;\n  --leading-solid: 1;\n  --leading-ui: 1.45;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;}\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans);line-height:var(--leading-ui)}\n  .wrap{\n  padding-block: var(--space-8) var(--space-10); inline-size: 1000px; margin-inline: auto\n}\n  .row{\n  background:var(--card); border:var(--border-width-thin) solid var(--border); border-radius:var(--radius-lg); display:flex; align-items:flex-end; justify-content:center; gap: var(--space-16); padding-block: var(--space-11) var(--space-8); box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n  .size{display:flex;flex-direction:column;align-items:center;gap: var(--space-4)}\n  .size span{font-family:var(--font-mono);font-size: var(--text-xs);color:var(--muted-foreground);letter-spacing: 0}\n  svg{display:block;overflow:visible}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG symbol sprite with mark defs\" height=\"0\" style=\"position:absolute\" width=\"0\"><defs>\n<g id=\"head\">\n<circle cx=\"16\" cy=\"22\" fill=\"oklch(0.812 0.160 82)\" r=\"8.8\"></circle>\n</g>\n<g id=\"eyes\">\n<rect fill=\"oklch(0.235 0.048 70)\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect fill=\"oklch(0.235 0.048 70)\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g>\n<g id=\"hatBehind\">\n<rect fill=\"oklch(0.505 0.133 142)\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse cx=\"15.2\" cy=\"9.6\" fill=\"oklch(0.545 0.150 140)\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n</defs></svg>\n<div class=\"wrap\" data-kid=\"2\" data-name=\"mark showcase layout container\">\n<div class=\"row\" data-kid=\"2-1\" data-name=\"mark size comparison row with dark mode support\">\n<div class=\"size\" data-kid=\"2-1-1\" data-name=\"mark preview column at 220 px\">\n<svg data-kid=\"2-1-1-1\" data-name=\"large mark icon at 220 px\" height=\"220\" viewbox=\"0 0 32 32\" width=\"220\">\n<g transform=\"rotate(-16 16 22)\"><use href=\"#hatBehind\"></use></g>\n<use href=\"#head\"></use><use href=\"#eyes\"></use>\n</svg>\n<span data-kid=\"2-1-1-2\" data-name=\"size label showing 220 px\">220 px</span>\n</div>\n<div class=\"size\" data-kid=\"2-1-2\" data-name=\"mark preview column at 64 px\">\n<svg data-kid=\"2-1-2-1\" data-name=\"medium mark icon at 64 px\" height=\"64\" viewbox=\"0 0 32 32\" width=\"64\">\n<g transform=\"rotate(-16 16 22)\"><use href=\"#hatBehind\"></use></g>\n<use href=\"#head\"></use><use href=\"#eyes\"></use>\n</svg>\n<span data-kid=\"2-1-2-2\" data-name=\"size label showing 64 px\">64 px</span>\n</div>\n<div class=\"size\" data-kid=\"2-1-3\" data-name=\"mark preview column at 38 px\">\n<svg data-kid=\"2-1-3-1\" data-name=\"small mark icon at 38 px\" height=\"38\" viewbox=\"0 0 32 32\" width=\"38\">\n<g transform=\"rotate(-16 16 22)\"><use href=\"#hatBehind\"></use></g>\n<use href=\"#head\"></use><use href=\"#eyes\"></use>\n</svg>\n<span data-kid=\"2-1-3-2\" data-name=\"size label showing 38 px\">38 px</span>\n</div>\n</div>\n</div>",
