      },
      "html": "<style>\n  :root{\n    color-scheme:light;\n    --background:oklch(0.968 0.026 88);\n    --foreground:oklch(0.255 0.045 45);\n    --card:oklch(0.994 0.008 88);\n    --primary:oklch(0.505 0.180 32);\n    --primary-foreground:oklch(0.990 0.010 90);\n    --border:oklch(0.885 0.030 70);\n    --radius:0.5rem;\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  \n    --spacing: 0.25rem;\n    --font-base: 1rem;\n  --leading-solid: 1;\n  --leading-ui: 1.45;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;}\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans);line-height:var(--leading-ui)}\n  .wrap{\n  padding-block: var(--space-11) var(--space-12); inline-size: 960px; margin-inline: auto\n}\n  .sheet{\n  background:var(--card); border:var(--border-width-thin) solid var(--border); border-radius:calc(var(--radius) * 1.5); display:grid; grid-template-columns:repeat(3,1fr); align-items:center; justify-items:center; gap: var(--space-7); padding-block: var(--space-14); box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n\n  .btn{position:relative;display:inline-flex;align-items:center;block-size:44px;border-radius:var(--radius);\n       font-size: var(--text-sm);font-weight:700;letter-spacing:0;text-decoration:none;color:var(--primary);\n       transition:background 150ms linear,color 150ms linear}\n  .btn:active{transform:scale(0.97)}\n\n  .btn--outline{padding: 0 var(--space-5) 0 var(--space-8);border:var(--border-width-thin) solid var(--primary);background:var(--background)}\n  .btn--outline:hover{background:var(--primary);color:var(--primary-foreground)}\n  .btn--outline:hover .plate{border-color:var(--primary)}\n\n  .btn--filled{padding: 0 var(--space-5) 0 var(--space-9);border:var(--border-width-thin) solid var(--primary);\n               background:var(--primary);color:var(--primary-foreground)}\n  .btn--filled:hover{background:color-mix(in oklab,var(--primary) 90%,var(--foreground))}\n\n  .btn--ticket{padding:0;overflow:hidden;border:var(--border-width-thin) solid var(--primary);\n               background:var(--primary);color:var(--primary-foreground)}\n  .btn--ticket:hover{background:color-mix(in oklab,var(--primary) 90%,var(--foreground))}\n\n  .plate{position:absolute;z-index:2;inset-inline-start:-19px;inset-block-start:50%;margin-top: calc(var(--space-5) * -1);inline-size:40px;block-size:40px;\n         border-radius:50%;background:var(--card);border:var(--border-width-thin) solid var(--border);\n         display:grid;place-items:center;color:var(--primary)}\n  .btn--filled .plate{border-color:var(--card)}\n\n  .well{inline-size:44px;align-self:stretch;display:grid;place-items:center;\n        border-inline-end:var(--border-width-thin) solid color-mix(in oklab,var(--primary-foreground) 30%,transparent)}\n  .label{display:flex;align-items:center;padding: 0 var(--space-4) 0 var(--space-4)}\n\n  .icon{overflow:visible;display:block}\n  .fork,.knife,.fork__rock,.knife__rock{transform-box:fill-box;transform-origin:center}\n  @media (prefers-reduced-motion:no-preference){\n    .fork__rock{animation:rock 3.8s ease-in-out infinite}\n    .knife__rock{animation:rock 3.8s ease-in-out infinite -1.9s}\n  }\n  @keyframes rock{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n</style>\n<div class=\"wrap\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"sheet\" data-kid=\"1-1\" data-name=\"button showcase card\">\n<a class=\"btn btn--outline\" data-kid=\"1-1-1\" data-name=\"outline cooking button\" href=\"/pantry\">\n<span class=\"plate\" data-kid=\"1-1-1-1\" data-name=\"outline button circular icon plate\">\n<svg aria-hidden=\"true\" class=\"icon\" data-kid=\"1-1-1-1-1\" data-name=\"fork and knife circle icon\" height=\"21\" viewbox=\"0 0 22 22\" width=\"21\">\n<circle cx=\"11\" cy=\"11\" fill=\"none\" r=\"9.3\" stroke=\"currentColor\" stroke-width=\"1.3\"></circle>\n<g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-2\" data-name=\"outline button label text\">Start cooking</span>\n</a>\n<a class=\"btn btn--filled\" data-kid=\"1-1-2\" data-name=\"filled cooking button\" href=\"/pantry\">\n<span class=\"plate\" data-kid=\"1-1-2-1\" data-name=\"filled button circular icon plate\">\n<svg aria-hidden=\"true\" class=\"icon\" data-kid=\"1-1-2-1-1\" data-name=\"fork and knife circle icon\" height=\"21\" viewbox=\"0 0 22 22\" width=\"21\">\n<circle cx=\"11\" cy=\"11\" fill=\"none\" r=\"9.3\" stroke=\"currentColor\" stroke-width=\"1.3\"></circle>\n<g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</span>\n<span data-kid=\"1-1-2-2\" data-name=\"filled button label text\">Start cooking</span>\n</a>\n<a class=\"btn btn--ticket\" data-kid=\"1-1-3\" data-name=\"ticket-style cooking button\" href=\"/pantry\">\n<span class=\"well\" data-kid=\"1-1-3-1\" data-name=\"ticket button perforated icon well\">\n<svg aria-hidden=\"true\" class=\"icon\" data-kid=\"1-1-3-1-1\" data-name=\"fork and knife circle icon\" height=\"20\" viewbox=\"0 0 22 22\" width=\"20\">\n<circle cx=\"11\" cy=\"11\" fill=\"none\" r=\"9.3\" stroke=\"currentColor\" stroke-width=\"1.3\"></circle>\n<g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</span>\n<span class=\"label\" data-kid=\"1-1-3-2\" data-name=\"ticket button label text\">Start cooking</span>\n</a>\n</div>\n</div>\n",
