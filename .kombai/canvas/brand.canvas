      },
      "html": "<style>\n  :root{\n    color-scheme:light;\n    --background:oklch(0.968 0.026 88);\n    --foreground:oklch(0.255 0.045 45);\n    --card:oklch(0.994 0.008 88);\n    --secondary:oklch(0.940 0.038 86);\n    --muted:oklch(0.936 0.034 86);\n    --muted-foreground:oklch(0.470 0.040 48);\n    --primary:oklch(0.505 0.180 32);\n    --primary-foreground:oklch(0.990 0.010 90);\n    --border:oklch(0.885 0.030 70);\n    --radius:0.5rem;\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n    \n  \n    --spacing: 0.25rem;\n    --font-base: 1rem;\n  --leading-body: 1.55;\n  --leading-tight: 1.2;\n  --leading-solid: 1;\n  --leading-ui: 1.45;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;}\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--background);color:var(--foreground);\n       font-family:var(--font-sans);font-size: var(--text-sm);line-height:var(--leading-body);-webkit-font-smoothing:antialiased}\n  h1,h2,h3,p,ol,ul,dl,dd,dt{margin:0}\n  ol,ul{list-style:none;padding:0}\n  a{color:inherit;text-decoration:none}\n  .wrap{\n  box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n  a:focus-visible{outline:var(--border-width-medium) solid var(--primary);outline-offset:3px;border-radius:2px}\n  .unit{font-family:var(--font-mono);font-size: var(--text-2xs);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--muted-foreground)}\n\n  /* single-row sign, pinned */\n  .sign{position:sticky;inset-block-start:0;z-index:20;background:var(--background);\n        border-block-end:var(--border-width-thin) solid var(--border)}\n  .deck--sign{block-size:72px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap: var(--space-6)}\n  .lockup{display:inline-flex;align-items:center;gap: var(--space-3);justify-self:start}\n  .wordmark{font-family:var(--font-display);font-size: var(--text-xl);line-height:var(--leading-solid);letter-spacing:var(--tracking-display)}\n  .nav{display:flex;align-items:center;gap: var(--space-7);justify-self:center;font-family:var(--font-mono);\n       font-size: var(--text-2xs);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--muted-foreground)}\n  .nav a{transition:color 130ms linear}\n  .nav a:hover{color:var(--foreground)}\n  .cta{justify-self:end}\n\n  /* CTA with the plate set down on its edge */\n  .cta{position:relative;display:inline-flex;align-items:center;block-size:44px;\n       padding: 0 var(--space-5) 0 var(--space-8);border:var(--border-width-thin) solid var(--primary);border-radius:var(--radius);\n       color:var(--primary);background:var(--background);font-size: var(--text-sm);font-weight:700;\n       transition:background 150ms linear,color 150ms linear}\n  .cta:hover{background:var(--primary);color:var(--primary-foreground)}\n  .cta:active{transform:scale(0.97)}\n  .cta__plate{position:absolute;inset-inline-start:-19px;inset-block-start:50%;margin-top: calc(var(--space-5) * -1);inline-size:40px;block-size:40px;\n              border-radius:50%;background:var(--card);border:var(--border-width-thin) solid var(--border);\n              display:grid;place-items:center;color:var(--primary);transition:none}\n  .cta:hover .cta__plate{border-color:var(--primary)}\n  .plate{overflow:visible;display:block}\n  .fork,.knife,.fork__rock,.knife__rock{transform-box:fill-box;transform-origin:center}\n\n  /* the mark: a tilted toque over two eyes, no mouth */\n  .mk{display:block;flex:none;overflow:visible}\n  .mk-crown{fill:oklch(0.545 0.150 140)}\n  .mk-band{fill:oklch(0.505 0.133 142)}\n  .mk-head{fill:oklch(0.812 0.160 82)}\n  .mk-eye{fill:oklch(0.235 0.048 70)}\n  .mk-blink{transform-box:fill-box;transform-origin:center}\n  .mk-hat{transform-box:view-box;transform-origin:16px 22px;transform:rotate(-16deg)}\n  .mk-eye--far{transform-box:fill-box;transform-origin:center}\n\n  @media (prefers-reduced-motion:no-preference){\n    .mk-blink{animation:blink 5.6s cubic-bezier(0.23, 1, 0.32, 1) infinite}\n    .fork__rock{animation:rock 3.8s ease-in-out infinite}\n    .knife__rock{animation:rock 3.8s ease-in-out infinite -1.9s}\n  }\n  @keyframes blink{0%,90%,100%{transform:scaleY(1)}93.5%,95.5%{transform:scaleY(.1)}}\n  @keyframes mkLook{0%{transform:translateX(0)}50%{transform:translateX(1.1px)}100%{transform:translateX(0)}}\n  @keyframes mkSquash{0%{transform:scale(1,1)}50%{transform:scale(0.76,0.88)}100%{transform:scale(1,1)}}\n  @keyframes mkTilt{0%{transform:rotate(-16deg)}50%{transform:rotate(-21deg)}100%{transform:rotate(-16deg)}}\n  @keyframes rock{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}\n  @keyframes tip{from{transform:translateY(0) rotate(0)}to{transform:translateY(-2.4px) rotate(-5deg)}}\n  @keyframes part{from{transform:translateX(0)}to{transform:translateX(-2.8px)}}\n\n  @supports (animation-timeline: scroll()){\n    @media (prefers-reduced-motion:no-preference){\n      .mk-eyes{animation:mkLook linear both;animation-timeline:scroll(root block)}\n      .mk-eye--far{animation:mkSquash linear both;animation-timeline:scroll(root block)}\n      .mk-hat{animation:mkTilt linear both;animation-timeline:scroll(root block)}\n      .fork{animation:part linear both;animation-timeline:scroll(root block);animation-range:0 200px}\n      .knife{animation:part linear both;animation-timeline:scroll(root block);animation-range:0 200px;\n             animation-direction:reverse}\n    }\n  }\n\n  /* content */\n  .hero{padding: var(--space-14) 0 var(--space-13)}\n  .hero__in{display:grid;gap: var(--space-7)}\n  @media (width >= 900px){.hero__in{grid-template-columns:minmax(0,1fr) 320px;gap: var(--space-20);align-items:start}}\n  .hero h1{font-family:var(--font-display);font-weight:400;font-size: var(--text-4xl);line-height:var(--leading-tight);letter-spacing:var(--tracking-display);max-inline-size:24ch}\n  .hero p{color:var(--muted-foreground);max-inline-size:38ch;padding-top: var(--space-3)}\n  .hero__more{display:inline-flex;align-items:center;gap: var(--space-2);margin-top: var(--space-5);font-size: var(--text-xs);font-weight:700;color:var(--primary)}\n  .hero__more span{display:inline-block;inline-size:18px;block-size:1px;background:currentColor}\n\n  .band{background:var(--secondary);border-block-start:var(--border-width-thin) solid var(--border);border-block-end:var(--border-width-thin) solid var(--border);\n        padding: var(--space-10) 0 var(--space-11)}\n  .band__head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom: var(--space-5)}\n  .band h2{font-family:var(--font-display);font-weight:400;font-size: var(--text-xl);letter-spacing: var(--tracking-tight)}\n  .specimen{display:grid;gap:0;background:var(--card);border:var(--border-width-thin) solid var(--border);border-radius:var(--radius)}\n  @media (width >= 820px){.specimen{grid-template-columns:264px minmax(0,1fr)}}\n  .specimen__side{padding: var(--space-5) var(--space-6);border-block-end:var(--border-width-thin) solid var(--border)}\n  @media (width >= 820px){.specimen__side{border-block-end:none;border-inline-end:var(--border-width-thin) solid var(--border)}}\n  .chips{display:flex;flex-wrap:wrap;gap: var(--space-2);margin-top: var(--space-3)}\n  .chip{font-size: var(--text-xs);background:var(--muted);border:var(--border-width-thin) solid var(--border);\n        border-radius:3px;padding: 3px var(--space-2)}\n  .specimen__attrs{display:grid;grid-template-columns:repeat(3,1fr);gap: var(--space-4);margin-top: var(--space-5)}\n  .specimen__attrs dt{font-family:var(--font-mono);font-size: var(--text-2xs);letter-spacing:var(--tracking-caps);\n                      text-transform:uppercase;color:var(--muted-foreground);margin-bottom:3px}\n  .specimen__attrs dd{font-size: var(--text-xs)}\n  .specimen__body{padding: var(--space-5) var(--space-6)}\n  .specimen__title{font-family:var(--font-display);font-weight:400;font-size: var(--text-xl);letter-spacing:var(--tracking-display);margin: var(--space-3) 0 var(--space-4)}\n  .specimen__stats{display:flex;gap: var(--space-8);padding-top: var(--space-3);border-block-start:var(--border-width-thin) solid var(--border)}\n  .specimen__stats div{min-inline-size:54px}\n  .specimen__stats dt{font-family:var(--font-mono);font-size: var(--text-2xs);letter-spacing:var(--tracking-caps);\n                      text-transform:uppercase;color:var(--muted-foreground);margin-bottom:2px}\n  .specimen__stats dd{font-family:var(--font-mono);font-size: var(--text-base);font-variant-numeric:tabular-nums}\n  .specimen__line{margin-top: var(--space-4);font-size: var(--text-sm);color:var(--muted-foreground);max-inline-size:62ch}\n\n  /* steps */\n  .steps{padding: var(--space-12) 0 var(--space-2);border-block-start:var(--border-width-thin) solid var(--border);margin-top: var(--space-7)}\n  .steps__in{display:grid;gap: var(--space-6)}\n  @media (width >= 900px){.steps__in{grid-template-columns:220px minmax(0,1fr);gap: var(--space-14)}}\n  .steps h2{font-family:var(--font-display);font-weight:400;font-size: var(--text-xl);letter-spacing: var(--tracking-tight)}\n  .steps ol{display:grid;gap: var(--space-4)}\n  .steps li{display:grid;gap: var(--space-1);padding-top: var(--space-3);border-block-start:var(--border-width-thin) solid var(--border)}\n  @media (width >= 720px){.steps li{grid-template-columns:200px minmax(0,1fr);gap: var(--space-6);align-items:start}}\n  .steps h3{font-size: var(--text-sm);font-weight:700}\n  .steps p{font-size: var(--text-sm);color:var(--muted-foreground);max-inline-size:54ch}\n\n  /* free cooks */\n  .free{background:var(--secondary);border-block-start:var(--border-width-thin) solid var(--border);margin-top: var(--space-8)}\n  .free__in{display:flex;align-items:center;justify-content:space-between;gap: var(--space-6);\n            padding-top: var(--space-4);padding-bottom: var(--space-4)}\n  .free p{font-size: var(--text-sm)}\n  .free a{font-size: var(--text-xs);font-weight:700;color:var(--primary);border-block-end:var(--border-width-thin) solid currentColor;padding-bottom:1px}\n\n  footer{padding: var(--space-9) 0 var(--space-12)}\n  .foot__in{display:flex;align-items:baseline;justify-content:space-between;gap: var(--space-6)}\n  .foot__brand{font-family:var(--font-display);font-size: var(--text-base)}\n  .foot__nav{display:flex;gap: var(--space-5);font-size: var(--text-xs);color:var(--muted-foreground)}\n  .foot__nav a:hover{color:var(--foreground)}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n</style>\n<header class=\"sign\" data-kid=\"1\" data-name=\"header\">\n<div class=\"wrap\" data-kid=\"1-1\" data-name=\"header content wrapper\">\n<div class=\"deck--sign\" data-kid=\"1-1-1\" data-name=\"branding and call-to-action deck\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1\" data-name=\"brand link with logo and wordmark\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1\" height=\"38\" viewbox=\"0 0 32 32\" width=\"38\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\"><g class=\"mk-blink\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye mk-eye--far\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-1-2-1\" data-name=\"main site navigation\">\n<a data-kid=\"1-1-2-1-1\" data-name=\"nav link popular\" href=\"#example\">Popular</a>\n<a data-kid=\"1-1-2-1-3\" data-name=\"nav link pricing\" href=\"/pricing\">Pricing</a>\n<a data-kid=\"1-1-2-1-5\" data-name=\"nav link how to cook\" href=\"/how-to\">How to cook</a>\n</nav>\n<a class=\"cta\" data-kid=\"1-1-1-2\" data-name=\"call-to-action button\" href=\"/pantry\">\n<span class=\"cta__plate\" data-kid=\"1-1-1-2-1\" data-name=\"CTA decorative plate\">\n<svg aria-hidden=\"true\" class=\"plate\" data-kid=\"1-1-1-2-1-1\" data-name=\"fork and knife icon\" height=\"21\" viewbox=\"0 0 22 22\" width=\"21\">\n<circle cx=\"11\" cy=\"11\" fill=\"none\" r=\"9.3\" stroke=\"currentColor\" stroke-width=\"1.3\"></circle>\n<g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-2-2\" data-name=\"CTA button label\">Start cooking</span>\n</a>\n</div>\n</div>\n</header>\n<main data-kid=\"2\" data-name=\"main content region\">\n<section aria-labelledby=\"hero-h\" class=\"hero\" data-kid=\"2-1\" data-name=\"hero section\">\n<div class=\"wrap hero__in\" data-kid=\"2-1-1\" data-name=\"hero inner grid container\">\n<h1 data-kid=\"2-1-1-1\" data-name=\"hero headline text\" id=\"hero-h\">You’ve got the Pantry. Chef Llama’s got the Recipe.</h1>\n<div data-kid=\"2-1-1-2\" data-name=\"hero secondary content block\">\n<p data-kid=\"2-1-1-2-1\" data-name=\"hero supporting paragraph\">Your Diet and allergies are hard limits. You cook it, save it, and find similar dishes from the same Pantry.</p>\n<a class=\"hero__more\" data-kid=\"2-1-1-2-2\" data-name=\"learn-more text link\" href=\"#example\">See an example Recipe</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"example-h\" class=\"band\" data-kid=\"2-2\" data-name=\"example recipe section band\" id=\"example\">\n<div class=\"wrap\" data-kid=\"2-2-1\" data-name=\"section inner wrapper\">\n<div class=\"band__head\" data-kid=\"2-2-1-1\" data-name=\"section heading row\">\n<h2 data-kid=\"2-2-1-1-1\" data-name=\"section headline text\" id=\"example-h\">Example Recipe</h2>\n<p class=\"unit\" data-kid=\"2-2-1-1-2\" data-name=\"section chips count label\">5 Chips</p>\n</div>\n<article aria-labelledby=\"specimen-h\" class=\"specimen\" data-kid=\"2-2-1-2\" data-name=\"recipe specimen card\">\n<div class=\"specimen__side\" data-kid=\"2-2-1-2-1\" data-name=\"specimen side panel\">\n<p class=\"unit\" data-kid=\"2-2-1-2-1-1\" data-name=\"side pantry label\">Pantry</p>\n<ul class=\"chips\" data-kid=\"2-2-1-2-1-2\" data-name=\"ingredient chips list\">\n<li class=\"chip\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"ingredient chip firm tofu\">firm tofu</li>\n<li class=\"chip\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"ingredient chip day-old rice\">day-old rice</li>\n<li class=\"chip\" data-kid=\"2-2-1-2-1-2-3\" data-name=\"ingredient chip soy sauce\">soy sauce</li>\n<li class=\"chip\" data-kid=\"2-2-1-2-1-2-4\" data-name=\"ingredient chip spring onion\">spring onion</li>\n<li class=\"chip\" data-kid=\"2-2-1-2-1-2-5\" data-name=\"ingredient chip ginger\">ginger</li>\n</ul>\n<dl class=\"specimen__attrs\" data-kid=\"2-2-1-2-1-3\" data-name=\"recipe attribute grid\">\n<div data-kid=\"2-2-1-2-1-3-1\" data-name=\"diet attribute cell\"><dt data-kid=\"2-2-1-2-1-3-1-1\" data-name=\"diet attribute label\">Diet</dt><dd data-kid=\"2-2-1-2-1-3-1-2\" data-name=\"diet attribute value\">vegan</dd></div>\n<div data-kid=\"2-2-1-2-1-3-2\" data-name=\"allergy attribute cell\"><dt data-kid=\"2-2-1-2-1-3-2-1\" data-name=\"allergy attribute label\">Allergy</dt><dd data-kid=\"2-2-1-2-1-3-2-2\" data-name=\"allergy attribute value\">sesame</dd></div>\n<div data-kid=\"2-2-1-2-1-3-3\" data-name=\"servings attribute cell\"><dt data-kid=\"2-2-1-2-1-3-3-1\" data-name=\"servings attribute label\">Servings</dt><dd data-kid=\"2-2-1-2-1-3-3-2\" data-name=\"servings attribute value\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"2-2-1-2-2\" data-name=\"specimen body panel\">\n<h3 class=\"specimen__title\" data-kid=\"2-2-1-2-2-1\" data-name=\"recipe title text\" id=\"specimen-h\">Tofu fried rice</h3>\n<dl class=\"specimen__stats\" data-kid=\"2-2-1-2-2-2\" data-name=\"recipe stats row\">\n<div data-kid=\"2-2-1-2-2-2-1\" data-name=\"cuisine time stat cell\"><dt data-kid=\"2-2-1-2-2-2-1-1\" data-name=\"cuisine time stat label\">Minutes</dt><dd data-kid=\"2-2-1-2-2-2-1-2\" data-name=\"cuisine time stat value\">25</dd></div>\n<div data-kid=\"2-2-1-2-2-2-2\" data-name=\"servings stat cell\"><dt data-kid=\"2-2-1-2-2-2-2-1\" data-name=\"servings stat label\">Servings</dt><dd data-kid=\"2-2-1-2-2-2-2-2\" data-name=\"servings stat value\">2</dd></div>\n<div data-kid=\"2-2-1-2-2-2-3\" data-name=\"kcal stat cell\"><dt data-kid=\"2-2-1-2-2-2-3-1\" data-name=\"kcal stat label\">kcal</dt><dd data-kid=\"2-2-1-2-2-2-3-2\" data-name=\"kcal stat value\">480</dd></div>\n</dl>\n<p class=\"specimen__line\" data-kid=\"2-2-1-2-2-3\" data-name=\"recipe preparation tip text\">Day-old rice goes in cold and gets pressed flat for a minute before it is tossed, so it steams dry instead of clumping.</p>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"steps-h\" class=\"steps\" data-kid=\"2-3\" data-name=\"how it works steps section\">\n<div class=\"wrap steps__in\" data-kid=\"2-3-1\" data-name=\"steps section inner container\">\n<h2 data-kid=\"2-3-1-1\" data-name=\"steps section headline\" id=\"steps-h\">How it works</h2>\n<ol data-kid=\"2-3-1-2\" data-name=\"steps ordered list\">\n<li data-kid=\"2-3-1-2-1\" data-name=\"step item add chips\"><h3 data-kid=\"2-3-1-2-1-1\" data-name=\"step item title add chips\">Add three Chips</h3><p data-kid=\"2-3-1-2-1-2\" data-name=\"step item description add chips\">Type what is in the kitchen. Three ingredients at least, sixteen at most.</p></li>\n<li data-kid=\"2-3-1-2-2\" data-name=\"step item set diet\"><h3 data-kid=\"2-3-1-2-2-1\" data-name=\"step item title set diet\">Set your Diet</h3><p data-kid=\"2-3-1-2-2-2\" data-name=\"step item description set diet\">Vegan, vegetarian, gluten free and your allergies are hard limits. Kcal and minutes are targets.</p></li>\n<li data-kid=\"2-3-1-2-3\" data-name=\"step item cook recipe\"><h3 data-kid=\"2-3-1-2-3-1\" data-name=\"step item title cook recipe\">Cook one Recipe</h3><p data-kid=\"2-3-1-2-3-2\" data-name=\"step item description cook recipe\">One dish for tonight, made from what you already have. Save it and ask for something similar.</p></li>\n</ol>\n</div>\n</section>\n<section aria-label=\"Free cooks\" class=\"free\" data-kid=\"2-4\" data-name=\"free cooks pricing promo band\">\n<div class=\"wrap free__in\" data-kid=\"2-4-1\" data-name=\"free cooks promo inner container\">\n<p data-kid=\"2-4-1-1\" data-name=\"free cooks promo description text\">Free cooks come from a shared pool and go fast. Packs start at $8 for 20 Credits.</p>\n<a data-kid=\"2-4-1-2\" data-name=\"pricing call-to-action link\" href=\"/pricing\">Pricing</a>\n</div>\n</section>\n</main>\n<footer data-kid=\"3\" data-name=\"page footer\">\n<div class=\"wrap foot__in\" data-kid=\"3-1\" data-name=\"footer inner container\">\n<p class=\"foot__brand\" data-kid=\"3-1-1\" data-name=\"footer brand text\">Chef Llama</p>\n<nav aria-label=\"Footer\" class=\"foot__nav\" data-kid=\"3-1-2\" data-name=\"footer navigation\">\n<a data-kid=\"3-1-2-1\" data-name=\"footer link popular\" href=\"/popular\">Popular</a>\n<a data-kid=\"3-1-2-2\" data-name=\"footer link pricing\" href=\"/pricing\">Pricing</a>\n<a data-kid=\"3-1-2-3\" data-name=\"footer link how to cook\" href=\"/how-to\">How to cook</a>\n<a data-kid=\"3-1-2-4\" data-name=\"footer link terms\" href=\"/terms\">Terms</a>\n<a data-kid=\"3-1-2-5\" data-name=\"footer link privacy\" href=\"/privacy\">Privacy</a>\n</nav>\n</div>\n</footer>\n",
