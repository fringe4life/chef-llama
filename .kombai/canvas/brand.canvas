      "html": "<style>\n  :root{\n    color-scheme:light;\n    --background:oklch(0.958 0.024 95);\n    --card:oklch(0.985 0.014 95);\n    --foreground:oklch(0.255 0.055 62);\n    --border:oklch(0.885 0.032 82);\n    --radius:0.5rem;\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --mark:oklch(0.812 0.160 82);\n    --cut:oklch(0.235 0.048 70);\n    --crown:oklch(0.545 0.150 140);\n    --band:oklch(0.505 0.133 142);\n  \n    --spacing: 0.25rem;\n    --font-base: 1rem;\n  --leading-solid: 1;\n  --leading-ui: 1.45;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;}\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--background);color:var(--foreground);line-height:var(--leading-ui)}\n  .wrap{\n  padding-block: var(--space-9) var(--space-11); display:grid; gap: var(--space-4); box-sizing: border-box; inline-size: 840px; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n  .bar,.iron{block-size:78px;border-radius:calc(var(--radius) * 1.5);display:flex;align-items:center;\n             gap: var(--space-3);padding: 0 var(--space-6)}\n  .bar{background:var(--card);border:var(--border-width-thin) solid var(--border)}\n  .iron{background:oklch(0.185 0.018 70);border:var(--border-width-thin) solid transparent;\n        --mark:oklch(0.845 0.160 84);--cut:oklch(0.210 0.045 70);\n        --crown:oklch(0.800 0.125 140);--band:oklch(0.690 0.115 141)}\n  .name{font-family:var(--font-display);font-size: var(--text-xl);letter-spacing:var(--tracking-display)}\n  .iron .name{color:oklch(0.945 0.022 92)}\n  .stage{background:var(--card);border:var(--border-width-thin) solid var(--border);border-radius:calc(var(--radius) * 1.5);\n         display:grid;place-items:center;padding: var(--space-11) 0 var(--space-10)}\n  svg{display:block;overflow:visible}\n  .band{fill:var(--band)}\n  .crown{fill:var(--crown)}\n  .head{fill:var(--mark)}\n  .eye{fill:var(--cut)}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n</style>\n<div class=\"wrap\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"bar\" data-kid=\"1-1\" data-name=\"brand bar with chef llama\">\n<svg aria-label=\"Chef Llama\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"chef llama logo icon\" data-reason=\"SVG contents replaced by script-injected hat, head and eye shapes\" height=\"38\" id=\"m1\" role=\"img\" viewbox=\"0 0 32 32\" width=\"38\"></svg>\n<span class=\"name\" data-kid=\"1-1-2\" data-name=\"brand name text\">Chef Llama</span>\n</div>\n<div class=\"stage\" data-kid=\"1-2\" data-name=\"hero llama display stage\">\n<svg aria-label=\"Chef Llama\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"large chef llama display icon\" data-reason=\"SVG contents replaced and eye/hat attributes animated by script\" height=\"248\" id=\"m2\" role=\"img\" viewbox=\"0 0 32 32\" width=\"248\"></svg>\n</div>\n<div class=\"iron\" data-kid=\"1-3\" data-name=\"iron brand bar with chef llama\">\n<svg aria-label=\"Chef Llama\" data-dynamic=\"true\" data-kid=\"1-3-1\" data-name=\"chef llama logo icon in iron bar\" data-reason=\"SVG contents replaced by script-injected hat, head and eye shapes\" height=\"38\" id=\"m3\" role=\"img\" viewbox=\"0 0 32 32\" width=\"38\"></svg>\n<span class=\"name\" data-kid=\"1-3-2\" data-name=\"brand name text in iron bar\">Chef Llama</span>\n</div>\n</div>\n<script>\n(function () {\n  var HAT = '<g class=\"hatg\">' +\n    '<rect class=\"band\" x=\"9.6\" y=\"9.4\" width=\"12.8\" height=\"8.8\" rx=\"1.8\"/>' +\n    '<ellipse class=\"crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" ' +\n      'transform=\"rotate(-6 15.2 9.6)\"/>' +\n    '</g>';\n\n  var marks = ['m1', 'm2', 'm3'].map(function (id) {\n    var svg = document.getElementById(id);\n    svg.innerHTML = HAT +\n      '<circle class=\"head\" cx=\"16\" cy=\"22\" r=\"8.8\"/>' +\n      '<rect class=\"eye\"/><rect class=\"eye\"/>';\n    var eyes = svg.querySelectorAll('.eye');\n    return { hat: svg.querySelector('.hatg'), left: eyes[0], right: eyes[1] };\n  });\n\n  var NEAR = { w: 2.9, h: 7.5, rx: 1.35 };\n  var CY = 22.1, CX_LEFT = 12.8, CX_RIGHT = 19.2;\n  var W_DROP = 0.7, H_DROP = 0.9, RX_DROP = 0.5, SHIFT = 1.7;\n  var REST_TILT = -16, TILT_SWING = 5;\n\n  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }\n  function smooth(x) { return x * x * (3 - 2 * x); }\n\n  function put(el, cx, g, blink) {\n    var h = Math.max(1.1, g.h * blink);\n    var rx = Math.min(g.rx, h / 2);\n    el.setAttribute('x', (cx - g.w / 2).toFixed(3));\n    el.setAttribute('y', (CY - h / 2).toFixed(3));\n    el.setAttribute('width', g.w.toFixed(3));\n    el.setAttribute('height', h.toFixed(3));\n    el.setAttribute('rx', rx.toFixed(3));\n  }\n\n  function paint(gaze, blink, hatGaze) {\n    var m = Math.min(1, Math.abs(gaze));\n    var far = {\n      w: NEAR.w - W_DROP * m,\n      h: NEAR.h - H_DROP * m,\n      rx: NEAR.rx - RX_DROP * m\n    };\n    var shift = SHIFT * gaze;\n    var leftIsNear = gaze >= 0;\n    var L = leftIsNear ? NEAR : far;\n    var R = leftIsNear ? far : NEAR;\n    var angle = REST_TILT - TILT_SWING * hatGaze;\n    var rot = 'rotate(' + angle.toFixed(2) + ' 16 22)';\n    for (var i = 0; i < marks.length; i++) {\n      marks[i].hat.setAttribute('transform', rot);\n      put(marks[i].left, CX_LEFT + shift, L, blink);\n      put(marks[i].right, CX_RIGHT + shift, R, blink);\n    }\n  }\n\n  var IDLE = [\n    [0, 0], [1500, 0], [2300, -1], [3400, -1], [4200, 0],\n    [5600, 0], [6400, 1], [7500, 1], [8300, 0], [9600, 0]\n  ];\n  var IDLE_LEN = 9600;\n\n  function idleGaze(t) {\n    var p = t % IDLE_LEN;\n    for (var i = 1; i < IDLE.length; i++) {\n      if (p <= IDLE[i][0]) {\n        var a = IDLE[i - 1], b = IDLE[i];\n        return a[1] + (b[1] - a[1]) * smooth(clamp((p - a[0]) / (b[0] - a[0]), 0, 1));\n      }\n    }\n    return 0;\n  }\n\n  function blinkAt(t) {\n    var p = t % 4300;\n    if (p < 90) return 1 - smooth(p / 90);\n    if (p < 140) return 0;\n    if (p < 220) return smooth((p - 140) / 80);\n    return 1;\n  }\n\n  var pointer = null, lastMove = -1e9;\n  var stage = document.querySelector('.wrap');\n  var big = document.getElementById('m2');\n\n  stage.addEventListener('pointermove', function (e) {\n    var r = big.getBoundingClientRect();\n    var g = clamp((e.clientX - (r.left + r.width / 2)) / 200, -1, 1);\n    pointer = Math.abs(g) < 0.06 ? 0 : g;\n    lastMove = performance.now();\n  });\n  stage.addEventListener('pointerleave', function () { pointer = null; });\n\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var cur = 0, hatCur = 0, start = performance.now();\n\n  if (reduce) { paint(0, 1, 0); return; }\n\n  function frame(now) {\n    var t = now - start;\n    var target = (pointer !== null && now - lastMove < 2000) ? pointer : idleGaze(t);\n    cur += (target - cur) * 0.18;\n    hatCur += (cur - hatCur) * 0.075;\n    paint(cur, blinkAt(t), hatCur);\n    requestAnimationFrame(frame);\n  }\n\n  requestAnimationFrame(frame);\n})();\n</script>\n",
