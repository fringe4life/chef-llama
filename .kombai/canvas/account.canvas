b, var(--foreground) 40%, var(--background));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --text-4xl: calc(var(--font-base) * 2.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-11: calc(var(--spacing) * 11);\n  --space-12: calc(var(--spacing) * 12);\n  --space-13: calc(var(--spacing) * 13);\n  --space-14: calc(var(--spacing) * 14);\n  --space-15: calc(var(--spacing) * 15);\n  --space-16: calc(var(--spacing) * 16);\n  --space-17: calc(var(--spacing) * 17);\n  --space-18: calc(var(--spacing) * 18);\n  --space-19: calc(var(--spacing) * 19);\n  --space-20: calc(var(--spacing) * 20);}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\nb,strong{font-weight:700}</style><style>\n  :root{\n  }\n  *,*::before,*::after{box-sizing:border-box}\n  body{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans);-webkit-font-smoothing:antialiased;line-height:var(--leading-ui)}\n  .wrap{\n  padding-block: var(--space-7) var(--space-11); box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n\n  .opt{margin-top: var(--space-7)}\n  .opt:first-child{margin-top:0}\n  .opt__name{font-family:var(--font-mono);font-size: var(--text-2xs);letter-spacing: var(--tracking-caps);text-transform:uppercase;color:var(--muted-foreground);margin:0;padding-bottom: var(--space-2);border-block-end:var(--border-width-thin) solid var(--border)}\n  .opts{display:grid;gap: var(--space-3);margin-top: var(--space-3)}\n  @media(width >= 768px){.opts{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n  .c{display:grid;grid-template-columns:34px minmax(0,1fr);gap: var(--space-4);padding: var(--space-4) var(--space-5) var(--space-5);\n     border:var(--border-width-thin) solid color-mix(in oklab,var(--chart-gift-ink) 38%,var(--primary));\n     border-radius:var(--radius-lg);background:var(--card)}\n  .c__rank{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-lg);line-height:var(--leading-solid);color:var(--muted-foreground)}\n  .c__title{display:block;font-family:var(--font-display);font-size: var(--text-lg);font-weight:700;line-height:var(--leading-tight);letter-spacing: var(--tracking-tight)}\n  .c__ings{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;line-clamp:1;overflow:hidden;\n           margin-top: var(--space-2);font-size: var(--text-xs);line-height:var(--leading-ui);color:var(--muted-foreground)}\n\n  /* A — flex wrap, as shipped */\n  .meta-a{display:flex;flex-wrap:wrap;gap: var(--space-1) var(--space-4);margin-top: var(--space-4);padding-top: var(--space-3);\n          border-block-start:var(--border-width-thin) solid var(--border);font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-xs)}\n\n  /* B — value over label, three equal tracks */\n  .meta-b{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap: 0 var(--space-3);margin-top: var(--space-4);padding-top: var(--space-3);\n          border-block-start:var(--border-width-thin) solid var(--border)}\n  .meta-b>div{display:grid;gap:3px;min-inline-size:0}\n  .meta-b b{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-xs);font-weight:400;line-height:var(--leading-tight);white-space:nowrap}\n  .meta-b i{font-family:var(--font-mono);font-style:normal;font-size: var(--text-2xs);line-height:var(--leading-ui);letter-spacing: var(--tracking-caps);\n            text-transform:uppercase;color:var(--muted-foreground);white-space:nowrap}\n  @media(width <= 767.98px){\n    .meta-b{grid-template-columns:minmax(0,1fr);gap: var(--space-2)}\n    .meta-b>div{grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap: var(--space-3)}\n    .meta-b b{grid-column:2;grid-row:1;text-align:end}\n    .meta-b i{grid-column:1;grid-row:1}\n  }\n\n  /* C — three equal columns, units kept on one line */\n  .meta-c{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap: var(--space-1) var(--space-3);margin-top: var(--space-4);padding-top: var(--space-3);\n          border-block-start:var(--border-width-thin) solid var(--border);font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size: var(--text-xs)}\n\nb,strong{font-weight:700}</style>\n<div class=\"wrap\" data-kid=\"1\" data-name=\"page layout container\">\n<section class=\"opt\" data-kid=\"1-1\" data-name=\"recipe layout option A section\" data-opt=\"a\">\n<h2 class=\"opt__name\" data-kid=\"1-1-1\" data-name=\"option section heading - flex wrap label\">Flex wrap</h2>\n<ul class=\"opts\" data-kid=\"1-1-2\" data-name=\"recipe card list - flex wrap variant\" style=\"list-style:none;padding:0;\">\n<li class=\"c\" data-kid=\"1-1-2-1\" data-name=\"recipe card container\">\n<span class=\"c__rank\" data-kid=\"1-1-2-1-1\" data-name=\"recipe rank number\">1</span>\n<span data-kid=\"1-1-2-1-2\" data-name=\"recipe card content wrapper\">\n<span class=\"c__title\" data-kid=\"1-1-2-1-2-1\" data-name=\"recipe card title\">Cucumber and sesame salad</span>\n<span class=\"c__ings\" data-kid=\"1-1-2-1-2-2\" data-name=\"recipe ingredients text\">cucumber, rice vinegar, sesame, chilli</span>\n<span class=\"meta-a\" data-kid=\"1-1-2-1-2-3\" data-name=\"recipe meta stats row - flex wrap\"><span data-kid=\"1-1-2-1-2-3-1\" data-name=\"recipe cook time stat\">5 min</span><span data-kid=\"1-1-2-1-2-3-2\" data-name=\"recipe calorie stat\">90 kcal a serving</span><span data-kid=\"1-1-2-1-2-3-3\" data-name=\"recipe save count stat\">1,204 saves</span></span>\n</span>\n</li>\n<li class=\"c\" data-kid=\"1-1-2-2\" data-name=\"recipe card container\">\n<span class=\"c__rank\" data-kid=\"1-1-2-2-1\" data-name=\"recipe rank number\">2</span>\n<span data-kid=\"1-1-2-2-2\" data-name=\"recipe card content wrapper\">\n<span class=\"c__title\" data-kid=\"1-1-2-2-2-1\" data-name=\"recipe card title\">Slow borlotti with sage</span>\n<span class=\"c__ings\" data-kid=\"1-1-2-2-2-2\" data-name=\"recipe ingredients text\">borlotti beans, sage, tomato, olive oil</span>\n<span class=\"meta-a\" data-kid=\"1-1-2-2-2-3\" data-name=\"recipe meta stats row - flex wrap\"><span data-kid=\"1-1-2-2-2-3-1\" data-name=\"recipe cook time stat\">2 h 30 min</span><span data-kid=\"1-1-2-2-2-3-2\" data-name=\"recipe calorie stat\">1,180 kcal a serving</span><span data-kid=\"1-1-2-2-2-3-3\" data-name=\"recipe save count stat\"