\">Receipt</a></td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-2\" data-name=\"purchase table row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"purchase date cell\">2 October 2026</td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"purchase amount cell\"><span class=\"num\" data-kid=\"1-2-4-2-2-2-2-1\">NZ$16.00</span><span class=\"meta\" data-kid=\"1-2-4-2-2-2-2-2\">Visa ···· 4242</span></td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-2-3\" data-name=\"purchase credits cell\">50</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-2-4\" data-name=\"credits remaining cell\"><span class=\"pack\" data-kid=\"1-2-4-2-2-2-4-1\"><span class=\"pack__meter\" data-kid=\"1-2-4-2-2-2-4-1-1\" style=\"--left:46%\"><i data-kid=\"1-2-4-2-2-2-4-1-1-1\"></i></span><span class=\"num\" data-kid=\"1-2-4-2-2-2-4-1-2\">23</span></span></td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-2-5\" data-name=\"receipt link cell\"><a class=\"textlink\" data-kid=\"1-2-4-2-2-2-5-1\" href=\"/billing\">Receipt</a></td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-3\" data-name=\"purchase table row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"purchase date cell\">12 September 2026</td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"purchase amount cell\"><span class=\"num\" data-kid=\"1-2-4-2-2-3-2-1\">NZ$8.00</span><span class=\"meta\" data-kid=\"1-2-4-2-2-3-2-2\">Visa ···· 4242</span></td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-3-3\" data-name=\"purchase credits cell\">20</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-3-4\" data-name=\"credits remaining cell\"><span class=\"pack\" data-kid=\"1-2-4-2-2-3-4-1\"><span class=\"pack__meter\" data-kid=\"1-2-4-2-2-3-4-1-1\" style=\"--left:0%\"><i data-kid=\"1-2-4-2-2-3-4-1-1-1\"></i></span><span class=\"num\" data-kid=\"1-2-4-2-2-3-4-1-2\">0</span></span></td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-3-5\" data-name=\"receipt link cell\"><a class=\"textlink\" data-kid=\"1-2-4-2-2-3-5-1\" href=\"/billing\">Receipt</a></td>\n</tr>\n</tbody>\n</table>\n<p class=\"table__foot\" data-kid=\"1-2-4-3\" data-name=\"purchases table footer totals\">3 purchases · NZ$56.00 · 190 Credits</p>\n</section>\n</main>\n</div>\n<div aria-hidden=\"true\" class=\"tip\" data-kid=\"2\" data-name=\"bar hover/detail popover\" id=\"cook-tip\" popover=\"manual\">\n<p class=\"tip__date\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"tooltip date text\" data-reason=\"text replaced by script from hovered bucket's data-date\" data-tip=\"date\">7–13 October 2026</p>\n<dl class=\"tip__rows\" data-kid=\"2-2\" data-name=\"tooltip metrics definition list\">\n<dt data-kid=\"2-2-1\">Gift-funded</dt><dd data-dynamic=\"true\" data-kid=\"2-2-2\" data-name=\"tooltip gift value\" data-reason=\"text replaced by script from hovered bucket's data-gift\" data-tip=\"gift\">2</dd>\n<dt data-kid=\"2-2-3\">Credit-funded</dt><dd data-dynamic=\"true\" data-kid=\"2-2-4\" data-name=\"tooltip credit value\" data-reason=\"text replaced by script from hovered bucket's data-credit\" data-tip=\"credit\">6</dd>\n<dt data-kid=\"2-2-5\">Cooks</dt><dd data-dynamic=\"true\" data-kid=\"2-2-6\" data-name=\"tooltip cooks total value\" data-reason=\"text replaced by script from hovered bucket's data-total\" data-tip=\"total\">8</dd>\n<dt data-kid=\"2-2-7\">Previous period</dt><dd data-dynamic=\"true\" data-kid=\"2-2-8\" data-name=\"tooltip previous period value\" data-reason=\"text replaced by script from hovered bucket's data-prev\" data-tip=\"prev\">5</dd>\n</dl>\n</div>\n<script>\n(function () {\n  var tip = document.getElementById('cook-tip');\n  if (!tip || !tip.showPopover) return;\n  var fields = {\n    date: tip.querySelector('[data-tip=\"date\"]'),\n    gift: tip.querySelector('[data-tip=\"gift\"]'),\n    credit: tip.querySelector('[data-tip=\"credit\"]'),\n    total: tip.querySelector('[data-tip=\"total\"]'),\n    prev: tip.querySelector('[data-tip=\"prev\"]')\n  };\n  var current = null;\n  var hideTimer = 0;\n  var pinned = false;\n\n  function open(el) {\n    if (!el || !el.dataset || !el.dataset.date) return;\n    if (current && current !== el) current.style.removeProperty('anchor-name');\n    current = el;\n    el.style.setProperty('anchor-name', '--tip');\n    tip.style.setProperty('position-anchor', '--tip');\n    fields.date.textContent = el.dataset.date;\n    fields.gift.textContent = el.dataset.gift;\n    fields.credit.textContent = el.dataset.credit;\n    fields.total.textContent = el.dataset.total;\n    fields.prev.textContent = el.dataset.prev;\n    if (!tip.matches(':popover-open')) tip.showPopover();\n  }\n\n  function close() {\n    if (pinned) return;\n    if (tip.matches(':popover-open')) tip.hidePopover();\n  }\n\n  var buckets = document.querySelectorAll('.bucket');\n  for (var i = 0; i < buckets.length; i++) {\n    (function (el) {\n      el.addEventListener('pointerenter', function () { clearTimeout(hideTimer); open(el); });\n      el.addEventListener('pointerleave', function () { clearTimeout(hideTimer); hideTimer = setTimeout(close, 140); });\n      el.addEventListener('focus', function () { open(el); });\n      el.addEventListener('blur', function () { pinned = false; close(); });\n      el.addEventListener('click', function () {\n        pinned = !pinned;\n        if (pinned) { clearTimeout(hideTimer); open(el); } else { close(); }\n      });\n    })(buckets[i]);\n  }\n\n  tip.addEventListener('pointerenter', function () { clearTimeout(hideTimer); });\n  tip.addEventListener('pointerleave', function () { hideTimer = setTimeout(close, 140); });\n\n  document.addEventListener('keydown', function (e) {\n    if (e.key === 'Escape') { pinned = false; close(); }\n  });\n\n  document.addEventListener('pointerdown', function (e) {\n    if (!pinned) return;\n    if (tip.contains(e.target)) return;\n    if (e.target.closest && e.target.closest('.bucket')) return;\n    pinned = false;\n    close();\n  });\n})();\n</script>\n",
