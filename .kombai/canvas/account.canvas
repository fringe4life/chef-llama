      "html": "<style>body{line-height:var(--leading-ui)}\n\n:root {\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.968 0.026 88), oklch(0.185 0.020 40));\n  --foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --card: light-dark(oklch(0.994 0.008 88), oklch(0.235 0.022 40));\n  --card-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --popover: var(--card);\n  --popover-foreground: var(--card-foreground);\n  --secondary: light-dark(oklch(0.940 0.038 86), oklch(0.262 0.024 42));\n  --secondary-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --muted: light-dark(oklch(0.936 0.034 86), oklch(0.258 0.022 42));\n  --muted-foreground: light-dark(oklch(0.470 0.040 48), oklch(0.745 0.032 80));\n  --primary: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --primary-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 32));\n  --accent: light-dark(oklch(0.520 0.150 138), oklch(0.780 0.140 138));\n  --accent-foreground: light-dark(oklch(0.985 0.010 90), oklch(0.200 0.040 138));\n  --destructive: light-dark(oklch(0.480 0.185 22), oklch(0.660 0.170 22));\n  --destructive-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 22));\n  --border: light-dark(oklch(0.885 0.030 70), oklch(0.330 0.022 45));\n  --input: light-dark(oklch(0.865 0.032 68), oklch(0.350 0.024 45));\n  --ring: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --chart-gift: light-dark(oklch(0.600 0.155 138), oklch(0.800 0.130 138));\n  --chart-credit: light-dark(oklch(0.460 0.165 25), oklch(0.560 0.150 25));\n  --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n  --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n  --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n  --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n  --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --text-4xl: calc(var(--font-base) * 2.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-11: calc(var(--spacing) * 11);\n  --space-12: calc(var(--spacing) * 12);\n  --space-13: calc(var(--spacing) * 13);\n  --space-14: calc(var(--spacing) * 14);\n  --space-15: calc(var(--spacing) * 15);\n  --space-16: calc(var(--spacing) * 16);\n  --space-17: calc(var(--spacing) * 17);\n  --space-18: calc(var(--spacing) * 18);\n  --space-19: calc(var(--spacing) * 19);\n  --space-20: calc(var(--spacing) * 20);}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\nbutton{font-family:var(--font-sans);line-height:var(--leading-ui)}\nb,strong{font-weight:700}</style><style>\n:root{\n  color-scheme: light dark;\n}\nbody{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans);font-size: var(--text-sm);line-height:var(--leading-ui);-webkit-font-smoothing:antialiased}\n.app h1,.app h2,.app p,.app ul,.app li,.app table{margin:0}\n.app ul{padding:0;list-style:none}\n.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;letter-spacing: var(--tracking-display)}\n\n.shell{\n  display:flex; align-items:center; gap: var(--space-7); block-size:64px; border-block-end:var(--border-width-thin) solid var(--border); box-sizing:border-box\n}\n.wordmark{font-size: var(--text-base);font-weight:700;letter-spacing: var(--tracking-display);color:var(--foreground);text-decoration:none}\n.nav{display:flex;align-items:center;gap: var(--space-6);margin-inline-start: var(--space-2)}\n.nav a{font-size: var(--text-sm);color:var(--muted-foreground);text-decoration:none;padding: var(--space-2) 0;border-block-end:var(--border-width-medium) solid transparent}\n.nav a[aria-current=\"page\"]{color:var(--foreground);border-bottom-color:var(--primary)}\n.shell__end{margin-inline-start:auto;display:flex;align-items:center}\n.avatar{display:grid;place-items:center;inline-size:30px;block-size:30px;border-radius:50%;background:var(--muted);border:var(--border-width-thin) solid var(--border);font-size: var(--text-xs);font-weight:700;color:var(--muted-foreground)}\n\n.page{\n  padding-block: var(--space-7) var(--space-14); box-sizing:border-box; container-type:inline-size; container-name:page\n}\n.page, .shell__row { box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page) }\n.shell__row { display: flex; align-items: center; gap: var(--space-7) }\n.page__head{display:flex;align-items:flex-end;gap: var(--space-4);flex-wrap:wrap}\n.page__head h1{font-size: var(--text-xl);font-weight:700;letter-spacing: var(--tracking-display);line-height:var(--leading-tight)}\n.asof{font-family:var(--font-mono);font-size: var(--text-xs);color:var(--muted-foreground);padding-bottom:3px}\n.page__cta{margin-inline-start:auto}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;block-size:36px;padding: 0 var(--space-4);border-radius:6px;border:var(--border-width-thin) solid transparent;background:var(--primary);color:var(--primary-foreground);font-family:var(--font-sans);font-size: var(--text-sm);font-weight:700;text-decoration:none;cursor:pointer;box-sizing:border-box;white-space:nowrap}\n.btn:hover{filter:brightness(1.05)}\n.btn:focus-visible{outline:var(--border-width-medium) solid var(--ring);outline-offset:2px}\n.btn--ghost{background:transparent;color:var(--foreground);border-color:var(--border)}\n.btn--ghost:hover{background:var(--muted);filter:none}\n.textlink{font-size: var(--text-xs);color:var(--foreground);text-decoration:none;border-block-end:var(--border-width-thin) solid var(--border);padding-bottom:1px}\n\n.band{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);margin-top: var(--space-6);border-block-start:var(--border-width-thin) solid var(--border);border-block-end:var(--border-width-thin) solid var(--border)}\n.band__cell{padding: var(--space-5) var(--space-6) var(--space-5) 0}\n.band__cell + .band__cell{border-inline-start:var(--border-width-thin) solid var(--border);padding-inline-start: var(--space-6)}\n.band__label{font-size: var(--text-xs);color:var(--muted-foreground)}\n.band__value{display:flex;align-items:baseline;gap: var(--space-2);margin-top:2px}\n.band__value b{font-size: var(--text-2xl);font-weight:700;line-height:var(--leading-tight)}\n.band__value span{font-size: var(--text-xs);color:var(--muted-foreground)}\n.band__note{font-size: var(--text-xs);color:var(--muted-foreground);margin-top: var(--space-1)}\n.gift{display:flex;flex-direction:column;align-items:flex-start;gap:2px}\n.gift__state{font-size: var(--text-base);font-weight:700;letter-spacing: var(--tracking-tight);margin-top:2px}\n.gift__state i{font-style:normal;display:inline-block;inline-size:7px;block-size:7px;border-radius:50%;background:var(--chart-gift);margin-inline-end: var(--space-2);vertical-align:2px}\n.gift__note{font-size: var(--text-xs);color:var(--muted-foreground);margin-top:2px}\n.gift .btn{margin-top: var(--space-3)}\n\n.section{margin-top: var(--space-7)}\n.section__head{display:flex;align-items:center;gap: var(--space-4);flex-wrap:wrap}\n.section__head h2{font-size: var(--text-sm);font-weight:700;letter-spacing: 0}\n.segmented{display:inline-flex;border:var(--border-width-thin) solid var(--border);border-radius:6px;overflow:hidden;margin-inline-start:auto}\n.segmented button{block-size:34px;padding: 0 var(--space-3);border:0;background:transparent;color:var(--muted-foreground);font-family:var(--font-sans);font-size: var(--text-xs);cursor:pointer}\n.segmented button + button{border-inline-start:var(--border-width-thin) solid var(--border)}\n.segmented button[aria-pressed=\"true\"]{background:var(--muted);color:var(--foreground);font-weight:700}\n\n.empty{margin-top: var(--space-4);padding: var(--space-9) 0 var(--space-8);border-block-start:var(--border-width-thin) solid var(--border);border-block-end:var(--border-width-thin) solid var(--border)}\n.empty__title{font-size: var(--text-sm);font-weight:700}\n.empty__note{font-size: var(--text-xs);color:var(--muted-foreground);margin-top: var(--space-1);max-inline-size:44ch}\n\n.table{inline-size:100%;border-collapse:collapse}\n.table th{block-size:36px;padding: 0 var(--space-3);font-size: var(--text-xs);font-weight:700;color:var(--muted-foreground);text-align:start;border-block-end:var(--border-width-thin) solid var(--border)}\n.table th:first-child{padding-inline-start:0}\n\n@container (inline-size <= 780px) {\n  \n  .nav{display:none}\n  \n  .band{grid-template-columns:minmax(0,1fr)}\n  .band__cell{padding: var(--space-4) 0}\n  .band__cell + .band__cell{border-inline-start:0;border-block-start:var(--border-width-thin) solid var(--border);padding-inline-start:0}\n  .page__cta{margin-inline-start:0;inline-size:100%}\n  .page__cta .btn{inline-size:100%}\n  .section__head .segmented{margin-inline-start:0}\n}\n\nbutton{font-family:var(--font-sans);line-height:var(--leading-ui)}\nb,strong{font-weight:700}</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"dashboard page app container\">\n<header class=\"shell\" data-kid=\"1-1\" data-name=\"top app navigation bar\">\n<div class=\"shell__row\">\n<a class=\"wordmark\" data-kid=\"1-1-1\" data-name=\"brand wordmark link\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n<a data-kid=\"1-1-2-1\" data-name=\"nav link to pantry\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" data-name=\"nav link to recipes\" href=\"/recipes\">Recipes</a>\n<a data-kid=\"1-1-2-3\" data-name=\"nav link to saved\" href=\"/saved\">Saved</a>\n<a aria-current=\"page\" data-kid=\"1-1-2-4\" data-name=\"active nav link to dashboard\" href=\"/dashboard\">Dashboard</a>\n<a data-kid=\"1-1-2-5\" data-name=\"nav link to billing\" href=\"/billing\">Billing</a>\n</nav>\n<div class=\"shell__end\" data-kid=\"1-1-3\" data-name=\"header right-side user area\"><span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-3-1\" data-name=\"user avatar monogram badge\">AR</span></div>\n</div>\n</header>\n<main class=\"page\" data-kid=\"1-2\" data-name=\"main dashboard content\">\n<div class=\"page__head\" data-kid=\"1-2-1\" data-name=\"page header with title and actions\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page title heading\">Dashboard</h1>\n<p class=\"asof\" data-kid=\"1-2-1-2\" data-name=\"as-of timestamp text\">4 November 2026, 9:14 am</p>\n<div class=\"page__cta\" data-kid=\"1-2-1-3\" data-name=\"page header call-to-action group\"><a class=\"btn btn--ghost\" data-kid=\"1-2-1-3-1\" data-name=\"ghost buy credits button\" href=\"/topup\">Buy Credits</a></div>\n</div>\n<section aria-label=\"Credit account\" class=\"band\" data-kid=\"1-2-2\" data-name=\"credit account summary band\">\n<div class=\"band__cell\" data-kid=\"1-2-2-1\" data-name=\"available credits cell\">\n<p class=\"band__label\" data-kid=\"1-2-2-1-1\" data-name=\"available credits label\">Available</p>\n<p class=\"band__value\" data-kid=\"1-2-2-1-2\" data-name=\"available credits value row\"><b class=\"num\" data-kid=\"1-2-2-1-2-1\" data-name=\"available credits count number\">0</b><span data-kid=\"1-2-2-1-2-2\" data-name=\"credits unit label\">Credits</span></p>\n<p class=\"band__note\" data-kid=\"1-2-2-1-3\" data-name=\"credits note text\">One Credit per cook.</p>\n</div>\n<div class=\"band__cell\" data-kid=\"1-2-2-2\" data-name=\"free cooks cell\">\n<div class=\"gift\" data-kid=\"1-2-2-2-1\" data-name=\"free cooks gift block\">\n<p class=\"band__label\" data-kid=\"1-2-2-2-1-1\" data-name=\"free cooks label\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-2-2-1-2\" data-name=\"free cooks available state line\"><i aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"status indicator dot\"></i>Available now</p>\n<p class=\"gift__note\" data-kid=\"1-2-2-2-1-3\" data-name=\"free cooks note text\">Until the shared daily pool runs out.</p>\n<a class=\"btn\" data-kid=\"1-2-2-2-1-4\" data-name=\"primary cook from pantry button\" href=\"/pantry\">Cook from the pantry</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"cooks-h\" class=\"section\" data-kid=\"1-2-3\" data-name=\"cooks section\">\n<div class=\"section__head\" data-kid=\"1-2-3-1\" data-name=\"cooks section header\">\n<h2 data-kid=\"1-2-3-1-1\" data-name=\"cooks section title\" id=\"cooks-h\">Cooks</h2>\n<div aria-label=\"Range\" class=\"segmented\" data-kid=\"1-2-3-1-2\" data-name=\"time range segmented control\" role=\"group\">\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-1\" data-name=\"one week range toggle button\" type=\"button\">1 week</button>\n<button aria-pressed=\"true\" data-kid=\"1-2-3-1-2-2\" data-name=\"one month range toggle button\" type=\"button\">1 month</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-3\" data-name=\"one year range toggle button\" type=\"button\">1 year</button>\n</div>\n</div>\n<div class=\"empty\" data-kid=\"1-2-3-2\" data-name=\"cooks empty state panel\">\n<p class=\"empty__title\" data-kid=\"1-2-3-2-1\" data-name=\"cooks empty state title\">No cooks yet.</p>\n<p class=\"empty__note\" data-kid=\"1-2-3-2-2\" data-name=\"cooks empty state note text\">The chart fills in once your first recipe is generated.</p>\n</div>\n</section>\n<section aria-labelledby=\"purchases-h\" class=\"section\" data-kid=\"1-2-4\" data-name=\"purchases section\">\n<div class=\"section__head\" data-kid=\"1-2-4-1\" data-name=\"purchases section header\"><h2 data-kid=\"1-2-4-1-1\" data-name=\"purchases section title\" id=\"purchases-h\">Purchases</h2></div>\n<div class=\"empty\" data-kid=\"1-2-4-2\" data-name=\"purchases empty state panel\">\n<p class=\"empty__title\" data-kid=\"1-2-4-2-1\" data-name=\"purchases empty state title\">No purchases yet.</p>\n<p class=\"empty__note\" data-kid=\"1-2-4-2-2\" data-name=\"purchases empty state note text\">The smallest pack is NZ$8 for 20 Credits.</p>\n</div>\n</section>\n</main>\n</div>\n",
