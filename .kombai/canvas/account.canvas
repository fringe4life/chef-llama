      },
      "html": "<style>body{line-height:var(--leading-ui)}\n\n:root {\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.968 0.026 88), oklch(0.185 0.020 40));\n  --foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --card: light-dark(oklch(0.994 0.008 88), oklch(0.235 0.022 40));\n  --card-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --popover: var(--card);\n  --popover-foreground: var(--card-foreground);\n  --secondary: light-dark(oklch(0.940 0.038 86), oklch(0.262 0.024 42));\n  --secondary-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --muted: light-dark(oklch(0.936 0.034 86), oklch(0.258 0.022 42));\n  --muted-foreground: light-dark(oklch(0.470 0.040 48), oklch(0.745 0.032 80));\n  --primary: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --primary-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 32));\n  --accent: light-dark(oklch(0.520 0.150 138), oklch(0.780 0.140 138));\n  --accent-foreground: light-dark(oklch(0.985 0.010 90), oklch(0.200 0.040 138));\n  --destructive: light-dark(oklch(0.480 0.185 22), oklch(0.660 0.170 22));\n  --destructive-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 22));\n  --border: light-dark(oklch(0.885 0.030 70), oklch(0.330 0.022 45));\n  --input: light-dark(oklch(0.865 0.032 68), oklch(0.350 0.024 45));\n  --ring: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --chart-gift: light-dark(oklch(0.600 0.155 138), oklch(0.800 0.130 138));\n  --chart-credit: light-dark(oklch(0.460 0.165 25), oklch(0.560 0.150 25));\n  --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n  --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n  --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n  --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n  --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n  --spacing: 0.25rem;\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-11: calc(var(--spacing) * 11);\n  --space-12: calc(var(--spacing) * 12);\n  --space-13: calc(var(--spacing) * 13);\n  --space-14: calc(var(--spacing) * 14);\n  --space-15: calc(var(--spacing) * 15);\n  --space-16: calc(var(--spacing) * 16);\n  --space-17: calc(var(--spacing) * 17);\n  --space-18: calc(var(--spacing) * 18);\n  --space-19: calc(var(--spacing) * 19);\n  --space-20: calc(var(--spacing) * 20);\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --text-4xl: calc(var(--font-base) * 2.5);\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\nbutton{font-family:var(--font-sans);line-height:var(--leading-ui)}\nb,strong{font-weight:700}</style><style>\n:root{\n  color-scheme: light dark;\n  --prev: light-dark(hsl(32 14% 60%), hsl(30 10% 46%));\n}\nbody{\n  margin:0;\n  background:var(--background);\n  color:var(--foreground);\n  font-family:var(--font-sans);\n  font-size:var(--text-sm);\n  line-height:var(--leading-ui);\n  -webkit-font-smoothing:antialiased;\n}\n.app h1,.app h2,.app p,.app dl,.app dd,.app dt,.app ul,.app li,.app table{margin:0}\n.app ul{padding:0;list-style:none}\n.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;letter-spacing: var(--tracking-display)}\n.serif{font-family:var(--font-display)}\n\n.shell{\n  display:flex; align-items:center; gap:var(--space-6); block-size:64px; border-block-end:var(--border-width-thin) solid var(--border); box-sizing:border-box\n}\n.wordmark{font-size:var(--text-base);font-weight:700;letter-spacing: var(--tracking-display);color:var(--foreground);text-decoration:none}\n.nav{display:flex;align-items:center;gap:var(--space-5);margin-inline-start:var(--space-2)}\n.nav a{font-size:var(--text-sm);color:var(--muted-foreground);text-decoration:none;padding:var(--space-1) 0;border-block-end:var(--border-width-medium) solid transparent}\n.nav a[aria-current=\"page\"]{color:var(--foreground);border-bottom-color:var(--primary)}\n.shell__end{margin-inline-start:auto;display:flex;align-items:center}\n.avatar{display:grid;place-items:center;inline-size:30px;block-size:30px;border-radius:50%;background:var(--muted);border:var(--border-width-thin) solid var(--border);font-size:var(--text-xs);font-weight:700;color:var(--muted-foreground)}\n\n.page{\n  padding-block: var(--space-6) var(--space-12); box-sizing:border-box; container-type:inline-size; container-name:page\n}\n.page, .shell__row { box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page) }\n.shell__row { display: flex; align-items: center; gap: var(--space-6) }\n.page__head{display:flex;align-items:flex-end;gap:var(--space-4);flex-wrap:wrap}\n.page__head h1{font-size:var(--text-xl);font-weight:700;letter-spacing: var(--tracking-display);line-height:var(--leading-tight)}\n.asof{font-family:var(--font-mono);font-size:var(--text-xs);color:var(--muted-foreground);padding-bottom:3px}\n.page__cta{margin-inline-start:auto;display:flex;gap:var(--space-2)}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;block-size:36px;padding:0 var(--space-4);border-radius:var(--radius-sm);border:var(--border-width-thin) solid transparent;background:var(--primary);color:var(--primary-foreground);font-family:var(--font-sans);font-size:var(--text-sm);font-weight:700;text-decoration:none;cursor:pointer;box-sizing:border-box;white-space:nowrap}\n.btn:hover{filter:brightness(1.05)}\n.btn:focus-visible{outline:var(--border-width-medium) solid var(--ring);outline-offset:2px}\n.btn--ghost{background:transparent;color:var(--foreground);border-color:var(--border)}\n.btn--ghost:hover{background:var(--muted);filter:none}\n\n.textlink{font-family:var(--font-sans);font-size:var(--text-xs);color:var(--foreground);text-decoration:none;border-block-end:var(--border-width-thin) solid var(--border);padding-bottom:1px}\n.textlink:hover{border-bottom-color:var(--foreground)}\n.textlink:focus-visible{outline:var(--border-width-medium) solid var(--ring);outline-offset:3px}\n\n/* account band: balance + free cooks */\n.band{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);margin-top:var(--space-5);border-block-start:var(--border-width-thin) solid var(--border);border-block-end:var(--border-width-thin) solid var(--border)}\n.band__cell{padding:var(--space-4) var(--space-6) var(--space-4) 0;container-type:inline-size;container-name:account}\n.band__cell + .band__cell{border-inline-start:var(--border-width-thin) solid var(--border);padding-inline-start:var(--space-6)}\n.band__label{font-size:var(--text-xs);color:var(--muted-foreground)}\n.band__value{display:flex;align-items:baseline;gap:var(--space-2);margin-top:2px}\n.band__value b{font-size:var(--text-2xl);font-weight:700;line-height:var(--leading-tight)}\n.band__value span{font-size:var(--text-xs);color:var(--muted-foreground)}\n.band__note{font-size:var(--text-xs);color:var(--muted-foreground);margin-top:var(--space-1)}\n\n.cell__row{display:flex;flex-direction:column;align-items:flex-start}\n.cell__aside{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-2);margin-top:var(--space-1)}\n.cell__aside .band__note{margin-top:0}\n.gift{display:flex;flex-direction:column;align-items:flex-start;gap:2px}\n.gift__state{font-size:var(--text-base);font-weight:700;letter-spacing: var(--tracking-tight);margin-top:2px}\n.gift__state i{font-style:normal;display:inline-block;inline-size:7px;block-size:7px;border-radius:50%;background:var(--chart-gift);margin-inline-end:var(--space-2);vertical-align:2px}\n.gift__note{font-size:var(--text-xs);color:var(--muted-foreground);margin-top:2px}\n.cell__row .btn{margin-top:var(--space-3)}\n\n@container account (inline-size >= 21rem){\n  .cell__row{flex-direction:row;align-items:flex-end;justify-content:space-between;gap:var(--space-6)}\n  .cell__aside{align-items:flex-end;text-align:end;margin-top:0;padding-bottom:3px}\n  .cell--gift .cell__row{align-items:center}\n  .cell__row .btn{margin-top:0;flex-shrink:0}\n}\n\n.section{margin-top:var(--space-6)}\n.section__head{display:flex;align-items:center;gap:var(--space-4);flex-wrap:wrap}\n.section__head h2{font-size:var(--text-sm);font-weight:700;letter-spacing: 0}\n.section__link{margin-inline-start:auto}\n\n.segmented{display:inline-flex;border:var(--border-width-thin) solid var(--border);border-radius:var(--radius-sm);overflow:hidden;margin-inline-start:auto}\n.segmented button{block-size:34px;padding:0 var(--space-3);border:0;background:transparent;color:var(--muted-foreground);font-family:var(--font-sans);font-size:var(--text-xs);cursor:pointer}\n.segmented button + button{border-inline-start:var(--border-width-thin) solid var(--border)}\n.segmented button[aria-pressed=\"true\"]{background:var(--muted);color:var(--foreground);font-weight:700}\n.segmented button:focus-visible{outline:var(--border-width-medium) solid var(--ring);outline-offset:-2px}\n\n.report{container-type:inline-size;container-name:report}\n.report__periods{font-family:var(--font-mono);font-size:var(--text-xs);color:var(--muted-foreground);margin-top:3px}\n\n.report__summary{display:flex;align-items:center;justify-content:space-between;gap:var(--space-5);flex-wrap:wrap;margin-top:var(--space-3);padding-bottom:var(--space-3);border-block-end:var(--border-width-thin) solid var(--border)}\n.stats{display:flex;align-items:baseline;gap:var(--space-5)}\n.stats li{display:flex;align-items:baseline;gap:var(--space-1)}\n.stats b{font-size:var(--text-base);font-weight:700}\n.stats span{font-size:var(--text-xs);color:var(--muted-foreground)}\n.stats em{font-style:normal;font-size:var(--text-xs);color:var(--muted-foreground);font-family:var(--font-mono)}\n\n.legend{display:flex;align-items:center;gap:var(--space-4);font-size:var(--text-xs);color:var(--muted-foreground);flex-wrap:wrap}\n.legend li{display:inline-flex;align-items:center;gap:var(--space-2)}\n.swatch{inline-size:10px;block-size:10px;border-radius:1px;display:inline-block}\n.swatch--gift{background:var(--chart-gift)}\n.swatch--credit{background:var(--primary)}\n.swatch--prev{background:linear-gradient(to top, color-mix(in oklab, var(--chart-gift) 38%, var(--background)) 0 50%, color-mix(in oklab, var(--primary) 38%, var(--background)) 50% 100%)}\n\n.plot{display:grid;grid-template-columns:26px minmax(0,1fr);column-gap:var(--space-2);margin-top:var(--space-5);padding-bottom:var(--space-8)}\n.plot__y{position:relative;block-size:200px}\n.plot__y span{position:absolute;inset-inline-end:0;inset-block-end:calc(var(--t) / var(--max) * 100%);transform:translateY(50%);font-family:var(--font-mono);font-size:var(--text-xs);color:var(--muted-foreground)}\n.bars{position:relative;block-size:196px;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);align-items:end;border-block-end:var(--border-width-thin) solid var(--border)}\n.bars::before{content:\"\";position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(to top, var(--border) 0 1px, transparent 1px calc(100% / var(--max)))}\n.bucket{position:relative;block-size:100%;padding:0;border:0;background:none;display:flex;align-items:flex-end;justify-content:center;font-family:var(--font-sans);cursor:default}\n.bucket:focus-visible{outline:var(--border-width-medium) solid var(--ring);outline-offset:-1px}\n.bucket__prev{position:absolute;inset-block-end:0;inset-inline-start:50%;transform:translateX(-50%);inline-size:70%;max-inline-size:118px;block-size:calc(var(--v) / var(--max) * 100%);background:linear-gradient(to top, color-mix(in oklab, var(--chart-gift) 30%, var(--background)) 0 calc(var(--pg, 40) * 1%), color-mix(in oklab, var(--primary) 30%, var(--background)) calc(var(--pg, 40) * 1%) 100%)}\n.bucket__stack{position:relative;inline-size:44%;max-inline-size:74px;block-size:100%;display:flex;flex-direction:column-reverse;gap:2px}\n.bucket__gift{block-size:calc(var(--v) / var(--max) * 100%);background:var(--chart-gift)}\n.bucket__credit{block-size:calc(var(--v) / var(--max) * 100%);background:var(--primary)}\n.bucket__value{position:absolute;inset-inline-start:50%;transform:translateX(-50%);inset-block-end:calc(var(--total) / var(--max) * 100% + 6px);font-family:var(--font-mono);font-size:var(--text-xs);font-weight:400;color:var(--foreground)}\n.bucket__label{position:absolute;inset-block-start:100%;margin-top:var(--space-2);inset-inline-start:50%;transform:translateX(-50%);font-family:var(--font-display);font-size:var(--text-xs);color:var(--muted-foreground);white-space:nowrap}\n\n.tip{position-anchor:--tip;position-area:top;position-try-fallbacks:flip-block,flip-inline;margin:0 0 var(--space-2);padding:var(--space-3);inline-size:max-content;max-inline-size:260px;background:var(--card);color:var(--foreground);border:var(--border-width-thin) solid var(--border);border-radius:var(--radius-md);box-shadow:0 8px 24px -12px hsl(30 30% 10% / .35);font-size:var(--text-xs)}\n.tip__date{font-family:var(--font-mono);font-weight:700;margin-bottom:var(--space-2);font-size:var(--text-xs)}\n.tip__rows{display:grid;grid-template-columns:auto auto;gap:var(--space-1) var(--space-4)}\n.tip__rows dt{color:var(--muted-foreground)}\n.tip__rows dd{text-align:end;font-family:var(--font-mono);font-weight:400}\n@supports not (position-area: top){\n  .tip{position:fixed;inset:auto auto 24px 24px;margin:0}\n}\n\n.table{inline-size:100%;border-collapse:collapse}\n.table th{block-size:36px;padding:0 var(--space-3);vertical-align:middle;font-size:var(--text-xs);font-weight:700;color:var(--muted-foreground);text-align:start;border-block-end:var(--border-width-thin) solid var(--border);white-space:nowrap}\n.table td{block-size:40px;padding:0 var(--space-3);vertical-align:middle;font-size:var(--text-sm);border-block-end:var(--border-width-thin) solid var(--border)}\n.table th:first-child,.table td:first-child{padding-inline-start:0}\n.table th:last-child,.table td:last-child{padding-inline-end:0}\n.table .r{text-align:end}\n.table td.t-date{font-family:var(--font-mono);font-size:var(--text-sm)}\n.table__foot{display:flex;gap:var(--space-2);align-items:baseline;padding-top:var(--space-3);font-size:var(--text-xs);color:var(--muted-foreground);font-family:var(--font-mono)}\n.meta{display:block;margin-top:1px;font-family:var(--font-sans);font-size:var(--text-xs);color:var(--muted-foreground);letter-spacing:0}\n.table{table-layout:fixed}\n.table th:nth-child(1){inline-size:25%}\n.table th:nth-child(2){inline-size:17%}\n.table th:nth-child(3){inline-size:11%}\n.table th:nth-child(4){inline-size:33%}\n.table th:nth-child(5){inline-size:14%}\n.pack{display:flex;align-items:center;gap:var(--space-2);inline-size:100%}\n.pack__meter{position:relative;flex:1;min-inline-size:52px;block-size:4px;border-radius:1px;background:var(--muted);box-shadow:inset 0 0 0 var(--border-width-thin) var(--border);overflow:hidden}\n.pack__meter i{position:absolute;inset-inline-start:0;inset-block-start:0;inset-block-end:0;inline-size:var(--left,50%);background:var(--primary)}\n.pack .num{min-inline-size:34px;text-align:end}\n.vh{position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;font-size:var(--text-xs)}\n\n@container (inline-size <= 800px) {\n  \n  \n  .report__summary{gap:var(--space-3)}\n  .stats{gap:var(--space-4);flex-wrap:wrap}\n  .col--ref{display:none}\n}\n@container (inline-size <= 680px) {\n  .nav{display:none}\n  .band{grid-template-columns:minmax(0,1fr)}\n  .band__cell{padding:var(--space-4) 0}\n  .band__cell + .band__cell{border-inline-start:0;border-block-start:var(--border-width-thin) solid var(--border);padding-inline-start:0}\n  .section__head .segmented{margin-inline-start:0}\n}\n@container (inline-size <= 460px) {\n  \n  .page__cta{margin-inline-start:0;inline-size:100%}\n  .page__cta .btn{inline-size:100%}\n}\n\nbutton{font-family:var(--font-sans);line-height:var(--leading-ui)}\nb,strong{font-weight:700}</style>\n<div class=\"app\" data-kid=\"1\">\n<header class=\"shell\" data-kid=\"1-1\">\n<div class=\"shell__row\">\n<a class=\"wordmark\" data-kid=\"1-1-1\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-2\">\n<a data-kid=\"1-1-2-1\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" href=\"/recipes\">Recipes</a>\n<a data-kid=\"1-1-2-3\" href=\"/saved\">Save