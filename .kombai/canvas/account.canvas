      "html": "<style>body{line-height:var(--leading-ui)}\n\n:root {\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.968 0.026 88), oklch(0.185 0.020 40));\n  --foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --card: light-dark(oklch(0.994 0.008 88), oklch(0.235 0.022 40));\n  --card-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --popover: var(--card);\n  --popover-foreground: var(--card-foreground);\n  --secondary: light-dark(oklch(0.940 0.038 86), oklch(0.262 0.024 42));\n  --secondary-foreground: light-dark(oklch(0.255 0.045 45), oklch(0.945 0.030 85));\n  --muted: light-dark(oklch(0.936 0.034 86), oklch(0.258 0.022 42));\n  --muted-foreground: light-dark(oklch(0.470 0.040 48), oklch(0.745 0.032 80));\n  --primary: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --primary-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 32));\n  --accent: light-dark(oklch(0.520 0.150 138), oklch(0.780 0.140 138));\n  --accent-foreground: light-dark(oklch(0.985 0.010 90), oklch(0.200 0.040 138));\n  --destructive: light-dark(oklch(0.480 0.185 22), oklch(0.660 0.170 22));\n  --destructive-foreground: light-dark(oklch(0.990 0.010 90), oklch(0.190 0.045 22));\n  --border: light-dark(oklch(0.885 0.030 70), oklch(0.330 0.022 45));\n  --input: light-dark(oklch(0.865 0.032 68), oklch(0.350 0.024 45));\n  --ring: light-dark(oklch(0.505 0.180 32), oklch(0.700 0.170 33));\n  --chart-gift: light-dark(oklch(0.600 0.155 138), oklch(0.800 0.130 138));\n  --chart-credit: light-dark(oklch(0.460 0.165 25), oklch(0.560 0.150 25));\n  --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n  --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n  --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n  --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n  --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --text-4xl: calc(var(--font-base) * 2.5);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-11: calc(var(--spacing) * 11);\n  --space-12: calc(var(--spacing) * 12);\n  --space-13: calc(var(--spacing) * 13);\n  --space-14: calc(var(--spacing) * 14);\n  --space-15: calc(var(--spacing) * 15);\n  --space-16: calc(var(--spacing) * 16);\n  --space-17: calc(var(--spacing) * 17);\n  --space-18: calc(var(--spacing) * 18);\n  --space-19: calc(var(--spacing) * 19);\n  --space-20: calc(var(--spacing) * 20);}\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\nbutton{font-family:var(--font-sans);line-height:var(--leading-ui)}\nb,strong{font-weight:700}</style><style>\n:root{\n  color-scheme: light dark;\n}\nbody{\n  margin:0;\n  background:var(--background);\n  color:var(--foreground);\n  font-family:var(--font-sans);\n  font-size: var(--text-sm);\n  line-height:var(--leading-ui);\n  -webkit-font-smoothing:antialiased;\n}\np,ul{margin:0}\nul{padding:0;list-style:none}\n.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;letter-spacing: var(--tracking-display)}\n\n.sheet{\n  padding-block: var(--space-11) var(--space-15); box-sizing:border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n.sheet h1{margin:0;font-size: var(--text-xl);font-weight:700;letter-spacing: var(--tracking-display)}\n.grid{display:grid;grid-template-columns:1fr 1fr;margin-top: var(--space-6);border-block-start:var(--border-width-thin) solid var(--border)}\n.spec{\n  padding: var(--space-6) var(--space-7) var(--space-7);\n  container-type:inline-size;\n  container-name:account;\n  border-block-end:var(--border-width-thin) solid var(--border);\n  box-sizing:border-box;\n}\n.spec:nth-child(2n){border-inline-start:var(--border-width-thin) solid var(--border)}\n.spec__name{font-family:var(--font-mono);font-size: var(--text-xs);color:var(--muted-foreground)}\n\n.cell__row{display:flex;flex-direction:column;align-items:flex-start;margin-top: var(--space-3)}\n.cell__aside{display:flex;flex-direction:column;align-items:flex-start;gap: var(--space-2);margin-top: var(--space-4)}\n.band__label{font-size: var(--text-xs);color:var(--muted-foreground)}\n.gift__state{display:flex;align-items:center;gap: var(--space-2);font-size: var(--text-base);font-weight:700;letter-spacing: var(--tracking-tight);margin-top:3px}\n.gift__note{font-size: var(--text-xs);color:var(--muted-foreground);margin-top: var(--space-1)}\n\n.dot{flex:none;display:inline-block;inline-size:7px;block-size:7px;border-radius:50%;background:var(--chart-gift)}\n.dot--warn{background:var(--destructive);box-shadow:0 0 0 3px color-mix(in oklab, var(--destructive) 18%, transparent)}\n.dot--used{background:transparent;box-shadow:inset 0 0 0 var(--border-width-medium) var(--muted-foreground)}\n.dot--failed{inline-size:8px;block-size:8px;background:transparent;border:var(--border-width-thin) dashed var(--muted-foreground)}\n\n.pips{display:flex;gap:3px;margin-top: var(--space-2)}\n.pips li{inline-size:13px;block-size:5px;border-radius:1px;background:transparent;box-shadow:inset 0 0 0 var(--border-width-thin) var(--border)}\n.pips li.on{background:var(--destructive);box-shadow:none}\n.pips--gift li.on{background:var(--chart-gift)}\n\n.btn{\n  display:inline-flex;align-items:center;justify-content:center;block-size:36px;padding: 0 var(--space-4);\n  border-radius:6px;border:var(--border-width-thin) solid transparent;background:var(--primary);color:var(--primary-foreground);\n  font-family:var(--font-sans);font-size: var(--text-sm);font-weight:700;text-decoration:none;white-space:nowrap;box-sizing:border-box;\n}\n.btn--ink{background:var(--foreground);color:var(--background)}\n.btn:focus-visible{outline:var(--border-width-medium) solid var(--ring);outline-offset:3px}\n\n@container account (inline-size >= 21rem){\n  .cell__row{flex-direction:row;align-items:flex-end;justify-content:space-between;gap: var(--space-7)}\n  .cell__aside{align-items:flex-end;text-align:end;margin-top:0;padding-bottom:3px}\n  .cell__row .btn{flex:none}\n}\n\nbutton{font-family:var(--font-sans);line-height:var(--leading-ui)}\nb,strong{font-weight:700}</style>\n<div class=\"sheet\" data-kid=\"1\">\n<h1 data-kid=\"1-1\">Free cooks</h1>\n<div class=\"grid\" data-kid=\"1-2\">\n<section class=\"spec\" data-kid=\"1-2-1\">\n<p class=\"spec__name\" data-kid=\"1-2-1-1\">Available</p>\n<div class=\"cell__row\" data-kid=\"1-2-1-2\">\n<div class=\"gift\" data-kid=\"1-2-1-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-1-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-1-2-1-2\"><i class=\"dot\" data-kid=\"1-2-1-2-1-2-1\"></i><span data-kid=\"1-2-1-2-1-2-2\"><b class=\"num\" data-kid=\"1-2-1-2-1-2-2-1\">3</b> left today</span></p>\n<ul aria-hidden=\"true\" class=\"pips pips--gift\" data-kid=\"1-2-1-2-1-3\"><li class=\"on\" data-kid=\"1-2-1-2-1-3-1\"></li><li class=\"on\" data-kid=\"1-2-1-2-1-3-2\"></li><li class=\"on\" data-kid=\"1-2-1-2-1-3-3\"></li></ul>\n<p class=\"gift__note\" data-kid=\"1-2-1-2-1-4\">Resets 5:00 am.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-1-2-2\">\n<a class=\"btn\" data-kid=\"1-2-1-2-2-1\" href=\"/pantry\">Cook free</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-2\">\n<p class=\"spec__name\" data-kid=\"1-2-2-1\">Few left</p>\n<div class=\"cell__row\" data-kid=\"1-2-2-2\">\n<div class=\"gift\" data-kid=\"1-2-2-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-2-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-2-2-1-2\"><i class=\"dot dot--warn\" data-kid=\"1-2-2-2-1-2-1\"></i><span data-kid=\"1-2-2-2-1-2-2\" data-name=\"free cook low-availability status line with count\">Only <b class=\"num\" data-kid=\"1-2-2-2-1-2-2-1\">1</b> left today</span></p>\n<ul aria-hidden=\"true\" class=\"pips\" data-kid=\"1-2-2-2-1-3\"><li class=\"on\" data-kid=\"1-2-2-2-1-3-1\"></li><li data-kid=\"1-2-2-2-1-3-2\"></li><li data-kid=\"1-2-2-2-1-3-3\"></li></ul>\n<p class=\"gift__note\" data-kid=\"1-2-2-2-1-4\">Resets 5:00 am.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-2-2-2\">\n<a class=\"btn\" data-kid=\"1-2-2-2-2-1\" href=\"/pantry\">Cook free</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-3\">\n<p class=\"spec__name\" data-kid=\"1-2-3-1\" data-name=\"state label for no free cooks remaining\">None left</p>\n<div class=\"cell__row\" data-kid=\"1-2-3-2\">\n<div class=\"gift\" data-kid=\"1-2-3-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-3-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-3-2-1-2\" data-name=\"no free cooks today status line\"><i class=\"dot dot--used\" data-kid=\"1-2-3-2-1-2-1\"></i>No free cooks today</p>\n<p class=\"gift__note\" data-kid=\"1-2-3-2-1-3\" data-name=\"daily reset helper note\">Resets 5:00 am.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-3-2-2\">\n<a class=\"btn btn--ink\" data-kid=\"1-2-3-2-2-1\" data-name=\"cook call-to-action link\" href=\"/pantry\">Cook</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-4\" data-name=\"none left no credits spec card\">\n<p class=\"spec__name\" data-kid=\"1-2-4-1\" data-name=\"state label for no free cooks and no credits\">None left, no Credits</p>\n<div class=\"cell__row\" data-kid=\"1-2-4-2\">\n<div class=\"gift\" data-kid=\"1-2-4-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-4-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-4-2-1-2\" data-name=\"no free cooks today status line\"><i class=\"dot dot--used\" data-kid=\"1-2-4-2-1-2-1\"></i>No free cooks today</p>\n<p class=\"gift__note\" data-kid=\"1-2-4-2-1-3\" data-name=\"zero credits remaining note\">0 Credits left.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-4-2-2\">\n<a class=\"btn btn--ink\" data-kid=\"1-2-4-2-2-1\" data-name=\"buy credits call-to-action link\" href=\"/topup\">Buy Credits</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-5\" data-name=\"lookup failed full-width spec card\" style=\"grid-column:1 / -1\">\n<p class=\"spec__name\" data-kid=\"1-2-5-1\" data-name=\"lookup failed state label\">Lookup failed</p>\n<div class=\"cell__row\" data-kid=\"1-2-5-2\">\n<div class=\"gift\" data-kid=\"1-2-5-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-5-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-5-2-1-2\" data-name=\"error status line with failed dot\"><i class=\"dot dot--failed\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"failed lookup status dot\"></i>Couldn't check</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-5-2-2\">\n<button class=\"btn\" data-kid=\"1-2-5-2-2-1\" data-name=\"try again retry button\" type=\"button\">Try again</button>\n</div>\n</div>\n</section>\n</div>\n</div>\n",
