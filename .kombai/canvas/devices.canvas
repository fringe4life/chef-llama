ir fryer body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-air\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-1-2-8-1-2\" data-name=\"air fryer basket layer\" viewbox=\"0 0 24 24\"><use href=\"#p-air\"></use></svg></span><span class=\"tile__n\" data-kid=\"2-7-1-1-2-8-2\" data-name=\"air fryer tile name\">Air fryer</span></label>\n<input class=\"in\" data-kid=\"2-7-1-1-2-9\" data-name=\"slow cooker kitchen checkbox\" id=\"o-slow\" type=\"checkbox\"/><label class=\"tile m-slow\" data-kid=\"2-7-1-1-2-10\" data-name=\"slow cooker kitchen tile\" for=\"o-slow\"><span class=\"ic ic48\" data-kid=\"2-7-1-1-2-10-1\" data-name=\"48px slow cooker icon\"><svg class=\"lay body\" data-kid=\"2-7-1-1-2-10-1-1\" data-name=\"slow cooker body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-slow\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-1-2-10-1-2\" data-name=\"slow cooker lid layer\" viewbox=\"0 0 24 24\"><use href=\"#p-slow\"></use></svg><svg class=\"lay tend\" data-kid=\"2-7-1-1-2-10-1-3\" data-name=\"hidden steam layer\" viewbox=\"0 0 24 24\"><use href=\"#s-slow\"></use></svg></span><span class=\"tile__n\" data-kid=\"2-7-1-1-2-10-2\" data-name=\"slow cooker tile name\">Slow cooker</span></label>\n<input class=\"in\" data-kid=\"2-7-1-1-2-11\" data-name=\"pressure cooker kitchen checkbox\" id=\"o-press\" type=\"checkbox\"/><label class=\"tile m-press\" data-kid=\"2-7-1-1-2-12\" data-name=\"pressure cooker kitchen tile\" for=\"o-press\"><span class=\"ic ic48\" data-kid=\"2-7-1-1-2-12-1\" data-name=\"48px pressure cooker icon\"><svg class=\"lay body\" data-kid=\"2-7-1-1-2-12-1-1\" data-name=\"pressure cooker body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-press\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-1-2-12-1-2\" data-name=\"pressure cooker weight layer\" viewbox=\"0 0 24 24\"><use href=\"#p-press\"></use></svg><svg class=\"lay tend\" data-kid=\"2-7-1-1-2-12-1-3\" data-name=\"hidden steam layer\" viewbox=\"0 0 24 24\"><use href=\"#s-press\"></use></svg></span><span class=\"tile__n\" data-kid=\"2-7-1-1-2-12-2\" data-name=\"pressure cooker tile name\">Pressure cooker</span></label>\n<input class=\"in\" data-kid=\"2-7-1-1-2-13\" data-name=\"grill kitchen checkbox\" id=\"o-grill\" type=\"checkbox\"/><label class=\"tile m-grill\" data-kid=\"2-7-1-1-2-14\" data-name=\"grill kitchen tile\" for=\"o-grill\"><span class=\"ic ic48\" data-kid=\"2-7-1-1-2-14-1\" data-name=\"48px grill icon\"><svg class=\"lay body\" data-kid=\"2-7-1-1-2-14-1-1\" data-name=\"grill body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-grill\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-1-2-14-1-2\" data-name=\"grill grate layer\" viewbox=\"0 0 24 24\"><use href=\"#p-grill\"></use></svg><svg class=\"lay tend\" data-kid=\"2-7-1-1-2-14-1-3\" data-name=\"hidden steam layer\" viewbox=\"0 0 24 24\"><use href=\"#s-grill\"></use></svg></span><span class=\"tile__n\" data-kid=\"2-7-1-1-2-14-2\" data-name=\"grill tile name\">Grill</span></label>\n<input class=\"in\" data-kid=\"2-7-1-1-2-15\" data-name=\"no cook kitchen checkbox\" id=\"o-nocook\" type=\"checkbox\"/><label class=\"tile m-nocook\" data-kid=\"2-7-1-1-2-16\" data-name=\"no cook kitchen tile\" for=\"o-nocook\"><span class=\"ic ic48\" data-kid=\"2-7-1-1-2-16-1\" data-name=\"48px no cook bowl icon\"><svg class=\"lay body\" data-kid=\"2-7-1-1-2-16-1-1\" data-name=\"no cook bowl body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-nocook\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-1-2-16-1-2\" data-name=\"no cook leaves layer\" viewbox=\"0 0 24 24\"><use href=\"#p-nocook\"></use></svg></span><span class=\"tile__n\" data-kid=\"2-7-1-1-2-16-2\" data-name=\"no cook tile name\">No cook</span></label>\n</div>\n</div>\n<div class=\"card\" data-kid=\"2-7-1-2\" data-name=\"cooking state card\">\n<div class=\"card__head\" data-kid=\"2-7-1-2-1\" data-name=\"cooking state card header\">\n<span class=\"card__h\" data-kid=\"2-7-1-2-1-1\" data-name=\"cooking state card title\">Cooking state</span>\n<span class=\"card__hint\" data-kid=\"2-7-1-2-1-2\" data-name=\"cooking state card hint\">An uncooked one is cooked through, so the time and the device change.</span>\n</div>\n<div class=\"prs\" data-kid=\"2-7-1-2-2\" data-name=\"cooking state list\">\n<div class=\"pr\" data-kid=\"2-7-1-2-2-1\" data-name=\"rice cooking row item\">\n<span class=\"pr__n\" data-kid=\"2-7-1-2-2-1-1\" data-name=\"rice food name\">rice</span>\n<span class=\"pr__m\" data-kid=\"2-7-1-2-2-1-2\" data-name=\"rice device with icon\"><span class=\"ic ic20 m-sauce\" data-kid=\"2-7-1-2-2-1-2-1\" data-name=\"20px saucepan icon\"><svg class=\"lay body\" data-kid=\"2-7-1-2-2-1-2-1-1\" data-name=\"saucepan body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-sauce\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-2-2-1-2-1-2\" data-name=\"saucepan lid layer\" viewbox=\"0 0 24 24\"><use href=\"#p-sauce\"></use></svg></span>Saucepan</span>\n<span class=\"pr__s\" data-kid=\"2-7-1-2-2-1-3\" data-name=\"rice cooking state\">uncooked</span>\n<span class=\"pr__t\" data-kid=\"2-7-1-2-2-1-4\" data-name=\"rice cooking time\">18 min</span>\n</div>\n<div class=\"pr\" data-kid=\"2-7-1-2-2-2\" data-name=\"chicken cooking row item\">\n<span class=\"pr__n\" data-kid=\"2-7-1-2-2-2-1\" data-name=\"chicken food name\">chicken</span>\n<span class=\"pr__m\" data-kid=\"2-7-1-2-2-2-2\" data-name=\"chicken device with icon\"><span class=\"ic ic20 m-fry\" data-kid=\"2-7-1-2-2-2-2-1\" data-name=\"20px fry pan icon\"><svg class=\"lay body\" data-kid=\"2-7-1-2-2-2-2-1-1\" data-name=\"fry pan body layer\" viewbox=\"0 0 24 24\"><use href=\"#b-fry\"></use></svg><svg class=\"lay part\" data-kid=\"2-7-1-2-2-2-2-1-2\" data-name=\"fry pan food layer\" viewbox=\"0 0 24 24\"><use href=\"#p-fry\"></use></svg></span>Fry pan</span>\n<span class=\"pr__s\" data-kid=\"2-7-1-2-2-2-3\" data-name=\"chicken cooking state\">already cooked</span>\n<span class=\"pr__t\" data-kid=\"2-7-1-2-2-2-4\" data-name=\"chicken cooking time\">8 min</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>",
      "comments": [],
      "created": "2026-11-22T08:34:51.891133+00:00",
      "modified": "2026-11-22T08:48:12.373289+00:00",
      "id": "var_bddceaa70a98",
      "contentHeight": 853
    },
    "var_570432bfac83": {
      "type": "variant",
      "label": "Devices E — the tile fills from the mark, the rank seals in",
      "parentId": "var_bddceaa70a98",
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n  --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n  --box-line: color-mix(in oklab, var(--input) 74%, var(--foreground));\n\n  --ease-arrive: linear(0, 0.264 6.25%, 0.38 9.375%, 0.482 12.5%, 0.571 15.625%, 0.647 18.75%, 0.765 25%, 0.829 29.688%, 0.876 34.375%, 0.937 43.75%, 0.98 57.813%, 0.998 78.906%, 1);\n  --ease-depart: linear(0, 0.002 21.094%, 0.02 42.188%, 0.063 56.25%, 0.124 65.625%, 0.171 70.313%, 0.235 75%, 0.353 81.25%, 0.429 84.375%, 0.518 87.5%, 0.62 90.625%, 0.736 93.75%, 1);\n  --ease-glide: linear(0, 0.002 3.125%, 0.01 6.25%, 0.022 9.375%, 0.039 12.5%, 0.085 18.75%, 0.148 25%, 0.211 30.273%, 0.282 35.547%, 0.368 41.479%, 0.643 59.277%, 0.756 67.188%, 0.843 74.219%, 0.881 77.734%, 0.915 81.25%, 0.951 85.938%, 0.978 90.625%, 0.994 95.313%, 1);\n  --ease-squish: linear(0, 0.389 8.5%, 0.692 17.4%, 0.912 26.8%, 0.992 31.7%, 1.054 36.8%, 1.092 41.3%, 1.117 46%, 1.13 51%, 1.131 56.3%, 1.108 66%, 1.018 88.8%, 1);\n  --ease-anticipate: linear(0, -0.006 5.6%, -0.038 17.6%, -0.04 22.9%, -0.016 29%, 0.042 34.5%, 0.131 39.3%, 0.254 43.8%, 0.654 53.6%, 0.803 58.1%, 0.92 63.2%, 0.996 68.6%, 1.03 73.4%, 1.041 78.7%, 1);\n  --ease-linear: linear(0, 1);\n  --duration-tick: 100ms;\n  --duration-quick: 160ms;\n  --duration-base: 250ms;\n  --duration-slow: 400ms;\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-10: calc(var(--spacing) * 10);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n@media (width >= 48rem){ :root{ --space-page: var(--space-8, calc(var(--spacing) * 8)); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,figure{ margin: 0; }\n.frame{ inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.sheet{ padding-block: var(--space-6) var(--space-10); }\n\n.bar{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.head{ padding-block: var(--space-3) var(--space-4); border-block-end: var(--border-width-thin) solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n.stack{ display: grid; gap: var(--space-10); margin-block-start: var(--space-6); }\n.block{ display: grid; gap: var(--space-4); }\nh2{ font-size: var(--text-base); font-weight: 700; letter-spacing: var(--tracking-tight); }\n\n/* ── the picker ───────────────────────────────────────────────────────── */\n.picker{ display: grid; gap: var(--space-3); padding: var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--background); }\n.hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.rail{ display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); }\n.in{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }\n\n.tile{\n  --slot: 20px;\n  --slot-inset: var(--space-2);\n  --fill-x: calc(100% - var(--slot-inset) - var(--slot) / 2);\n  --fill-y: calc(var(--slot-inset) + var(--slot) / 2);\n  --surface: var(--card);\n  --food: color-mix(in oklab, var(--primary) 66%, var(--foreground));\n  --leaf: var(--accent);\n  --steam: color-mix(in oklab, var(--foreground) 42%, var(--background));\n  position: relative;\n  display: grid; justify-items: center; align-content: center; gap: var(--space-2);\n  padding: var(--space-4) var(--space-2);\n  border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm);\n  background: var(--surface); color: var(--foreground);\n  cursor: pointer; overflow: hidden;\n  transition: background-color var(--duration-tick) var(--ease-linear),\n              border-color var(--duration-tick) var(--ease-linear),\n              transform var(--duration-quick) var(--ease-squish);\n}\n.tile__wash{\n  position: absolute; inset: 0; z-index: 1;\n  background: var(--primary);\n  clip-path: circle(0% at var(--fill-x) var(--fill-y));\n  transition: clip-path var(--duration-quick) var(--ease-depart);\n}\n.tile__name{\n  position: relative; z-index: 2;\n  font-size: var(--text-xs); line-height: var(--leading-tight); text-align: center; text-wrap: balance;\n  transition: color var(--duration-tick) var(--ease-linear);\n}\n.tile__rank{\n  position: absolute; inset-block-start: var(--slot-inset); inset-inline-end: var(--slot-inset); z-index: 3;\n  display: grid; place-items: center;\n  inline-size: var(--slot); block-size: var(--slot);\n}\n.tile__pocket{\n  position: absolute; inset: 0;\n  background: var(--box-line);\n  clip-path: polygon(4% 2%, 98% 6%, 99% 94%, 2% 99%);\n  transition: background-color var(--duration-tick) var(--ease-linear);\n}\n.tile__pocket::before{\n  content: \"\"; position: absolute; inset: 1px;\n  background: var(--surface);\n  clip-path: inherit;\n  transition: background-color var(--duration-tick) var(--ease-linear);\n}\n.tile__num{\n  position: relative; z-index: 1;\n  font-family: var(--font-mono); font-size: var(--text-2xs); line-height: 1; font-variant-numeric: tabular-nums;\n  color: var(--primary);\n  opacity: 0; transform: scale(0.4);\n}\n\n.tile:not(.is-static):hover{ --surface: var(--secondary); background: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.tile:not(.is-static):active{ --surface: var(--muted); background: var(--muted); transform: translateY(1px); }\n.in:focus-visible + .tile{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n.in:checked + .tile{\n  border-color: var(--primary);\n  color: var(--primary-foreground);\n  --food: color-mix(in oklab, var(--background) 82%, var(--primary));\n  --steam: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n}\n.in:checked + .tile .tile__wash{\n  clip-path: circle(150% at var(--fill-x) var(--fill-y));\n  transition: clip-path var(--duration-base) var(--ease-arrive);\n}\n.in:checked + .tile .tile__name{ color: var(--primary-foreground); transition: color var(--duration-tick) var(--ease-linear) var(--duration-quick); }\n.in:checked + .tile .tile__pocket{ background: var(--primary-foreground); animation: rank-seal var(--duration-quick) var(--ease-squish) both; }\n.in:checked + .tile .tile__pocket::before{ background: transparent; }\n.in:checked + .tile .tile__num{ animation: rank-in var(--duration-quick) var(--ease-arrive) var(--duration-tick) both; }\n.in:checked + .tile .part{ transform: var(--mv); }\n.in:checked + .tile .tend{ opacity: 1; animation: rise 1500ms cubic-bezier(0.2,0.6,0.3,1) var(--sd,0ms) infinite; }\n\n/* static states, drawn by hand for the register */\n.tile.is-hover{ --surface: var(--secondary); background: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.tile.is-press{ --surface: var(--muted); background: var(--muted); transform: translateY(1px); }\n.tile.is-focus{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.tile.is-fill40, .tile.is-filled{\n  border-color: var(--primary);\n  color: var(--primary-foreground);\n  --food: color-mix(in oklab, var(--background) 82%, var(--primary));\n  --steam: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n}\n.tile.is-fill40 .tile__wash{ clip-path: circle(40% at var(--fill-x) var(--fill-y)); }\n.tile.is-filled .tile__wash{ clip-path: circle(150% at var(--fill-x) var(--fill-y)); }\n.tile.is-fill40 .tile__name, .tile.is-filled .tile__name{ color: var(--primary-foreground); }\n.tile.is-filled .tile__pocket{ background: var(--primary-foreground); }\n.tile.is-filled .tile__pocket::before{ background: transparent; }\n.tile.is-filled .tile__num{ opacity: 1; transform: scale(1); }\n.tile.is-filled .part{ transform: var(--mv); }\n.tile.is-filled .tend{ opacity: 1; animation: rise 1500ms cubic-bezier(0.2,0.6,0.3,1) var(--sd,0ms) infinite; }\n.tile.is-limit{ border-style: dashed; color: var(--muted-foreground); }\n.tile.is-limit .ic{ opacity: 0.55; }\n.tile.is-limit .tile__pocket{ background: color-mix(in oklab, var(--input) 55%, transparent); }\n.tile.is-limit .tile__pocket::before{ background: var(--card); }\n.tile.is-static{ cursor: default; }\n\n@keyframes rank-seal{ from{ transform: scale(0.62); } to{ transform: scale(1); } }\n@keyframes rank-in{ from{ opacity: 0; transform: scale(0.4); } to{ opacity: 1; transform: scale(1); } }\n\n/* ── the icons, unchanged gestures ────────────────────────────────────── */\n.ic{ position: relative; z-index: 2; display: block; flex: none; --sw: 1.4; --sw-s: 1.2; }\n.lay{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }\n.ic40{ inline-size: 40px; block-size: 40px; --sw: 1.5; --sw-s: 1.3; }\n.part{ transform-origin: var(--org, 50% 50%); transition: transform var(--duration-base) var(--ease-glide); }\n.tend{ opacity: 0; transition: opacity var(--duration-tick) var(--ease-linear); }\n\n.m-fry{ --mv: translateY(-9%); --sd: 0ms; }\n.m-sauce{ --mv: translateY(-13%); --sd: -240ms; }\n.m-oven{ --mv: scaleY(0.34); --org: 50% 100%; }\n.m-air{ --mv: translateY(7%); --sd: -120ms; }\n.m-slow{ --mv: translateY(-10%); --sd: -640ms; }\n.m-press{ --mv: translateY(-2.5%); --sd: -420ms; }\n.m-grill{ --mv: translateY(-8%); --sd: -880ms; }\n.m-nocook{ --mv: translateY(-6%) rotate(5deg); --org: 50% 90%; }\n\n@keyframes rise{\n  0%{ transform: translateY(8%) scaleY(0.86); opacity: 0; }\n  22%{ opacity: 0.62; }\n  100%{ transform: translateY(-22%) scaleY(1.12); opacity: 0; }\n}\n\n/* ── states register ──────────────────────────────────────────────────── */\n.register{ display: grid; }\n.reg-row{ display: grid; grid-template-columns: 84px repeat(6, minmax(0, 1fr)); align-items: stretch; }\n.reg-row + .reg-row{ border-block-start: var(--border-width-thin) solid var(--border); }\n.reg-row--head{ align-items: end; border-block-end: var(--border-width-thin) solid var(--border); }\n.reg-key{ display: flex; align-items: center; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.reg-h{ padding: var(--space-2); text-align: center; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.reg-cell{ display: grid; place-items: center; padding: var(--space-3) var(--space-2); border-inline-start: var(--border-width-thin) solid var(--border); }\n.reg-cell:first-of-type{ border-inline-start: 0; }\n.reg-cell .tile{ inline-size: 100%; min-block-size: 96px; }\n.tile--sm{ padding: var(--space-2); gap: var(--space-1); }\n.tile--sm .ic{ inline-size: 32px; block-size: 32px; --sw: 2.2; --sw-s: 1.9; }\n.tile--sm .tile__name{ font-size: var(--text-2xs); }\n\n/* ── the rank pocket at 4x ────────────────────────────────────────────── */\n.ranks{ display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block: var(--border-width-thin) solid var(--border); }\n.rank-cell{ display: grid; justify-items: center; align-content: center; gap: var(--space-2); padding: var(--space-5) var(--space-2); border-inline-start: var(--border-width-thin) solid var(--border); }\n.rank-cell:first-child{ border-inline-start: 0; }\n.plate{ display: grid; place-items: center; inline-size: 112px; block-size: 80px; border-radius: var(--radius-sm); }\n.plate--off{ background: var(--card); border: var(--border-width-thin) solid var(--border); }\n.plate--on{ background: var(--primary); }\n.rank-lg{ --slot: 56px; position: relative; display: grid; place-items: center; inline-size: var(--slot); block-size: var(--slot); }\n.rank-lg .tile__num{ font-size: var(--text-lg); }\n.rank-lg.is-on .tile__pocket{ background: var(--primary-foreground); }\n.rank-lg.is-on .tile__pocket::before{ background: transparent; }\n.rank-lg.is-on .tile__num{ opacity: 1; transform: scale(1); }\n.rank-lg .tile__pocket{ background: var(--box-line); }\n.rank-lg .tile__pocket::before{ background: var(--card); }\n.caption{ display: flex; gap: var(--space-2); }\n.k{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n/* ── timing ───────────────────────────────────────────────────────────── */\n.timing{ display: grid; }\n.trow{ display: grid; grid-template-columns: minmax(0,1fr) 170px 200px minmax(0,1.45fr); gap: var(--space-3); align-items: center; min-block-size: 40px; }\n.trow + .trow{ border-block-start: var(--border-width-thin) solid var(--border); }\n.trow--head{ min-block-size: 30px; border-block-end: var(--border-width-thin) solid var(--border); }\n.th{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.tstep{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.ttok{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n.tdur{ display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); }\n.tnum{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); }\n.tval{ font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n@media (prefers-reduced-motion: reduce){\n  .tile__wash{ transition: none; }\n  .tile__pocket, .tile__num{ animation: none; }\n  .in:checked + .tile .tile__num{ opacity: 1; transform: scale(1); }\n  .part{ transition: none; }\n  .tend, .in:checked + .tile .tend, .tile.is-filled .tend{ animation: none; opacity: 0; }\n}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG symbol sprite sheet\" focusable=\"false\" style=\"position:absolute;inline-size:0;block-size:0\"><defs>\n<symbol id=\"b-fry\" viewbox=\"0 0 24 24\">\n<path d=\"M3.5 10.2a6.6 6.6 0 0 0 13.2 0\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M3.5 10.2h13.2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M16.9 9.6 22.3 8.3\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"calc(var(--sw)*1.5)\"></path>\n</symbol>\n<symbol id=\"p-fry\" viewbox=\"0 0 24 24\">\n<path d=\"M7.2 11.6c1.6-.7 8-.7 9.9.2-.7.9-3 1.5-5.4 1.5s-4.4-.7-5-1.7z\" fill=\"var(--food)\"></path>\n<path d=\"M9.3 9.4l2.7-.9.5 1.3-2.7.9z\" fill=\"var(--leaf)\"></path>\n</symbol>\n<symbol id=\"s-fry\" viewbox=\"0 0 24 24\">\n<g fill=\"none\" stroke=\"var(--steam)\" stroke-linecap=\"round\" stroke-width=\"var(--sw-s)\"><path d=\"M7.5 5.6c1.1.9-.5 1.7 0 2.6\"></path><path d=\"M10.7 4.4c1.1.9-.5 1.7 0 2.6\"></path></g>\n</symbol>\n<symbol id=\"b-sauce\" viewbox=\"0 0 24 24\">\n<path d=\"M7.2 10.3h9.6v5.6a2.2 2.2 0 0 1-2.2 2.2h-5.2a2.2 2.2 0 0 1-2.2-2.2z\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M6.3 10.3h11.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<rect fill=\"currentColor\" height=\"1.7\"