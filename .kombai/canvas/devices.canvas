  "nodes": {
    "var_bddceaa70a98": {
      "type": "variant",
      "label": "Cooking method icons — the eight devices",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n  --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n  --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n  --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n  --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n  --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n  --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n  --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n  --primary-text: light-dark(oklch(0.470 0.120 68), oklch(0.870 0.140 84));\n  --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n  --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n  --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n\n  /* icon ink, so a bare .ic outside a state cell still paints food, leaf, steam and the oven door */\n  --food: color-mix(in oklab, var(--primary) 66%, var(--foreground));\n  --leaf: var(--accent);\n  --steam: color-mix(in oklab, var(--foreground) 42%, var(--background));\n  --surface: var(--card);\n\n  --radius: 0.5rem;\n  --radius-sm: calc(var(--radius) * 0.5);\n  --radius-md: var(--radius);\n  --radius-lg: calc(var(--radius) * 1.5);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n\n  --font-display: Georgia, \"Times New Roman\", serif;\n  --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n  --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n  --leading-solid: 1;\n  --leading-tight: 1.2;\n  --leading-ui: 1.45;\n  --leading-body: 1.55;\n  --tracking-tight: -0.01em;\n  --tracking-display: -0.02em;\n  --tracking-caps: 0.14em;\n\n  --spacing: 0.25rem;\n  --font-base: 1rem;\n  --text-2xs: calc(var(--font-base) * 0.625);\n  --text-xs: calc(var(--font-base) * 0.75);\n  --text-sm: calc(var(--font-base) * 0.875);\n  --text-base: calc(var(--font-base) * 1);\n  --text-lg: calc(var(--font-base) * 1.125);\n  --text-xl: calc(var(--font-base) * 1.5);\n  --text-2xl: calc(var(--font-base) * 1.875);\n  --space-1: calc(var(--spacing) * 1);\n  --space-2: calc(var(--spacing) * 2);\n  --space-3: calc(var(--spacing) * 3);\n  --space-4: calc(var(--spacing) * 4);\n  --space-5: calc(var(--spacing) * 5);\n  --space-6: calc(var(--spacing) * 6);\n  --space-7: calc(var(--spacing) * 7);\n  --space-8: calc(var(--spacing) * 8);\n  --space-9: calc(var(--spacing) * 9);\n  --space-10: calc(var(--spacing) * 10);\n  --space-12: calc(var(--spacing) * 12);\n  --page-measure: 72rem;\n  --space-page: var(--space-5);\n}\n/* the one colour the icon set needs beyond the shadcn set: leaves */\n:root{ --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140)); }\n@media (width >= 48rem){ :root{ --space-page: var(--space-8); } }\n\n*{ box-sizing: border-box; }\nbody{ margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: var(--text-sm); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }\nh1,h2,p,ol,ul,fieldset,legend,figure{ margin: 0; }\nul,ol{ padding: 0; list-style: none; }\nfieldset{ border: 0; padding: 0; }\nbutton{ font: inherit; color: inherit; }\n.sr-only{ position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.label{ font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.frame{ box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page); }\n.sheet{ padding-block: var(--space-6) var(--space-12); }\n\n.bar{ display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); }\n.wordmark{ font-family: var(--font-display); font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-display); }\n.facts{ display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.head{ padding-block: var(--space-3) var(--space-4); border-block-end: var(--border-width-thin) solid var(--border); }\nh1{ font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n\n/* ── the icon: three stacked layers, so one part can move alone ───────── */\n.defs{ position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }\n.ic{ position: relative; display: block; flex: none; --sw: 1.45; --sw-s: 1.3; }\n.lay{ position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }\n.ic48{ inline-size: 48px; block-size: 48px; --sw: 1.4; --sw-s: 1.2; }\n.ic44{ inline-size: 44px; block-size: 44px; --sw: 1.5; --sw-s: 1.3; }\n.ic24{ inline-size: 24px; block-size: 24px; --sw: 2.1; --sw-s: 1.8; }\n.ic20{ inline-size: 20px; block-size: 20px; --sw: 2.4; --sw-s: 2; }\n.ic16{ inline-size: 16px; block-size: 16px; --sw: 2.7; --sw-s: 2.3; }\n.ic16 .d{ display: none; }\n.ic16 .tend{ display: none; }\n.part{ transform-origin: var(--org, 50% 50%); transition: transform 320ms cubic-bezier(0.23,1,0.32,1); }\n.tend{ opacity: 0; transition: opacity 140ms linear; }\n\n/* one pose per device, and the surface the part paints over */\n.m-fry{ --mv: translateY(-9%); --gt: 320ms; --sd: 0ms; }\n.m-sauce{ --mv: translateY(-13%); --gt: 340ms; --sd: -240ms; }\n.m-oven{ --mv: scaleY(0.34); --org: 50% 100%; --gt: 380ms; }\n.m-air{ --mv: translateY(7%); --gt: 320ms; }\n.m-slow{ --mv: translateY(-10%); --gt: 340ms; --sd: -640ms; }\n/* a regulator unseats a hair; the steam jet is the event, not weight travel */\n.m-press{ --mv: translateY(-2.5%); --gt: 300ms; --sd: -420ms; }\n.m-grill{ --mv: translateY(-8%); --gt: 320ms; --sd: -880ms; }\n.m-nocook{ --mv: translateY(-6%) rotate(5deg); --org: 50% 90%; --gt: 360ms; }\n\n/* steam rises and fades. It never comes back down. */\n@keyframes rise{\n  0%{ transform: translateY(8%) scaleY(0.86); opacity: 0; }\n  22%{ opacity: 0.62; }\n  100%{ transform: translateY(-22%) scaleY(1.12); opacity: 0; }\n}\n@keyframes gesture{\n  0%{ transform: none; }\n  52%{ transform: var(--mv); }\n  100%{ transform: none; }\n}\n\n/* ── tabs ─────────────────────────────────────────────────────────────── */\n.tabs{ display: flex; gap: var(--space-6); margin-block-start: var(--space-2); border-block-end: var(--border-width-thin) solid var(--border); }\n.tab{ padding: var(--space-3) 0 var(--space-2); border-block-end: var(--border-width-medium) solid transparent; margin-block-end: calc(var(--border-width-thin) * -1); font-size: var(--text-sm); color: var(--muted-foreground); cursor: pointer; }\n.tab:hover{ color: var(--foreground); }\n.tabin{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }\n.tabin:focus-visible + .tab{ outline: var(--border-width-medium) solid var(--ring); outline-offset: -2px; }\n.view{ display: none; }\n.board:has(#v-states:checked) .view--states,\n.board:has(#v-sizes:checked) .view--sizes,\n.board:has(#v-motion:checked) .view--motion,\n.board:has(#v-integration:checked) .view--integration{ display: grid; gap: var(--space-4); padding-block-start: var(--space-4); }\n.board:has(#v-states:checked) label[for=\"v-states\"],\n.board:has(#v-sizes:checked) label[for=\"v-sizes\"],\n.board:has(#v-motion:checked) label[for=\"v-motion\"],\n.board:has(#v-integration:checked) label[for=\"v-integration\"]{ color: var(--foreground); border-block-end-color: var(--foreground); }\n\n/* ── the state register: one shared matrix, hairlines between rows ────── */\n.mx{ display: grid; }\n.mxr{ display: grid; grid-template-columns: 96px repeat(8, minmax(0, 1fr)); gap: var(--space-1); align-items: stretch; }\n.mxr + .mxr{ border-block-start: var(--border-width-thin) solid var(--border); }\n.mxr--head{ align-items: end; padding-block-end: var(--space-2); border-block-start: 0; }\n.mxh{ padding-inline: 2px; text-align: center; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.mxk{ display: flex; align-items: center; align-self: stretch; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n\n.spec{\n  display: grid; place-items: center; min-block-size: 72px; border-radius: var(--radius-sm);\n  background: var(--card); color: var(--foreground);\n  --surface: var(--card);\n  --food: color-mix(in oklab, var(--primary) 66%, var(--foreground));\n  --leaf: var(--accent);\n  --steam: color-mix(in oklab, var(--foreground) 42%, var(--background));\n}\n.st-hover{ background: var(--secondary); --surface: var(--secondary); }\n/* inset, so eight 4px-apart cells read as eight rings and not one chain */\n.st-focus{ outline: var(--border-width-medium) solid var(--ring); outline-offset: -3px; }\n.st-press{ background: var(--muted); --surface: var(--muted); transform: translateY(1px); }\n.st-on{\n  background: var(--primary); color: var(--primary-foreground);\n  --surface: var(--primary);\n  --food: color-mix(in oklab, var(--background) 82%, var(--primary));\n  --leaf: var(--accent);\n  --steam: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n}\n.st-off{\n  outline: var(--border-width-thin) dashed var(--input); outline-offset: -1px;\n  background: transparent; color: var(--muted-foreground);\n  --surface: var(--background); --food: transparent; --leaf: transparent;\n}\n.st-on .part{ transform: var(--mv); }\n.st-on .tend{ opacity: 1; animation: rise 1500ms cubic-bezier(0.2,0.6,0.3,1) var(--sd,0ms) infinite; }\n.st-off .tend{ opacity: 0; }\n\n/* ── the live picker ──────────────────────────────────────────────────── */\n.field{ display: grid; gap: var(--space-3); padding: var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--background); }\n.field__label{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.field__hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.rail{ display: grid; gap: var(--space-2); counter-reset: rank; }\n.rail--8{ grid-template-columns: repeat(8, minmax(0, 1fr)); }\n.rail--4{ grid-template-columns: repeat(4, minmax(0, 1fr)); }\n.in{ position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }\n.in:checked{ counter-increment: rank; }\n.tile{\n  position: relative; display: grid; justify-items: center; align-content: center; gap: var(--space-1);\n  padding: var(--space-2) var(--space-1); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md);\n  background: var(--card); color: var(--foreground); cursor: pointer;\n  transition: background-color 140ms linear, border-color 140ms linear;\n  --surface: var(--card);\n  --food: color-mix(in oklab, var(--primary) 66%, var(--foreground));\n  --leaf: var(--accent);\n  --steam: color-mix(in oklab, var(--foreground) 42%, var(--background));\n}\n.tile__n{ font-size: var(--text-2xs); line-height: var(--leading-tight); text-align: center; text-wrap: balance; }\n.tile:hover{ background: var(--secondary); --surface: var(--secondary); border-color: color-mix(in oklab, var(--input) 52%, var(--foreground)); }\n.tile:active{ background: var(--muted); --surface: var(--muted); }\n.in:focus-visible + .tile{ outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n.in:checked + .tile{\n  background: var(--primary); border-color: var(--primary); color: var(--primary-foreground);\n  --surface: var(--primary);\n  --food: color-mix(in oklab, var(--background) 82%, var(--primary));\n  --steam: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n}\n.in:checked + .tile::after{\n  content: counter(rank); position: absolute; inset-block-start: 4px; inset-inline-end: 4px;\n  inline-size: 18px; block-size: 18px; border-radius: 50%;\n  background: var(--foreground); color: var(--background);\n  display: grid; place-items: center; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: 1;\n}\n.in:checked + .tile .part{ transform: var(--mv); }\n.in:checked + .tile .tend{ opacity: 1; animation: rise 1500ms cubic-bezier(0.2,0.6,0.3,1) var(--sd,0ms) infinite; }\n\n/* ── sizes ────────────────────────────────────────────────────────────── */\n.szr{ display: grid; grid-template-columns: 96px repeat(8, minmax(0, 1fr)); gap: var(--space-1); align-items: center; min-block-size: 56px; }\n.szr + .szr{ border-block-start: var(--border-width-thin) solid var(--border); }\n.szr--head{ align-items: end; min-block-size: 28px; padding-block-end: var(--space-2); border-block-start: 0; }\n.szc{ display: grid; place-items: center; }\n.szk{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); color: var(--muted-foreground); }\n\n/* ── motion ───────────────────────────────────────────────────────────── */\n.tbl{ display: grid; }\n.tr{ display: grid; grid-template-columns: minmax(0, 1fr) 104px minmax(0, 1.35fr) 88px 72px; gap: var(--space-3); align-items: center; min-block-size: 34px; }\n.tr + .tr{ border-block-start: var(--border-width-thin) solid var(--border); }\n.tr--head{ min-block-size: 28px; border-block-end: var(--border-width-thin) solid var(--border); }\n.th{ font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n.tn{ font-weight: 700; letter-spacing: var(--tracking-tight); }\n.tm{ font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n.replay{ display: flex; flex-wrap: wrap; gap: var(--space-3); }\n.rp{ display: grid; place-items: center; inline-size: 68px; block-size: 68px; border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-sm); background: var(--card); --surface: var(--card); }\n.rp:hover{ background: var(--secondary); --surface: var(--secondary); }\n.rp:hover .part{ animation: gesture var(--gt, 320ms) cubic-bezier(0.23,1,0.32,1); }\n.rp:hover .tend{ opacity: 1; animation: rise 1500ms cubic-bezier(0.2,0.6,0.3,1) 1; }\n\n/* ── integration ──────────────────────────────────────────────────────── */\n.duo{ display: grid; align-items: start; gap: var(--space-5); }\n@media (width >= 64rem){ .duo{ grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-6); } }\n.card{ display: grid; gap: var(--space-4); align-content: start; padding: var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n.card__head{ display: grid; gap: 2px; }\n.card__h{ font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n.card__hint{ font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n.prs{ display: grid; }\n.pr{ display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: var(--space-3); align-items: center; min-block-size: 44px; border-block-end: var(--border-width-thin) solid var(--border); }\n.pr:last-child{ border-block-end: 0; }\n.pr__n{ font-weight: 700; letter-spacing: var(--tracking-tight); }\n.pr__m{ display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); }\n.pr__s{ font-size: var(--text-xs); color: var(--muted-foreground); }\n.pr__t{ font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n@media (prefers-reduced-motion: reduce){\n  .part{ transition: none; }\n  .tend, .st-on .tend, .in:checked + .tile .tend, .rp:hover .tend{ animation: none; opacity: 0; }\n  .rp:hover .part{ animation: none; }\n}\n</style>\n<svg aria-hidden=\"true\" class=\"defs\" data-kid=\"1\" data-name=\"icon symbol definitions sprite\" focusable=\"false\"><defs>\n<symbol id=\"b-fry\" viewbox=\"0 0 24 24\">\n<path d=\"M3.5 10.2a6.6 6.6 0 0 0 13.2 0\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M3.5 10.2h13.2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M16.9 9.6 22.3 8.3\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"calc(var(--sw)*1.5)\"></path>\n</symbol>\n<symbol id=\"p-fry\" viewbox=\"0 0 24 24\">\n<path d=\"M7.2 11.6c1.6-.7 8-.7 9.9.2-.7.9-3 1.5-5.4 1.5s-4.4-.7-5-1.7z\" fill=\"var(--food)\"></path>\n<path d=\"M9.3 9.4l2.7-.9.5 1.3-2.7.9z\" fill=\"var(--leaf)\"></path>\n</symbol>\n<symbol id=\"s-fry\" viewbox=\"0 0 24 24\">\n<g fill=\"none\" stroke=\"var(--steam)\" stroke-linecap=\"round\" stroke-width=\"var(--sw-s)\"><path d=\"M7.5 5.6c1.1.9-.5 1.7 0 2.6\"></path><path d=\"M10.7 4.4c1.1.9-.5 1.7 0 2.6\"></path></g>\n</symbol>\n<symbol id=\"b-sauce\" viewbox=\"0 0 24 24\">\n<path d=\"M7.2 10.3h9.6v5.6a2.2 2.2 0 0 1-2.2 2.2h-5.2a2.2 2.2 0 0 1-2.2-2.2z\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"var(--sw)\"></path>\n<path d=\"M6.3 10.3h11.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"var(--sw)\"></path>\n<rect fill=\"currentColor\" height=\"1.7\" rx=\"0.85\" width=\"2.5\" x=\"4.6\" y=\"12.1\"></rect>\n<rect fill=\"currentColor\" height=\"1.7\" rx=\"0.85\" width=\"2.5\" x=\"16.9\" y=\"12.1\"