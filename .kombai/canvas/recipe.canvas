      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --card-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --muted: light-dark(oklch(0.926 0.045 90), oklch(0.265 0.024 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --accent-foreground: light-dark(oklch(0.985 0.012 140), oklch(0.200 0.045 140));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --input: light-dark(oklch(0.865 0.034 82), oklch(0.350 0.024 72));\n    --ring: light-dark(oklch(0.500 0.110 65), oklch(0.845 0.160 84));\n    --destructive: light-dark(oklch(0.450 0.165 20), oklch(0.640 0.155 20));\n    --destructive-foreground: light-dark(oklch(0.985 0.014 95), oklch(0.190 0.045 20));\n    --chart-gift: light-dark(oklch(0.545 0.150 140), oklch(0.800 0.125 140));\n    --chart-credit: light-dark(oklch(0.430 0.150 15), oklch(0.560 0.135 15));\n    --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n    --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n    --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n    --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n    --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n    --radius-xl: calc(var(--radius) * 2);\n    --border-width-thin: 1px;\n    --border-width-medium: 2px;\n    --border-width-thick: 3px;\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n    --leading-solid: 1;\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-20: calc(var(--spacing) * 20);\n    --page-measure: 72rem;\n    --space-page: var(--space-5);\n  }\n  @media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-base);\n    line-height: var(--leading-body);\n  }\n  a { color: inherit; }\n  button { font: inherit; }\n\n  .frame {\n    inline-size: 100%;\n    max-inline-size: calc(var(--page-measure) + var(--space-page) * 2);\n    margin-inline: auto;\n    padding-inline: var(--space-page);\n  }\n\n  .site-header { border-block-end: var(--border-width-thin) solid var(--border); background: var(--background); }\n  .sign { block-size: 64px; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-4); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-2); text-decoration: none; }\n  .mk { display: block; flex: none; overflow: visible; inline-size: 30px; block-size: 30px; }\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  .wordmark {\n    font-family: var(--font-display);\n    font-size: var(--text-lg);\n    font-weight: 400;\n    line-height: var(--leading-solid);\n    letter-spacing: var(--tracking-display);\n  }\n  .nav { display: none; }\n  .cta {\n    position: relative;\n    justify-self: end;\n    display: inline-flex;\n    align-items: center;\n    min-block-size: 40px;\n    padding: 0 var(--space-4) 0 var(--space-7);\n    border: var(--border-width-thin) solid var(--primary);\n    border-radius: var(--radius);\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-size: var(--text-xs);\n    font-weight: 700;\n    line-height: var(--leading-tight);\n    text-decoration: none;\n    white-space: nowrap;\n  }\n  .cta__plate {\n    position: absolute;\n    inset-inline-start: -17px;\n    inset-block-start: 50%;\n    margin-block-start: -17px;\n    inline-size: 34px;\n    block-size: 34px;\n    border-radius: 50%;\n    background: var(--card);\n    border: var(--border-width-thin) solid var(--border);\n    display: grid;\n    place-items: center;\n    color: var(--foreground);\n  }\n\n  .article { padding-block: var(--space-6) var(--space-12); }\n  h1 {\n    margin: 0;\n    font-family: var(--font-display);\n    font-size: var(--text-2xl);\n    font-weight: 400;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-display);\n  }\n  .flags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block: var(--space-3) 0; }\n  .tag {\n    display: inline-flex;\n    align-items: center;\n    min-block-size: 24px;\n    padding-inline: var(--space-3);\n    border: var(--border-width-thin) solid color-mix(in oklab, var(--accent) 48%, var(--border));\n    border-radius: var(--radius-sm);\n    background: color-mix(in oklab, var(--accent) 13%, var(--card));\n    color: color-mix(in oklab, var(--accent) 72%, var(--foreground));\n    font-size: var(--text-xs);\n    line-height: var(--leading-ui);\n  }\n\n  /* the saffron band keeps three columns; Save takes its own row */\n  .facts {\n    margin-block-start: var(--space-4);\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    align-items: start;\n    gap: var(--space-3) var(--space-4);\n    padding: var(--space-4);\n    border-radius: var(--radius);\n    background: var(--primary);\n    color: var(--primary-foreground);\n  }\n  .fact { display: grid; gap: 2px; }\n  .fact b {\n    font-family: var(--font-mono);\n    font-weight: 400;\n    font-size: var(--text-xl);\n    line-height: var(--leading-solid);\n    letter-spacing: var(--tracking-tight);\n  }\n  .fact span {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n  }\n  .saveform { margin: 0; grid-column: 1 / -1; }\n  .save {\n    inline-size: 100%;\n    min-block-size: 44px;\n    padding-inline: var(--space-5);\n    border: var(--border-width-thin) solid var(--foreground);\n    border-radius: var(--radius);\n    background: var(--foreground);\n    color: var(--primary);\n    font-size: var(--text-sm);\n    font-weight: 700;\n    line-height: var(--leading-tight);\n    cursor: pointer;\n  }\n\n  .contents { display: flex; flex-wrap: wrap; gap: var(--space-4); padding-block: var(--space-4); }\n  .contents a {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n    text-decoration: none;\n  }\n\n  section { margin-block-start: var(--space-6); scroll-margin-block-start: var(--space-6); }\n  h2 {\n    margin: 0 0 var(--space-2);\n    font-family: var(--font-sans);\n    font-size: var(--text-base);\n    font-weight: 700;\n    line-height: var(--leading-tight);\n    letter-spacing: var(--tracking-tight);\n  }\n\n  .groups { display: grid; border-block-start: var(--border-width-thin) solid var(--border); }\n  .group {\n    display: grid;\n    gap: var(--space-2);\n    padding-block: var(--space-3);\n    border-block-end: var(--border-width-thin) solid var(--border);\n  }\n  .group dt {\n    margin: 0;\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  .group dd { margin: 0; }\n  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }\n  .chip {\n    display: inline-flex;\n    align-items: center;\n    min-block-size: 32px;\n    padding-inline: var(--space-3);\n    border: var(--border-width-thin) solid var(--border);\n    border-radius: var(--radius-sm);\n    background: var(--muted);\n    font-size: var(--text-sm);\n    line-height: var(--leading-ui);\n  }\n  .none { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted-foreground); }\n  .staples { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); font-size: var(--text-sm); }\n  .assumed {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n\n  .swapwrap { margin-block-start: 0; }\n  .swap {\n    display: grid;\n    gap: var(--space-2);\n    padding-block: var(--space-3);\n    border-block-end: var(--border-width-thin) solid var(--border);\n  }\n  .swap .k { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .swap .v { font-family: var(--font-mono); font-size: var(--text-sm); }\n  .swap .v i { font-style: normal; color: var(--muted-foreground); padding-inline: var(--space-2); }\n\n  .method { counter-reset: step; list-style: none; margin: 0; padding: 0; }\n  .method li {\n    counter-increment: step;\n    display: grid;\n    grid-template-columns: 1.75rem minmax(0, 1fr);\n    column-gap: var(--space-3);\n    align-items: start;\n    padding-block: var(--space-2);\n  }\n  .method li::before {\n    content: counter(step);\n    font-family: var(--font-mono);\n    font-size: var(--text-sm);\n    line-height: var(--leading-body);\n    color: var(--muted-foreground);\n  }\n\n  .similar { display: grid; }\n  .similar a {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: var(--space-1) var(--space-3);\n    padding-block: var(--space-3);\n    border-block-start: var(--border-width-thin) solid var(--border);\n    text-decoration: none;\n  }\n  .similar a:last-child { border-block-end: var(--border-width-thin) solid var(--border); }\n  .similar .t {\n    grid-column: 1 / -1;\n    font-family: var(--font-display);\n    font-size: var(--text-lg);\n    line-height: var(--leading-tight);\n  }\n  .similar .m {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  .similar .m + .m { justify-self: end; }\n\n  .site-footer { border-block-start: var(--border-width-thin) solid var(--border); }\n  .site-footer .frame { display: grid; gap: var(--space-3); padding-block: var(--space-5); }\n  .disclaimer { margin: 0; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .legal { display: flex; gap: var(--space-5); font-size: var(--text-xs); }\n  .legal a { color: var(--muted-foreground); }\n</style>\n<header class=\"site-header\" data-kid=\"1\" data-name=\"page header bar\">\n<div class=\"frame\" data-kid=\"1-1\" data-name=\"header inner layout frame\">\n<div class=\"sign\" data-kid=\"1-1-1\" data-name=\"site masthead row\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1\" data-name=\"brand logo link to home\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1\" data-name=\"llama chef logo icon\" height=\"30\" viewbox=\"0 0 32 32\" width=\"30\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<a class=\"cta\" data-kid=\"1-1-1-2\" data-name=\"primary call-to-action button\" href=\"/pantry\">\n<span aria-hidden=\"true\" class=\"cta__plate\" data-kid=\"1-1-1-2-1\" data-name=\"decorative plate icon container\">\n<svg data-kid=\"1-1-1-2-1-1\" data-name=\"cooking utensils icon\" height=\"20\" viewbox=\"0 0 22 22\" width=\"20\">\n<g transform=\"translate(11 11) scale(1.5) translate(-10.35 -10.8)\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-2-2\" data-name=\"call-to-action label text\">Start cooking</span>\n</a>\n</div>\n</div>\n</header>\n<main class=\"frame\" data-kid=\"2\" data-name=\"main recipe content region\">\n<article class=\"article\" data-kid=\"2-1\" data-name=\"recipe article\">\n<h1 data-kid=\"2-1-1\" data-name=\"recipe title heading\">Tofu fried rice</h1>\n<p class=\"flags\" data-kid=\"2-1-2\" data-name=\"recipe dietary flags row\">\n<span class=\"tag\" data-kid=\"2-1-2-1\" data-name=\"vegan dietary tag\">vegan</span>\n<span class=\"tag\" data-kid=\"2-1-2-2\" data-name=\"gluten free dietary tag\">gluten free</span>\n</p>\n<div class=\"facts\" data-kid=\"2-1-3\" data-name=\"recipe quick facts card\">\n<div class=\"fact\" data-kid=\"2-1-3-1\" data-name=\"total time fact item\"><b data-kid=\"2-1-3-1-1\" data-name=\"cooking time value\">25</b><span data-kid=\"2-1-3-1-2\" data-name=\"cooking time unit label\">minutes</span></div>\n<div class=\"fact\" data-kid=\"2-1-3-2\" data-name=\"servings fact item\"><b data-kid=\"2-1-3-2-1\" data-name=\"servings value\">2</b><span data-kid=\"2-1-3-2-2\" data-name=\"servings unit label\">servings</span></div>\n<div class=\"fact\" data-kid=\"2-1-3-3\" data-name=\"calorie fact item\"><b data-kid=\"2-1-3-3-1\" data-name=\"calorie value\">480</b><span data-kid=\"2-1-3-3-2\" data-name=\"calorie unit label\">kcal per serving</span></div>\n<form action=\"/saved\" class=\"saveform\" data-kid=\"2-1-3-4\" data-name=\"save recipe form\" method=\"post\">\n<button class=\"save\" data-kid=\"2-1-3-4-1\" data-name=\"save recipe submit button\" type=\"submit\">Save</button>\n</form>\n</div>\n<nav aria-label=\"On this recipe\" class=\"contents\" data-kid=\"2-1-4\" data-name=\"recipe table of contents nav\">\n<a data-kid=\"2-1-4-1\" data-name=\"contents link to ingredients\" href=\"#ingredients\">Ingredients</a>\n<a data-kid=\"2-1-4-2\" data-name=\"contents link to method\" href=\"#method\">Method</a>\n<a data-kid=\"2-1-4-3\" data-name=\"contents link to similar\" href=\"#similar\">Similar</a>\n</nav>\n<section data-kid=\"2-1-5\" data-name=\"ingredients section\" id=\"ingredients\">\n<h2 data-kid=\"2-1-5-1\" data-name=\"ingredients section heading\">Ingredients</h2>\n<dl class=\"groups\" data-kid=\"2-1-5-2\" data-name=\"ingredient groups list\">\n<div class=\"group\" data-kid=\"2-1-5-2-1\" data-name=\"have ingredient group\">\n<dt data-kid=\"2-1-5-2-1-1\" data-name=\"have group label\">Have</dt>\n<dd class=\"chips\" data-kid=\"2-1-5-2-1-2\" data-name=\"have ingredient chips container\">\n<span class=\"chip\" data-kid=\"2-1-5-2-1-2-1\" data-name=\"firm tofu ingredient chip\">firm tofu</span>\n<span class=\"chip\" data-kid=\"2-1-5-2-1-2-2\" data-name=\"day-old rice ingredient chip\">day-old rice</span>\n<span class=\"chip\" data-kid=\"2-1-5-2-1-2-3\" data-name=\"soy sauce ingredient chip\">soy sauce</span>\n<span class=\"chip\" data-kid=\"2-1-5-2-1-2-4\" data-name=\"spring onion ingredient chip\">spring onion</span>\n<span class=\"chip\" data-kid=\"2-1-5-2-1-2-5\" data-name=\"garlic ingredient chip\">garlic</span>\n<span class=\"chip\" data-kid=\"2-1-5-2-1-2-6\" data-name=\"ginger ingredient chip\">ginger</span>\n</dd>\n</div>\n<div class=\"group\" data-kid=\"2-1-5-2-2\" data-name=\"need ingredient group\">\n<dt data-kid=\"2-1-5-2-2-1\" data-name=\"need group label\">Need</dt>\n<dd data-kid=\"2-1-5-2-2-2\" data-name=\"need group value\"><span class=\"none\" data-kid=\"2-1-5-2-2-2-1\" data-name=\"empty value em dash\">—</span></dd>\n</div>\n<div class=\"group\" data-kid=\"2-1-5-2-3\" data-name=\"staples ingredient group\">\n<dt data-kid=\"2-1-5-2-3-1\" data-name=\"staples group label\">Staples</dt>\n<dd class=\"staples\" data-kid=\"2-1-5-2-3-2\" data-name=\"staples inline list\">neutral oil, salt <span class=\"assumed\" data-kid=\"2-1-5-2-3-2-1\" data-name=\"staples assumed marker\">assumed</span></dd>\n</div>\n</dl>\n</section>\n<section aria-label=\"Swap\" class=\"swapwrap\" data-kid=\"2-1-6\" data-name=\"swap suggestion section\">\n<div class=\"swap\" data-kid=\"2-1-6-1\" data-name=\"swap suggestion row\">\n<span class=\"k\" data-kid=\"2-1-6-1-1\" data-name=\"swap label\">Swap</span>\n<span class=\"v\" data-kid=\"2-1-6-1-2\" data-name=\"swap value text\">chicken <i aria-hidden=\"true\" data-kid=\"2-1-6-1-2-1\" data-name=\"swap arrow separator icon\">→</i> firm tofu</span>\n</div>\n</section>\n<section data-kid=\"2-1-7\" data-name=\"method section\" id=\"method\">\n<h2 data-kid=\"2-1-7-1\" data-name=\"method section heading\">Method</h2>\n<ol class=\"method\" data-kid=\"2-1-7-2\" data-name=\"numbered cooking steps list\">\n<li data-kid=\"2-1-7-2-1\" data-name=\"cooking step 1 heat oil\">Heat the neutral oil in a wide pan until it shimmers.</li>\n<li data-kid=\"2-1-7-2-2\" data-name=\"cooking step 2 fry tofu\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</li>\n<li data-kid=\"2-1-7-2-3\" data-name=\"cooking step 3 press rice\">Break up the day-old rice and press it flat for a minute.</li>\n<li data-kid=\"2-1-7-2-4\" data-name=\"cooking step 4 aromatics\">Add the garlic, ginger and spring onion and stir for thirty seconds.</li>\n<li data-kid=\"2-1-7-2-5\" data-name=\"cooking step 5 soy sauce toss\">Splash in the soy sauce and toss hard until the rice darkens.</li>\n<li data-kid=\"2-1-7-2-6\" data-name=\"cooking step 6 fold tofu and taste\">Fold the tofu back through, off the heat, and taste for salt.</li>\n<li data-kid=\"2-1-7-2-7\" data-name=\"cooking step 7 serve\">Serve from the pan with the extra spring onion on top.</li>\n</ol>\n</section>\n<section data-kid=\"2-1-8\" data-name=\"similar recipes section\" id=\"similar\">\n<h2 data-kid=\"2-1-8-1\" data-name=\"similar recipes heading\">Similar</h2>\n<div class=\"similar\" data-kid=\"2-1-8-2\" data-name=\"similar recipes list\">\n<a data-kid=\"2-1-8-2-1\" data-name=\"similar recipe link garlic oil pasta\" href=\"/recipes/garlic-oil-pasta-with-kale-0a1b2c3d\">\n<span class=\"t\" data-kid=\"2-1-8-2-1-1\" data-name=\"similar recipe title garlic oil pasta\">Garlic oil pasta with kale</span>\n<span class=\"m\" data-kid=\"2-1-8-2-1-2\" data-name=\"similar recipe duration meta\">20 min</span>\n<span class=\"m\" data-kid=\"2-1-8-2-1-3\" data-name=\"similar recipe calorie meta\">520 kcal</span>\n</a>\n<a data-kid=\"2-1-8-2-2\" data-name=\"similar recipe link skillet beans\" href=\"/recipes/skillet-beans-and-greens-0a1b2c3e\">\n<span class=\"t\" data-kid=\"2-1-8-2-2-1\" data-name=\"similar recipe title skillet beans\">Skillet beans and greens</span>\n<span class=\"m\" data-kid=\"2-1-8-2-2-2\" data-name=\"similar recipe duration meta\">25 min</span>\n<span class=\"m\" data-kid=\"2-1-8-2-2-3\" data-name=\"similar recipe calorie meta\">410 kcal</span>\n</a>\n<a data-kid=\"2-1-8-2-3\" data-name=\"similar recipe link lemon lentils\" href=\"/recipes/lemon-lentils-with-herbs-0a1b2c3f\">\n<span class=\"t\" data-kid=\"2-1-8-2-3-1\" data-name=\"similar recipe title lemon lentils\">Lemon lentils with herbs</span>\n<span class=\"m\" data-kid=\"2-1-8-2-3-2\" data-name=\"similar recipe duration meta\">35 min</span>\n<span class=\"m\" data-kid=\"2-1-8-2-3-3\" data-name=\"similar recipe calorie meta\">380 kcal</span>\n</a>\n</div>\n</section>\n</article>\n</main>\n<footer class=\"site-footer\" data-kid=\"3\" data-name=\"site footer\">\n<div class=\"frame\" data-kid=\"3-1\" data-name=\"footer inner layout frame\">\n<p class=\"disclaimer\" data-kid=\"3-1-1\" data-name=\"footer disclaimer text\">Recipes are generated by a small model. Check ingredients and allergens yourself.</p>\n<p class=\"legal\" data-kid=\"3-1-2\" data-name=\"footer legal links row\"><a data-kid=\"3-1-2-1\" data-name=\"terms link\" href=\"/terms\">Terms</a><a data-kid=\"3-1-2-2\" data-name=\"privacy link\" href=\"/privacy\">Privacy</a></p>\n</div>\n</footer>",
