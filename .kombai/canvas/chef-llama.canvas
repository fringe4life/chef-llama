      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(hsl(38 42% 96%), hsl(30 12% 8%));\n  --surface-2: light-dark(hsl(36 34% 93%), hsl(30 9% 15%));\n  --ink: light-dark(hsl(28 24% 15%), hsl(36 28% 93%));\n  --ink-muted: light-dark(hsl(30 9% 38%), hsl(30 8% 66%));\n  --ink-faint: light-dark(hsl(30 7% 50%), hsl(30 7% 54%));\n  --rule: light-dark(hsl(34 24% 85%), hsl(30 8% 21%));\n  --rule-hair: light-dark(hsl(34 22% 90%), hsl(30 8% 16%));\n  --rule-strong: light-dark(hsl(32 18% 70%), hsl(30 8% 30%));\n  --accent: light-dark(hsl(30 74% 37%), hsl(34 82% 60%));\n  --accent-ink: light-dark(hsl(40 60% 98%), hsl(30 45% 9%));\n  --focus: light-dark(hsl(214 80% 42%), hsl(210 90% 64%));\n  --sans: ui-sans-serif, system-ui, sans-serif;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --serif: ui-serif, Georgia, \"Times New Roman\", serif;\n}\nbody{margin:0;background:var(--background);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\n.app h1,.app h2,.app p,.app ul,.app li{margin:0}\n.app ul{padding:0;list-style:none}\n.num{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n\n.shell{display:flex;align-items:center;gap:28px;height:64px;padding:0 24px;border-bottom:1px solid var(--rule);box-sizing:border-box}\n.wordmark{font-size:17px;font-weight:700;letter-spacing:-.03em;color:var(--ink);text-decoration:none}\n.nav{display:flex;align-items:center;gap:22px;margin-left:8px}\n.nav a{font-size:13.5px;color:var(--ink-muted);text-decoration:none;padding:6px 0;border-bottom:2px solid transparent}\n.nav a[aria-current=\"page\"]{color:var(--ink);border-bottom-color:var(--accent)}\n.shell__end{margin-left:auto;display:flex;align-items:center}\n.avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--surface-2);border:1px solid var(--rule);font-size:11px;font-weight:600;color:var(--ink-muted)}\n\n.page{max-width:1232px;margin:0 auto;padding:26px 24px 56px;box-sizing:border-box;container-type:inline-size;container-name:page}\n.page__head{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.page__head h1{font-size:24px;font-weight:600;letter-spacing:-.015em;line-height:1.1}\n.page__cta{margin-left:auto}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:6px;border:1px solid transparent;background:var(--accent);color:var(--accent-ink);font-family:inherit;font-size:13.5px;font-weight:600;text-decoration:none;cursor:pointer;box-sizing:border-box;white-space:nowrap}\n.btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}\n.btn--ghost{background:transparent;color:var(--ink);border-color:var(--rule-strong)}\n.textlink{font-size:12.5px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-strong);padding-bottom:1px}\n.textlink:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n\n.band{display:grid;grid-template-columns:minmax(0,1fr);margin-top:22px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.band__cell{padding:18px 0}\n.band__label{font-size:12px;color:var(--ink-muted)}\n.band__value{display:flex;align-items:baseline;gap:8px;margin-top:2px}\n.band__value b{font-size:34px;font-weight:500;line-height:1.05;color:var(--ink-faint)}\n.band__value span{font-size:13px;color:var(--ink-muted)}\n.band__note{font-size:13px;color:var(--ink-muted);margin-top:5px}\n.band .textlink{display:inline-block;margin-top:10px}\n\n.section{margin-top:26px}\n.section__head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}\n.section__head h2{font-size:15px;font-weight:600;letter-spacing:-.005em}\n.segmented{display:inline-flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden;margin-left:auto}\n.segmented button{height:34px;padding:0 12px;border:0;background:transparent;color:var(--ink-muted);font-family:inherit;font-size:12.5px;cursor:pointer}\n.segmented button + button{border-left:1px solid var(--rule)}\n.segmented button[aria-pressed=\"true\"]{background:var(--surface-2);color:var(--ink);font-weight:600}\n\n.failed{margin-top:16px;padding:30px 0 28px;border-top:1px solid var(--rule-hair);border-bottom:1px solid var(--rule-hair)}\n.failed__title{font-size:15px;font-weight:600}\n.failed__note{font-size:13px;color:var(--ink-muted);margin-top:4px}\n.failed .textlink{display:inline-block;margin-top:10px}\n\n.table{width:100%;border-collapse:collapse}\n.table th{height:36px;padding:0 12px;vertical-align:middle;font-size:12px;font-weight:500;color:var(--ink-muted);text-align:left;border-bottom:1px solid var(--rule);white-space:nowrap}\n.table td{height:40px;padding:0 12px;vertical-align:middle;font-size:13.5px;border-bottom:1px solid var(--rule-hair)}\n.table th:first-child,.table td:first-child{padding-left:0}\n.table th:last-child,.table td:last-child{padding-right:0}\n.table .r{text-align:right}\n.table td.t-date{font-family:var(--serif);font-size:13.5px}\n.table__foot{display:flex;gap:10px;align-items:baseline;padding-top:12px;font-size:12.5px;color:var(--ink-muted);font-family:var(--mono)}\n.eventid{font-family:var(--mono);font-size:11.5px;color:var(--ink-faint)}\n\n@container (max-width: 780px) {\n  .shell{padding:0 16px}\n  .nav{display:none}\n  .page{padding:20px 16px 44px}\n  .page__cta{margin-left:0;width:100%}\n  .page__cta .btn{width:100%}\n  .section__head .segmented{margin-left:0}\n  .col--ref{display:none}\n}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"shell\" data-kid=\"1-1\" data-name=\"application top shell bar\">\n<a class=\"wordmark\" data-kid=\"1-1-1\" data-name=\"brand wordmark link\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-2-1\" data-name=\"main nav link to Pantry\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" data-name=\"main nav link to Recipes\" href=\"/recipes\">Recipes</a>\n<a data-kid=\"1-1-2-3\" data-name=\"main nav link to Saved\" href=\"/saved\">Saved</a>\n<a aria-current=\"page\" data-kid=\"1-1-2-4\" data-name=\"main nav link to Dashboard (active)\" href=\"/dashboard\">Dashboard</a>\n<a data-kid=\"1-1-2-5\" data-name=\"main nav link to Billing\" href=\"/billing\">Billing</a>\n</nav>\n<div class=\"shell__end\" data-kid=\"1-1-3\" data-name=\"right-aligned top bar controls container\"><span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-3-1\" data-name=\"user avatar initials\">AR</span></div>\n</header>\n<main class=\"page\" data-kid=\"1-2\" data-name=\"main dashboard content\">\n<div class=\"page__head\" data-kid=\"1-2-1\" data-name=\"page header with title and action\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page heading (Dashboard)\">Dashboard</h1>\n<div class=\"page__cta\" data-kid=\"1-2-1-2\" data-name=\"header action button container\"><a class=\"btn btn--ghost\" data-kid=\"1-2-1-2-1\" data-name=\"buy credits button\" href=\"/topup\">Buy Credits</a></div>\n</div>\n<section aria-label=\"Credit account\" class=\"band\" data-kid=\"1-2-2\" data-name=\"credit account status band\">\n<div class=\"band__cell\" data-kid=\"1-2-2-1\" data-name=\"credit account cell\">\n<p class=\"band__label\" data-kid=\"1-2-2-1-1\" data-name=\"credits availability label\">Available</p>\n<p class=\"band__value\" data-kid=\"1-2-2-1-2\" data-name=\"credits value display\"><b class=\"num\" data-kid=\"1-2-2-1-2-1\" data-name=\"credits numeric value\">—</b><span data-kid=\"1-2-2-1-2-2\" data-name=\"credits unit label\">Credits</span></p>\n<p class=\"band__note\" data-kid=\"1-2-2-1-3\" data-name=\"credits load error note\">Couldn't load your Credits or the daily gift.</p>\n<a class=\"textlink\" data-kid=\"1-2-2-1-4\" data-name=\"credits retry link\" href=\"/dashboard\">Try again</a>\n</div>\n</section>\n<section aria-labelledby=\"cooks-h\" class=\"section\" data-kid=\"1-2-3\" data-name=\"cooks activity section\">\n<div class=\"section__head\" data-kid=\"1-2-3-1\" data-name=\"section header with title and range toggle\">\n<h2 data-kid=\"1-2-3-1-1\" data-name=\"section heading (Cooks)\" id=\"cooks-h\">Cooks</h2>\n<div aria-label=\"Range\" class=\"segmented\" data-kid=\"1-2-3-1-2\" data-name=\"time range toggle group\" role=\"group\">\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-1\" data-name=\"1 week range toggle button\" type=\"button\">1 week</button>\n<button aria-pressed=\"true\" data-kid=\"1-2-3-1-2-2\" data-name=\"1 month range toggle button (active)\" type=\"button\">1 month</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-3\" data-name=\"1 year range toggle button\" type=\"button\">1 year</button>\n</div>\n</div>\n<div class=\"failed\" data-kid=\"1-2-3-2\" data-name=\"cooks load error panel\">\n<p class=\"failed__title\" data-kid=\"1-2-3-2-1\" data-name=\"cooks error message title\">Couldn't load cooks.</p>\n<p class=\"failed__note\" data-kid=\"1-2-3-2-2\" data-name=\"cooks error reassurance note\">Your recipes are safe. This is only the chart.</p>\n<a class=\"textlink\" data-kid=\"1-2-3-2-3\" data-name=\"cooks retry link\" href=\"/dashboard?range=month\">Try again</a>\n</div>\n</section>\n<section aria-labelledby=\"purchases-h\" class=\"section\" data-kid=\"1-2-4\" data-name=\"purchases section\">\n<div class=\"section__head\" data-kid=\"1-2-4-1\" data-name=\"purchases section header\"><h2 data-kid=\"1-2-4-1-1\" data-name=\"section heading (Purchases)\" id=\"purchases-h\">Purchases</h2></div>\n<table class=\"table\" data-kid=\"1-2-4-2\" data-name=\"purchases transaction table\" style=\"margin-top:14px\">\n<thead data-kid=\"1-2-4-2-1\" data-name=\"purchases table header row\">\n<tr data-kid=\"1-2-4-2-1-1\" data-name=\"purchases table header cells row\">\n<th data-kid=\"1-2-4-2-1-1-1\" data-name=\"Date column header\" scope=\"col\">Date</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"Amount column header (right-aligned)\" scope=\"col\">Amount</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-3\" data-name=\"Credits column header (right-aligned)\" scope=\"col\">Credits</th>\n<th class=\"col--ref\" data-kid=\"1-2-4-2-1-1-4\" data-name=\"Event ID column header\" scope=\"col\">Event ID</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-4-2-2\" data-name=\"purchases table body rows\">\n<tr data-kid=\"1-2-4-2-2-1\" data-name=\"purchase row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"purchase date cell\">21 October 2026</td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"purchase amount cell\">NZ$32.00</td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-1-3\" data-name=\"purchase credits amount cell\">120</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-1-4\" data-name=\"purchase event ID cell\"><span class=\"eventid\" data-kid=\"1-2-4-2-2-1-4-1\" data-name=\"purchase event ID value\">evt_1Q9xWv2eZvKYlo2Cq4bHn7Ts</span></td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-2\" data-name=\"purchase row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"purchase date cell\">2 October 2026</td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"purchase amount cell\">NZ$16.00</td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-2-3\" data-name=\"purchase credits amount cell\">50</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-2-4\" data-name=\"purchase event ID cell\"><span class=\"eventid\" data-kid=\"1-2-4-2-2-2-4-1\" data-name=\"purchase event ID value\">evt_1Q6mRd2eZvKYlo2Cx8fJk2Vb</span></td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-3\" data-name=\"purchase row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"purchase date cell\">12 September 2026</td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"purchase amount cell\">NZ$8.00</td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-3-3\" data-name=\"purchase credits amount cell\">20</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-3-4\" data-name=\"purchase event ID cell\"><span class=\"eventid\" data-kid=\"1-2-4-2-2-3-4-1\" data-name=\"purchase event ID value\">evt_1Q3pLc2eZvKYlo2Cm5dHg9Wn</span></td>\n</tr>\n</tbody>\n</table>\n<p class=\"table__foot\" data-kid=\"1-2-4-3\" data-name=\"table footer totals text\">3 purchases · NZ$56.00 · 190 Credits</p>\n</section>\n</main>\n</div>\n",
