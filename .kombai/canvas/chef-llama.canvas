      "html": "<script data-asset-crawler=\"\">\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19067/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/larder-site.canvas\", nodeId: \"var_paletteBeet\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  \n\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.962 0.012 92), oklch(0.180 0.012 60));\n    --foreground: light-dark(oklch(0.250 0.030 40), oklch(0.940 0.012 88));\n    --card: light-dark(oklch(0.992 0.005 92), oklch(0.228 0.014 60));\n    --card-foreground: light-dark(oklch(0.250 0.030 40), oklch(0.940 0.012 88));\n    --secondary: light-dark(oklch(0.935 0.018 90), oklch(0.258 0.016 60));\n    --secondary-foreground: light-dark(oklch(0.250 0.030 40), oklch(0.940 0.012 88));\n    --muted: light-dark(oklch(0.932 0.016 90), oklch(0.255 0.016 60));\n    --muted-foreground: light-dark(oklch(0.460 0.016 55), oklch(0.740 0.014 80));\n    --primary: light-dark(oklch(0.470 0.195 350), oklch(0.720 0.180 348));\n    --primary-foreground: light-dark(oklch(0.985 0.010 340), oklch(0.180 0.040 348));\n    --accent: light-dark(oklch(0.925 0.078 120), oklch(0.300 0.048 120));\n    --accent-foreground: light-dark(oklch(0.320 0.050 120), oklch(0.900 0.045 118));\n    --border: light-dark(oklch(0.880 0.020 80), oklch(0.325 0.014 60));\n    --input: light-dark(oklch(0.860 0.022 80), oklch(0.345 0.016 60));\n    --ring: light-dark(oklch(0.470 0.195 350), oklch(0.720 0.180 348));\n\n    --veg: light-dark(oklch(0.590 0.150 128), oklch(0.815 0.130 128));\n    --veg-ink: light-dark(oklch(0.460 0.118 128), oklch(0.800 0.120 128));\n    --meat: light-dark(oklch(0.440 0.170 12), oklch(0.560 0.150 12));\n    --fruit: light-dark(oklch(0.780 0.145 100), oklch(0.850 0.115 100));\n    --fruit-ink: light-dark(oklch(0.470 0.094 96), oklch(0.850 0.115 100));\n    --chart-1: var(--veg);\n    --chart-2: var(--meat);\n    --chart-1-past: light-dark(oklch(0.900 0.045 128), oklch(0.330 0.040 128));\n    --chart-2-past: light-dark(oklch(0.895 0.045 12), oklch(0.340 0.045 12));\n    --chart-past-rim: light-dark(oklch(0.640 0.020 70), oklch(0.520 0.020 60));\n\n    --field: light-dark(oklch(0.400 0.155 350), oklch(0.380 0.145 350));\n    --field-foreground: light-dark(oklch(0.985 0.008 340), oklch(0.975 0.015 340));\n    --field-muted: light-dark(oklch(0.840 0.048 340), oklch(0.820 0.048 340));\n    --field-border: light-dark(oklch(0.505 0.125 350), oklch(0.500 0.115 350));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) - 4px);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) + 4px);\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n\n    --leading-tight: 1.2;\n    --leading-body: 1.55;\n    --tracking-display: -0.02em;\n    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  html:has(#scheme-light:checked) { color-scheme: light; }\n  html:has(#scheme-dark:checked) { color-scheme: dark; }\n\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: 15px;\n    line-height: var(--leading-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, h3, p, dl, dd, dt, ol, ul, fieldset, legend { margin: 0; }\n  ul, ol { padding: 0; list-style: none; }\n  a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }\n\n  .wrap { width: 100%; max-width: 1152px; margin: 0 auto; padding: 0 20px; box-sizing: border-box; }\n  @media (min-width: 768px) { .wrap { padding: 0 32px; } }\n\n  .label {\n    font-family: var(--font-mono);\n    font-size: 10px;\n    line-height: 1.4;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n\n  .site-header { border-bottom: 1px solid var(--border); }\n  .site-header .wrap { display: flex; align-items: center; gap: 32px; height: 80px; }\n  .wordmark {\n    font-family: var(--font-display);\n    font-size: 22px;\n    font-weight: 600;\n    line-height: 1;\n    letter-spacing: -0.01em;\n    color: var(--foreground);\n    text-decoration: none;\n  }\n  .site-nav { display: none; align-items: center; gap: 24px; }\n  @media (min-width: 768px) { .site-nav { display: flex; } }\n  .site-nav a { font-size: 14px; color: var(--muted-foreground); text-decoration: none; }\n  .site-nav a:hover { color: var(--foreground); }\n  .btn {\n    margin-left: auto;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 44px;\n    padding: 0 20px;\n    border: 1px solid var(--primary);\n    border-radius: var(--radius-md);\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.2;\n    text-decoration: none;\n    white-space: nowrap;\n    transition: background-color 120ms var(--ease-out), transform 120ms var(--ease-out);\n  }\n  .btn:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n  .btn:active { transform: scale(0.97); }\n\n  .hero__inner { padding: 40px 0; }\n  @media (min-width: 768px) { .hero__inner { padding: 48px 0; } }\n  .hero__grid { display: grid; gap: 24px; }\n  @media (min-width: 768px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 336px; gap: 64px; align-items: end; } }\n  .hero__title { max-width: 700px; font-size: 30px; font-weight: 600; line-height: 1.08; letter-spacing: -0.025em; }\n  .hero__title .ln { display: inline; }\n  @media (min-width: 768px) { .hero__title { font-size: 42px; } .hero__title .ln { display: block; } }\n  .hero__note { max-width: 340px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 15px; color: var(--muted-foreground); }\n  @media (min-width: 768px) { .hero__note { padding-top: 0; border-top: 0; } }\n\n  .specimen {\n    margin-top: 32px;\n    display: grid;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n  }\n  @media (min-width: 768px) { .specimen { margin-top: 40px; } }\n  @media (min-width: 1024px) { .specimen { grid-template-columns: 300px minmax(0, 1fr); } }\n  .specimen__pantry {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 20px;\n    border-bottom: 1px solid var(--border);\n    background: var(--secondary);\n  }\n  @media (min-width: 1024px) { .specimen__pantry { border-bottom: 0; border-right: 1px solid var(--border); } }\n  .pantry__list { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }\n  .tape {\n    display: inline-flex;\n    align-items: center;\n    min-height: 32px;\n    padding: 0 11px;\n    border: 1px dashed color-mix(in oklab, var(--border) 55%, var(--foreground));\n    border-radius: var(--radius-sm);\n    background: var(--card);\n    color: var(--foreground);\n    font-size: 14px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n  .pantry__attrs { display: grid; gap: 8px; padding-top: 16px; border-top: 1px solid var(--border); }\n  .attr { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .attr dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }\n  .attr dd { font-size: 13px; }\n\n  .specimen__body { padding: 20px; }\n  @media (min-width: 768px) { .specimen__body { padding: 24px; } }\n  .specimen__meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }\n  .tag { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: var(--veg-ink); }\n  .tag__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--veg); }\n  .specimen__title { margin-top: 8px; font-family: var(--font-display); font-size: 26px; font-weight: 600; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  @media (min-width: 768px) { .specimen__title { font-size: 30px; } }\n\n  .stats {\n    margin-top: 16px;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n    padding: 12px 0;\n    border-top: 1px solid var(--border);\n    border-bottom: 1px solid var(--border);\n  }\n  .stat dd { margin-top: 4px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 15px; font-weight: 500; letter-spacing: -0.02em; }\n\n  .pairs { margin-top: 16px; display: grid; gap: 12px; }\n  @media (min-width: 640px) { .pairs { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }\n  .pairs p { margin-top: 4px; font-size: 14px; }\n  .swap__from { color: var(--muted-foreground); text-decoration: line-through; text-decoration-thickness: 1px; }\n  .swap__arrow { padding: 0 4px; color: var(--muted-foreground); }\n  .swap__to { font-weight: 500; color: var(--fruit-ink); }\n\n  .steps { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); display: grid; gap: 8px; font-size: 14px; }\n  .step { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 8px; }\n  .step__n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 12px; line-height: 1.6; color: var(--muted-foreground); }\n\n  /* the deep field: one saturated mass on the page */\n  .field {\n    background: var(--field);\n    color: var(--field-foreground);\n    border-top: 1px solid var(--field-border);\n    border-bottom: 1px solid var(--field-border);\n  }\n  .field__inner { padding: 44px 0; }\n  .field__grid { display: grid; gap: 0; }\n  @media (min-width: 768px) { .field__grid { grid-template-columns: 0.8fr 1.35fr 1fr; } }\n  .field__step { padding-top: 32px; border-top: 1px solid var(--field-border); }\n  .field__step:first-child { padding-top: 0; border-top: 0; }\n  @media (min-width: 768px) {\n    .field__step { padding: 0 0 0 24px; border-top: 0; border-left: 1px solid var(--field-border); }\n    .field__step:first-child { padding: 0 24px 0 0; border-left: 0; }\n  }\n  .field__step h3 {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    font-size: 17px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    color: var(--field-foreground);\n  }\n  .field__step h3 span {\n    font-family: var(--font-mono);\n    font-variant-numeric: tabular-nums;\n    font-size: 12px;\n    font-weight: 400;\n    color: var(--field-muted);\n  }\n  .field .tape {\n    background: transparent;\n    border-color: var(--field-border);\n    color: var(--field-foreground);\n  }\n  .field .label { color: var(--field-muted); }\n  .field .note { color: var(--field-muted); }\n  .field .constraint dt { color: var(--field-muted); }\n  .field .copylist li { border-color: var(--field-border); }\n  .field .copylist li span:last-child { color: var(--field-muted); }\n\n  .chips { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }\n  .note { margin-top: 16px; font-size: 13px; color: var(--muted-foreground); }\n  .constraints { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px 24px; }\n  .constraint { display: flex; align-items: baseline; gap: 8px; }\n  .constraint dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }\n  .constraint dd { font-size: 13px; }\n  .copylist { margin-top: 16px; display: grid; gap: 8px; font-size: 13px; }\n  .copylist li { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }\n  .copylist li:last-child { padding-bottom: 0; border-bottom: 0; }\n  .copylist li span:last-child { color: var(--muted-foreground); }\n  .free {\n    background: var(--field);\n    color: var(--field-foreground);\n    border-top: 1px solid var(--field-border);\n    border-bottom: 1px solid var(--field-border);\n  }\n  .free__inner { padding: 28px 0; }\n  .free__grid { display: grid; gap: 16px; }\n  @media (min-width: 768px) { .free__grid { grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: center; } }\n  .free__title { font-size: 26px; font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; }\n  .free__title .n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 400; font-size: 32px; line-height: 1; color: var(--field-foreground); }\n  .free__note { margin-top: 6px; font-size: 13px; color: var(--field-muted); }\n  .free__link { font-size: 14px; font-weight: 600; color: var(--field-foreground); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }\n  .free__link:hover { text-decoration-thickness: 2px; }\n  .strip { background: var(--accent); color: var(--foreground); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n  .strip .field__step { border-color: var(--border); }\n  .strip .field__step h3 { color: var(--foreground); }\n  .strip .field__step h3 span { color: var(--muted-foreground); }\n  .popular__inner { padding: 48px 0; }\n  @media (min-width: 768px) { .popular__inner { padding: 56px 0; } }\n  .sectionhead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .sectionhead h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .sectionhead p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .table { margin-top: 24px; border-top: 1px solid var(--border); }\n  .thead { display: none; }\n  @media (min-width: 768px) {\n    .thead {\n      display: grid;\n      grid-template-columns: 48px minmax(0, 1fr) 96px 136px 112px;\n      gap: 16px;\n      align-items: baseline;\n      padding: 8px 6px;\n      border-bottom: 1px solid var(--border);\n    }\n    .thead span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-foreground); }\n    .thead .th--num { text-align: right; }\n  }\n  .row { border-bottom: 1px solid var(--border); }\n  .row a {\n    display: grid;\n    grid-template-columns: 32px minmax(0, 1fr);\n    align-items: baseline;\n    gap: 4px 16px;\n    padding: 14px 6px;\n    color: var(--foreground);\n    text-decoration: none;\n    transition: background-color 140ms var(--ease-out);\n  }\n  .row a:hover { background: var(--accent); }\n  @media (min-width: 768px) {\n    .row a { grid-template-columns: 48px minmax(0, 1fr) 96px 136px 112px; gap: 16px; padding: 16px 6px; }\n    .row a:hover .title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }\n  }\n  .rank { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; color: var(--muted-foreground); }\n  .title { font-family: var(--font-display); font-size: 20px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }\n  .figure { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; letter-spacing: -0.02em; }\n  .unit { margin-left: 4px; font-size: 13px; color: var(--muted-foreground); }\n  @media (max-width: 767.98px) { .figure { grid-column: 2; } }\n  @media (min-width: 768px) {\n    .row .figure { text-align: right; }\n    .unit { display: none; }\n  }\n\n  .strip--plain { background: transparent; border-color: var(--border); }\n  .pop { background: var(--accent); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n  .pop__inner { padding: 48px 0 56px; }\n  @media (min-width: 768px) { .pop__inner { padding: 56px 0 64px; } }\n  .pop__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .pop__head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .pop__head p { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 12px; color: var(--muted-foreground); }\n  .cards { margin-top: 24px; display: grid; gap: 10px; }\n  .cards > li { display: grid; container: card / inline-size; }\n  @media (min-width: 768px) {\n    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n    .cards > li:first-child { grid-column: 1 / -1; }\n    .cards > li:first-child .card { padding: 22px 24px 24px; }\n    .cards > li:first-child .card__title { font-size: 28px; }\n    .cards > li:first-child .card__ings { -webkit-line-clamp: 1; line-clamp: 1; }\n  }\n  .card {\n    display: grid;\n    grid-template-columns: 40px minmax(0, 1fr);\n    grid-template-areas:\n      \"rank title\"\n      \"rank ings\"\n      \"rank meta\";\n    align-content: start;\n    column-gap: 16px;\n    padding: 18px 20px 20px;\n    border: 1px solid color-mix(in oklab, var(--veg-ink) 38%, var(--accent));\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--foreground);\n    text-decoration: none;\n    transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out);\n  }\n  .card:hover { transform: scale(0.984); border-color: var(--primary); }\n  .card:active { transform: scale(0.972); }\n  .card__body { display: contents; }\n  .card__rank { grid-area: rank; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 26px; line-height: 1; color: var(--muted-foreground); }\n  .card__title { grid-area: title; font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.14; letter-spacing: -0.01em; transition: transform 220ms var(--ease-out); transform-origin: left center; }\n  @media (min-width: 768px) { .card__title { font-size: 24px; } }\n  .card:hover .card__title { transform: scale(1.02); }\n  .card__ings { grid-area: ings; min-width: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; margin-top: 7px; padding-bottom: 12px; border-bottom: 1px solid var(--border); font-size: 13px; line-height: 1.45; color: var(--muted-foreground); }\n  @media (max-width: 767.98px) {\n    .card__rank { font-size: 18px; }\n  }\n  .card__meta { grid-area: meta; display: grid; grid-template-columns: minmax(0, 1fr); gap: 7px; margin-top: 14px; min-width: 0; }\n  .card__meta > span { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 12px; min-width: 0; }\n  .card__fig { grid-column: 2; grid-row: 1; text-align: right; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; line-height: 1.3; letter-spacing: -0.02em; white-space: nowrap; }\n  .card__unit { grid-column: 1; grid-row: 1; font-family: var(--font-mono); font-size: 10px; line-height: 1.4; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; color: var(--muted-foreground); }\n  @container card (min-width: 380px) and (max-width: 779.98px) {\n    .card__meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); gap: 0 10px; }\n    .card__meta > span { grid-template-columns: minmax(0, 1fr); gap: 3px; }\n    .card__fig { grid-column: 1; grid-row: 1; text-align: left; }\n    .card__unit { grid-column: 1; grid-row: 2; }\n  }\n  @container card (min-width: 780px) {\n    .card {\n      grid-template-columns: 40px minmax(0, 1fr) 264px;\n      grid-template-areas:\n        \"rank title meta\"\n        \"rank ings meta\";\n      column-gap: 22px;\n    }\n    .card__title { align-self: start; }\n    .card__ings { align-self: end; }\n    .card__ings { padding-bottom: 0; border-bottom: none; }\n    .card__meta { margin-top: 0; padding-left: 22px; border-left: 1px solid var(--border); gap: 12px; align-content: start; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .card, .card__title { transition: none; }\n    .card:hover, .card:active { transform: none; }\n    .card:hover .card__title { transform: none; }\n  }\n  /* packs: four one-time purchase tiers, no subscription */\n  .packs { border-top: 1px solid var(--border); }\n  .packs__inner { padding: 48px 0 56px; }\n  @media (min-width: 768px) { .packs__inner { padding: 56px 0 64px; } }\n  .packs__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .packs__head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .packs__head p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n  .packs__grid { margin-top: 24px; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }\n  @media (min-width: 640px) { .packs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (min-width: 1024px) { .packs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }\n  .pack { display: flex; flex-direction: column; padding: 18px 20px 20px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n  .pack--starter { border-color: color-mix(in oklab, var(--veg-ink) 40%, var(--border)); }\n  .pack--best { border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n  .pack__top { min-height: 26px; }\n  .pack__flag { display: inline-flex; align-items: center; min-height: 22px; padding: 0 8px; border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-foreground); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; }\n  .pack__price { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 30px; line-height: 1; letter-spacing: -0.03em; }\n  .pack__credits { margin-top: 6px; font-size: 15px; font-weight: 600; }\n  .pack__rate { margin-top: 4px; margin-bottom: 18px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 11px; color: var(--muted-foreground); }\n  .pack__buy { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--foreground); font-size: 13px; font-weight: 600; text-decoration: none; }\n  .pack__buy:hover { border-color: var(--foreground); }\n  .pack--starter .pack__buy { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n  .pack--starter .pack__buy:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); border-color: transparent; }\n  .packs__fine { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n  .free__note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }\n\n  .site-footer { background: var(--secondary); border-top: 1px solid var(--border); }\n  .site-footer .wrap { padding-top: 32px; padding-bottom: 32px; }\n  .footer__grid { display: grid; gap: 32px; }\n  @media (min-width: 768px) { .footer__grid { grid-template-columns: minmax(0, 1fr) auto; gap: 64px; align-items: end; } }\n  .footer__brand { font-family: var(--font-display); font-size: 18px; font-weight: 600; line-height: 1; letter-spacing: var(--tracking-display); }\n  .footer__note { margin-top: 12px; max-width: 46ch; font-size: 13px; color: var(--muted-foreground); }\n  .footer__links { margin-top: 16px; display: flex; gap: 24px; }\n  .footer__links a { font-size: 13px; color: var(--foreground); text-decoration: none; }\n  .footer__links a:hover { text-decoration: underline; text-underline-offset: 4px; }\n\n  .scheme { min-width: 0; padding: 0; border: 0; }\n  .scheme legend { margin-bottom: 8px; padding: 0; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }\n  .switch { display: inline-flex; align-items: center; gap: 4px; padding: 4px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); }\n  .opt { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 0 12px; border-radius: calc(var(--radius-md) - 2px); font-size: 12px; color: var(--muted-foreground); cursor: pointer; }\n  .opt input { position: absolute; width: 1px; height: 1px; opacity: 0; }\n  .opt span { display: inline-flex; align-items: center; min-height: 30px; padding: 0 8px; border-radius: calc(var(--radius-md) - 3px); }\n  .opt input:checked + span { background: var(--primary); color: var(--primary-foreground); }\n  .opt input:focus-visible + span { outline: 2px solid var(--ring); outline-offset: 2px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .btn { transition: none; }\n    .btn:active { transform: none; }\n    .row a { transition: opacity 120ms linear; }\n  }\n</style>\n<div data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"site-header\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"wrap\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<a class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"brand wordmark link\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Site\" class=\"site-nav\" data-kid=\"1-1-1-2\" data-name=\"site main navigation\"><a data-kid=\"1-1-1-2-1\" data-name=\"nav link to popular recipes\" href=\"#popular\">Popular</a><a href=\"#credits\">Credits</a></nav>\n<a class=\"btn\" data-kid=\"1-1-1-3\" data-name=\"primary start-cooking button\" href=\"/pantry\">Start cooking</a>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\" data-name=\"hero inner container\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\" data-name=\"hero two-column grid\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero main headline\" id=\"site-hero\"><span class=\"ln\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline line one\">You’ve got the Pantry.</span> <span class=\"ln\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline line two\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\" data-name=\"hero supporting note text\">Your Diet and allergies are hard limits. You cook it, save it, and find similar dishes from the same Pantry.</p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\" data-name=\"example recipe specimen card\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\" data-name=\"specimen pantry panel\">\n<div data-kid=\"1-2-1-2-1-1\" data-name=\"pantry ingredient label and chips\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"pantry section label\" style=\"font-size:11px; letter-spacing:0.16em\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"pantry ingredient chips list\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"pantry chip: firm tofu\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"pantry chip: day-old rice\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\" data-name=\"pantry chip: soy sauce\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\" data-name=\"pantry attributes list\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"pantry attr row: diet\"><dt data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"pantry attr label: diet\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"pantry attr value: vegan\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"pantry attr row: allergy\"><dt data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"pantry attr label: allergy\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"pantry attr value: sesame\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"pantry attr row: servings\"><dt data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"pantry attr label: servings\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\" data-name=\"pantry attr value: 2\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\" data-name=\"specimen body panel\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\" data-name=\"specimen meta row (label + tag)\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"specimen example-recipe label\" style=\"font-size:10px; letter-spacing:0.16em\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"diet tag with dot (vegan)\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"tag status dot\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" data-name=\"specimen recipe title\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\" data-name=\"recipe stats grid\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"stat cell: minutes\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"stat label: minutes\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"stat value: 25\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"stat cell: servings\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"stat label: servings\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"stat value: 2\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\" data-name=\"stat cell: kcal per serving\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\" data-name=\"stat label: kcal per serving\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\" data-name=\"stat value: 480\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\" data-name=\"recipe extras pair row\">\n<div data-kid=\"1-2-1-2-2-4-1\" data-name=\"staples block\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\" data-name=\"staples label\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\" data-name=\"staples value text\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\" data-name=\"swap block\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\" data-name=\"swap label\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\" data-name=\"swap value with from, arrow, and to\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\" data-name=\"swapped-from ingredient (struck)\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\" data-name=\"swap arrow icon\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\" data-name=\"swapped-to ingredient\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\" data-name=\"recipe steps list\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\" data-name=\"step row 1\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\" data-name=\"step number 1\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\" data-name=\"step 1 instruction text\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\" data-name=\"step row 2\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\" data-name=\"step number 2\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\" data-name=\"step 2 instruction text\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\" data-name=\"step row 3\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\" data-name=\"step number 3\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\" data-name=\"step 3 instruction text\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\" data-name=\"step row 4\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\" data-name=\"step number 4\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\" data-name=\"step 4 instruction text\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"free-heading\" class=\"free\" data-kid=\"1-6\" data-name=\"daily-free-cooks band\">\n<div class=\"wrap free__inner\" data-kid=\"1-6-1\" data-name=\"free band inner container\">\n<div class=\"free__grid\" data-kid=\"1-6-1-1\" data-name=\"free band grid\">\n<div data-kid=\"1-6-1-1-1\" data-name=\"free band text block\">\n<h2 class=\"free__title\" data-kid=\"1-6-1-1-1-1\" data-name=\"free band headline\" id=\"free-heading\">Up to 3 free cooks a day.</h2>\n<p class=\"free__note\" data-kid=\"1-6-1-1-1-2\" data-name=\"free band sub-note\">First come first served from a shared pool. <a href=\"#credits\">Credits</a> when you need more.</p>\n</div>\n<a class=\"free__link\" data-kid=\"1-6-1-1-2\" data-name=\"free band start-cooking link\" href=\"/pantry\">Start cooking</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"strip strip--plain\" data-kid=\"1-3\" data-name=\"how-a-cook-runs section\">\n<div class=\"wrap field__inner\" data-kid=\"1-3-1\" data-name=\"how-a-cook-runs inner container\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-1\" data-name=\"visually hidden process heading\" id=\"process-heading\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-3-1-2\" data-name=\"process steps list\">\n<li class=\"field__step\" data-kid=\"1-3-1-2-1\" data-name=\"process step: add ingredients\">\n<h3 data-kid=\"1-3-1-2-1-1\" data-name=\"process step heading: add ingredients\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"process step number 1\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-3-1-2-1-2\" data-name=\"example ingredient chips\">\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"example chip: firm tofu\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"example chip: day-old rice\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-3\" data-name=\"example chip: soy sauce\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-3-1-2-1-3\" data-name=\"example ingredients minimum note\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-2\" data-name=\"process step: chef writes recipe\">\n<h3 data-kid=\"1-3-1-2-2-1\" data-name=\"process step heading: chef writes recipe\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"process step number 2\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-3-1-2-2-2\" data-name=\"example constraint chips (diet/allergy/servings)\">\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"constraint row: diet\"><dt data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"constraint label: diet\">Diet</dt><dd data-kid=\"1-3-1-2-2-2-1-2\" data-name=\"constraint value: vegan\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"constraint row: allergy\"><dt data-kid=\"1-3-1-2-2-2-2-1\" data-name=\"constraint label: allergy\">Allergy</dt><dd data-kid=\"1-3-1-2-2-2-2-2\" data-name=\"constraint value: sesame\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-3\" data-name=\"constraint row: servings\"><dt data-kid=\"1-3-1-2-2-2-3-1\" data-name=\"constraint label: servings\">Servings</dt><dd data-kid=\"1-3-1-2-2-2-3-2\" data-name=\"constraint value: 2\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-3-1-2-2-3\" data-name=\"process step 2 explanation note\" style=\"max-width:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-3\" data-name=\"process step: cook the recipe\">\n<h3 data-kid=\"1-3-1-2-3-1\" data-name=\"process step heading: cook the recipe\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"process step number 3\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-3-1-2-3-2\" data-name=\"deliverables copy list\">\n<li data-kid=\"1-3-1-2-3-2-1\" data-name=\"deliverable row: method\"><span data-kid=\"1-3-1-2-3-2-1-1\" data-name=\"deliverable label: method\">Method</span><span data-kid=\"1-3-1-2-3-2-1-2\" data-name=\"deliverable description: method\">every step, numbered</span></li>\n<li data-kid=\"1-3-1-2-3-2-2\" data-name=\"deliverable row: save\"><span data-kid=\"1-3-1-2-3-2-2-1\" data-name=\"deliverable label: save\">Save</span><span data-kid=\"1-3-1-2-3-2-2-2\" data-name=\"deliverable description: save\">one tap to Saved</span></li>\n<li data-kid=\"1-3-1-2-3-2-3\" data-name=\"deliverable row: similar\"><span data-kid=\"1-3-1-2-3-2-3-1\" data-name=\"deliverable label: similar\">Similar</span><span data-kid=\"1-3-1-2-3-2-3-2\" data-name=\"deliverable description: similar\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"pop\" data-kid=\"1-4\" data-name=\"popular recipes section\" id=\"popular\">\n<div class=\"wrap pop__inner\" data-kid=\"1-4-1\" data-name=\"popular section inner container\">\n<div class=\"pop__head\" data-kid=\"1-4-1-1\" data-name=\"popular section header\">\n<h2 data-kid=\"1-4-1-1-1\" data-name=\"popular section heading\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-4-1-1-2\" data-name=\"popular rank-by subtitle\">Ranked by saves in the last 7 days</p>\n</div>\n<ol class=\"cards\" data-kid=\"1-4-1-2\" data-name=\"popular recipe cards list\">\n<li data-kid=\"1-4-1-2-1\" data-name=\"recipe card list item 1\">\n<a class=\"card\" data-kid=\"1-4-1-2-1-1\" data-name=\"recipe card 1 (skillet beans)\" href=\"/recipes/skillet-beans\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"recipe card rank 1\">1</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-1-1-2\" data-name=\"recipe card 1 body\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-1-1-2-1\" data-name=\"recipe card 1 title\">Skillet beans and greens</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-1-1-2-2\" data-name=\"recipe card 1 ingredients\">butter beans, cavolo nero, garlic, olive oil</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-1-1-2-3\" data-name=\"recipe card 1 stats row\"><span data-kid=\"1-4-1-2-1-1-2-3-1\" data-name=\"recipe card 1 stat: cook time\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-1-1\" data-name=\"recipe card 1 cook time figure\">25 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-1-2\" data-name=\"recipe card 1 cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-1-1-2-3-2\" data-name=\"recipe card 1 stat: kcal\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-2-1\" data-name=\"recipe card 1 kcal figure\">410 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-2-2\" data-name=\"recipe card 1 kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-1-1-2-3-3\" data-name=\"recipe card 1 stat: saves\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-3-1\" data-name=\"recipe card 1 saves figure\">86</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-3-2\" data-name=\"recipe card 1 saves unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-2\" data-name=\"recipe card list item 2\">\n<a class=\"card\" data-kid=\"1-4-1-2-2-1\" data-name=\"recipe card 2 (lemon lentils)\" href=\"/recipes/lemon-lentils\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"recipe card rank 2\">2</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"recipe card 2 body\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-2-1-2-1\" data-name=\"recipe card 2 title\">Lemon lentils with herbs</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-2-1-2-2\" data-name=\"recipe card 2 ingredients\">brown lentils, lemon, parsley, cumin</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-2-1-2-3\" data-name=\"recipe card 2 stats row\"><span data-kid=\"1-4-1-2-2-1-2-3-1\" data-name=\"recipe card 2 stat: cook time\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-1-1\" data-name=\"recipe card 2 cook time figure\">35 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-1-2\" data-name=\"recipe card 2 cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-2-1-2-3-2\" data-name=\"recipe card 2 stat: kcal\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-2-1\" data-name=\"recipe card 2 kcal figure\">380 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-2-2\" data-name=\"recipe card 2 kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-2-1-2-3-3\" data-name=\"recipe card 2 stat: saves\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-3-1\" data-name=\"recipe card 2 saves figure\">61</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-3-2\" data-name=\"recipe card 2 saves unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-3\" data-name=\"recipe card list item 3\">\n<a class=\"card\" data-kid=\"1-4-1-2-3-1\" data-name=\"recipe card 3 (garlic oil pasta)\" href=\"/recipes/garlic-oil-pasta\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-3-1-1\" data-name=\"recipe card rank 3\">3</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-3-1-2\" data-name=\"recipe card 3 body\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-3-1-2-1\" data-name=\"recipe card 3 title\">Garlic oil pasta with kale</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-3-1-2-2\" data-name=\"recipe card 3 ingredients\">spaghetti, garlic, kale, chilli flakes</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-3-1-2-3\" data-name=\"recipe card 3 stats row\"><span data-kid=\"1-4-1-2-3-1-2-3-1\" data-name=\"recipe card 3 stat: cook time\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-1-1\" data-name=\"recipe card 3 cook time figure\">20 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-1-2\" data-name=\"recipe card 3 cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-3-1-2-3-2\" data-name=\"recipe card 3 stat: kcal\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-2-1\" data-name=\"recipe card 3 kcal figure\">520 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-2-2\" data-name=\"recipe card 3 kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-3-1-2-3-3\" data-name=\"recipe card 3 stat: saves\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-3-1\" data-name=\"recipe card 3 saves figure\">44</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-3-2\" data-name=\"recipe card 3 saves unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-4\" data-name=\"recipe card list item 4\">\n<a class=\"card\" data-kid=\"1-4-1-2-4-1\" data-name=\"recipe card 4 (roast squash and chickpeas)\" href=\"/recipes/roast-squash-chickpeas\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-4-1-1\" data-name=\"recipe card rank 4\">4</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-4-1-2\" data-name=\"recipe card 4 body\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-4-1-2-1\" data-name=\"recipe card 4 title\">Roast squash and chickpeas</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-4-1-2-2\" data-name=\"recipe card 4 ingredients\">butternut squash, chickpeas, cumin, yoghurt</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-4-1-2-3\" data-name=\"recipe card 4 stats row\"><span data-kid=\"1-4-1-2-4-1-2-3-1\" data-name=\"recipe card 4 stat: cook time\"><span class=\"card__fig\" data-