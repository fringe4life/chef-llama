      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.938 0.060 86), oklch(0.310 0.045 78));\n    --accent-foreground: light-dark(oklch(0.320 0.065 70), oklch(0.915 0.045 86));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --radius: 0.5rem;\n    --radius-md: var(--radius);\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }\n  h2, p, ol, li { margin: 0; }\n  ol { padding: 0; list-style: none; }\n  a { color: inherit; }\n  a:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }\n\n  .section { padding: 56px 0 64px; }\n  .wrap { max-width: 1152px; margin: 0 auto; padding: 0 32px; }\n  @media (max-width: 640px) { .wrap { padding: 0 20px; } }\n\n  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .head p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .jars { margin-top: 28px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; align-items: end; }\n\n  .vessel {\n    position: relative; height: 200px; overflow: hidden;\n    border: 1px solid var(--border); border-bottom: 1px solid color-mix(in oklab, var(--foreground) 55%, var(--border)); border-radius: 8px 8px 0 0;\n    background: var(--card);\n  }\n  .jar { position: relative; }\n  .jar--starter .vessel { border-style: dashed; border-bottom-style: solid; }\n\n  .fill { position: absolute; left: 0; right: 0; bottom: 0; height: var(--fill); background: var(--primary); }\n  .fill__n {\n    position: absolute; left: 12px; top: 8px;\n    font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums;\n    color: var(--primary-foreground);\n  }\n\n  .stamp {\n    position: absolute; right: 10px; top: 12px; z-index: 1;\n    padding: 3px 7px; border: 1px dashed var(--muted-foreground); border-radius: 3px;\n    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;\n    color: var(--muted-foreground); transform: rotate(-6deg); background: color-mix(in oklab, var(--card) 82%, transparent);\n  }\n\n  .info { padding-top: 14px; }\n  .info__price { font-family: var(--font-display); font-size: 26px; font-weight: 600; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }\n  .info__credits { margin-top: 3px; font-size: 13px; font-weight: 600; }\n  .info__rate { margin-top: 2px; font-family: var(--font-mono); font-size: 11px; font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n  .info__buy {\n    margin-top: 14px; display: inline-flex; align-items: center; justify-content: center;\n    min-height: 38px; padding: 0 12px; border: 1px solid var(--border); border-radius: var(--radius-md);\n    color: var(--foreground); font-size: 13px; font-weight: 600; text-decoration: none;\n  }\n  .info__buy:hover { border-color: var(--foreground); }\n  .info__buy--primary { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n  .info__buy--primary:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); border-color: transparent; }\n\n  .fine { margin-top: 28px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n\n  @media (max-width: 899px) {\n    .jars { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }\n    .vessel { height: 150px; }\n    .info__price { font-size: 22px; }\n  }\n  @media (max-width: 420px) {\n    .jars { gap: 18px 12px; }\n    .vessel { height: 132px; }\n  }\n</style>\n<section aria-labelledby=\"credits-heading\" class=\"section\" data-kid=\"1\">\n<div class=\"wrap\" data-kid=\"1-1\">\n<div class=\"head\" data-kid=\"1-1-1\">\n<h2 data-kid=\"1-1-1-1\" id=\"credits-heading\">Credits</h2>\n<p data-kid=\"1-1-1-2\">One-time purchase. No subscription.</p>\n</div>\n<ol class=\"jars\" data-kid=\"1-1-2\">\n<li class=\"jar jar--starter\" data-kid=\"1-1-2-1\">\n<div class=\"vessel\" data-kid=\"1-1-2-1-1\">\n<span class=\"stamp\" data-kid=\"1-1-2-1-1-1\">Once only</span>\n<div class=\"fill\" data-kid=\"1-1-2-1-1-2\" style=\"--fill:29%\"><span class=\"fill__n\" data-kid=\"1-1-2-1-1-2-1\">10</span></div>\n</div>\n<div class=\"info\" data-kid=\"1-1-2-1-2\">\n<p class=\"info__price\" data-kid=\"1-1-2-1-2-1\">NZ$4</p>\n<p class=\"info__credits\" data-kid=\"1-1-2-1-2-2\">10 Credits</p>\n<p class=\"info__rate\" data-kid=\"1-1-2-1-2-3\">NZ$0.40 per Credit</p>\n<a class=\"info__buy info__buy--primary\" data-kid=\"1-1-2-1-2-4\" href=\"/pantry\">Buy Starter pack</a>\n</div>\n</li>\n<li class=\"jar\" data-kid=\"1-1-2-2\">\n<div class=\"vessel\" data-kid=\"1-1-2-2-1\">\n<div class=\"fill\" data-kid=\"1-1-2-2-1-1\" style=\"--fill:41%\"><span class=\"fill__n\" data-kid=\"1-1-2-2-1-1-1\">20</span></div>\n</div>\n<div class=\"info\" data-kid=\"1-1-2-2-2\">\n<p class=\"info__price\" data-kid=\"1-1-2-2-2-1\">NZ$8</p>\n<p class=\"info__credits\" data-kid=\"1-1-2-2-2-2\">20 Credits</p>\n<p class=\"info__rate\" data-kid=\"1-1-2-2-2-3\">NZ$0.40 per Credit</p>\n<a class=\"info__buy\" data-kid=\"1-1-2-2-2-4\" href=\"/pantry\">Buy 20 Credits</a>\n</div>\n</li>\n<li class=\"jar\" data-kid=\"1-1-2-3\">\n<div class=\"vessel\" data-kid=\"1-1-2-3-1\">\n<div class=\"fill\" data-kid=\"1-1-2-3-1-1\" style=\"--fill:65%\"><span class=\"fill__n\" data-kid=\"1-1-2-3-1-1-1\">50</span></div>\n</div>\n<div class=\"info\" data-kid=\"1-1-2-3-2\">\n<p class=\"info__price\" data-kid=\"1-1-2-3-2-1\">NZ$16</p>\n<p class=\"info__credits\" data-kid=\"1-1-2-3-2-2\">50 Credits</p>\n<p class=\"info__rate\" data-kid=\"1-1-2-3-2-3\">NZ$0.32 per Credit</p>\n<a class=\"info__buy\" data-kid=\"1-1-2-3-2-4\" href=\"/pantry\">Buy 50 Credits</a>\n</div>\n</li>\n<li class=\"jar\" data-kid=\"1-1-2-4\">\n<div class=\"vessel\" data-kid=\"1-1-2-4-1\">\n<span class=\"stamp\" data-kid=\"1-1-2-4-1-1\">Best rate</span>\n<div class=\"fill\" data-kid=\"1-1-2-4-1-2\" style=\"--fill:100%\"><span class=\"fill__n\" data-kid=\"1-1-2-4-1-2-1\">120</span></div>\n</div>\n<div class=\"info\" data-kid=\"1-1-2-4-2\">\n<p class=\"info__price\" data-kid=\"1-1-2-4-2-1\">NZ$32</p>\n<p class=\"info__credits\" data-kid=\"1-1-2-4-2-2\">120 Credits</p>\n<p class=\"info__rate\" data-kid=\"1-1-2-4-2-3\">NZ$0.27 per Credit</p>\n<a class=\"info__buy\" data-kid=\"1-1-2-4-2-4\" href=\"/pantry\">Buy 120 Credits</a>\n</div>\n</li>\n</ol>\n<p class=\"fine\" data-kid=\"1-1-3\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</div>\n</section>\n",
