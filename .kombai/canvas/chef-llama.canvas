      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.938 0.060 86), oklch(0.310 0.045 78));\n    --accent-foreground: light-dark(oklch(0.320 0.065 70), oklch(0.915 0.045 86));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --radius: 0.5rem;\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) + 4px);\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }\n  h2, p, ol, li, fieldset, legend { margin: 0; }\n  ol { padding: 0; list-style: none; }\n  fieldset { padding: 0; border: 0; }\n  a { color: inherit; }\n  a:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }\n\n  .section { padding: 56px 0 64px; }\n  .wrap { max-width: 1152px; margin: 0 auto; padding: 0 32px; }\n  @media (max-width: 640px) { .wrap { padding: 0 20px; } }\n\n  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .head p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .settle { margin-top: 8px; font-size: 13px; color: var(--muted-foreground); }\n\n  .scale { margin-top: 24px; display: grid; gap: 16px; }\n  @media (min-width: 900px) { .scale { grid-template-columns: minmax(0, 336px) minmax(0, 1fr); gap: 24px; align-items: start; } }\n\n  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }\n\n  .rail { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); overflow: hidden; }\n  .rail label {\n    position: relative;\n    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: 10px;\n    min-height: 60px; padding: 0 16px; border-bottom: 1px solid var(--border); cursor: pointer;\n  }\n  .rail li:last-child label { border-bottom: 0; }\n  .rail input { position: absolute; opacity: 0; pointer-events: none; }\n  .rail__price { font-family: var(--font-mono); font-size: 17px; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }\n  .rail__credits { font-size: 13px; color: var(--muted-foreground); }\n  .rail__tag { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-foreground); white-space: nowrap; }\n  .rail label:hover .rail__price { text-decoration: underline; text-underline-offset: 3px; }\n  .rail label:has(input:checked) { background: var(--foreground); }\n  .rail label:has(input:checked) .rail__price { color: var(--background); }\n  .rail label:has(input:checked) .rail__credits,\n  .rail label:has(input:checked) .rail__tag { color: color-mix(in oklab, var(--background) 74%, transparent); }\n  .rail label:has(input:focus-visible) { outline: 2px solid var(--primary); outline-offset: -2px; }\n\n  .ticket { display: none; }\n  .scale:has(#p10:checked) .ticket--10,\n  .scale:has(#p20:checked) .ticket--20,\n  .scale:has(#p50:checked) .ticket--50,\n  .scale:has(#p120:checked) .ticket--120 { display: block; }\n\n  .ticket {\n    position: relative; padding: 22px 26px 26px;\n    border: 1px solid var(--foreground); border-radius: 4px; background: var(--card);\n    box-shadow: 5px 5px 0 color-mix(in oklab, var(--foreground) 12%, transparent);\n  }\n  .ticket__top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .ticket__name { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); }\n  .ticket__tag { display: inline-flex; align-items: center; min-height: 22px; padding: 0 7px; border-radius: 3px; background: var(--accent); color: var(--accent-foreground); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.09em; text-transform: uppercase; }\n  .ticket__price { margin-top: 12px; font-family: var(--font-display); font-size: 64px; font-weight: 600; line-height: 0.95; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }\n  .ticket__credits { margin-top: 12px; font-size: 16px; font-weight: 600; }\n  .ticket__rate { margin-top: 3px; font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n\n  .ladder { position: relative; margin-top: 22px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; align-items: end; height: 78px; }\n  .ladder__step { display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }\n  .ladder__bar { height: var(--h); background: color-mix(in oklab, var(--foreground) 14%, transparent); border-radius: 2px 2px 0 0; }\n  .ladder__step--on .ladder__bar { background: var(--primary); }\n  .ladder__lab { margin-top: 5px; line-height: 1; font-family: var(--font-mono); font-size: 10px; font-variant-numeric: tabular-nums; color: var(--muted-foreground); text-align: center; white-space: nowrap; }\n  .ladder__step--on .ladder__lab { color: var(--foreground); }\n  .ladder::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: 15px; height: 1px; background: var(--border); }\n\n  .buy {\n    margin-top: 20px; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 20px;\n    border: 1px solid var(--primary); border-radius: var(--radius-md); background: var(--primary);\n    color: var(--primary-foreground); font-size: 14px; font-weight: 600; text-decoration: none;\n  }\n  .buy:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n  .terms { margin-top: 12px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n\n  @media (max-width: 899px) {\n    .rail { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }\n    .rail li + li label { border-left: 1px solid var(--border); }\n    .rail label { grid-template-columns: 1fr; justify-items: center; gap: 2px; min-height: 66px; padding: 12px 6px; border-bottom: 0; text-align: center; }\n    .rail__credits { font-size: 11px; }\n    .rail__tag { display: none; }\n    .ticket { padding: 20px; }\n    .ticket__price { font-size: 52px; }\n  }\n</style>\n<section aria-labelledby=\"credits-heading\" class=\"section\" data-kid=\"1\">\n<div class=\"wrap\" data-kid=\"1-1\">\n<div class=\"head\" data-kid=\"1-1-1\">\n<h2 data-kid=\"1-1-1-1\" id=\"credits-heading\">Credits</h2>\n<p data-kid=\"1-1-1-2\">One-time purchase. No subscription.</p>\n</div>\n<div class=\"scale\" data-kid=\"1-1-2\">\n<fieldset class=\"rail\" data-kid=\"1-1-2-1\">\n<legend class=\"sr\" data-kid=\"1-1-2-1-1\">Pack size</legend>\n<ol data-kid=\"1-1-2-1-2\">\n<li data-kid=\"1-1-2-1-2-1\">\n<label data-kid=\"1-1-2-1-2-1-1\" for=\"p10\">\n<input data-kid=\"1-1-2-1-2-1-1-1\" id=\"p10\" name=\"pack\" type=\"radio\"/>\n<span class=\"rail__price\" data-kid=\"1-1-2-1-2-1-1-2\">NZ$4</span>\n<span class=\"rail__credits\" data-kid=\"1-1-2-1-2-1-1-3\">10 Credits, once only</span>\n</label>\n</li>\n<li data-kid=\"1-1-2-1-2-2\">\n<label data-kid=\"1-1-2-1-2-2-1\" for=\"p20\">\n<input data-kid=\"1-1-2-1-2-2-1-1\" id=\"p20\" name=\"pack\" type=\"radio\"/>\n<span class=\"rail__price\" data-kid=\"1-1-2-1-2-2-1-2\">NZ$8</span>\n<span class=\"rail__credits\" data-kid=\"1-1-2-1-2-2-1-3\">20 Credits</span>\n</label>\n</li>\n<li data-kid=\"1-1-2-1-2-3\">\n<label data-kid=\"1-1-2-1-2-3-1\" for=\"p50\">\n<input data-kid=\"1-1-2-1-2-3-1-1\" id=\"p50\" name=\"pack\" type=\"radio\"/>\n<span class=\"rail__price\" data-kid=\"1-1-2-1-2-3-1-2\">NZ$16</span>\n<span class=\"rail__credits\" data-kid=\"1-1-2-1-2-3-1-3\">50 Credits</span>\n</label>\n</li>\n<li data-kid=\"1-1-2-1-2-4\">\n<label data-kid=\"1-1-2-1-2-4-1\" for=\"p120\">\n<input checked=\"\" data-kid=\"1-1-2-1-2-4-1-1\" id=\"p120\" name=\"pack\" type=\"radio\"/>\n<span class=\"rail__price\" data-kid=\"1-1-2-1-2-4-1-2\">NZ$32</span>\n<span class=\"rail__credits\" data-kid=\"1-1-2-1-2-4-1-3\">120 Credits</span>\n<span class=\"rail__tag\" data-kid=\"1-1-2-1-2-4-1-4\">Best rate</span>\n</label>\n</li>\n</ol>\n</fieldset>\n<div class=\"readouts\" data-kid=\"1-1-2-2\">\n<article class=\"ticket ticket--10\" data-kid=\"1-1-2-2-1\">\n<div class=\"ticket__top\" data-kid=\"1-1-2-2-1-1\">\n<p class=\"ticket__name\" data-kid=\"1-1-2-2-1-1-1\">Starter pack</p>\n<span class=\"ticket__tag\" data-kid=\"1-1-2-2-1-1-2\">Once per account</span>\n</div>\n<p class=\"ticket__price\" data-kid=\"1-1-2-2-1-2\">NZ$4</p>\n<p class=\"ticket__credits\" data-kid=\"1-1-2-2-1-3\">10 Credits</p>\n<p class=\"ticket__rate\" data-kid=\"1-1-2-2-1-4\">NZ$0.40 per Credit</p>\n<div aria-hidden=\"true\" class=\"ladder\" data-kid=\"1-1-2-2-1-5\">\n<div class=\"ladder__step ladder__step--on\" data-kid=\"1-1-2-2-1-5-1\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-1-5-1-1\" style=\"--h:18px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-1-5-1-2\">10</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-1-5-2\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-1-5-2-1\" style=\"--h:26px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-1-5-2-2\">20</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-1-5-3\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-1-5-3-1\" style=\"--h:41px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-1-5-3-2\">50</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-1-5-4\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-1-5-4-1\" style=\"--h:63px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-1-5-4-2\">120</p></div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-2-1-6\" href=\"/pantry\">Buy Starter pack</a>\n<p class=\"terms\" data-kid=\"1-1-2-2-1-7\">Once per account. 1 Credit pays for 1 Generate. Prices in NZD.</p>\n</article>\n<article class=\"ticket ticket--20\" data-kid=\"1-1-2-2-2\">\n<div class=\"ticket__top\" data-kid=\"1-1-2-2-2-1\">\n<p class=\"ticket__name\" data-kid=\"1-1-2-2-2-1-1\">One-time pack</p>\n</div>\n<p class=\"ticket__price\" data-kid=\"1-1-2-2-2-2\">NZ$8</p>\n<p class=\"ticket__credits\" data-kid=\"1-1-2-2-2-3\">20 Credits</p>\n<p class=\"ticket__rate\" data-kid=\"1-1-2-2-2-4\">NZ$0.40 per Credit</p>\n<div aria-hidden=\"true\" class=\"ladder\" data-kid=\"1-1-2-2-2-5\">\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-2-5-1\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-2-5-1-1\" style=\"--h:18px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-2-5-1-2\">10</p></div>\n<div class=\"ladder__step ladder__step--on\" data-kid=\"1-1-2-2-2-5-2\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-2-5-2-1\" style=\"--h:26px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-2-5-2-2\">20</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-2-5-3\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-2-5-3-1\" style=\"--h:41px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-2-5-3-2\">50</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-2-5-4\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-2-5-4-1\" style=\"--h:63px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-2-5-4-2\">120</p></div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-2-2-6\" href=\"/pantry\">Buy 20 Credits</a>\n<p class=\"terms\" data-kid=\"1-1-2-2-2-7\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</article>\n<article class=\"ticket ticket--50\" data-kid=\"1-1-2-2-3\">\n<div class=\"ticket__top\" data-kid=\"1-1-2-2-3-1\">\n<p class=\"ticket__name\" data-kid=\"1-1-2-2-3-1-1\">One-time pack</p>\n</div>\n<p class=\"ticket__price\" data-kid=\"1-1-2-2-3-2\">NZ$16</p>\n<p class=\"ticket__credits\" data-kid=\"1-1-2-2-3-3\">50 Credits</p>\n<p class=\"ticket__rate\" data-kid=\"1-1-2-2-3-4\">NZ$0.32 per Credit</p>\n<div aria-hidden=\"true\" class=\"ladder\" data-kid=\"1-1-2-2-3-5\">\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-3-5-1\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-3-5-1-1\" style=\"--h:18px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-3-5-1-2\">10</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-3-5-2\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-3-5-2-1\" style=\"--h:26px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-3-5-2-2\">20</p></div>\n<div class=\"ladder__step ladder__step--on\" data-kid=\"1-1-2-2-3-5-3\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-3-5-3-1\" style=\"--h:41px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-3-5-3-2\">50</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-3-5-4\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-3-5-4-1\" style=\"--h:63px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-3-5-4-2\">120</p></div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-2-3-6\" href=\"/pantry\">Buy 50 Credits</a>\n<p class=\"terms\" data-kid=\"1-1-2-2-3-7\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</article>\n<article class=\"ticket ticket--120\" data-kid=\"1-1-2-2-4\">\n<div class=\"ticket__top\" data-kid=\"1-1-2-2-4-1\">\n<p class=\"ticket__name\" data-kid=\"1-1-2-2-4-1-1\">One-time pack</p>\n<span class=\"ticket__tag\" data-kid=\"1-1-2-2-4-1-2\">Best rate</span>\n</div>\n<p class=\"ticket__price\" data-kid=\"1-1-2-2-4-2\">NZ$32</p>\n<p class=\"ticket__credits\" data-kid=\"1-1-2-2-4-3\">120 Credits</p>\n<p class=\"ticket__rate\" data-kid=\"1-1-2-2-4-4\">NZ$0.27 per Credit</p>\n<div aria-hidden=\"true\" class=\"ladder\" data-kid=\"1-1-2-2-4-5\">\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-4-5-1\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-4-5-1-1\" style=\"--h:18px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-4-5-1-2\">10</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-4-5-2\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-4-5-2-1\" style=\"--h:26px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-4-5-2-2\">20</p></div>\n<div class=\"ladder__step\" data-kid=\"1-1-2-2-4-5-3\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-4-5-3-1\" style=\"--h:41px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-4-5-3-2\">50</p></div>\n<div class=\"ladder__step ladder__step--on\" data-kid=\"1-1-2-2-4-5-4\"><div class=\"ladder__bar\" data-kid=\"1-1-2-2-4-5-4-1\" style=\"--h:63px\"></div><p class=\"ladder__lab\" data-kid=\"1-1-2-2-4-5-4-2\">120</p></div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-2-4-6\" href=\"/pantry\">Buy 120 Credits</a>\n<p class=\"terms\" data-kid=\"1-1-2-2-4-7\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</article>\n</div>\n</div>\n</div>\n</section>\n",
