      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --rule-strong:oklch(0.800 0.036 62);\n  --accent:oklch(0.505 0.180 32);\n  --accent-ink:oklch(0.990 0.010 90);\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-read);font-size:14px;line-height:1.45}\n.sheet{padding:36px 40px 56px}\n.plate{background:var(--card);border:1px solid var(--rule);border-radius:12px;overflow:hidden}\n\n.bar{display:flex;align-items:center;gap:26px;height:60px;padding:0 44px;border-bottom:1px solid var(--rule-hair)}\n.wordmark{font-family:var(--font-name);font-size:17.5px;font-weight:700;letter-spacing:-.02em}\n.nav{display:flex;gap:20px;margin-left:6px}\n.nav a{font-family:var(--font-read);font-size:13px;color:var(--ink-muted);text-decoration:none;padding:4px 0}\n.nav a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--accent)}\n.av{margin-left:auto;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;border:1px solid var(--rule);background:var(--tint);font-family:var(--font-read);font-size:10.5px;font-weight:600;color:var(--ink-muted)}\n\n.doc{padding:34px 44px 40px}\n.dish{font-family:var(--font-name);font-weight:400;font-size:44px;line-height:1.04;letter-spacing:-.015em;margin:0;max-width:19ch}\n.note{font-family:var(--font-read);font-size:16.5px;line-height:1.6;color:var(--ink-muted);margin:16px 0 0;max-width:58ch}\n\n.meta{display:grid;grid-template-columns:repeat(6,minmax(0,auto));justify-content:start;column-gap:44px;margin:26px 0 0;padding:15px 0 16px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.meta dt{font-family:var(--font-read);font-size:9.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted);margin:0}\n.meta dd{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:14.5px;margin:5px 0 0}\n\n.body{display:grid;grid-template-columns:294px minmax(0,1fr);column-gap:52px;margin-top:34px}\nh2{font-family:var(--font-read);font-size:14.5px;font-weight:600;letter-spacing:-.005em;margin:0 0 4px}\n\n.ings{list-style:none;margin:0;padding:0}\n.ing{display:grid;grid-template-columns:62px minmax(0,1fr);column-gap:14px;padding:9px 0 10px;border-bottom:1px solid var(--rule-hair)}\n.ing:first-child{border-top:1px solid var(--rule-hair)}\n.ing__q{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:13.5px;line-height:1.5}\n.ing__i{font-family:var(--font-read);font-size:15.5px;line-height:1.5}\n\n.pantry{margin-top:24px;background:var(--tint);border-radius:6px;padding:13px 14px 15px}\n.pantry__l{font-family:var(--font-read);font-size:9.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted);margin:0 0 10px}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}\n.chip{font-family:var(--font-read);font-size:12px;line-height:1;padding:6px 8px;border:1px dashed var(--rule-strong);border-radius:4px;background:var(--paper)}\n\n.method{margin:0;padding:0;list-style:none}\n.step{display:grid;grid-template-columns:34px minmax(0,1fr);column-gap:18px;padding:15px 0 16px;border-top:1px solid var(--rule-hair)}\n.step:last-child{border-bottom:1px solid var(--rule-hair)}\n.step__n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12px;line-height:1.9;color:var(--ink-muted)}\n.step__t{font-family:var(--font-read);font-size:16.5px;line-height:1.66;max-width:38em}\n\n.docfoot{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:30px;padding-top:20px;border-top:1px solid var(--rule)}\n.gen{font-family:var(--font-read);font-size:12px;color:var(--ink-muted);margin:0}\n.acts{display:flex;gap:10px}\n.btn{display:inline-flex;align-items:center;height:38px;padding:0 18px;border-radius:6px;border:1px solid transparent;font-family:var(--font-read);font-size:13.5px;font-weight:600;text-decoration:none;white-space:nowrap}\n.btn--fill{background:var(--accent);color:var(--accent-ink)}\n.btn--ghost{border-color:var(--rule-strong);color:var(--ink)}\n\n.key{display:flex;flex-wrap:wrap;gap:4px 14px;margin:16px 2px 0;font-family:var(--font-fig);font-size:10px;line-height:1.6;color:var(--ink-muted)}\n.key b{font-weight:400;color:var(--ink)}\n.key em{font-style:normal;font-family:var(--font-read);font-size:12px;color:var(--ink);margin-right:2px}\n</style>\n<div class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"plate\" data-kid=\"1-1\" data-name=\"recipe document card panel\">\n<header class=\"bar\" data-kid=\"1-1-1\" data-name=\"top app bar\">\n<span class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"site wordmark logo\">Chef Llama</span>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to pantry page\" href=\"#\">Pantry</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to recipes page current\" href=\"#\">Recipes</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to saved items\" href=\"#\">Saved</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link to dashboard\" href=\"#\">Dashboard</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link to billing page\" href=\"#\">Billing</a>\n</nav>\n<span aria-hidden=\"true\" class=\"av\" data-kid=\"1-1-1-3\" data-name=\"user initials avatar\">AR</span>\n</header>\n<main class=\"doc\" data-kid=\"1-1-2\" data-name=\"recipe document main content\">\n<h1 class=\"dish\" data-kid=\"1-1-2-1\" data-name=\"recipe title headline\">Kūmara, chickpea and silverbeet traybake</h1>\n<p class=\"note\" data-kid=\"1-1-2-2\" data-name=\"recipe intro note text\">One tray and a 200 °C oven. The silverbeet goes in at the end, in two goes, so the stems cook through and the leaves only wilt.</p>\n<dl class=\"meta\" data-kid=\"1-1-2-3\" data-name=\"recipe metadata grid\">\n<div data-kid=\"1-1-2-3-1\" data-name=\"metadata cell for total time\"><dt data-kid=\"1-1-2-3-1-1\" data-name=\"metadata label total time\">Total</dt><dd data-kid=\"1-1-2-3-1-2\" data-name=\"metadata value total time\">40 min</dd></div>\n<div data-kid=\"1-1-2-3-2\" data-name=\"metadata cell for prep time\"><dt data-kid=\"1-1-2-3-2-1\" data-name=\"metadata label prep time\">Prep</dt><dd data-kid=\"1-1-2-3-2-2\" data-name=\"metadata value prep time\">15 min</dd></div>\n<div data-kid=\"1-1-2-3-3\" data-name=\"metadata cell for calories per serving\"><dt data-kid=\"1-1-2-3-3-1\" data-name=\"metadata label per serving calories\">Per serving</dt><dd data-kid=\"1-1-2-3-3-2\" data-name=\"metadata value calories per serving\">620 kcal</dd></div>\n<div data-kid=\"1-1-2-3-4\" data-name=\"metadata cell for serving count\"><dt data-kid=\"1-1-2-3-4-1\" data-name=\"metadata label serves\">Serves</dt><dd data-kid=\"1-1-2-3-4-2\" data-name=\"metadata value serves count\">4</dd></div>\n<div data-kid=\"1-1-2-3-5\" data-name=\"metadata cell for pantry items\"><dt data-kid=\"1-1-2-3-5-1\" data-name=\"metadata label from pantry\">From pantry</dt><dd data-kid=\"1-1-2-3-5-2\" data-name=\"metadata value pantry items count\">8 items</dd></div>\n<div data-kid=\"1-1-2-3-6\" data-name=\"metadata cell for cost\"><dt data-kid=\"1-1-2-3-6-1\" data-name=\"metadata label cost\">Cost</dt><dd data-kid=\"1-1-2-3-6-2\" data-name=\"metadata value cost\">1 Credit</dd></div>\n</dl>\n<div class=\"body\" data-kid=\"1-1-2-4\" data-name=\"recipe body two column container\">\n<section aria-labelledby=\"ings-h\" data-kid=\"1-1-2-4-1\" data-name=\"ingredients section\">\n<h2 data-kid=\"1-1-2-4-1-1\" data-name=\"ingredients section heading\" id=\"ings-h\">Ingredients</h2>\n<ul class=\"ings\" data-kid=\"1-1-2-4-1-2\" data-name=\"ingredients list\">\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"ingredient row for kūmara\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-1-1\" data-name=\"ingredient quantity\">800 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-1-2\" data-name=\"ingredient name kūmara chunks\">kūmara, cut into 3 cm chunks</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"ingredient row for chickpeas\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-2-1\" data-name=\"ingredient quantity chickpeas\">400 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-2-2\" data-name=\"ingredient name chickpeas\">chickpeas, drained</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-3\" data-name=\"ingredient row for olive oil\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-3-1\" data-name=\"ingredient quantity olive oil\">2 tbsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-3-2\" data-name=\"ingredient name olive oil\">olive oil</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-4\" data-name=\"ingredient row for smoked paprika\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-4-1\" data-name=\"ingredient quantity smoked paprika\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-4-2\" data-name=\"ingredient name smoked paprika\">smoked paprika</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-5\" data-name=\"ingredient row for garlic\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-5-1\" data-name=\"ingredient quantity garlic\">3</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-5-2\" data-name=\"ingredient name garlic\">cloves garlic, sliced</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-6\" data-name=\"ingredient row for silverbeet\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-6-1\" data-name=\"ingredient quantity silverbeet\">1 bunch</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-6-2\" data-name=\"ingredient name silverbeet\">silverbeet, stems sliced, leaves torn</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-7\" data-name=\"ingredient row for lemon\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-7-1\" data-name=\"ingredient quantity lemon\">1</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-7-2\" data-name=\"ingredient name lemon\">lemon, zest and juice</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-8\" data-name=\"ingredient row for feta\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-8-1\" data-name=\"ingredient quantity feta\">120 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-8-2\" data-name=\"ingredient name feta\">feta, crumbled</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-9\" data-name=\"ingredient row for flaky salt\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-9-1\" data-name=\"ingredient quantity flaky salt\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-9-2\" data-name=\"ingredient name flaky salt\">flaky salt</span></li>\n</ul>\n<div class=\"pantry\" data-kid=\"1-1-2-4-1-3\" data-name=\"pantry items callout box\">\n<p class=\"pantry__l\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"pantry callout heading\">From your pantry</p>\n<ul class=\"chips\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"pantry item chips list\">\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-1\" data-name=\"pantry item chip kūmara\">kūmara</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-2\" data-name=\"pantry item chip chickpeas\">chickpeas</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-3\" data-name=\"pantry item chip silverbeet\">silverbeet</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-4\" data-name=\"pantry item chip garlic\">garlic</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-5\" data-name=\"pantry item chip lemon\">lemon</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-6\" data-name=\"pantry item chip feta\">feta</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-7\" data-name=\"pantry item chip olive oil\">olive oil</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-8\" data-name=\"pantry item chip smoked paprika\">smoked paprika</li>\n</ul>\n</div>\n</section>\n<section aria-labelledby=\"method-h\" data-kid=\"1-1-2-4-2\" data-name=\"method section\">\n<h2 data-kid=\"1-1-2-4-2-1\" data-name=\"method section heading\" id=\"method-h\">Method</h2>\n<ol class=\"method\" data-kid=\"1-1-2-4-2-2\" data-name=\"method steps list\">\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"method step one row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"step number one\">01</span><span class=\"step__t\" data-dynamic=\"true\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"step instruction text one\" data-reason=\"text replaced by typewriter effect script\">Heat the oven to 200 °C fan and line a large tray.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"method step two row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"step number two\">02</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"step instruction text two\">Toss the kūmara with the olive oil, smoked paprika and salt, spread it in one layer, and roast for 20 minutes until the edges darken.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-3\" data-name=\"method step three row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-3-1\" data-name=\"step number three\">03</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-3-2\" data-name=\"step instruction text three\">Push the kūmara to one side of the tray, add the chickpeas and garlic to the bare side, and roast for 10 minutes more.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-4\" data-name=\"method step four row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-4-1\" data-name=\"step number four\">04</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-4-2\" data-name=\"step instruction text four\">Fold the sliced silverbeet stems through and return the tray for 4 minutes; they should give when pressed with the back of a spoon.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-5\" data-name=\"method step five row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-5-1\" data-name=\"step number five\">05</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-5-2\" data-name=\"step instruction text five\">Take the tray out and fold the torn leaves through in three handfuls. The residual heat wilts them without flattening them.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-6\" data-name=\"method step six row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-6-1\" data-name=\"step number six\">06</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-6-2\" data-name=\"step instruction text six\">Scatter over the feta, then the lemon zest and juice. Rest 5 minutes and serve from the tray.</span></li>\n</ol>\n</section>\n</div>\n<footer class=\"docfoot\" data-kid=\"1-1-2-5\" data-name=\"recipe document footer bar\">\n<p class=\"gen\" data-kid=\"1-1-2-5-1\" data-name=\"recipe generation timestamp text\">Generated 17 November 2026, 9:41 am</p>\n<div class=\"acts\" data-kid=\"1-1-2-5-2\" data-name=\"footer actions button group\">\n<a class=\"btn btn--ghost\" data-kid=\"1-1-2-5-2-1\" data-name=\"ghost button change ingredient\" href=\"#\">Change an ingredient</a>\n<a class=\"btn btn--fill\" data-kid=\"1-1-2-5-2-2\" data-name=\"primary save recipe button\" href=\"#\">Save recipe</a>\n</div>\n</footer>\n</main>\n</div>\n<p class=\"key\" data-kid=\"1-2\" data-name=\"typographic key caption\"><em data-kid=\"1-2-1\" data-name=\"key caption bold lead-in\">3 families.</em> name <b data-kid=\"1-2-2\" data-name=\"key geometric serif sample name\">Georgia</b> · headnote, method, nav, buttons, section headings, labels, chips, timestamp <b data-kid=\"1-2-3\" data-name=\"key humanist serif sample name\">Humanist</b> · quantities, step numbers, meta values <b data-kid=\"1-2-4\" data-name=\"key monospace sample name\">Mono</b></p>\n</div>\n",
