        "h": 0
      },
      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --rule-strong:oklch(0.800 0.036 62);\n  --accent:oklch(0.505 0.180 32);\n  --font-ui:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n  --font-hand:\"Segoe Print\",\"Bradley Hand\",Chilanka,TSCu_Comic,casual,cursive;\n  --font-neo:Inter,Roboto,\"Helvetica Neue\",\"Arial Nova\",\"Nimbus Sans\",Arial,sans-serif;\n  --font-trans:Charter,\"Bitstream Charter\",\"Sitka Text\",Cambria,serif;\n  --font-old:\"Iowan Old Style\",\"Palatino Linotype\",\"URW Palladio L\",P052,serif;\n  --font-antique:Superclarendon,\"Bookman Old Style\",\"URW Bookman\",\"URW Bookman L\",\"Georgia Pro\",Georgia,serif;\n  --font-classical:Optima,Candara,\"Noto Sans\",source-sans-pro,sans-serif;\n  --font-geo:Avenir,Montserrat,Corbel,\"URW Gothic\",source-sans-pro,sans-serif;\n  --font-slab:Rockwell,\"Rockwell Nova\",\"Roboto Slab\",\"DejaVu Serif\",\"Sitka Small\",serif;\n  --font-didone:Didot,\"Bodoni MT\",\"Noto Serif Display\",\"URW Palladio L\",P052,Sylfaen,serif;\n  --font-round:ui-rounded,\"Hiragino Maru Gothic ProN\",Quicksand,Comfortaa,Manjari,\"Arial Rounded MT\",\"Arial Rounded MT Bold\",Calibri,source-sans-pro,sans-serif;\n  --font-ind:Bahnschrift,\"DIN Alternate\",\"Franklin Gothic Medium\",\"Nimbus Sans Narrow\",sans-serif-condensed,sans-serif;\n  --font-monoslab:\"Nimbus Mono PS\",\"Courier New\",monospace;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-ui);font-size:13.5px;line-height:1.45}\n.sheet{max-width:1180px;margin:0 auto;padding:40px 32px 64px}\nh1{font-size:25px;font-weight:600;letter-spacing:-.02em;margin:0}\n.headrule{height:1px;background:var(--ink);margin-top:16px}\nh2{font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0}\nsection{margin-top:38px}\n.shead{display:flex;align-items:baseline;justify-content:space-between;gap:24px;padding-bottom:10px;border-bottom:1px solid var(--rule)}\n.shead p{font-family:var(--font-fig);font-size:10.5px;color:var(--ink-muted);margin:0}\n.chain{font-family:var(--font-fig);font-size:10.5px;line-height:1.7;color:var(--ink-muted);margin:12px 0 0;word-break:break-word}\n.chain b{font-weight:400;color:var(--ink)}\n\ntable{width:100%;border-collapse:collapse;table-layout:fixed;margin-top:16px}\nth{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);font-weight:400;text-align:left;padding:0 16px 9px 0;border-bottom:1px solid var(--rule);vertical-align:bottom}\ntd{padding:13px 16px 14px 0;border-bottom:1px solid var(--rule-hair);vertical-align:baseline;line-height:1.5}\ntd:last-child,th:last-child{padding-right:0}\n.n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12.5px}\n.dim{color:var(--ink-muted)}\n.small{font-size:12px;line-height:1.5}\n\n/* share cell */\n.share{display:flex;align-items:center;gap:10px}\n.share__track{position:relative;flex:1;min-width:42px;height:6px;background:var(--tint);box-shadow:inset 0 0 0 1px var(--rule)}\n.share__fill{position:absolute;inset:0 auto 0 0;width:var(--w);background:var(--ink-muted)}\n.share__num{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:11.5px;min-width:70px;text-align:right}\n.sub{display:block;font-family:var(--font-fig);font-size:10px;color:var(--ink-faint);margin-top:3px}\n\n/* facts strip */\n.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin:26px 0 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.fact{padding:14px 20px 16px 0}\n.fact + .fact{border-left:1px solid var(--rule);padding-left:20px}\n.fact dt{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0}\n.fact dd{margin:7px 0 0;font-family:var(--font-read);font-size:14px;line-height:1.5}\n.fact dd b{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-weight:400;font-size:15px}\n\n/* stack table */\n.stackname{line-height:1.2}\n.verdict{font-family:var(--font-ui);font-size:12.5px}\n.v-hold{color:var(--ink)}\n.v-care{color:var(--ink)}\n.v-no{color:var(--ink-muted)}\n.verdict span{display:block;font-family:var(--font-fig);font-size:10.5px;color:var(--ink-muted);margin-top:4px;line-height:1.55}\n.note{margin-top:26px;padding-top:16px;border-top:1px solid var(--rule);display:grid;grid-template-columns:180px minmax(0,1fr);column-gap:28px}\n.note dt{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted)}\n.note dd{margin:0;font-family:var(--font-read);font-size:14px;line-height:1.6;max-width:76ch}\n</style>\n<main class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<h1 data-kid=\"1-1\" data-name=\"document headline\">Stack reliability</h1>\n<div class=\"headrule\" data-kid=\"1-2\" data-name=\"header rule divider\"></div>\n<section aria-labelledby=\"hand-h\" data-kid=\"1-3\" data-name=\"handwritten stack section\">\n<div class=\"shead\" data-kid=\"1-3-1\" data-name=\"section heading bar\">\n<h2 data-kid=\"1-3-1-1\" data-name=\"section title\" id=\"hand-h\">Handwritten stack, by platform</h2>\n<p data-kid=\"1-3-1-2\" data-name=\"section subtitle with date\">New Zealand, October 2026</p>\n</div>\n<p class=\"chain\" data-kid=\"1-3-2\" data-name=\"font stack chain description\"><b data-kid=\"1-3-2-1\" data-name=\"chain label\">the chain</b>   'Segoe Print', 'Bradley Hand', Chilanka, TSCu_Comic, 'Comic Sans MS', 'Comic Sans', 'Chalkboard', 'ChalkboardSE-Regular', 'Marker Felt', 'URW Chancery L', 'Comic Neue', 'Dancing Script', casual, cursive</p>\n<table data-kid=\"1-3-3\" data-name=\"handwritten stack platform table\">\n<thead data-kid=\"1-3-3-1\" data-name=\"table header row group\">\n<tr data-kid=\"1-3-3-1-1\" data-name=\"table header row\">\n<th data-kid=\"1-3-3-1-1-1\" data-name=\"platform column header\" scope=\"col\">Platform</th>\n<th data-kid=\"1-3-3-1-1-2\" data-name=\"share of sessions column header\" scope=\"col\">Share of sessions</th>\n<th data-kid=\"1-3-3-1-1-3\" data-name=\"face column header\" scope=\"col\">Face it lands on</th>\n<th data-kid=\"1-3-3-1-1-4\" data-name=\"weight column header\" scope=\"col\">Weight</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-3-3-2\" data-name=\"table body rows\">\n<tr data-kid=\"1-3-3-2-1\" data-name=\"Windows platform row\">\n<td data-kid=\"1-3-3-2-1-1\" data-name=\"Windows platform name\">Windows 10, 11</td>\n<td data-kid=\"1-3-3-2-1-2\" data-name=\"Windows share cell\">\n<span class=\"share\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"share bar container\"><span class=\"share__track\" data-kid=\"1-3-3-2-1-2-1-1\" data-name=\"share bar track\"><i class=\"share__fill\" data-kid=\"1-3-3-2-1-2-1-1-1\" data-name=\"share bar fill\" style=\"--w:100%\"></i></span><span class=\"share__num\" data-kid=\"1-3-3-2-1-2-1-2\" data-name=\"Windows share percentage\">35.9%</span></span>\n</td>\n<td data-kid=\"1-3-3-2-1-3\" data-name=\"Windows landing face note\">Segoe Print, first in the chain and installed by default</td>\n<td class=\"n\" data-kid=\"1-3-3-2-1-4\" data-name=\"Windows weights cell\">400 · 700</td>\n</tr>\n<tr data-kid=\"1-3-3-2-2\" data-name=\"Android platform row\">\n<td data-kid=\"1-3-3-2-2-1\" data-name=\"Android platform name\">Android</td>\n<td data-kid=\"1-3-3-2-2-2\" data-name=\"Android share cell\">\n<span class=\"share\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"share bar container\"><span class=\"share__track\" data-kid=\"1-3-3-2-2-2-1-1\" data-name=\"share bar track\"><i class=\"share__fill\" data-kid=\"1-3-3-2-2-2-1-1-1\" data-name=\"share bar fill\" style=\"--w:65%\"></i></span><span class=\"share__num\" data-kid=\"1-3-3-2-2-2-1-2\" data-name=\"Android share percentage\">23.4%</span></span>\n</td>\n<td data-kid=\"1-3-3-2-2-3\" data-name=\"Android landing face note\">Coming Soon, through the <span class=\"n\" data-kid=\"1-3-3-2-2-3-1\" data-name=\"casual alias code\">casual</span> alias in the AOSP font config</td>\n<td class=\"n\" data-kid=\"1-3-3-2-2-4\" data-name=\"Android weight cell\">400</td>\n</tr>\n<tr data-kid=\"1-3-3-2-3\" data-name=\"iOS platform row\">\n<td data-kid=\"1-3-3-2-3-1\" data-name=\"iOS platform name\">iOS</td>\n<td data-kid=\"1-3-3-2-3-2\" data-name=\"iOS share cell\">\n<span class=\"share\" data-kid=\"1-3-3-2-3-2-1\" data-name=\"share bar container\"><span class=\"share__track\" data-kid=\"1-3-3-2-3-2-1-1\" data-name=\"share bar track\"><i class=\"share__fill\" data-kid=\"1-3-3-2-3-2-1-1-1\" data-name=\"share bar fill\" style=\"--w:65%\"></i></span><span class=\"share__num\" data-kid=\"1-3-3-2-3-2-1-2\" data-name=\"iOS share percentage\">23.3%</span></span>\n</td>\n<td class=\"dim\" data-kid=\"1-3-3-2-3-3\" data-name=\"iOS landing face note\">Bradley Hand if it resolves; otherwise Comic Sans MS, Chalkboard, Chalkboard SE or Marker Felt — all are Apple faces, several are document-support and activate on request</td>\n<td class=\"n\" data-kid=\"1-3-3-2-3-4\" data-name=\"iOS weight cell\">700</td>\n</tr>\n<tr data-kid=\"1-3-3-2-4\" data-name=\"macOS platform row\">\n<td data-kid=\"1-3-3-2-4-1\" data-name=\"macOS platform name\">macOS<span class=\"sub\" data-kid=\"1-3-3-2-4-1-1\" data-name=\"macOS version caption\">OS X 7.5 + macOS 5.6</span></td>\n<td data-kid=\"1-3-3-2-4-2\" data-name=\"macOS share cell\">\n<span class=\"share\" data-kid=\"1-3-3-2-4-2-1\" data-name=\"share bar container\"><span class=\"share__track\" data-kid=\"1-3-3-2-4-2-1-1\" data-name=\"share bar track\"><i class=\"share__fill\" data-kid=\"1-3-3-2-4-2-1-1-1\" data-name=\"share bar fill\" style=\"--w:36%\"></i></span><span class=\"share__num\" data-kid=\"1-3-3-2-4-2-1-2\" data-name=\"macOS share percentage\">13.1%</span></span>\n</td>\n<td class=\"dim\" data-kid=\"1-3-3-2-4-3\" data-name=\"macOS landing face note\">The same four Apple faces, with the same question about which are active</td>\n<td class=\"n\" data-kid=\"1-3-3-2-4-4\" data-name=\"macOS weight cell\">700 · 400 · 300</td>\n</tr>\n<tr data-kid=\"1-3-3-2-5\" data-name=\"Chrome OS platform row\">\n<td data-kid=\"1-3-3-2-5-1\" data-name=\"Chrome OS platform name\">Chrome OS</td>\n<td data-kid=\"1-3-3-2-5-2\" data-name=\"Chrome OS share cell\">\n<span class=\"share\" data-kid=\"1-3-3-2-5-2-1\" data-name=\"share bar container\"><span class=\"share__track\" data-kid=\"1-3-3-2-5-2-1-1\" data-name=\"share bar track\"><i class=\"share__fill\" data-kid=\"1-3-3-2-5-2-1-1-1\" data-name=\"share bar fill\" style=\"--w:6%\"></i></span><span class=\"share__num\" data-kid=\"1-3-3-2-5-2-1-2\" data-name=\"Chrome OS share percentage\">2.2%</span></span>\n</td>\n<td class=\"dim\" data-kid=\"1-3-3-2-5-3\" data-name=\"Chrome OS landing note\">Nothing verified. None of the named faces ships, and <span class=\"n\" data-kid=\"1-3-3-2-5-3-1\" data-name=\"casual alias code\">casual</span> is not a Chrome OS family</td>\n<td class=\"n\" data-kid=\"1-3-3-2-5-4\" data-name=\"Chrome OS weight cell\">—</td>\n</tr>\n<tr data-kid=\"1-3-3-2-6\" data-name=\"Linux platform row\">\n<td data-kid=\"1-3-3-2-6-1\" data-name=\"Linux platform name\">Linux<span class=\"sub\" data-kid=\"1-3-3-2-6-1-1\" data-name=\"Linux note caption\">counted inside Other</span></td>\n<td data-kid=\"1-3-3-2-6-2\" data-name=\"Linux share cell\">\n<span class=\"share\" data-kid=\"1-3-3-2-6-2-1\" data-name=\"share bar container\"><span class=\"share__track\" data-kid=\"1-3-3-2-6-2-1-1\" data-name=\"share bar track\"><i class=\"share__fill\" data-kid=\"1-3-3-2-6-2-1-1-1\" data-name=\"share bar fill\" style=\"--w:5%\"></i></span><span class=\"share__num\" data-kid=\"1-3-3-2-6-2-1-2\" data-name=\"Linux share percentage\">under 2%</span></span>\n</td>\n<td class=\"dim\" data-kid=\"1-3-3-2-6-3\" data-name=\"Linux landing face note\">Chilanka, TSCu_Comic or URW Chancery L only where those packages are installed; otherwise the default sans</td>\n<td class=\"n\" data-kid=\"1-3-3-2-6-4\" data-name=\"Linux weight cell\">varies</td>\n</tr>\n</tbody>\n</table>\n<dl class=\"facts\" data-kid=\"1-3-4\" data-name=\"handwritten stack facts strip\">\n<div class=\"fact\" data-kid=\"1-3-4-1\" data-name=\"coverage fact\">\n<dt data-kid=\"1-3-4-1-1\" data-name=\"coverage label\">Coverage</dt>\n<dd data-kid=\"1-3-4-1-2\" data-name=\"coverage description\"><b data-kid=\"1-3-4-1-2-1\" data-name=\"coverage percentage\">95.7%</b> land on a named face if Apple's document-support faces resolve; <b data-kid=\"1-3-4-1-2-2\" data-name=\"coverage percentage\">82.6%</b> get one face with no ambiguity.</dd>\n</div>\n<div class=\"fact\" data-kid=\"1-3-4-2\" data-name=\"distinct faces fact\">\n<dt data-kid=\"1-3-4-2-1\" data-name=\"distinct faces label\">Distinct faces</dt>\n<dd data-kid=\"1-3-4-2-2\" data-name=\"distinct faces description\"><b data-kid=\"1-3-4-2-2-1\" data-name=\"faces count\">8</b> named, plus whatever a Linux machine substitutes. One per platform is the best case.</dd>\n</div>\n<div class=\"fact\" data-kid=\"1-3-4-3\" data-name=\"weight fact\">\n<dt data-kid=\"1-3-4-3-1\" data-name=\"weight label\">Weight you see</dt>\n<dd data-kid=\"1-3-4-3-2\" data-name=\"weight description\">400 on Windows and Android, <b data-kid=\"1-3-4-3-2-1\" data-name=\"Apple weight value\">700</b> on Apple. The same recipe renders bold on an iPhone.</dd>\n</div>\n<div class=\"fact\" data-kid=\"1-3-4-4\" data-name=\"x-height fact\">\n<dt data-kid=\"1-3-4-4-1\" data-name=\"x-height label\">x-height</dt>\n<dd data-kid=\"1-3-4-4-2\" data-name=\"x-height description\">0.33em to 0.50em across the plausible faces, so line count changes with the face, not just the size.</dd>\n</div>\n</dl>\n<div class=\"note\" data-kid=\"1-3-5\" data-name=\"macrons note\">\n<dt data-kid=\"1-3-5-1\" data-name=\"macrons label\">Macrons</dt>\n<dd data-kid=\"1-3-5-2\" data-name=\"macrons note text\">Half the recipe copy is kūmara, kōura, kānga, hāngī. TSCu_Comic is a ~230-glyph Tamil face, so Latin Extended-A is a real risk there; Bradley Hand and Segoe Print are unverified for it. A missing glyph falls back per character, so a macron vowel can render in a different face mid-word.</dd>\n</div>\n</section>\n<section aria-labelledby=\"stacks-h\" data-kid=\"1-4\" data-name=\"font stacks assessment section\">\n<div class=\"shead\" data-kid=\"1-4-1\" data-name=\"section heading bar\">\n<h2 data-kid=\"1-4-1-1\" data-name=\"section title\" id=\"stacks-h\">Which of the catalogue holds up</h2>\n<p data-kid=\"1-4-1-2\" data-name=\"section subtitle\">15 stacks, judged on faces met, weights present, and metric spread</p>\n</div>\n<table data-kid=\"1-4-2\" data-name=\"font stacks assessment table\">\n<thead data-kid=\"1-4-2-1\" data-name=\"table header row group\">\n<tr data-kid=\"1-4-2-1-1\" data-name=\"table header row\">\n<th data-kid=\"1-4-2-1-1-1\" data-name=\"stack column header\" scope=\"col\" style=\"width:220px\">Stack</th>\n<th data-kid=\"1-4-2-1-1-2\" data-name=\"faces met column header\" scope=\"col\">Faces met across platforms</th>\n<th data-kid=\"1-4-2-1-1-3\" data-name=\"weights column header\" scope=\"col\" style=\"width:200px\">Weights on those faces</th>\n<th data-kid=\"1-4-2-1-1-4\" data-name=\"verdict column header\" scope=\"col\" style=\"width:210px\">Verdict</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-4-2-2\" data-name=\"table body rows\">\n<tr data-kid=\"1-4-2-2-1\" data-name=\"monospace code row\">\n<td data-kid=\"1-4-2-2-1-1\" data-name=\"monospace code stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"monospace code stack name\" style=\"font-family:var(--font-fig);font-size:14px\">Monospace Code</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-1-2\" data-name=\"monospace code faces list\">SF Mono, Cascadia Code, Menlo, Consolas, Noto Mono, Droid Sans Mono</td>\n<td class=\"n\" data-kid=\"1-4-2-2-1-3\" data-name=\"monospace code weights\">400 · 700</td>\n<td class=\"verdict v-hold\" data-kid=\"1-4-2-2-1-4\" data-name=\"monospace code verdict\">Holds<span data-kid=\"1-4-2-2-1-4-1\" data-name=\"monospace code verdict explanation\">fixed width is the invariant, so the face swap is invisible in a column</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-2\" data-name=\"system UI row\">\n<td data-kid=\"1-4-2-2-2-1\" data-name=\"system UI stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"system UI stack name\" style=\"font-family:var(--font-ui);font-size:15px\">System UI</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-2-2\" data-name=\"system UI faces list\">SF Pro, Segoe UI, Roboto, Ubuntu, Adwaita, Cantarell, Noto Sans</td>\n<td class=\"n\" data-kid=\"1-4-2-2-2-3\" data-name=\"system UI weights note\">full ladder; 600 missing on Ubuntu, Cantarell</td>\n<td class=\"verdict v-hold\" data-kid=\"1-4-2-2-2-4\" data-name=\"system UI verdict\">Holds<span data-kid=\"1-4-2-2-2-4-1\" data-name=\"system UI verdict explanation\">every visitor gets their own UI face; nothing is lost by that</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-3\" data-name=\"neo-grotesque row\">\n<td data-kid=\"1-4-2-2-3-1\" data-name=\"neo-grotesque stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-3-1-1\" data-name=\"neo-grotesque stack name\" style=\"font-family:var(--font-neo);font-size:15px\">Neo-Grotesque</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-3-2\" data-name=\"neo-grotesque faces list\">Helvetica Neue, Arial, Nimbus Sans, Roboto</td>\n<td class=\"n\" data-kid=\"1-4-2-2-3-3\" data-name=\"neo-grotesque weights\">400 · 700 + italic</td>\n<td class=\"verdict v-hold\" data-kid=\"1-4-2-2-3-4\" data-name=\"neo-grotesque verdict\">Holds, metric-compatible<span data-kid=\"1-4-2-2-3-4-1\" data-name=\"neo-grotesque verdict explanation\">Helvetica Neue, Arial and Nimbus Sans share widths, so line breaks survive</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-4\" data-name=\"humanist row\">\n<td data-kid=\"1-4-2-2-4-1\" data-name=\"humanist stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-4-1-1\" data-name=\"humanist stack name\" style=\"font-family:var(--font-read);font-size:15px\">Humanist</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-4-2\" data-name=\"humanist faces list\">Seravek, Calibri, Ubuntu, Noto Sans, Source Sans</td>\n<td class=\"n\" data-kid=\"1-4-2-2-4-3\" data-name=\"humanist weights note\">400 · 500 · 700; no 600 outside Android</td>\n<td class=\"verdict v-hold\" data-kid=\"1-4-2-2-4-4\" data-name=\"humanist verdict\">Holds, with care<span data-kid=\"1-4-2-2-4-4-1\" data-name=\"humanist verdict explanation\">four personalities at the same size; no 600 to lean on</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-5\" data-name=\"transitional row\">\n<td data-kid=\"1-4-2-2-5-1\" data-name=\"transitional stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-5-1-1\" data-name=\"transitional stack name\" style=\"font-family:var(--font-trans);font-size:15px\">Transitional</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-5-2\" data-name=\"transitional faces list\">Charter, Sitka Text, Cambria, Noto Serif</td>\n<td class=\"n\" data-kid=\"1-4-2-2-5-3\" data-name=\"transitional weights\">400 · 700</td>\n<td class=\"verdict v-care\" data-kid=\"1-4-2-2-5-4\" data-name=\"transitional verdict\">Holds, with care<span data-kid=\"1-4-2-2-5-4-1\" data-name=\"transitional verdict explanation\">Charter and Sitka are both Matthew Carter designs</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-6\" data-name=\"old style row\">\n<td data-kid=\"1-4-2-2-6-1\" data-name=\"old style stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-6-1-1\" data-name=\"old style stack name\" style=\"font-family:var(--font-old);font-size:15px\">Old Style</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-6-2\" data-name=\"old style faces list\">Iowan Old Style, Palatino Linotype, URW Palladio, P052, Noto Serif</td>\n<td class=\"n\" data-kid=\"1-4-2-2-6-3\" data-name=\"old style weights\">400 · 700</td>\n<td class=\"verdict v-care\" data-kid=\"1-4-2-2-6-4\" data-name=\"old style verdict\">Holds, with care<span data-kid=\"1-4-2-2-6-4-1\" data-name=\"old style verdict explanation\">Palladio is a Palatino clone, so two of four are near-identical</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-7\" data-name=\"antique row\">\n<td data-kid=\"1-4-2-2-7-1\" data-name=\"antique stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-7-1-1\" data-name=\"antique stack name\" style=\"font-family:var(--font-antique);font-size:15px\">Antique</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-7-2\" data-name=\"antique faces list\">Superclarendon, Bookman Old Style, URW Bookman, Georgia, Noto Serif</td>\n<td class=\"n\" data-kid=\"1-4-2-2-7-3\" data-name=\"antique weights note\">400 · 700; URW Bookman ships 300 · 600</td>\n<td class=\"verdict v-care\" data-kid=\"1-4-2-2-7-4\" data-name=\"antique verdict\">Holds, with care<span data-kid=\"1-4-2-2-7-4-1\" data-name=\"antique verdict explanation\">a Linux visitor gets 600 where Windows gets 700</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-8\" data-name=\"classical humanist row\">\n<td data-kid=\"1-4-2-2-8-1\" data-name=\"classical humanist stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-8-1-1\" data-name=\"classical humanist stack name\" style=\"font-family:var(--font-classical);font-size:15px\">Classical Humanist</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-8-2\" data-name=\"classical humanist faces list\">Optima, Candara, Noto Sans, Source Sans</td>\n<td class=\"n\" data-kid=\"1-4-2-2-8-3\" data-name=\"classical humanist weights\">400 · 700</td>\n<td class=\"verdict v-care\" data-kid=\"1-4-2-2-8-4\" data-name=\"classical humanist verdict\">With care<span data-kid=\"1-4-2-2-8-4-1\" data-name=\"classical humanist verdict explanation\">Optima is a flared roman; the others are plain humanist sans</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-9\" data-name=\"geometric humanist row\">\n<td data-kid=\"1-4-2-2-9-1\" data-name=\"geometric humanist stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-9-1-1\" data-name=\"geometric humanist stack name\" style=\"font-family:var(--font-geo);font-size:15px\">Geometric Humanist</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-9-2\" data-name=\"geometric humanist faces list\">Avenir, Corbel, URW Gothic, Source Sans</td>\n<td class=\"n\" data-kid=\"1-4-2-2-9-3\" data-name=\"geometric humanist weights note\">Avenir has no 700; 700 falls to 800</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-9-4\" data-name=\"geometric humanist verdict\">Weak at 700<span data-kid=\"1-4-2-2-9-4-1\" data-name=\"geometric humanist verdict explanation\">the heading weight jumps by a step on every Mac</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-10\" data-name=\"slab serif row\">\n<td data-kid=\"1-4-2-2-10-1\" data-name=\"slab serif stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-10-1-1\" data-name=\"slab serif stack name\" style=\"font-family:var(--font-slab);font-size:15px\">Slab Serif</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-10-2\" data-name=\"slab serif faces list\">Rockwell, Rockwell Nova, Roboto Slab, DejaVu Serif, Sitka Small</td>\n<td class=\"n\" data-kid=\"1-4-2-2-10-3\" data-name=\"slab serif weights\">400 · 700</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-10-4\" data-name=\"slab serif verdict\">Not a slab on Windows<span data-kid=\"1-4-2-2-10-4-1\" data-name=\"slab serif verdict explanation\">Rockwell ships with Office, not Windows; the stack ends in a plain serif</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-11\" data-name=\"didone row\">\n<td data-kid=\"1-4-2-2-11-1\" data-name=\"didone stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-11-1-1\" data-name=\"didone stack name\" style=\"font-family:var(--font-didone);font-size:15px\">Didone</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-11-2\" data-name=\"didone faces list\">Didot, Bodoni MT, Noto Serif Display, URW Palladio, Sylfaen</td>\n<td class=\"n\" data-kid=\"1-4-2-2-11-3\" data-name=\"didone weights note\">Sylfaen has no bold</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-11-4\" data-name=\"didone verdict\">Display only<span data-kid=\"1-4-2-2-11-4-1\" data-name=\"didone verdict explanation\">hairline serifs at 15px, and a faux bold on Windows</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-12\" data-name=\"rounded sans row\">\n<td data-kid=\"1-4-2-2-12-1\" data-name=\"rounded sans stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-12-1-1\" data-name=\"rounded sans stack name\" style=\"font-family:var(--font-round);font-size:15px\">Rounded Sans</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-12-2\" data-name=\"rounded sans faces list\">SF Pro Rounded, Hiragino Maru, Arial Rounded MT, Calibri, Source Sans</td>\n<td class=\"n\" data-kid=\"1-4-2-2-12-3\" data-name=\"rounded sans weights\">400 · 700</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-12-4\" data-name=\"rounded sans verdict\">Fails the intent<span data-kid=\"1-4-2-2-12-4-1\" data-name=\"rounded sans verdict explanation\">Android and most Windows get a face with no round terminals</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-13\" data-name=\"industrial row\">\n<td data-kid=\"1-4-2-2-13-1\" data-name=\"industrial stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-13-1-1\" data-name=\"industrial stack name\" style=\"font-family:var(--font-ind);font-size:15px\">Industrial</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-13-2\" data-name=\"industrial faces list\">Bahnschrift, DIN Alternate, Franklin Gothic Medium, Nimbus Sans Narrow</td>\n<td class=\"n\" data-kid=\"1-4-2-2-13-3\" data-name=\"industrial weights note\">DIN Alternate is 700 only</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-13-4\" data-name=\"industrial verdict\">Display only<span data-kid=\"1-4-2-2-13-4-1\" data-name=\"industrial verdict explanation\">the catalogue says so itself; weights do not line up</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-14\" data-name=\"monospace slab row\">\n<td data-kid=\"1-4-2-2-14-1\" data-name=\"monospace slab stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-14-1-1\" data-name=\"monospace slab stack name\" style=\"font-family:var(--font-monoslab);font-size:14px\">Monospace Slab</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-14-2\" data-name=\"monospace slab faces list\">Nimbus Mono PS, Courier New, Cutive Mono</td>\n<td class=\"n\" data-kid=\"1-4-2-2-14-3\" data-name=\"monospace slab weights\">400 · 700</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-14-4\" data-name=\"monospace slab verdict\">Holds, but thin<span data-kid=\"1-4-2-2-14-4-1\" data-name=\"monospace slab verdict explanation\">Courier New is the lighter, wider cousin of every other mono</span></td>\n</tr>\n<tr data-kid=\"1-4-2-2-15\" data-name=\"handwritten row\">\n<td data-kid=\"1-4-2-2-15-1\" data-name=\"handwritten stack name cell\"><span class=\"stackname\" data-kid=\"1-4-2-2-15-1-1\" data-name=\"handwritten stack name\" style=\"font-family:var(--font-hand);font-size:15px\">Handwritten</span></td>\n<td class=\"small dim\" data-kid=\"1-4-2-2-15-2\" data-name=\"handwritten faces list\">Segoe Print, Coming Soon, Bradley Hand, Comic Sans MS, Chalkboard, Marker Felt</td>\n<td class=\"n\" data-kid=\"1-4-2-2-15-3\" data-name=\"handwritten weights note\">400 or 700, by platform</td>\n<td class=\"verdict v-no\" data-kid=\"1-4-2-2-15-4\" data-name=\"handwritten verdict\">Not for reading<span data-kid=\"1-4-2-2-15-4-1\" data-name=\"handwritten verdict explanation\">availability covers most sessions; determinism and metrics do not</span></td>\n</tr>\n</tbody>\n</table>\n<dl class=\"note\" data-kid=\"1-4-3\" data-name=\"substitution note\">\n<dt data-kid=\"1-4-3-1\" data-name=\"substitution note label\">If humanist reads too unevenly</dt>\n<dd data-kid=\"1-4-3-2\" data-name=\"substitution note text\">Neo-Grotesque is the only substitute that keeps line breaks stable: Helvetica Neue on Apple, Arial on Windows and Nimbus Sans on Linux are metric-compatible with each other. It costs the calligraphic forms that make humanist worth choosing in the first place.</dd>\n</dl>\n</section>\n</main>\n",
      "comments": [],
      "created": "2026-11-17T21:47:44.954464+00:00",
      "modified": "2026-11-17T21:49:10.732222+00:00",
      "id": "var_c8f58f19d49d",
      "contentHeight": 2704
    },
    "var_899f2358f53f": {
      "type": "variant",
      "label": "Recipe site typography — what the category loads",
      "parentId": "var_c8f58f19d49d",
      "themeId": null,
      "rect": {
        "x": 44537,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --accent:oklch(0.505 0.180 32);\n  --font-ui:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-ui);font-size:13.5px;line-height:1.45}\n.sheet{max-width:1180px;margin:0 auto;padding:40px 32px 64px}\nh1{font-size:25px;font-weight:600;letter-spacing:-.02em;margin:0}\n.headrule{height:1px;background:var(--ink);margin-top:16px}\nh2{font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0}\nsection{margin-top:38px}\n.shead{display:flex;align-items:baseline;justify-content:space-between;gap:24px;padding-bottom:10px;border-bottom:1px solid var(--rule)}\n.shead p{font-family:var(--font-fig);font-size:10.5px;color:var(--ink-muted);margin:0}\n.n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12.5px}\n.dim{color:var(--ink-muted)}\n.small{font-size:12px;line-height:1.5}\n\ntable{width:100%;border-collapse:collapse;table-layout:fixed;margin-top:16px}\nth{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);font-weight:400;text-align:left;padding:0 16px 9px 0;border-bottom:1px solid var(--rule);vertical-align:bottom}\ntd{padding:13px 16px 13px 0;border-bottom:1px solid var(--rule-hair);vertical-align:baseline;line-height:1.5}\ntd:last-child,th:last-child{padding-right:0}\n.site{font-size:14px;font-weight:600}\n.sep{display:block;font-family:var(--font-fig);font-size:10px;color:var(--ink-faint);margin-top:3px;letter-spacing:0}\n\n/* findings */\n.findings{margin-top:34px;border-top:1px solid var(--rule)}\n.finding{display:grid;grid-template-columns:150px minmax(0,1fr);column-gap:28px;align-items:baseline;padding:15px 0 16px;border-bottom:1px solid var(--rule-hair)}\n.finding dt{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted)}\n.finding dd{margin:0;font-family:var(--font-read);font-size:15px;line-height:1.6;max-width:74ch}\n.finding dd b{font-weight:600}\n\n/* evidence */\n.evidence{margin-top:26px;background:var(--card);border:1px solid var(--rule);border-radius:8px;padding:18px 22px 20px}\n.evidence__l{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0 0 12px}\n.evidence ul{margin:0;padding:0;list-style:none}\n.evidence li{display:grid;grid-template-columns:minmax(0,1fr) 190px;column-gap:24px;align-items:baseline;padding:8px 0}\n.evidence li + li{border-top:1px solid var(--rule-hair)}\n.evidence code{font-family:var(--font-fig);font-size:11.5px;color:var(--ink)}\n.evidence span{font-family:var(--font-ui);font-size:11.5px;color:var(--ink-muted);text-align:right}\n\n/* our roles */\n.ours{margin-top:34px;border-top:1px solid var(--ink);padding-top:22px}\n.ours h3{font-size:14px;font-weight:600;margin:0 0 12px}\n.ours table{margin-top:8px}\n.verdict{font-size:12.5px;line-height:1.5}\n.verdict em{font-style:normal;font-family:var(--font-fig);font-size:10px;color:var(--ink-faint);display:block;margin-top:3px}\n</style>\n<main class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<h1 data-kid=\"1-1\" data-name=\"page headline\">Recipe site typography</h1>\n<div class=\"headrule\" data-kid=\"1-2\" data-name=\"header divider rule\"></div>\n<section aria-labelledby=\"sample-h\" data-kid=\"1-3\" data-name=\"typography sample section\">\n<div class=\"shead\" data-kid=\"1-3-1\" data-name=\"section header bar\">\n<h2 data-kid=\"1-3-1-1\" data-name=\"section title\" id=\"sample-h\">What the recipe pages load</h2>\n<p data-kid=\"1-3-1-2\" data-name=\"section last-updated caption\">CSS inspected 17 November 2026</p>\n</div>\n<table data-kid=\"1-3-2\" data-name=\"typography comparison table\">\n<thead data-kid=\"1-3-2-1\" data-name=\"table header row group\">\n<tr data-kid=\"1-3-2-1-1\" data-name=\"table header row\">\n<th data-kid=\"1-3-2-1-1-1\" data-name=\"site name column header\" scope=\"col\" style=\"width:190px\">Site</th>\n<th data-kid=\"1-3-2-1-1-2\" data-name=\"recipe title column header\" scope=\"col\" style=\"width:230px\">Recipe title</th>\n<th data-kid=\"1-3-2-1-1-3\" data-name=\"method body column header\" scope=\"col\" style=\"width:230px\">Method body</th>\n<th data-kid=\"1-3-2-1-1-4\" data-name=\"family count column header\" scope=\"col\" style=\"width:96px\">Families</th>\n<th data-kid=\"1-3-2-1-1-5\" data-name=\"recipe markup column header\" scope=\"col\">How the recipe is marked off</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-3-2-2\" data-name=\"table body row group\">\n<tr data-kid=\"1-3-2-2-1\" data-name=\"King Arthur Baking table row\">\n<td data-kid=\"1-3-2-2-1-1\" data-name=\"site name cell\"><span class=\"site\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"site name label\">King Arthur Baking</span></td>\n<td data-kid=\"1-3-2-2-1-2\" data-name=\"recipe title font cell\">Para Supreme, a serif webfont<span class=\"sep\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"font fallback note\">falls back to georgia, serif</span></td>\n<td data-kid=\"1-3-2-2-1-3\" data-name=\"method body font cell\">Brandon Grotesque, a sans webfont</td>\n<td class=\"n\" data-kid=\"1-3-2-2-1-4\" data-name=\"family count cell\">2</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-1-5\" data-name=\"recipe markup cell false\">a <span class=\"n\" data-kid=\"1-3-2-2-1-5-1\">recipe__</span> region, 24 classes deep, inside the article</td>\n</tr>\n<tr data-kid=\"1-3-2-2-2\">\n<td data-kid=\"1-3-2-2-2-1\"><span class=\"site\" data-kid=\"1-3-2-2-2-1-1\">BBC Good Food</span></td>\n<td data-kid=\"1-3-2-2-2-2\">Silva Display, a serif webfont<span class=\"sep\" data-kid=\"1-3-2-2-2-2-1\">falls back to georgia, times, serif</span></td>\n<td data-kid=\"1-3-2-2-2-3\">Ariana Pro, a sans webfont<span class=\"sep\" data-kid=\"1-3-2-2-2-3-1\">a system sans stack sits beneath it</span></td>\n<td class=\"n\" data-kid=\"1-3-2-2-2-4\">2</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-2-5\">a <span class=\"n\" data-kid=\"1-3-2-2-2-5-1\">recipe-card</span> inside a <span class=\"n\" data-kid=\"1-3-2-2-2-5-2\">recipe__</span> region, plus jump to recipe</td>\n</tr>\n<tr data-kid=\"1-3-2-2-3\">\n<td data-kid=\"1-3-2-2-3-1\"><span class=\"site\" data-kid=\"1-3-2-2-3-1-1\">RecipeTin Eats</span></td>\n<td data-kid=\"1-3-2-2-3-2\">Lora, a serif webfont</td>\n<td data-kid=\"1-3-2-2-3-3\">Raleway, a sans webfont</td>\n<td class=\"n\" data-kid=\"1-3-2-2-3-4\">2</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-3-5\">a WP Recipe Maker card, 364 class references</td>\n</tr>\n<tr data-kid=\"1-3-2-2-4\">\n<td data-kid=\"1-3-2-2-4-1\"><span class=\"site\" data-kid=\"1-3-2-2-4-1-1\">Smitten Kitchen</span></td>\n<td class=\"dim\" data-kid=\"1-3-2-2-4-2\">not resolved, stylesheet blocked</td>\n<td class=\"dim\" data-kid=\"1-3-2-2-4-3\">not resolved</td>\n<td class=\"n dim\" data-kid=\"1-3-2-2-4-4\">—</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-4-5\">a WP Recipe Maker card on a story post</td>\n</tr>\n<tr data-kid=\"1-3-2-2-5\">\n<td data-kid=\"1-3-2-2-5-1\"><span class=\"site\" data-kid=\"1-3-2-2-5-1-1\">Allrecipes</span></td>\n<td data-kid=\"1-3-2-2-5-2\">Copper Pot, a display webfont<span class=\"sep\" data-kid=\"1-3-2-2-5-2-1\">reported by a font audit</span></td>\n<td data-kid=\"1-3-2-2-5-3\">Source Sans 3</td>\n<td class=\"n\" data-kid=\"1-3-2-2-5-4\">2</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-5-5\">its own recipe template and a jump link</td>\n</tr>\n<tr data-kid=\"1-3-2-2-6\">\n<td data-kid=\"1-3-2-2-6-1\"><span class=\"site\" data-kid=\"1-3-2-2-6-1-1\">Serious Eats</span></td>\n<td data-kid=\"1-3-2-2-6-2\">Inter<span class=\"sep\" data-kid=\"1-3-2-2-6-2-1\">the audit gives it headings; Space Grotesk takes smaller text</span></td>\n<td data-kid=\"1-3-2-2-6-3\">Inter</td>\n<td class=\"n\" data-kid=\"1-3-2-2-6-4\">2</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-6-5\">the recipe is the page; no card, and historically no jump link</td>\n</tr>\n<tr data-kid=\"1-3-2-2-7\">\n<td data-kid=\"1-3-2-2-7-1\"><span class=\"site\" data-kid=\"1-3-2-2-7-1-1\">Jamie Oliver</span></td>\n<td data-kid=\"1-3-2-2-7-2\">P22 Underground<span class=\"sep\" data-kid=\"1-3-2-2-7-2-1\">with Housebrick for display lines</span></td>\n<td data-kid=\"1-3-2-2-7-3\">Poppins</td>\n<td class=\"n\" data-kid=\"1-3-2-2-7-4\">3</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-7-5\">overview / ingredients / method tabs</td>\n</tr>\n<tr data-kid=\"1-3-2-2-8\">\n<td data-kid=\"1-3-2-2-8-1\"><span class=\"site\" data-kid=\"1-3-2-2-8-1-1\">Bon Appétit</span></td>\n<td data-kid=\"1-3-2-2-8-2\">Futura PT</td>\n<td data-kid=\"1-3-2-2-8-3\">Work Sans</td>\n<td class=\"n\" data-kid=\"1-3-2-2-8-4\">4</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-8-5\">a recipe route of its own; Radley and Owners Narrow are the extra two</td>\n</tr>\n<tr data-kid=\"1-3-2-2-9\">\n<td data-kid=\"1-3-2-2-9-1\"><span class=\"site\" data-kid=\"1-3-2-2-9-1-1\">NYT Cooking</span></td>\n<td data-kid=\"1-3-2-2-9-2\">Karnak, a slab serif<span class=\"sep\" data-kid=\"1-3-2-2-9-2-1\">reported in a design case study</span></td>\n<td class=\"dim\" data-kid=\"1-3-2-2-9-3\">not resolved</td>\n<td class=\"n dim\" data-kid=\"1-3-2-2-9-4\">—</td>\n<td class=\"small dim\" data-kid=\"1-3-2-2-9-5\">a recipe box with a cooked mode</td>\n</tr>\n</tbody>\n</table>\n<dl class=\"findings\" data-kid=\"1-3-3\">\n<div class=\"finding\" data-kid=\"1-3-3-1\">\n<dt data-kid=\"1-3-3-1-1\">Family count</dt>\n<dd data-kid=\"1-3-3-1-2\">Two is the norm: <b data-kid=\"1-3-3-1-2-1\">five of the seven</b> sites where the families could be counted load exactly two. Three and four appear only at the magazines, which are paying for brand typefaces.</dd>\n</div>\n<div class=\"finding\" data-kid=\"1-3-3-2\">\n<dt data-kid=\"1-3-3-2-1\">Where the serif goes</dt>\n<dd data-kid=\"1-3-3-2-2\">On the <b data-kid=\"1-3-3-2-2-1\">title</b>, never on the method. In every site where the roles could be read, the method body is the sans and the serif is the display face.</dd>\n</div>\n<div class=\"finding\" data-kid=\"1-3-3-3\">\n<dt data-kid=\"1-3-3-3-1\">How the recipe is marked off</dt>\n<dd data-kid=\"1-3-3-3-2\">By <b data-kid=\"1-3-3-3-2-1\">structure</b>: a recipe component with its own template, a named region, tabs, or a jump-to-recipe anchor. No site in the sample gives the recipe a different typeface from the article around it.</dd>\n</div>\n<div class=\"finding\" data-kid=\"1-3-3-4\">\n<dt data-kid=\"1-3-3-4-1\">Figures</dt>\n<dd data-kid=\"1-3-3-4-2\">Mono stacks do appear in these stylesheets, on the <span class=\"n\" data-kid=\"1-3-3-4-2-1\">code</span> element. <b data-kid=\"1-3-3-4-2-2\">Not one site</b> sets ingredient quantities or cook times in one; they stay in the text face.</dd>\n</div>\n</dl>\n<div class=\"evidence\" data-kid=\"1-3-4\">\n<p class=\"evidence__l\" data-kid=\"1-3-4-1\">The serif fallback, quoted from their stylesheets</p>\n<ul data-kid=\"1-3-4-2\">\n<li data-kid=\"1-3-4-2-1\"><code data-kid=\"1-3-4-2-1-1\">para supreme, georgia, serif</code><span data-kid=\"1-3-4-2-1-2\">King Arthur Baking</span></li>\n<li data-kid=\"1-3-4-2-2\"><code data-kid=\"1-3-4-2-2-1\">silva-display, georgia, times, serif</code><span data-kid=\"1-3-4-2-2-2\">BBC Good Food</span></li>\n</ul>\n</div>\n</section>\n<section aria-labelledby=\"ours-h\" class=\"ours\" data-kid=\"1-4\">\n<h3 data-kid=\"1-4-1\" id=\"ours-h\">Where that leaves the four roles</h3>\n<table data-kid=\"1-4-2\">\n<thead data-kid=\"1-4-2-1\">\n<tr data-kid=\"1-4-2-1-1\">\n<th data-kid=\"1-4-2-1-1-1\" scope=\"col\" style=\"width:170px\">Role</th>\n<th data-kid=\"1-4-2-1-1-2\" scope=\"col\" style=\"width:220px\">Our face</th>\n<th data-kid=\"1-4-2-1-1-3\" scope=\"col\">Against the category</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-4-2-2\">\n<tr data-kid=\"1-4-2-2-1\">\n<td data-kid=\"1-4-2-2-1-1\">Names</td>\n<td class=\"n\" data-kid=\"1-4-2-2-1-2\">Georgia</td>\n<td class=\"verdict\" data-kid=\"1-4-2-2-1-3\">The category's own fallback. Both leaders set the title in a webfont whose next line is Georgia, so this is the same decision without the 40–80 KB.<em data-kid=\"1-4-2-2-1-3-1\">conventional, and the strongest single choice</em></td>\n</tr>\n<tr data-kid=\"1-4-2-2-2\">\n<td data-kid=\"1-4-2-2-2-1\">Reading text</td>\n<td class=\"n\" data-kid=\"1-4-2-2-2-2\">Humanist</td>\n<td class=\"verdict\" data-kid=\"1-4-2-2-2-3\">Matches the market's sans-for-body placement. It differs from the leaders only in not being a custom webfont.<em data-kid=\"1-4-2-2-2-3-1\">conventional</em></td>\n</tr>\n<tr data-kid=\"1-4-2-2-3\">\n<td data-kid=\"1-4-2-2-3-1\">Figures</td>\n<td class=\"n\" data-kid=\"1-4-2-2-3-2\">Mono</td>\n<td class=\"verdict\" data-kid=\"1-4-2-2-3-3\">Absent from the entire sample. Free in bytes, and it earns itself in the ingredients column, the chart and the ledger — on the recipe it is a statement rather than a convention.<em data-kid=\"1-4-2-2-3-3-1\">the only genuinely different move</em></td>\n</tr>\n<tr data-kid=\"1-4-2-2-4\">\n<td data-kid=\"1-4-2-2-4-1\">Chrome</td>\n<td class=\"n\" data-kid=\"1-4-2-2-4-2\">System UI</td>\n<td class=\"verdict\" data-kid=\"1-4-2-2-4-3\">No site runs two sans families for text and chrome. This is the one distinction the sample never makes, and the one that collapses on Linux. Folding controls into the humanist gives three families: serif, humanist, mono.<em data-kid=\"1-4-2-2-4-3-1\">the cut, if a cut is wanted</em></td>\n</tr>\n</tbody>\n</table>\n</section>\n</main>\n",
      "comments": [],
      "created": "2026-11-17T21:56:56.900912+00:00",
      "modified": "2026-11-17T21:57:42.785222+00:00",
      "id": "var_899f2358f53f",
      "contentHeight": 1815
    },
    "var_5546b69f68c1": {
      "type": "variant",
      "label": "Recipe — three voices, mono takes the apparatus",
      "parentId": "var_899f2358f53f",
      "themeId": null,
      "rect": {
        "x": 45917,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --rule-strong:oklch(0.800 0.036 62);\n  --accent:oklch(0.505 0.180 32);\n  --accent-ink:oklch(0.990 0.010 90);\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-read);font-size:14px;line-height:1.45}\n.sheet{padding:36px 40px 56px}\n.plate{background:var(--card);border:1px solid var(--rule);border-radius:12px;overflow:hidden}\n\n.bar{display:flex;align-items:center;gap:26px;height:60px;padding:0 44px;border-bottom:1px solid var(--rule-hair)}\n.wordmark{font-family:var(--font-name);font-size:17.5px;font-weight:700;letter-spacing:-.02em}\n.nav{display:flex;gap:18px;margin-left:6px}\n.nav a{font-family:var(--font-fig);font-size:11.5px;letter-spacing:.02em;color:var(--ink-muted);text-decoration:none;padding:4px 0}\n.nav a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--accent)}\n.av{margin-left:auto;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;border:1px solid var(--rule);background:var(--tint);font-family:var(--font-fig);font-size:10px;color:var(--ink-muted)}\n\n.doc{padding:34px 44px 40px}\n.dish{font-family:var(--font-name);font-weight:400;font-size:44px;line-height:1.04;letter-spacing:-.015em;margin:0;max-width:19ch}\n.note{font-family:var(--font-read);font-size:16.5px;line-height:1.6;color:var(--ink-muted);margin:16px 0 0;max-width:58ch}\n\n.meta{display:grid;grid-template-columns:repeat(6,minmax(0,auto));justify-content:start;column-gap:44px;margin:26px 0 0;padding:15px 0 16px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.meta dt{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0}\n.meta dd{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:14.5px;margin:5px 0 0}\n\n.body{display:grid;grid-template-columns:294px minmax(0,1fr);column-gap:52px;margin-top:34px}\nh2{font-family:var(--font-fig);font-size:10.5px;font-weight:400;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-muted);margin:0 0 6px}\n\n.ings{list-style:none;margin:0;padding:0}\n.ing{display:grid;grid-template-columns:62px minmax(0,1fr);column-gap:14px;padding:9px 0 10px;border-bottom:1px solid var(--rule-hair)}\n.ing:first-child{border-top:1px solid var(--rule-hair)}\n.ing__q{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:13.5px;line-height:1.5}\n.ing__i{font-family:var(--font-read);font-size:15.5px;line-height:1.5}\n\n.pantry{margin-top:24px;background:var(--tint);border-radius:6px;padding:13px 14px 15px}\n.pantry__l{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0 0 10px}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}\n.chip{font-family:var(--font-fig);font-size:10.5px;line-height:1;padding:6px 8px;border:1px dashed var(--rule-strong);border-radius:4px;background:var(--paper)}\n\n.method{margin:0;padding:0;list-style:none}\n.step{display:grid;grid-template-columns:34px minmax(0,1fr);column-gap:18px;padding:15px 0 16px;border-top:1px solid var(--rule-hair)}\n.step:last-child{border-bottom:1px solid var(--rule-hair)}\n.step__n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12px;line-height:1.9;color:var(--ink-muted)}\n.step__t{font-family:var(--font-read);font-size:16.5px;line-height:1.66;max-width:38em}\n\n.docfoot{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:30px;padding-top:20px;border-top:1px solid var(--rule)}\n.gen{font-family:var(--font-fig);font-size:10.5px;color:var(--ink-muted);margin:0}\n.acts{display:flex;gap:10px}\n.btn{display:inline-flex;align-items:center;height:36px;padding:0 16px;border-radius:6px;border:1px solid transparent;font-family:var(--font-fig);font-size:12px;letter-spacing:.01em;text-decoration:none;white-space:nowrap}\n.btn--fill{background:var(--accent);color:var(--accent-ink)}\n.btn--ghost{border-color:var(--rule-strong);color:var(--ink)}\n\n.key{display:flex;flex-wrap:wrap;gap:4px 14px;margin:16px 2px 0;font-family:var(--font-fig);font-size:10px;line-height:1.6;color:var(--ink-muted)}\n.key b{font-weight:400;color:var(--ink)}\n.key em{font-style:normal;font-family:var(--font-read);font-size:12px;color:var(--ink);margin-right:2px}\n</style>\n<div class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"plate\" data-kid=\"1-1\" data-name=\"recipe card plate\">\n<header class=\"bar\" data-kid=\"1-1-1\" data-name=\"app top bar header\">\n<span class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"site wordmark text\">Chef Llama</span>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to pantry\" href=\"#\">Pantry</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to recipes (current page)\" href=\"#\">Recipes</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to saved\" href=\"#\">Saved</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link to dashboard\" href=\"#\">Dashboard</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link to billing\" href=\"#\">Billing</a>\n</nav>\n<span aria-hidden=\"true\" class=\"av\" data-kid=\"1-1-1-3\" data-name=\"user avatar initials circle\">AR</span>\n</header>\n<main class=\"doc\" data-kid=\"1-1-2\" data-name=\"recipe document main region\">\n<h1 class=\"dish\" data-kid=\"1-1-2-1\" data-name=\"recipe title heading\">Kūmara, chickpea and silverbeet traybake</h1>\n<p class=\"note\" data-kid=\"1-1-2-2\" data-name=\"recipe intro note paragraph\">One tray and a 200 °C oven. The silverbeet goes in at the end, in two goes, so the stems cook through and the leaves only wilt.</p>\n<dl class=\"meta\" data-kid=\"1-1-2-3\" data-name=\"recipe metadata grid\">\n<div data-kid=\"1-1-2-3-1\" data-name=\"metadata field container\"><dt data-kid=\"1-1-2-3-1-1\" data-name='metadata label \"Total\"'>Total</dt><dd data-kid=\"1-1-2-3-1-2\" data-name='metadata value \"40 min\"'>40 min</dd></div>\n<div data-kid=\"1-1-2-3-2\" data-name=\"metadata field container\"><dt data-kid=\"1-1-2-3-2-1\" data-name='metadata label \"Prep\"'>Prep</dt><dd data-kid=\"1-1-2-3-2-2\" data-name='metadata value \"15 min\"'>15 min</dd></div>\n<div data-kid=\"1-1-2-3-3\" data-name=\"metadata field container\"><dt data-kid=\"1-1-2-3-3-1\" data-name='metadata label \"Per serving\"'>Per serving</dt><dd data-kid=\"1-1-2-3-3-2\" data-name='metadata value \"620 kcal\"'>620 kcal</dd></div>\n<div data-kid=\"1-1-2-3-4\" data-name=\"metadata field container\"><dt data-kid=\"1-1-2-3-4-1\" data-name='metadata label \"Serves\"'>Serves</dt><dd data-kid=\"1-1-2-3-4-2\" data-name='metadata value \"4\"'>4</dd></div>\n<div data-kid=\"1-1-2-3-5\" data-name=\"metadata field container\"><dt data-kid=\"1-1-2-3-5-1\" data-name='metadata label \"From pantry\"'>From pantry</dt><dd data-kid=\"1-1-2-3-5-2\" data-name='metadata value \"8 items\"'>8 items</dd></div>\n<div data-kid=\"1-1-2-3-6\" data-name=\"metadata field container\"><dt data-kid=\"1-1-2-3-6-1\" data-name='metadata label \"Cost\"'>Cost</dt><dd data-kid=\"1-1-2-3-6-2\" data-name='metadata value \"1 Credit\"'>1 Credit</dd></div>\n</dl>\n<div class=\"body\" data-kid=\"1-1-2-4\" data-name=\"recipe two-column body section\">\n<section aria-labelledby=\"ings-h\" data-kid=\"1-1-2-4-1\" data-name=\"ingredients section\">\n<h2 data-kid=\"1-1-2-4-1-1\" data-name=\"ingredients section heading\" id=\"ings-h\">Ingredients</h2>\n<ul class=\"ings\" data-kid=\"1-1-2-4-1-2\" data-name=\"ingredients list\">\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-1-1\" data-name=\"ingredient quantity\">800 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-1-2\" data-name=\"ingredient name\">kūmara, cut into 3 cm chunks</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-2-1\" data-name=\"ingredient quantity\">400 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-2-2\" data-name=\"ingredient name\">chickpeas, drained</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-3\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-3-1\" data-name=\"ingredient quantity\">2 tbsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-3-2\" data-name=\"ingredient name\">olive oil</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-4\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-4-1\" data-name=\"ingredient quantity\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-4-2\" data-name=\"ingredient name\">smoked paprika</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-5\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-5-1\" data-name=\"ingredient quantity\">3</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-5-2\" data-name=\"ingredient name\">cloves garlic, sliced</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-6\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-6-1\" data-name=\"ingredient quantity\">1 bunch</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-6-2\" data-name=\"ingredient name\">silverbeet, stems sliced, leaves torn</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-7\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-7-1\" data-name=\"ingredient quantity\">1</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-7-2\" data-name=\"ingredient name\">lemon, zest and juice</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-8\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-8-1\" data-name=\"ingredient quantity\">120 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-8-2\" data-name=\"ingredient name\">feta, crumbled</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-9\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-9-1\" data-name=\"ingredient quantity\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-9-2\" data-name=\"ingredient name\">flaky salt</span></li>\n</ul>\n<div class=\"pantry\" data-kid=\"1-1-2-4-1-3\" data-name=\"pantry panel container\">\n<p class=\"pantry__l\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"pantry panel label\">From your pantry</p>\n<ul class=\"chips\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"pantry item chips list\">\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-1\" data-name=\"pantry item chip\">kūmara</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-2\" data-name=\"pantry item chip\">chickpeas</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-3\" data-name=\"pantry item chip\">silverbeet</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-4\" data-name=\"pantry item chip\">garlic</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-5\" data-name=\"pantry item chip\">lemon</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-6\" data-name=\"pantry item chip\">feta</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-7\" data-name=\"pantry item chip\">olive oil</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-8\" data-name=\"pantry item chip\">smoked paprika</li>\n</ul>\n</div>\n</section>\n<section aria-labelledby=\"method-h\" data-kid=\"1-1-2-4-2\" data-name=\"method section\">\n<h2 data-kid=\"1-1-2-4-2-1\" data-name=\"method section heading\" id=\"method-h\">Method</h2>\n<ol class=\"method\" data-kid=\"1-1-2-4-2-2\" data-name=\"method steps list\">\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"step number\">01</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"step instruction text\">Heat the oven to 200 °C fan and line a large tray.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"step number\">02</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"step instruction text\">Toss the kūmara with the olive oil, smoked paprika and salt, spread it in one layer, and roast for 20 minutes until the edges darken.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-3\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-3-1\" data-name=\"step number\">03</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-3-2\" data-name=\"step instruction text\">Push the kūmara to one side of the tray, add the chickpeas and garlic to the bare side, and roast for 10 minutes more.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-4\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-4-1\" data-name=\"step number\">04</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-4-2\" data-name=\"step instruction text\">Fold the sliced silverbeet stems through and return the tray for 4 minutes; they should give when pressed with the back of a spoon.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-5\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-5-1\" data-name=\"step number\">05</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-5-2\" data-name=\"step instruction text\">Take the tray out and fold the torn leaves through in three handfuls. The residual heat wilts them without flattening them.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-6\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-6-1\" data-name=\"step number\">06</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-6-2\" data-name=\"step instruction text\">Scatter over the feta, then the lemon zest and juice. Rest 5 minutes and serve from the tray.</span></li>\n</ol>\n</section>\n</div>\n<footer class=\"docfoot\" data-kid=\"1-1-2-5\" data-name=\"recipe document footer bar\">\n<p class=\"gen\" data-kid=\"1-1-2-5-1\" data-name=\"generated timestamp text\">Generated 17 November 2026, 9:41 am</p>\n<div class=\"acts\" data-kid=\"1-1-2-5-2\" data-name=\"action buttons group\">\n<a class=\"btn btn--ghost\" data-kid=\"1-1-2-5-2-1\" data-name=\"change ingredient outline button\" href=\"#\">Change an ingredient</a>\n<a class=\"btn btn--fill\" data-kid=\"1-1-2-5-2-2\" data-name=\"save recipe call-to-action button\" href=\"#\">Save recipe</a>\n</div>\n</footer>\n</main>\n</div>\n<p class=\"key\" data-kid=\"1-2\" data-name=\"font stack key paragraph\"><em data-kid=\"1-2-1\" data-name=\"font count legend text\">3 families.</em> name <b data-kid=\"1-2-2\" data-name='font name \"Georgia\" highlight'>Georgia</b> · headnote and method <b data-kid=\"1-2-3\" data-name='font name \"Humanist\" highlight'>Humanist</b> · nav, buttons, section labels, chips, quantities, step numbers, meta, timestamp <b data-kid=\"1-2-4\" data-name='font name \"Mono\" highlight'>Mono</b></p>\n</div>\n",
