      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.938 0.060 86), oklch(0.310 0.045 78));\n    --accent-foreground: light-dark(oklch(0.320 0.065 70), oklch(0.915 0.045 86));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --veg-ink: light-dark(oklch(0.450 0.130 140), oklch(0.790 0.120 140));\n    --radius: 0.5rem;\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) + 4px);\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }\n  h2, p, ol, li { margin: 0; }\n  ol { padding: 0; list-style: none; }\n  a { color: inherit; }\n  a:focus-visible, label:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }\n\n  .section { padding: 56px 0 64px; }\n  .wrap { max-width: 1152px; margin: 0 auto; padding: 0 32px; }\n  @media (max-width: 640px) { .wrap { padding: 0 20px; } }\n\n  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .head p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .ledger { margin-top: 24px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); overflow: hidden; }\n  .cols, .row { display: grid; grid-template-columns: 176px minmax(0, 1fr) 104px 92px 150px; gap: 20px; align-items: center; padding: 0 20px; }\n  .cols { height: 34px; background: var(--secondary); border-bottom: 1px solid var(--border); }\n  .cols span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-foreground); }\n  .cols span:nth-child(3), .cols span:nth-child(4) { text-align: right; }\n\n  .row { min-height: 84px; padding-top: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }\n  .row:last-child { border-bottom: 0; }\n  .row--best { background: color-mix(in oklab, var(--accent) 46%, var(--card)); }\n  .row--starter { border-top: 1px dashed color-mix(in oklab, var(--foreground) 32%, var(--border)); }\n\n  .row__credits { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; }\n  .n { font-family: var(--font-display); font-size: 30px; font-weight: 600; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }\n  .row__tag, .row__note {\n    display: inline-flex; align-items: center; min-height: 20px; padding: 0 6px; border-radius: 3px;\n    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.09em; text-transform: uppercase; white-space: nowrap;\n  }\n  .row__tag { background: var(--accent); color: var(--accent-foreground); }\n  .row__note { color: var(--muted-foreground); padding: 0; background: none; }\n\n  .rail { position: relative; height: 18px; border-bottom: 1px solid var(--border); }\n  .rail i {\n    display: block; height: 12px; width: calc(var(--w) * 100%);\n    background-image: repeating-linear-gradient(90deg, color-mix(in oklab, var(--foreground) 60%, transparent) 0 1px, transparent 1px 5px);\n  }\n  .row--best .rail i { background-image: repeating-linear-gradient(90deg, var(--foreground) 0 1px, transparent 1px 5px); }\n\n  .row__rate { text-align: right; font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; color: var(--muted-foreground); }\n  .row__price { text-align: right; font-family: var(--font-mono); font-size: 19px; font-variant-numeric: tabular-nums; letter-spacing: -0.015em; }\n\n  .buy {\n    display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 12px;\n    border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--foreground);\n    font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap;\n  }\n  .buy:hover { border-color: var(--foreground); }\n  .buy--primary { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n  .buy--primary:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); border-color: transparent; }\n\n  .fine { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n\n  @media (max-width: 899px) {\n    .cols { display: none; }\n    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: \"credits price\" \"rail rail\" \"rate buy\"; gap: 10px 12px; min-height: 0; padding: 16px; }\n    .row__credits { grid-area: credits; flex-wrap: wrap; }\n    .row__price { grid-area: price; font-size: 17px; }\n    .rail { grid-area: rail; margin: 2px 0 4px; }\n    .row__rate { grid-area: rate; text-align: left; align-self: center; }\n    .buy { grid-area: buy; }\n    .n { font-size: 26px; }\n  }\n</style>\n<section aria-labelledby=\"credits-heading\" class=\"section\" data-kid=\"1\">\n<div class=\"wrap\" data-kid=\"1-1\">\n<div class=\"head\" data-kid=\"1-1-1\">\n<h2 data-kid=\"1-1-1-1\" id=\"credits-heading\">Credits</h2>\n<p data-kid=\"1-1-1-2\">One-time purchase. No subscription.</p>\n</div>\n<div class=\"ledger\" data-kid=\"1-1-2\">\n<div aria-hidden=\"true\" class=\"cols\" data-kid=\"1-1-2-1\">\n<span data-kid=\"1-1-2-1-1\">Credits</span><span data-kid=\"1-1-2-1-2\"></span><span data-kid=\"1-1-2-1-3\">Per credit</span><span data-kid=\"1-1-2-1-4\">Price</span><span data-kid=\"1-1-2-1-5\"></span>\n</div>\n<ol data-kid=\"1-1-2-2\">\n<li class=\"row row--best\" data-kid=\"1-1-2-2-1\">\n<div class=\"row__credits\" data-kid=\"1-1-2-2-1-1\"><span class=\"n\" data-kid=\"1-1-2-2-1-1-1\">120</span><span class=\"row__tag\" data-kid=\"1-1-2-2-1-1-2\">Best rate</span></div>\n<div aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-2-1-2\"><i data-kid=\"1-1-2-2-1-2-1\" style=\"--w:1\"></i></div>\n<p class=\"row__rate\" data-kid=\"1-1-2-2-1-3\">NZ$0.27</p>\n<p class=\"row__price\" data-kid=\"1-1-2-2-1-4\">NZ$32</p>\n<a class=\"buy\" data-kid=\"1-1-2-2-1-5\" href=\"/pantry\">Buy 120 Credits</a>\n</li>\n<li class=\"row\" data-kid=\"1-1-2-2-2\">\n<div class=\"row__credits\" data-kid=\"1-1-2-2-2-1\"><span class=\"n\" data-kid=\"1-1-2-2-2-1-1\">50</span></div>\n<div aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-2-2-2\"><i data-kid=\"1-1-2-2-2-2-1\" style=\"--w:0.417\"></i></div>\n<p class=\"row__rate\" data-kid=\"1-1-2-2-2-3\">NZ$0.32</p>\n<p class=\"row__price\" data-kid=\"1-1-2-2-2-4\">NZ$16</p>\n<a class=\"buy\" data-kid=\"1-1-2-2-2-5\" href=\"/pantry\">Buy 50 Credits</a>\n</li>\n<li class=\"row\" data-kid=\"1-1-2-2-3\">\n<div class=\"row__credits\" data-kid=\"1-1-2-2-3-1\"><span class=\"n\" data-kid=\"1-1-2-2-3-1-1\">20</span></div>\n<div aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-2-3-2\"><i data-kid=\"1-1-2-2-3-2-1\" style=\"--w:0.167\"></i></div>\n<p class=\"row__rate\" data-kid=\"1-1-2-2-3-3\">NZ$0.40</p>\n<p class=\"row__price\" data-kid=\"1-1-2-2-3-4\">NZ$8</p>\n<a class=\"buy\" data-kid=\"1-1-2-2-3-5\" href=\"/pantry\">Buy 20 Credits</a>\n</li>\n<li class=\"row row--starter\" data-kid=\"1-1-2-2-4\">\n<div class=\"row__credits\" data-kid=\"1-1-2-2-4-1\"><span class=\"n\" data-kid=\"1-1-2-2-4-1-1\">10</span><span class=\"row__note\" data-kid=\"1-1-2-2-4-1-2\">Starter pack, once only</span></div>\n<div aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-2-4-2\"><i data-kid=\"1-1-2-2-4-2-1\" style=\"--w:0.083\"></i></div>\n<p class=\"row__rate\" data-kid=\"1-1-2-2-4-3\">NZ$0.40</p>\n<p class=\"row__price\" data-kid=\"1-1-2-2-4-4\">NZ$4</p>\n<a class=\"buy buy--primary\" data-kid=\"1-1-2-2-4-5\" href=\"/pantry\">Buy Starter pack</a>\n</li>\n</ol>\n</div>\n<p class=\"fine\" data-kid=\"1-1-3\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</div>\n</section>\n",
