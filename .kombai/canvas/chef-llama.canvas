    },
    "var_c586796be4ec": {
      "type": "variant",
      "label": "Billing — purchases and credit history",
      "parentId": "var_0ccd4f014bc1",
      "themeId": null,
      "rect": {
        "x": 1053,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(hsl(38 42% 96%), hsl(30 12% 8%));\n  --surface: light-dark(hsl(40 44% 98.6%), hsl(30 10% 11%));\n  --surface-2: light-dark(hsl(36 34% 93%), hsl(30 9% 15%));\n  --ink: light-dark(hsl(28 24% 15%), hsl(36 28% 93%));\n  --ink-muted: light-dark(hsl(30 9% 38%), hsl(30 8% 66%));\n  --ink-faint: light-dark(hsl(30 7% 50%), hsl(30 7% 54%));\n  --rule: light-dark(hsl(34 24% 85%), hsl(30 8% 21%));\n  --rule-hair: light-dark(hsl(34 22% 90%), hsl(30 8% 16%));\n  --rule-strong: light-dark(hsl(32 18% 70%), hsl(30 8% 30%));\n  --accent: light-dark(hsl(30 74% 37%), hsl(34 82% 60%));\n  --accent-ink: light-dark(hsl(40 60% 98%), hsl(30 45% 9%));\n  --gift: light-dark(hsl(168 18% 43%), hsl(168 24% 54%));\n  --focus: light-dark(hsl(214 80% 42%), hsl(210 90% 64%));\n  --sans: ui-sans-serif, system-ui, sans-serif;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --serif: ui-serif, Georgia, \"Times New Roman\", serif;\n}\nbody{margin:0;background:var(--background);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\n.app h1,.app h2,.app p,.app dl,.app dd,.app dt,.app ul,.app li,.app table{margin:0}\n.app ul{padding:0;list-style:none}\n.num{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n\n.shell{display:flex;align-items:center;gap:28px;height:64px;padding:0 24px;border-bottom:1px solid var(--rule);box-sizing:border-box}\n.wordmark{font-size:17px;font-weight:700;letter-spacing:-.03em;color:var(--ink);text-decoration:none}\n.nav{display:flex;align-items:center;gap:22px;margin-left:8px}\n.nav a{font-size:13.5px;color:var(--ink-muted);text-decoration:none;padding:6px 0;border-bottom:2px solid transparent}\n.nav a[aria-current=\"page\"]{color:var(--ink);border-bottom-color:var(--accent)}\n.shell__end{margin-left:auto;display:flex;align-items:center}\n.avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--surface-2);border:1px solid var(--rule);font-size:11px;font-weight:600;color:var(--ink-muted)}\n\n.page{max-width:1232px;margin:0 auto;padding:26px 24px 56px;box-sizing:border-box;container-type:inline-size;container-name:page}\n.page__head{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.page__head h1{font-size:24px;font-weight:600;letter-spacing:-.015em;line-height:1.1}\n.asof{font-family:var(--serif);font-size:13px;color:var(--ink-faint);padding-bottom:3px}\n.page__cta{margin-left:auto;display:flex;gap:10px}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:6px;border:1px solid transparent;background:var(--accent);color:var(--accent-ink);font-family:inherit;font-size:13.5px;font-weight:600;text-decoration:none;cursor:pointer;box-sizing:border-box;white-space:nowrap}\n.btn:hover{filter:brightness(1.05)}\n.btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}\n.textlink{font-size:12.5px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-strong);padding-bottom:1px}\n.textlink:hover{border-bottom-color:var(--ink)}\n.textlink:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n\n.section{margin-top:26px}\n.section__head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}\n.section__head h2{font-size:15px;font-weight:600;letter-spacing:-.005em}\n\n.segmented{display:inline-flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden}\n.segmented button{height:34px;padding:0 12px;border:0;background:transparent;color:var(--ink-muted);font-family:inherit;font-size:12.5px;cursor:pointer}\n.segmented button + button{border-left:1px solid var(--rule)}\n.segmented button[aria-pressed=\"true\"]{background:var(--surface-2);color:var(--ink);font-weight:600}\n.segmented button:focus-visible{outline:2px solid var(--focus);outline-offset:-2px}\n\n/* balance equation + terms */\n.recon{display:flex;align-items:flex-end;gap:18px;flex-wrap:wrap;margin-top:16px;padding:16px 0 18px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.recon__cell{display:flex;flex-direction:column;gap:2px}\n.recon__k{font-size:12px;color:var(--ink-muted)}\n.recon__v{font-family:var(--mono);font-size:26px;font-weight:500;letter-spacing:-.03em;line-height:1.1}\n.recon__op{font-family:var(--mono);font-size:16px;color:var(--ink-faint);padding-bottom:4px}\n.terms{display:grid;grid-template-columns:auto 1fr;gap:6px 20px;margin-top:16px;font-size:13px;max-width:520px}\n.terms dt{color:var(--ink-muted)}\n.terms dd{color:var(--ink)}\n\n.table{width:100%;border-collapse:collapse}\n.table th{height:36px;padding:0 12px;vertical-align:middle;font-size:12px;font-weight:500;color:var(--ink-muted);text-align:left;border-bottom:1px solid var(--rule);white-space:nowrap}\n.table td{height:40px;padding:0 12px;vertical-align:middle;font-size:13.5px;border-bottom:1px solid var(--rule-hair)}\n.table th:first-child,.table td:first-child{padding-left:0}\n.table th:last-child,.table td:last-child{padding-right:0}\n.table .r{text-align:right}\n.table td.t-date{font-family:var(--serif);font-size:13.5px}\n.table__foot{display:flex;gap:10px;align-items:baseline;padding-top:12px;font-size:12.5px;color:var(--ink-muted);font-family:var(--mono)}\n.eventid{font-family:var(--mono);font-size:11.5px;color:var(--ink-faint)}\n.recipe{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-hair)}\n.recipe:hover{border-bottom-color:var(--rule-strong)}\n.type{color:var(--ink-muted)}\n.delta{font-family:var(--mono);font-weight:500}\n.delta--zero{color:var(--ink-faint);font-weight:400}\n.bal{font-family:var(--mono);color:var(--ink-muted)}\n.ledger__foot{display:flex;align-items:center;gap:14px;padding-top:14px;font-size:12.5px;color:var(--ink-muted);font-family:var(--mono)}\n.ledger__foot .textlink{margin-left:auto;font-family:var(--sans)}\n\n@container (max-width: 780px) {\n  .shell{padding:0 16px}\n  .nav{display:none}\n  .page{padding:20px 16px 44px}\n  .page__cta{margin-left:0;width:100%}\n  .page__cta .btn{flex:1}\n  .col--ref,.col--time{display:none}\n  .recon__v{font-size:22px}\n}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"billing page app root\">\n<header class=\"shell\" data-kid=\"1-1\" data-name=\"top navigation shell\">\n<a class=\"wordmark\" data-kid=\"1-1-1\" data-name=\"site wordmark link\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a data-kid=\"1-1-2-1\" data-name=\"Pantry navigation link\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" data-name=\"Recipes navigation link\" href=\"/recipes\">Recipes</a>\n<a data-kid=\"1-1-2-3\" data-name=\"Saved navigation link\" href=\"/saved\">Saved</a>\n<a data-kid=\"1-1-2-4\" data-name=\"Dashboard navigation link\" href=\"/dashboard\">Dashboard</a>\n<a aria-current=\"page\" data-kid=\"1-1-2-5\" data-name=\"Billing navigation link (current page)\" href=\"/billing\">Billing</a>\n</nav>\n<div class=\"shell__end\" data-kid=\"1-1-3\" data-name=\"right-side shell action cluster\"><span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-3-1\" data-name=\"user avatar initials badge\">AR</span></div>\n</header>\n<main class=\"page\" data-kid=\"1-2\" data-name=\"main billing page content\">\n<div class=\"page__head\" data-kid=\"1-2-1\" data-name=\"page header row with title and actions\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page title heading\">Billing</h1>\n<p class=\"asof\" data-kid=\"1-2-1-2\" data-name=\"as-of date and time annotation\">4 November 2026, 9:14 am</p>\n<div class=\"page__cta\" data-kid=\"1-2-1-3\" data-name=\"page-level call-to-action group\"><a class=\"btn\" data-kid=\"1-2-1-3-1\" data-name=\"Buy Credits call-to-action button\" href=\"/topup\">Buy Credits</a></div>\n</div>\n<section aria-labelledby=\"balance-h\" class=\"section\" data-kid=\"1-2-2\" data-name=\"credit balance summary section\">\n<div class=\"section__head\" data-kid=\"1-2-2-1\" data-name=\"section header row\"><h2 data-kid=\"1-2-2-1-1\" data-name=\"Balance section heading\" id=\"balance-h\">Balance</h2></div>\n<div class=\"recon\" data-kid=\"1-2-2-2\" data-name=\"balance equation row\">\n<div class=\"recon__cell\" data-kid=\"1-2-2-2-1\" data-name=\"purchased credits cell\"><span class=\"recon__k\" data-kid=\"1-2-2-2-1-1\" data-name=\"purchased credits label\">Purchased</span><span class=\"recon__v\" data-kid=\"1-2-2-2-1-2\" data-name=\"purchased credits numeric value\">190</span></div>\n<span aria-hidden=\"true\" class=\"recon__op\" data-kid=\"1-2-2-2-2\" data-name=\"minus operator symbol\">−</span>\n<div class=\"recon__cell\" data-kid=\"1-2-2-2-3\" data-name=\"spent credits cell\"><span class=\"recon__k\" data-kid=\"1-2-2-2-3-1\" data-name=\"spent credits label\">Spent</span><span class=\"recon__v\" data-kid=\"1-2-2-2-3-2\" data-name=\"spent credits numeric value\">47</span></div>\n<span aria-hidden=\"true\" class=\"recon__op\" data-kid=\"1-2-2-2-4\" data-name=\"equal operator symbol\">=</span>\n<div class=\"recon__cell\" data-kid=\"1-2-2-2-5\" data-name=\"remaining balance cell\"><span class=\"recon__k\" data-kid=\"1-2-2-2-5-1\" data-name=\"balance label\">Balance</span><span class=\"recon__v\" data-kid=\"1-2-2-2-5-2\" data-name=\"balance numeric value\">143</span></div>\n</div>\n<dl class=\"terms\" data-kid=\"1-2-2-3\" data-name=\"policy terms definition list\">\n<dt data-kid=\"1-2-2-3-1\" data-name=\"credits expiry term label\">Purchased Credits</dt><dd data-kid=\"1-2-2-3-2\" data-name=\"credits expiry term description\">Never expire.</dd>\n<dt data-kid=\"1-2-2-3-3\" data-name=\"free gift cooks term label\">Free gift cooks</dt><dd data-kid=\"1-2-2-3-4\" data-name=\"free gift cooks term description\">No Credits charged.</dd>\n<dt data-kid=\"1-2-2-3-5\" data-name=\"amounts currency term label\">Amounts</dt><dd data-kid=\"1-2-2-3-6\" data-name=\"amounts currency term description\">New Zealand dollars.</dd>\n</dl>\n</section>\n<section aria-labelledby=\"purchases-h\" class=\"section\" data-kid=\"1-2-3\" data-name=\"purchases history section\">\n<div class=\"section__head\" data-kid=\"1-2-3-1\" data-name=\"section header row\"><h2 data-kid=\"1-2-3-1-1\" data-name=\"Purchases section heading\" id=\"purchases-h\">Purchases</h2></div>\n<table class=\"table\" data-kid=\"1-2-3-2\" data-name=\"purchases table\" style=\"margin-top:14px\">\n<thead data-kid=\"1-2-3-2-1\" data-name=\"purchases table header\">\n<tr data-kid=\"1-2-3-2-1-1\" data-name=\"header row\">\n<th data-kid=\"1-2-3-2-1-1-1\" data-name=\"Date column header\" scope=\"col\">Date</th>\n<th class=\"r\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"Amount column header\" scope=\"col\">Amount</th>\n<th class=\"r\" data-kid=\"1-2-3-2-1-1-3\" data-name=\"Credits column header\" scope=\"col\">Credits</th>\n<th class=\"col--ref\" data-kid=\"1-2-3-2-1-1-4\" data-name=\"Event ID column header\" scope=\"col\">Event ID</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-3-2-2\" data-name=\"purchases table body\">\n<tr data-kid=\"1-2-3-2-2-1\" data-name=\"purchase row for 21 October 2026\">\n<td class=\"t-date\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"purchase date cell\">21 October 2026</td>\n<td class=\"r num\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"purchase amount cell\">NZ$32.00</td>\n<td class=\"r num\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"purchase credits cell\">120</td>\n<td class=\"col--ref\" data-kid=\"1-2-3-2-2-1-4\" data-name=\"purchase event ID cell\"><span class=\"eventid\" data-kid=\"1-2-3-2-2-1-4-1\" data-name=\"event ID monospace token\">evt_1Q9xWv2eZvKYlo2Cq4bHn7Ts</span></td>\n</tr>\n<tr data-kid=\"1-2-3-2-2-2\" data-name=\"purchase row for 2 October 2026\">\n<td class=\"t-date\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"purchase date cell\">2 October 2026</td>\n<td class=\"r num\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"purchase amount cell\">NZ$16.00</td>\n<td class=\"r num\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"purchase credits cell\">50</td>\n<td class=\"col--ref\" data-kid=\"1-2-3-2-2-2-4\" data-name=\"purchase event ID cell\"><span class=\"eventid\" data-kid=\"1-2-3-2-2-2-4-1\" data-name=\"event ID monospace token\">evt_1Q6mRd2eZvKYlo2Cx8fJk2Vb</span></td>\n</tr>\n<tr data-kid=\"1-2-3-2-2-3\" data-name=\"purchase row for 12 September 2026\">\n<td class=\"t-date\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"purchase date cell\">12 September 2026</td>\n<td class=\"r num\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"purchase amount cell\">NZ$8.00</td>\n<td class=\"r num\" data-kid=\"1-2-3-2-2-3-3\" data-name=\"purchase credits cell\">20</td>\n<td class=\"col--ref\" data-kid=\"1-2-3-2-2-3-4\" data-name=\"purchase event ID cell\"><span class=\"eventid\" data-kid=\"1-2-3-2-2-3-4-1\" data-name=\"event ID monospace token\">evt_1Q3pLc2eZvKYlo2Cm5dHg9Wn</span></td>\n</tr>\n</tbody>\n</table>\n<p class=\"table__foot\" data-kid=\"1-2-3-3\" data-name=\"purchases table footer summary\">3 purchases · NZ$56.00 · 190 Credits</p>\n</section>\n<section aria-labelledby=\"history-h\" class=\"section\" data-kid=\"1-2-4\" data-name=\"credit history section\">\n<div class=\"section__head\" data-kid=\"1-2-4-1\" data-name=\"section header row with filter controls\">\n<h2 data-kid=\"1-2-4-1-1\" data-name=\"Credit history section heading\" id=\"history-h\">Credit history</h2>\n<div aria-label=\"Filter events\" class=\"segmented\" data-kid=\"1-2-4-1-2\" data-name=\"event type segmented filter group\" role=\"group\" style=\"margin-left:auto\">\n<button aria-pressed=\"true\" data-kid=\"1-2-4-1-2-1\" data-name=\"All filter toggle button (active)\" type=\"button\">All</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-4-1-2-2\" data-name=\"Purchases filter toggle button\" type=\"button\">Purchases</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-4-1-2-3\" data-name=\"Cooks filter toggle button\" type=\"button\">Cooks</button>\n</div>\n</div>\n<table class=\"table\" data-kid=\"1-2-4-2\" data-name=\"credit history table\" style=\"margin-top:12px\">\n<thead data-kid=\"1-2-4-2-1\" data-name=\"credit history table header\">\n<tr data-kid=\"1-2-4-2-1-1\" data-name=\"header row\">\n<th class=\"col--time\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"Date column header\" scope=\"col\">Date</th>\n<th data-kid=\"1-2-4-2-1-1-2\" data-name=\"Event column header\" scope=\"col\">Event</th>\n<th class=\"col--ref\" data-kid=\"1-2-4-2-1-1-3\" data-name=\"Recipe column header\" scope=\"col\">Recipe</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-4\" data-name=\"Credits column header\" scope=\"col\">Credits</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-5\" data-name=\"Balance column header\" scope=\"col\">Balance</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-4-2-2\" data-name=\"credit history table body\">\n<tr data-kid=\"1-2-4-2-2-1\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"event timestamp cell\">3 November 2026, 7:02 pm</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-1-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-1-3-1\" data-name=\"recipe link to Kūmara and black bean hash\" href=\"/recipes/2\">Kūmara and black bean hash</a></td>\n<td class=\"r delta\" data-kid=\"1-2-4-2-2-1-4\" data-name=\"credit delta cell\">−1</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-1-5\" data-name=\"resulting balance cell\">143</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-2\" data-name=\"credit event row (Lemon rice pilaf)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"event timestamp cell\">3 November 2026, 12:31 pm</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-2-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-2-3-1\" data-name=\"recipe link to Lemon and herb rice pilaf\" href=\"/recipes/3\">Lemon and herb rice pilaf</a></td>\n<td class=\"r delta\" data-kid=\"1-2-4-2-2-2-4\" data-name=\"credit delta cell\">−1</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-2-5\" data-name=\"resulting balance cell\">144</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-3\" data-name=\"credit event row (Porridge with stewed apple)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"event timestamp cell\">3 November 2026, 7:58 am</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-3-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-3-3-1\" data-name=\"recipe link to Porridge with stewed apple\" href=\"/recipes/4\">Porridge with stewed apple</a></td>\n<td class=\"r delta\" data-kid=\"1-2-4-2-2-3-4\" data-name=\"credit delta cell\">−1</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-3-5\" data-name=\"resulting balance cell\">145</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-4\" data-name=\"credit event row (Miso eggplant)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-4-1\" data-name=\"event timestamp cell\">2 November 2026, 6:24 pm</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-4-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-4-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-4-3-1\" data-name=\"recipe link to Miso eggplant with sesame\" href=\"/recipes/5\">Miso eggplant with sesame</a></td>\n<td class=\"r delta\" data-kid=\"1-2-4-2-2-4-4\" data-name=\"credit delta cell\">−1</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-4-5\" data-name=\"resulting balance cell\">146</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-5\" data-name=\"credit event row (Spiced lentil soup)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-5-1\" data-name=\"event timestamp cell\">1 November 2026, 8:12 am</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-5-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-5-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-5-3-1\" data-name=\"recipe link to Spiced lentil soup\" href=\"/recipes/6\">Spiced lentil soup</a></td>\n<td class=\"r delta delta--zero\" data-kid=\"1-2-4-2-2-5-4\" data-name=\"zero credit delta cell\">0</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-5-5\" data-name=\"resulting balance cell\">147</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-6\" data-name=\"credit event row (Roast pumpkin galette)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-6-1\" data-name=\"event timestamp cell\">31 October 2026, 5:55 pm</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-6-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-6-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-6-3-1\" data-name=\"recipe link to Roast pumpkin and feta galette\" href=\"/recipes/7\">Roast pumpkin and feta galette</a></td>\n<td class=\"r delta\" data-kid=\"1-2-4-2-2-6-4\" data-name=\"credit delta cell\">−1</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-6-5\" data-name=\"resulting balance cell\">147</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-7\" data-name=\"credit event row (Apple and oat slice)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-7-1\" data-name=\"event timestamp cell\">31 October 2026, 8:05 am</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-7-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-7-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-7-3-1\" data-name=\"recipe link to Apple and oat breakfast slice\" href=\"/recipes/8\">Apple and oat breakfast slice</a></td>\n<td class=\"r delta delta--zero\" data-kid=\"1-2-4-2-2-7-4\" data-name=\"zero credit delta cell\">0</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-7-5\" data-name=\"resulting balance cell\">148</td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-8\" data-name=\"credit event row (Silverbeet and feta pie)\">\n<td class=\"col--time t-date\" data-kid=\"1-2-4-2-2-8-1\" data-name=\"event timestamp cell\">30 October 2026, 7:12 pm</td>\n<td class=\"type\" data-kid=\"1-2-4-2-2-8-2\" data-name=\"event type label\">Cook</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-8-3\" data-name=\"recipe reference cell\"><a class=\"recipe\" data-kid=\"1-2-4-2-2-8-3-1\" data-name=\"recipe link to Silverbeet and feta pie\" href=\"/recipes/9\">Silverbeet and feta pie</a></td>\n<td class=\"r delta\" data-kid=\"1-2-4-2-2-8-4\" data-name=\"credit delta cell\">−1</td>\n<td class=\"r bal\" data-kid=\"1-2-4-2-2-8-5\" data-name=\"resulting balance cell\">148</td>\n</tr>\n</tbody>\n</table>\n<div class=\"ledger__foot\" data-kid=\"1-2-4-3\" data-name=\"credit history footer row with pagination\">\n<span data-kid=\"1-2-4-3-1\" data-name=\"pagination status text\">Showing 8 of 73</span>\n<a class=\"textlink\" data-kid=\"1-2-4-3-2\" data-name=\"Older events pagination link\" href=\"/billing?page=2\">Older events</a>\n</div>\n</section>\n</main>\n</div>\n",
