    "var_502ac8af05fb": {
      "type": "variant",
      "label": "Card meta row — options (stress data)",
      "parentId": "var_free_1",
      "themeId": null,
      "rect": {
        "x": 24093,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  :root{\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace;\n    --background: oklch(0.972 0.012 85);\n    --card: oklch(0.992 0.004 88);\n    --accent: oklch(0.938 0.024 150);\n    --foreground: oklch(0.255 0.028 58);\n    --muted-foreground: oklch(0.505 0.020 65);\n    --border: oklch(0.895 0.012 85);\n    --veg-ink: oklch(0.440 0.090 150);\n    --radius-lg: 12px;\n  }\n  *,*::before,*::after{box-sizing:border-box}\n  body{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans);-webkit-font-smoothing:antialiased}\n  .wrap{max-width:1152px;margin:0 auto;padding:28px 20px 44px}\n\n  .opt{margin-top:26px}\n  .opt:first-child{margin-top:0}\n  .opt__name{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-foreground);margin:0;padding-bottom:8px;border-bottom:1px solid var(--border)}\n  .opts{display:grid;gap:12px;margin-top:12px}\n  @media(min-width:768px){.opts{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n  .c{display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;padding:16px 18px 18px;\n     border:1px solid color-mix(in oklab,var(--veg-ink) 38%,var(--accent));\n     border-radius:var(--radius-lg);background:var(--card)}\n  .c__rank{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:18px;line-height:1;color:var(--muted-foreground)}\n  .c__title{display:block;font-family:var(--font-display);font-size:20px;font-weight:600;line-height:1.15;letter-spacing:-.01em}\n  .c__ings{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;line-clamp:1;overflow:hidden;\n           margin-top:6px;font-size:13px;line-height:1.45;color:var(--muted-foreground)}\n\n  /* A — flex wrap, as shipped */\n  .meta-a{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:14px;padding-top:12px;\n          border-top:1px solid var(--border);font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:12px}\n\n  /* B — value over label, three equal tracks */\n  .meta-b{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 10px;margin-top:14px;padding-top:12px;\n          border-top:1px solid var(--border)}\n  .meta-b>div{display:grid;gap:3px;min-width:0}\n  .meta-b b{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:13px;font-weight:400;line-height:1.3;white-space:nowrap}\n  .meta-b i{font-family:var(--font-mono);font-style:normal;font-size:10px;line-height:1.4;letter-spacing:.12em;\n            text-transform:uppercase;color:var(--muted-foreground);white-space:nowrap}\n  @media(max-width:767.98px){\n    .meta-b{grid-template-columns:minmax(0,1fr);gap:6px}\n    .meta-b>div{grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap:12px}\n    .meta-b b{grid-column:2;grid-row:1;text-align:right}\n    .meta-b i{grid-column:1;grid-row:1}\n  }\n\n  /* C — three equal columns, units kept on one line */\n  .meta-c{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px 10px;margin-top:14px;padding-top:12px;\n          border-top:1px solid var(--border);font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:12px}\n</style>\n<div class=\"wrap\" data-kid=\"1\" data-name=\"page layout container\">\n<section class=\"opt\" data-kid=\"1-1\" data-name=\"recipe layout option A section\" data-opt=\"a\">\n<h2 class=\"opt__name\" data-kid=\"1-1-1\" data-name=\"option section heading - flex wrap label\">Flex wrap</h2>\n<ul class=\"opts\" data-kid=\"1-1-2\" data-name=\"recipe card list - flex wrap variant\" style=\"list-style:none;padding:0;\">\n<li class=\"c\" data-kid=\"1-1-2-1\" data-name=\"recipe card container\">\n<span class=\"c__rank\" data-kid=\"1-1-2-1-1\" data-name=\"recipe rank number\">1</span>\n<span data-kid=\"1-1-2-1-2\" data-name=\"recipe card content wrapper\">\n<span class=\"c__title\" data-kid=\"1-1-2-1-2-1\" data-name=\"recipe card title\">Cucumber and sesame salad</span>\n<span class=\"c__ings\" data-kid=\"1-1-2-1-2-2\" data-name=\"recipe ingredients text\">cucumber, rice vinegar, sesame, chilli</span>\n<span class=\"meta-a\" data-kid=\"1-1-2-1-2-3\" data-name=\"recipe meta stats row - flex wrap\"><span data-kid=\"1-1-2-1-2-3-1\" data-name=\"recipe cook time stat\">5 min</span><span data-kid=\"1-1-2-1-2-3-2\" data-name=\"recipe calorie stat\">90 kcal a serving</span><span data-kid=\"1-1-2-1-2-3-3\" data-name=\"recipe save count stat\">1,204 saves</span></span>\n</span>\n</li>\n<li class=\"c\" data-kid=\"1-1-2-2\" data-name=\"recipe card container\">\n<span class=\"c__rank\" data-kid=\"1-1-2-2-1\" data-name=\"recipe rank number\">2</span>\n<span data-kid=\"1-1-2-2-2\" data-name=\"recipe card content wrapper\">\n<span class=\"c__title\" data-kid=\"1-1-2-2-2-1\" data-name=\"recipe card title\">Slow borlotti with sage</span>\n<span class=\"c__ings\" data-kid=\"1-1-2-2-2-2\" data-name=\"recipe ingredients text\">borlotti beans, sage, tomato, olive oil</span>\n<span class=\"meta-a\" data-kid=\"1-1-2-2-2-3\" data-name=\"recipe meta stats row - flex wrap\"><span data-kid=\"1-1-2-2-2-3-1\" data-name=\"recipe cook time stat\">2 h 30 min</span><span data-kid=\"1-1-2-2-2-3-2\" data-name=\"recipe calorie stat\">1,180 kcal a serving</span><span data-kid=\"1-1-2-2-2-3-3\" data-name=\"recipe save count stat\">9 saves</span></span>\n</span>\n</li>\n<li class=\"c\" data-kid=\"1-1-2-3\" data-name=\"recipe card container\">\n<span class=\"c__rank\" data-kid=\"1-1-2-3-1\" data-name=\"recipe rank number\">3</span>\n<span data-kid=\"1-1-2-3-2\" data-name=\"recipe card content wrapper\">\n<span class=\"c__title\" data-kid=\"1-1-2-3-2-1\" data-name=\"recipe card title\">Baked potato with chard</span>\n<span class=\"c__ings\" data-kid=\"1-1-2-3-2-2\" data-name=\"recipe ingredients text\">potato, cha