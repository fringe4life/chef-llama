      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.938 0.060 86), oklch(0.310 0.045 78));\n    --accent-foreground: light-dark(oklch(0.320 0.065 70), oklch(0.915 0.045 86));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --veg-ink: light-dark(oklch(0.450 0.130 140), oklch(0.790 0.120 140));\n    --radius: 0.5rem;\n    --radius-sm: 4px;\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) + 4px);\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }\n  h2, p, ol, li { margin: 0; padding: 0; }\n  ol { list-style: none; }\n  a { color: inherit; }\n\n  .packs { padding: 64px 0 72px; }\n  .wrap { max-width: 1152px; margin: 0 auto; padding: 0 32px; }\n  @media (max-width: 640px) { .wrap { padding: 0 20px; } }\n\n  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .head p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .grid { margin-top: 24px; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }\n  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }\n\n  .pack {\n    position: relative; display: flex; flex-direction: column;\n    padding: 18px 20px 20px 32px;\n    border: 1px solid var(--border); border-radius: var(--radius-lg);\n    background: var(--card); overflow: hidden;\n  }\n  .rail {\n    position: absolute; left: 0; top: 0; bottom: 0; width: 16px;\n    background: var(--secondary);\n    border-right: 1px solid var(--border);\n  }\n  .rail i {\n    position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--f) * 100%);\n    background: linear-gradient(to top, color-mix(in oklab, var(--primary) 86%, var(--foreground)), var(--primary));\n  }\n  .pack__head { display: flex; justify-content: flex-start; min-height: 26px; }\n  .flag {\n    display: inline-flex; align-items: center; min-height: 22px; padding: 0 8px;\n    border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-foreground);\n    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;\n  }\n  .price { margin-top: 12px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 30px; line-height: 1; letter-spacing: -0.03em; }\n  .credits { margin-top: 6px; font-size: 15px; font-weight: 600; }\n  .rate { margin-top: 4px; margin-bottom: 18px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 11px; color: var(--muted-foreground); }\n  .buy {\n    margin-top: auto; display: inline-flex; align-items: center; justify-content: center;\n    min-height: 40px; padding: 0 12px; border: 1px solid var(--border); border-radius: var(--radius-md);\n    color: var(--foreground); font-size: 13px; font-weight: 600; text-decoration: none;\n  }\n  .buy:hover { border-color: var(--foreground); }\n\n  .pack--starter { border-color: color-mix(in oklab, var(--veg-ink) 40%, var(--border)); }\n  .pack--starter .buy { background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }\n  .pack--best { border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n  .pack--best .rail { border-right-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n\n  .fine { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n</style>\n<section aria-labelledby=\"credits-heading\" class=\"packs\" data-kid=\"1\" data-name=\"credits pricing section\" id=\"credits\">\n<div class=\"wrap\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n<div class=\"head\" data-kid=\"1-1-1\" data-name=\"section header row\">\n<h2 data-kid=\"1-1-1-1\" data-name=\"section heading title\" id=\"credits-heading\">Credits</h2>\n<p data-kid=\"1-1-1-2\" data-name=\"section subtitle note\">One-time purchase. No subscription.</p>\n</div>\n<ol class=\"grid\" data-kid=\"1-1-2\" data-name=\"pricing cards grid\">\n<li class=\"pack pack--starter\" data-kid=\"1-1-2-1\" data-name=\"starter pricing card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-1-1\" data-name=\"pricing card flag container\"><span class=\"flag\" data-kid=\"1-1-2-1-1-1\" data-name=\"starter badge label\">Starter pack, once only</span></div>\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-1-2\" data-name=\"vertical value rail\"><i data-kid=\"1-1-2-1-2-1\" data-name=\"rail fill indicator bar\" style=\"--f:0.29\"></i></span>\n<p class=\"price\" data-kid=\"1-1-2-1-3\" data-name=\"card price amount\">NZ$4</p>\n<p class=\"credits\" data-kid=\"1-1-2-1-4\" data-name=\"card credit quantity\">10 Credits</p>\n<p class=\"rate\" data-kid=\"1-1-2-1-5\" data-name=\"card per-credit unit rate\">NZ$0.40 per Credit</p>\n<a class=\"buy\" data-kid=\"1-1-2-1-6\" data-name=\"purchase call-to-action link\" href=\"/pantry\">Buy Starter pack</a>\n</li>\n<li class=\"pack\" data-kid=\"1-1-2-2\" data-name=\"20 credit pricing card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-2-1\" data-name=\"pricing card flag container\"></div>\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-2-2\" data-name=\"vertical value rail\"><i data-kid=\"1-1-2-2-2-1\" data-name=\"rail fill indicator bar\" style=\"--f:0.41\"></i></span>\n<p class=\"price\" data-kid=\"1-1-2-2-3\" data-name=\"card price amount\">NZ$8</p>\n<p class=\"credits\" data-kid=\"1-1-2-2-4\" data-name=\"card credit quantity\">20 Credits</p>\n<p class=\"rate\" data-kid=\"1-1-2-2-5\" data-name=\"card per-credit unit rate\">NZ$0.40 per Credit</p>\n<a class=\"buy\" data-kid=\"1-1-2-2-6\" data-name=\"purchase call-to-action link\" href=\"/pantry\">Buy 20 Credits</a>\n</li>\n<li class=\"pack\" data-kid=\"1-1-2-3\" data-name=\"50 credit pricing card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-3-1\" data-name=\"pricing card flag container\"></div>\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-3-2\" data-name=\"vertical value rail\"><i data-kid=\"1-1-2-3-2-1\" data-name=\"rail fill indicator bar\" style=\"--f:0.65\"></i></span>\n<p class=\"price\" data-kid=\"1-1-2-3-3\" data-name=\"card price amount\">NZ$16</p>\n<p class=\"credits\" data-kid=\"1-1-2-3-4\" data-name=\"card credit quantity\">50 Credits</p>\n<p class=\"rate\" data-kid=\"1-1-2-3-5\" data-name=\"card per-credit unit rate\">NZ$0.32 per Credit</p>\n<a class=\"buy\" data-kid=\"1-1-2-3-6\" data-name=\"purchase call-to-action link\" href=\"/pantry\">Buy 50 Credits</a>\n</li>\n<li class=\"pack pack--best\" data-kid=\"1-1-2-4\" data-name=\"best value pricing card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-4-1\" data-name=\"pricing card flag container\"><span class=\"flag\" data-kid=\"1-1-2-4-1-1\" data-name=\"best rate badge label\">Best rate</span></div>\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-1-2-4-2\" data-name=\"vertical value rail\"><i data-kid=\"1-1-2-4-2-1\" data-name=\"rail fill indicator bar\" style=\"--f:1\"></i></span>\n<p class=\"price\" data-kid=\"1-1-2-4-3\" data-name=\"card price amount\">NZ$32</p>\n<p class=\"credits\" data-kid=\"1-1-2-4-4\" data-name=\"card credit quantity\">120 Credits</p>\n<p class=\"rate\" data-kid=\"1-1-2-4-5\" data-name=\"card per-credit unit rate\">NZ$0.27 per Credit</p>\n<a class=\"buy\" data-kid=\"1-1-2-4-6\" data-name=\"purchase call-to-action link\" href=\"/pantry\">Buy 120 Credits</a>\n</li>\n</ol>\n<p class=\"fine\" data-kid=\"1-1-3\" data-name=\"footer fine-print note\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</div>\n</section>",
