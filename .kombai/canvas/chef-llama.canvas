      },
      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --rule-strong:oklch(0.800 0.036 62);\n  --accent:oklch(0.505 0.180 32);\n  --accent-ink:oklch(0.990 0.010 90);\n  --font-ui:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n  --font-hand:\"Segoe Print\",\"Bradley Hand\",Chilanka,TSCu_Comic,casual,cursive;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-ui);font-size:14px;line-height:1.45}\n.sheet{padding:36px 40px 64px}\n\n.plate{background:var(--card);border:1px solid var(--rule);border-radius:12px;overflow:hidden}\n.bar{display:flex;align-items:center;gap:26px;height:60px;padding:0 44px;border-bottom:1px solid var(--rule-hair)}\n.wordmark{font-family:var(--font-name);font-size:17.5px;font-weight:700;letter-spacing:-.02em}\n.nav{display:flex;gap:20px;margin-left:6px}\n.nav a{font-family:var(--font-ui);font-size:13px;color:var(--ink-muted);text-decoration:none;padding:4px 0}\n.nav a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--accent)}\n.av{margin-left:auto;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;border:1px solid var(--rule);background:var(--tint);font-size:10.5px;font-weight:600;color:var(--ink-muted)}\n\n.doc{padding:34px 44px 40px}\n.dish{font-family:var(--font-name);font-weight:400;font-size:44px;line-height:1.04;letter-spacing:-.015em;margin:0;max-width:19ch}\n.note{font-family:var(--font-name);font-style:italic;font-size:16.5px;line-height:1.6;color:var(--ink-muted);margin:16px 0 0;max-width:62ch}\n\n.meta{display:grid;grid-template-columns:repeat(6,minmax(0,auto));justify-content:start;column-gap:44px;margin:26px 0 0;padding:15px 0 16px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.meta dt{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0}\n.meta dd{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:14.5px;margin:5px 0 0}\n\n.body{display:grid;grid-template-columns:294px minmax(0,1fr);column-gap:52px;margin-top:34px}\nh2{font-family:var(--font-ui);font-size:14.5px;font-weight:600;letter-spacing:-.005em;margin:0 0 4px}\n\n.ings{list-style:none;margin:0;padding:0}\n.ing{display:grid;grid-template-columns:62px minmax(0,1fr);column-gap:14px;padding:9px 0 10px;border-bottom:1px solid var(--rule-hair)}\n.ing:first-child{border-top:1px solid var(--rule-hair)}\n.ing__q{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:13.5px;line-height:1.5}\n.ing__i{font-family:var(--font-read);font-size:15.5px;line-height:1.5}\n\n.pantry{margin-top:24px;background:var(--tint);border-radius:6px;padding:13px 14px 15px}\n.pantry__l{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0 0 10px}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}\n.chip{font-family:var(--font-ui);font-size:11.5px;line-height:1;padding:6px 8px;border:1px dashed var(--rule-strong);border-radius:4px;background:var(--paper)}\n\n.method{margin:0;padding:0;list-style:none}\n.step{display:grid;grid-template-columns:34px minmax(0,1fr);column-gap:18px;padding:15px 0 16px;border-top:1px solid var(--rule-hair)}\n.step:last-child{border-bottom:1px solid var(--rule-hair)}\n.step__n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12px;line-height:2.2;color:var(--ink-muted)}\n.step__t{font-family:var(--font-hand);font-size:17px;line-height:1.78;word-spacing:.06em;max-width:34em}\n\n.docfoot{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:30px;padding-top:20px;border-top:1px solid var(--rule)}\n.gen{font-family:var(--font-fig);font-size:11px;color:var(--ink-muted);margin:0}\n.acts{display:flex;gap:10px}\n.btn{display:inline-flex;align-items:center;height:38px;padding:0 18px;border-radius:6px;border:1px solid transparent;font-family:var(--font-ui);font-size:13.5px;font-weight:600;text-decoration:none;white-space:nowrap}\n.btn--fill{background:var(--accent);color:var(--accent-ink)}\n.btn--ghost{border-color:var(--rule-strong);color:var(--ink)}\n\n.key{display:flex;flex-wrap:wrap;gap:4px 14px;margin:16px 2px 0;font-family:var(--font-fig);font-size:10px;line-height:1.6;color:var(--ink-muted)}\n.key b{font-weight:400;color:var(--ink)}\n\n/* analysis */\n.lands{margin-top:36px;padding-top:26px;border-top:1px solid var(--ink)}\n.lands h2{font-size:15px;margin:0 0 14px}\ntable{width:100%;border-collapse:collapse;table-layout:fixed}\nth{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);text-align:left;font-weight:400;padding:0 16px 9px 0;border-bottom:1px solid var(--rule)}\ntd{font-size:13px;padding:12px 16px 12px 0;border-bottom:1px solid var(--rule-hair);vertical-align:baseline;line-height:1.5}\ntd.n{font-family:var(--font-fig);font-size:12.5px;font-variant-numeric:tabular-nums}\nth:first-child,td:first-child{width:190px}\nth:nth-child(2),td:nth-child(2){width:250px}\nth:nth-child(3),td:nth-child(3){width:130px}\ntd:last-child,th:last-child{padding-right:0}\n\n.verdict{display:flex;gap:32px;align-items:baseline;margin:34px 0 0;padding-top:20px;border-top:1px solid var(--rule)}\n.verdict dt{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted)}\n.verdict dd{font-family:var(--font-read);font-size:16px;margin:6px 0 0;max-width:44em}\n</style>\n<div class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"plate\" data-kid=\"1-1\" data-name=\"recipe card container\">\n<header class=\"bar\" data-kid=\"1-1-1\" data-name=\"top app bar\">\n<span class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"brand wordmark\">Chef Llama</span>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to pantry\" href=\"#\">Pantry</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"current page nav link\" href=\"#\">Recipes</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to saved items\" href=\"#\">Saved</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link to dashboard\" href=\"#\">Dashboard</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link to billing\" href=\"#\">Billing</a>\n</nav>\n<span aria-hidden=\"true\" class=\"av\" data-kid=\"1-1-1-3\" data-name=\"user avatar initials\">AR</span>\n</header>\n<main class=\"doc\" data-kid=\"1-1-2\" data-name=\"recipe document main\">\n<h1 class=\"dish\" data-kid=\"1-1-2-1\" data-name=\"recipe title heading\">Kūmara, chickpea and silverbeet traybake</h1>\n<p class=\"note\" data-kid=\"1-1-2-2\" data-name=\"recipe headnote\">One tray and a 200 °C oven. The silverbeet goes in at the end, in two goes, so the stems cook through and the leaves only wilt.</p>\n<dl class=\"meta\" data-kid=\"1-1-2-3\" data-name=\"recipe metadata grid\">\n<div data-kid=\"1-1-2-3-1\" data-name=\"total time metadata cell\"><dt data-kid=\"1-1-2-3-1-1\" data-name=\"total time label\">Total</dt><dd data-kid=\"1-1-2-3-1-2\" data-name=\"total time value\">40 min</dd></div>\n<div data-kid=\"1-1-2-3-2\" data-name=\"prep time metadata cell\"><dt data-kid=\"1-1-2-3-2-1\" data-name=\"prep time label\">Prep</dt><dd data-kid=\"1-1-2-3-2-2\" data-name=\"prep time value\">15 min</dd></div>\n<div data-kid=\"1-1-2-3-3\" data-name=\"per serving calorie metadata cell\"><dt data-kid=\"1-1-2-3-3-1\" data-name=\"per serving label\">Per serving</dt><dd data-kid=\"1-1-2-3-3-2\" data-name=\"calorie value\">620 kcal</dd></div>\n<div data-kid=\"1-1-2-3-4\" data-name=\"serves metadata cell\"><dt data-kid=\"1-1-2-3-4-1\" data-name=\"serves label\">Serves</dt><dd data-kid=\"1-1-2-3-4-2\" data-name=\"serves count value\">4</dd></div>\n<div data-kid=\"1-1-2-3-5\" data-name=\"from pantry count metadata cell\"><dt data-kid=\"1-1-2-3-5-1\" data-name=\"from pantry label\">From pantry</dt><dd data-kid=\"1-1-2-3-5-2\" data-name=\"pantry item count value\">8 items</dd></div>\n<div data-kid=\"1-1-2-3-6\" data-name=\"cost metadata cell\"><dt data-kid=\"1-1-2-3-6-1\" data-name=\"cost label\">Cost</dt><dd data-kid=\"1-1-2-3-6-2\" data-name=\"cost value\">1 Credit</dd></div>\n</dl>\n<div class=\"body\" data-kid=\"1-1-2-4\" data-name=\"recipe body two-column layout\">\n<section aria-labelledby=\"ings-h\" data-kid=\"1-1-2-4-1\" data-name=\"ingredients section\">\n<h2 data-kid=\"1-1-2-4-1-1\" data-name=\"ingredients section heading\" id=\"ings-h\">Ingredients</h2>\n<ul class=\"ings\" data-kid=\"1-1-2-4-1-2\" data-name=\"ingredients list\">\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-1-1\" data-name=\"ingredient quantity\">800 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-1-2\" data-name=\"ingredient name\">kūmara, cut into 3 cm chunks</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-2-1\" data-name=\"ingredient quantity\">400 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-2-2\" data-name=\"ingredient name\">chickpeas, drained</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-3\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-3-1\" data-name=\"ingredient quantity\">2 tbsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-3-2\" data-name=\"ingredient name\">olive oil</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-4\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-4-1\" data-name=\"ingredient quantity\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-4-2\" data-name=\"ingredient name\">smoked paprika</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-5\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-5-1\" data-name=\"ingredient quantity\">3</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-5-2\" data-name=\"ingredient name\">cloves garlic, sliced</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-6\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-6-1\" data-name=\"ingredient quantity\">1 bunch</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-6-2\" data-name=\"ingredient name\">silverbeet, stems sliced, leaves torn</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-7\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-7-1\" data-name=\"ingredient quantity\">1</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-7-2\" data-name=\"ingredient name\">lemon, zest and juice</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-8\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-8-1\" data-name=\"ingredient quantity\">120 g</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-8-2\" data-name=\"ingredient name\">feta, crumbled</span></li>\n<li class=\"ing\" data-kid=\"1-1-2-4-1-2-9\" data-name=\"ingredient row\"><span class=\"ing__q\" data-kid=\"1-1-2-4-1-2-9-1\" data-name=\"ingredient quantity\">1 tsp</span><span class=\"ing__i\" data-kid=\"1-1-2-4-1-2-9-2\" data-name=\"ingredient name\">flaky salt</span></li>\n</ul>\n<div class=\"pantry\" data-kid=\"1-1-2-4-1-3\" data-name=\"pantry summary container\">\n<p class=\"pantry__l\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"pantry section label\">From your pantry</p>\n<ul class=\"chips\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"pantry items chip list\">\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-1\" data-name=\"pantry item chip\">kūmara</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-2\" data-name=\"pantry item chip\">chickpeas</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-3\" data-name=\"pantry item chip\">silverbeet</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-4\" data-name=\"pantry item chip\">garlic</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-5\" data-name=\"pantry item chip\">lemon</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-6\" data-name=\"pantry item chip\">feta</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-7\" data-name=\"pantry item chip\">olive oil</li>\n<li class=\"chip\" data-kid=\"1-1-2-4-1-3-2-8\" data-name=\"pantry item chip\">smoked paprika</li>\n</ul>\n</div>\n</section>\n<section aria-labelledby=\"method-h\" data-kid=\"1-1-2-4-2\" data-name=\"method section\">\n<h2 data-kid=\"1-1-2-4-2-1\" data-name=\"method section heading\" id=\"method-h\">Method</h2>\n<ol class=\"method\" data-kid=\"1-1-2-4-2-2\" data-name=\"method steps list\">\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"step number\">01</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"step instruction text\">Heat the oven to 200 °C fan and line a large tray.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"step number\">02</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"step instruction text\">Toss the kūmara with the olive oil, smoked paprika and salt, spread it in one layer, and roast for 20 minutes until the edges darken.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-3\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-3-1\" data-name=\"step number\">03</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-3-2\" data-name=\"step instruction text\">Push the kūmara to one side of the tray, add the chickpeas and garlic to the bare side, and roast for 10 minutes more.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-4\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-4-1\" data-name=\"step number\">04</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-4-2\" data-name=\"step instruction text\">Fold the sliced silverbeet stems through and return the tray for 4 minutes; they should give when pressed with the back of a spoon.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-5\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-5-1\" data-name=\"step number\">05</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-5-2\" data-name=\"step instruction text\">Take the tray out and fold the torn leaves through in three handfuls. The residual heat wilts them without flattening them.</span></li>\n<li class=\"step\" data-kid=\"1-1-2-4-2-2-6\" data-name=\"method step row\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-1-2-4-2-2-6-1\" data-name=\"step number\">06</span><span class=\"step__t\" data-kid=\"1-1-2-4-2-2-6-2\" data-name=\"step instruction text\">Scatter over the feta, then the lemon zest and juice. Rest 5 minutes and serve from the tray.</span></li>\n</ol>\n</section>\n</div>\n<footer class=\"docfoot\" data-kid=\"1-1-2-5\" data-name=\"document footer bar\">\n<p class=\"gen\" data-kid=\"1-1-2-5-1\" data-name=\"generation timestamp note\">Generated 17 November 2026, 9:41 am</p>\n<div class=\"acts\" data-kid=\"1-1-2-5-2\" data-name=\"footer actions row\">\n<a class=\"btn btn--ghost\" data-kid=\"1-1-2-5-2-1\" data-name=\"change ingredient action button\" href=\"#\">Change an ingredient</a>\n<a class=\"btn btn--fill\" data-kid=\"1-1-2-5-2-2\" data-name=\"save recipe action button\" href=\"#\">Save recipe</a>\n</div>\n</footer>\n</main>\n</div>\n<p class=\"key\" data-kid=\"1-2\" data-name=\"typography key legend\">\n<span data-kid=\"1-2-1\" data-name=\"font key entry\">dish name <b data-kid=\"1-2-1-1\" data-name=\"font name value\">Georgia 400</b></span>\n<span data-kid=\"1-2-2\" data-name=\"font key entry\">headnote <b data-kid=\"1-2-2-1\" data-name=\"font name value\">Georgia italic</b></span>\n<span data-kid=\"1-2-3\" data-name=\"font key entry\">ingredient <b data-kid=\"1-2-3-1\" data-name=\"font name value\">Humanist</b></span>\n<span data-kid=\"1-2-4\" data-name=\"font key entry\">quantity <b data-kid=\"1-2-4-1\" data-name=\"font name value\">Mono</b></span>\n<span data-kid=\"1-2-5\" data-name=\"font key entry\">step number <b data-kid=\"1-2-5-1\" data-name=\"font name value\">Mono</b></span>\n<span data-kid=\"1-2-6\" data-name=\"font key entry\">step text <b data-kid=\"1-2-6-1\" data-name=\"font name value\">Handwritten</b></span>\n<span data-kid=\"1-2-7\" data-name=\"font key entry\">meta figures <b data-kid=\"1-2-7-1\" data-name=\"font name value\">Mono</b></span>\n<span data-kid=\"1-2-8\" data-name=\"font key entry\">tags <b data-kid=\"1-2-8-1\" data-name=\"font name value\">System UI</b></span>\n<span data-kid=\"1-2-9\" data-name=\"font key entry\">actions <b data-kid=\"1-2-9-1\" data-name=\"font name value\">System UI 600</b></span>\n</p>\n<section aria-labelledby=\"lands-h\" class=\"lands\" data-kid=\"1-3\" data-name=\"font platform analysis section\">\n<h2 data-kid=\"1-3-1\" data-name=\"font platform analysis heading\" id=\"lands-h\">Where the chain lands</h2>\n<table data-kid=\"1-3-2\" data-name=\"platform font table\">\n<thead data-kid=\"1-3-2-1\" data-name=\"table header row\">\n<tr data-kid=\"1-3-2-1-1\" data-name=\"table header row\"><th data-kid=\"1-3-2-1-1-1\" data-name=\"platform column header\" scope=\"col\">Platform</th><th data-kid=\"1-3-2-1-1-2\" data-name=\"font face column header\" scope=\"col\">Face</th><th data-kid=\"1-3-2-1-1-3\" data-name=\"weights column header\" scope=\"col\">Weights</th><th data-kid=\"1-3-2-1-1-4\" data-name=\"result column header\" scope=\"col\">Result</th></tr>\n</thead>\n<tbody data-kid=\"1-3-2-2\" data-name=\"table body\">\n<tr data-kid=\"1-3-2-2-1\" data-name=\"Windows platform row\">\n<td data-kid=\"1-3-2-2-1-1\" data-name=\"platform name cell\">Windows 10, 11</td>\n<td class=\"n\" data-kid=\"1-3-2-2-1-2\" data-name=\"font face cell\">Segoe Print</td>\n<td class=\"n\" data-kid=\"1-3-2-2-1-3\" data-name=\"weights cell\">400 · 700</td>\n<td data-kid=\"1-3-2-2-1-4\" data-name=\"result note cell\">Handwriting at both weights. The only platform with a real 400.</td>\n</tr>\n<tr data-kid=\"1-3-2-2-2\" data-name=\"macOS platform row\">\n<td data-kid=\"1-3-2-2-2-1\" data-name=\"platform name cell\">macOS, iOS</td>\n<td class=\"n\" data-kid=\"1-3-2-2-2-2\" data-name=\"font face cell\">Bradley Hand</td>\n<td class=\"n\" data-kid=\"1-3-2-2-2-3\" data-name=\"weights cell\">700</td>\n<td data-kid=\"1-3-2-2-2-4\" data-name=\"result note cell\">Bold only, so every method line renders at 700.</td>\n</tr>\n<tr data-kid=\"1-3-2-2-3\" data-name=\"Android platform row\">\n<td data-kid=\"1-3-2-2-3-1\" data-name=\"platform name cell\">Android</td>\n<td class=\"n\" data-kid=\"1-3-2-2-3-2\" data-name=\"font face cell\">Coming Soon</td>\n<td class=\"n\" data-kid=\"1-3-2-2-3-3\" data-name=\"weights cell\">400</td>\n<td data-kid=\"1-3-2-2-3-4\" data-name=\"result note cell\">A rounded comic face, reached through the <span class=\"n\" data-kid=\"1-3-2-2-3-4-1\" data-name=\"font alias mention\">casual</span> alias. No bold.</td>\n</tr>\n<tr data-kid=\"1-3-2-2-4\" data-name=\"Linux platform row\">\n<td data-kid=\"1-3-2-2-4-1\" data-name=\"platform name cell\">Linux</td>\n<td class=\"n\" data-kid=\"1-3-2-2-4-2\" data-name=\"font face cell\">none of the four</td>\n<td class=\"n\" data-kid=\"1-3-2-2-4-3\" data-name=\"weights cell\">—</td>\n<td data-kid=\"1-3-2-2-4-4\" data-name=\"result note cell\">The names resolve to the default sans, so the method renders as plain text.</td>\n</tr>\n<tr data-kid=\"1-3-2-2-5\" data-name=\"fallback platform row\">\n<td data-kid=\"1-3-2-2-5-1\" data-name=\"platform name cell\">No named face installed</td>\n<td class=\"n\" data-kid=\"1-3-2-2-5-2\" data-name=\"font face cell\">cursive</td>\n<td class=\"n\" data-kid=\"1-3-2-2-5-3\" data-name=\"weights cell\">—</td>\n<td data-kid=\"1-3-2-2-5-4\" data-name=\"result note cell\">Whatever the engine maps that generic to. Not a handwriting face, and not the same face twice.</td>\n</tr>\n</tbody>\n</table>\n</section>\n<dl class=\"verdict\" data-kid=\"1-4\" data-name=\"proposal verdict definition list\">\n<dt data-kid=\"1-4-1\" data-name=\"proposed label\">Proposed</dt>\n<dd data-kid=\"1-4-2\" data-name=\"proposal statement\">The method stays in the humanist face. No other role takes the handwritten stack.</dd>\n</dl>\n</div>\n",
      "comments": [],
      "created": "2026-11-17T21:34:47.355065+00:00",
      "modified": "2026-11-17T21:37:25.788336+00:00",
      "id": "var_fd1d9c7bb166",
      "contentHeight": 1684
    },
    "var_9b09739655ed": {
      "type": "variant",
      "label": "Dashboard — every aligned figure in mono",
      "parentId": "var_fd1d9c7bb166",
      "themeId": null,
      "rect": {
        "x": 42033,
        "y": 0,
        "w": 1024,
        "h": 0
      },
      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --rule-strong:oklch(0.800 0.036 62);\n  --grid:oklch(0.925 0.026 76);\n  --accent:oklch(0.505 0.180 32);\n  --accent-ink:oklch(0.990 0.010 90);\n  --veg:oklch(0.600 0.155 138);\n  --meat:oklch(0.460 0.165 25);\n  --rim:oklch(0.640 0.030 70);\n  --font-ui:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-ui);font-size:13.5px;line-height:1.45}\n.mono{font-family:var(--font-fig);font-variant-numeric:tabular-nums;letter-spacing:-.01em}\n.sheet{padding:32px}\n\n.plate{background:var(--card);border:1px solid var(--rule);border-radius:12px;overflow:hidden}\n.bar{display:flex;align-items:center;gap:24px;height:56px;padding:0 32px;border-bottom:1px solid var(--rule-hair)}\n.wordmark{font-family:var(--font-name);font-size:16.5px;font-weight:700;letter-spacing:-.02em}\n.nav{display:flex;gap:18px;margin-left:4px}\n.nav a{font-size:12.5px;color:var(--ink-muted);text-decoration:none;padding:4px 0}\n.nav a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--accent)}\n.av{margin-left:auto;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;border:1px solid var(--rule);background:var(--tint);font-size:10px;font-weight:600;color:var(--ink-muted)}\n\n.page{padding:24px 32px 30px}\n\n.head{display:flex;align-items:baseline;gap:14px}\n.head h1{font-size:22px;font-weight:600;letter-spacing:-.015em;margin:0}\n.asof{font-family:var(--font-fig);font-size:12px;color:var(--ink-faint);margin:0}\n.head .btn{margin-left:auto}\n.btn{display:inline-flex;align-items:center;justify-content:center;height:34px;padding:0 14px;border-radius:6px;border:1px solid transparent;font-family:var(--font-ui);font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap}\n.btn--ghost{border-color:var(--rule-strong);color:var(--ink)}\n.btn--fill{background:var(--accent);color:var(--accent-ink)}\n.tlink{font-family:var(--font-ui);font-size:12px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-strong);padding-bottom:1px}\n\n/* account band */\n.band{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);margin-top:18px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.cell{padding:16px 22px 17px 0}\n.cell + .cell{border-left:1px solid var(--rule);padding-left:22px;display:flex;align-items:center;justify-content:space-between;gap:18px}\n.lbl{font-size:11.5px;color:var(--ink-muted);margin:0}\n.val{display:flex;align-items:baseline;gap:7px;margin:3px 0 0}\n.val b{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:33px;font-weight:400;line-height:1.05;letter-spacing:-.02em}\n.val span{font-size:12.5px;color:var(--ink-muted)}\n.note{font-size:12px;color:var(--ink-faint);margin:5px 0 0}\n.state{display:flex;align-items:baseline;gap:7px;font-size:16px;font-weight:600;letter-spacing:-.01em;margin:3px 0 0}\n.state i{width:7px;height:7px;border-radius:50%;background:var(--veg);transform:translateY(-2px)}\n.state b{font-family:var(--font-fig);font-size:20px;font-weight:400}\n\n/* sections */\n.section{margin-top:24px}\n.shead{display:flex;align-items:center;gap:14px}\n.shead h2{font-size:14.5px;font-weight:600;margin:0}\n.seg{margin-left:auto;display:inline-flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden}\n.seg span{font-size:12px;padding:7px 11px;color:var(--ink-muted)}\n.seg span + span{border-left:1px solid var(--rule)}\n.seg span[aria-pressed]{background:var(--tint);color:var(--ink);font-weight:600}\n.period{font-family:var(--font-fig);font-size:11.5px;color:var(--ink-faint);margin:5px 0 0}\n\n.summary{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:13px;padding-bottom:12px;border-bottom:1px solid var(--rule-hair)}\n.stats{display:flex;align-items:baseline;gap:20px;margin:0;padding:0;list-style:none}\n.stats li{display:flex;align-items:baseline;gap:6px}\n.stats b{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:16px;font-weight:400}\n.stats span{font-size:12px;color:var(--ink-muted)}\n.stats em{font-style:normal;font-family:var(--font-fig);font-size:12px;color:var(--ink-muted)}\n.legend{display:flex;gap:15px;margin:0;padding:0;list-style:none;font-size:11.5px;color:var(--ink-muted)}\n.legend li{display:inline-flex;align-items:center;gap:6px}\n.sw{width:9px;height:9px;border-radius:1px;display:inline-block}\n.sw--g{background:var(--veg)}\n.sw--c{background:var(--meat)}\n.sw--p{background:linear-gradient(to top,color-mix(in oklab,var(--veg) 32%,var(--paper)) 0 46%,color-mix(in oklab,var(--meat) 32%,var(--paper)) 46% 100%);border:1px solid var(--rim)}\n\n/* plot */\n.plot{display:grid;grid-template-columns:24px minmax(0,1fr);column-gap:9px;margin-top:18px;padding-bottom:30px}\n.plot__y{position:relative;height:168px}\n.plot__y span{position:absolute;right:0;bottom:calc(var(--t)/var(--max)*100%);transform:translateY(50%);font-family:var(--font-fig);font-size:11px;color:var(--ink-muted)}\n.bars{position:relative;height:168px;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);align-items:end;border-bottom:1px solid var(--rule-strong)}\n.bars::before{content:\"\";position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(to top,var(--grid) 0 1px,transparent 1px calc(100% / var(--max)))}\n.bucket{position:relative;height:100%;display:flex;align-items:flex-end;justify-content:center}\n.bucket__past{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:54%;max-width:92px;height:calc(var(--prev) / var(--max) * 100%);border:1px solid var(--rim);background:linear-gradient(to top,color-mix(in oklab,var(--veg) 32%,var(--paper)) 0 var(--pg),color-mix(in oklab,var(--meat) 32%,var(--paper)) var(--pg) 100%)}\n.bucket__col{position:relative;width:40%;max-width:68px;height:calc(var(--total) / var(--max) * 100%);display:flex;flex-direction:column-reverse;gap:2px}\n.seg--g{height:calc(var(--g) / var(--total) * 100%);background:var(--veg)}\n.seg--c{flex:1;background:var(--meat)}\n.bucket__v{position:absolute;bottom:calc(var(--total) / var(--max) * 100% + 5px);left:50%;transform:translateX(-50%);font-family:var(--font-fig);font-size:12px;font-variant-numeric:tabular-nums}\n.bucket__d{position:absolute;top:100%;margin-top:7px;left:50%;transform:translateX(-50%);font-family:var(--font-fig);font-size:11px;color:var(--ink-muted);white-space:nowrap}\n\n/* ledger */\ntable{width:100%;border-collapse:collapse;table-layout:fixed;margin-top:12px}\nth{font-family:var(--font-fig);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);font-weight:400;text-align:left;height:32px;padding:0 12px 0 0;border-bottom:1px solid var(--rule);vertical-align:middle}\ntd{padding:9px 12px 10px 0;border-bottom:1px solid var(--rule-hair);vertical-align:middle;font-size:12.5px}\nth:first-child,td:first-child{width:26%}\nth:nth-child(2),td:nth-child(2){width:19%}\nth:nth-child(3),td:nth-child(3){width:13%}\nth:nth-child(4),td:nth-child(4){width:28%}\nth:last-child,td:last-child{width:14%;text-align:right;padding-right:0}\ntd.n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12.5px}\n.r{text-align:right}\n.meta{display:block;font-family:var(--font-ui);font-size:11px;color:var(--ink-faint);margin-top:1px}\n.pack{display:flex;align-items:center;gap:9px}\n.pack__m{position:relative;flex:1;min-width:44px;height:4px;border-radius:1px;background:var(--tint);box-shadow:inset 0 0 0 1px var(--rule)}\n.pack__m i{position:absolute;inset:0 auto 0 0;width:var(--left);background:var(--accent)}\n.pack .n{font-family:var(--font-fig);font-variant-numeric:tabular-nums;font-size:12.5px;min-width:30px;text-align:right}\n.foot{font-family:var(--font-fig);font-size:11.5px;color:var(--ink-muted);margin:11px 0 0}\n\n.key{display:flex;flex-wrap:wrap;gap:4px 14px;margin:16px 2px 0;font-family:var(--font-fig);font-size:10px;line-height:1.6;color:var(--ink-muted)}\n.key b{font-weight:400;color:var(--ink)}\n</style>\n<div class=\"sheet\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"page wrapper\" data-reason=\"sheet padding reinitialized by script so it clears the fixed bar (width/height set to bar metrics)\">\n<div class=\"plate\" data-kid=\"1-1\" data-name=\"top app card container\">\n<header class=\"bar\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n<span class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"brand wordmark text\">Chef Llama</span>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation link group\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"Pantry navigation link\" href=\"#\">Pantry</a>\n<a data-kid=\"1-1-1-2-2\" data-name=\"Recipes navigation link\" href=\"#\">Recipes</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"Saved navigation link\" href=\"#\">Saved</a>\n<a aria-current=\"page\" data-kid=\"1-1-1-2-4\" data-name=\"Dashboard current-page navigation link\" href=\"#\">Dashboard</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"Billing navigation link\" href=\"#\">Billing</a>\n</nav>\n<span aria-hidden=\"true\" class=\"av\" data-kid=\"1-1-1-3\" data-name=\"user avatar initials chip\">AR</span>\n</header>\n<main class=\"page\" data-kid=\"1-1-2\" data-name=\"main dashboard content\">\n<div class=\"head\" data-kid=\"1-1-2-1\" data-name=\"page head row with title and action\">\n<h1 data-kid=\"1-1-2-1-1\" data-name=\"dashboard page title\">Dashboard</h1>\n<p class=\"asof\" data-kid=\"1-1-2-1-2\" data-name=\"dashboard as-of timestamp\">4 November 2026, 9:14 am</p>\n<a class=\"btn btn--ghost\" data-kid=\"1-1-2-1-3\" data-name=\"buy credits ghost button\" href=\"#\">Buy Credits</a>\n</div>\n<section aria-label=\"Credit account\" class=\"band\" data-kid=\"1-1-2-2\" data-name=\"credit account summary band\">\n<div class=\"cell\" data-kid=\"1-1-2-2-1\" data-name=\"available balance cell\">\n<p class=\"lbl\" data-kid=\"1-1-2-2-1-1\" data-name=\"available credits label\">Available</p>\n<p class=\"val\" data-kid=\"1-1-2-2-1-2\" data-name=\"available credits value row\"><b data-kid=\"1-1-2-2-1-2-1\" data-name=\"available credits number\">143</b><span data-kid=\"1-1-2-2-1-2-2\" data-name=\"credits unit label\">Credits</span></p>\n<p class=\"note\" data-kid=\"1-1-2-2-1-3\" data-name=\"credit cost note\">One Credit per cook. <a class=\"tlink\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"credit history link\" href=\"#\">Credit history</a></p>\n</div>\n<div class=\"cell\" data-kid=\"1-1-2-2-2\" data-name=\"free cooks cell\">\n<div data-kid=\"1-1-2-2-2-1\" data-name=\"free cooks info block\">\n<p class=\"lbl\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"free cooks label\">Free cooks</p>\n<p class=\"state\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"free cooks remaining state\"><i aria-hidden=\"true\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"status indicator dot\"></i><span data-kid=\"1-1-2-2-2-1-2-2\" data-name=\"remaining cooks text\"><b data-kid=\"1-1-2-2-2-1-2-2-1\" data-name=\"remaining cooks number\">3</b> left today</span></p>\n<p class=\"note\" data-kid=\"1-1-2-2-2-1-3\" data-name=\"daily reset note\">Resets <span class=\"mono\" data-kid=\"1-1-2-2-2-1-3-1\" data-name=\"daily reset time\">5:00 am</span>.</p>\n</div>\n<a class=\"btn btn--fill\" data-kid=\"1-1-2-2-2-2\" data-name=\"cook from pantry filled button\" href=\"#\">Cook from the pantry</a>\n</div>\n</section>\n<section aria-labelledby=\"cooks-h\" class=\"section\" data-kid=\"1-1-2-3\" data-name=\"cooks overview section\">\n<div class=\"shead\" data-kid=\"1-1-2-3-1\" data-name=\"cooks section header with range control\">\n<h2 data-kid=\"1-1-2-3-1-1\" data-name=\"cooks section title\" id=\"cooks-h\">Cooks</h2>\n<div aria-label=\"Range\" class=\"seg\" data-kid=\"1-1-2-3-1-2\" data-name=\"time range segmented control\" role=\"group\">\n<span data-kid=\"1-1-2-3-1-2-1\" data-name=\"1 week range segment\">1 week</span>\n<span aria-pressed=\"true\" data-kid=\"1-1-2-3-1-2-2\" data-name=\"1 month selected range segment\">1 month</span>\n<span data-kid=\"1-1-2-3-1-2-3\" data-name=\"1 year range segment\">1 year</span>\n</div>\n</div>\n<p class=\"period\" data-kid=\"1-1-2-3-2\" data-name=\"comparison period caption\">7 October – 3 November 2026, against 7 September – 6 October 2026</p>\n<div class=\"summary\" data-kid=\"1-1-2-3-3\" data-name=\"cooks summary row with legend\">\n<ul class=\"stats\" data-kid=\"1-1-2-3-3-1\" data-name=\"cooks summary stats list\">\n<li data-kid=\"1-1-2-3-3-1-1\" data-name=\"current period cooks stat\"><b data-kid=\"1-1-2-3-3-1-1-1\" data-name=\"current cooks number\">33</b><span data-kid=\"1-1-2-3-3-1-1-2\" data-name=\"cooks stat label\">cooks</span></li>\n<li data-kid=\"1-1-2-3-3-1-2\" data-name=\"previous period cooks stat\"><b data-kid=\"1-1-2-3-3-1-2-1\" data-name=\"previous cooks number\">22</b><span data-kid=\"1-1-2-3-3-1-2-2\" data-name=\"previous stat label\">previous</span></li>\n<li data-kid=\"1-1-2-3-3-1-3\" data-name=\"change stat\"><b data-kid=\"1-1-2-3-3-1-3-1\" data-name=\"change amount\">+11</b><em data-kid=\"1-1-2-3-3-1-3-2\" data-name=\"percentage change\">+50%</em></li>\n</ul>\n<ul class=\"legend\" data-kid=\"1-1-2-3-3-2\" data-name=\"chart legend list\">\n<li data-kid=\"1-1-2-3-3-2-1\" data-name=\"gift-funded legend item\"><span aria-hidden=\"true\" class=\"sw sw--g\" data-kid=\"1-1-2-3-3-2-1-1\" data-name=\"gift-funded color swatch\"></span>Gift-funded</li>\n<li data-kid=\"1-1-2-3-3-2-2\" data-name=\"credit-funded legend item\"><span aria-hidden=\"true\" class=\"sw sw--c\" data-kid=\"1-1-2-3-3-2-2-1\" data-name=\"credit-funded color swatch\"></span>Credit-funded</li>\n<li data-kid=\"1-1-2-3-3-2-3\" data-name=\"previous period legend item\"><span aria-hidden=\"true\" class=\"sw sw--p\" data-kid=\"1-1-2-3-3-2-3-1\" data-name=\"previous period dual-tone swatch\"></span>Previous period</li>\n</ul>\n</div>\n<div class=\"plot\" data-kid=\"1-1-2-3-4\" data-name=\"cooks bar chart plot\">\n<div aria-hidden=\"true\" class=\"plot__y\" data-kid=\"1-1-2-3-4-1\" data-name=\"y-axis scale labels\" style=\"--max:10\">\n<span data-kid=\"1-1-2-3-4-1-1\" data-name=\"y-axis max label\" style=\"--t:10\">10</span>\n<span data-kid=\"1-1-2-3-4-1-2\" data-name=\"y-axis mid label\" style=\"--t:5\">5</span>\n<span data-kid=\"1-1-2-3-4-1-3\" data-name=\"y-axis baseline label\" style=\"--t:0\">0</span>\n</div>\n<div class=\"bars\" data-kid=\"1-1-2-3-4-2\" data-name=\"bar chart plot area\" style=\"--max:10\">\n<div class=\"bucket\" data-kid=\"1-1-2-3-4-2-1\" data-name=\"first week bar bucket\" style=\"--total:8;--prev:5;--g:2;--pg:25%\">\n<span aria-hidden=\"true\" class=\"bucket__past\" data-kid=\"1-1-2-3-4-2-1-1\" data-name=\"previous period ghost bar\"></span>\n<span class=\"bucket__v\" data-kid=\"1-1-2-3-4-2-1-2\" data-name=\"bar value label\">8</span>\n<span class=\"bucket__col\" data-kid=\"1-1-2-3-4-2-1-3\" data-name=\"stacked bar column\"><span aria-hidden=\"true\" class=\"seg--g\" data-kid=\"1-1-2-3-4-2-1-3-1\" data-name=\"gift-funded bar segment\"></span><span aria-hidden=\"true\" class=\"seg--c\" data-kid=\"1-1-2-3-4-2-1-3-2\" data-name=\"credit-funded bar segment\"></span></span>\n<span class=\"bucket__d\" data-kid=\"1-1-2-3-4-2-1-4\" data-name=\"week range axis label\">7–13 Oct</span>\n</div>\n<div class=\"bucket\" data-kid=\"1-1-2-3-4-2-2\" data-name=\"second week bar bucket\" style=\"--total:9;--prev:6;--g:1;--pg:14%\">\n<span aria-hidden=\"true\" class=\"bucket__past\" data-kid=\"1-1-2-3-4-2-2-1\" data-name=\"previous period ghost bar\"></span>\n<span class=\"bucket__v\" data-kid=\"1-1-2-3-4-2-2-2\" data-name=\"bar value label\">9</span>\n<span class=\"bucket__col\" data-kid=\"1-1-2-3-4-2-2-3\" data-name=\"stacked bar column\"><span aria-hidden=\"true\" class=\"seg--g\" data-kid=\"1-1-2-3-4-2-2-3-1\" data-name=\"gift-funded bar segment\"></span><span aria-hidden=\"true\" class=\"seg--c\" data-kid=\"1-1-2-3-4-2-2-3-2\" data-name=\"credit-funded bar segment\"></span></span>\n<span class=\"bucket__d\" data-kid=\"1-1-2-3-4-2-2-4\" data-name=\"week range axis label\">14–20 Oct</span>\n</div>\n<div class=\"bucket\" data-kid=\"1-1-2-3-4-2-3\" data-name=\"third week bar bucket\" style=\"--total:7;--prev:4;--g:2;--pg:29%\">\n<span aria-hidden=\"true\" class=\"bucket__past\" data-kid=\"1-1-2-3-4-2-3-1\" data-name=\"previous period ghost bar\"></span>\n<span class=\"bucket__v\" data-kid=\"1-1-2-3-4-2-3-2\" data-name=\"bar value label\">7</span>\n<span class=\"bucket__col\" data-kid=\"1-1-2-3-4-2-3-3\" data-name=\"stacked bar column\"><span aria-hidden=\"true\" class=\"seg--g\" data-kid=\"1-1-2-3-4-2-3-3-1\" data-name=\"gift-funded bar segment\"></span><span aria-hidden=\"true\" class=\"seg--c\" data-kid=\"1-1-2-3-4-2-3-3-2\" data-name=\"credit-funded bar segment\"></span></span>\n<span class=\"bucket__d\" data-kid=\"1-1-2-3-4-2-3-4\" data-name=\"week range axis label\">21–27 Oct</span>\n</div>\n<div class=\"bucket\" data-kid=\"1-1-2-3-4-2-4\" data-name=\"fourth week bar bucket\" style=\"--total:9;--prev:7;--g:1;--pg:13%\">\n<span aria-hidden=\"true\" class=\"bucket__past\" data-kid=\"1-1-2-3-4-2-4-1\" data-name=\"previous period ghost bar\"></span>\n<span class=\"bucket__v\" data-kid=\"1-1-2-3-4-2-4-2\" data-name=\"bar value label\">9</span>\n<span class=\"bucket__col\" data-kid=\"1-1-2-3-4-2-4-3\" data-name=\"stacked bar column\"><span ar