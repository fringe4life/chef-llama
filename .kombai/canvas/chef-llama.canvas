\"1-1-2-4-2-2-1-3\" data-name=\"credits purchased count cell\">120</td>\n<td data-kid=\"1-1-2-4-2-2-1-4\" data-name=\"pack remaining cell\"><span class=\"pack\" data-kid=\"1-1-2-4-2-2-1-4-1\" data-name=\"pack remaining meter\"><span class=\"pack__m\" data-kid=\"1-1-2-4-2-2-1-4-1-1\" data-name=\"full pack meter track\" style=\"--left:100%\"><i data-kid=\"1-1-2-4-2-2-1-4-1-1-1\" data-name=\"pack meter fill\"></i></span><span class=\"n\" data-kid=\"1-1-2-4-2-2-1-4-1-2\" data-name=\"remaining credits count\">120</span></span></td>\n<td class=\"r\" data-kid=\"1-1-2-4-2-2-1-5\" data-name=\"receipt link cell\"><a class=\"tlink\" data-kid=\"1-1-2-4-2-2-1-5-1\" data-name=\"receipt download link\" href=\"#\">Receipt</a></td>\n</tr>\n<tr data-kid=\"1-1-2-4-2-2-2\" data-name=\"second purchase row\">\n<td class=\"n\" data-kid=\"1-1-2-4-2-2-2-1\" data-name=\"purchase date cell\">2 October 2026</td>\n<td class=\"n\" data-kid=\"1-1-2-4-2-2-2-2\" data-name=\"purchase amount and card cell\">NZ$16.00<span class=\"meta\" data-kid=\"1-1-2-4-2-2-2-2-1\" data-name=\"card method meta\">Visa ···· 4242</span></td>\n<td class=\"n r\" data-kid=\"1-1-2-4-2-2-2-3\" data-name=\"credits purchased count cell\">50</td>\n<td data-kid=\"1-1-2-4-2-2-2-4\" data-name=\"pack remaining cell\"><span class=\"pack\" data-kid=\"1-1-2-4-2-2-2-4-1\" data-name=\"partially used pack meter\"><span class=\"pack__m\" data-kid=\"1-1-2-4-2-2-2-4-1-1\" data-name=\"pack meter track\" style=\"--left:46%\"><i data-kid=\"1-1-2-4-2-2-2-4-1-1-1\" data-name=\"pack meter fill\"></i></span><span class=\"n\" data-kid=\"1-1-2-4-2-2-2-4-1-2\" data-name=\"remaining credits count\">23</span></span></td>\n<td class=\"r\" data-kid=\"1-1-2-4-2-2-2-5\" data-name=\"receipt link cell\"><a class=\"tlink\" data-kid=\"1-1-2-4-2-2-2-5-1\" data-name=\"receipt download link\" href=\"#\">Receipt</a></td>\n</tr>\n<tr data-kid=\"1-1-2-4-2-2-3\" data-name=\"third purchase row\">\n<td class=\"n\" data-kid=\"1-1-2-4-2-2-3-1\" data-name=\"purchase date cell\">12 September 2026</td>\n<td class=\"n\" data-kid=\"1-1-2-4-2-2-3-2\" data-name=\"purchase amount and card cell\">NZ$8.00<span class=\"meta\" data-kid=\"1-1-2-4-2-2-3-2-1\" data-name=\"card method meta\">Visa ···· 4242</span></td>\n<td class=\"n r\" data-kid=\"1-1-2-4-2-2-3-3\" data-name=\"credits purchased count cell\">20</td>\n<td data-kid=\"1-1-2-4-2-2-3-4\" data-name=\"pack remaining cell\"><span class=\"pack\" data-kid=\"1-1-2-4-2-2-3-4-1\" data-name=\"exhausted pack meter\"><span class=\"pack__m\" data-kid=\"1-1-2-4-2-2-3-4-1-1\" data-name=\"empty pack meter track\" style=\"--left:0%\"><i data-kid=\"1-1-2-4-2-2-3-4-1-1-1\" data-name=\"pack meter fill\"></i></span><span class=\"n\" data-kid=\"1-1-2-4-2-2-3-4-1-2\" data-name=\"remaining credits count\">0</span></span></td>\n<td class=\"r\" data-kid=\"1-1-2-4-2-2-3-5\" data-name=\"receipt link cell\"><a class=\"tlink\" data-kid=\"1-1-2-4-2-2-3-5-1\" data-name=\"receipt download link\" href=\"#\">Receipt</a></td>\n</tr>\n</tbody>\n</table>\n<p class=\"foot\" data-kid=\"1-1-2-4-3\" data-name=\"purchases footer totals\">3 purchases · NZ$56.00 · 190 Credits</p>\n</section>\n</main>\n</div>\n<p class=\"key\" data-kid=\"1-2\" data-name=\"typography key legend\">\n<span data-kid=\"1-2-1\" data-name=\"wordmark font key entry\">wordmark <b data-kid=\"1-2-1-1\" data-name=\"Georgia font name\">Georgia 700</b></span>\n<span data-kid=\"1-2-2\" data-name=\"nav and buttons font key entry\">nav and buttons <b data-kid=\"1-2-2-1\" data-name=\"System UI font name\">System UI</b></span>\n<span data-kid=\"1-2-3\" data-name=\"balance and axis font key entry\">balance, counts, axis <b data-kid=\"1-2-3-1\" data-name=\"Mono font name\">Mono</b></span>\n<span data-kid=\"1-2-4\" data-name=\"amounts and dates font key entry\">amounts, dates, foot total <b data-kid=\"1-2-4-1\" data-name=\"Mono font name\">Mono</b></span>\n<span data-kid=\"1-2-5\" data-name=\"labels and notes font key entry\">labels and notes <b data-kid=\"1-2-5-1\" data-name=\"System UI font name\">System UI</b></span>\n</p>\n</div>\n",
