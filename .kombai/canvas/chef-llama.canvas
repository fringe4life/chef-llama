mily: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 30px; line-height: 1; letter-spacing: -0.03em; }\n  .pack__credits { margin-top: 6px; font-size: 15px; font-weight: 600; }\n  .pack__rate { margin-top: 4px; margin-bottom: 18px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 11px; color: var(--muted-foreground); }\n  .pack__buy { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--foreground); font-size: 13px; font-weight: 600; text-decoration: none; }\n  .pack__buy:hover { border-color: var(--foreground); }\n  .pack--starter .pack__buy { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n  .pack--starter .pack__buy:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); border-color: transparent; }\n  .packs__fine { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n  .free__note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }\n\n  .site-footer { background: var(--secondary); border-top: 1px solid var(--border); }\n  .site-footer .wrap { padding-top: 32px; padding-bottom: 32px; }\n  .footer__grid { display: grid; gap: 32px; }\n  @media (min-width: 768px) { .footer__grid { grid-template-columns: minmax(0, 1fr) auto; gap: 64px; align-items: end; } }\n  .footer__brand { font-family: var(--font-display); font-size: 18px; font-weight: 600; line-height: 1; letter-spacing: var(--tracking-display); }\n  .footer__note { margin-top: 12px; max-width: 46ch; font-size: 13px; color: var(--muted-foreground); }\n  .footer__links { margin-top: 16px; display: flex; gap: 24px; }\n  .footer__links a { font-size: 13px; color: var(--foreground); text-decoration: none; }\n  .footer__links a:hover { text-decoration: underline; text-underline-offset: 4px; }\n\n  .scheme { min-width: 0; padding: 0; border: 0; }\n  .scheme legend { margin-bottom: 8px; padding: 0; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }\n  .switch { display: inline-flex; align-items: center; gap: 4px; padding: 4px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); }\n  .opt { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 0 12px; border-radius: calc(var(--radius-md) - 2px); font-size: 12px; color: var(--muted-foreground); cursor: pointer; }\n  .opt input { position: absolute; width: 1px; height: 1px; opacity: 0; }\n  .opt span { display: inline-flex; align-items: center; min-height: 30px; padding: 0 8px; border-radius: calc(var(--radius-md) - 3px); }\n  .opt input:checked + span { background: var(--primary); color: var(--primary-foreground); }\n  .opt input:focus-visible + span { outline: 2px solid var(--ring); outline-offset: 2px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .btn { transition: none; }\n    .btn:active { transform: none; }\n    .row a { transition: opacity 120ms linear; }\n  }\n</style>\n<div data-kid=\"1\">\n<header class=\"site-header\" data-kid=\"1-1\">\n<div class=\"wrap\" data-kid=\"1-1-1\">\n<a class=\"wordmark\" data-kid=\"1-1-1-1\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Site\" class=\"site-nav\" data-kid=\"1-1-1-2\"><a data-kid=\"1-1-1-2-1\" href=\"#popular\">Popular</a><a href=\"#credits\">Credits</a></nav>\n<a class=\"btn\" data-kid=\"1-1-1-3\" href=\"/pantry\">Start cooking</a>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero main headline\" id=\"site-hero\"><span class=\"ln\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline first line\">You’ve got the Pantry.</span> <span class=\"ln\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline second line\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\">Your Diet and allergies are hard limits. You cook it, save it, and find similar dishes from the same Pantry.</p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\">\n<div data-kid=\"1-2-1-2-1-1\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" style=\"font-size:11px; letter-spacing:0.16em\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\"><dt data-kid=\"1-2-1-2-1-2-1-1\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\"><dt data-kid=\"1-2-1-2-1-2-2-1\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\"><dt data-kid=\"1-2-1-2-1-2-3-1\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" style=\"font-size:10px; letter-spacing:0.16em\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\">\n<div data-kid=\"1-2-1-2-2-4-1\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"free-heading\" class=\"free\" data-kid=\"1-6\" data-name=\"free cooks promotional section\">\n<div class=\"wrap free__inner\" data-kid=\"1-6-1\" data-name=\"free cooks section inner wrapper\">\n<div class=\"free__grid\" data-kid=\"1-6-1-1\" data-name=\"free cooks grid layout\">\n<div data-kid=\"1-6-1-1-1\" data-name=\"free cooks title and note block\">\n<h2 class=\"free__title\" data-kid=\"1-6-1-1-1-1\" data-name=\"free cooks headline with count\" id=\"free-heading\">Up to 3 free cooks a day.</h2>\n<p class=\"free__note\" data-kid=\"1-6-1-1-1-2\" data-name=\"free cooks reset and credits note\">First come first served from a shared pool. <a href=\"#credits\">Credits</a> when you need more.</p>\n</div>\n<a class=\"free__link\" data-kid=\"1-6-1-1-2\" data-name=\"free section call-to-action link\" href=\"/pantry\">Start cooking</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"strip strip--plain\" data-kid=\"1-3\">\n<div class=\"wrap field__inner\" data-kid=\"1-3-1\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-1\" id=\"process-heading\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-3-1-2\">\n<li class=\"field__step\" data-kid=\"1-3-1-2-1\">\n<h3 data-kid=\"1-3-1-2-1-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-1-1-1\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-3-1-2-1-2\">\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-1\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-2\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-3\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-3-1-2-1-3\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-2\">\n<h3 data-kid=\"1-3-1-2-2-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-2-1-1\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-3-1-2-2-2\">\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-1\"><dt data-kid=\"1-3-1-2-2-2-1-1\">Diet</dt><dd data-kid=\"1-3-1-2-2-2-1-2\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-2\"><dt data-kid=\"1-3-1-2-2-2-2-1\">Allergy</dt><dd data-kid=\"1-3-1-2-2-2-2-2\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-3\"><dt data-kid=\"1-3-1-2-2-2-3-1\">Servings</dt><dd data-kid=\"1-3-1-2-2-2-3-2\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-3-1-2-2-3\" style=\"max-width:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-3\">\n<h3 data-kid=\"1-3-1-2-3-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-1\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-3-1-2-3-2\">\n<li data-kid=\"1-3-1-2-3-2-1\"><span data-kid=\"1-3-1-2-3-2-1-1\">Method</span><span data-kid=\"1-3-1-2-3-2-1-2\">every step, numbered</span></li>\n<li data-kid=\"1-3-1-2-3-2-2\"><span data-kid=\"1-3-1-2-3-2-2-1\">Save</span><span data-kid=\"1-3-1-2-3-2-2-2\">one tap to Saved</span></li>\n<li data-kid=\"1-3-1-2-3-2-3\"><span data-kid=\"1-3-1-2-3-2-3-1\">Similar</span><span data-kid=\"1-3-1-2-3-2-3-2\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"pop\" data-kid=\"1-4\" id=\"popular\">\n<div class=\"wrap pop__inner\" data-kid=\"1-4-1\">\n<div class=\"pop__head\" data-kid=\"1-4-1-1\">\n<h2 data-kid=\"1-4-1-1-1\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-4-1-1-2\">Ranked by saves in the last 7 days</p>\n</div>\n<ol class=\"cards\" data-kid=\"1-4-1-2\">\n<li data-kid=\"1-4-1-2-1\">\n<a class=\"card\" data-kid=\"1-4-1-2-1-1\" href=\"/recipes/skillet-beans\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-1-1-1\">1</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-1-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-1-1-2-1\">Skillet beans and greens</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-1-1-2-2\">butter beans, cavolo nero, garlic, olive oil</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-1-1-2-3\"><span data-kid=\"1-4-1-2-1-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-1-1\" data-name=\"recipe card cook time figure\">25 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-1-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-2-1\" data-name=\"recipe card kcal figure\">410 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-1-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-3-1\" data-name=\"recipe card saves count figure\">86</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-2\">\n<a class=\"card\" data-kid=\"1-4-1-2-2-1\" href=\"/recipes/lemon-lentils\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-2-1-1\">2</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-2-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-2-1-2-1\">Lemon lentils with herbs</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-2-1-2-2\">brown lentils, lemon, parsley, cumin</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-2-1-2-3\"><span data-kid=\"1-4-1-2-2-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-1-1\" data-name=\"recipe card cook time figure\">35 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-2-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-2-1\" data-name=\"recipe card kcal figure\">380 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-2-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-3-1\" data-name=\"recipe card saves count figure\">61</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-3\">\n<a class=\"card\" data-kid=\"1-4-1-2-3-1\" href=\"/recipes/garlic-oil-pasta\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-3-1-1\">3</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-3-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-3-1-2-1\">Garlic oil pasta with kale</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-3-1-2-2\">spaghetti, garlic, kale, chilli flakes</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-3-1-2-3\"><span data-kid=\"1-4-1-2-3-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-1-1\" data-name=\"recipe card cook time figure\">20 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-3-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-2-1\" data-name=\"recipe card kcal figure\">520 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-3-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-3-1\" data-name=\"recipe card saves count figure\">44</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-4\">\n<a class=\"card\" data-kid=\"1-4-1-2-4-1\" href=\"/recipes/roast-squash-chickpeas\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-4-1-1\">4</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-4-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-4-1-2-1\">Roast squash and chickpeas</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-4-1-2-2\">butternut squash, chickpeas, cumin, yoghurt</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-4-1-2-3\"><span data-kid=\"1-4-1-2-4-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-4-1-2-3-1-1\" data-name=\"recipe card cook time figure\">40 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-4-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-4-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-4-1-2-3-2-1\" data-name=\"recipe card kcal figure\">445 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-4-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-4-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-4-1-2-3-3-1\" data-name=\"recipe card saves count figure\">29</span><span class=\"card__unit\" data-kid=\"1-4-1-2-4-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-5\">\n<a class=\"card\" data-kid=\"1-4-1-2-5-1\" href=\"/recipes/braised-leeks\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-5-1-1\">5</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-5-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-5-1-2-1\">Braised leeks on toast</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-5-1-2-2\">leeks, sourdough, butter, thyme</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-5-1-2-3\"><span data-kid=\"1-4-1-2-5-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-5-1-2-3-1-1\" data-name=\"recipe card cook time figure\">30 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-5-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-5-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-5-1-2-3-2-1\" data-name=\"recipe card kcal figure\">390 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-5-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-5-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-5-1-2-3-3-1\" data-name=\"recipe card saves count figure\">18</span><span class=\"card__unit\" data-kid=\"1-4-1-2-5-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"credits-heading\" class=\"packs\" id=\"credits\">\n<div class=\"wrap packs__inner\">\n<div class=\"packs__head\">\n<h2 id=\"credits-heading\">Credits</h2>\n<p>One-time purchase. No subscription.</p>\n</div>\n<ol class=\"packs__grid\">\n<li class=\"pack pack--starter\">\n<div class=\"pack__top\"><span class=\"pack__flag\">Starter pack, once only</span></div>\n<p class=\"pack__price\">NZ$4</p>\n<p class=\"pack__credits\">10 Credits</p>\n<p class=\"pack__rate\">NZ$0.40 per Credit</p>\n<a class=\"pack__buy\" href=\"/pantry\">Buy Starter pack</a>\n</li>\n<li class=\"pack\">\n<div class=\"pack__top\"></div>\n<p class=\"pack__price\">NZ$8</p>\n<p class=\"pack__credits\">20 Credits</p>\n<p class=\"pack__rate\">NZ$0.40 per Credit</p>\n<a class=\"pack__buy\" href=\"/pantry\">Buy 20 Credits</a>\n</li>\n<li class=\"pack\">\n<div class=\"pack__top\"></div>\n<p class=\"pack__price\">NZ$16</p>\n<p class=\"pack__credits\">50 Credits</p>\n<p class=\"pack__rate\">NZ$0.32 per Credit</p>\n<a class=\"pack__buy\" href=\"/pantry\">Buy 50 Credits</a>\n</li>\n<li class=\"pack pack--best\">\n<div class=\"pack__top\"><span class=\"pack__flag\">Best rate</span></div>\n<p class=\"pack__price\">NZ$32</p>\n<p class=\"pack__credits\">120 Credits</p>\n<p class=\"pack__rate\">NZ$0.27 per Credit</p>\n<a class=\"pack__buy\" href=\"/pantry\">Buy 120 Credits</a>\n</li>\n</ol>\n<p class=\"packs__fine\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</div>\n</section>\n<footer class=\"site-footer\" data-kid=\"1-5\">\n<div class=\"wrap\" data-kid=\"1-5-1\">\n<div class=\"footer__grid\" data-kid=\"1-5-1-1\">\n<div data-kid=\"1-5-1-1-1\">\n<p class=\"footer__brand\" data-kid=\"1-5-1-1-1-1\">Chef Llama</p>\n<p class=\"footer__note\" data-kid=\"1-5-1-1-1-2\">Recipes are generated by a small model. Check ingredients and allergens yourself.</p>\n<nav aria-label=\"Legal\" class=\"footer__links\" data-kid=\"1-5-1-1-1-3\">\n<a data-kid=\"1-5-1-1-1-3-1\" href=\"/terms\">Terms</a>\n<a data-kid=\"1-5-1-1-1-3-2\" href=\"/privacy\">Privacy</a>\n</nav>\n</div>\n<fieldset class=\"scheme\" data-kid=\"1-5-1-1-2\">\n<legend data-kid=\"1-5-1-1-2-1\">Appearance</legend>\n<div class=\"switch\" data-kid=\"1-5-1-1-2-2\">\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-1\"><input checked=\"\" data-kid=\"1-5-1-1-2-2-1-1\" id=\"scheme-system\" name=\"scheme\" type=\"radio\" value=\"system\"/><span data-kid=\"1-5-1-1-2-2-1-2\">System</span></label>\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-2\"><input data-kid=\"1-5-1-1-2-2-2-1\" id=\"scheme-light\" name=\"scheme\" type=\"radio\" value=\"light\"/><span data-kid=\"1-5-1-1-2-2-2-2\">Light</span></label>\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-3\"><input data-kid=\"1-5-1-1-2-2-3-1\" id=\"scheme-dark\" name=\"scheme\" type=\"radio\" value=\"dark\"/><span data-kid=\"1-5-1-1-2-2-3-2\">Dark</span></label>\n</div>\n</fieldset>\n</div>\n</div>\n</footer>\n</div>\n",
