      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(hsl(38 42% 96%), hsl(30 12% 8%));\n  --surface-2: light-dark(hsl(36 34% 93%), hsl(30 9% 15%));\n  --ink: light-dark(hsl(28 24% 15%), hsl(36 28% 93%));\n  --ink-muted: light-dark(hsl(30 9% 38%), hsl(30 8% 66%));\n  --ink-faint: light-dark(hsl(30 7% 50%), hsl(30 7% 54%));\n  --rule: light-dark(hsl(34 24% 85%), hsl(30 8% 21%));\n  --rule-strong: light-dark(hsl(32 18% 70%), hsl(30 8% 30%));\n  --accent: light-dark(hsl(30 74% 37%), hsl(34 82% 60%));\n  --accent-ink: light-dark(hsl(40 60% 98%), hsl(30 45% 9%));\n  --gift: light-dark(hsl(168 18% 43%), hsl(168 24% 54%));\n  --warn: light-dark(hsl(14 62% 38%), hsl(14 76% 61%));\n  --focus: light-dark(hsl(214 80% 42%), hsl(210 90% 64%));\n  --sans: ui-sans-serif, system-ui, sans-serif;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n}\nbody{\n  margin:0;\n  background:var(--background);\n  color:var(--ink);\n  font-family:var(--sans);\n  font-size:14px;\n  line-height:1.45;\n  -webkit-font-smoothing:antialiased;\n}\np,ul{margin:0}\nul{padding:0;list-style:none}\n.num{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n\n.sheet{max-width:1000px;margin:0 auto;padding:44px 24px 60px;box-sizing:border-box}\n.sheet h1{margin:0;font-size:22px;font-weight:600;letter-spacing:-.015em}\n.grid{display:grid;grid-template-columns:1fr 1fr;margin-top:24px;border-top:1px solid var(--rule)}\n.spec{\n  padding:22px 26px 26px;\n  container-type:inline-size;\n  container-name:account;\n  border-bottom:1px solid var(--rule);\n  box-sizing:border-box;\n}\n.spec:nth-child(2n){border-left:1px solid var(--rule)}\n.spec__name{font-family:var(--mono);font-size:11px;color:var(--ink-faint)}\n\n.cell__row{display:flex;flex-direction:column;align-items:flex-start;margin-top:12px}\n.cell__aside{display:flex;flex-direction:column;align-items:flex-start;gap:9px;margin-top:14px}\n.band__label{font-size:12px;color:var(--ink-muted)}\n.gift__state{display:flex;align-items:center;gap:8px;font-size:17px;font-weight:600;letter-spacing:-.01em;margin-top:3px}\n.gift__note{font-size:12.5px;color:var(--ink-muted);margin-top:4px}\n\n.dot{flex:none;display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--gift)}\n.dot--warn{background:var(--warn);box-shadow:0 0 0 3px color-mix(in oklab, var(--warn) 18%, transparent)}\n.dot--used{background:transparent;box-shadow:inset 0 0 0 2px var(--ink-faint)}\n.dot--failed{width:8px;height:8px;background:transparent;border:1px dashed var(--ink-faint)}\n\n.pips{display:flex;gap:3px;margin-top:9px}\n.pips li{width:13px;height:5px;border-radius:1px;background:transparent;box-shadow:inset 0 0 0 1px var(--rule-strong)}\n.pips li.on{background:var(--warn);box-shadow:none}\n.pips--gift li.on{background:var(--gift)}\n\n.btn{\n  display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;\n  border-radius:6px;border:1px solid transparent;background:var(--accent);color:var(--accent-ink);\n  font-family:inherit;font-size:13.5px;font-weight:600;text-decoration:none;white-space:nowrap;box-sizing:border-box;\n}\n.btn--ink{background:var(--ink);color:var(--background)}\n.btn:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n\n@container account (min-width:21rem){\n  .cell__row{flex-direction:row;align-items:flex-end;justify-content:space-between;gap:26px}\n  .cell__aside{align-items:flex-end;text-align:right;margin-top:0;padding-bottom:3px}\n  .cell__row .btn{flex:none}\n}\n</style>\n<div class=\"sheet\" data-kid=\"1\">\n<h1 data-kid=\"1-1\">Free cooks</h1>\n<div class=\"grid\" data-kid=\"1-2\">\n<section class=\"spec\" data-kid=\"1-2-1\">\n<p class=\"spec__name\" data-kid=\"1-2-1-1\">Available</p>\n<div class=\"cell__row\" data-kid=\"1-2-1-2\">\n<div class=\"gift\" data-kid=\"1-2-1-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-1-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-1-2-1-2\"><i class=\"dot\" data-kid=\"1-2-1-2-1-2-1\"></i><span data-kid=\"1-2-1-2-1-2-2\"><b class=\"num\" data-kid=\"1-2-1-2-1-2-2-1\">3</b> left today</span></p>\n<ul aria-hidden=\"true\" class=\"pips pips--gift\" data-kid=\"1-2-1-2-1-3\"><li class=\"on\" data-kid=\"1-2-1-2-1-3-1\"></li><li class=\"on\" data-kid=\"1-2-1-2-1-3-2\"></li><li class=\"on\" data-kid=\"1-2-1-2-1-3-3\"></li></ul>\n<p class=\"gift__note\" data-kid=\"1-2-1-2-1-4\">Resets 5:00 am.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-1-2-2\">\n<a class=\"btn\" data-kid=\"1-2-1-2-2-1\" href=\"/pantry\">Cook free</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-2\">\n<p class=\"spec__name\" data-kid=\"1-2-2-1\">Few left</p>\n<div class=\"cell__row\" data-kid=\"1-2-2-2\">\n<div class=\"gift\" data-kid=\"1-2-2-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-2-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-2-2-1-2\"><i class=\"dot dot--warn\" data-kid=\"1-2-2-2-1-2-1\"></i><span data-kid=\"1-2-2-2-1-2-2\" data-name=\"free cook low-availability status line with count\">Only <b class=\"num\" data-kid=\"1-2-2-2-1-2-2-1\">1</b> left today</span></p>\n<ul aria-hidden=\"true\" class=\"pips\" data-kid=\"1-2-2-2-1-3\"><li class=\"on\" data-kid=\"1-2-2-2-1-3-1\"></li><li data-kid=\"1-2-2-2-1-3-2\"></li><li data-kid=\"1-2-2-2-1-3-3\"></li></ul>\n<p class=\"gift__note\" data-kid=\"1-2-2-2-1-4\">Resets 5:00 am.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-2-2-2\">\n<a class=\"btn\" data-kid=\"1-2-2-2-2-1\" href=\"/pantry\">Cook free</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-3\">\n<p class=\"spec__name\" data-kid=\"1-2-3-1\" data-name=\"state label for no free cooks remaining\">None left</p>\n<div class=\"cell__row\" data-kid=\"1-2-3-2\">\n<div class=\"gift\" data-kid=\"1-2-3-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-3-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-3-2-1-2\" data-name=\"no free cooks today status line\"><i class=\"dot dot--used\" data-kid=\"1-2-3-2-1-2-1\"></i>No free cooks today</p>\n<p class=\"gift__note\" data-kid=\"1-2-3-2-1-3\" data-name=\"daily reset helper note\">Resets 5:00 am.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-3-2-2\">\n<a class=\"btn btn--ink\" data-kid=\"1-2-3-2-2-1\" data-name=\"cook call-to-action link\" href=\"/pantry\">Cook</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-4\" data-name=\"none left no credits spec card\">\n<p class=\"spec__name\" data-kid=\"1-2-4-1\" data-name=\"state label for no free cooks and no credits\">None left, no Credits</p>\n<div class=\"cell__row\" data-kid=\"1-2-4-2\">\n<div class=\"gift\" data-kid=\"1-2-4-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-4-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-4-2-1-2\" data-name=\"no free cooks today status line\"><i class=\"dot dot--used\" data-kid=\"1-2-4-2-1-2-1\"></i>No free cooks today</p>\n<p class=\"gift__note\" data-kid=\"1-2-4-2-1-3\" data-name=\"zero credits remaining note\">0 Credits left.</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-4-2-2\">\n<a class=\"btn btn--ink\" data-kid=\"1-2-4-2-2-1\" data-name=\"buy credits call-to-action link\" href=\"/topup\">Buy Credits</a>\n</div>\n</div>\n</section>\n<section class=\"spec\" data-kid=\"1-2-5\" data-name=\"lookup failed full-width spec card\" style=\"grid-column:1 / -1\">\n<p class=\"spec__name\" data-kid=\"1-2-5-1\" data-name=\"lookup failed state label\">Lookup failed</p>\n<div class=\"cell__row\" data-kid=\"1-2-5-2\">\n<div class=\"gift\" data-kid=\"1-2-5-2-1\">\n<p class=\"band__label\" data-kid=\"1-2-5-2-1-1\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-5-2-1-2\" data-name=\"error status line with failed dot\"><i class=\"dot dot--failed\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"failed lookup status dot\"></i>Couldn't check</p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-5-2-2\">\n<button class=\"btn\" data-kid=\"1-2-5-2-2-1\" data-name=\"try again retry button\" type=\"button\">Try again</button>\n</div>\n</div>\n</section>\n</div>\n</div>\n",
      "comments": [],
      "created": "2026-11-04T15:17:39.626713+00:00",
      "modified": "2026-11-04T18:55:52.219804+00:00",
      "id": "var_aabcf158e78e",
      "contentHeight": 586
    },
    "var_f793f99d31c8": {
      "type": "variant",
      "label": "Cooks chart — three treatments",
      "parentId": "var_0ccd4f014bc1",
      "themeId": null,
      "rect": {
        "x": 3759,
        "y": 0,
        "w": 1334,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(hsl(38 42% 96%), hsl(30 12% 8%));\n  --surface-2: light-dark(hsl(36 34% 93%), hsl(30 9% 15%));\n  --ink: light-dark(hsl(28 24% 15%), hsl(36 28% 93%));\n  --ink-muted: light-dark(hsl(30 9% 38%), hsl(30 8% 66%));\n  --ink-faint: light-dark(hsl(30 7% 50%), hsl(30 7% 54%));\n  --rule: light-dark(hsl(34 24% 85%), hsl(30 8% 21%));\n  --rule-hair: light-dark(hsl(34 22% 90%), hsl(30 8% 16%));\n  --rule-strong: light-dark(hsl(32 18% 70%), hsl(30 8% 30%));\n  --grid: light-dark(hsl(34 20% 91%), hsl(30 8% 17%));\n  --accent: light-dark(hsl(30 74% 37%), hsl(34 82% 60%));\n  --accent-ink: light-dark(hsl(40 60% 98%), hsl(30 45% 9%));\n  --gift: light-dark(hsl(168 18% 43%), hsl(168 24% 54%));\n  --focus: light-dark(hsl(214 80% 42%), hsl(210 90% 64%));\n  --sans: ui-sans-serif, system-ui, sans-serif;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --serif: ui-serif, Georgia, \"Times New Roman\", serif;\n}\nbody{\n  margin:0;\n  background:var(--background);\n  color:var(--ink);\n  font-family:var(--sans);\n  font-size:14px;\n  line-height:1.45;\n  -webkit-font-smoothing:antialiased;\n}\np,ul{margin:0}\nul{padding:0;list-style:none}\n.num{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n\n.page{max-width:980px;margin:0 auto;padding:40px 24px 56px;box-sizing:border-box}\n.head{display:flex;align-items:center;gap:18px;flex-wrap:wrap}\n.head h1{margin:0;font-size:22px;font-weight:600;letter-spacing:-.015em}\n.periods{font-family:var(--serif);font-size:13px;color:var(--ink-faint);margin-top:4px}\n.stats{display:flex;align-items:baseline;gap:22px;margin-top:14px;flex-wrap:wrap}\n.stats li{display:flex;align-items:baseline;gap:6px}\n.stats b{font-size:17px;font-weight:500}\n.stats span{font-size:12.5px;color:var(--ink-muted)}\n.stats em{font-style:normal;font-size:12.5px;color:var(--ink-muted);font-family:var(--mono)}\n\n.segmented{display:inline-flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden;margin-left:auto}\n.segmented button{height:32px;padding:0 12px;border:0;background:transparent;color:var(--ink-muted);font-family:inherit;font-size:12.5px;cursor:pointer}\n.segmented button + button{border-left:1px solid var(--rule)}\n.segmented button[aria-pressed=\"true\"]{background:var(--surface-2);color:var(--ink);font-weight:600}\n.segmented button:focus-visible{outline:2px solid var(--focus);outline-offset:-2px}\n\n.legend{display:flex;align-items:center;gap:16px;font-size:12.5px;color:var(--ink-muted);flex-wrap:wrap}\n.legend li{display:inline-flex;align-items:center;gap:7px}\n.sw{width:10px;height:10px;border-radius:1px;display:inline-block}\n.sw--gift{background:var(--gift)}\n.sw--credit{background:var(--accent)}\n.sw--prev{\n  background:linear-gradient(to top,\n    color-mix(in oklab,var(--gift) 30%,var(--background)) 0 calc(50% - 1px),\n    var(--background) calc(50% - 1px) calc(50% + 1px),\n    color-mix(in oklab,var(--accent) 26%,var(--background)) calc(50% + 1px) 100%);\n  box-shadow:inset 0 0 0 1px var(--rule-strong);\n}\n\n.alt{margin-top:34px;padding-top:20px;border-top:1px solid var(--rule)}\n.alt__head{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}\n.alt h2{margin:0;font-size:13.5px;font-weight:600;letter-spacing:-.005em}\n\n/* ---- A: paired columns ---- */\n.plotA{display:grid;grid-template-columns:24px minmax(0,1fr);column-gap:10px;margin-top:18px;padding-bottom:26px}\n.axisA{position:relative;height:180px}\n.axisA span{position:absolute;right:0;bottom:calc(var(--t) / 10 * 100%);transform:translateY(50%);font-family:var(--mono);font-size:11px;color:var(--ink-faint)}\n.barsA{position:relative;height:180px;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);border-bottom:1px solid var(--rule-strong)}\n.bA{position:relative;height:100%;display:flex;align-items:flex-end;justify-content:center;padding:0;border:0;background:none;font-family:inherit;cursor:default}\n.bA:focus-visible{outline:2px solid var(--focus);outline-offset:-1px}\n.pair{display:flex;align-items:flex-end;justify-content:center;gap:10px;height:100%;width:100%}\n.stk{height:100%;width:clamp(18px,22%,44px);display:flex;flex-direction:column-reverse;gap:2px}\n.stk--now{width:clamp(24px,32%,64px);position:relative}\n.stk--now::after{\n  content:attr(data-t);position:absolute;left:50%;transform:translateX(-50%);\n  bottom:calc(var(--tot) / var(--max) * 100% + 6px);\n  font-family:var(--mono);font-size:12px;font-weight:500;color:var(--ink);\n}\n.sg{height:calc(var(--v) / var(--max) * 100%);background:var(--gift)}\n.sc{height:calc(var(--v) / var(--max) * 100%);background:var(--accent)}\n.stk--prev .sg{background:color-mix(in oklab,var(--gift) 24%,var(--background));box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--gift) 85%,var(--background))}\n.stk--prev .sc{background:color-mix(in oklab,var(--accent) 20%,var(--background));box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--accent) 82%,var(--background))}\n.lbl{position:absolute;top:100%;left:50%;transform:translateX(-50%);margin-top:8px;font-family:var(--serif);font-size:12px;color:var(--ink-faint);white-space:nowrap}\n\n/* ---- B: period lanes ---- */\n.lanes{margin-top:16px;--max:10}\n.scale{display:grid;grid-template-columns:50px minmax(0,1fr) 38px;column-gap:12px;align-items:end;padding-bottom:6px;border-bottom:1px solid var(--rule)}\n.scale__ticks{grid-column:2;display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;color:var(--ink-faint)}\n.lane{\n  display:grid;grid-template-columns:50px minmax(0,1fr) 38px;column-gap:12px;row-gap:6px;\n  width:100%;padding:13px 0;border:0;border-bottom:1px solid var(--rule-hair);\n  background:none;text-align:left;font-family:inherit;cursor:default;\n}\n.lane:focus-visible{outline:2px solid var(--focus);outline-offset:-2px}\n.lane__date{grid-column:1 / 3;font-family:var(--serif);font-size:13px;color:var(--ink)}\n.lane__diff{grid-column:3;display:flex;justify-content:flex-end;align-items:center;font-family:var(--mono);font-size:12.5px;color:var(--ink-muted)}\n.delta{display:inline-flex;align-items:center;gap:4px}\n.delta svg{\n  width:12px;height:12px;flex:none;\n  --rise-shallow:60deg;--rise-steep:32deg;--fall-shallow:122deg;--fall-steep:150deg;\n  --t:calc(var(--mag,1) / var(--mag-max,3));\n  transform:rotate(clamp(var(--rise-steep),calc(var(--rise-shallow) - var(--t) * (var(--rise-shallow) - var(--rise-steep))),var(--rise-shallow)));\n}\n.delta--down svg{\n  transform:rotate(clamp(var(--fall-shallow),calc(var(--fall-shallow) + var(--t) * (var(--fall-steep) - var(--fall-shallow))),var(--fall-steep)));\n}\n.delta--down{color:var(--ink-faint)}\n.lane__row{display:contents}\n.lane__tag{grid-column:1;align-self:center;font-size:11.5px;color:var(--ink-faint)}\n.strip{grid-column:2;display:flex;gap:2px;align-self:center}\n.strip--now{height:18px}\n.strip--prev{height:14px}\n\n@property --v{syntax:'<number>';inherits:false;initial-value:0}\n.sg,.sc{transition:--v .5s cubic-bezier(.2,.7,.2,1)}\n@starting-style{.sg,.sc{--v:0}}\n@media (pointer:coarse){\n  .lane{padding:16px 0}\n  .strip--now{height:24px}\n  .strip--prev{height:18px}\n}\n.strip .sg,.strip .sc{height:100%;display:block;width:calc(var(--v) / var(--max) * 100%)}\n.strip--prev .sg{background:color-mix(in oklab,var(--gift) 24%,var(--background));box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--gift) 85%,var(--background))}\n.strip--prev .sc{background:color-mix(in oklab,var(--accent) 20%,var(--background));box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--accent) 82%,var(--background))}\n.lane__tot{grid-column:3;text-align:right;align-self:center;font-family:var(--mono);font-size:12.5px;color:var(--ink)}\n\n/* ---- C: narrow strips ---- */\n.phone{\n  width:390px;max-width:100%;margin-top:18px;padding:16px;box-sizing:border-box;\n  background:var(--background);border:1px solid var(--rule-strong);border-radius:10px;\n}\n.phone__head{display:flex;align-items:center;gap:10px}\n.phone__head h3{margin:0;font-size:15px;font-weight:600}\n.phone .segmented{margin-left:auto;border-radius:5px}\n.phone .segmented button{height:28px;padding:0 8px;font-size:11.5px}\n.phone .stats{gap:14px;margin-top:10px}\n.phone .stats b{font-size:15px}\n.phone .legend{gap:12px;margin-top:10px;font-size:11.5px}\n.phone .lanes{margin-top:12px}\n.phone .lane{grid-template-columns:44px minmax(0,1fr) 34px;column-gap:9px;padding:11px 0}\n.phone .strip--now{height:12px}\n.phone .strip--prev{height:9px}\n.phone .lane__date{font-size:12.5px}\n.phone .lane__tot,.phone .lane__diff{font-size:12px}\n.phone__foot{margin-top:12px}\n.textlink{font-size:12.5px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-strong);padding-bottom:1px}\n.textlink:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n</style>\n<div class=\"page\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"head\" data-kid=\"1-1\" data-name=\"dashboard header bar\">\n<h1 data-kid=\"1-1-1\" data-name=\"dashboard title heading\">Cooks</h1>\n<div aria-label=\"Range\" class=\"segmented\" data-kid=\"1-1-2\" data-name=\"period range segmented control\" role=\"group\">\n<button aria-pressed=\"false\" data-kid=\"1-1-2-1\" data-name=\"1 week range toggle button\" type=\"button\">1 week</button>\n<button aria-pressed=\"true\" data-kid=\"1-1-2-2\" data-name=\"1 month range toggle button\" type=\"button\">1 month</button>\n<button aria-pressed=\"false\" data-kid=\"1-1-2-3\" data-name=\"1 year range toggle button\" type=\"button\">1 year</button>\n</div>\n</div>\n<p class=\"periods\" data-kid=\"1-2\" data-name=\"period range comparison text\">7 October – 3 November 2026, against 7 September – 6 October 2026</p>\n<ul class=\"stats\" data-kid=\"1-3\" data-name=\"key stats indicator row\">\n<li data-kid=\"1-3-1\" data-name=\"cooks stat item\"><b class=\"num\" data-kid=\"1-3-1-1\" data-name=\"cooks stat value\">33</b><span data-kid=\"1-3-1-2\" data-name=\"cooks stat label\">cooks</span></li>\n<li data-kid=\"1-3-2\" data-name=\"previous cooks stat item\"><b class=\"num\" data-kid=\"1-3-2-1\" data-name=\"previous cooks stat value\">26</b><span data-kid=\"1-3-2-2\" data-name=\"previous cooks stat label\">previous</span></li>\n<li data-kid=\"1-3-3\" data-name=\"cooks change stat item\"><b class=\"num\" data-kid=\"1-3-3-1\" data-name=\"cooks increase value\">+7</b><em data-kid=\"1-3-3-2\" data-name=\"cooks change percentage\">+27%</em></li>\n</ul>\n<section class=\"alt\" data-kid=\"1-4\" data-name=\"paired columns chart section\">\n<div class=\"alt__head\" data-kid=\"1-4-1\" data-name=\"chart section header row\">\n<h2 data-kid=\"1-4-1-1\" data-name=\"paired columns chart heading\">Paired columns</h2>\n<ul class=\"legend\" data-kid=\"1-4-1-2\" data-name=\"chart funding legend\">\n<li data-kid=\"1-4-1-2-1\" data-name=\"gift-funded legend item\"><span aria-hidden=\"true\" class=\"sw sw--gift\" data-kid=\"1-4-1-2-1-1\" data-name=\"gift-funded color swatch\"></span>Gift-funded</li>\n<li data-kid=\"1-4-1-2-2\" data-name=\"credit-funded legend item\"><span aria-hidden=\"true\" class=\"sw sw--credit\" data-kid=\"1-4-1-2-2-1\" data-name=\"credit-funded color swatch\"></span>Credit-funded</li>\n<li data-kid=\"1-4-1-2-3\" data-name=\"previous period legend item\"><span aria-hidden=\"true\" class=\"sw sw--prev\" data-kid=\"1-4-1-2-3-1\" data-name=\"previous period color swatch\"></span>Previous period</li>\n</ul>\n</div>\n<div class=\"plotA\" data-kid=\"1-4-2\" data-name=\"paired columns plot area\">\n<div aria-hidden=\"true\" class=\"axisA\" data-kid=\"1-4-2-1\" data-name=\"vertical value axis labels\">\n<span data-kid=\"1-4-2-1-1\" data-name=\"axis top value label\" style=\"--t:10\">10</span><span data-kid=\"1-4-2-1-2\" data-name=\"axis mid value label\" style=\"--t:5\">5</span><span data-kid=\"1-4-2-1-3\" data-name=\"axis zero value label\" style=\"--t:0\">0</span>\n</div>\n<div c