      "html": "<style>\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.024 95), oklch(0.185 0.018 70));\n    --foreground: light-dark(oklch(0.255 0.055 62), oklch(0.945 0.022 92));\n    --card: light-dark(oklch(0.985 0.014 95), oklch(0.235 0.020 70));\n    --secondary: light-dark(oklch(0.930 0.055 88), oklch(0.270 0.026 72));\n    --muted-foreground: light-dark(oklch(0.465 0.045 64), oklch(0.745 0.028 88));\n    --primary: light-dark(oklch(0.812 0.160 82), oklch(0.845 0.160 84));\n    --primary-foreground: light-dark(oklch(0.235 0.048 70), oklch(0.210 0.045 70));\n    --accent: light-dark(oklch(0.938 0.060 86), oklch(0.310 0.045 78));\n    --accent-foreground: light-dark(oklch(0.320 0.065 70), oklch(0.915 0.045 86));\n    --border: light-dark(oklch(0.885 0.032 82), oklch(0.330 0.022 72));\n    --veg-ink: light-dark(oklch(0.450 0.130 140), oklch(0.790 0.120 140));\n    --radius: 0.5rem;\n    --radius-sm: 4px;\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) + 4px);\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }\n  h2, p, ol, li { margin: 0; padding: 0; }\n  ol { list-style: none; }\n  a { color: inherit; }\n\n  .packs { padding: 64px 0 72px; }\n  .wrap { max-width: 1152px; margin: 0 auto; padding: 0 32px; }\n  @media (max-width: 640px) { .wrap { padding: 0 20px; } }\n\n  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .head h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .head p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .grid { margin-top: 24px; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }\n  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }\n\n  .pack {\n    display: flex; flex-direction: column;\n    border: 1px solid var(--border); border-radius: var(--radius-lg);\n    background: var(--card); overflow: hidden; min-height: 236px;\n  }\n  .pack__head { display: flex; justify-content: flex-start; padding: 14px 14px 0; min-height: 36px; }\n  .flag {\n    display: inline-flex; align-items: center; min-height: 22px; padding: 0 7px;\n    border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-foreground);\n    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase;\n  }\n\n  .stub { flex: 1; display: grid; grid-template-columns: 92px minmax(0, 1fr); margin-top: 8px; }\n  .spine {\n    position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-start; gap: 3px;\n    padding: 12px 0 0 12px; border-right: 1px solid var(--border);\n    background: color-mix(in oklab, var(--secondary) 72%, var(--card));\n  }\n  .spine i {\n    position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--f) * (100% - 56px));\n    background: linear-gradient(to top, color-mix(in oklab, var(--primary) 70%, var(--foreground)), var(--primary));\n  }\n  .spine__lab {\n    position: relative; z-index: 1;\n    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.13em; text-transform: uppercase;\n    color: color-mix(in oklab, var(--foreground) 62%, transparent);\n  }\n  .spine__n { position: relative; z-index: 1; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 24px; line-height: 1; letter-spacing: -0.02em; }\n\n  .spec { display: flex; flex-direction: column; justify-content: center; padding: 12px 14px 14px; }\n  .price { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 30px; line-height: 1; letter-spacing: -0.03em; }\n  .rate { margin-top: 6px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 11px; color: var(--muted-foreground); }\n\n  .buy {\n    margin: 0 14px 14px; display: inline-flex; align-items: center; justify-content: center;\n    min-height: 40px; padding: 0 8px; border: 1px solid var(--border); border-radius: var(--radius-md);\n    color: var(--foreground); font-size: 12px; font-weight: 600; text-decoration: none; white-space: nowrap;\n  }\n  .buy:hover { border-color: var(--foreground); }\n\n  .pack--starter { border-color: color-mix(in oklab, var(--veg-ink) 40%, var(--border)); }\n  .pack--starter .buy { background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }\n  .pack--best { border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n\n  .fine { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }\n</style>\n<section aria-labelledby=\"credits-heading\" class=\"packs\" data-kid=\"1\" data-name=\"credits pricing section\" id=\"credits\">\n<div class=\"wrap\" data-kid=\"1-1\" data-name=\"column wrapper for pricing content\">\n<div class=\"head\" data-kid=\"1-1-1\" data-name=\"section heading row\">\n<h2 data-kid=\"1-1-1-1\" data-name='heading title \"Credits\"' id=\"credits-heading\">Credits</h2>\n<p data-kid=\"1-1-1-2\" data-name=\"heading subtitle about one-time purchase\">One-time purchase. No subscription.</p>\n</div>\n<ol class=\"grid\" data-kid=\"1-1-2\" data-name=\"grid list of credit packs\">\n<li class=\"pack pack--starter\" data-kid=\"1-1-2-1\" data-name=\"starter pack card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-1-1\" data-name=\"pack header slot\"><span class=\"flag\" data-kid=\"1-1-2-1-1-1\" data-name=\"starter pack badge flag\">Starter, once only</span></div>\n<div class=\"stub\" data-kid=\"1-1-2-1-2\" data-name=\"pack body layout container\">\n<div class=\"spine\" data-kid=\"1-1-2-1-2-1\" data-name=\"credit meter spine panel\">\n<i data-kid=\"1-1-2-1-2-1-1\" data-name=\"credit meter fill bar\" style=\"--f:0.29\"></i>\n<span class=\"spine__lab\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"spine unit label\">Credits</span>\n<span class=\"spine__n\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"spine credit count value\">10</span>\n</div>\n<div class=\"spec\" data-kid=\"1-1-2-1-2-2\" data-name=\"pricing spec block\">\n<p class=\"price\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"starter pack price\">NZ$4</p>\n<p class=\"rate\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"starter pack per-credit rate\">NZ$0.40 per Credit</p>\n</div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-1-3\" data-name=\"starter pack buy button\" href=\"/pantry\">Buy Starter pack</a>\n</li>\n<li class=\"pack\" data-kid=\"1-1-2-2\" data-name=\"20 credit pack card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-2-1\" data-name=\"pack header slot\"></div>\n<div class=\"stub\" data-kid=\"1-1-2-2-2\" data-name=\"pack body layout container\">\n<div class=\"spine\" data-kid=\"1-1-2-2-2-1\" data-name=\"credit meter spine panel\">\n<i data-kid=\"1-1-2-2-2-1-1\" data-name=\"credit meter fill bar\" style=\"--f:0.41\"></i>\n<span class=\"spine__lab\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"spine unit label\">Credits</span>\n<span class=\"spine__n\" data-kid=\"1-1-2-2-2-1-3\" data-name=\"spine credit count value\">20</span>\n</div>\n<div class=\"spec\" data-kid=\"1-1-2-2-2-2\" data-name=\"pricing spec block\">\n<p class=\"price\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"20 credit pack price\">NZ$8</p>\n<p class=\"rate\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"20 credit pack per-credit rate\">NZ$0.40 per Credit</p>\n</div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-2-3\" data-name=\"20 credit pack buy button\" href=\"/pantry\">Buy 20 Credits</a>\n</li>\n<li class=\"pack\" data-kid=\"1-1-2-3\" data-name=\"50 credit pack card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-3-1\" data-name=\"pack header slot\"></div>\n<div class=\"stub\" data-kid=\"1-1-2-3-2\" data-name=\"pack body layout container\">\n<div class=\"spine\" data-kid=\"1-1-2-3-2-1\" data-name=\"credit meter spine panel\">\n<i data-kid=\"1-1-2-3-2-1-1\" data-name=\"credit meter fill bar\" style=\"--f:0.65\"></i>\n<span class=\"spine__lab\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"spine unit label\">Credits</span>\n<span class=\"spine__n\" data-kid=\"1-1-2-3-2-1-3\" data-name=\"spine credit count value\">50</span>\n</div>\n<div class=\"spec\" data-kid=\"1-1-2-3-2-2\" data-name=\"pricing spec block\">\n<p class=\"price\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"50 credit pack price\">NZ$16</p>\n<p class=\"rate\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"50 credit pack per-credit rate\">NZ$0.32 per Credit</p>\n</div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-3-3\" data-name=\"50 credit pack buy button\" href=\"/pantry\">Buy 50 Credits</a>\n</li>\n<li class=\"pack pack--best\" data-kid=\"1-1-2-4\" data-name=\"best rate pack card\">\n<div class=\"pack__head\" data-kid=\"1-1-2-4-1\" data-name=\"pack header slot\"><span class=\"flag\" data-kid=\"1-1-2-4-1-1\" data-name=\"best rate badge flag\">Best rate</span></div>\n<div class=\"stub\" data-kid=\"1-1-2-4-2\" data-name=\"pack body layout container\">\n<div class=\"spine\" data-kid=\"1-1-2-4-2-1\" data-name=\"credit meter spine panel\">\n<i data-kid=\"1-1-2-4-2-1-1\" data-name=\"credit meter fill bar\" style=\"--f:1\"></i>\n<span class=\"spine__lab\" data-kid=\"1-1-2-4-2-1-2\" data-name=\"spine unit label\">Credits</span>\n<span class=\"spine__n\" data-kid=\"1-1-2-4-2-1-3\" data-name=\"spine credit count value\">120</span>\n</div>\n<div class=\"spec\" data-kid=\"1-1-2-4-2-2\" data-name=\"pricing spec block\">\n<p class=\"price\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"120 credit pack price\">NZ$32</p>\n<p class=\"rate\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"120 credit pack per-credit rate\">NZ$0.27 per Credit</p>\n</div>\n</div>\n<a class=\"buy\" data-kid=\"1-1-2-4-3\" data-name=\"120 credit pack buy button\" href=\"/pantry\">Buy 120 Credits</a>\n</li>\n</ol>\n<p class=\"fine\" data-kid=\"1-1-3\" data-name=\"footer fine print note\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</div>\n</section>",
      "comments": [],
      "created": "2026-11-14T09:57:42.303476+00:00",
      "modified": "2026-11-14T10:01:40.507790+00:00",
      "id": "var_f2862ce56ea6",
      "contentHeight": 467
    },
    "var_99f241c226a6": {
      "type": "variant",
      "label": "Type roles — four stacks, one job each",
      "parentId": "var_f2862ce56ea6",
      "themeId": null,
      "rect": {
        "x": 37893,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --paper:oklch(0.968 0.026 88);\n  --card:oklch(0.994 0.008 88);\n  --tint:oklch(0.940 0.038 86);\n  --ink:oklch(0.255 0.045 45);\n  --ink-muted:oklch(0.470 0.040 48);\n  --ink-faint:oklch(0.545 0.032 50);\n  --rule:oklch(0.885 0.030 70);\n  --rule-hair:oklch(0.918 0.026 76);\n  --accent:oklch(0.505 0.180 32);\n  --font-ui:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  --font-read:Seravek,\"Gill Sans Nova\",Ubuntu,Calibri,\"Noto Sans\",\"DejaVu Sans\",source-sans-pro,sans-serif;\n  --font-name:Georgia,\"Times New Roman\",serif;\n  --font-fig:ui-monospace,\"Cascadia Code\",\"Source Code Pro\",Menlo,Consolas,\"DejaVu Sans Mono\",monospace;\n  --font-hand:\"Segoe Print\",\"Bradley Hand\",Chilanka,TSCu_Comic,casual,cursive;\n}\nhtml{color-scheme:light}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-ui);font-size:14px;line-height:1.45}\n.sheet{max-width:1160px;margin:0 auto;padding:40px 32px 72px}\n.title{font-size:25px;font-weight:600;letter-spacing:-.02em;margin:0}\n.headrule{height:1px;background:var(--ink);margin-top:16px}\n.mono{font-family:var(--font-fig);font-variant-numeric:tabular-nums;letter-spacing:0}\n\n/* stack declarations */\n.stack{display:grid;grid-template-columns:200px minmax(0,1fr) 168px;column-gap:28px;align-items:baseline;padding:18px 0;border-bottom:1px solid var(--rule-hair)}\n.stack:first-of-type{border-top:1px solid var(--rule-hair)}\n.stack__name{font-size:29px;line-height:1.05;letter-spacing:-.02em}\n.stack__decl{font-family:var(--font-fig);font-size:10.5px;line-height:1.6;color:var(--ink);word-break:break-word}\n.stack__where{font-size:12px;line-height:1.5;color:var(--ink-muted);margin-top:7px;max-width:52ch}\n.stack__weights{font-family:var(--font-fig);font-size:10px;line-height:1.75;color:var(--ink-muted);text-align:left}\n.stack__weights b{font-weight:400;color:var(--ink)}\n\n/* contested roles */\n.glabel{font-family:var(--font-fig);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-muted)}\n.matrix{margin-top:40px}\n.matrix__head{display:grid;grid-template-columns:164px repeat(4,minmax(0,1fr));column-gap:14px;padding:0 0 8px;border-bottom:1px solid var(--rule);align-items:end}\n.matrix__head span:not(:first-child){padding-left:2px}\n.matrix__row{display:grid;grid-template-columns:164px repeat(4,minmax(0,1fr));column-gap:14px;padding:16px 0 18px;border-bottom:1px solid var(--rule-hair);align-items:start}\n.matrix__role{font-size:12.5px;color:var(--ink-muted);padding-top:11px}\n.cell{padding:10px 12px 11px;border:1px solid transparent;border-radius:4px;line-height:1.24;min-height:100%}\n.cell--win{background:var(--card);border-color:var(--rule)}\n.cell__face{display:block;font-family:var(--font-fig);font-size:9px;letter-spacing:.05em;color:var(--ink-muted);margin-top:11px}\n\n/* resolved map */\n.map{margin-top:44px}\n.map__group{display:grid;grid-template-columns:164px minmax(0,1fr);column-gap:28px;align-items:center;margin-top:30px}\n.map__group:first-of-type{margin-top:0}\n.map__groupline{height:1px;background:var(--rule)}\n.map__row{display:grid;grid-template-columns:164px minmax(0,1fr) 150px;column-gap:28px;align-items:baseline;padding:8px 0 9px;border-bottom:1px solid var(--rule-hair)}\n.map__role{font-size:12.5px;color:var(--ink-muted)}\n.map__sample{min-width:0}\n.map__face{font-family:var(--font-fig);font-size:10px;color:var(--ink-faint);text-align:right}\n</style>\n<main class=\"sheet\" data-kid=\"1\" data-name=\"page content sheet container\">\n<h1 class=\"title\" data-kid=\"1-1\" data-name=\"page main headline\">Type roles</h1>\n<div class=\"headrule\" data-kid=\"1-2\" data-name=\"headline underline rule\"></div>\n<section aria-label=\"Stack declarations\" class=\"stacks\" data-kid=\"1-3\" data-name=\"font stack declarations section\">\n<div class=\"stack\" data-kid=\"1-3-1\" data-name=\"font stack row for humanist\">\n<div class=\"stack__name\" data-kid=\"1-3-1-1\" data-name=\"humanist face sample label\" style=\"font-family:var(--font-read)\">Humanist</div>\n<div data-kid=\"1-3-1-2\" data-name=\"humanist stack detail container\">\n<div class=\"stack__decl\" data-kid=\"1-3-1-2-1\" data-name=\"humanist font declaration list\">Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif</div>\n<p class=\"stack__where\" data-kid=\"1-3-1-2-2\" data-name=\"humanist usage guidance text\">Method text, headnote, empty states, help copy. Anything read past one line.</p>\n</div>\n<div class=\"stack__weights\" data-kid=\"1-3-1-3\" data-name=\"humanist weight notes column\"><b data-kid=\"1-3-1-3-1\" data-name=\"humanist available weights value\">400 500 700</b><br data-kid=\"1-3-1-3-2\" data-name=\"line break separator\"/>no 600 on Seravek, Calibri or Ubuntu<br data-kid=\"1-3-1-3-3\" data-name=\"humanist weight caveat note\"/>Noto Sans inserted ahead of DejaVu</div>\n</div>\n<div class=\"stack\" data-kid=\"1-3-2\" data-name=\"font stack row for serif\">\n<div class=\"stack__name\" data-kid=\"1-3-2-1\" data-name=\"serif face sample label\" style=\"font-family:var(--font-name)\">Serif</div>\n<div data-kid=\"1-3-2-2\" data-name=\"serif stack detail container\">\n<div class=\"stack__decl\" data-kid=\"1-3-2-2-1\" data-name=\"serif font declaration list\">Georgia, \"Times New Roman\", serif</div>\n<p class=\"stack__where\" data-kid=\"1-3-2-2-2\" data-name=\"serif usage guidance text\">Dish name, headnote, wordmark, footer brand. A name, never body copy.</p>\n</div>\n<div class=\"stack__weights\" data-kid=\"1-3-2-3\" data-name=\"serif weight notes column\"><b data-kid=\"1-3-2-3-1\" data-name=\"serif available weights value\">400 700 + italic</b><br data-kid=\"1-3-2-3-2\" data-name=\"line break separator\"/>no 500 or 600<br data-kid=\"1-3-2-3-3\" data-name=\"serif hierarchy note\"/>hierarchy comes from size and italic</div>\n</div>\n<div class=\"stack\" data-kid=\"1-3-3\" data-name=\"font stack row for monospace\">\n<div class=\"stack__name\" data-kid=\"1-3-3-1\" data-name=\"monospace face sample label\" style=\"font-family:var(--font-fig)\">Monospace</div>\n<div data-kid=\"1-3-3-2\" data-name=\"monospace stack detail container\">\n<div class=\"stack__decl\" data-kid=\"1-3-3-2-1\" data-name=\"monospace font declaration list\">ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace</div>\n<p class=\"stack__where\" data-kid=\"1-3-3-2-2\" data-name=\"monospace usage guidance text\">Every figure that has to line up: money, Credits, quantities, times, kcal, axis values, ledger columns.</p>\n</div>\n<div class=\"stack__weights\" data-kid=\"1-3-3-3\" data-name=\"monospace weight notes column\"><b data-kid=\"1-3-3-3-1\" data-name=\"monospace available weights value\">400 700</b><br data-kid=\"1-3-3-3-2\" data-name=\"line break separator\"/>no 500 or 600<br data-kid=\"1-3-3-3-3\" data-name=\"monospace platform note\"/>ui-monospace resolves in Safari only</div>\n</div>\n<div class=\"stack\" data-kid=\"1-3-4\" data-name=\"font stack row for system UI\">\n<div class=\"stack__name\" data-kid=\"1-3-4-1\" data-name=\"system UI face sample label\" style=\"font-family:var(--font-ui)\">System UI</div>\n<div data-kid=\"1-3-4-2\" data-name=\"system UI stack detail container\">\n<div class=\"stack__decl\" data-kid=\"1-3-4-2-1\" data-name=\"system UI font declaration list\">system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif</div>\n<p class=\"stack__where\" data-kid=\"1-3-4-2-2\" data-name=\"system UI usage guidance text\">Nav, buttons, controls, labels, headings, one-line status. Anything clicked or scanned once.</p>\n</div>\n<div class=\"stack__weights\" data-kid=\"1-3-4-3\" data-name=\"system UI weight notes column\"><b data-kid=\"1-3-4-3-1\" data-name=\"system UI available weights value\">400–700</b><br data-kid=\"1-3-4-3-2\" data-name=\"line break separator\"/>600 snaps to 700 on Ubuntu and Cantarell<br data-kid=\"1-3-4-3-3\" data-name=\"system UI snapping caveat\"/>only stack with a full ladder</div>\n</div>\n<div class=\"stack\" data-kid=\"1-3-5\" data-name=\"font stack row for handwritten\">\n<div class=\"stack__name\" data-kid=\"1-3-5-1\" data-name=\"handwritten face sample label\" style=\"font-family:var(--font-hand)\">Handwritten</div>\n<div data-kid=\"1-3-5-2\" data-name=\"handwritten stack detail container\">\n<div class=\"stack__decl\" data-kid=\"1-3-5-2-1\" data-name=\"handwritten font declaration list\">\"Segoe Print\", \"Bradley Hand\", Chilanka, TSCu_Comic, casual, cursive</div>\n<p class=\"stack__where\" data-kid=\"1-3-5-2-2\" data-name=\"handwritten usage guidance text\">Nothing structural. Carried into the method experiment only, to see what it does.</p>\n</div>\n<div class=\"stack__weights\" data-kid=\"1-3-5-3\" data-name=\"handwritten weight notes column\"><b data-kid=\"1-3-5-3-1\" data-name=\"handwritten available weights value\">400 Windows · 700 Apple</b><br data-kid=\"1-3-5-3-2\" data-name=\"line break separator\"/>no face at all on Linux<br data-kid=\"1-3-5-3-3\" data-name=\"handwritten platform note\"/>one face per platform, never a choice</div>\n</div>\n</section>\n<section aria-labelledby=\"contested\" class=\"matrix\" data-kid=\"1-4\" data-name=\"contested roles comparison section\">\n<h2 class=\"glabel\" data-kid=\"1-4-1\" data-name=\"contested roles section heading\" id=\"contested\" style=\"margin:0 0 12px\">Contested roles, same string in every face</h2>\n<div class=\"matrix__head\" data-kid=\"1-4-2\" data-name=\"comparison matrix header row\">\n<span data-kid=\"1-4-2-1\" data-name=\"header row corner spacer\"></span>\n<span data-kid=\"1-4-2-2\" data-name=\"serif column header label\">Serif</span>\n<span data-kid=\"1-4-2-3\" data-name=\"humanist column header label\">Humanist</span>\n<span data-kid=\"1-4-2-4\" data-name=\"monospace column header label\">Monospace</span>\n<span data-kid=\"1-4-2-5\" data-name=\"system UI column header label\">System UI</span>\n</div>\n<div class=\"matrix__row\" data-kid=\"1-4-3\" data-name=\"comparison row for dish name\">\n<div class=\"matrix__role\" data-kid=\"1-4-3-1\" data-name=\"dish name role label\">Dish name</div>\n<div class=\"cell cell--win\" data-kid=\"1-4-3-2\" data-name=\"winning cell for dish name in serif\">\n<span data-kid=\"1-4-3-2-1\" data-name=\"dish name sample in serif\" style=\"font-family:var(--font-name);font-size:20px;line-height:1.2;letter-spacing:-.01em\">Kūmara, chickpea and silverbeet traybake</span>\n<span class=\"cell__face\" data-kid=\"1-4-3-2-2\" data-name=\"serif face attribution label\">Georgia</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-3-3\" data-name=\"comparison cell for dish name in humanist\">\n<span data-kid=\"1-4-3-3-1\" data-name=\"dish name sample in humanist\" style=\"font-family:var(--font-read);font-size:19px;line-height:1.2;letter-spacing:-.01em\">Kūmara, chickpea and silverbeet traybake</span>\n<span class=\"cell__face\" data-kid=\"1-4-3-3-2\" data-name=\"humanist face attribution label\">Humanist</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-3-4\" data-name=\"comparison cell for dish name in monospace\">\n<span data-kid=\"1-4-3-4-1\" data-name=\"dish name sample in monospace\" style=\"font-family:var(--font-fig);font-size:14px;line-height:1.35\">Kūmara, chickpea and silverbeet traybake</span>\n<span class=\"cell__face\" data-kid=\"1-4-3-4-2\" data-name=\"monospace face attribution label\">Monospace</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-3-5\" data-name=\"comparison cell for dish name in system UI\">\n<span data-kid=\"1-4-3-5-1\" data-name=\"dish name sample in system UI\" style=\"font-family:var(--font-ui);font-size:19px;font-weight:600;line-height:1.2;letter-spacing:-.01em\">Kūmara, chickpea and silverbeet traybake</span>\n<span class=\"cell__face\" data-kid=\"1-4-3-5-2\" data-name=\"system UI face attribution label\">System UI 600</span>\n</div>\n</div>\n<div class=\"matrix__row\" data-kid=\"1-4-4\" data-name=\"comparison row for method step\">\n<div class=\"matrix__role\" data-kid=\"1-4-4-1\" data-name=\"method step role label\">Method step</div>\n<div class=\"cell\" data-kid=\"1-4-4-2\" data-name=\"comparison cell for method step in serif\">\n<span data-kid=\"1-4-4-2-1\" data-name=\"method step sample in serif\" style=\"font-family:var(--font-name);font-size:14px;line-height:1.55\">Fold the torn leaves through in handfuls; they wilt in the residual heat.</span>\n<span class=\"cell__face\" data-kid=\"1-4-4-2-2\" data-name=\"serif face attribution label\">Georgia</span>\n</div>\n<div class=\"cell cell--win\" data-kid=\"1-4-4-3\" data-name=\"winning cell for method step in humanist\">\n<span data-kid=\"1-4-4-3-1\" data-name=\"method step sample in humanist\" style=\"font-family:var(--font-read);font-size:15px;line-height:1.55\">Fold the torn leaves through in handfuls; they wilt in the residual heat.</span>\n<span class=\"cell__face\" data-kid=\"1-4-4-3-2\" data-name=\"humanist face attribution label\">Humanist</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-4-4\" data-name=\"comparison cell for method step in monospace\">\n<span data-kid=\"1-4-4-4-1\" data-name=\"method step sample in monospace\" style=\"font-family:var(--font-fig);font-size:11.5px;line-height:1.6\">Fold the torn leaves through in handfuls; they wilt in the residual heat.</span>\n<span class=\"cell__face\" data-kid=\"1-4-4-4-2\" data-name=\"monospace face attribution label\">Monospace</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-4-5\" data-name=\"comparison cell for method step in system UI\">\n<span data-kid=\"1-4-4-5-1\" data-name=\"method step sample in system UI\" style=\"font-family:var(--font-ui);font-size:14px;line-height:1.5\">Fold the torn leaves through in handfuls; they wilt in the residual heat.</span>\n<span class=\"cell__face\" data-kid=\"1-4-4-5-2\" data-name=\"system UI face attribution label\">System UI</span>\n</div>\n</div>\n<div class=\"matrix__row\" data-kid=\"1-4-5\" data-name=\"comparison row for quantity and unit\">\n<div class=\"matrix__role\" data-kid=\"1-4-5-1\" data-name=\"quantity and unit role label\">Quantity and unit</div>\n<div class=\"cell\" data-kid=\"1-4-5-2\" data-name=\"comparison cell for quantity in serif\">\n<span data-kid=\"1-4-5-2-1\" data-name=\"quantity sample in serif\" style=\"font-family:var(--font-name);font-size:18px\">800 g · 2 tbsp</span>\n<span class=\"cell__face\" data-kid=\"1-4-5-2-2\" data-name=\"serif face attribution label\">Georgia, old-style figures</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-5-3\" data-name=\"comparison cell for quantity in humanist\">\n<span data-kid=\"1-4-5-3-1\" data-name=\"quantity sample in humanist\" style=\"font-family:var(--font-read);font-size:18px\">800 g · 2 tbsp</span>\n<span class=\"cell__face\" data-kid=\"1-4-5-3-2\" data-name=\"humanist face attribution label\">Humanist</span>\n</div>\n<div class=\"cell cell--win\" data-kid=\"1-4-5-4\" data-name=\"winning cell for quantity in monospace\">\n<span data-kid=\"1-4-5-4-1\" data-name=\"quantity sample in monospace\" style=\"font-family:var(--font-fig);font-size:16px\">800 g · 2 tbsp</span>\n<span class=\"cell__face\" data-kid=\"1-4-5-4-2\" data-name=\"monospace face attribution label\">Monospace, fixed width</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-5-5\" data-name=\"comparison cell for quantity in system UI\">\n<span data-kid=\"1-4-5-5-1\" data-name=\"quantity sample in system UI\" style=\"font-family:var(--font-ui);font-size:18px;font-variant-numeric:tabular-nums\">800 g · 2 tbsp</span>\n<span class=\"cell__face\" data-kid=\"1-4-5-5-2\" data-name=\"system UI face attribution label\">System UI, tabular</span>\n</div>\n</div>\n<div class=\"matrix__row\" data-kid=\"1-4-6\" data-name=\"comparison row for credits balance\">\n<div class=\"matrix__role\" data-kid=\"1-4-6-1\" data-name=\"credits balance role label\">Credits balance</div>\n<div class=\"cell\" data-kid=\"1-4-6-2\" data-name=\"comparison cell for credits in serif\">\n<span data-kid=\"1-4-6-2-1\" data-name=\"credits sample in serif\" style=\"font-family:var(--font-name);font-size:30px\">143</span>\n<span class=\"cell__face\" data-kid=\"1-4-6-2-2\" data-name=\"serif face attribution label\">Georgia, proportional</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-6-3\" data-name=\"comparison cell for credits in humanist\">\n<span data-kid=\"1-4-6-3-1\" data-name=\"credits sample in humanist\" style=\"font-family:var(--font-read);font-size:30px\">143</span>\n<span class=\"cell__face\" data-kid=\"1-4-6-3-2\" data-name=\"humanist face attribution label\">Humanist</span>\n</div>\n<div class=\"cell cell--win\" data-kid=\"1-4-6-4\" data-name=\"winning cell for credits in monospace\">\n<span data-kid=\"1-4-6-4-1\" data-name=\"credits sample in monospace\" style=\"font-family:var(--font-fig);font-size:27px\">143</span>\n<span class=\"cell__face\" data-kid=\"1-4-6-4-2\" data-name=\"monospace face attribution label\">Monospace</span>\n</div>\n<div class=\"cell\" data-kid=\"1-4-6-5\" data-name=\"comparison cell for credits in system UI\">\n<span data-kid=\"1-4-6-5-1\" data-name=\"credits sample in system UI\" style=\"font-family:var(--font-ui);font-size:30px;font-variant-numeric:tabular-nums\">143</span>\n<span class=\"cell__face\" data-kid=\"1-4-6-5-2\" data-name=\"system UI face attribution label\">System UI, tabular</span>\n</div>\n</div>\n</section>\n<section aria-label=\"Resolved face per role\" class=\"map\" data-kid=\"1-5\" data-name=\"resolved face map section\" style=\"border-top:1px solid var(--ink);padding-top:26px\">\n<div class=\"map__group\" data-kid=\"1-5-1\" data-name=\"recipe group header row\"><span class=\"glabel\" data-kid=\"1-5-1-1\" data-name=\"recipe group label\">Recipe</span><span class=\"map__groupline\" data-kid=\"1-5-1-2\" data-name=\"recipe group rule line\"></span></div>\n<div class=\"map__row\" data-kid=\"1-5-2\" dat