      "html": "<style>\n  \n\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.958 0.026 80), oklch(0.190 0.014 70));\n    --foreground: light-dark(oklch(0.255 0.028 58), oklch(0.930 0.015 85));\n    --card: light-dark(oklch(0.988 0.008 80), oklch(0.235 0.016 70));\n    --card-foreground: light-dark(oklch(0.255 0.028 58), oklch(0.930 0.015 85));\n    --secondary: light-dark(oklch(0.930 0.032 76), oklch(0.268 0.026 72));\n    --secondary-foreground: light-dark(oklch(0.255 0.028 58), oklch(0.930 0.015 85));\n    --muted: light-dark(oklch(0.936 0.026 78), oklch(0.262 0.020 76));\n    --muted-foreground: light-dark(oklch(0.495 0.022 70), oklch(0.715 0.018 82));\n    --primary: light-dark(oklch(0.425 0.088 150), oklch(0.760 0.095 150));\n    --primary-foreground: light-dark(oklch(0.975 0.012 90), oklch(0.200 0.020 150));\n    --accent: light-dark(oklch(0.900 0.038 150), oklch(0.300 0.028 150));\n    --accent-foreground: light-dark(oklch(0.300 0.035 150), oklch(0.880 0.030 150));\n    --border: light-dark(oklch(0.868 0.028 78), oklch(0.320 0.018 80));\n    --input: light-dark(oklch(0.848 0.030 78), oklch(0.340 0.020 80));\n    --ring: light-dark(oklch(0.425 0.088 150), oklch(0.760 0.095 150));\n\n    --field: light-dark(oklch(0.330 0.045 55), oklch(0.255 0.040 55));\n    --field-foreground: light-dark(oklch(0.960 0.020 85), oklch(0.940 0.018 85));\n    --field-muted: light-dark(oklch(0.815 0.025 80), oklch(0.760 0.022 80));\n    --field-border: light-dark(oklch(0.440 0.030 55), oklch(0.380 0.035 55));\n\n    --veg: light-dark(oklch(0.620 0.115 150), oklch(0.820 0.100 150));\n    --veg-ink: light-dark(oklch(0.440 0.090 150), oklch(0.760 0.090 152));\n    --meat: light-dark(oklch(0.440 0.110 27), oklch(0.560 0.120 27));\n    --fruit: light-dark(oklch(0.760 0.140 76), oklch(0.830 0.125 76));\n    --fruit-ink: light-dark(oklch(0.520 0.120 62), oklch(0.840 0.110 76));\n    --chart-1: var(--veg);\n    --chart-2: var(--meat);\n    --chart-1-past: light-dark(oklch(0.885 0.028 150), oklch(0.335 0.032 150));\n    --chart-2-past: light-dark(oklch(0.885 0.032 27), oklch(0.345 0.040 27));\n    --chart-past-rim: light-dark(oklch(0.620 0.018 70), oklch(0.530 0.018 80));\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) - 4px);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) + 4px);\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n\n    --leading-tight: 1.2;\n    --leading-body: 1.55;\n    --tracking-display: -0.02em;\n    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  html:has(#scheme-light:checked) { color-scheme: light; }\n  html:has(#scheme-dark:checked) { color-scheme: dark; }\n\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: 15px;\n    line-height: var(--leading-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, h3, p, dl, dd, dt, ol, ul, fieldset, legend { margin: 0; }\n  ul, ol { padding: 0; list-style: none; }\n  a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }\n\n  .wrap { width: 100%; max-width: 1152px; margin: 0 auto; padding: 0 20px; box-sizing: border-box; }\n  @media (min-width: 768px) { .wrap { padding: 0 32px; } }\n\n  .label {\n    font-family: var(--font-mono);\n    font-size: 10px;\n    line-height: 1.4;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n\n  .site-header { border-bottom: 1px solid var(--border); }\n  .site-header .wrap { display: flex; align-items: center; gap: 32px; height: 80px; }\n  .wordmark { font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1; letter-spacing: -0.01em; color: var(--foreground); text-decoration: none; }\n  .site-nav { display: none; align-items: center; gap: 24px; }\n  @media (min-width: 768px) { .site-nav { display: flex; } }\n  .site-nav a { font-size: 14px; color: var(--muted-foreground); text-decoration: none; }\n  .site-nav a:hover { color: var(--foreground); }\n  .btn {\n    margin-left: auto;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 44px;\n    padding: 0 20px;\n    border: 1px solid var(--primary);\n    border-radius: var(--radius-md);\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.2;\n    text-decoration: none;\n    white-space: nowrap;\n    transition: background-color 120ms var(--ease-out), transform 120ms var(--ease-out);\n  }\n  .btn:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n  .btn:active { transform: scale(0.97); }\n\n  .hero__inner { padding: 40px 0; }\n  @media (min-width: 768px) { .hero__inner { padding: 48px 0; } }\n  .hero__grid { display: grid; gap: 24px; }\n  @media (min-width: 768px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 336px; gap: 64px; align-items: end; } }\n  .hero__title { max-width: 700px; font-size: 30px; font-weight: 600; line-height: 1.08; letter-spacing: -0.025em; }\n  .hero__title .ln { display: inline; }\n  @media (min-width: 768px) { .hero__title { font-size: 42px; } .hero__title .ln { display: block; } }\n  .hero__note { max-width: 340px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 15px; color: var(--muted-foreground); }\n  @media (min-width: 768px) { .hero__note { padding-top: 0; border-top: 0; } }\n\n  .specimen {\n    margin-top: 32px;\n    display: grid;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n  }\n  @media (min-width: 768px) { .specimen { margin-top: 40px; } }\n  @media (min-width: 1024px) { .specimen { grid-template-columns: 300px minmax(0, 1fr); } }\n  .specimen__pantry {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 20px;\n    border-bottom: 1px solid var(--border);\n    background: var(--secondary);\n  }\n  @media (min-width: 1024px) { .specimen__pantry { border-bottom: 0; border-right: 1px solid var(--border); } }\n  .pantry__list { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }\n  .tape {\n    display: inline-flex;\n    align-items: center;\n    min-height: 32px;\n    padding: 0 11px;\n    border: 1px dashed color-mix(in oklab, var(--border) 55%, var(--foreground));\n    border-radius: var(--radius-sm);\n    background: var(--card);\n    color: var(--foreground);\n    font-size: 14px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n  .pantry__attrs { display: grid; gap: 8px; padding-top: 16px; border-top: 1px solid var(--border); }\n  .attr { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .attr dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }\n  .attr dd { font-size: 13px; }\n\n  .specimen__body { padding: 20px; }\n  @media (min-width: 768px) { .specimen__body { padding: 24px; } }\n  .specimen__meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }\n  .tag { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: var(--veg-ink); }\n  .tag__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--veg); }\n  .specimen__title { margin-top: 8px; font-family: var(--font-display); font-size: 26px; font-weight: 600; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  @media (min-width: 768px) { .specimen__title { font-size: 30px; } }\n\n  .stats {\n    margin-top: 16px;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n    padding: 12px 0;\n    border-top: 1px solid var(--border);\n    border-bottom: 1px solid var(--border);\n  }\n  .stat dd { margin-top: 4px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 15px; font-weight: 500; letter-spacing: -0.02em; }\n\n  .pairs { margin-top: 16px; display: grid; gap: 12px; }\n  @media (min-width: 640px) { .pairs { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }\n  .pairs p { margin-top: 4px; font-size: 14px; }\n  .swap__from { color: var(--muted-foreground); text-decoration: line-through; text-decoration-thickness: 1px; }\n  .swap__arrow { padding: 0 4px; color: var(--muted-foreground); }\n  .swap__to { font-weight: 500; color: var(--fruit-ink); }\n\n  .steps { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); display: grid; gap: 8px; font-size: 14px; }\n  .step { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 8px; }\n  .step__n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 12px; line-height: 1.6; color: var(--muted-foreground); }\n\n  .field { background: var(--field); color: var(--field-foreground); }\n  .field__inner { padding: 44px 0; }\n  .field__grid { display: grid; gap: 0; }\n  @media (min-width: 768px) { .field__grid { grid-template-columns: 0.8fr 1.35fr 1fr; } }\n  .field__step { padding-top: 32px; border-top: 1px solid var(--field-border); }\n  .field__step:first-child { padding-top: 0; border-top: 0; }\n  @media (min-width: 768px) {\n    .field__step { padding: 0 0 0 24px; border-top: 0; border-left: 1px solid var(--field-border); }\n    .field__step:first-child { padding: 0 24px 0 0; border-left: 0; }\n  }\n  .field__step h3 { display: flex; align-items: baseline; gap: 8px; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; color: var(--field-foreground); }\n  .field__step h3 span { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 12px; font-weight: 400; color: var(--field-muted); }\n  .field .tape { background: transparent; border-color: var(--field-border); color: var(--field-foreground); }\n  .field .label, .field .note, .field .constraint dt { color: var(--field-muted); }\n  .field .copylist li { border-color: var(--field-border); }\n  .field .copylist li span:last-child { color: var(--field-muted); }\n\n  .chips { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }\n  .note { margin-top: 16px; font-size: 13px; color: var(--muted-foreground); }\n  .constraints { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px 24px; }\n  .constraint { display: flex; align-items: baseline; gap: 8px; }\n  .constraint dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }\n  .constraint dd { font-size: 13px; }\n  .copylist { margin-top: 16px; display: grid; gap: 8px; font-size: 13px; }\n  .copylist li { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }\n  .copylist li:last-child { padding-bottom: 0; border-bottom: 0; }\n  .copylist li span:last-child { color: var(--muted-foreground); }\n\n  .popular__inner { padding: 48px 0; }\n  @media (min-width: 768px) { .popular__inner { padding: 56px 0; } }\n  .sectionhead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }\n  .sectionhead h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; }\n  .sectionhead p { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }\n\n  .table { margin-top: 24px; border-top: 1px solid var(--border); }\n  .thead { display: none; }\n  @media (min-width: 768px) {\n    .thead {\n      display: grid;\n      grid-template-columns: 48px minmax(0, 1fr) 96px 136px 112px;\n      gap: 16px;\n      align-items: baseline;\n      padding: 8px 6px;\n      border-bottom: 1px solid var(--border);\n    }\n    .thead span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-foreground); }\n    .thead .th--num { text-align: right; }\n  }\n  .row { border-bottom: 1px solid var(--border); }\n  .row a {\n    display: grid;\n    grid-template-columns: 32px minmax(0, 1fr);\n    align-items: baseline;\n    gap: 4px 16px;\n    padding: 14px 6px;\n    color: var(--foreground);\n    text-decoration: none;\n    transition: background-color 140ms var(--ease-out);\n  }\n  .row a:hover { background: var(--accent); }\n  @media (min-width: 768px) {\n    .row a { grid-template-columns: 48px minmax(0, 1fr) 96px 136px 112px; gap: 16px; padding: 16px 6px; }\n    .row a:hover .title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }\n  }\n  .rank { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; color: var(--muted-foreground); }\n  .title { font-family: var(--font-display); font-size: 20px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }\n  .figure { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; letter-spacing: -0.02em; }\n  .unit { margin-left: 4px; font-size: 13px; color: var(--muted-foreground); }\n  @media (max-width: 767.98px) { .figure { grid-column: 2; } }\n  @media (min-width: 768px) {\n    .row .figure { text-align: right; }\n    .unit { display: none; }\n  }\n\n  .site-footer { background: var(--field); color: var(--field-foreground); }\n  .site-footer .wrap { padding-top: 32px; padding-bottom: 32px; }\n  .footer__grid { display: grid; gap: 32px; }\n  @media (min-width: 768px) { .footer__grid { grid-template-columns: minmax(0, 1fr) auto; gap: 64px; align-items: end; } }\n  .footer__brand { font-family: var(--font-display); font-size: 18px; font-weight: 600; line-height: 1; letter-spacing: var(--tracking-display); color: var(--field-foreground); }\n  .footer__note { margin-top: 12px; max-width: 46ch; font-size: 13px; color: var(--field-muted); }\n  .footer__links { margin-top: 16px; display: flex; gap: 24px; }\n  .footer__links a { font-size: 13px; color: var(--field-foreground); text-decoration: none; }\n  .footer__links a:hover { text-decoration: underline; text-underline-offset: 4px; }\n\n  .scheme { min-width: 0; padding: 0; border: 0; }\n  .scheme legend { margin-bottom: 8px; padding: 0; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--field-muted); }\n  .switch { display: inline-flex; align-items: center; gap: 4px; padding: 4px; border: 1px solid var(--field-border); border-radius: var(--radius-md); background: var(--card); }\n  .opt { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 0 12px; border-radius: calc(var(--radius-md) - 2px); font-size: 12px; color: var(--muted-foreground); cursor: pointer; }\n  .opt input { position: absolute; width: 1px; height: 1px; opacity: 0; }\n  .opt span { display: inline-flex; align-items: center; min-height: 30px; padding: 0 8px; border-radius: calc(var(--radius-md) - 3px); }\n  .opt input:checked + span { background: var(--primary); color: var(--primary-foreground); }\n  .opt input:focus-visible + span { outline: 2px solid var(--ring); outline-offset: 2px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .btn { transition: none; }\n    .btn:active { transform: none; }\n    .row a { transition: opacity 120ms linear; }\n  }\n</style>\n<div data-kid=\"1\">\n<header class=\"site-header\" data-kid=\"1-1\">\n<div class=\"wrap\" data-kid=\"1-1-1\">\n<a class=\"wordmark\" data-kid=\"1-1-1-1\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Site\" class=\"site-nav\" data-kid=\"1-1-1-2\"><a data-kid=\"1-1-1-2-1\" href=\"#popular\">Popular</a></nav>\n<a class=\"btn\" data-kid=\"1-1-1-3\" href=\"/pantry\">Start cooking</a>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline\" id=\"site-hero\"><span class=\"ln\">You’ve got the Pantry.</span> <span class=\"ln\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\" data-name=\"hero description text\">Your Diet and allergies are hard limits. You cook it, save it, and find similar dishes from the same Pantry.</p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\">\n<div data-kid=\"1-2-1-2-1-1\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" style=\"font-size:11px; letter-spacing:0.16em\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\"><dt data-kid=\"1-2-1-2-1-2-1-1\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\"><dt data-kid=\"1-2-1-2-1-2-2-1\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\"><dt data-kid=\"1-2-1-2-1-2-3-1\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" style=\"font-size:10px; letter-spacing:0.16em\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\">\n<div data-kid=\"1-2-1-2-2-4-1\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"field\" data-kid=\"1-3\">\n<div class=\"wrap field__inner\" data-kid=\"1-3-1\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-1\" id=\"process-heading\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-3-1-2\">\n<li class=\"field__step\" data-kid=\"1-3-1-2-1\">\n<h3 data-kid=\"1-3-1-2-1-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-1-1-1\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-3-1-2-1-2\">\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-1\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-2\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-3\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-3-1-2-1-3\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-2\">\n<h3 data-kid=\"1-3-1-2-2-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-2-1-1\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-3-1-2-2-2\">\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-1\"><dt data-kid=\"1-3-1-2-2-2-1-1\">Diet</dt><dd data-kid=\"1-3-1-2-2-2-1-2\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-2\"><dt data-kid=\"1-3-1-2-2-2-2-1\">Allergy</dt><dd data-kid=\"1-3-1-2-2-2-2-2\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-3\"><dt data-kid=\"1-3-1-2-2-2-3-1\">Servings</dt><dd data-kid=\"1-3-1-2-2-2-3-2\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-3-1-2-2-3\" style=\"max-width:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-3\">\n<h3 data-kid=\"1-3-1-2-3-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-1\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-3-1-2-3-2\">\n<li data-kid=\"1-3-1-2-3-2-1\"><span data-kid=\"1-3-1-2-3-2-1-1\">Method</span><span data-kid=\"1-3-1-2-3-2-1-2\">every step, numbered</span></li>\n<li data-kid=\"1-3-1-2-3-2-2\"><span data-kid=\"1-3-1-2-3-2-2-1\">Save</span><span data-kid=\"1-3-1-2-3-2-2-2\">one tap to Saved</span></li>\n<li data-kid=\"1-3-1-2-3-2-3\"><span data-kid=\"1-3-1-2-3-2-3-1\">Similar</span><span data-kid=\"1-3-1-2-3-2-3-2\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"popular\" data-kid=\"1-4\" id=\"popular\">\n<div class=\"wrap popular__inner\" data-kid=\"1-4-1\">\n<div class=\"sectionhead\" data-kid=\"1-4-1-1\">\n<h2 data-kid=\"1-4-1-1-1\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-4-1-1-2\">Ranked by saves in the last 7 days</p>\n</div>\n<div class=\"table\" data-kid=\"1-4-1-2\">\n<div aria-hidden=\"true\" class=\"thead\" data-kid=\"1-4-1-2-1\">\n<span data-kid=\"1-4-1-2-1-1\">Rank</span>\n<span data-kid=\"1-4-1-2-1-2\">Recipe</span>\n<span class=\"th--num\" data-kid=\"1-4-1-2-1-3\">Minutes</span>\n<span class=\"th--num\" data-kid=\"1-4-1-2-1-4\">kcal per serving</span>\n<span class=\"th--num\" data-kid=\"1-4-1-2-1-5\">7-day saves</span>\n</div>\n<ol data-kid=\"1-4-1-2-2\">\n<li class=\"row\" data-kid=\"1-4-1-2-2-1\">\n<a data-kid=\"1-4-1-2-2-1-1\" href=\"/recipes/skillet-beans\">\n<span class=\"rank\" data-kid=\"1-4-1-2-2-1-1-1\">1</span>\n<span class=\"title\" data-kid=\"1-4-1-2-2-1-1-2\">Skillet beans and greens</span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-1-1-3\"><span class=\"num\" data-kid=\"1-4-1-2-2-1-1-3-1\">25</span><span class=\"unit\" data-kid=\"1-4-1-2-2-1-1-3-2\">min</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-1-1-4\"><span class=\"num\" data-kid=\"1-4-1-2-2-1-1-4-1\">410</span><span class=\"unit\" data-kid=\"1-4-1-2-2-1-1-4-2\">kcal</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-1-1-5\"><span class=\"num\" data-kid=\"1-4-1-2-2-1-1-5-1\">86</span><span class=\"unit\" data-kid=\"1-4-1-2-2-1-1-5-2\">saves</span></span>\n</a>\n</li>\n<li class=\"row\" data-kid=\"1-4-1-2-2-2\">\n<a data-kid=\"1-4-1-2-2-2-1\" href=\"/recipes/lemon-lentils\">\n<span class=\"rank\" data-kid=\"1-4-1-2-2-2-1-1\">2</span>\n<span class=\"title\" data-kid=\"1-4-1-2-2-2-1-2\">Lemon lentils with herbs</span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-2-1-3\"><span class=\"num\" data-kid=\"1-4-1-2-2-2-1-3-1\">35</span><span class=\"unit\" data-kid=\"1-4-1-2-2-2-1-3-2\">min</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-2-1-4\"><span class=\"num\" data-kid=\"1-4-1-2-2-2-1-4-1\">380</span><span class=\"unit\" data-kid=\"1-4-1-2-2-2-1-4-2\">kcal</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-2-1-5\"><span class=\"num\" data-kid=\"1-4-1-2-2-2-1-5-1\">61</span><span class=\"unit\" data-kid=\"1-4-1-2-2-2-1-5-2\">saves</span></span>\n</a>\n</li>\n<li class=\"row\" data-kid=\"1-4-1-2-2-3\">\n<a data-kid=\"1-4-1-2-2-3-1\" href=\"/recipes/garlic-oil-pasta\">\n<span class=\"rank\" data-kid=\"1-4-1-2-2-3-1-1\">3</span>\n<span class=\"title\" data-kid=\"1-4-1-2-2-3-1-2\">Garlic oil pasta with kale</span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-3-1-3\"><span class=\"num\" data-kid=\"1-4-1-2-2-3-1-3-1\">20</span><span class=\"unit\" data-kid=\"1-4-1-2-2-3-1-3-2\">min</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-3-1-4\"><span class=\"num\" data-kid=\"1-4-1-2-2-3-1-4-1\">520</span><span class=\"unit\" data-kid=\"1-4-1-2-2-3-1-4-2\">kcal</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-3-1-5\"><span class=\"num\" data-kid=\"1-4-1-2-2-3-1-5-1\">44</span><span class=\"unit\" data-kid=\"1-4-1-2-2-3-1-5-2\">saves</span></span>\n</a>\n</li>\n<li class=\"row\" data-kid=\"1-4-1-2-2-4\">\n<a data-kid=\"1-4-1-2-2-4-1\" href=\"/recipes/roast-squash-chickpeas\">\n<span class=\"rank\" data-kid=\"1-4-1-2-2-4-1-1\">4</span>\n<span class=\"title\" data-kid=\"1-4-1-2-2-4-1-2\">Roast squash and chickpeas</span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-4-1-3\"><span class=\"num\" data-kid=\"1-4-1-2-2-4-1-3-1\">40</span><span class=\"unit\" data-kid=\"1-4-1-2-2-4-1-3-2\">min</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-4-1-4\"><span class=\"num\" data-kid=\"1-4-1-2-2-4-1-4-1\">445</span><span class=\"unit\" data-kid=\"1-4-1-2-2-4-1-4-2\">kcal</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-4-1-5\"><span class=\"num\" data-kid=\"1-4-1-2-2-4-1-5-1\">29</span><span class=\"unit\" data-kid=\"1-4-1-2-2-4-1-5-2\">saves</span></span>\n</a>\n</li>\n<li class=\"row\" data-kid=\"1-4-1-2-2-5\">\n<a data-kid=\"1-4-1-2-2-5-1\" href=\"/recipes/braised-leeks\">\n<span class=\"rank\" data-kid=\"1-4-1-2-2-5-1-1\">5</span>\n<span class=\"title\" data-kid=\"1-4-1-2-2-5-1-2\">Braised leeks on toast</span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-5-1-3\"><span class=\"num\" data-kid=\"1-4-1-2-2-5-1-3-1\">30</span><span class=\"unit\" data-kid=\"1-4-1-2-2-5-1-3-2\">min</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-5-1-4\"><span class=\"num\" data-kid=\"1-4-1-2-2-5-1-4-1\">390</span><span class=\"unit\" data-kid=\"1-4-1-2-2-5-1-4-2\">kcal</span></span>\n<span class=\"figure\" data-kid=\"1-4-1-2-2-5-1-5\"><span class=\"num\" data-kid=\"1-4-1-2-2-5-1-5-1\">18</span><span class=\"unit\" data-kid=\"1-4-1-2-2-5-1-5-2\">saves</span></span>\n</a>\n</li>\n</ol>\n</div>\n</div>\n</section>\n<footer class=\"site-footer\" data-kid=\"1-5\">\n<div class=\"wrap\" data-kid=\"1-5-1\">\n<div class=\"footer__grid\" data-kid=\"1-5-1-1\">\n<div data-kid=\"1-5-1-1-1\">\n<p class=\"footer__brand\" data-kid=\"1-5-1-1-1-1\">Chef Llama</p>\n<p class=\"footer__note\" data-kid=\"1-5-1-1-1-2\">Recipes are generated by a small model. Check ingredients and allergens yourself.</p>\n<nav aria-label=\"Legal\" class=\"footer__links\" data-kid=\"1-5-1-1-1-3\">\n<a data-kid=\"1-5-1-1-1-3-1\" href=\"/terms\">Terms</a>\n<a data-kid=\"1-5-1-1-1-3-2\" href=\"/privacy\">Privacy</a>\n</nav>\n</div>\n<fieldset class=\"scheme\" data-kid=\"1-5-1-1-2\">\n<legend data-kid=\"1-5-1-1-2-1\">Appearance</legend>\n<div class=\"switch\" data-kid=\"1-5-1-1-2-2\">\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-1\"><input checked=\"\" data-kid=\"1-5-1-1-2-2-1-1\" id=\"scheme-system\" name=\"scheme\" type=\"radio\" value=\"system\"/><span data-kid=\"1-5-1-1-2-2-1-2\">System</span></label>\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-2\"><input data-kid=\"1-5-1-1-2-2-2-1\" id=\"scheme-light\" name=\"scheme\" type=\"radio\" value=\"light\"/><span data-kid=\"1-5-1-1-2-2-2-2\">Light</span></label>\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-3\"><input data-kid=\"1-5-1-1-2-2-3-1\" id=\"scheme-dark\" name=\"scheme\" type=\"radio\" value=\"dark\"/><span data-kid=\"1-5-1-1-2-2-3-2\">Dark</span></label>\n</div>\n</fieldset>\n</div>\n</div>\n</footer>\n</div>\n",
