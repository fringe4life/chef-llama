    "var_1843b56a9d1c": {
      "type": "variant",
      "label": "Dashboard — new user, nothing cooked yet",
      "parentId": "var_c586796be4ec",
      "themeId": null,
      "rect": {
        "x": 5193,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(hsl(38 42% 96%), hsl(30 12% 8%));\n  --surface-2: light-dark(hsl(36 34% 93%), hsl(30 9% 15%));\n  --ink: light-dark(hsl(28 24% 15%), hsl(36 28% 93%));\n  --ink-muted: light-dark(hsl(30 9% 38%), hsl(30 8% 66%));\n  --ink-faint: light-dark(hsl(30 7% 50%), hsl(30 7% 54%));\n  --rule: light-dark(hsl(34 24% 85%), hsl(30 8% 21%));\n  --rule-hair: light-dark(hsl(34 22% 90%), hsl(30 8% 16%));\n  --rule-strong: light-dark(hsl(32 18% 70%), hsl(30 8% 30%));\n  --accent: light-dark(hsl(30 74% 37%), hsl(34 82% 60%));\n  --accent-ink: light-dark(hsl(40 60% 98%), hsl(30 45% 9%));\n  --gift: light-dark(hsl(168 18% 43%), hsl(168 24% 54%));\n  --focus: light-dark(hsl(214 80% 42%), hsl(210 90% 64%));\n  --sans: ui-sans-serif, system-ui, sans-serif;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --serif: ui-serif, Georgia, \"Times New Roman\", serif;\n}\nbody{margin:0;background:var(--background);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\n.app h1,.app h2,.app p,.app ul,.app li,.app table{margin:0}\n.app ul{padding:0;list-style:none}\n.num{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n\n.shell{display:flex;align-items:center;gap:28px;height:64px;padding:0 24px;border-bottom:1px solid var(--rule);box-sizing:border-box}\n.wordmark{font-size:17px;font-weight:700;letter-spacing:-.03em;color:var(--ink);text-decoration:none}\n.nav{display:flex;align-items:center;gap:22px;margin-left:8px}\n.nav a{font-size:13.5px;color:var(--ink-muted);text-decoration:none;padding:6px 0;border-bottom:2px solid transparent}\n.nav a[aria-current=\"page\"]{color:var(--ink);border-bottom-color:var(--accent)}\n.shell__end{margin-left:auto;display:flex;align-items:center}\n.avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--surface-2);border:1px solid var(--rule);font-size:11px;font-weight:600;color:var(--ink-muted)}\n\n.page{max-width:1232px;margin:0 auto;padding:26px 24px 56px;box-sizing:border-box;container-type:inline-size;container-name:page}\n.page__head{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.page__head h1{font-size:24px;font-weight:600;letter-spacing:-.015em;line-height:1.1}\n.asof{font-family:var(--serif);font-size:13px;color:var(--ink-faint);padding-bottom:3px}\n.page__cta{margin-left:auto}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:6px;border:1px solid transparent;background:var(--accent);color:var(--accent-ink);font-family:inherit;font-size:13.5px;font-weight:600;text-decoration:none;cursor:pointer;box-sizing:border-box;white-space:nowrap}\n.btn:hover{filter:brightness(1.05)}\n.btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}\n.btn--ghost{background:transparent;color:var(--ink);border-color:var(--rule-strong)}\n.btn--ghost:hover{background:var(--surface-2);filter:none}\n.textlink{font-size:12.5px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-strong);padding-bottom:1px}\n\n.band{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);margin-top:22px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.band__cell{padding:18px 24px 18px 0}\n.band__cell + .band__cell{border-left:1px solid var(--rule);padding-left:24px}\n.band__label{font-size:12px;color:var(--ink-muted)}\n.band__value{display:flex;align-items:baseline;gap:8px;margin-top:2px}\n.band__value b{font-size:34px;font-weight:500;line-height:1.05}\n.band__value span{font-size:13px;color:var(--ink-muted)}\n.band__note{font-size:12.5px;color:var(--ink-faint);margin-top:5px}\n.gift{display:flex;flex-direction:column;align-items:flex-start;gap:2px}\n.gift__state{font-size:17px;font-weight:600;letter-spacing:-.01em;margin-top:2px}\n.gift__state i{font-style:normal;display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--gift);margin-right:8px;vertical-align:2px}\n.gift__note{font-size:12.5px;color:var(--ink-muted);margin-top:2px}\n.gift .btn{margin-top:12px}\n\n.section{margin-top:26px}\n.section__head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}\n.section__head h2{font-size:15px;font-weight:600;letter-spacing:-.005em}\n.segmented{display:inline-flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden;margin-left:auto}\n.segmented button{height:34px;padding:0 12px;border:0;background:transparent;color:var(--ink-muted);font-family:inherit;font-size:12.5px;cursor:pointer}\n.segmented button + button{border-left:1px solid var(--rule)}\n.segmented button[aria-pressed=\"true\"]{background:var(--surface-2);color:var(--ink);font-weight:600}\n\n.empty{margin-top:16px;padding:34px 0 30px;border-top:1px solid var(--rule-hair);border-bottom:1px solid var(--rule-hair)}\n.empty__title{font-size:15px;font-weight:600}\n.empty__note{font-size:13px;color:var(--ink-muted);margin-top:4px;max-width:44ch}\n\n.table{width:100%;border-collapse:collapse}\n.table th{height:36px;padding:0 12px;font-size:12px;font-weight:500;color:var(--ink-muted);text-align:left;border-bottom:1px solid var(--rule)}\n.table th:first-child{padding-left:0}\n\n@container (max-width: 780px) {\n  .shell{padding:0 16px}\n  .nav{display:none}\n  .page{padding:20px 16px 44px}\n  .band{grid-template-columns:minmax(0,1fr)}\n  .band__cell{padding:16px 0}\n  .band__cell + .band__cell{border-left:0;border-top:1px solid var(--rule);padding-left:0}\n  .page__cta{margin-left:0;width:100%}\n  .page__cta .btn{width:100%}\n  .section__head .segmented{margin-left:0}\n}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"dashboard page app container\">\n<header class=\"shell\" data-kid=\"1-1\" data-name=\"top app navigation bar\">\n<a class=\"wordmark\" data-kid=\"1-1-1\" data-name=\"brand wordmark link\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n<a data-kid=\"1-1-2-1\" data-name=\"nav link to pantry\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" data-name=\"nav link to recipes\" href=\"/recipes\">Recipes</a>\n<a data-kid=\"1-1-2-3\" data-name=\"nav link to saved\" href=\"/saved\">Saved</a>\n<a aria-current=\"page\" data-kid=\"1-1-2-4\" data-name=\"active nav link to dashboard\" href=\"/dashboard\">Dashboard</a>\n<a data-kid=\"1-1-2-5\" data-name=\"nav link to billing\" href=\"/billing\">Billing</a>\n</nav>\n<div class=\"shell__end\" data-kid=\"1-1-3\" data-name=\"header right-side user area\"><span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-3-1\" data-name=\"user avatar monogram badge\">AR</span></div>\n</header>\n<main class=\"page\" data-kid=\"1-2\" data-name=\"main dashboard content\">\n<div class=\"page__head\" data-kid=\"1-2-1\" data-name=\"page header with title and actions\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page title heading\">Dashboard</h1>\n<p class=\"asof\" data-kid=\"1-2-1-2\" data-name=\"as-of timestamp text\">4 November 2026, 9:14 am</p>\n<div class=\"page__cta\" data-kid=\"1-2-1-3\" data-name=\"page header call-to-action group\"><a class=\"btn btn--ghost\" data-kid=\"1-2-1-3-1\" data-name=\"ghost buy credits button\" href=\"/topup\">Buy Credits</a></div>\n</div>\n<section aria-label=\"Credit account\" class=\"band\" data-kid=\"1-2-2\" data-name=\"credit account summary band\">\n<div class=\"band__cell\" data-kid=\"1-2-2-1\" data-name=\"available credits cell\">\n<p class=\"band__label\" data-kid=\"1-2-2-1-1\" data-name=\"available credits label\">Available</p>\n<p class=\"band__value\" data-kid=\"1-2-2-1-2\" data-name=\"available credits value row\"><b class=\"num\" data-kid=\"1-2-2-1-2-1\" data-name=\"available credits count number\">0</b><span data-kid=\"1-2-2-1-2-2\" data-name=\"credits unit label\">Credits</span></p>\n<p class=\"band__note\" data-kid=\"1-2-2-1-3\" data-name=\"credits note text\">One Credit per cook.</p>\n</div>\n<div class=\"band__cell\" data-kid=\"1-2-2-2\" data-name=\"free cooks cell\">\n<div class=\"gift\" data-kid=\"1-2-2-2-1\" data-name=\"free cooks gift block\">\n<p class=\"band__label\" data-kid=\"1-2-2-2-1-1\" data-name=\"free cooks label\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-2-2-1-2\" data-name=\"free cooks available state line\"><i aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"status indicator dot\"></i>Available now</p>\n<p class=\"gift__note\" data-kid=\"1-2-2-2-1-3\" data-name=\"free cooks note text\">Until the shared daily pool runs out.</p>\n<a class=\"btn\" data-kid=\"1-2-2-2-1-4\" data-name=\"primary cook from pantry button\" href=\"/pantry\">Cook from the pantry</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"cooks-h\" class=\"section\" data-kid=\"1-2-3\" data-name=\"cooks section\">\n<div class=\"section__head\" data-kid=\"1-2-3-1\" data-name=\"cooks section header\">\n<h2 data-kid=\"1-2-3-1-1\" data-name=\"cooks section title\" id=\"cooks-h\">Cooks</h2>\n<div aria-label=\"Range\" class=\"segmented\" data-kid=\"1-2-3-1-2\" data-name=\"time range segmented control\" role=\"group\">\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-1\" data-name=\"one week range toggle button\" type=\"button\">1 week</button>\n<button aria-pressed=\"true\" data-kid=\"1-2-3-1-2-2\" data-name=\"one month range toggle button\" type=\"button\">1 month</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-3\" data-name=\"one year range toggle button\" type=\"button\">1 year</button>\n</div>\n</div>\n<div class=\"empty\" data-kid=\"1-2-3-2\" data-name=\"cooks empty state panel\">\n<p class=\"empty__title\" data-kid=\"1-2-3-2-1\" data-name=\"cooks empty state title\">No cooks yet.</p>\n<p class=\"empty__note\" data-kid=\"1-2-3-2-2\" data-name=\"cooks empty state note text\">The chart fills in once your first recipe is generated.</p>\n</div>\n</section>\n<section aria-labelledby=\"purchases-h\" class=\"section\" data-kid=\"1-2-4\" data-name=\"purchases section\">\n<div class=\"section__head\" data-kid=\"1-2-4-1\" data-name=\"purchases section header\"><h2 data-kid=\"1-2-4-1-1\" data-name=\"purchases section title\" id=\"purchases-h\">Purchases</h2></div>\n<div class=\"empty\" data-kid=\"1-2-4-2\" data-name=\"purchases empty state panel\">\n<p class=\"empty__title\" data-kid=\"1-2-4-2-1\" data-name=\"purchases empty state title\">No purchases yet.</p>\n<p class=\"empty__note\" data-kid=\"1-2-4-2-2\" data-name=\"purchases empty state note text\">The smallest pack is NZ$8 for 20 Credits.</p>\n</div>\n</section>\n</main>\n</div>\n",
