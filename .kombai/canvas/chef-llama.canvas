      },
      "html": "<style>\n:root{\n  color-scheme: light dark;\n  --background: light-dark(hsl(38 42% 96%), hsl(30 12% 8%));\n  --surface: light-dark(hsl(40 44% 98.6%), hsl(30 10% 11%));\n  --surface-2: light-dark(hsl(36 34% 93%), hsl(30 9% 15%));\n  --ink: light-dark(hsl(28 24% 15%), hsl(36 28% 93%));\n  --ink-muted: light-dark(hsl(30 9% 38%), hsl(30 8% 66%));\n  --ink-faint: light-dark(hsl(30 7% 50%), hsl(30 7% 54%));\n  --rule: light-dark(hsl(34 24% 85%), hsl(30 8% 21%));\n  --rule-hair: light-dark(hsl(34 22% 90%), hsl(30 8% 16%));\n  --rule-strong: light-dark(hsl(32 18% 70%), hsl(30 8% 30%));\n  --grid: light-dark(hsl(34 20% 91%), hsl(30 8% 17%));\n  --accent: light-dark(hsl(30 74% 37%), hsl(34 82% 60%));\n  --accent-ink: light-dark(hsl(40 60% 98%), hsl(30 45% 9%));\n  --gift: light-dark(hsl(168 18% 43%), hsl(168 24% 54%));\n  --prev: light-dark(hsl(32 14% 60%), hsl(30 10% 46%));\n  --focus: light-dark(hsl(214 80% 42%), hsl(210 90% 64%));\n  --sans: ui-sans-serif, system-ui, sans-serif;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --serif: ui-serif, Georgia, \"Times New Roman\", serif;\n}\nbody{\n  margin:0;\n  background:var(--background);\n  color:var(--ink);\n  font-family:var(--sans);\n  font-size:14px;\n  line-height:1.45;\n  -webkit-font-smoothing:antialiased;\n}\n.app h1,.app h2,.app p,.app dl,.app dd,.app dt,.app ul,.app li,.app table{margin:0}\n.app ul{padding:0;list-style:none}\n.num{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n.serif{font-family:var(--serif)}\n\n.shell{display:flex;align-items:center;gap:28px;height:64px;padding:0 24px;border-bottom:1px solid var(--rule);box-sizing:border-box}\n.wordmark{font-size:17px;font-weight:700;letter-spacing:-.03em;color:var(--ink);text-decoration:none}\n.nav{display:flex;align-items:center;gap:22px;margin-left:8px}\n.nav a{font-size:13.5px;color:var(--ink-muted);text-decoration:none;padding:6px 0;border-bottom:2px solid transparent}\n.nav a[aria-current=\"page\"]{color:var(--ink);border-bottom-color:var(--accent)}\n.shell__end{margin-left:auto;display:flex;align-items:center}\n.avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--surface-2);border:1px solid var(--rule);font-size:11px;font-weight:600;color:var(--ink-muted)}\n\n.page{max-width:1232px;margin:0 auto;padding:26px 24px 56px;box-sizing:border-box;container-type:inline-size;container-name:page}\n.page__head{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.page__head h1{font-size:24px;font-weight:600;letter-spacing:-.015em;line-height:1.1}\n.asof{font-family:var(--serif);font-size:13px;color:var(--ink-faint);padding-bottom:3px}\n.page__cta{margin-left:auto;display:flex;gap:10px}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:6px;border:1px solid transparent;background:var(--accent);color:var(--accent-ink);font-family:inherit;font-size:13.5px;font-weight:600;text-decoration:none;cursor:pointer;box-sizing:border-box;white-space:nowrap}\n.btn:hover{filter:brightness(1.05)}\n.btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}\n.btn--ghost{background:transparent;color:var(--ink);border-color:var(--rule-strong)}\n.btn--ghost:hover{background:var(--surface-2);filter:none}\n\n.textlink{font-family:var(--sans);font-size:12.5px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-strong);padding-bottom:1px}\n.textlink:hover{border-bottom-color:var(--ink)}\n.textlink:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n\n/* account band: balance + free cooks */\n.band{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);margin-top:22px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n.band__cell{padding:18px 24px 18px 0;container-type:inline-size;container-name:account}\n.band__cell + .band__cell{border-left:1px solid var(--rule);padding-left:24px}\n.band__label{font-size:12px;color:var(--ink-muted)}\n.band__value{display:flex;align-items:baseline;gap:8px;margin-top:2px}\n.band__value b{font-size:34px;font-weight:500;line-height:1.05}\n.band__value span{font-size:13px;color:var(--ink-muted)}\n.band__note{font-size:12.5px;color:var(--ink-faint);margin-top:5px}\n\n.cell__row{display:flex;flex-direction:column;align-items:flex-start}\n.cell__aside{display:flex;flex-direction:column;align-items:flex-start;gap:8px;margin-top:6px}\n.cell__aside .band__note{margin-top:0}\n.gift{display:flex;flex-direction:column;align-items:flex-start;gap:2px}\n.gift__state{font-size:17px;font-weight:600;letter-spacing:-.01em;margin-top:2px}\n.gift__state i{font-style:normal;display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--gift);margin-right:8px;vertical-align:2px}\n.gift__note{font-size:12.5px;color:var(--ink-muted);margin-top:2px}\n.cell__row .btn{margin-top:12px}\n\n@container account (min-width:21rem){\n  .cell__row{flex-direction:row;align-items:flex-end;justify-content:space-between;gap:28px}\n  .cell__aside{align-items:flex-end;text-align:right;margin-top:0;padding-bottom:3px}\n  .cell--gift .cell__row{align-items:center}\n  .cell__row .btn{margin-top:0;flex-shrink:0}\n}\n\n.section{margin-top:26px}\n.section__head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}\n.section__head h2{font-size:15px;font-weight:600;letter-spacing:-.005em}\n.section__link{margin-left:auto}\n\n.segmented{display:inline-flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden;margin-left:auto}\n.segmented button{height:34px;padding:0 12px;border:0;background:transparent;color:var(--ink-muted);font-family:inherit;font-size:12.5px;cursor:pointer}\n.segmented button + button{border-left:1px solid var(--rule)}\n.segmented button[aria-pressed=\"true\"]{background:var(--surface-2);color:var(--ink);font-weight:600}\n.segmented button:focus-visible{outline:2px solid var(--focus);outline-offset:-2px}\n\n.report{container-type:inline-size;container-name:report}\n.report__periods{font-family:var(--serif);font-size:13px;color:var(--ink-faint);margin-top:3px}\n\n.report__summary{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:14px;padding-bottom:14px;border-bottom:1px solid var(--rule-hair)}\n.stats{display:flex;align-items:baseline;gap:22px}\n.stats li{display:flex;align-items:baseline;gap:6px}\n.stats b{font-size:17px;font-weight:500}\n.stats span{font-size:12.5px;color:var(--ink-muted)}\n.stats em{font-style:normal;font-size:12.5px;color:var(--ink-muted);font-family:var(--mono)}\n\n.legend{display:flex;align-items:center;gap:18px;font-size:12.5px;color:var(--ink-muted);flex-wrap:wrap}\n.legend li{display:inline-flex;align-items:center;gap:7px}\n.swatch{width:10px;height:10px;border-radius:1px;display:inline-block}\n.swatch--gift{background:var(--gift)}\n.swatch--credit{background:var(--accent)}\n.swatch--prev{background:linear-gradient(to top, color-mix(in oklab, var(--gift) 38%, var(--background)) 0 50%, color-mix(in oklab, var(--accent) 38%, var(--background)) 50% 100%)}\n\n.plot{display:grid;grid-template-columns:26px minmax(0,1fr);column-gap:10px;margin-top:20px;padding-bottom:30px}\n.plot__y{position:relative;height:200px}\n.plot__y span{position:absolute;right:0;bottom:calc(var(--t) / var(--max) * 100%);transform:translateY(50%);font-family:var(--mono);font-size:11.5px;color:var(--ink-faint)}\n.bars{position:relative;height:196px;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);align-items:end;border-bottom:1px solid var(--rule-strong)}\n.bars::before{content:\"\";position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(to top, var(--grid) 0 1px, transparent 1px calc(100% / var(--max)))}\n.bucket{position:relative;height:100%;padding:0;border:0;background:none;display:flex;align-items:flex-end;justify-content:center;font-family:inherit;cursor:default}\n.bucket:focus-visible{outline:2px solid var(--focus);outline-offset:-1px}\n.bucket__prev{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:70%;max-width:118px;height:calc(var(--v) / var(--max) * 100%);background:linear-gradient(to top, color-mix(in oklab, var(--gift) 30%, var(--background)) 0 calc(var(--pg, 40) * 1%), color-mix(in oklab, var(--accent) 30%, var(--background)) calc(var(--pg, 40) * 1%) 100%)}\n.bucket__stack{position:relative;width:44%;max-width:74px;height:100%;display:flex;flex-direction:column-reverse;gap:2px}\n.bucket__gift{height:calc(var(--v) / var(--max) * 100%);background:var(--gift)}\n.bucket__credit{height:calc(var(--v) / var(--max) * 100%);background:var(--accent)}\n.bucket__value{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(var(--total) / var(--max) * 100% + 6px);font-family:var(--mono);font-size:12.5px;font-weight:500;color:var(--ink)}\n.bucket__label{position:absolute;top:100%;margin-top:8px;left:50%;transform:translateX(-50%);font-family:var(--serif);font-size:12px;color:var(--ink-faint);white-space:nowrap}\n\n.tip{position-anchor:--tip;position-area:top;position-try-fallbacks:flip-block,flip-inline;margin:0 0 10px;padding:12px;width:max-content;max-width:260px;background:var(--surface);color:var(--ink);border:1px solid var(--rule-strong);border-radius:8px;box-shadow:0 8px 24px -12px hsl(30 30% 10% / .35);font-size:12.5px}\n.tip__date{font-family:var(--serif);font-weight:600;margin-bottom:8px;font-size:13px}\n.tip__rows{display:grid;grid-template-columns:auto auto;gap:4px 18px}\n.tip__rows dt{color:var(--ink-muted)}\n.tip__rows dd{text-align:right;font-family:var(--mono);font-weight:500}\n@supports not (position-area: top){\n  .tip{position:fixed;inset:auto auto 24px 24px;margin:0}\n}\n\n.table{width:100%;border-collapse:collapse}\n.table th{height:36px;padding:0 12px;vertical-align:middle;font-size:12px;font-weight:500;color:var(--ink-muted);text-align:left;border-bottom:1px solid var(--rule);white-space:nowrap}\n.table td{height:40px;padding:0 12px;vertical-align:middle;font-size:13.5px;border-bottom:1px solid var(--rule-hair)}\n.table th:first-child,.table td:first-child{padding-left:0}\n.table th:last-child,.table td:last-child{padding-right:0}\n.table .r{text-align:right}\n.table td.t-date{font-family:var(--serif);font-size:13.5px}\n.table__foot{display:flex;gap:10px;align-items:baseline;padding-top:12px;font-size:12.5px;color:var(--ink-muted);font-family:var(--mono)}\n.meta{display:block;margin-top:1px;font-family:var(--sans);font-size:11.5px;color:var(--ink-faint);letter-spacing:0}\n.table{table-layout:fixed}\n.table th:nth-child(1){width:25%}\n.table th:nth-child(2){width:17%}\n.table th:nth-child(3){width:11%}\n.table th:nth-child(4){width:33%}\n.table th:nth-child(5){width:14%}\n.pack{display:flex;align-items:center;gap:10px;width:100%}\n.pack__meter{position:relative;flex:1;min-width:52px;height:4px;border-radius:1px;background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--rule);overflow:hidden}\n.pack__meter i{position:absolute;left:0;top:0;bottom:0;width:var(--left,50%);background:var(--accent)}\n.pack .num{min-width:34px;text-align:right}\n.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n\n@container (max-width: 800px) {\n  .shell{padding:0 16px}\n  .page{padding:22px 20px 48px}\n  .report__summary{gap:12px}\n  .stats{gap:16px;flex-wrap:wrap}\n  .col--ref{display:none}\n}\n@container (max-width: 680px) {\n  .nav{display:none}\n  .band{grid-template-columns:minmax(0,1fr)}\n  .band__cell{padding:16px 0}\n  .band__cell + .band__cell{border-left:0;border-top:1px solid var(--rule);padding-left:0}\n  .section__head .segmented{margin-left:0}\n}\n@container (max-width: 460px) {\n  .page{padding:18px 16px 40px}\n  .page__cta{margin-left:0;width:100%}\n  .page__cta .btn{width:100%}\n}\n</style>\n<div class=\"app\" data-kid=\"1\">\n<header class=\"shell\" data-kid=\"1-1\">\n<a class=\"wordmark\" data-kid=\"1-1-1\" href=\"/\">Chef Llama</a>\n<nav aria-label=\"Main\" class=\"nav\" data-kid=\"1-1-2\">\n<a data-kid=\"1-1-2-1\" href=\"/pantry\">Pantry</a>\n<a data-kid=\"1-1-2-2\" href=\"/recipes\">Recipes</a>\n<a data-kid=\"1-1-2-3\" href=\"/saved\">Saved</a>\n<a aria-current=\"page\" data-kid=\"1-1-2-4\" href=\"/dashboard\">Dashboard</a>\n<a data-kid=\"1-1-2-5\" data-name=\"billing navigation link\" href=\"/billing\">Billing</a>\n</nav>\n<div class=\"shell__end\" data-kid=\"1-1-3\"><span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-3-1\">AR</span></div>\n</header>\n<main class=\"page\" data-kid=\"1-2\">\n<div class=\"page__head\" data-kid=\"1-2-1\">\n<h1 data-kid=\"1-2-1-1\">Dashboard</h1>\n<p class=\"asof\" data-kid=\"1-2-1-2\">4 November 2026, 9:14 am</p>\n<div class=\"page__cta\" data-kid=\"1-2-1-3\"><a class=\"btn btn--ghost\" data-kid=\"1-2-1-3-1\" href=\"/topup\">Buy Credits</a></div>\n</div>\n<section aria-label=\"Credit account\" class=\"band\" data-kid=\"1-2-2\">\n<div class=\"band__cell\" data-kid=\"1-2-2-1\" data-name=\"available credits band cell\">\n<div class=\"cell__row\" data-kid=\"1-2-2-1-1\" data-name=\"credits row layout wrapper\">\n<div data-kid=\"1-2-2-1-1-1\" data-name=\"credits label and value group\">\n<p class=\"band__label\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"available credits label\">Available</p>\n<p class=\"band__value\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"available credits value line\"><b class=\"num\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"available credits count value\">143</b><span data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"credits unit label\">Credits</span></p>\n</div>\n<div class=\"cell__aside\" data-kid=\"1-2-2-1-1-2\" data-name=\"credits aside group with note and link\">\n<p class=\"band__note\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"credits conversion note text\">One Credit per cook.</p>\n<a class=\"textlink\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"credit history text link\" href=\"/billing\">Credit history</a>\n</div>\n</div>\n</div>\n<div class=\"band__cell cell--gift\" data-kid=\"1-2-2-2\" data-name=\"free cooks band cell\">\n<div class=\"cell__row\" data-kid=\"1-2-2-2-1\" data-name=\"free cooks row layout wrapper\">\n<div class=\"gift\" data-kid=\"1-2-2-2-1-1\" data-name=\"daily gift status block\">\n<p class=\"band__label\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"free cooks label\">Free cooks</p>\n<p class=\"gift__state\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"free cooks status line\"><i aria-hidden=\"true\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"available status dot badge\"></i><span data-kid=\"1-2-2-2-1-1-2-2\" data-name=\"free cooks remaining count phrase\"><b class=\"num\" data-kid=\"1-2-2-2-1-1-2-2-1\" data-name=\"free cooks remaining count value\">3</b> left today</span></p>\n<p class=\"gift__note\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"free cooks reset note text\">Resets 5:00 am.</p>\n</div>\n<a class=\"btn\" data-kid=\"1-2-2-2-1-2\" data-name=\"cook from pantry primary button\" href=\"/pantry\">Cook from the pantry</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"cooks-h\" class=\"section report\" data-kid=\"1-2-3\">\n<div class=\"section__head\" data-kid=\"1-2-3-1\">\n<h2 data-kid=\"1-2-3-1-1\" id=\"cooks-h\">Cooks</h2>\n<div aria-label=\"Range\" class=\"segmented\" data-kid=\"1-2-3-1-2\" role=\"group\">\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-1\" type=\"button\">1 week</button>\n<button aria-pressed=\"true\" data-kid=\"1-2-3-1-2-2\" type=\"button\">1 month</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-3-1-2-3\" type=\"button\">1 year</button>\n</div>\n</div>\n<p class=\"report__periods\" data-kid=\"1-2-3-2\">7 October – 3 November 2026, against 7 September – 6 October 2026</p>\n<div class=\"report__summary\" data-kid=\"1-2-3-3\" data-name=\"cooks report summary row\">\n<ul class=\"stats\" data-kid=\"1-2-3-3-1\" data-name=\"cooks summary stats list\">\n<li data-kid=\"1-2-3-3-1-1\" data-name=\"current period cook count stat\"><b class=\"num\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"current period cook count value\">33</b><span data-kid=\"1-2-3-3-1-1-2\" data-name=\"current period stat label\">cooks</span></li>\n<li data-kid=\"1-2-3-3-1-2\" data-name=\"previous period cook count stat\"><b class=\"num\" data-kid=\"1-2-3-3-1-2-1\" data-name=\"previous period cook count value\">22</b><span data-kid=\"1-2-3-3-1-2-2\" data-name=\"previous period stat label\">previous</span></li>\n<li data-kid=\"1-2-3-3-1-3\" data-name=\"cook count difference stat\"><b class=\"num\" data-kid=\"1-2-3-3-1-3-1\" data-name=\"difference absolute value\">+11</b><em data-kid=\"1-2-3-3-1-3-2\" data-name=\"difference percentage value\">+50%</em></li>\n</ul>\n<ul class=\"legend\" data-kid=\"1-2-3-3-2\" data-name=\"chart legend list\">\n<li data-kid=\"1-2-3-3-2-1\"><span aria-hidden=\"true\" class=\"swatch swatch--gift\" data-kid=\"1-2-3-3-2-1-1\"></span>Gift-funded</li>\n<li data-kid=\"1-2-3-3-2-2\"><span aria-hidden=\"true\" class=\"swatch swatch--credit\" data-kid=\"1-2-3-3-2-2-1\"></span>Credit-funded</li>\n<li data-kid=\"1-2-3-3-2-3\"><span aria-hidden=\"true\" class=\"swatch swatch--prev\" data-kid=\"1-2-3-3-2-3-1\"></span>Previous period</li>\n</ul>\n</div>\n<div class=\"plot\" data-kid=\"1-2-3-4\" data-name=\"cooks bar chart plot\">\n<div aria-hidden=\"true\" class=\"plot__y\" data-kid=\"1-2-3-4-1\" data-name=\"chart y-axis values column\" style=\"--max:10\">\n<span data-kid=\"1-2-3-4-1-1\" data-name=\"y-axis max tick label\" style=\"--t:10\">10</span><span data-kid=\"1-2-3-4-1-2\" data-name=\"y-axis mid tick label\" style=\"--t:5\">5</span><span data-kid=\"1-2-3-4-1-3\" data-name=\"y-axis zero tick label\" style=\"--t:0\">0</span>\n</div>\n<div class=\"bars\" data-kid=\"1-2-3-4-2\" data-name=\"chart bars container\" style=\"--max:10\">\n<button aria-label=\"7 to 13 October 2026: 8 cooks, 2 gift-funded, 6 Credit-funded. Previous period 5 cooks, 1 gift-funded and 4 Credit-funded.\" class=\"bucket\" data-credit=\"6\" data-date=\"7–13 October 2026\" data-gift=\"2\" data-kid=\"1-2-3-4-2-1\" data-name=\"weekly bar bucket for 7–13 Oct\" data-prev=\"5\" data-total=\"8\" style=\"--total:8\" type=\"button\">\n<span class=\"bucket__prev\" data-kid=\"1-2-3-4-2-1-1\" data-name=\"previous period reference bar\" style=\"--v:5;--pg:20\"></span>\n<span class=\"bucket__value\" data-kid=\"1-2-3-4-2-1-2\" data-name=\"bar total value label\">8</span>\n<span class=\"bucket__stack\" data-kid=\"1-2-3-4-2-1-3\" data-name=\"stacked bar column\"><span class=\"bucket__gift\" data-kid=\"1-2-3-4-2-1-3-1\" data-name=\"gift-funded bar segment\" style=\"--v:2\"></span><span class=\"bucket__credit\" data-kid=\"1-2-3-4-2-1-3-2\" data-name=\"credit-funded bar segment\" style=\"--v:6\"></span></span>\n<span class=\"bucket__label\" data-kid=\"1-2-3-4-2-1-4\" data-name=\"x-axis bucket date label\">7–13 Oct</span>\n</button>\n<button aria-label=\"14 to 20 October 2026: 9 cooks, 1 gift-funded, 8 Credit-funded. Previous period 6 cooks, 2 gift-funded and 4 Credit-funded.\" class=\"bucket\" data-credit=\"8\" data-date=\"14–20 October 2026\" data-gift=\"1\" data-kid=\"1-2-3-4-2-2\" data-name=\"weekly bar bucket for 14–20 Oct\" data-prev=\"6\" data-total=\"9\" style=\"--total:9\" type=\"button\">\n<span class=\"bucket__prev\" data-kid=\"1-2-3-4-2-2-1\" data-name=\"previous period reference bar\" style=\"--v:6;--pg:33\"></span>\n<span class=\"bucket__value\" data-kid=\"1-2-3-4-2-2-2\" data-name=\"bar total value label\">9</span>\n<span class=\"bucket__stack\" data-kid=\"1-2-3-4-2-2-3\" data-name=\"stacked bar column\"><span class=\"bucket__gift\" data-kid=\"1-2-3-4-2-2-3-1\" data-name=\"gift-funded bar segment\" style=\"--v:1\"></span><span class=\"bucket__credit\" data-kid=\"1-2-3-4-2-2-3-2\" data-name=\"credit-funded bar segment\" style=\"--v:8\"></span></span>\n<span class=\"bucket__label\" data-kid=\"1-2-3-4-2-2-4\" data-name=\"x-axis bucket date label\">14–20 Oct</span>\n</button>\n<button aria-label=\"21 to 27 October 2026: 7 cooks, 2 gift-funded, 5 Credit-funded. Previous period 4 cooks, 1 gift-funded and 3 Credit-funded.\" class=\"bucket\" data-credit=\"5\" data-date=\"21–27 October 2026\" data-gift=\"2\" data-kid=\"1-2-3-4-2-3\" data-name=\"weekly bar bucket for 21–27 Oct\" data-prev=\"4\" data-total=\"7\" style=\"--total:7\" type=\"button\">\n<span class=\"bucket__prev\" data-kid=\"1-2-3-4-2-3-1\" data-name=\"previous period reference bar\" style=\"--v:4;--pg:25\"></span>\n<span class=\"bucket__value\" data-kid=\"1-2-3-4-2-3-2\" data-name=\"bar total value label\">7</span>\n<span class=\"bucket__stack\" data-kid=\"1-2-3-4-2-3-3\" data-name=\"stacked bar column\"><span class=\"bucket__gift\" data-kid=\"1-2-3-4-2-3-3-1\" data-name=\"gift-funded bar segment\" style=\"--v:2\"></span><span class=\"bucket__credit\" data-kid=\"1-2-3-4-2-3-3-2\" data-name=\"credit-funded bar segment\" style=\"--v:5\"></span></span>\n<span class=\"bucket__label\" data-kid=\"1-2-3-4-2-3-4\" data-name=\"x-axis bucket date label\">21–27 Oct</span>\n</button>\n<button aria-label=\"28 October to 3 November 2026: 9 cooks, 1 gift-funded, 8 Credit-funded. Previous period 7 cooks, 2 gift-funded and 5 Credit-funded.\" class=\"bucket\" data-credit=\"8\" data-date=\"28 October – 3 November 2026\" data-gift=\"1\" data-kid=\"1-2-3-4-2-4\" data-name=\"weekly bar bucket for 28 Oct–3 Nov\" data-prev=\"7\" data-total=\"9\" style=\"--total:9\" type=\"button\">\n<span class=\"bucket__prev\" data-kid=\"1-2-3-4-2-4-1\" data-name=\"previous period reference bar\" style=\"--v:7;--pg:29\"></span>\n<span class=\"bucket__value\" data-kid=\"1-2-3-4-2-4-2\" data-name=\"bar total value label\">9</span>\n<span class=\"bucket__stack\" data-kid=\"1-2-3-4-2-4-3\" data-name=\"stacked bar column\"><span class=\"bucket__gift\" data-kid=\"1-2-3-4-2-4-3-1\" data-name=\"gift-funded bar segment\" style=\"--v:1\"></span><span class=\"bucket__credit\" data-kid=\"1-2-3-4-2-4-3-2\" data-name=\"credit-funded bar segment\" style=\"--v:8\"></span></span>\n<span class=\"bucket__label\" data-kid=\"1-2-3-4-2-4-4\" data-name=\"x-axis bucket date label\">28 Oct–3 Nov</span>\n</button>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"purchases-h\" class=\"section\" data-kid=\"1-2-4\" data-name=\"purchases section\">\n<div class=\"section__head\" data-kid=\"1-2-4-1\" data-name=\"purchases section header\">\n<h2 data-kid=\"1-2-4-1-1\" id=\"purchases-h\">Purchases</h2>\n<a class=\"textlink section__link\" data-kid=\"1-2-4-1-2\" href=\"/billing\">All purchases</a>\n</div>\n<table class=\"table\" data-kid=\"1-2-4-2\" data-name=\"purchases table\" style=\"margin-top:14px\">\n<thead data-kid=\"1-2-4-2-1\" data-name=\"purchases table header group\">\n<tr data-kid=\"1-2-4-2-1-1\" data-name=\"purchases table header row\">\n<th data-kid=\"1-2-4-2-1-1-1\" scope=\"col\">Date</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-2\" scope=\"col\">Amount</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-3\" scope=\"col\">Credits</th>\n<th class=\"col--ref\" data-kid=\"1-2-4-2-1-1-4\" scope=\"col\">Left</th>\n<th class=\"r\" data-kid=\"1-2-4-2-1-1-5\" scope=\"col\"><span class=\"vh\" data-kid=\"1-2-4-2-1-1-5-1\">Receipt</span></th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-4-2-2\" data-name=\"purchases table body rows\">\n<tr data-kid=\"1-2-4-2-2-1\" data-name=\"purchase table row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"purchase date cell\">21 October 2026</td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"purchase amount cell\"><span class=\"num\" data-kid=\"1-2-4-2-2-1-2-1\">NZ$32.00</span><span class=\"meta\" data-kid=\"1-2-4-2-2-1-2-2\">Visa ···· 4242</span></td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-1-3\" data-name=\"purchase credits cell\">120</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-1-4\" data-name=\"credits remaining cell\"><span class=\"pack\" data-kid=\"1-2-4-2-2-1-4-1\"><span class=\"pack__meter\" data-kid=\"1-2-4-2-2-1-4-1-1\" style=\"--left:100%\"><i data-kid=\"1-2-4-2-2-1-4-1-1-1\"></i></span><span class=\"num\" data-kid=\"1-2-4-2-2-1-4-1-2\">120</span></span></td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-1-5\" data-name=\"receipt link cell\"><a class=\"textlink\" data-kid=\"1-2-4-2-2-1-5-1\" href=\"/billing\">Receipt</a></td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-2\" data-name=\"purchase table row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"purchase date cell\">2 October 2026</td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"purchase amount cell\"><span class=\"num\" data-kid=\"1-2-4-2-2-2-2-1\">NZ$16.00</span><span class=\"meta\" data-kid=\"1-2-4-2-2-2-2-2\">Visa ···· 4242</span></td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-2-3\" data-name=\"purchase credits cell\">50</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-2-4\" data-name=\"credits remaining cell\"><span class=\"pack\" data-kid=\"1-2-4-2-2-2-4-1\"><span class=\"pack__meter\" data-kid=\"1-2-4-2-2-2-4-1-1\" style=\"--left:46%\"><i data-kid=\"1-2-4-2-2-2-4-1-1-1\"></i></span><span class=\"num\" data-kid=\"1-2-4-2-2-2-4-1-2\">23</span></span></td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-2-5\" data-name=\"receipt link cell\"><a class=\"textlink\" data-kid=\"1-2-4-2-2-2-5-1\" href=\"/billing\">Receipt</a></td>\n</tr>\n<tr data-kid=\"1-2-4-2-2-3\" data-name=\"purchase table row\">\n<td class=\"t-date\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"purchase date cell\">12 September 2026</td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"purchase amount cell\"><span class=\"num\" data-kid=\"1-2-4-2-2-3-2-1\">NZ$8.00</span><span class=\"meta\" data-kid=\"1-2-4-2-2-3-2-2\">Visa ···· 4242</span></td>\n<td class=\"r num\" data-kid=\"1-2-4-2-2-3-3\" data-name=\"purchase credits cell\">20</td>\n<td class=\"col--ref\" data-kid=\"1-2-4-2-2-3-4\" data-name=\"credits remaining cell\"><span class=\"pack\" data-kid=\"1-2-4-2-2-3-4-1\"><span class=\"pack__meter\" data-kid=\"1-2-4-2-2-3-4-1-1\" style=\"--left:0%\"><i data-kid=\"1-2-4-2-2-3-4-1-1-1\"></i></span><span class=\"num\" data-kid=\"1-2-4-2-2-3-4-1-2\">0</span></span></td>\n<td class=\"r\" data-kid=\"1-2-4-2-2-3-5\" data-name=\"receipt link cell\"><a class=\"textlink\" data-kid=\"1-2-4-2-2-3-5-1\" href=\"/billing\">Receipt</a></td>\n</tr>\n</tbody>\n</table>\n<p class=\"table__foot\" data-kid=\"1-2-4-3\" data-name=\"purchases table footer totals\">3 purchases · NZ$56.00 · 190 Credits</p>\n</section>\n</main>\n</div>\n<div aria-hidden=\"true\" class=\"tip\" data-kid=\"2\" data-name=\"bar hover/detail popover\" id=\"cook-tip\" popover=\"manual\">\n<p class=\"tip__date\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"tooltip date text\" data-reason=\"text replaced by script from hovered bucket's data-date\" data-tip=\"date\">7–13 October 2026</p>\n<dl class=\"tip__rows\" data-kid=\"2-2\" data-name=\"tooltip metrics definition list\">\n<dt data-kid=\"2-2-1\">Gift-funded</dt><dd data-dynamic=\"true\" data-kid=\"2-2-2\" data-name=\"tooltip gift value\" data-reason=\"text replaced by script from hovered bucket's data-gift\" data-tip=\"gift\">2</dd>\n<dt data-kid=\"2-2-3\">Credit-funded</dt><dd data-dynamic=\"true\" data-kid=\"2-2-4\" data-name=\"tooltip credit value\" data-reason=\"text replaced by script from hovered bucket's data-credit\" data-tip=\"credit\">6</dd>\n<dt data-kid=\"2-2-5\">Cooks</dt><dd data-dynamic=\"true\" data-kid=\"2-2-6\" data-name=\"tooltip cooks total value\" data-reason=\"text replaced by script from hovered bucket's data-total\" data-tip=\"total\">8</dd>\n<dt data-kid=\"2-2-7\">Previous period</dt><dd data-dynamic=\"true\" data-kid=\"2-2-8\" data-name=\"tooltip previous period value\" data-reason=\"text replaced by script from hovered bucket's data-prev\" data-tip=\"prev\">5</dd>\n</dl>\n</div>\n<script>\n(function () {\n  var tip = document.getElementById('cook-tip');\n  if (!tip || !tip.showPopover) return;\n  var fields = {\n    date: tip.querySelector('[data-tip=\"date\"]'),\n    gift: tip.querySelector('[data-tip=\"gift\"]'),\n    credit: tip.querySelector('[data-tip=\"credit\"]'),\n    total: tip.querySelector('[data-tip=\"total\"]'),\n    prev: tip.querySelector('[data-tip=\"prev\"]')\n  };\n  var current = null;\n  var hideTimer = 0;\n  var pinned = false;\n\n  function open(el) {\n    if (!el || !el.dataset || !el.dataset.date) return;\n    if (current && current !== el) current.style.removeProperty('anchor-name');\n    current = el;\n    el.style.setProperty('anchor-name', '--tip');\n    tip.style.setProperty('position-anchor', '--tip');\n    fields.date.textContent = el.dataset.date;\n    fields.gift.textContent = el.dataset.gift;\n    fields.credit.textContent = el.dataset.credit;\n    fields.total.textContent = el.dataset.total;\n    fields.prev.textContent = el.dataset.prev;\n    if (!tip.matches(':popover-open')) tip.showPopover();\n  }\n\n  function close() {\n    if (pinned) return;\n    if (tip.matches(':popover-open')) tip.hidePopover();\n  }\n\n  var buckets = document.querySelectorAll('.bucket');\n  for (var i = 0; i < buckets.length; i++) {\n    (function (el) {\n      el.addEventListener('pointerenter', function () { clearTimeout(hideTimer); open(el); });\n      el.addEventListener('pointerleave', function () { clearTimeout(hideTimer); hideTimer = setTimeout(close, 140); });\n      el.addEventListener('focus', function () { open(el); });\n      el.addEventListener('blur', function () { pinned = false; close(); });\n      el.addEventListener('click', function () {\n        pinned = !pinned;\n        if (pinned) { clearTimeout(hideTimer); open(el); } else { close(); }\n      });\n    })(buckets[i]);\n  }\n\n  tip.addEventListener('pointerenter', function () { clearTimeout(hideTimer); });\n  tip.addEventListener('pointerleave', function () { hideTimer = setTimeout(close, 140); });\n\n  document.addEventListener('keydown', function (e) {\n    if (e.key === 'Escape') { pinned = false; close(); }\n  });\n\n  document.addEventListener('pointerdown', function (e) {\n    if (!pinned) return;\n    if (tip.contains(e.target)) return;\n    if (e.target.closest && e.target.closest('.bucket')) return;\n    pinned = false;\n    close();\n  });\n})();\n</script>\n",
      "comments": [],
      "created": "2026-11-04T14:03:54.242847+00:00",
      "modified": "2026-11-04T18:55:53.024287+00:00",
