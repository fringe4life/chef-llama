input:checked + span { background: var(--primary); color: var(--primary-foreground); }\n  .opt input:focus-visible + span { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .btn { transition: none; }\n    .btn:active { transform: none; }\n    .row a { transition: opacity 120ms linear; }\n  }\n\n  /* site sign: mark, mono nav, plate set on the CTA's edge */\n  .sign { position: sticky; inset-block-start: 0; z-index: 20; background: var(--background); border-block-end: var(--border-width-thin) solid var(--border); }\n  .deck--sign { block-size: 72px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-6); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-3); justify-self: start; text-decoration: none; }\n  .wordmark { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); color: var(--foreground); }\n  .nav { display: none; align-items: center; gap: var(--space-7); justify-self: center; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  @media (width >= 768px) { .nav { display: flex; } }\n  .nav a { color: inherit; text-decoration: none; transition: color 130ms linear; }\n  .nav a:hover { color: var(--foreground); }\n  .cta { position: relative; justify-self: end; display: inline-flex; align-items: center; min-block-size: 44px; padding: 0 var(--space-5) 0 var(--space-8); border: var(--border-width-thin) solid var(--primary); border-radius: var(--radius); background: var(--primary); color: var(--primary-foreground); font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); text-decoration: none; white-space: nowrap; transition: background 150ms linear, color 150ms linear; }\n  .cta:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); color: var(--primary-foreground); }\n  .cta:active { transform: scale(0.97); }\n  .cta__plate { position: absolute; inset-inline-start: -19px; inset-block-start: 50%; margin-top: calc(var(--space-5) * -1); inline-size: 40px; block-size: 40px; border-radius: 50%; background: var(--card); border: var(--border-width-thin) solid var(--border); display: grid; place-items: center; color: var(--foreground); transition: border-color 150ms linear; }\n  .cta:hover .cta__plate { border-color: var(--primary); }\n  .plate { display: block; overflow: visible; }\n  .mk { display: block; flex: none; overflow: visible; }\n  /* the mark: face on primary, toque on accent, eyes punched in primary-foreground */\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-blink, .fork__rock, .knife__rock { transform-box: fill-box; transform-origin: center; }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  @media (prefers-reduced-motion: no-preference) {\n    .mk-blink { animation: blink 5.6s cubic-bezier(0.23, 1, 0.32, 1) infinite; }\n    .fork__rock { animation: rock 3.8s ease-in-out infinite; }\n    .knife__rock { animation: rock 3.8s ease-in-out infinite -1.9s; }\n  }\n  @keyframes blink { 0%, 90%, 100% { transform: scaleY(1); } 93.5%, 95.5% { transform: scaleY(0.1); } }\n  @keyframes rock { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }\n  @media (width <= 767.98px) { .deck--sign { grid-template-columns: minmax(0, 1fr) auto; } }\n  .hero__note .ln { display: block; }\n  .hero__note { max-inline-size: 100%; font-size: var(--text-sm); text-align: end; }\n  @media (width >= 768px) { .hero__grid { align-items: center; } }\n  @media (width >= 1024px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 480px; gap: var(--space-8); } }\n\n  /* credits: credit-count rail down the left edge of each pack */\n  .pack { position: relative; overflow: hidden; padding-inline-start: var(--space-8); }\n  .rail { position: absolute; inset-inline-start: 0; inset-block-start: 0; inset-block-end: 0; inline-size: 16px; background: var(--secondary); border-inline-end: var(--border-width-thin) solid var(--border); }\n  .rail i { position: absolute; inset-inline-start: 0; inset-inline-end: 0; inset-block-end: 0; block-size: calc(var(--f) * 100%); background: linear-gradient(to top, color-mix(in oklab, var(--primary) 86%, var(--foreground)), var(--primary)); }\n  .pack--best .rail { border-right-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n\n  /* pack flag: a highlighter stroke, two passes, under the lower half of the label */\n  .pack__top { margin-bottom: var(--space-2); }\n  .pack__flag { position: relative; isolation: isolate; padding: 2px var(--space-2) var(--space-1); border-radius: 0; background: none; color: var(--foreground); line-height: var(--leading-tight); }\n  .pack__flag::before { content: \"\"; position: absolute; z-index: -1; inset-inline-start: -4px; inset-inline-end: -4px; inset-block-start: 38%; inset-block-end: 2px; background: color-mix(in oklab, var(--accent) 26%, var(--background)); transform: skewX(-1.6deg) rotate(-0.8deg); border-radius: 2px; }\n  .pack__flag::after { content: \"\"; position: absolute; z-index: -2; inset-inline-start: -1px; inset-inline-end: -7px; inset-block-start: 46%; inset-block-end: 0; background: color-mix(in oklab, var(--accent) 14%, transparent); transform: skewX(1.2deg) rotate(0.6deg); border-radius: 2px; }\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n.sr-only{position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;font-size:var(--text-xs)}</style>\n<div data-kid=\"1\" data-name=\"site page root container\">\n<header class=\"sign\" data-kid=\"1-1\" data-name=\"sticky site sign header\">\n<div class=\"wrap\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n<div class=\"deck--sign\" data-kid=\"1-1-1-1\" data-name=\"sign layout grid with logo nav and CTA\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1-1\" data-name=\"brand lockup home link\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1-1\" data-name=\"chef llama mascot icon with blinking eyes and hat\" height=\"38\" viewbox=\"0 0 32 32\" width=\"38\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\"><g class=\"mk-blink\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye mk-eye--far\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-1-2\" data-name=\"site brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-1-1-1-2\" data-name=\"main site navigation\">\n<a data-kid=\"1-1-1-1-2-1\" data-name=\"popular recipes section link\" href=\"#popular\">Popular</a>\n<a data-kid=\"1-1-1-1-2-2\" data-name=\"pricing section link\" href=\"#credits\">Pricing</a>\n<a data-kid=\"1-1-1-1-2-3\" data-name=\"how to cook section link\" href=\"/how-to\">How to cook</a>\n</nav>\n<a class=\"cta\" data-kid=\"1-1-1-1-3\" data-name=\"primary start cooking call-to-action button\" href=\"/pantry\">\n<span class=\"cta__plate\" data-kid=\"1-1-1-1-3-1\" data-name=\"CTA plate badge container\">\n<svg aria-hidden=\"true\" class=\"plate\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"food plate icon with rocking fork and knife\" height=\"24\" viewbox=\"0 0 22 22\" width=\"24\">\n<g transform=\"translate(11 11) scale(1.5) translate(-10.35 -10.8)\"><g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-1-3-2\" data-name=\"start cooking button label\">Start cooking</span>\n</a>\n</div>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\" data-name=\"hero content wrapper\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\" data-name=\"hero grid layout with headline note and specimen\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero main headline\" id=\"site-hero\"><span class=\"ln\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline first line\">You’ve got the Pantry.</span> <span class=\"ln\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline second line\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\" data-name=\"hero supporting note about limits and saves\"><span class=\"ln\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero note sentence on hard limits\">Your Diet and allergies are hard limits.</span> <span class=\"ln\" data-kid=\"1-2-1-1-2-2\" data-name=\"hero note sentence on cooking and similar dishes\">You cook it, save it, and find similar dishes from the same Pantry.</span></p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\" data-name=\"example recipe specimen card\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\" data-name=\"specimen pantry column\">\n<div data-kid=\"1-2-1-2-1-1\" data-name=\"pantry ingredients group\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"pantry column label heading\" style=\"font-size: var(--text-xs); letter-spacing:var(--tracking-caps)\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"pantry ingredient chip list\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"firm tofu ingredient chip\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"day-old rice ingredient chip\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\" data-name=\"soy sauce ingredient chip\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\" data-name=\"pantry attributes list\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"diet attribute row\"><dt data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"diet attribute label\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"vegan diet value\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"allergy attribute row\"><dt data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"allergy attribute label\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"sesame allergy value\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"servings attribute row\"><dt data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"servings attribute label\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\" data-name=\"servings value\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\" data-name=\"specimen recipe body\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\" data-name=\"specimen recipe meta row with label and tag\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"example recipe label heading\" style=\"font-size: var(--text-2xs); letter-spacing:var(--tracking-caps)\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"vegan diet tag with dot\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"vegan tag indicator dot\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" data-name=\"specimen recipe title\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\" data-name=\"specimen recipe stats row\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"cook time stat\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"minutes stat label\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"minutes stat value\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"servings stat\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"servings stat label\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"servings stat value\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\" data-name=\"kcal per serving stat\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\" data-name=\"kcal per serving stat label\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\" data-name=\"kcal stat value\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\" data-name=\"specimen recipe pairs grid\">\n<div data-kid=\"1-2-1-2-2-4-1\" data-name=\"staples pair\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\" data-name=\"staples pair label\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\" data-name=\"staples pair value\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\" data-name=\"swap pair\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\" data-name=\"swap pair label\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\" data-name=\"swap pair value with arrow\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\" data-name=\"crossed-out original swap item\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\" data-name=\"swap arrow glyph\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\" data-name=\"replacement swap item\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\" data-name=\"recipe method step list\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\" data-name=\"recipe step 1 container\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\" data-name=\"recipe step 1 number\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\" data-name=\"recipe step 1 instruction text\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\" data-name=\"recipe step 2 container\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\" data-name=\"recipe step 2 number\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\" data-name=\"recipe step 2 instruction text\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\" data-name=\"recipe step 3 container\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\" data-name=\"recipe step 3 number\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\" data-name=\"recipe step 3 instruction text\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\" data-name=\"recipe step 4 container\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\" data-name=\"recipe step 4 number\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\" data-name=\"recipe step 4 instruction text\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"free-heading\" class=\"free\" data-kid=\"1-6\" data-name=\"free tiers section\">\n<div class=\"wrap free__inner\" data-kid=\"1-6-1\" data-name=\"free tiers section content wrapper\">\n<div class=\"free__grid\" data-kid=\"1-6-1-1\" data-name=\"free tiers content grid\">\n<div data-kid=\"1-6-1-1-1\" data-name=\"free tiers info column\">\n<h2 class=\"free__title\" data-kid=\"1-6-1-1-1-1\" data-name=\"free tiers heading\" id=\"free-heading\">Up to 3 free cooks a day.</h2>\n<p class=\"free__note\" data-kid=\"1-6-1-1-1-2\" data-name=\"free tiers description\">First come first served from a shared pool. <a data-kid=\"1-6-1-1-1-2-1\" data-name=\"credits link\" href=\"#credits\">Credits</a> when you need more.</p>\n</div>\n<a class=\"free__link\" data-kid=\"1-6-1-1-2\" data-name=\"free tiers call-to-action link\" href=\"/pantry\">Start cooking</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"strip strip--plain\" data-kid=\"1-3\" data-name=\"how a cook runs process section\">\n<div class=\"wrap field__inner\" data-kid=\"1-3-1\" data-name=\"process section content wrapper\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-1\" data-name=\"visually hidden process section heading\" id=\"process-heading\" style=\"position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-3-1-2\" data-name=\"process steps grid\">\n<li class=\"field__step\" data-kid=\"1-3-1-2-1\" data-name=\"process step 1 add pantry ingredients\">\n<h3 data-kid=\"1-3-1-2-1-1\" data-name=\"process step 1 heading with number\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"process step 1 number\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-3-1-2-1-2\" data-name=\"process step 1 ingredient chip list\">\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"firm tofu ingredient chip\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"day-old rice ingredient chip\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-3\" data-name=\"soy sauce ingredient chip\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-3-1-2-1-3\" data-name=\"process step 1 minimum ingredients note\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-2\" data-name=\"process step 2 chef writes recipe\">\n<h3 data-kid=\"1-3-1-2-2-1\" data-name=\"process step 2 heading with number\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"process step 2 number\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-3-1-2-2-2\" data-name=\"hard constraints list\">\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"diet constraint row\"><dt data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"diet constraint label\">Diet</dt><dd data-kid=\"1-3-1-2-2-2-1-2\" data-name=\"vegan diet constraint value\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"allergy constraint row\"><dt data-kid=\"1-3-1-2-2-2-2-1\" data-name=\"allergy constraint label\">Allergy</dt><dd data-kid=\"1-3-1-2-2-2-2-2\" data-name=\"sesame allergy constraint value\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-3\" data-name=\"servings constraint row\"><dt data-kid=\"1-3-1-2-2-2-3-1\" data-name=\"servings constraint label\">Servings</dt><dd data-kid=\"1-3-1-2-2-2-3-2\" data-name=\"servings constraint value\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-3-1-2-2-3\" data-name=\"constraints explanation note\" style=\"max-inline-size:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-3\" data-name=\"process step 3 cook the recipe\">\n<h3 data-kid=\"1-3-1-2-3-1\" data-name=\"process step 3 heading with number\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"process step 3 number\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-3-1-2-3-2\" data-name=\"cook the recipe deliverables list\">\n<li data-kid=\"1-3-1-2-3-2-1\" data-name=\"method deliverable row\"><span data-kid=\"1-3-1-2-3-2-1-1\" data-name=\"method deliverable label\">Method</span><span data-kid=\"1-3-1-2-3-2-1-2\" data-name=\"method deliverable description\">every step, numbered</span></li>\n<li data-kid=\"1-3-1-2-3-2-2\" data-name=\"save deliverable row\"><span data-kid=\"1-3-1-2-3-2-2-1\" data-name=\"save deliverable label\">Save</span><span data-kid=\"1-3-1-2-3-2-2-2\" data-name=\"save deliverable description\">one tap to Saved</span></li>\n<li data-kid=\"1-3-1-2-3-2-3\" data-name=\"similar deliverable row\"><span data-kid=\"1-3-1-2-3-2-3-1\" data-name=\"similar deliverable label\">Similar</span><span data-kid=\"1-3-1-2-3-2-3-2\" data-name=\"similar deliverable description\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"pop\" data-kid=\"1-4\" data-name=\"popular recipes section\" id=\"popular\">\n<div class=\"wrap pop__inner\" data-kid=\"1-4-1\" data-name=\"popular section content wrapper\">\n<div class=\"pop__head\" data-kid=\"1-4-1-1\" data-name=\"popular section heading row\">\n<h2 data-kid=\"1-4-1-1-1\" data-name=\"popular section heading\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-4-1-1-2\" data-name=\"popular section ranking subtitle\">Ranked by saves in the last 7 days</p>\n</div>\n<ol class=\"cards\" data-kid=\"1-4-1-2\" data-name=\"popular recipe card list\">\n<li data-kid=\"1-4-1-2-1\" data-name=\"popular recipe card wrapper false\">\n<a class=\"card\" data-kid=\"1-4-1-2-1-1\" data-name=\"skillet beans and greens recipe card\" href=\"/recipes/skillet-beans\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"recipe card rank number\">1</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-1-1-2\" data-name=\"recipe card body container\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-1-1-2-1\" data-name=\"skillet beans and greens recipe card title\">Skillet beans and greens</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-1-1-2-2\" data-name=\"skillet beans and greens ingredient list\">butter beans, cavolo nero, garlic, olive oil</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-1-1-2-3\" data-name=\"skillet beans and gardens recipe card stats grid\"><span data-kid=\"1-4-1-2-1-1-2-3-1\" data-name=\"cook time stat container\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-1-1\" data-name=\"cook time stat value\">25 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-1-2\" data-name=\"cook time stat unit label\">Cook</span></span><span data-kid=\"1-4-1-2-1-1-2-3-2\" data-name=\"per serving stat container\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-2-1\" data-name=\"per serving stat value\">410 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-2-2\" data-name=\"per serving stat unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-1-1-2-3-3\" data-name=\"saves stat container\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-3-1\" data-name=\"saves stat value\">86</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-3-2\" data-name=\"saves stat unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-2\" data-name=\"popular recipe card wrapper false\">\n<a class=\"card\" data-kid=\"1-4-1-2-2-1\" data-name=\"lemon lentils with herbs recipe card\" href=\"/recipes/lemon-lentils\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"recipe card rank number\">2</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"recipe card body container\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-2-1-2-1\" data-name=\"lemon lentils with herbs recipe card title\">Lemon lentils with herbs</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-2-1-2-2\" data-name=\"lemon lentils with herbs ingredient list\">brown lentils, lemon, parsley, cumin</span>\n<span c