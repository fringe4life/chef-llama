      },
      "html": "<style>\n  \n\n  :root {\n    color-scheme: light dark;\n    --background: light-dark(oklch(0.962 0.012 92), oklch(0.180 0.012 60));\n    --foreground: light-dark(oklch(0.250 0.030 40), oklch(0.940 0.012 88));\n    --card: light-dark(oklch(0.992 0.005 92), oklch(0.228 0.014 60));\n    --card-foreground: light-dark(oklch(0.250 0.030 40), oklch(0.940 0.012 88));\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --secondary: light-dark(oklch(0.935 0.018 90), oklch(0.258 0.016 60));\n    --secondary-foreground: light-dark(oklch(0.250 0.030 40), oklch(0.940 0.012 88));\n    --muted: light-dark(oklch(0.932 0.016 90), oklch(0.255 0.016 60));\n    --muted-foreground: light-dark(oklch(0.460 0.016 55), oklch(0.740 0.014 80));\n    --primary: light-dark(oklch(0.470 0.195 350), oklch(0.720 0.180 348));\n    --primary-foreground: light-dark(oklch(0.985 0.010 340), oklch(0.180 0.040 348));\n    --accent: light-dark(oklch(0.640 0.140 122), oklch(0.800 0.130 122));\n    --accent-foreground: oklch(0.200 0.045 122);\n    --border: light-dark(oklch(0.880 0.020 80), oklch(0.325 0.014 60));\n    --input: light-dark(oklch(0.860 0.022 80), oklch(0.345 0.016 60));\n    --ring: light-dark(oklch(0.470 0.195 350), oklch(0.720 0.180 348));\n\n    --destructive: light-dark(oklch(0.455 0.175 18), oklch(0.640 0.165 18));\n    --destructive-foreground: light-dark(oklch(0.985 0.010 340), oklch(0.190 0.045 18));\n\n    /* the only colour outside the shadcn set: two chart marks, their washes and one rim */\n    --chart-gift: light-dark(oklch(0.590 0.150 128), oklch(0.815 0.130 128));\n    --chart-credit: light-dark(oklch(0.440 0.170 12), oklch(0.560 0.150 12));\n    --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n    --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n    --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n    --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n    --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n    \n  \n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);}\n\n  html:has(#scheme-light:checked) { color-scheme: light; }\n  html:has(#scheme-dark:checked) { color-scheme: dark; }\n\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-sm);\n    line-height: var(--leading-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, h3, p, dl, dd, dt, ol, ul, fieldset, legend { margin: 0; }\n  ul, ol { padding: 0; list-style: none; }\n  a:focus-visible, button:focus-visible, input:focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  .wrap {\n  box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n  \n\n  .label {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    line-height: var(--leading-ui);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n\n  .site-header { border-block-end: var(--border-width-thin) solid var(--border); }\n  .site-header .wrap { display: flex; align-items: center; gap: var(--space-8); block-size: 80px; }\n  .wordmark {\n    font-family: var(--font-display);\n    font-size: var(--text-xl);\n    font-weight: 700;\n    line-height: var(--leading-solid);\n    letter-spacing: var(--tracking-tight);\n    color: var(--foreground);\n    text-decoration: none;\n  }\n  .site-nav { display: none; align-items: center; gap: var(--space-6); }\n  @media (width >= 768px) { .site-nav { display: flex; } }\n  .site-nav a { font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none; }\n  .site-nav a:hover { color: var(--foreground); }\n  .btn {\n    margin-inline-start: auto;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-block-size: 44px;\n    padding: 0 var(--space-5);\n    border: var(--border-width-thin) solid var(--primary);\n    border-radius: var(--radius-md);\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-sm);\n    font-weight: 700;\n    line-height: var(--leading-tight);\n    text-decoration: none;\n    white-space: nowrap;\n    transition: background-color 120ms cubic-bezier(0.23, 1, 0.32, 1), transform 120ms cubic-bezier(0.23, 1, 0.32, 1);\n  }\n  .btn:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n  .btn:active { transform: scale(0.97); }\n\n  .hero__inner { padding: var(--space-10) 0; }\n  @media (width >= 768px) { .hero__inner { padding: var(--space-12) 0; } }\n  .hero__grid { display: grid; gap: var(--space-6); }\n  @media (width >= 768px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 336px; gap: var(--space-16); align-items: end; } }\n  .hero__title { max-inline-size: 700px; font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .hero__title .ln { display: inline; }\n  @media (width >= 768px) { .hero__title { font-size: var(--text-4xl); } .hero__title .ln { display: block; } }\n  .hero__note { max-inline-size: 340px; padding-top: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); font-size: var(--text-sm); color: var(--muted-foreground); }\n  @media (width >= 768px) { .hero__note { padding-top: 0; border-block-start: 0; } }\n\n  .specimen {\n    margin-top: var(--space-8);\n    display: grid;\n    overflow: hidden;\n    border: var(--border-width-thin) solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n  }\n  @media (width >= 768px) { .specimen { margin-top: var(--space-10); } }\n  @media (width >= 1024px) { .specimen { grid-template-columns: 300px minmax(0, 1fr); } }\n  .specimen__pantry {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    gap: var(--space-5);\n    padding: var(--space-5);\n    border-block-end: var(--border-width-thin) solid var(--border);\n    background: var(--secondary);\n  }\n  @media (width >= 1024px) { .specimen__pantry { border-block-end: 0; border-inline-end: var(--border-width-thin) solid var(--border); } }\n  .pantry__list { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: var(--space-2); }\n  .tape {\n    display: inline-flex;\n    align-items: center;\n    min-block-size: 32px;\n    padding: 0 var(--space-3);\n    border: var(--border-width-thin) dashed color-mix(in oklab, var(--border) 55%, var(--foreground));\n    border-radius: var(--radius-sm);\n    background: var(--card);\n    color: var(--foreground);\n    font-size: var(--text-sm);\n    line-height: var(--leading-solid);\n    white-space: nowrap;\n  }\n  .pantry__attrs { display: grid; gap: var(--space-2); padding-top: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); }\n  .attr { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .attr dt { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .attr dd { font-size: var(--text-xs); }\n\n  .specimen__body { padding: var(--space-5); }\n  @media (width >= 768px) { .specimen__body { padding: var(--space-6); } }\n  .specimen__meta { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }\n  .tag { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: 400; color: var(--primary); }\n  .tag__dot { inline-size: 5px; block-size: 5px; border-radius: 50%; background: var(--primary); }\n  .specimen__title { margin-top: var(--space-2); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  @media (width >= 768px) { .specimen__title { font-size: var(--text-2xl); } }\n\n  .stats {\n    margin-top: var(--space-4);\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--space-4);\n    padding: var(--space-3) 0;\n    border-block-start: var(--border-width-thin) solid var(--border);\n    border-block-end: var(--border-width-thin) solid var(--border);\n  }\n  .stat dd { margin-top: var(--space-1); font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-sm); font-weight: 400; letter-spacing: var(--tracking-display); }\n\n  .pairs { margin-top: var(--space-4); display: grid; gap: var(--space-3); }\n  @media (width >= 640px) { .pairs { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }\n  .pairs p { margin-top: var(--space-1); font-size: var(--text-sm); }\n  .swap__from { color: var(--muted-foreground); text-decoration: line-through; text-decoration-thickness: 1px; }\n  .swap__arrow { padding: 0 var(--space-1); color: var(--muted-foreground); }\n  .swap__to { font-weight: 400; color: color-mix(in oklab, var(--accent) 60%, var(--foreground)); }\n\n  .steps { margin-top: var(--space-4); padding-top: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); display: grid; gap: var(--space-2); font-size: var(--text-sm); }\n  .step { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: var(--space-2); }\n  .step__n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); line-height: var(--leading-body); color: var(--muted-foreground); }\n\n  /* the deep field: one saturated mass on the page */\n  .field {\n    background: var(--primary);\n    color: var(--primary-foreground);\n    border-block-start: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 78%, var(--primary-foreground));\n    border-block-end: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 78%, var(--primary-foreground));\n  }\n  .field__inner { padding: var(--space-11) 0; }\n  .field__grid { display: grid; gap: 0; }\n  @media (width >= 768px) { .field__grid { grid-template-columns: 0.8fr 1.35fr 1fr; } }\n  .field__step { padding-top: var(--space-8); border-block-start: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 78%, var(--primary-foreground)); }\n  .field__step:first-child { padding-top: 0; border-block-start: 0; }\n  @media (width >= 768px) {\n    .field__step { padding: 0 0 0 var(--space-6); border-block-start: 0; border-inline-start: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 78%, var(--primary-foreground)); }\n    .field__step:first-child { padding: 0 var(--space-6) 0 0; border-inline-start: 0; }\n  }\n  .field__step h3 {\n    display: flex;\n    align-items: baseline;\n    gap: var(--space-2);\n    font-size: var(--text-base);\n    font-weight: 700;\n    letter-spacing: var(--tracking-tight);\n    color: var(--primary-foreground);\n  }\n  .field__step h3 span {\n    font-family: var(--font-mono);\n    font-variant-numeric: tabular-nums;\n    font-size: var(--text-xs);\n    font-weight: 400;\n    color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary));\n  }\n  .field .tape {\n    background: transparent;\n    border-color: color-mix(in oklab, var(--primary) 78%, var(--primary-foreground));\n    color: var(--primary-foreground);\n  }\n  .field .label { color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary)); }\n  .field .note { color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary)); }\n  .field .constraint dt { color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary)); }\n  .field .copylist li { border-color: color-mix(in oklab, var(--primary) 78%, var(--primary-foreground)); }\n  .field .copylist li span:last-child { color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary)); }\n\n  .chips { margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2); }\n  .note { margin-top: var(--space-4); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .constraints { margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }\n  .constraint { display: flex; align-items: baseline; gap: var(--space-2); }\n  .constraint dt { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .constraint dd { font-size: var(--text-xs); }\n  .copylist { margin-top: var(--space-4); display: grid; gap: var(--space-2); font-size: var(--text-xs); }\n  .copylist li { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); padding-bottom: var(--space-2); border-block-end: var(--border-width-thin) solid var(--border); }\n  .copylist li:last-child { padding-bottom: 0; border-block-end: 0; }\n  .copylist li span:last-child { color: var(--muted-foreground); }\n  .free {\n    background: var(--primary);\n    color: var(--primary-foreground);\n    border-block-start: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 78%, var(--primary-foreground));\n    border-block-end: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 78%, var(--primary-foreground));\n  }\n  .free__inner { padding: var(--space-7) 0; }\n  .free__grid { display: grid; gap: var(--space-4); }\n  @media (width >= 768px) { .free__grid { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); align-items: center; } }\n  .free__title { font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .free__title .n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 400; font-size: var(--text-2xl); line-height: var(--leading-solid); color: var(--primary-foreground); }\n  .free__note { margin-top: var(--space-2); font-size: var(--text-xs); color: color-mix(in oklab, var(--primary-foreground) 72%, var(--primary)); }\n  .free__link { font-size: var(--text-sm); font-weight: 700; color: var(--primary-foreground); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }\n  .free__link:hover { text-decoration-thickness: 2px; }\n  .strip { background: color-mix(in oklab, var(--primary) 6%, var(--background)); color: var(--foreground); border-block-start: var(--border-width-thin) solid var(--border); border-block-end: var(--border-width-thin) solid var(--border); }\n  .strip .field__step { border-color: var(--border); }\n  .strip .field__step h3 { color: var(--foreground); }\n  .strip .field__step h3 span { color: var(--muted-foreground); }\n  .popular__inner { padding: var(--space-12) 0; }\n  @media (width >= 768px) { .popular__inner { padding: var(--space-14) 0; } }\n  .sectionhead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .sectionhead h2 { font-size: var(--text-xl); font-weight: 700; letter-spacing: var(--tracking-tight); }\n  .sectionhead p { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  .table { margin-top: var(--space-6); border-block-start: var(--border-width-thin) solid var(--border); }\n  .thead { display: none; }\n  @media (width >= 768px) {\n    .thead {\n      display: grid;\n      grid-template-columns: 48px minmax(0, 1fr) 96px 136px 112px;\n      gap: var(--space-4);\n      align-items: baseline;\n      padding: var(--space-2) var(--space-2);\n      border-block-end: var(--border-width-thin) solid var(--border);\n    }\n    .thead span { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n    .thead .th--num { text-align: end; }\n  }\n  .row { border-block-end: var(--border-width-thin) solid var(--border); }\n  .row a {\n    display: grid;\n    grid-template-columns: 32px minmax(0, 1fr);\n    align-items: baseline;\n    gap: var(--space-1) var(--space-4);\n    padding: var(--space-4) var(--space-2);\n    color: var(--foreground);\n    text-decoration: none;\n    transition: background-color 140ms cubic-bezier(0.23, 1, 0.32, 1);\n  }\n  .row a:hover { background: color-mix(in oklab, var(--primary) 8%, var(--background)); }\n  @media (width >= 768px) {\n    .row a { grid-template-columns: 48px minmax(0, 1fr) 96px 136px 112px; gap: var(--space-4); padding: var(--space-4) var(--space-2); }\n    .row a:hover .title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }\n  }\n  .rank { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); }\n  .figure { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); letter-spacing: var(--tracking-display); }\n  .unit { margin-inline-start: var(--space-1); font-size: var(--text-xs); color: var(--muted-foreground); }\n  @media (width <= 767.98px) { .figure { grid-column: 2; } }\n  @media (width >= 768px) {\n    .row .figure { text-align: end; }\n    .unit { display: none; }\n  }\n\n  .strip--plain { background: transparent; border-color: var(--border); }\n  .pop { background: color-mix(in oklab, var(--primary) 6%, var(--background)); border-block-start: var(--border-width-thin) solid var(--border); border-block-end: var(--border-width-thin) solid var(--border); }\n  .pop__inner { padding: var(--space-12) 0 var(--space-14); }\n  @media (width >= 768px) { .pop__inner { padding: var(--space-14) 0 var(--space-16); } }\n  .pop__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .pop__head h2 { font-size: var(--text-xl); font-weight: 700; letter-spacing: var(--tracking-tight); }\n  .pop__head p { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .cards { margin-top: var(--space-6); display: grid; gap: var(--space-3); }\n  .cards > li { display: grid; container: card / inline-size; }\n  @media (width >= 768px) {\n    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }\n    .cards > li:first-child { grid-column: 1 / -1; }\n    .cards > li:first-child .card { padding: var(--space-6) var(--space-6) var(--space-6); }\n    .cards > li:first-child .card__title { font-size: var(--text-2xl); }\n    .cards > li:first-child .card__ings { -webkit-line-clamp: 1; line-clamp: 1; }\n  }\n  .card {\n    display: grid;\n    grid-template-columns: 40px minmax(0, 1fr);\n    grid-template-areas:\n      \"rank title\"\n      \"rank ings\"\n      \"rank meta\";\n    align-content: start;\n    column-gap: var(--space-4);\n    padding: var(--space-5) var(--space-5) var(--space-5);\n    border: var(--border-width-thin) solid color-mix(in oklab, var(--primary) 30%, var(--border));\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--foreground);\n    text-decoration: none;\n    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1), border-color 220ms cubic-bezier(0.23, 1, 0.32, 1);\n  }\n  .card:hover { transform: scale(0.984); border-color: var(--primary); }\n  .card:active { transform: scale(0.972); }\n  .card__body { display: contents; }\n  .card__rank { grid-area: rank; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xl); line-height: var(--leading-solid); color: var(--muted-foreground); }\n  .card__title { grid-area: title; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1); transform-origin: left center; }\n  @media (width >= 768px) { .card__title { font-size: var(--text-xl); } }\n  .card:hover .card__title { transform: scale(1.02); }\n  .card__ings { grid-area: ings; min-inline-size: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; margin-top: var(--space-2); padding-bottom: var(--space-3); border-block-end: var(--border-width-thin) solid var(--border); font-size: var(--text-xs); line-height: var(--leading-ui); color: var(--muted-foreground); }\n  @media (width <= 767.98px) {\n    .card__rank { font-size: var(--text-lg); }\n  }\n  .card__meta { grid-area: meta; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2); margin-top: var(--space-4); min-inline-size: 0; }\n  .card__meta > span { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--space-3); min-inline-size: 0; }\n  .card__fig { grid-column: 2; grid-row: 1; text-align: end; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); line-height: var(--leading-tight); letter-spacing: var(--tracking-display); white-space: nowrap; }\n  .card__unit { grid-column: 1; grid-row: 1; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; white-space: nowrap; color: var(--muted-foreground); }\n  @container card (inline-size >= 380px) and (inline-size <= 779.98px) {\n    .card__meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); gap: 0 var(--space-3); }\n    .card__meta > span { grid-template-columns: minmax(0, 1fr); gap: 3px; }\n    .card__fig { grid-column: 1; grid-row: 1; text-align: start; }\n    .card__unit { grid-column: 1; grid-row: 2; }\n  }\n  @container card (inline-size >= 780px) {\n    .card {\n      grid-template-columns: 40px minmax(0, 1fr) 264px;\n      grid-template-areas:\n        \"rank title meta\"\n        \"rank ings meta\";\n      column-gap: var(--space-6);\n    }\n    .card__title { align-self: start; }\n    .card__ings { align-self: end; }\n    .card__ings { padding-bottom: 0; border-block-end: none; }\n    .card__meta { margin-top: 0; padding-inline-start: var(--space-6); border-inline-start: var(--border-width-thin) solid var(--border); gap: var(--space-3); align-content: start; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .card, .card__title { transition: none; }\n    .card:hover, .card:active { transform: none; }\n    .card:hover .card__title { transform: none; }\n  }\n  /* packs: four one-time purchase tiers, no subscription */\n  .packs { border-block-start: var(--border-width-thin) solid var(--border); }\n  .packs__inner { padding: var(--space-12) 0 var(--space-14); }\n  @media (width >= 768px) { .packs__inner { padding: var(--space-14) 0 var(--space-16); } }\n  .packs__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .packs__head h2 { font-size: var(--text-xl); font-weight: 700; letter-spacing: var(--tracking-tight); }\n  .packs__head p { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .packs__grid { margin-top: var(--space-6); display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1fr); }\n  @media (width >= 640px) { .packs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (width >= 1024px) { .packs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }\n  .pack { display: flex; flex-direction: column; padding: var(--space-5) var(--space-5) var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n  .pack--starter { border-color: color-mix(in oklab, var(--primary) 40%, var(--border)); }\n  .pack--best { border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n  .pack__top { min-block-size: 26px; }\n  .pack__flag { display: inline-flex; align-items: center; min-block-size: 22px; padding: 0 var(--space-2); border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-foreground); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; }\n  .pack__price { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-2xl); line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .pack__credits { margin-top: var(--space-2); font-size: var(--text-sm); font-weight: 700; }\n  .pack__rate { margin-top: var(--space-1); margin-bottom: var(--space-5); font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .pack__buy { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); color: var(--foreground); font-size: var(--text-xs); font-weight: 700; text-decoration: none; }\n  .pack__buy:hover { border-color: var(--foreground); }\n  .pack--starter .pack__buy { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n  .pack--starter .pack__buy:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); border-color: transparent; }\n  .packs__fine { margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .free__note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }\n\n  .site-footer { background: var(--secondary); border-block-start: var(--border-width-thin) solid var(--border); }\n  .site-footer .wrap { padding-top: var(--space-8); padding-bottom: var(--space-8); }\n  .footer__grid { display: grid; gap: var(--space-8); }\n  @media (width >= 768px) { .footer__grid { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-16); align-items: end; } }\n  .footer__brand { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .footer__note { margin-top: var(--space-3); max-inline-size: 46ch; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .footer__links { margin-top: var(--space-4); display: flex; gap: var(--space-6); }\n  .footer__links a { font-size: var(--text-xs); color: var(--foreground); text-decoration: none; }\n  .footer__links a:hover { text-decoration: underline; text-underline-offset: 4px; }\n\n  .scheme { min-inline-size: 0; padding: 0; border: 0; }\n  .scheme legend { margin-bottom: var(--space-2); padding: 0; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .switch { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: var(--card); }\n  .opt { position: relative; display: inline-flex; align-items: center; justify-content: center; min-block-size: 36px; padding: 0 var(--space-3); border-radius: calc(var(--radius-md) - 2px); font-size: var(--text-xs); color: var(--muted-foreground); cursor: pointer; }\n  .opt input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n  .opt span { display: inline-flex; align-items: center; min-block-size: 30px; padding: 0 var(--space-2); border-radius: calc(var(--radius-md) - 3px); }\n  .opt input:checked + span { background: var(--primary); color: var(--primary-foreground); }\n  .opt input:focus-visible + span { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .btn { transition: none; }\n    .btn:active { transform: none; }\n    .row a { transition: opacity 120ms linear; }\n  }\n\n  /* site sign: mark, mono nav, plate set on the CTA's edge */\n  .sign { position: sticky; inset-block-start: 0; z-index: 20; background: var(--background); border-block-end: var(--border-width-thin) solid var(--border); }\n  .deck--sign { block-size: 72px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-6); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-3); justify-self: start; text-decoration: none; }\n  .wordmark { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); color: var(--foreground); }\n  .nav { display: none; align-items: center; gap: var(--space-7); justify-self: center; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  @media (width >= 768px) { .nav { display: flex; } }\n  .nav a { color: inherit; text-decoration: none; transition: color 130ms linear; }\n  .nav a:hover { color: var(--foreground); }\n  .cta { position: relative; justify-self: end; display: inline-flex; align-items: center; min-block-size: 44px; padding: 0 var(--space-5) 0 var(--space-8); border: var(--border-width-thin) solid var(--primary); border-radius: var(--radius); background: var(--primary); color: var(--primary-foreground); font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); text-decoration: none; white-space: nowrap; transition: background 150ms linear, color 150ms linear; }\n  .cta:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); color: var(--primary-foreground); }\n  .cta:active { transform: scale(0.97); }\n  .cta__plate { position: absolute; inset-inline-start: -19px; inset-block-start: 50%; margin-top: calc(var(--space-5) * -1); inline-size: 40px; block-size: 40px; border-radius: 50%; background: var(--card); border: var(--border-width-thin) solid var(--border); display: grid; place-items: center; color: var(--foreground); transition: border-color 150ms linear; }\n  .cta:hover .cta__plate { border-color: var(--primary); }\n  .plate { display: block; overflow: visible; }\n  .mk { display: block; flex: none; overflow: visible; }\n  /* the mark: face on primary, toque on accent, eyes punched in primary-foreground */\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-blink, .fork__rock, .knife__rock { transform-box: fill-box; transform-origin: center; }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  @media (prefers-reduced-motion: no-preference) {\n    .mk-blink { animation: blink 5.6s cubic-bezier(0.23, 1, 0.32, 1) infinite; }\n    .fork__rock { animation: rock 3.8s ease-in-out infinite; }\n    .knife__rock { animation: rock 3.8s ease-in-out infinite -1.9s; }\n  }\n  @keyframes blink { 0%, 90%, 100% { transform: scaleY(1); } 93.5%, 95.5% { transform: scaleY(0.1); } }\n  @keyframes rock { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }\n  @media (width <= 767.98px) { .deck--sign { grid-template-columns: minmax(0, 1fr) auto; } }\n\n  /* hero subhead: one sentence per line, right aligned, centred against the headline */\n  .hero__note .ln { display: block; }\n  .hero__note { max-inline-size: 100%; font-size: var(--text-sm); text-align: end; }\n  @media (width >= 768px) { .hero__grid { align-items: center; } }\n  @media (width >= 1024px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 480px; gap: var(--space-8); } }\n\n  /* credits: credit-count rail down the left edge of each pack */\n  .pack { position: relative; overflow: hidden; padding-inline-start: var(--space-8); }\n  .rail { position: absolute; inset-inline-start: 0; inset-block-start: 0; inset-block-end: 0; inline-size: 16px; background: var(--secondary); border-inline-end: var(--border-width-thin) solid var(--border); }\n  .rail i { position: absolute; inset-inline-start: 0; inset-inline-end: 0; inset-block-end: 0; block-size: calc(var(--f) * 100%); background: linear-gradient(to top, color-mix(in oklab, var(--primary) 86%, var(--foreground)), var(--primary)); }\n  .pack--best .rail { border-right-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n\n  /* pack flag: a highlighter stroke, two passes, under the lower half of the label */\n  .pack__top { margin-bottom: var(--space-2); }\n  .pack__flag { position: relative; isolation: isolate; padding: 2px var(--space-2) var(--space-1); border-radius: 0; background: none; color: var(--foreground); line-height: var(--leading-tight); }\n  .pack__flag::before { content: \"\"; position: absolute; z-index: -1; inset-inline-start: -4px; inset-inline-end: -4px; inset-block-start: 38%; inset-block-end: 2px; background: color-mix(in oklab, var(--accent) 26%, var(--background)); transform: skewX(-1.6deg) rotate(-0.8deg); border-radius: 2px; }\n  .pack__flag::after { content: \"\"; position: absolute; z-index: -2; inset-inline-start: -1px; inset-inline-end: -7px; inset-block-start: 46%; inset-block-end: 0; background: color-mix(in oklab, var(--accent) 14%, transparent); transform: skewX(1.2deg) rotate(0.6deg); border-radius: 2px; }\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n.sr-only{position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;font-size:var(--text-xs)}</style>\n<div data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"sign\" data-kid=\"1-1\">\n<div class=\"wrap\" data-kid=\"1-1-1\">\n<div class=\"deck--sign\" data-kid=\"1-1-1-1\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1-1\" data-name=\"site logo lockup home link\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1-1\" data-name=\"chef llama mascot logo icon\" height=\"38\" viewbox=\"0 0 32 32\" width=\"38\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\"><g class=\"mk-blink\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye mk-eye--far\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-1-1-1-2\" data-name=\"site header mono navigation\">\n<a data-kid=\"1-1-1-1-2-1\" href=\"#popular\">Popular</a>\n<a data-kid=\"1-1-1-1-2-2\" href=\"#credits\">Pricing</a>\n<a data-kid=\"1-1-1-1-2-3\" href=\"/how-to\">How to cook</a>\n</nav>\n<a class=\"cta\" data-kid=\"1-1-1-1-3\" data-name=\"start cooking header call-to-action\" href=\"/pantry\">\n<span class=\"cta__plate\" data-kid=\"1-1-1-1-3-1\" data-name=\"start cooking button plate icon container\">\n<svg aria-hidden=\"true\" class=\"plate\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"fork and knife plate icon\" height=\"24\" viewbox=\"0 0 22 22\" width=\"24\">\n<g transform=\"translate(11 11) scale(1.5) translate(-10.35 -10.8)\"><g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-1-3-2\">Start cooking</span>\n</a>\n</div>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\" data-name=\"hero inner container\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\" data-name=\"hero two-column grid\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero main headline\" id=\"site-hero\"><span class=\"ln\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline line one\">You’ve got the Pantry.</span> <span class=\"ln\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline line two\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\" data-name=\"hero supporting note text\"><span class=\"ln\" data-kid=\"1-2-1-1-2-1\">Your Diet and allergies are hard limits.</span> <span class=\"ln\" data-kid=\"1-2-1-1-2-2\">You cook it, save it, and find similar dishes from the same Pantry.</span></p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\" data-name=\"example recipe specimen card\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\" data-name=\"specimen pantry panel\">\n<div data-kid=\"1-2-1-2-1-1\" data-name=\"pantry ingredient label and chips\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"pantry section label\" style=\"font-size: var(--text-xs); letter-spacing:var(--tracking-caps)\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"pantry ingredient chips list\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"pantry chip: firm tofu\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"pantry chip: day-old rice\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\" data-name=\"pantry chip: soy sauce\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\" data-name=\"pantry attributes list\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"pantry attr row: diet\"><dt data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"pantry attr label: diet\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"pantry attr value: vegan\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"pantry attr row: allergy\"><dt data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"pantry attr label: allergy\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"pantry attr value: sesame\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"pantry attr row: servings\"><dt data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"pantry attr label: servings\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\" data-name=\"pantry attr value: 2\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\" data-name=\"specimen body panel\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\" data-name=\"specimen meta row (label + tag)\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"specimen example-recipe label\" style=\"font-size: var(--text-2xs); letter-spacing:var(--tracking-caps)\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"diet tag with dot (vegan)\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"tag status dot\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" data-name=\"specimen recipe title\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\" data-name=\"recipe stats grid\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"stat cell: minutes\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"stat label: minutes\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"stat value: 25\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"stat cell: servings\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"stat label: servings\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"stat value: 2\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\" data-name=\"stat cell: kcal per serving\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\" data-name=\"stat label: kcal per serving\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\" data-name=\"stat value: 480\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\" data-name=\"recipe extras pair row\">\n<div data-kid=\"1-2-1-2-2-4-1\" data-name=\"staples block\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\" data-name=\"staples label\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\" data-name=\"staples value text\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\" data-name=\"swap block\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\" data-name=\"swap label\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\" data-name=\"swap value with from, arrow, and to\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\" data-name=\"swapped-from ingredient (struck)\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\" data-name=\"swap arrow icon\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\" data-name=\"swapped-to ingredient\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\" data-name=\"recipe steps list\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\" data-name=\"step row 1\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\" data-name=\"step number 1\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\" data-name=\"step 1 instruction text\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\" data-name=\"step row 2\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\" data-name=\"step number 2\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\" data-name=\"step 2 instruction text\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\" data-name=\"step row 3\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\" data-name=\"step number 3\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\" data-name=\"step 3 instruction text\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\" data-name=\"step row 4\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\" data-name=\"step number 4\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\" data-name=\"step 4 instruction text\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"free-heading\" class=\"free\" data-kid=\"1-6\" data-name=\"daily-free-cooks band\">\n<div class=\"wrap free__inner\" data-kid=\"1-6-1\" data-name=\"free band inner container\">\n<div class=\"free__grid\" data-kid=\"1-6-1-1\" data-name=\"free band grid\">\n<div data-kid=\"1-6-1-1-1\" data-name=\"free band text block\">\n<h2 class=\"free__title\" data-kid=\"1-6-1-1-1-1\" data-name=\"free band headline\" id=\"free-heading\">Up to 3 free cooks a day.</h2>\n<p class=\"free__note\" data-kid=\"1-6-1-1-1-2\" data-name=\"free band sub-note\">First come first served from a shared pool. <a data-kid=\"1-6-1-1-1-2-1\" href=\"#credits\">Credits</a> when you need more.</p>\n</div>\n<a class=\"free__link\" data-kid=\"1-6-1-1-2\" data-name=\"free band start-cooking link\" href=\"/pantry\">Start cooking</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"strip strip--plain\" data-kid=\"1-3\" data-name=\"how-a-cook-runs section\">\n<div class=\"wrap field__inner\" data-kid=\"1-3-1\" data-name=\"how-a-cook-runs inner container\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-1\" data-name=\"visually hidden process heading\" id=\"process-heading\" style=\"position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-3-1-2\" data-name=\"process steps list\">\n<li class=\"field__step\" data-kid=\"1-3-1-2-1\" data-name=\"process step: add ingredients\">\n<h3 data-kid=\"1-3-1-2-1-1\" data-name=\"process step heading: add ingredients\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"process step number 1\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-3-1-2-1-2\" data-name=\"example ingredient chips\">\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"example chip: firm tofu\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"example chip: day-old rice\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-3\" data-name=\"example chip: soy sauce\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-3-1-2-1-3\" data-name=\"example ingredients minimum note\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-2\" data-name=\"process step: chef writes recipe\">\n<h3 data-kid=\"1-3-1-2-2-1\" data-name=\"process step heading: chef writes recipe\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"process step number 2\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-3-1-2-2-2\" data-name=\"example constraint chips (diet/allergy/servings)\">\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"constraint row: diet\"><dt data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"constraint label: diet\">Diet</dt><dd data-kid=\"1-3-1-2-2-2-1-2\" data-name=\"constraint value: vegan\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"constraint row: allergy\"><dt data-kid=\"1-3-1-2-2-2-2-1\" data-name=\"constraint label: allergy\">Allergy</dt><dd data-kid=\"1-3-1-2-2-2-2-2\" data-name=\"constraint value: sesame\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-3\" data-name=\"constraint row: servings\"><dt data-kid=\"1-3-1-2-2-2-3-1\" data-name=\"constraint label: servings\">Servings</dt><dd data-kid=\"1-3-1-2-2-2-3-2\" data-name=\"constraint value: 2\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-3-1-2-2-3\" data-name=\"process step 2 explanation note\" style=\"max-inline-size:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-3\" data-name=\"process step: cook the recipe\">\n<h3 data-kid=\"1-3-1-2-3-1\" data-name=\"process step heading: cook the recipe\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"process step number 3\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-3-1-2-3-2\" data-name=\"deliverables copy list\">\n<li data-kid=\"1-3-1-2-3-2-1\" data-name=\"deliverable row: method\"><span data-kid=\"1-3-1-2-3-2-1-1\" data-name=\"deliverable label: method\">Method</span><span data-kid=\"1-3-1-2-3-2-1-2\" data-name=\"deliverable description: method\">every step, numbered</span></li>\n<li data-kid=\"1-3-1-2-3-2-2\" data-name=\"deliverable row: save\"><span data-kid=\"1-3-1-2-3-2-2-1\" data-name=\"deliverable label: save\">Save</span><span data-kid=\"1-3-1-2-3-2-2-2\" data-name=\"deliverable description: save\">one tap to Saved</span></li>\n<li data-kid=\"1-3-1-2-3-2-3\" data-name=\"deliverable row: similar\"><span data-kid=\"1-3-1-2-3-2-3-1\" data-name=\"deliverable label: similar\">Similar</span><span data-kid=\"1-3-1-2-3-2-3-2\" data-name=\"deliverable description: similar\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"pop\" data-kid=\"1-4\" data-name=\"popular recipes section\" id=\"popular\">\n<div class=\"wrap pop__inner\" data-kid=\"1-4-1\" data-name=\"popular section inner container\">\n<div class=\"pop__head\" data-kid=\"1-4-1-1\" data-name=\"popular section header\">\n<h2 data-kid=\"1-4-1-1-1\" data-name=\"popular section heading\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-4-1-1-2\" data-name=\"popular rank-by subtitle\">Ranked by saves in the last 7 days</p>\n</div>\n<ol class=\"cards\" data-kid=\"1-4-1-2\" data-name=\"popular recipe cards list\">\n<li data-kid=\"1-4-1-2-1\" data-name=\"recipe card list item 1\">\n<a class=\"card\" data-kid=\"1-4-1-2-1-1\" data-name=\"recipe card 1 (skillet beans)\" href=\"/recipes/skillet-beans\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"recipe card rank 1\">1</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-1-1-2\" data-name=\"recipe card 1 body\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-1-1-2-1\" data-name=\"recipe card 1 title\">Skillet beans and greens</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-1-1-2-2\" data-name=\"recipe card 1 ingredients\">butter beans, cavolo nero, garlic, olive oil</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-1-1-2-3\" data-name=\"recipe card 1 stats row\"><span data-kid=\"1-4-1-2-1-1-2-3-1\" data-name=\"recipe card 1 stat: cook time\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-1-1\" data-name=\"recipe card 1 cook time figure\">25 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-1-2\" data-name=\"recipe card 1 cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-1-1-2-3-2\" data-name=\"recipe card 1 stat: kcal\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-2-1\" data-name=\"recipe card 1 kcal figure\">410 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-2-2\" data-name=\"recipe card 1 kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-1-1-2-3-3\" data-name=\"recipe card 1 stat: saves\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-3-1\" data-name=\"recipe card 1 saves figure\">86</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-3-2\" data-name=\"recipe card 1 saves unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-2\" data-name=\"recipe card list item 2\">\n<a class=\"card\" data-kid=\"1-4-1-2-2-1\" data-name=\"recipe card 2 (lemon lentils)\" href=\"/recipes/lemon-lentils\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"recipe card rank 2\">2</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"recipe card 2 body\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-2-1-2-1\" data-name=\"recipe card 2 title\">Lemon lentils with herbs</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-2-1-2-2\" data-name=\"recipe card 2 ingredients\">brown lentils, lemon, parsley, cumin</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-2-1-2-3\" data-name=\"recipe card 2 stats row\"><span data-kid=\"1-4-1-2-2-1-2-3-1\" data-name=\"recipe card 2 stat: cook time\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-1-1\" data-name=\"recipe card 2 cook time figure\">35 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-1-2\" data-name=\"recipe card 2 cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-2-1-2-3-2\" data-name=\"recipe card 2 stat: kcal\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-2-1\" data-name=\"recipe card 2 kcal figure\">380 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-2-2\" data-name=\"recipe card 2 kcal unit label\">Per serving</span></span><span data-ki