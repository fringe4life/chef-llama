.cta:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); color: var(--primary-foreground); }\n  .cta:active { transform: scale(0.97); }\n  .cta__plate { position: absolute; inset-inline-start: -19px; inset-block-start: 50%; margin-top: calc(var(--space-5) * -1); inline-size: 40px; block-size: 40px; border-radius: 50%; background: var(--card); border: var(--border-width-thin) solid var(--border); display: grid; place-items: center; color: var(--foreground); transition: border-color 150ms linear; }\n  .cta:hover .cta__plate { border-color: var(--primary); }\n  .plate { display: block; overflow: visible; }\n  .mk { display: block; flex: none; overflow: visible; }\n  /* the mark: face on primary, toque on accent, eyes punched in primary-foreground */\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-blink, .fork__rock, .knife__rock { transform-box: fill-box; transform-origin: center; }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  @media (prefers-reduced-motion: no-preference) {\n    .mk-blink { animation: blink 5.6s cubic-bezier(0.23, 1, 0.32, 1) infinite; }\n    .fork__rock { animation: rock 3.8s ease-in-out infinite; }\n    .knife__rock { animation: rock 3.8s ease-in-out infinite -1.9s; }\n  }\n  @keyframes blink { 0%, 90%, 100% { transform: scaleY(1); } 93.5%, 95.5% { transform: scaleY(0.1); } }\n  @keyframes rock { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }\n  @media (width <= 767.98px) { .deck--sign { grid-template-columns: minmax(0, 1fr) auto; } }\n  .hero__note .ln { display: block; }\n  .hero__note { max-inline-size: 100%; font-size: var(--text-sm); text-align: end; }\n  @media (width >= 768px) { .hero__grid { align-items: center; } }\n  @media (width >= 1024px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 480px; gap: var(--space-8); } }\n\n  /* credits: credit-count rail down the left edge of each pack */\n  .pack { position: relative; overflow: hidden; padding-inline-start: var(--space-8); }\n  .rail { position: absolute; inset-inline-start: 0; inset-block-start: 0; inset-block-end: 0; inline-size: 16px; background: var(--secondary); border-inline-end: var(--border-width-thin) solid var(--border); }\n  .rail i { position: absolute; inset-inline-start: 0; inset-inline-end: 0; inset-block-end: 0; block-size: calc(var(--f) * 100%); background: linear-gradient(to top, color-mix(in oklab, var(--primary) 86%, var(--foreground)), var(--primary)); }\n  .pack--best .rail { border-right-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n\n  /* pack flag: a highlighter stroke, two passes, under the lower half of the label */\n  .pack__top { margin-bottom: var(--space-2); }\n  .pack__flag { position: relative; isolation: isolate; padding: 2px var(--space-2) var(--space-1); border-radius: 0; background: none; color: var(--foreground); line-height: var(--leading-tight); }\n  .pack__flag::before { content: \"\"; position: absolute; z-index: -1; inset-inline-start: -4px; inset-inline-end: -4px; inset-block-start: 38%; inset-block-end: 2px; background: color-mix(in oklab, var(--accent) 26%, var(--background)); transform: skewX(-1.6deg) rotate(-0.8deg); border-radius: 2px; }\n  .pack__flag::after { content: \"\"; position: absolute; z-index: -2; inset-inline-start: -1px; inset-inline-end: -7px; inset-block-start: 46%; inset-block-end: 0; background: color-mix(in oklab, var(--accent) 14%, transparent); transform: skewX(1.2deg) rotate(0.6deg); border-radius: 2px; }\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n.sr-only{position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;font-size:var(--text-xs)}</style>\n<div data-kid=\"1\">\n<header class=\"sign\" data-kid=\"1-1\">\n<div class=\"wrap\" data-kid=\"1-1-1\">\n<div class=\"deck--sign\" data-kid=\"1-1-1-1\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1-1\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-dynamic=\"true\" data-kid=\"1-1-1-1-1-1\" data-name=\"chef llama mascot icon with blinking eye\" data-reason=\"eye group scaleY replaced by infinite blink keyframe animation\" height=\"38\" viewbox=\"0 0 32 32\" width=\"38\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\"><g class=\"mk-blink\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye mk-eye--far\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-1-2\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-1-1-1-2\">\n<a data-kid=\"1-1-1-1-2-1\" href=\"#popular\">Popular</a>\n<a data-kid=\"1-1-1-1-2-2\" href=\"#credits\">Pricing</a>\n<a data-kid=\"1-1-1-1-2-3\" href=\"/how-to\">How to cook</a>\n</nav>\n<a class=\"cta\" data-kid=\"1-1-1-1-3\" href=\"/pantry\">\n<span class=\"cta__plate\" data-kid=\"1-1-1-1-3-1\">\n<svg aria-hidden=\"true\" class=\"plate\" data-kid=\"1-1-1-1-3-1-1\" height=\"24\" viewbox=\"0 0 22 22\" width=\"24\">\n<g transform=\"translate(11 11) scale(1.5) translate(-10.35 -10.8)\"><g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-1-3-2\">Start cooking</span>\n</a>\n</div>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero main headline\" id=\"site-hero\"><span class=\"ln\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline first line\">You’ve got the Pantry.</span> <span class=\"ln\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline second line\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\"><span class=\"ln\" data-kid=\"1-2-1-1-2-1\">Your Diet and allergies are hard limits.</span> <span class=\"ln\" data-kid=\"1-2-1-1-2-2\">You cook it, save it, and find similar dishes from the same Pantry.</span></p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\">\n<div data-kid=\"1-2-1-2-1-1\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" style=\"font-size: var(--text-xs); letter-spacing:var(--tracking-caps)\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\"><dt data-kid=\"1-2-1-2-1-2-1-1\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\"><dt data-kid=\"1-2-1-2-1-2-2-1\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\"><dt data-kid=\"1-2-1-2-1-2-3-1\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" style=\"font-size: var(--text-2xs); letter-spacing:var(--tracking-caps)\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\">\n<div data-kid=\"1-2-1-2-2-4-1\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"free-heading\" class=\"free\" data-kid=\"1-6\" data-name=\"free cooks promotional section\">\n<div class=\"wrap free__inner\" data-kid=\"1-6-1\" data-name=\"free cooks section inner wrapper\">\n<div class=\"free__grid\" data-kid=\"1-6-1-1\" data-name=\"free cooks grid layout\">\n<div data-kid=\"1-6-1-1-1\" data-name=\"free cooks title and note block\">\n<h2 class=\"free__title\" data-kid=\"1-6-1-1-1-1\" data-name=\"free cooks headline with count\" id=\"free-heading\">Up to 3 free cooks a day.</h2>\n<p class=\"free__note\" data-kid=\"1-6-1-1-1-2\" data-name=\"free cooks reset and credits note\">First come first served from a shared pool. <a data-kid=\"1-6-1-1-1-2-1\" href=\"#credits\">Credits</a> when you need more.</p>\n</div>\n<a class=\"free__link\" data-kid=\"1-6-1-1-2\" data-name=\"free section call-to-action link\" href=\"/pantry\">Start cooking</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"strip strip--plain\" data-kid=\"1-3\">\n<div class=\"wrap field__inner\" data-kid=\"1-3-1\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-1\" id=\"process-heading\" style=\"position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-3-1-2\">\n<li class=\"field__step\" data-kid=\"1-3-1-2-1\">\n<h3 data-kid=\"1-3-1-2-1-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-1-1-1\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-3-1-2-1-2\">\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-1\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-2\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-3-1-2-1-2-3\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-3-1-2-1-3\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-2\">\n<h3 data-kid=\"1-3-1-2-2-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-2-1-1\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-3-1-2-2-2\">\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-1\"><dt data-kid=\"1-3-1-2-2-2-1-1\">Diet</dt><dd data-kid=\"1-3-1-2-2-2-1-2\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-2\"><dt data-kid=\"1-3-1-2-2-2-2-1\">Allergy</dt><dd data-kid=\"1-3-1-2-2-2-2-2\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-3-1-2-2-2-3\"><dt data-kid=\"1-3-1-2-2-2-3-1\">Servings</dt><dd data-kid=\"1-3-1-2-2-2-3-2\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-3-1-2-2-3\" style=\"max-inline-size:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-3-1-2-3\">\n<h3 data-kid=\"1-3-1-2-3-1\"><span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-1\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-3-1-2-3-2\">\n<li data-kid=\"1-3-1-2-3-2-1\"><span data-kid=\"1-3-1-2-3-2-1-1\">Method</span><span data-kid=\"1-3-1-2-3-2-1-2\">every step, numbered</span></li>\n<li data-kid=\"1-3-1-2-3-2-2\"><span data-kid=\"1-3-1-2-3-2-2-1\">Save</span><span data-kid=\"1-3-1-2-3-2-2-2\">one tap to Saved</span></li>\n<li data-kid=\"1-3-1-2-3-2-3\"><span data-kid=\"1-3-1-2-3-2-3-1\">Similar</span><span data-kid=\"1-3-1-2-3-2-3-2\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"pop\" data-kid=\"1-4\" id=\"popular\">\n<div class=\"wrap pop__inner\" data-kid=\"1-4-1\">\n<div class=\"pop__head\" data-kid=\"1-4-1-1\">\n<h2 data-kid=\"1-4-1-1-1\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-4-1-1-2\">Ranked by saves in the last 7 days</p>\n</div>\n<ol class=\"cards\" data-kid=\"1-4-1-2\">\n<li data-kid=\"1-4-1-2-1\">\n<a class=\"card\" data-kid=\"1-4-1-2-1-1\" href=\"/recipes/skillet-beans\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-1-1-1\">1</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-1-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-1-1-2-1\">Skillet beans and greens</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-1-1-2-2\">butter beans, cavolo nero, garlic, olive oil</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-1-1-2-3\"><span data-kid=\"1-4-1-2-1-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-1-1\" data-name=\"recipe card cook time figure\">25 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-1-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-2-1\" data-name=\"recipe card kcal figure\">410 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-1-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-1-1-2-3-3-1\" data-name=\"recipe card saves count figure\">86</span><span class=\"card__unit\" data-kid=\"1-4-1-2-1-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-2\">\n<a class=\"card\" data-kid=\"1-4-1-2-2-1\" href=\"/recipes/lemon-lentils\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-2-1-1\">2</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-2-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-2-1-2-1\">Lemon lentils with herbs</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-2-1-2-2\">brown lentils, lemon, parsley, cumin</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-2-1-2-3\"><span data-kid=\"1-4-1-2-2-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-1-1\" data-name=\"recipe card cook time figure\">35 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-2-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-2-1\" data-name=\"recipe card kcal figure\">380 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-2-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-2-1-2-3-3-1\" data-name=\"recipe card saves count figure\">61</span><span class=\"card__unit\" data-kid=\"1-4-1-2-2-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-3\">\n<a class=\"card\" data-kid=\"1-4-1-2-3-1\" href=\"/recipes/garlic-oil-pasta\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-3-1-1\">3</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-3-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-3-1-2-1\">Garlic oil pasta with kale</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-3-1-2-2\">spaghetti, garlic, kale, chilli flakes</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-3-1-2-3\"><span data-kid=\"1-4-1-2-3-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-1-1\" data-name=\"recipe card cook time figure\">20 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-3-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-2-1\" data-name=\"recipe card kcal figure\">520 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-3-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-3-1-2-3-3-1\" data-name=\"recipe card saves count figure\">44</span><span class=\"card__unit\" data-kid=\"1-4-1-2-3-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-4\">\n<a class=\"card\" data-kid=\"1-4-1-2-4-1\" href=\"/recipes/roast-squash-chickpeas\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-4-1-1\">4</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-4-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-4-1-2-1\">Roast squash and chickpeas</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-4-1-2-2\">butternut squash, chickpeas, cumin, yoghurt</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-4-1-2-3\"><span data-kid=\"1-4-1-2-4-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-4-1-2-3-1-1\" data-name=\"recipe card cook time figure\">40 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-4-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-4-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-4-1-2-3-2-1\" data-name=\"recipe card kcal figure\">445 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-4-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-4-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-4-1-2-3-3-1\" data-name=\"recipe card saves count figure\">29</span><span class=\"card__unit\" data-kid=\"1-4-1-2-4-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n<li data-kid=\"1-4-1-2-5\">\n<a class=\"card\" data-kid=\"1-4-1-2-5-1\" href=\"/recipes/braised-leeks\">\n<span class=\"card__rank\" data-kid=\"1-4-1-2-5-1-1\">5</span>\n<span class=\"card__body\" data-kid=\"1-4-1-2-5-1-2\">\n<span class=\"card__title\" data-kid=\"1-4-1-2-5-1-2-1\">Braised leeks on toast</span>\n<span class=\"card__ings\" data-kid=\"1-4-1-2-5-1-2-2\">leeks, sourdough, butter, thyme</span>\n<span class=\"card__meta\" data-kid=\"1-4-1-2-5-1-2-3\"><span data-kid=\"1-4-1-2-5-1-2-3-1\"><span class=\"card__fig\" data-kid=\"1-4-1-2-5-1-2-3-1-1\" data-name=\"recipe card cook time figure\">30 min</span><span class=\"card__unit\" data-kid=\"1-4-1-2-5-1-2-3-1-2\" data-name=\"recipe card cook time unit label\">Cook</span></span><span data-kid=\"1-4-1-2-5-1-2-3-2\"><span class=\"card__fig\" data-kid=\"1-4-1-2-5-1-2-3-2-1\" data-name=\"recipe card kcal figure\">390 kcal</span><span class=\"card__unit\" data-kid=\"1-4-1-2-5-1-2-3-2-2\" data-name=\"recipe card kcal unit label\">Per serving</span></span><span data-kid=\"1-4-1-2-5-1-2-3-3\"><span class=\"card__fig\" data-kid=\"1-4-1-2-5-1-2-3-3-1\" data-name=\"recipe card saves count figure\">18</span><span class=\"card__unit\" data-kid=\"1-4-1-2-5-1-2-3-3-2\" data-name=\"recipe card saves count unit label\">Saves</span></span></span>\n</span>\n</a>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"credits-heading\" class=\"packs\" data-kid=\"1-7\" id=\"credits\">\n<div class=\"wrap packs__inner\" data-kid=\"1-7-1\">\n<div class=\"packs__head\" data-kid=\"1-7-1-1\">\n<h2 data-kid=\"1-7-1-1-1\" id=\"credits-heading\">Credits</h2>\n<p data-kid=\"1-7-1-1-2\">One-time purchase. No subscription.</p>\n</div>\n<ol class=\"packs__grid\" data-kid=\"1-7-1-2\">\n<li class=\"pack pack--starter\" data-kid=\"1-7-1-2-1\">\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-7-1-2-1-1\"><i data-kid=\"1-7-1-2-1-1-1\" style=\"--f:0.29\"></i></span>\n<div class=\"pack__top\" data-kid=\"1-7-1-2-1-2\"><span class=\"pack__flag\" data-kid=\"1-7-1-2-1-2-1\">Starter pack, once only</span></div>\n<p class=\"pack__price\" data-kid=\"1-7-1-2-1-3\">NZ$4</p>\n<p class=\"pack__credits\" data-kid=\"1-7-1-2-1-4\">10 Credits</p>\n<p class=\"pack__rate\" data-kid=\"1-7-1-2-1-5\">NZ$0.40 per Credit</p>\n<a class=\"pack__buy\" data-kid=\"1-7-1-2-1-6\" href=\"/pantry\">Buy Starter pack</a>\n</li>\n<li class=\"pack\" data-kid=\"1-7-1-2-2\">\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-7-1-2-2-1\"><i data-kid=\"1-7-1-2-2-1-1\" style=\"--f:0.41\"></i></span>\n<div class=\"pack__top\" data-kid=\"1-7-1-2-2-2\"></div>\n<p class=\"pack__price\" data-kid=\"1-7-1-2-2-3\">NZ$8</p>\n<p class=\"pack__credits\" data-kid=\"1-7-1-2-2-4\">20 Credits</p>\n<p class=\"pack__rate\" data-kid=\"1-7-1-2-2-5\">NZ$0.40 per Credit</p>\n<a class=\"pack__buy\" data-kid=\"1-7-1-2-2-6\" href=\"/pantry\">Buy 20 Credits</a>\n</li>\n<li class=\"pack\" data-kid=\"1-7-1-2-3\">\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-7-1-2-3-1\"><i data-kid=\"1-7-1-2-3-1-1\" style=\"--f:0.65\"></i></span>\n<div class=\"pack__top\" data-kid=\"1-7-1-2-3-2\"></div>\n<p class=\"pack__price\" data-kid=\"1-7-1-2-3-3\">NZ$16</p>\n<p class=\"pack__credits\" data-kid=\"1-7-1-2-3-4\">50 Credits</p>\n<p class=\"pack__rate\" data-kid=\"1-7-1-2-3-5\">NZ$0.32 per Credit</p>\n<a class=\"pack__buy\" data-kid=\"1-7-1-2-3-6\" href=\"/pantry\">Buy 50 Credits</a>\n</li>\n<li class=\"pack pack--best\" data-kid=\"1-7-1-2-4\">\n<span aria-hidden=\"true\" class=\"rail\" data-kid=\"1-7-1-2-4-1\"><i data-kid=\"1-7-1-2-4-1-1\" style=\"--f:1\"></i></span>\n<div class=\"pack__top\" data-kid=\"1-7-1-2-4-2\"><span class=\"pack__flag\" data-kid=\"1-7-1-2-4-2-1\">Best rate</span></div>\n<p class=\"pack__price\" data-kid=\"1-7-1-2-4-3\">NZ$32</p>\n<p class=\"pack__credits\" data-kid=\"1-7-1-2-4-4\">120 Credits</p>\n<p class=\"pack__rate\" data-kid=\"1-7-1-2-4-5\">NZ$0.27 per Credit</p>\n<a class=\"pack__buy\" data-kid=\"1-7-1-2-4-6\" href=\"/pantry\">Buy 120 Credits</a>\n</li>\n</ol>\n<p class=\"packs__fine\" data-kid=\"1-7-1-3\">1 Credit pays for 1 Generate. Prices in NZD.</p>\n</div>\n</section>\n<footer class=\"site-footer\" data-kid=\"1-5\">\n<div class=\"wrap\" data-kid=\"1-5-1\">\n<div class=\"footer__grid\" data-kid=\"1-5-1-1\">\n<div data-kid=\"1-5-1-1-1\">\n<p class=\"footer__brand\" data-kid=\"1-5-1-1-1-1\">Chef Llama</p>\n<p class=\"footer__note\" data-kid=\"1-5-1-1-1-2\">Recipes are generated by a small model. Check ingredients and allergens yourself.</p>\n<nav aria-label=\"Legal\" class=\"footer__links\" data-kid=\"1-5-1-1-1-3\">\n<a data-kid=\"1-5-1-1-1-3-1\" href=\"/terms\">Terms</a>\n<a data-kid=\"1-5-1-1-1-3-2\" href=\"/privacy\">Privacy</a>\n</nav>\n</div>\n<fieldset class=\"scheme\" data-kid=\"1-5-1-1-2\">\n<legend data-kid=\"1-5-1-1-2-1\">Appearance</legend>\n<div class=\"switch\" data-kid=\"1-5-1-1-2-2\">\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-1\"><input checked=\"\" data-kid=\"1-5-1-1-2-2-1-1\" id=\"scheme-system\" name=\"scheme\" type=\"radio\" value=\"system\"/><span data-kid=\"1-5-1-1-2-2-1-2\">System</span></label>\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-2\"><input data-kid=\"1-5-1-1-2-2-2-1\" id=\"scheme-light\" name=\"scheme\" type=\"radio\" value=\"light\"/><span data-kid=\"1-5-1-1-2-2-2-2\">Light</span></label>\n<label class=\"opt\" data-kid=\"1-5-1-1-2-2-3\"><input data-kid=\"1-5-1-1-2-2-3-1\" id=\"scheme-dark\" name=\"scheme\" type=\"radio\" value=\"dark\"/><span data-kid=\"1-5-1-1-2-2-3-2\">Dark</span></label>\n</div>\n</fieldset>\n</div>\n</div>\n</footer>\n</div>\n",
      "comments": [],
      "created": "2026-11-14T06:53:10.048391+00:00",
      "modified": "2026-11-18T06:07:01.382Z",
      "id": "var_paletteSaffron",
      "overrides": {},
      "contentHeight": 2312
    },
    "var_30e1fa7186c2": {
      "type": "variant",
      "label": "Palette 4 — Moss and Sunflower tokens",
      "parentId": "var_paletteSaffron",
      "themeId": null,
      "rect": {
        "x": 17380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  :root {\n    color-scheme: light dark;\n\n\n\n    /* every value inline, one per scheme: no primitive layer */\n    --background: light-dark(oklch(0.972 0.016 112), oklch(0.185 0.014 128));\n    --foreground: light-dark(oklch(0.255 0.045 128), oklch(0.945 0.022 108));\n    --card: light-dark(oklch(0.992 0.008 112), oklch(0.235 0.016 128));\n    --card-foreground: var(--foreground);\n    --popover: var(--card);\n    --popover-foreground: var(--card-foreground);\n    --primary: light-dark(oklch(0.552 0.142 126.8), oklch(0.735 0.165 128));\n    --primary-foreground: light-dark(oklch(0.992 0.012 100), oklch(0.200 0.045 127));\n    --secondary: light-dark(oklch(0.948 0.026 112), oklch(0.262 0.018 127));\n    --secondary-foreground: light-dark(oklch(0.265 0.045 128), oklch(0.930 0.024 108));\n    --muted: light-dark(oklch(0.935 0.022 110), oklch(0.272 0.016 127));\n    --muted-foreground: light-dark(oklch(0.465 0.038 120), oklch(0.750 0.030 110));\n    --accent: light-dark(oklch(0.760 0.155 78), oklch(0.840 0.140 78));\n    --accent-foreground: oklch(0.200 0.045 78);\n    /* blaze orange holds the paid mark, so destructive drops to a deeper, redder value */\n    --destructive: light-dark(oklch(0.470 0.170 25), oklch(0.640 0.170 25));\n    --destructive-foreground: light-dark(oklch(0.992 0.012 100), oklch(0.200 0.045 25));\n    --border: light-dark(oklch(0.885 0.026 112), oklch(0.330 0.018 127));\n    --input: light-dark(oklch(0.862 0.028 112), oklch(0.352 0.020 127));\n    --ring: light-dark(oklch(0.552 0.142 126.8), oklch(0.735 0.165 128));\n\n\n    /* the chart takes two marks, not five slots: gift and credit.\n       mark values sit a step below the brand swatches: at 0.64-0.68 lightness\n       blaze orange and lime moss reach only 2.8-3.0:1 on the paper ground. */\n    --chart-gift: light-dark(oklch(0.585 0.155 129), oklch(0.790 0.165 129));\n    --chart-credit: light-dark(oklch(0.580 0.190 42), oklch(0.745 0.175 46));\n    --chart-gift-ink: color-mix(in oklab, var(--chart-gift) 70%, var(--foreground));\n    --chart-credit-ink: color-mix(in oklab, var(--chart-credit) 70%, var(--foreground));\n    --chart-gift-wash: color-mix(in oklab, var(--chart-gift) 45%, var(--background));\n    --chart-credit-wash: color-mix(in oklab, var(--chart-credit) 45%, var(--background));\n    --chart-rim: color-mix(in oklab, var(--foreground) 40%, var(--background));\n\n\n    --radius: 0.5rem;\n    --radius-sm: calc(var(--radius) * 0.5);\n    --radius-md: var(--radius);\n    --radius-lg: calc(var(--radius) * 1.5);\n  --radius-xl: calc(var(--radius) * 2);\n  --border-width-thin: 1px;\n  --border-width-medium: 2px;\n  --border-width-thick: 3px;\n\n    --font-display: Georgia, \"Times New Roman\", serif;\n    --font-sans: Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"Noto Sans\", \"DejaVu Sans\", source-sans-pro, sans-serif;\n    --font-mono: ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace;\n\n    --leading-solid: 1;\n\n    --leading-tight: 1.2;\n    --leading-ui: 1.45;\n    --leading-body: 1.55;\n    --tracking-tight: -0.01em;\n    --tracking-display: -0.02em;\n    --tracking-caps: 0.14em;\n    \n  \n    --spacing: 0.25rem;\n    --font-base: 1rem;\n    --text-2xs: calc(var(--font-base) * 0.625);\n    --text-xs: calc(var(--font-base) * 0.75);\n    --text-sm: calc(var(--font-base) * 0.875);\n    --text-base: calc(var(--font-base) * 1);\n    --text-lg: calc(var(--font-base) * 1.125);\n    --text-xl: calc(var(--font-base) * 1.5);\n    --text-2xl: calc(var(--font-base) * 1.875);\n    --text-4xl: calc(var(--font-base) * 2.5);\n    --space-1: calc(var(--spacing) * 1);\n    --space-2: calc(var(--spacing) * 2);\n    --space-3: calc(var(--spacing) * 3);\n    --space-4: calc(var(--spacing) * 4);\n    --space-5: calc(var(--spacing) * 5);\n    --space-6: calc(var(--spacing) * 6);\n    --space-7: calc(var(--spacing) * 7);\n    --space-8: calc(var(--spacing) * 8);\n    --space-9: calc(var(--spacing) * 9);\n    --space-10: calc(var(--spacing) * 10);\n    --space-11: calc(var(--spacing) * 11);\n    --space-12: calc(var(--spacing) * 12);\n    --space-13: calc(var(--spacing) * 13);\n    --space-14: calc(var(--spacing) * 14);\n    --space-15: calc(var(--spacing) * 15);\n    --space-16: calc(var(--spacing) * 16);\n    --space-17: calc(var(--spacing) * 17);\n    --space-18: calc(var(--spacing) * 18);\n    --space-19: calc(var(--spacing) * 19);\n    --space-20: calc(var(--spacing) * 20);}\n\n  html:has(#scheme-light:checked) { color-scheme: light; }\n  html:has(#scheme-dark:checked) { color-scheme: dark; }\n\n  body {\n    margin: 0;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-sm);\n    line-height: var(--leading-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, h3, p, dl, dd, dt, ol, ul, fieldset, legend { margin: 0; }\n  ul, ol { padding: 0; list-style: none; }\n  a:focus-visible, button:focus-visible, input:focus-visible { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  .wrap {\n  box-sizing: border-box; inline-size: 100%; max-inline-size: calc(var(--page-measure) + var(--space-page) * 2); margin-inline: auto; padding-inline: var(--space-page)\n}\n  \n\n  .label {\n    font-family: var(--font-mono);\n    font-size: var(--text-2xs);\n    line-height: var(--leading-ui);\n    letter-spacing: var(--tracking-caps);\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n\n  .site-header { border-block-end: var(--border-width-thin) solid var(--border); }\n  .site-header .wrap { display: flex; align-items: center; gap: var(--space-8); block-size: 80px; }\n  .wordmark {\n    font-family: var(--font-display);\n    font-size: var(--text-xl);\n    font-weight: 700;\n    line-height: var(--leading-solid);\n    letter-spacing: var(--tracking-tight);\n    color: var(--foreground);\n    text-decoration: none;\n  }\n  .site-nav { display: none; align-items: center; gap: var(--space-6); }\n  @media (width >= 768px) { .site-nav { display: flex; } }\n  .site-nav a { font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none; }\n  .site-nav a:hover { color: var(--foreground); }\n  .btn {\n    margin-inline-start: auto;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-block-size: 44px;\n    padding: 0 var(--space-5);\n    border: var(--border-width-thin) solid var(--primary);\n    border-radius: var(--radius-md);\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-family: var(--font-sans);\n    font-size: var(--text-sm);\n    font-weight: 700;\n    line-height: var(--leading-tight);\n    text-decoration: none;\n    white-space: nowrap;\n    transition: background-color 120ms cubic-bezier(0.23, 1, 0.32, 1), transform 120ms cubic-bezier(0.23, 1, 0.32, 1);\n  }\n  .btn:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); }\n  .btn:active { transform: scale(0.97); }\n\n  .hero__inner { padding: var(--space-10) 0; }\n  @media (width >= 768px) { .hero__inner { padding: var(--space-12) 0; } }\n  .hero__grid { display: grid; gap: var(--space-6); }\n  @media (width >= 768px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 336px; gap: var(--space-16); align-items: end; } }\n  .hero__title { max-inline-size: 700px; font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }\n  .hero__title .ln { display: inline; }\n  @media (width >= 768px) { .hero__title { font-size: var(--text-4xl); } .hero__title .ln { display: block; } }\n  .hero__note { max-inline-size: 340px; padding-top: var(--space-4); border-block-start: var(--border-width-thin) solid var(--border); font-size: var(--text-sm); color: var(--muted-foreground); }\n  @media (width >= 768px) { .hero__note { padding-top: 0; border-block-start: 0; } }