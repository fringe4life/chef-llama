ntent: start; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .card, .card__title { transition: none; }\n    .card:hover, .card:active { transform: none; }\n    .card:hover .card__title { transform: none; }\n  }\n\n  .packs { border-block-start: var(--border-width-thin) solid var(--border); }\n  .packs__inner { padding: var(--space-12) 0 var(--space-14); }\n  @media (width >= 768px) { .packs__inner { padding: var(--space-14) 0 var(--space-16); } }\n  .packs__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .packs__head h2 { font-size: var(--text-xl); font-weight: 700; letter-spacing: var(--tracking-tight); }\n  .packs__head p { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .packs__grid { margin-top: var(--space-6); display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1fr); }\n  @media (width >= 640px) { .packs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (width >= 1024px) { .packs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }\n  .pack { display: flex; flex-direction: column; padding: var(--space-5) var(--space-5) var(--space-5); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--card); }\n  .pack--starter { border-color: color-mix(in oklab, var(--primary) 40%, var(--border)); }\n  .pack--best { border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n  .pack__top { min-block-size: 26px; }\n  .pack__flag { display: inline-flex; align-items: center; min-block-size: 22px; padding: 0 var(--space-2); border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-foreground); font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; }\n  .pack__price { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-2xl); line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .pack__credits { margin-top: var(--space-2); font-size: var(--text-sm); font-weight: 700; }\n  .pack__rate { margin-top: var(--space-1); margin-bottom: var(--space-5); font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .pack__buy { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-block-size: 40px; padding: 0 var(--space-4); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); color: var(--foreground); font-size: var(--text-xs); font-weight: 700; text-decoration: none; }\n  .pack__buy:hover { border-color: var(--foreground); }\n  .pack--starter .pack__buy { border-color: var(--primary); background: var(--primary); color: var(--primary-foreground); }\n  .pack--starter .pack__buy:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); border-color: transparent; }\n  .packs__fine { margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n\n  .tokens { border-block-start: var(--border-width-thin) solid var(--border); background: var(--card); }\n  .tokens__inner { padding: var(--space-11) 0 var(--space-13); }\n  .tokens__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); }\n  .tokens__head h2 { font-size: var(--text-xl); font-weight: 700; letter-spacing: var(--tracking-tight); }\n  .tokens__head p { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .swatches { margin-top: var(--space-5); display: grid; gap: var(--space-3); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  @media (width >= 640px) { .swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n  @media (width >= 1024px) { .swatches { grid-template-columns: repeat(5, minmax(0, 1fr)); } }\n  .swatch { border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--background); }\n  .swatch__chip { block-size: 56px; }\n  .swatch__body { padding: var(--space-3) var(--space-3) var(--space-3); }\n  .swatch__name { font-size: var(--text-xs); font-weight: 700; line-height: var(--leading-tight); }\n  .swatch__val { margin-top: 3px; font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-body); letter-spacing: var(--tracking-tight); color: var(--muted-foreground); overflow-wrap: anywhere; }\n  .swatch__role { margin-top: var(--space-2); padding-top: var(--space-2); border-block-start: var(--border-width-thin) solid var(--border); font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: 0; text-transform: uppercase; color: var(--muted-foreground); }\n  .chip--orange { background: oklch(0.684 0.204 42.1); }\n  .chip--glow { background: oklch(0.891 0.177 102); }\n  .chip--lime { background: oklch(0.707 0.181 129.2); }\n  .chip--forest { background: oklch(0.552 0.142 126.8); }\n  .chip--sunflower { background: oklch(0.809 0.159 75.4); }\n\n  .tokens__sub { margin-top: var(--space-7); display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2); }\n  .tokens__sub h3 { font-size: var(--text-sm); font-weight: 700; letter-spacing: var(--tracking-tight); }\n  .tokens__sub p { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .semantics { margin-top: var(--space-3); display: grid; gap: var(--space-3); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  @media (width >= 640px) { .semantics { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n  @media (width >= 1024px) { .semantics { grid-template-columns: repeat(6, minmax(0, 1fr)); } }\n  .sem { border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); overflow: hidden; }\n  .sem__pair { display: grid; grid-template-columns: 1fr 1fr; block-size: 40px; }\n  .sem__name { display: block; padding: var(--space-2) var(--space-3); border-block-start: var(--border-width-thin) solid var(--border); background: var(--background); font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--leading-ui); letter-spacing: var(--tracking-tight); color: var(--muted-foreground); }\n\n  /* usage chart specimen: two marks, one wash, one rim */\n  .legend { margin-top: var(--space-4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .legend li { display: inline-flex; align-items: center; gap: var(--space-2); }\n  .sw { display: inline-block; inline-size: 11px; block-size: 11px; border-radius: 1px; }\n  .sw--gift { background: var(--chart-gift); }\n  .sw--credit { background: var(--chart-credit); }\n  .sw--prev {\n    background: linear-gradient(to top,\n      var(--chart-gift-wash) 0 calc(50% - 1px),\n      var(--background) calc(50% - 1px) calc(50% + 1px),\n      var(--chart-credit-wash) calc(50% + 1px) 100%);\n    box-shadow: inset 0 0 0 var(--border-width-thin) var(--chart-rim);\n  }\n\n  .lanes { margin-top: var(--space-2); border-block-start: var(--border-width-thin) solid var(--border); }\n  .lane {\n    display: grid;\n    grid-template-columns: 104px minmax(0, 1fr) 2.4em 2.6em 2.6em;\n    grid-template-areas:\n      \"head  head  hk    hnow  hprev\"\n      \"tagN  now   kfree fN    fP\"\n      \"tagP  prev  kpaid pN    pP\";\n    column-gap: var(--space-3);\n    row-gap: 3px;\n    align-items: center;\n    padding: var(--space-3) 0;\n    border-block-end: var(--border-width-thin) solid var(--border);\n  }\n  .lane:last-child { border-block-end: 0; }\n  .lane__head { grid-area: head; display: flex; align-items: baseline; gap: var(--space-2); }\n  .lane__date { font-family: var(--font-mono); font-size: var(--text-xs); }\n  .lane__nodash { margin-inline-start: auto; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }\n  .lane__tag { font-size: var(--text-xs); color: var(--muted-foreground); }\n  .lane__tag--now { grid-area: tagN; }\n  .lane__tag--prev { grid-area: tagP; }\n\n  .bar {\n    display: block;\n    align-self: center;\n    block-size: 11px;\n    inline-size: calc(var(--t) / var(--max) * 100%);\n    --split: calc(var(--g) / var(--t) * 100%);\n    background-image: linear-gradient(to right,\n      var(--chart-gift) 0 var(--split),\n      var(--background) var(--split) calc(var(--split) + 2px),\n      var(--chart-credit) calc(var(--split) + 2px) 100%);\n    background-repeat: no-repeat;\n  }\n  .bar--now { grid-area: now; }\n  .bar--prev {\n    grid-area: prev;\n    block-size: 9px;\n    inline-size: calc(var(--pt) / var(--max) * 100%);\n    --split: calc(var(--pg) / var(--pt) * 100%);\n    background-image: linear-gradient(to right,\n      var(--chart-gift-wash) 0 var(--split),\n      var(--background) var(--split) calc(var(--split) + 2px),\n      var(--chart-credit-wash) calc(var(--split) + 2px) 100%);\n    box-shadow: inset 0 0 0 var(--border-width-thin) var(--chart-rim);\n  }\n  .bar--absent { inline-size: 0; background-image: none; box-shadow: none; }\n\n  .v { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--text-xs); text-align: end; align-self: center; }\n  .v--free { color: var(--chart-gift-ink); }\n  .v--paid { color: var(--chart-credit-ink); }\n  .v--prev { color: var(--muted-foreground); }\n  .v--now-free { grid-area: fN; }\n  .v--now-paid { grid-area: pN; }\n  .v--prev-free { grid-area: fP; }\n  .v--prev-paid { grid-area: pP; }\n  .k, .h { font-size: var(--text-2xs); color: var(--muted-foreground); align-self: center; }\n  .k--free { grid-area: kfree; }\n  .k--paid { grid-area: kpaid; }\n  .h--blank { grid-area: hk; }\n  .h--now { grid-area: hnow; }\n  .h--prev { grid-area: hprev; }\n\n  .site-footer { background: var(--secondary); border-block-start: var(--border-width-thin) solid var(--border); }\n  .site-footer .wrap { padding-top: var(--space-8); padding-bottom: var(--space-8); }\n  .footer__grid { display: grid; gap: var(--space-8); }\n  @media (width >= 768px) { .footer__grid { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-16); align-items: end; } }\n  .footer__brand { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); }\n  .footer__note { margin-top: var(--space-3); max-inline-size: 46ch; font-size: var(--text-xs); color: var(--muted-foreground); }\n  .footer__links { margin-top: var(--space-4); display: flex; gap: var(--space-6); }\n  .footer__links a { font-size: var(--text-xs); color: var(--foreground); text-decoration: none; }\n  .footer__links a:hover { text-decoration: underline; text-underline-offset: 4px; }\n\n  .scheme { min-inline-size: 0; padding: 0; border: 0; }\n  .scheme legend { margin-bottom: var(--space-2); padding: 0; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  .switch { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1); border: var(--border-width-thin) solid var(--border); border-radius: var(--radius-md); background: var(--card); }\n  .opt { position: relative; display: inline-flex; align-items: center; justify-content: center; min-block-size: 36px; padding: 0 var(--space-3); border-radius: calc(var(--radius-md) - 2px); font-size: var(--text-xs); color: var(--muted-foreground); cursor: pointer; }\n  .opt input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }\n  .opt span { display: inline-flex; align-items: center; min-block-size: 30px; padding: 0 var(--space-2); border-radius: calc(var(--radius-md) - 3px); }\n  .opt input:checked + span { background: var(--primary); color: var(--primary-foreground); }\n  .opt input:focus-visible + span { outline: var(--border-width-medium) solid var(--ring); outline-offset: 2px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .btn { transition: none; }\n    .btn:active { transform: none; }\n  }\n\n  /* site sign: mark, mono nav, plate set on the CTA's edge */\n  .sign { position: sticky; inset-block-start: 0; z-index: 20; background: var(--background); border-block-end: var(--border-width-thin) solid var(--border); }\n  .deck--sign { block-size: 72px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-6); }\n  .lockup { display: inline-flex; align-items: center; gap: var(--space-3); justify-self: start; text-decoration: none; }\n  .wordmark { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-solid); letter-spacing: var(--tracking-display); color: var(--foreground); }\n  .nav { display: none; align-items: center; gap: var(--space-7); justify-self: center; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--muted-foreground); }\n  @media (width >= 768px) { .nav { display: flex; } }\n  .nav a { color: inherit; text-decoration: none; transition: color 130ms linear; }\n  .nav a:hover { color: var(--foreground); }\n  .cta { position: relative; justify-self: end; display: inline-flex; align-items: center; min-block-size: 44px; padding: 0 var(--space-5) 0 var(--space-8); border: var(--border-width-thin) solid var(--primary); border-radius: var(--radius); background: var(--primary); color: var(--primary-foreground); font-size: var(--text-sm); font-weight: 700; line-height: var(--leading-tight); text-decoration: none; white-space: nowrap; transition: background 150ms linear, color 150ms linear; }\n  .cta:hover { background: color-mix(in oklab, var(--primary) 92%, var(--foreground)); color: var(--primary-foreground); }\n  .cta:active { transform: scale(0.97); }\n  .cta__plate { position: absolute; inset-inline-start: -19px; inset-block-start: 50%; margin-top: calc(var(--space-5) * -1); inline-size: 40px; block-size: 40px; border-radius: 50%; background: var(--card); border: var(--border-width-thin) solid var(--border); display: grid; place-items: center; color: var(--foreground); transition: border-color 150ms linear; }\n  .cta:hover .cta__plate { border-color: var(--primary); }\n  .plate { display: block; overflow: visible; }\n  .mk { display: block; flex: none; overflow: visible; }\n  /* the mark: face on primary, toque on accent, eyes punched in primary-foreground */\n  .mk-crown { fill: var(--accent); }\n  .mk-band { fill: color-mix(in oklab, var(--accent) 76%, var(--foreground)); }\n  .mk-head { fill: var(--primary); }\n  .mk-eye { fill: var(--primary-foreground); }\n  .mk-blink, .fork__rock, .knife__rock { transform-box: fill-box; transform-origin: center; }\n  .mk-hat { transform-box: view-box; transform-origin: 16px 22px; transform: rotate(-16deg); }\n  @media (prefers-reduced-motion: no-preference) {\n    .mk-blink { animation: blink 5.6s cubic-bezier(0.23, 1, 0.32, 1) infinite; }\n    .fork__rock { animation: rock 3.8s ease-in-out infinite; }\n    .knife__rock { animation: rock 3.8s ease-in-out infinite -1.9s; }\n  }\n  @keyframes blink { 0%, 90%, 100% { transform: scaleY(1); } 93.5%, 95.5% { transform: scaleY(0.1); } }\n  @keyframes rock { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }\n  @media (width <= 767.98px) { .deck--sign { grid-template-columns: minmax(0, 1fr) auto; } }\n  .hero__note .ln { display: block; }\n  .hero__note { max-inline-size: 100%; font-size: var(--text-sm); text-align: end; }\n  @media (width >= 768px) { .hero__grid { align-items: center; } }\n  @media (width >= 1024px) { .hero__grid { grid-template-columns: minmax(0, 1fr) 480px; gap: var(--space-8); } }\n\n  /* credits: credit-count rail down the left edge of each pack */\n  .pack { position: relative; overflow: hidden; padding-inline-start: var(--space-8); }\n  .rail { position: absolute; inset-inline-start: 0; inset-block-start: 0; inset-block-end: 0; inline-size: 16px; background: var(--secondary); border-inline-end: var(--border-width-thin) solid var(--border); }\n  .rail i { position: absolute; inset-inline-start: 0; inset-inline-end: 0; inset-block-end: 0; block-size: calc(var(--f) * 100%); background: linear-gradient(to top, color-mix(in oklab, var(--primary) 86%, var(--foreground)), var(--primary)); }\n  .pack--best .rail { border-right-color: color-mix(in oklab, var(--primary) 55%, var(--border)); }\n\n  /* pack flag: a highlighter stroke, two passes, under the lower half of the label */\n  .pack__top { margin-bottom: var(--space-2); }\n  .pack__flag { position: relative; isolation: isolate; padding: 2px var(--space-2) var(--space-1); border-radius: 0; background: none; color: var(--foreground); line-height: var(--leading-tight); }\n  .pack__flag::before { content: \"\"; position: absolute; z-index: -1; inset-inline-start: -4px; inset-inline-end: -4px; inset-block-start: 38%; inset-block-end: 2px; background: color-mix(in oklab, var(--accent) 26%, var(--background)); transform: skewX(-1.6deg) rotate(-0.8deg); border-radius: 2px; }\n  .pack__flag::after { content: \"\"; position: absolute; z-index: -2; inset-inline-start: -1px; inset-inline-end: -7px; inset-block-start: 46%; inset-block-end: 0; background: color-mix(in oklab, var(--accent) 14%, transparent); transform: skewX(1.2deg) rotate(0.6deg); border-radius: 2px; }\n\n/* page frame — docs/theme.md#page-frame */\n:root { --page-measure: 72rem; --space-page: var(--space-5); }\n@media (width >= 48rem) { :root { --space-page: var(--space-8); } }\n\n.sr-only{position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;font-size:var(--text-xs)}</style>\n<div data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"sign\" data-kid=\"1-1\" data-name=\"site header / sticky top navigation\">\n<div class=\"wrap\" data-kid=\"1-1-1\" data-name=\"header inner wrapper\">\n<div class=\"deck--sign\" data-kid=\"1-1-1-1\" data-name=\"header sign row (logo nav CTA)\">\n<a aria-label=\"Chef Llama, home\" class=\"lockup\" data-kid=\"1-1-1-1-1\" data-name=\"brand lockup link to home\" href=\"/\">\n<svg aria-hidden=\"true\" class=\"mk\" data-kid=\"1-1-1-1-1-1\" data-name=\"chef llama mascot logo icon\" height=\"38\" viewbox=\"0 0 32 32\" width=\"38\">\n<g class=\"mk-hat\">\n<rect class=\"mk-band\" height=\"8.8\" rx=\"1.8\" width=\"12.8\" x=\"9.6\" y=\"9.4\"></rect>\n<ellipse class=\"mk-crown\" cx=\"15.2\" cy=\"9.6\" rx=\"9.8\" ry=\"4.6\" transform=\"rotate(-6 15.2 9.6)\"></ellipse>\n</g>\n<circle class=\"mk-head\" cx=\"16\" cy=\"22\" r=\"8.8\"></circle>\n<g class=\"mk-eyes\"><g class=\"mk-blink\">\n<rect class=\"mk-eye\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"11.35\" y=\"18.35\"></rect>\n<rect class=\"mk-eye mk-eye--far\" height=\"7.5\" rx=\"1.35\" width=\"2.9\" x=\"17.75\" y=\"18.35\"></rect>\n</g></g>\n</svg>\n<span class=\"wordmark\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand wordmark text\">Chef Llama</span>\n</a>\n<nav aria-label=\"Site\" class=\"nav\" data-kid=\"1-1-1-1-2\" data-name=\"main site navigation\">\n<a data-kid=\"1-1-1-1-2-1\" data-name=\"nav link to Popular section\" href=\"#popular\">Popular</a>\n<a data-kid=\"1-1-1-1-2-2\" data-name=\"nav link to Pricing section\" href=\"#credits\">Pricing</a>\n<a data-kid=\"1-1-1-1-2-3\" data-name=\"nav link to How to cook page\" href=\"/how-to\">How to cook</a>\n</nav>\n<a class=\"cta\" data-kid=\"1-1-1-1-3\" data-name=\"primary call-to-action Start cooking\" href=\"/pantry\">\n<span class=\"cta__plate\" data-kid=\"1-1-1-1-3-1\" data-name=\"CTA circular plate inset\">\n<svg aria-hidden=\"true\" class=\"plate\" data-dynamic=\"true\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"fork and knife plate icon\" data-reason=\"infinite CSS keyframe rock animation masks the authored orientation of the fork and knife\" height=\"24\" viewbox=\"0 0 22 22\" width=\"24\">\n<g transform=\"translate(11 11) scale(1.5) translate(-10.35 -10.8)\"><g class=\"fork\"><g class=\"fork__rock\">\n<rect fill=\"currentColor\" height=\"6.1\" rx=\"0.55\" width=\"1.1\" x=\"7.1\" y=\"9.3\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"6.5\" y=\"6.2\"></rect>\n<rect fill=\"currentColor\" height=\"2.7\" rx=\"0.5\" width=\"1\" x=\"7.8\" y=\"6.2\"></rect>\n</g></g>\n<g class=\"knife\"><g class=\"knife__rock\">\n<path d=\"M13.6 6.2c1.3 1.5 1.6 3.5.6 5.2h-1.5V8c0-.8.3-1.3.9-1.8z\" fill=\"currentColor\"></path>\n<rect fill=\"currentColor\" height=\"3.9\" rx=\"0.55\" width=\"1.1\" x=\"12.8\" y=\"11.5\"></rect>\n</g></g>\n</svg>\n</g>\n</svg>\n</span>\n<span data-kid=\"1-1-1-1-3-2\" data-name=\"CTA button label text\">Start cooking</span>\n</a>\n</div>\n</div>\n</header>\n<section aria-labelledby=\"site-hero\" class=\"hero\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"wrap hero__inner\" data-kid=\"1-2-1\" data-name=\"hero inner content wrapper\">\n<div class=\"hero__grid\" data-kid=\"1-2-1-1\" data-name=\"hero text grid\">\n<h1 class=\"hero__title\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline\" id=\"site-hero\"><span class=\"ln\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline first line\" data-reason=\"display changed to block at &gt;=768px so authored whitespace is masked into line breaks\">You’ve got the Pantry.</span> <span class=\"ln\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline second line\" data-reason=\"display changed to block at &gt;=768px so authored whitespace is masked into line breaks\">Chef Llama’s got the Recipe.</span></h1>\n<p class=\"hero__note\" data-kid=\"1-2-1-1-2\" data-name=\"hero supporting note\"><span class=\"ln\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero note first line\" data-reason=\"block display applied via .hero__note .ln overrides authored inline whitespace\">Your Diet and allergies are hard limits.</span> <span class=\"ln\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-2\" data-name=\"hero note second line\" data-reason=\"block display applied via .hero__note .ln overrides authored inline whitespace\">You cook it, save it, and find similar dishes from the same Pantry.</span></p>\n</div>\n<article aria-labelledby=\"specimen-title\" class=\"specimen\" data-kid=\"1-2-1-2\" data-name=\"example recipe specimen card\">\n<div class=\"specimen__pantry\" data-kid=\"1-2-1-2-1\" data-name=\"specimen pantry (ingredients) panel\">\n<div data-kid=\"1-2-1-2-1-1\" data-name=\"pantry ingredients group\">\n<h2 class=\"label\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"pantry panel label\" style=\"font-size: var(--text-xs); letter-spacing:var(--tracking-caps)\">Pantry</h2>\n<ul class=\"pantry__list\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"pantry ingredient chips list\">\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"ingredient chip: firm tofu\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"ingredient chip: day-old rice\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-2-1-2-1-1-2-3\" data-name=\"ingredient chip: soy sauce\">soy sauce</li>\n</ul>\n</div>\n<dl class=\"pantry__attrs\" data-kid=\"1-2-1-2-1-2\" data-name=\"pantry attribute list (diet allergy servings)\">\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"diet attribute row\"><dt data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"diet attribute label\">Diet</dt><dd data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"diet attribute value: vegan\">vegan</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"allergy attribute row\"><dt data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"allergy attribute label\">Allergy</dt><dd data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"allergy attribute value: sesame\">sesame</dd></div>\n<div class=\"attr\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"servings attribute row\"><dt data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"servings attribute label\">Servings</dt><dd data-kid=\"1-2-1-2-1-2-3-2\" data-name=\"servings attribute value\">2</dd></div>\n</dl>\n</div>\n<div class=\"specimen__body\" data-kid=\"1-2-1-2-2\" data-name=\"specimen recipe body\">\n<div class=\"specimen__meta\" data-kid=\"1-2-1-2-2-1\" data-name=\"specimen meta row (label and tag)\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"example recipe section label\" style=\"font-size: var(--text-2xs); letter-spacing:var(--tracking-caps)\">Example Recipe</p>\n<p class=\"tag\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"vegan diet tag\"><span aria-hidden=\"true\" class=\"tag__dot\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"vegan tag indicator dot\"></span>vegan</p>\n</div>\n<h2 class=\"specimen__title\" data-kid=\"1-2-1-2-2-2\" data-name=\"recipe title Tofu fried rice\" id=\"specimen-title\">Tofu fried rice</h2>\n<dl class=\"stats\" data-kid=\"1-2-1-2-2-3\" data-name=\"recipe stats row\">\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"stat: cook time\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"stat label: minutes\">Minutes</dt><dd data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"stat value: 25 minutes\">25</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"stat: servings\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"stat label: servings\">Servings</dt><dd data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"stat value: 2 servings\">2</dd></div>\n<div class=\"stat\" data-kid=\"1-2-1-2-2-3-3\" data-name=\"stat: kcal per serving\"><dt class=\"label\" data-kid=\"1-2-1-2-2-3-3-1\" data-name=\"stat label: kcal per serving\">kcal per serving</dt><dd data-kid=\"1-2-1-2-2-3-3-2\" data-name=\"stat value: 480 kcal\">480</dd></div>\n</dl>\n<div class=\"pairs\" data-kid=\"1-2-1-2-2-4\" data-name=\"recipe staples and swap row\">\n<div data-kid=\"1-2-1-2-2-4-1\" data-name=\"staples info group\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-1-1\" data-name=\"staples label\">Staples</p>\n<p data-kid=\"1-2-1-2-2-4-1-2\" data-name=\"staples description text\">neutral oil, salt</p>\n</div>\n<div data-kid=\"1-2-1-2-2-4-2\" data-name=\"swap suggestion group\">\n<p class=\"label\" data-kid=\"1-2-1-2-2-4-2-1\" data-name=\"swap label\">Swap</p>\n<p data-kid=\"1-2-1-2-2-4-2-2\" data-name=\"swap replacement text\"><span class=\"swap__from\" data-kid=\"1-2-1-2-2-4-2-2-1\" data-name=\"swap original ingredient (struck-through)\">chicken</span><span aria-hidden=\"true\" class=\"swap__arrow\" data-kid=\"1-2-1-2-2-4-2-2-2\" data-name=\"swap arrow symbol\">→</span><span class=\"swap__to\" data-kid=\"1-2-1-2-2-4-2-2-3\" data-name=\"swap replacement ingredient highlighted\">firm tofu</span></p>\n</div>\n</div>\n<ol class=\"steps\" data-kid=\"1-2-1-2-2-5\" data-name=\"recipe cooking steps list\">\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-1\" data-name=\"cooking step 1\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-1-1\" data-name=\"step number 1\">1</span><span data-kid=\"1-2-1-2-2-5-1-2\" data-name=\"step 1 instruction text\">Heat the oil in a wide pan until it shimmers.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-2\" data-name=\"cooking step 2\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-2-1\" data-name=\"step number 2\">2</span><span data-kid=\"1-2-1-2-2-5-2-2\" data-name=\"step 2 instruction text\">Fry the tofu in a single layer until the edges crisp, then push it to one side.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-3\" data-name=\"cooking step 3\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-3-1\" data-name=\"step number 3\">3</span><span data-kid=\"1-2-1-2-2-5-3-2\" data-name=\"step 3 instruction text\">Add the rice, break it up, and press it flat for a minute.</span></li>\n<li class=\"step\" data-kid=\"1-2-1-2-2-5-4\" data-name=\"cooking step 4\"><span aria-hidden=\"true\" class=\"step__n\" data-kid=\"1-2-1-2-2-5-4-1\" data-name=\"step number 4\">4</span><span data-kid=\"1-2-1-2-2-5-4-2\" data-name=\"step 4 instruction text\">Splash in the soy sauce, toss hard, and serve from the pan.</span></li>\n</ol>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"free-heading\" class=\"free\" data-kid=\"1-3\" data-name=\"free tier promo band\">\n<div class=\"wrap free__inner\" data-kid=\"1-3-1\" data-name=\"free tier band inner wrapper\">\n<div class=\"free__grid\" data-kid=\"1-3-1-1\" data-name=\"free tier band grid\">\n<div data-kid=\"1-3-1-1-1\" data-name=\"free tier heading and note group\">\n<h2 class=\"free__title\" data-kid=\"1-3-1-1-1-1\" data-name=\"free tier headline\" id=\"free-heading\">Up to 3 free cooks a day.</h2>\n<p class=\"free__note\" data-kid=\"1-3-1-1-1-2\" data-name=\"free tier supporting note\">First come first served from a shared pool. <a data-kid=\"1-3-1-1-1-2-1\" data-name=\"inline link to Credits section\" href=\"#credits\">Credits</a> when you need more.</p>\n</div>\n<a class=\"free__link\" data-kid=\"1-3-1-1-2\" data-name=\"free tier call-to-action link\" href=\"/pantry\">Start cooking</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"process-heading\" class=\"strip strip--plain\" data-kid=\"1-4\" data-name=\"how a cook runs process section\">\n<div class=\"wrap field__inner\" data-kid=\"1-4-1\" data-name=\"process section inner wrapper\">\n<h2 class=\"sr-only\" data-kid=\"1-4-1-1\" data-name=\"process section screen-reader only heading\" id=\"process-heading\" style=\"position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)\">How a cook runs</h2>\n<ol class=\"field__grid\" data-kid=\"1-4-1-2\" data-name=\"process steps grid\">\n<li class=\"field__step\" data-kid=\"1-4-1-2-1\" data-name=\"process step 1: add ingredients\">\n<h3 data-kid=\"1-4-1-2-1-1\" data-name=\"process step 1 heading\"><span aria-hidden=\"true\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"process step 1 number indicator\">1</span>Add Pantry ingredients</h3>\n<ul class=\"chips\" data-kid=\"1-4-1-2-1-2\" data-name=\"process step 1 ingredient chips\">\n<li class=\"tape\" data-kid=\"1-4-1-2-1-2-1\" data-name=\"ingredient chip: firm tofu\">firm tofu</li>\n<li class=\"tape\" data-kid=\"1-4-1-2-1-2-2\" data-name=\"ingredient chip: day-old rice\">day-old rice</li>\n<li class=\"tape\" data-kid=\"1-4-1-2-1-2-3\" data-name=\"ingredient chip: soy sauce\">soy sauce</li>\n</ul>\n<p class=\"note\" data-kid=\"1-4-1-2-1-3\" data-name=\"process step 1 constraint note\">3 or more ingredients.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-4-1-2-2\" data-name=\"process step 2: write recipe\">\n<h3 data-kid=\"1-4-1-2-2-1\" data-name=\"process step 2 heading\"><span aria-hidden=\"true\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"process step 2 number indicator\">2</span>Chef Llama writes one Recipe</h3>\n<dl class=\"constraints\" data-kid=\"1-4-1-2-2-2\" data-name=\"process step 2 constraints list\">\n<div class=\"constraint\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"constraint row: diet\"><dt data-kid=\"1-4-1-2-2-2-1-1\" data-name=\"constraint label: diet\">Diet</dt><dd data-kid=\"1-4-1-2-2-2-1-2\" data-name=\"constraint value: vegan\">vegan</dd></div>\n<div class=\"constraint\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"constraint row: allergy\"><dt data-kid=\"1-4-1-2-2-2-2-1\" data-name=\"constraint label: allergy\">Allergy</dt><dd data-kid=\"1-4-1-2-2-2-2-2\" data-name=\"constraint value: sesame\">sesame</dd></div>\n<div class=\"constraint\" data-kid=\"1-4-1-2-2-2-3\" data-name=\"constraint row: servings\"><dt data-kid=\"1-4-1-2-2-2-3-1\" data-name=\"constraint label: servings\">Servings</dt><dd data-kid=\"1-4-1-2-2-2-3-2\" data-name=\"constraint value: 2 servings\">2</dd></div>\n</dl>\n<p class=\"note\" data-kid=\"1-4-1-2-2-3\" data-name=\"process step 2 explanatory note\" style=\"max-inline-size:44ch\">Diet and allergies are hard limits. kcal and cook time are targets. A chip that breaks the Diet comes back as a Swap.</p>\n</li>\n<li class=\"field__step\" data-kid=\"1-4-1-2-3\" data-name=\"process step 3: cook the recipe\">\n<h3 data-kid=\"1-4-1-2-3-1\" data-name=\"process step 3 heading\"><span aria-hidden=\"true\" data-kid=\"1-4-1-2-3-1-1\" data-name=\"process step 3 number indicator\">3</span>Cook the Recipe</h3>\n<ul class=\"copylist\" data-kid=\"1-4-1-2-3-2\" data-name=\"process step 3 outcomes list\">\n<li data-kid=\"1-4-1-2-3-2-1\" data-name=\"outcome row: Method\"><span data-kid=\"1-4-1-2-3-2-1-1\" data-name=\"outcome feature name: Method\">Method</span><span data-kid=\"1-4-1-2-3-2-1-2\" data-name=\"outcome feature description: every step numbered\">every step, numbered</span></li>\n<li data-kid=\"1-4-1-2-3-2-2\" data-name=\"outcome row: Save\"><span data-kid=\"1-4-1-2-3-2-2-1\" data-name=\"outcome feature name: Save\">Save</span><span data-kid=\"1-4-1-2-3-2-2-2\" data-name=\"outcome feature description: one tap to Saved\">one tap to Saved</span></li>\n<li data-kid=\"1-4-1-2-3-2-3\" data-name=\"outcome row: Similar\"><span data-kid=\"1-4-1-2-3-2-3-1\" data-name=\"outcome feature name: Similar\">Similar</span><span data-kid=\"1-4-1-2-3-2-3-2\" data-name=\"outcome feature description: dishes near this one\">dishes near this one</span></li>\n</ul>\n</li>\n</ol>\n</div>\n</section>\n<section aria-labelledby=\"popular-heading\" class=\"pop\" data-kid=\"1-5\" data-name=\"popular recipes section\" id=\"popular\">\n<div class=\"wrap pop__inner\" data-kid=\"1-5-1\" data-name=\"popular section inner wrapper\">\n<div class=\"pop__head\" data-kid=\"1-5-1-1\" data-name=\"popular section header\">\n<h2 data-kid=\"1-5-1-1-1\" data-name=\"popular section title\" id=\"popular-heading\">Popular</h2>\n<p data-kid=\"1-5-1-1-2\" data-name=\"popular section subtitle (ranking basis)\">Ranked by saves in the last 7 days</p>\n</div>\n<ol class=\"cards\" data-kid=\"1-5-1-2\" data-name=\"popular recipes card